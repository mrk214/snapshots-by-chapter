    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração para que a paz de Jerusalém continue"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico dos degraus, de David"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "ALEGREI-ME quando me disseram: Vamos à casa do Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Os nossos pés estão dentro das tuas portas, ó Jerusalém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Jerusalém está edificada como uma cidade bem sólida,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Onde sobem as tribos, as tribos do Senhor, como testemunho de Israel, para darem graças ao nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois ali estão os tronos do juízo, os tronos da casa de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Orai pela paz de Jerusalém: prosperarão aqueles que te amam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Haja paz dentro dos teus muros, e prosperidade dentro dos teus palácios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por causa dos meus irmãos e amigos, direi: Haja paz em ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por causa da casa do Senhor, nosso Deus, buscarei o teu bem."
        ],
        "rlw_lines": []
      }
    ]
  },
