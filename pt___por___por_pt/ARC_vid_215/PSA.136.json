    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus é louvado pelas suas obras e por sua permanente benignidade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "LOUVAI ao Senhor, porque ele é bom; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Louvai ao Deus dos deuses; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Louvai ao Senhor dos senhores; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Aquele que só faz maravilhas; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aquele que, com entendimento, fez os céus, porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Aquele que estendeu a terra sobre as águas; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Aquele que fez os grandes luminares; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O sol para governar de dia; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A lua e as estrelas para presidirem à noite; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Que feriu o Egito nos seus primogénitos; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "E tirou a Israel do meio deles; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Com mão forte, e com braço estendido; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Aquele que dividiu o Mar Vermelho em duas partes; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "E fez passar Israel pelo meio dele: porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mas derribou a Faraó com o seu exército no Mar Vermelho; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Aquele que guiou o seu povo pelo deserto; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Aquele que feriu os grandes reis; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "E deu a morte a reis famosos; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Seón, rei dos amorreus; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "E Og, rei de Basan; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "E deu a terra deles em herança; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Sim, em herança a Israel, seu servo; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Que se lembrou da nossa humilhação; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "E nos remiu dos nossos inimigos; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Que dá mantimento a toda a carne; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Louvai ao Deus dos céus; porque a sua benignidade é para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
