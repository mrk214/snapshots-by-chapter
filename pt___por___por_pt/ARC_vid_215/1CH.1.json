    "name": "1 Crónicas"
  },
  "chapter": {
    "usfm": "1CH.1",
    "human": "1 Crónicas 1",
    "previous": {
      "usfm": "2KI.25",
      "human": "2 Reis 25"
    },
    "next": {
      "usfm": "1CH.2",
