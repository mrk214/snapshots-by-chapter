      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "The family of Harim",
          "1,017"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
