    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the choir director: A psalm of David, regarding the time the Ziphites came and said to Saul, “We know where David is hiding.” To be accompanied by stringed instruments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Come with great power, O God, and rescue me!",
          "Defend me with your might."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Listen to my prayer, O God.",
          "Pay attention to my plea."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For strangers are attacking me;",
          "violent people are trying to kill me.",
          "They care nothing for God."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Interlude"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "But God is my helper.",
          "The Lord keeps me alive!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "May the evil plans of my enemies be turned against them.",
          "Do as you promised and put an end to them."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I will sacrifice a voluntary offering to you;",
          "I will praise your name, O Lord,",
          "for it is good."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "For you have rescued me from my troubles",
          "and helped me to triumph over my enemies."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
