        "verse_numbers": [
          4
        ],
        "lines": [
          "Even though I walk",
          "through the darkest valley,",
          "I will fear no evil,",
          "for you are with me;",
          "your rod and your staff,",
          "they comfort me."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "You prepare a table before me",
