    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Historical Records From Adam to Abraham"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "To Noah’s Sons"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Adam, Seth, Enosh,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Kenan, Mahalalel, Jared,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enoch, Methuselah, Lamech, Noah."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "The sons of Noah:",
          "Shem, Ham and Japheth."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "The Japhethites"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "The sons of Japheth:",
          "Gomer, Magog, Madai, Javan, Tubal, Meshek and Tiras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "The sons of Gomer:",
          "Ashkenaz, Riphath and Togarmah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "The sons of Javan:",
          "Elishah, Tarshish, the Kittites and the Rodanites."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "The Hamites"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "The sons of Ham:",
          "Cush, Egypt, Put and Canaan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "The sons of Cush:",
          "Seba, Havilah, Sabta, Raamah and Sabteka.",
          "The sons of Raamah:",
          "Sheba and Dedan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cush was the father of",
          "Nimrod, who became a mighty warrior on earth."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Egypt was the father of",
          "the Ludites, Anamites, Lehabites, Naphtuhites,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Pathrusites, Kasluhites (from whom the Philistines came) and Caphtorites."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Canaan was the father of",
          "Sidon his firstborn, and of the Hittites,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Jebusites, Amorites, Girgashites,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Hivites, Arkites, Sinites,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Arvadites, Zemarites and Hamathites."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "The Semites"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "The sons of Shem:",
          "Elam, Ashur, Arphaxad, Lud and Aram.",
          "The sons of Aram:",
          "Uz, Hul, Gether and Meshek."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Arphaxad was the father of Shelah,",
          "and Shelah the father of Eber."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Two sons were born to Eber:",
          "One was named Peleg, because in his time the earth was divided; his brother was named Joktan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Joktan was the father of",
          "Almodad, Sheleph, Hazarmaveth, Jerah,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Hadoram, Uzal, Diklah,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Obal, Abimael, Sheba,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ophir, Havilah and Jobab. All these were sons of Joktan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Shem, Arphaxad, Shelah,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Eber, Peleg, Reu,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Serug, Nahor, Terah"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "and Abram (that is, Abraham)."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Family of Abraham"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "The sons of Abraham:",
          "Isaac and Ishmael."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Descendants of Hagar"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "These were their descendants:",
          "Nebaioth the firstborn of Ishmael, Kedar, Adbeel, Mibsam,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Mishma, Dumah, Massa, Hadad, Tema,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Jetur, Naphish and Kedemah. These were the sons of Ishmael."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Descendants of Keturah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "The sons born to Keturah, Abraham’s concubine:",
          "Zimran, Jokshan, Medan, Midian, Ishbak and Shuah.",
          "The sons of Jokshan:",
          "Sheba and Dedan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "The sons of Midian:",
          "Ephah, Epher, Hanok, Abida and Eldaah.",
          "All these were descendants of Keturah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Descendants of Sarah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Abraham was the father of Isaac.",
          "The sons of Isaac:",
          "Esau and Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esau’s Sons"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "The sons of Esau:",
          "Eliphaz, Reuel, Jeush, Jalam and Korah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "The sons of Eliphaz:",
          "Teman, Omar, Zepho, Gatam and Kenaz;",
          "by Timna: Amalek."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "The sons of Reuel:",
          "Nahath, Zerah, Shammah and Mizzah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "The People of Seir in Edom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "The sons of Seir:",
          "Lotan, Shobal, Zibeon, Anah, Dishon, Ezer and Dishan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "The sons of Lotan:",
          "Hori and Homam. Timna was Lotan’s sister."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "The sons of Shobal:",
          "Alvan, Manahath, Ebal, Shepho and Onam.",
          "The sons of Zibeon:",
          "Aiah and Anah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "The son of Anah:",
          "Dishon.",
          "The sons of Dishon:",
          "Hemdan, Eshban, Ithran and Keran."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "The sons of Ezer:",
          "Bilhan, Zaavan and Akan.",
          "The sons of Dishan:",
          "Uz and Aran."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "The Rulers of Edom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "These were the kings who reigned in Edom before any Israelite king reigned:",
          "Bela son of Beor, whose city was named Dinhabah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "When Bela died, Jobab son of Zerah from Bozrah succeeded him as king."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "When Jobab died, Husham from the land of the Temanites succeeded him as king."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "When Husham died, Hadad son of Bedad, who defeated Midian in the country of Moab, succeeded him as king. His city was named Avith."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "When Hadad died, Samlah from Masrekah succeeded him as king."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "When Samlah died, Shaul from Rehoboth on the river succeeded him as king."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "When Shaul died, Baal-Hanan son of Akbor succeeded him as king."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "When Baal-Hanan died, Hadad succeeded him as king. His city was named Pau, and his wife’s name was Mehetabel daughter of Matred, the daughter of Me-Zahab."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Hadad also died.",
          "The chiefs of Edom were:",
          "Timna, Alvah, Jetheth,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Oholibamah, Elah, Pinon,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Kenaz, Teman, Mibzar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Magdiel and Iram. These were the chiefs of Edom."
        ],
        "rlw_lines": []
      }
    ]
  },
