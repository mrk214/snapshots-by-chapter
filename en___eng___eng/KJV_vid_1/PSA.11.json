    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "To the chief Musician, A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "In the LORD put I my trust:",
          "How say ye to my soul, flee as a bird to your mountain?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "For, lo, the wicked bend their bow, they make ready their arrow upon the string,",
          "That they may privily shoot at the upright in heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "If the foundations be destroyed,",
          "What can the righteous do?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "The LORD is in his holy temple,",
          "The LORD's throne is in heaven:",
          "His eyes behold, his eyelids try, the children of men."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "The LORD trieth the righteous:",
          "But the wicked and him that loveth violence his soul hateth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Upon the wicked he shall rain snares, fire and brimstone, and an horrible tempest:",
          "This shall be the portion of their cup."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "For the righteous LORD loveth righteousness;",
          "His countenance doth behold the upright."
        ],
        "rlw_lines": []
      }
    ]
  },
