    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "I love the LORD,",
          "Because he hath heard my voice and my supplications."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Because he hath inclined his ear unto me,",
          "Therefore will I call upon him as long as I live."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "The sorrows of death compassed me,",
          "And the pains of hell gat hold upon me:",
          "I found trouble and sorrow."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Then called I upon the name of the LORD;",
          "O LORD, I beseech thee, deliver my soul."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Gracious is the LORD, and righteous;",
          "Yea, our God is merciful."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "The LORD preserveth the simple:",
          "I was brought low, and he helped me."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Return unto thy rest, O my soul;",
          "For the LORD hath dealt bountifully with thee."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "For thou hast delivered my soul from death,",
          "Mine eyes from tears, and my feet from falling."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "I will walk before",
          "The LORD in the land of the living."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "I believed, therefore have I spoken: I was greatly afflicted:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "I said in my haste, all men are liars."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "What shall I render unto the LORD",
          "For all his benefits toward me?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "I will take the cup of salvation,",
          "And call upon the name of the LORD."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "I will pay my vows unto the LORD now in the presence of all his people."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Precious in the sight of the LORD is the death of his saints."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O LORD, truly I am thy servant;",
          "I am thy servant, and the son of thine handmaid: Thou hast loosed my bonds."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "I will offer to thee the sacrifice of thanksgiving,",
          "And will call upon the name of the LORD."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "I will pay my vows unto the LORD now in the presence of all his people,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "In the courts of the LORD's house, in the midst of thee, O Jerusalem.",
          "Praise ye the LORD."
        ],
        "rlw_lines": [],
        "np": true
      }
