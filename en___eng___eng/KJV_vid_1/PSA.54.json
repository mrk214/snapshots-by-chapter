    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "To the chief Musician on Neginoth, Maschil, A Psalm of David, when the Ziphim came and said to Saul, Doth not David hide himself with us?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Save me, O God, by thy name,",
          "And judge me by thy strength."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Hear my prayer, O God;",
          "Give ear to the words of my mouth."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For strangers are risen up against me,",
          "And oppressors seek after my soul: They have not set God before them."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Behold, God is mine helper:",
          "The Lord is with them that uphold my soul."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "He shall reward evil unto mine enemies:",
          "Cut them off in thy truth."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I will freely sacrifice unto thee:",
          "I will praise thy name, O LORD; for it is good."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "For he hath delivered me out of all trouble:",
          "And mine eye hath seen his desire upon mine enemies."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
