      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sharp arrows of the mighty, with coals of juniper."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Woe is me, that I sojourn in Mesech,",
          "That I dwell in the tents of Kedar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "My soul hath long dwelt",
          "With him that hateth peace."
