    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Song of degrees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "LORD, remember David,",
          "And all his afflictions:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "How he sware unto the LORD,",
          "And vowed unto the mighty God of Jacob;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Surely I will not come into the tabernacle of my house,",
          "Nor go up into my bed;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "I will not give sleep to mine eyes, or slumber to mine eyelids,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Until I find out a place for the LORD,",
          "An habitation for the mighty God of Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Lo, we heard of it at Ephratah:",
          "We found it in the fields of the wood."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "We will go into his tabernacles:",
          "We will worship at his footstool."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Arise, O LORD, into thy rest;",
          "Thou, and the ark of thy strength."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Let thy priests be clothed with righteousness;",
          "And let thy saints shout for joy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "For thy servant David's sake",
          "Turn not away the face of thine anointed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "The LORD hath sworn in truth unto David;",
          "He will not turn from it;",
          "Of the fruit of thy body",
          "Will I set upon thy throne."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "If thy children will keep my covenant and my testimony that I shall teach them,",
          "Their children shall also sit upon thy throne for evermore."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "For the LORD hath chosen Zion;",
          "He hath desired it for his habitation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "This is my rest for ever:",
          "Here will I dwell; for I have desired it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "I will abundantly bless her provision:",
          "I will satisfy her poor with bread."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "I will also clothe her priests with salvation:",
          "And her saints shall shout aloud for joy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "There will I make the horn of David to bud:",
          "I have ordained a lamp for mine anointed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "His enemies will I clothe with shame:",
          "But upon himself shall his crown flourish."
        ],
        "rlw_lines": []
      }
    ]
  },
