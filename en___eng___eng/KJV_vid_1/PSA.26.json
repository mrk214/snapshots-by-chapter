    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Judge me, O LORD; for I have walked in mine integrity:",
          "I have trusted also in the LORD; therefore I shall not slide."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Examine me, O LORD, and prove me;",
          "Try my reins and my heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For thy lovingkindness is before mine eyes:",
          "And I have walked in thy truth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "I have not sat with vain persons,",
          "Neither will I go in with dissemblers."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "I have hated the congregation of evil doers;",
          "And will not sit with the wicked."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I will wash mine hands in innocency:",
          "So will I compass thine altar, O LORD:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "That I may publish with the voice of thanksgiving,",
          "And tell of all thy wondrous works."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "LORD, I have loved the habitation of thy house,",
          "And the place where thine honour dwelleth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Gather not my soul with sinners,",
          "Nor my life with bloody men:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "In whose hands is mischief,",
          "And their right hand is full of bribes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "But as for me, I will walk in mine integrity:",
          "Redeem me, and be merciful unto me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "My foot standeth in an even place:",
          "In the congregations will I bless the LORD."
        ],
        "rlw_lines": []
      }
    ]
  },
