    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "א Aleph"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Blessed are the undefiled in the way,",
          "Who walk in the law of the LORD."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Blessed are they that keep his testimonies,",
          "And that seek him with the whole heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "They also do no iniquity:",
          "They walk in his ways."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Thou hast commanded us",
          "To keep thy precepts diligently."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O that my ways were directed",
          "To keep thy statutes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Then shall I not be ashamed,",
          "When I have respect unto all thy commandments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "I will praise thee with uprightness of heart,",
          "When I shall have learned thy righteous judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "I will keep thy statutes:",
          "O forsake me not utterly."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ב Bet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Wherewithal shall a young man cleanse his way?",
          "By taking heed thereto according to thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "With my whole heart have I sought thee:",
          "O let me not wander from thy commandments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Thy word have I hid in mine heart,",
          "That I might not sin against thee."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Blessed art thou, O LORD:",
          "Teach me thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "With my lips have I declared",
          "All the judgments of thy mouth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "I have rejoiced in the way of thy testimonies,",
          "As much as in all riches."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "I will meditate in thy precepts,",
          "And have respect unto thy ways."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "I will delight myself in thy statutes:",
          "I will not forget thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ג Gimel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Deal bountifully with thy servant,",
          "That I may live, and keep thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Open thou mine eyes,",
          "That I may behold wondrous things out of thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "I am a stranger in the earth:",
          "Hide not thy commandments from me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "My soul breaketh for the longing",
          "That it hath unto thy judgments at all times."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Thou hast rebuked the proud",
          "That are cursed, which do err from thy commandments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Remove from me reproach and contempt:",
          "For I have kept thy testimonies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Princes also did sit and speak against me:",
          "But thy servant did meditate in thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Thy testimonies also are",
          "My delight and my counsellors."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ד Dalet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "My soul cleaveth unto the dust:",
          "Quicken thou me according to thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "I have declared my ways, and thou heardest me:",
          "Teach me thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Make me to understand the way of thy precepts:",
          "So shall I talk of thy wondrous works."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "My soul melteth for heaviness:",
          "Strengthen thou me according unto thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Remove from me the way of lying:",
          "And grant me thy law graciously."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "I have chosen the way of truth:",
          "Thy judgments have I laid before me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "I have stuck unto thy testimonies:",
          "O LORD, put me not to shame."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "I will run the way of thy commandments,",
          "When thou shalt enlarge my heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ה He"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Teach me, O LORD, the way of thy statutes;",
          "And I shall keep it unto the end."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Give me understanding, and I shall keep thy law;",
          "Yea, I shall observe it with my whole heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Make me to go in the path of thy commandments;",
          "For therein do I delight."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Incline my heart unto thy testimonies,",
          "And not to covetousness."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Turn away mine eyes from beholding vanity;",
          "And quicken thou me in thy way."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Stablish thy word",
          "Unto thy servant, who is devoted to thy fear."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Turn away my reproach which I fear:",
          "For thy judgments are good."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Behold, I have longed after thy precepts:",
          "Quicken me in thy righteousness."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ו Waw"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Let thy mercies come also unto me, O LORD,",
          "Even thy salvation, according to thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "So shall I have wherewith to answer him that reproacheth me:",
          "For I trust in thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "And take not the word of truth utterly out of my mouth;",
          "For I have hoped in thy judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "So shall I keep",
          "thy law continually for ever and ever."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "And I will walk at liberty:",
          "For I seek thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "I will speak of thy testimonies also before kings,",
          "And will not be ashamed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "And I will delight myself",
          "In thy commandments, which I have loved."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "My hands also will I lift up unto thy commandments, which I have loved;",
          "And I will meditate in thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ז Zain"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Remember the word unto thy servant,",
          "Upon which thou hast caused me to hope."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "This is my comfort in my affliction:",
          "For thy word hath quickened me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "The proud have had me greatly in derision:",
          "Yet have I not declined from thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "I remembered thy judgments of old,",
          "O LORD; And have comforted myself."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Horror hath taken hold upon me",
          "Because of the wicked that forsake thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Thy statutes have been my songs",
          "In the house of my pilgrimage."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "I have remembered thy name, O LORD, in the night, and have kept thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "This I had, because I kept thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ח Het"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "Thou art my portion, O LORD:",
          "I have said that I would keep thy words."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "I intreated thy favour with my whole heart:",
          "Be merciful unto me according to thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "I thought on my ways,",
          "And turned my feet unto thy testimonies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "I made haste, and delayed not",
          "To keep thy commandments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "The bands of the wicked have robbed me:",
          "But I have not forgotten thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "At midnight I will rise to give thanks unto thee",
          "Because of thy righteous judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "I am a companion of all them",
          "That fear thee, and of them that keep thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "The earth, O LORD, is full of",
          "Thy mercy: Teach me thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ט Tet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Thou hast dealt well with thy servant,",
          "O LORD, according unto thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Teach me good judgment and knowledge:",
          "For I have believed thy commandments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Before I was afflicted I went astray:",
          "But now have I kept thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Thou art good, and doest good;",
          "Teach me thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "The proud have forged a lie against me:",
          "But I will keep thy precepts with my whole heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "Their heart is as fat as grease;",
          "But I delight in thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "It is good for me that I have been afflicted;",
          "That I might learn thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "The law of thy mouth is better unto me",
          "Than thousands of gold and silver."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "י Yod"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "Thy hands have made me and fashioned me:",
          "Give me understanding, that I may learn thy commandments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "They that fear thee will be glad when they see me;",
          "Because I have hoped in thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "I know, O LORD, that thy judgments are right,",
          "And that thou in faithfulness hast afflicted me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "Let, I pray thee, thy merciful kindness be for my comfort,",
          "According to thy word unto thy servant."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "Let thy tender mercies come unto me, that I may live:",
          "For thy law is my delight."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "Let the proud be ashamed; for they dealt perversely with me without a cause:",
          "But I will meditate in thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Let those that fear thee turn unto me,",
          "And those that have known thy testimonies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "Let my heart be sound in thy statutes;",
          "That I be not ashamed."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "כ Kaph"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "My soul fainteth for thy salvation:",
          "But I hope in thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          82
        ],
        "lines": [
          "Mine eyes fail for thy word,",
          "Saying, When wilt thou comfort me?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          83
        ],
        "lines": [
          "For I am become like a bottle in the smoke;",
          "Yet do I not forget thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          84
        ],
        "lines": [
          "How many are the days of thy servant?",
          "When wilt thou execute judgment on them that persecute me?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          85
        ],
        "lines": [
          "The proud have digged pits for me,",
          "Which are not after thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          86
        ],
        "lines": [
          "All thy commandments are faithful:",
          "They persecute me wrongfully; help thou me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          87
        ],
        "lines": [
          "They had almost consumed me upon earth;",
          "But I forsook not thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          88
        ],
        "lines": [
          "Quicken me after thy lovingkindness;",
          "So shall I keep the testimony of thy mouth."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ל Lamed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          89
        ],
        "lines": [
          "For ever, O LORD, Thy word",
          "Is settled in heaven."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          90
        ],
        "lines": [
          "Thy faithfulness is unto all generations:",
          "Thou hast established the earth, and it abideth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          91
        ],
        "lines": [
          "They continue this day according to thine ordinances:",
          "For all are thy servants."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          92
        ],
        "lines": [
          "Unless thy law had been my delights,",
          "I should then have perished in mine affliction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          93
        ],
        "lines": [
          "I will never forget thy precepts:",
          "For with them thou hast quickened me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          94
        ],
        "lines": [
          "I am thine, save me;",
          "For I have sought thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          95
        ],
        "lines": [
          "The wicked have waited for me to destroy me:",
          "But I will consider thy testimonies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          96
        ],
        "lines": [
          "I have seen an end of all perfection:",
          "But thy commandment is exceeding broad."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "מ Mem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          97
        ],
        "lines": [
          "O how love I thy law!",
          "It is my meditation all the day."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          98
        ],
        "lines": [
          "Thou through thy commandments hast made me wiser than mine enemies:",
          "For they are ever with me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          99
        ],
        "lines": [
          "I have more understanding than all my teachers:",
          "For thy testimonies are my meditation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          100
        ],
        "lines": [
          "I understand more than the ancients,",
          "Because I keep thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          101
        ],
        "lines": [
          "I have refrained my feet from every evil way,",
          "That I might keep thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          102
        ],
        "lines": [
          "I have not departed",
          "From thy judgments: For thou hast taught me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          103
        ],
        "lines": [
          "How sweet are thy words unto my taste!",
          "Yea, sweeter than honey to my mouth!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          104
        ],
        "lines": [
          "Through thy precepts I get understanding:",
          "Therefore I hate every false way."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "נ Nun"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          105
        ],
        "lines": [
          "Thy word is a lamp unto my feet,",
          "And a light unto my path."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          106
        ],
        "lines": [
          "I have sworn, and I will perform it,",
          "That I will keep thy righteous judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          107
        ],
        "lines": [
          "I am afflicted very much:",
          "Quicken me, O LORD, according unto thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          108
        ],
        "lines": [
          "Accept, I beseech thee, the freewill offerings of my mouth, O LORD,",
          "And teach me thy judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          109
        ],
        "lines": [
          "My soul is continually in my hand:",
          "Yet do I not forget thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          110
        ],
        "lines": [
          "The wicked have laid a snare for me:",
          "Yet I erred not from thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          111
        ],
        "lines": [
          "Thy testimonies have I taken as an heritage for ever:",
          "For they are the rejoicing of my heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          112
        ],
        "lines": [
          "I have inclined mine heart to perform thy statutes",
          "Alway, even unto the end."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ס Samek"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          113
        ],
        "lines": [
          "I hate vain thoughts:",
          "But thy law do I love."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          114
        ],
        "lines": [
          "Thou art my hiding place and my shield:",
          "I hope in thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          115
        ],
        "lines": [
          "Depart from me, ye evildoers:",
          "For I will keep the commandments of my God."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          116
        ],
        "lines": [
          "Uphold me according unto thy word, that I may live:",
          "And let me not be ashamed of my hope."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          117
        ],
        "lines": [
          "Hold thou me up, and I shall be safe:",
          "And I will have respect unto thy statutes continually."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          118
        ],
        "lines": [
          "Thou hast trodden down all them that err from thy statutes:",
          "For their deceit is falsehood."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          119
        ],
        "lines": [
          "Thou puttest away all the wicked of the earth like dross:",
          "Therefore I love thy testimonies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          120
        ],
        "lines": [
          "My flesh trembleth for fear of thee;",
          "And I am afraid of thy judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ע Ain"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          121
        ],
        "lines": [
          "I have done judgment and justice:",
          "Leave me not to mine oppressors."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          122
        ],
        "lines": [
          "Be surety for thy servant for good:",
          "Let not the proud oppress me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          123
        ],
        "lines": [
          "Mine eyes fail for thy salvation,",
          "And for the word of thy righteousness."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          124
        ],
        "lines": [
          "Deal with thy servant according unto thy mercy,",
          "And teach me thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          125
        ],
        "lines": [
          "I am thy servant; give me understanding,",
          "That I may know thy testimonies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          126
        ],
        "lines": [
          "It is time for thee, LORD, to work:",
          "For they have made void thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          127
        ],
        "lines": [
          "Therefore I love thy commandments",
          "Above gold; yea, above fine gold."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          128
        ],
        "lines": [
          "Therefore I esteem all thy precepts concerning all things to be right;",
          "And I hate every false way."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "פ Pe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          129
        ],
        "lines": [
          "Thy testimonies are wonderful:",
          "Therefore doth my soul keep them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          130
        ],
        "lines": [
          "The entrance of thy words giveth light;",
          "It giveth understanding unto the simple."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          131
        ],
        "lines": [
          "I opened my mouth, and panted:",
          "For I longed for thy commandments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          132
        ],
        "lines": [
          "Look thou upon me, and be merciful unto me,",
          "As thou usest to do unto those that love thy name."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          133
        ],
        "lines": [
          "Order my steps in thy word:",
          "And let not any iniquity have dominion over me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          134
        ],
        "lines": [
          "Deliver me from the oppression of man:",
          "So will I keep thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          135
        ],
        "lines": [
          "Make thy face to shine upon thy servant;",
          "And teach me thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          136
        ],
        "lines": [
          "Rivers of waters run down mine eyes,",
          "Because they keep not thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "צ Zade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          137
        ],
        "lines": [
          "Righteous art thou, O LORD,",
          "And upright are thy judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          138
        ],
        "lines": [
          "Thy testimonies that thou hast commanded",
          "are righteous and very faithful."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          139
        ],
        "lines": [
          "My zeal hath consumed me,",
          "Because mine enemies have forgotten thy words."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          140
        ],
        "lines": [
          "Thy word is very pure:",
          "Therefore thy servant loveth it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          141
        ],
        "lines": [
          "I am small and despised:",
          "Yet do not I forget thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          142
        ],
        "lines": [
          "Thy righteousness is an everlasting righteousness,",
          "And thy law is the truth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          143
        ],
        "lines": [
          "Trouble and anguish have taken hold on me:",
          "Yet thy commandments are my delights."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          144
        ],
        "lines": [
          "The righteousness of thy testimonies is everlasting:",
          "Give me understanding, and I shall live."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ק Qoph"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          145
        ],
        "lines": [
          "I cried with my whole heart;",
          "hear me, O LORD: I will keep thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          146
        ],
        "lines": [
          "I cried unto thee;",
          "save me, and I shall keep thy testimonies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          147
        ],
        "lines": [
          "I prevented the dawning of the morning, and cried:",
          "I hoped in thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          148
        ],
        "lines": [
          "Mine eyes prevent the night watches,",
          "That I might meditate in thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          149
        ],
        "lines": [
          "Hear my voice according unto thy lovingkindness:",
          "O LORD, quicken me according to thy judgment."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          150
        ],
        "lines": [
          "They draw nigh that follow after mischief:",
          "They are far from thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          151
        ],
        "lines": [
          "Thou art near, O LORD;",
          "And all thy commandments are truth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          152
        ],
        "lines": [
          "Concerning thy testimonies, I have known of old",
          "That thou hast founded them for ever."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ר Resh"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          153
        ],
        "lines": [
          "Consider mine affliction, and deliver me:",
          "For I do not forget thy law."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          154
        ],
        "lines": [
          "Plead my cause, and deliver me:",
          "Quicken me according to thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          155
        ],
        "lines": [
          "Salvation is far from the wicked:",
          "For they seek not thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          156
        ],
        "lines": [
          "Great are thy tender mercies, O LORD:",
          "Quicken me according to thy judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          157
        ],
        "lines": [
          "Many are my persecutors and mine enemies;",
          "Yet do I not decline from thy testimonies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          158
        ],
        "lines": [
          "I beheld the transgressors, and was grieved;",
          "Because they kept not thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          159
        ],
        "lines": [
          "Consider how I love thy precepts:",
          "Quicken me, O LORD, according to thy lovingkindness."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          160
        ],
        "lines": [
          "Thy word is true from the beginning:",
          "And every one of thy righteous judgments endureth for ever."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ש Shin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          161
        ],
        "lines": [
          "Princes have persecuted me without a cause:",
          "But my heart standeth in awe of thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          162
        ],
        "lines": [
          "I rejoice at thy word,",
          "As one that findeth great spoil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          163
        ],
        "lines": [
          "I hate and abhor lying:",
          "But thy law do I love."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          164
        ],
        "lines": [
          "Seven times a day do I praise thee",
          "Because of thy righteous judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          165
        ],
        "lines": [
          "Great peace have they which love thy law:",
          "And nothing shall offend them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          166
        ],
        "lines": [
          "LORD, I have hoped for thy salvation,",
          "And done thy commandments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          167
        ],
        "lines": [
          "My soul hath kept thy testimonies;",
          "And I love them exceedingly."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          168
        ],
        "lines": [
          "I have kept thy precepts and thy testimonies:",
          "For all my ways are before thee."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "ת Taw"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          169
        ],
        "lines": [
          "Let my cry come near before thee, O LORD:",
          "Give me understanding according to thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          170
        ],
        "lines": [
          "Let my supplication come before thee:",
          "Deliver me according to thy word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          171
        ],
        "lines": [
          "My lips shall utter praise,",
          "When thou hast taught me thy statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          172
        ],
        "lines": [
          "My tongue shall speak of thy word:",
          "For all thy commandments are righteousness."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          173
        ],
        "lines": [
          "Let thine hand help me;",
          "For I have chosen thy precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          174
        ],
        "lines": [
          "I have longed for thy salvation, O LORD;",
          "And thy law is my delight."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          175
        ],
        "lines": [
          "Let my soul live, and it shall praise thee;",
          "And let thy judgments help me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          176
        ],
        "lines": [
          "I have gone astray like a lost sheep;",
          "seek thy servant; For I do not forget thy commandments."
        ],
        "rlw_lines": []
      }
    ]
  },
