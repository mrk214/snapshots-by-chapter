    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Song of degrees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Many a time have they afflicted me from my youth,",
          "May Israel now say:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Many a time have they afflicted me from my youth:",
          "Yet they have not prevailed against me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "The plowers plowed upon my back:",
          "They made long their furrows."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "The LORD is righteous:",
          "He hath cut asunder the cords of the wicked."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Let them all be confounded and turned back",
          "That hate Zion."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Let them be as the grass upon the housetops,",
          "Which withereth afore it groweth up:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Wherewith the mower filleth not his hand;",
          "Nor he that bindeth sheaves his bosom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Neither do they which go by say, the blessing of the LORD be upon you:",
          "We bless you in the name of the LORD."
        ],
        "rlw_lines": []
      }
    ]
