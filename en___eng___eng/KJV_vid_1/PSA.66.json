    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "To the chief Musician, A Song or Psalm."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Make a joyful noise unto God, all ye lands:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sing forth the honour of his name: Make his praise glorious."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Say unto God, How terrible art thou in thy works!",
          "Through the greatness of thy power shall thine enemies submit themselves unto thee."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "All the earth shall worship thee,",
          "And shall sing unto thee; They shall sing to thy name."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Come and see the works of God:",
          "He is terrible in his doing toward the children of men."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He turned the sea into dry land:",
          "They went through the flood on foot: There did we rejoice in him."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "He ruleth by his power for ever; His eyes behold the nations:",
          "Let not the rebellious exalt themselves."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O bless our God, ye people,",
          "And make the voice of his praise to be heard:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Which holdeth our soul in life,",
          "And suffereth not our feet to be moved."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "For thou, O God, hast proved us:",
          "Thou hast tried us, as silver is tried."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Thou broughtest us into the net;",
          "Thou laidst affliction upon our loins."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Thou hast caused men to ride over our heads;",
          "We went through fire and through water: But thou broughtest us out into a wealthy place."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "I will go into thy house with burnt offerings:",
          "I will pay thee my vows,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "which my lips have uttered, and my mouth hath spoken, when I was in trouble."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "I will offer unto thee burnt sacrifices of fatlings, with the incense of rams;",
          "I will offer bullocks with goats."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Come and hear, all ye that fear God,",
          "And I will declare what he hath done for my soul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "I cried unto him with my mouth,",
          "And he was extolled with my tongue."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "If I regard iniquity in my heart,",
          "The Lord will not hear me:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "But verily God hath heard me;",
          "He hath attended to the voice of my prayer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Blessed be God, which hath not turned away my prayer,",
          "Nor his mercy from me."
        ],
        "rlw_lines": []
      }
    ]
  },
