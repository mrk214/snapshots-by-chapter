        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For the rod of the wicked shall not rest upon the lot of the righteous;",
          "Lest the righteous put forth their hands unto iniquity."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Do good, O LORD,",
          "Unto those that be good, and to them that are upright in their hearts."
