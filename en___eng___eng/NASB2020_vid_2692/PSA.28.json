    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 28"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Prayer for Help, and Praise for Its Answer."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "To You, Lord, I call;",
          "My rock, do not be deaf to me,",
          "For if You are silent to me,",
          "I will become like those who go down to the pit."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Hear the sound of my pleadings when I cry to You for help,",
          "When I raise my hands toward Your holy sanctuary."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Do not drag me away with the wicked",
          "And with those who practice injustice,",
          "Who speak peace with their neighbors,",
          "While evil is in their hearts."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Give back to them according to their work and according to the evil of their practices;",
          "Give back to them according to the work of their hands;",
          "Repay them what is due them."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Because they do not regard the works of the Lord",
          "Nor the deeds of His hands,",
          "He will tear them down and not build them up."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Blessed be the Lord,",
          "Because He has heard the sound of my pleading."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "The Lord is my strength and my shield;",
          "My heart trusts in Him, and I am helped;",
          "Therefore my heart triumphs,",
          "And with my song I shall thank Him."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "The Lord is their strength,",
          "And He is a refuge of salvation to His anointed."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Save Your people and bless Your inheritance;",
          "Be their shepherd also, and carry them forever."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
