    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 116"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Thanksgiving for Rescue from Death."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "I love the Lord, because He hears",
          "My voice and my pleas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Because He has inclined His ear to me,",
          "Therefore I will call upon Him as long as I live."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "The snares of death encompassed me",
          "And the terrors of Sheol came upon me;",
          "I found distress and sorrow."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Then I called upon the name of the Lord:",
          "“Please, Lord, save my life!”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Gracious is the Lord, and righteous;",
          "Yes, our God is compassionate."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "The Lord watches over the simple;",
          "I was brought low, and He saved me."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Return to your rest, my soul,",
          "For the Lord has dealt generously with you."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "For You have rescued my soul from death,",
          "My eyes from tears,",
          "And my feet from stumbling."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "I shall walk before the Lord",
          "In the land of the living."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "I believed when I said,",
          "“I am greatly afflicted.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "I said in my alarm,",
          "“All people are liars.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶What shall I repay to the Lord",
          "For all His benefits to me?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "I will lift up the cup of salvation,",
          "And call upon the name of the Lord."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "I will pay my vows to the Lord;",
          "May it be in the presence of all His people!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Precious in the sight of the Lord",
          "Is the death of His godly ones."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O Lord, I surely am Your slave,",
          "I am Your slave, the son of Your female slave,",
          "You have unfastened my restraints."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "I will offer You a sacrifice of thanksgiving,",
          "And call upon the name of the Lord."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "I will pay my vows to the Lord,",
          "May it be in the presence of all His people,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "In the courtyards of the Lord’s house,",
          "In the midst of you, Jerusalem!",
          "Praise the Lord!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
