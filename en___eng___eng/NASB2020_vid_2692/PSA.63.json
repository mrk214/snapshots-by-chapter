    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 63"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Thirsting Soul Satisfied in God."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Psalm of David, when he was in the wilderness of Judah."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "God, You are my God; I shall be watching for You;",
          "My soul thirsts for You, my flesh yearns for You,",
          "In a dry and exhausted land where there is no water."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "So have I seen You in the sanctuary,",
          "To see Your power and glory."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Because Your favor is better than life,",
          "My lips will praise You."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "So I will bless You as long as I live;",
          "I will lift up my hands in Your name."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "My soul is satisfied as with fat and fatness,",
          "And my mouth offers praises with joyful lips."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶When I remember You on my bed,",
          "I meditate on You in the night watches,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "For You have been my help,",
          "And in the shadow of Your wings I sing for joy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "My soul clings to You;",
          "Your right hand takes hold of me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶But those who seek my life to destroy it,",
          "Will go into the depths of the earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "They will be turned over to the power of the sword;",
          "They will be a prey for foxes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "But the king will rejoice in God;",
          "Everyone who swears by Him will boast,",
          "For the mouths of those who speak lies will be stopped."
        ],
        "rlw_lines": []
      }
    ]
  },
