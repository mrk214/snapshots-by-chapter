    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 25"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Prayer for Protection, Guidance, and Pardon."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "To You, Lord, I lift up my soul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "My God, in You I trust,",
          "Do not let me be ashamed;",
          "Do not let my enemies rejoice over me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Indeed, none of those who wait for You will be ashamed;",
          "Those who deal treacherously without cause will be ashamed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Make me know Your ways, Lord;",
          "Teach me Your paths."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Lead me in Your truth and teach me,",
          "For You are the God of my salvation;",
          "For You I wait all the day."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Remember, Lord, Your compassion and Your faithfulness,",
          "For they have been from of old."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Do not remember the sins of my youth or my wrongdoings;",
          "Remember me according to Your faithfulness,",
          "For Your goodness’ sake, Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶The Lord is good and upright;",
          "Therefore He instructs sinners in the way."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "He leads the humble in justice,",
          "And He teaches the humble His way."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "All the paths of the Lord are faithfulness and truth",
          "To those who comply with His covenant and His testimonies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "For the sake of Your name, Lord,",
          "Forgive my wrongdoing, for it is great."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶Who is the person who fears the Lord?",
          "He will instruct him in the way he should choose."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "His soul will dwell in prosperity,",
          "And his descendants will inherit the land."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "The secret of the Lord is for those who fear Him,",
          "And He will make them know His covenant."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "My eyes are continually toward the Lord,",
          "For He will rescue my feet from the net."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶Turn to me and be gracious to me,",
          "For I am lonely and afflicted."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "The troubles of my heart are enlarged;",
          "Bring me out of my distresses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Look at my misery and my trouble,",
          "And forgive all my sins."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Look at my enemies, for they are many,",
          "And they hate me with violent hatred."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Guard my soul and save me;",
          "Do not let me be ashamed, for I take refuge in You."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Let integrity and uprightness protect me,",
          "For I wait for You."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Redeem Israel, God,",
          "From all his distress."
        ],
        "rlw_lines": []
      }
    ]
  },
