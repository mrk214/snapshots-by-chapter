    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 112"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Prosperity of One Who Fears the Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Praise the Lord!",
          "Blessed is a person who fears the Lord,",
          "Who greatly delights in His commandments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "His descendants will be mighty on the earth;",
          "The generation of the upright will be blessed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Wealth and riches are in his house,",
          "And his righteousness endures forever."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Light shines in the darkness for the upright;",
          "He is gracious, compassionate, and righteous."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "It goes well for a person who is gracious and lends;",
          "He will maintain his cause in judgment."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "For he will never be shaken;",
          "The righteous will be remembered forever."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶He will not fear bad news;",
          "His heart is steadfast, trusting in the Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "His heart is firm, he will not fear,",
          "But will look with satisfaction on his enemies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "He has given freely to the poor,",
          "His righteousness endures forever;",
          "His horn will be exalted in honor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶The wicked will see it and be vexed,",
          "He will gnash his teeth and melt away;",
          "The desire of the wicked will perish."
        ],
        "rlw_lines": []
      }
    ]
  },
