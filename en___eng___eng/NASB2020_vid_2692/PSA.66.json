    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 66"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Praise for God’s Mighty Deeds and for His Answer to Prayer."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the music director. A Song. A Psalm."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Shout joyfully to God, all the earth;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sing the glory of His name;",
          "Make His praise glorious."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Say to God, “How awesome are Your works!",
          "Because of the greatness of Your power Your enemies will pretend to obey You."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“All the earth will worship You,",
          "And will sing praises to You;",
          "They will sing praises to Your name.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Come and see the works of God,",
          "Who is awesome in His deeds toward the sons of mankind."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He turned the sea into dry land;",
          "They passed through the river on foot;",
          "Let’s rejoice there, in Him!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "He rules by His might forever;",
          "His eyes keep watch on the nations;",
          "The rebellious shall not exalt themselves!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Bless our God, you peoples,",
          "And sound His praise abroad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Who keeps us in life,",
          "And does not allow our feet to slip."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "For You have put us to the test, God;",
          "You have refined us as silver is refined."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "You brought us into the net;",
          "You laid an oppressive burden upon us."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "You made men ride over our heads;",
          "We went through fire and through water.",
          "Yet You brought us out into a place of abundance."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "I shall come into Your house with burnt offerings;",
          "I shall pay You my vows,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Which my lips uttered",
          "And my mouth spoke when I was in distress."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "I shall offer to You burnt offerings of fat animals,",
          "With the smoke of rams;",
          "I shall make an offering of bulls with male goats."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶Come and hear, all who fear God,",
          "And I will tell of what He has done for my soul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "I cried to Him with my mouth,",
          "And He was exalted with my tongue."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "If I regard wickedness in my heart,",
          "The Lord will not hear;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "But God has heard;",
          "He has given attention to the sound of my prayer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Blessed be God,",
          "Who has not turned away my prayer",
          "Nor His favor from me."
        ],
        "rlw_lines": []
      }
    ]
  },
