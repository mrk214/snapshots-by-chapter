    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 6"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Prayer for Mercy in Time of Trouble."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the music director; with stringed instruments, upon an eight-string lyre. A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Lord, do not rebuke me in Your anger,",
          "Nor discipline me in Your wrath."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Be gracious to me, Lord, for I am frail;",
          "Heal me, Lord, for my bones are horrified."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "And my soul is greatly horrified;",
          "But You, Lord—how long?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Return, Lord, rescue my soul;",
          "Save me because of Your mercy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "For there is no mention of You in death;",
          "In Sheol, who will praise You?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶I am weary with my sighing;",
          "Every night I make my bed swim,",
          "I flood my couch with my tears."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "My eye has wasted away with grief;",
          "It has grown old because of all my enemies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Leave me, all you who practice injustice,",
          "For the Lord has heard the sound of my weeping."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "The Lord has heard my pleading,",
          "The Lord receives my prayer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "All my enemies will be put to shame and greatly horrified;",
          "They shall turn back, they will suddenly be put to shame."
        ],
        "rlw_lines": []
      }
    ]
  },
