    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 76"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Victorious Power of the God of Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the music director; on stringed instruments. A Psalm of Asaph, a Song."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "God is known in Judah;",
          "His name is great in Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "His tabernacle is in Salem;",
          "His dwelling place also is in Zion."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "There He broke the flaming arrows,",
          "The shield, the sword, and the weapons of war."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶You are resplendent,",
          "More majestic than the mountains of prey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "The stouthearted were plundered,",
          "They sank into sleep;",
          "And none of the warriors could use his hands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "At Your rebuke, God of Jacob,",
          "Both rider and horse were cast into a dead sleep."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "You, You indeed are to be feared,",
          "And who may stand in Your presence, once You are angry?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶You caused judgment to be heard from heaven;",
          "The earth feared and was still"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "When God arose to judgment,",
          "To save all the humble of the earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "For the wrath of mankind shall praise You;",
          "You will encircle Yourself with a remnant of wrath."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Make vows to the Lord your God and fulfill them;",
          "All who are around Him are to bring gifts to Him who is to be feared."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "He will cut off the spirit of princes;",
          "He is feared by the kings of the earth."
        ],
        "rlw_lines": []
      }
    ]
  },
