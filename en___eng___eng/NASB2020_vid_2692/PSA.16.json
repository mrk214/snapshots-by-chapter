    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 16"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Lord, the Psalmist’s Portion in Life and Salvation in Death."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Mikhtam of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Protect me, God, for I take refuge in You."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "I said to the Lord, “You are my Lord;",
          "I have nothing good besides You.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "As for the saints who are on the earth,",
          "They are the majestic ones; all my delight is in them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "The pains of those who have acquired another god will be multiplied;",
          "I will not pour out their drink offerings of blood,",
          "Nor will I take their names upon my lips."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶The Lord is the portion of my inheritance and my cup;",
          "You support my lot."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "The measuring lines have fallen for me in pleasant places;",
          "Indeed, my inheritance is beautiful to me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶I will bless the Lord who has advised me;",
          "Indeed, my mind instructs me in the night."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "I have set the Lord continually before me;",
          "Because He is at my right hand, I will not be shaken."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Therefore my heart is glad and my glory rejoices;",
          "My flesh also will dwell securely."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "For You will not abandon my soul to Sheol;",
          "You will not allow Your Holy One to undergo decay."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "You will make known to me the way of life;",
          "In Your presence is fullness of joy;",
          "In Your right hand there are pleasures forever."
        ],
        "rlw_lines": []
      }
    ]
  },
