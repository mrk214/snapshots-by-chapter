    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 61"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confidence in God’s Protection."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the music director; on a stringed instrument. A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hear my cry, God;",
          "Give Your attention to my prayer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "From the end of the earth I call to You when my heart is faint;",
          "Lead me to the rock that is higher than I."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For You have been a refuge for me,",
          "A tower of strength against the enemy."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Let me dwell in Your tent forever;",
          "Let me take refuge in the shelter of Your wings."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶For You have heard my vows, God;",
          "You have given me the inheritance of those who fear Your name."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "You will prolong the king’s life;",
          "His years will be like generations."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "He will sit enthroned before God forever;",
          "Appoint faithfulness and truth that they may watch over him."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "So I will sing praise to Your name forever,",
          "That I may pay my vows day by day."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
