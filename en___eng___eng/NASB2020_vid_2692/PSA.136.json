    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 136"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Thanks for the Lord’s Goodness to Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Give thanks to the Lord, for He is good,",
          "For His faithfulness is everlasting."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Give thanks to the God of gods,",
          "For His faithfulness is everlasting."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Give thanks to the Lord of lords,",
          "For His faithfulness is everlasting."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "To Him who alone does great wonders,",
          "For His faithfulness is everlasting;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "To Him who made the heavens with skill,",
          "For His faithfulness is everlasting;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "To Him who spread out the earth above the waters,",
          "For His faithfulness is everlasting;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "To Him who made the great lights,",
          "For His faithfulness is everlasting:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "The sun to rule by day,",
          "For His faithfulness is everlasting,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "The moon and stars to rule by night,",
          "For His faithfulness is everlasting."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶To Him who struck the Egyptians, that is, their firstborn,",
          "For His faithfulness is everlasting,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "And brought Israel out from their midst,",
          "For His faithfulness is everlasting,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "With a strong hand and an outstretched arm,",
          "For His faithfulness is everlasting."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "To Him who divided the Red Sea in parts,",
          "For His faithfulness is everlasting,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "And allowed Israel to pass through the midst of it,",
          "For His faithfulness is everlasting;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "But He overthrew Pharaoh and his army in the Red Sea,",
          "For His faithfulness is everlasting."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "To Him who led His people through the wilderness,",
          "For His faithfulness is everlasting;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "To Him who struck great kings,",
          "For His faithfulness is everlasting,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "And brought death to mighty kings,",
          "For His faithfulness is everlasting:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Sihon, king of the Amorites,",
          "For His faithfulness is everlasting,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "And Og, king of Bashan,",
          "For His faithfulness is everlasting,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "And gave their land as an inheritance,",
          "For His faithfulness is everlasting,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "An inheritance to His servant Israel,",
          "For His faithfulness is everlasting."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¶Who remembered us in our lowliness,",
          "For His faithfulness is everlasting,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "And has rescued us from our enemies,",
          "For His faithfulness is everlasting;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Who gives food to all flesh,",
          "For His faithfulness is everlasting."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Give thanks to the God of heaven,",
          "For His faithfulness is everlasting."
        ],
        "rlw_lines": []
      }
