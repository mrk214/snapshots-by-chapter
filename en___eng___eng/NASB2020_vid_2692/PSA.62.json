    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 62"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "God Alone a Refuge from Treachery and Oppression."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the music director; according to Jeduthun. A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "My soul waits in silence for God alone;",
          "From Him comes my salvation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "He alone is my rock and my salvation,",
          "My stronghold; I will not be greatly shaken."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶How long will you attack a man,",
          "That you may murder him, all of you,",
          "Like a leaning wall, like a tottering fence?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "They have planned only to thrust him down from his high position;",
          "They delight in falsehood;",
          "They bless with their mouth,",
          "But inwardly they curse."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶My soul, wait in silence for God alone,",
          "For my hope is from Him."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He alone is my rock and my salvation,",
          "My refuge; I will not be shaken."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "My salvation and my glory rest on God;",
          "The rock of my strength, my refuge is in God."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Trust in Him at all times, you people;",
          "Pour out your hearts before Him;",
          "God is a refuge for us."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶People of low standing are only breath, and people of rank are a lie;",
          "In the balances they go up.",
          "Together they are lighter than breath."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Do not trust in oppression,",
          "And do not vainly rely on robbery;",
          "If wealth increases, do not set your heart on it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶God has spoken once;",
          "Twice I have heard this:",
          "That power belongs to God;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "And faithfulness is Yours, Lord,",
          "For You reward a person according to his work."
        ],
        "rlw_lines": []
      }
    ]
  },
