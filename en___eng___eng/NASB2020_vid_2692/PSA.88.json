    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 88"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Petition to Be Saved from Death."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Song. A Psalm of the sons of Korah. For the music director; according to Mahalath Leannoth. A Maskil of Heman the Ezrahite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Lord, the God of my salvation,",
          "I have cried out by day and in the night before You."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Let my prayer come before You;",
          "Incline Your ear to my cry!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For my soul has had enough troubles,",
          "And my life has approached Sheol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "I am counted among those who go down to the pit;",
          "I have become like a man without strength,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Abandoned among the dead,",
          "Like the slain who lie in the grave,",
          "Whom You no longer remember,",
          "And they are cut off from Your hand."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "You have put me in the lowest pit,",
          "In dark places, in the depths."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Your wrath has rested upon me,",
          "And You have afflicted me with all Your waves."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "You have removed my acquaintances far from me;",
          "You have made me an object of loathing to them;",
          "I am shut up and cannot go out."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "My eye grows dim from misery;",
          "I have called upon You every day, Lord;",
          "I have spread out my hands to You."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Will You perform wonders for the dead?",
          "Or will the departed spirits rise and praise You?"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Will Your graciousness be declared in the grave,",
          "Your faithfulness in Abaddon?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Will Your wonders be made known in the darkness?",
          "And Your righteousness in the land of forgetfulness?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¶But I, Lord, have cried out to You for help,",
          "And in the morning my prayer comes before You."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Lord, why do You reject my soul?",
          "Why do You hide Your face from me?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "I was miserable and about to die from my youth on;",
          "I suffer Your terrors; I grow weary."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Your burning anger has passed over me;",
          "Your terrors have destroyed me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "They have surrounded me like water all day long;",
          "They have encircled me altogether."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "You have removed lover and friend far from me;",
          "My acquaintances are in a hiding place."
        ],
        "rlw_lines": []
      }
    ]
  },
