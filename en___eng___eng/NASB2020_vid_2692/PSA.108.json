    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 108"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "God Praised and Pleas to Give Victory."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Song, a Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "My heart is steadfast, God;",
          "I will sing, I will sing praises also with my soul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Awake, harp and lyre;",
          "I will awaken the dawn!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "I will give thanks to You, Lord, among the peoples,",
          "And I will sing praises to You among the nations."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "For Your mercy is great above the heavens,",
          "And Your truth reaches to the skies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Be exalted above the heavens, God,",
          "And may Your glory be above all the earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "So that Your beloved may be rescued,",
          "Save with Your right hand, and answer me!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶God has spoken in His holiness:",
          "“I will triumph, I will divide up Shechem,",
          "And measure out the Valley of Succoth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Gilead is Mine, Manasseh is Mine;",
          "Ephraim also is the helmet of My head;",
          "Judah is My scepter."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“Moab is My washbowl;",
          "I will throw My sandal over Edom;",
          "I will shout aloud over Philistia.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Who will bring me into the fortified city?",
          "Who will lead me to Edom?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "God, have You Yourself not rejected us?",
          "And will You not go forth with our armies, God?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Give us help against the enemy,",
          "For deliverance by man is worthless."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Through God we will do valiantly,",
          "And it is He who will trample down our enemies."
        ],
        "rlw_lines": []
      }
    ]
  },
