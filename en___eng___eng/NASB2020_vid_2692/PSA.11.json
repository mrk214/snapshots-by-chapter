    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 11"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Lord, a Refuge and Defense."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the music director. A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "In the Lord I take refuge;",
          "How can you say to my soul, “Flee as a bird to your mountain?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“For, behold, the wicked bend the bow,",
          "They have set their arrow on the string",
          "To shoot in darkness at the upright in heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“If the foundations are destroyed,",
          "What can the righteous do?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶The Lord is in His holy temple; the Lord’s throne is in heaven;",
          "His eyes see, His eyelids test the sons of mankind."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "The Lord tests the righteous and the wicked,",
          "And His soul hates one who loves violence."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He will rain coals of fire upon the wicked,",
          "And brimstone and burning wind will be the portion of their cup."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "For the Lord is righteous, He loves righteousness;",
          "The upright will see His face."
        ],
        "rlw_lines": []
      }
    ]
  },
