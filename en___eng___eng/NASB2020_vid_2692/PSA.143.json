    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 143"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Prayer for Help and Guidance."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hear my prayer, Lord,",
          "Listen to my pleadings!",
          "Answer me in Your faithfulness, in Your righteousness!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "And do not enter into judgment with Your servant,",
          "For no person living is righteous in Your sight."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For the enemy has persecuted my soul;",
          "He has crushed my life to the ground;",
          "He has made me dwell in dark places, like those who have long been dead."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Therefore my spirit feels weak within me;",
          "My heart is appalled within me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶I remember the days of old;",
          "I meditate on all Your accomplishments;",
          "I reflect on the work of Your hands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I spread out my hands to You;",
          "My soul longs for You, like a weary land."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Answer me quickly, Lord, my spirit fails;",
          "Do not hide Your face from me,",
          "Or I will be the same as those who go down to the pit."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Let me hear Your faithfulness in the morning,",
          "For I trust in You;",
          "Teach me the way in which I should walk;",
          "For to You I lift up my soul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Save me, Lord, from my enemies;",
          "I take refuge in You."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Teach me to do Your will,",
          "For You are my God;",
          "Let Your good Spirit lead me on level ground."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "For the sake of Your name, Lord, revive me.",
          "In Your righteousness bring my soul out of trouble."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "And in Your faithfulness, destroy my enemies,",
          "And eliminate all those who attack my soul,",
          "For I am Your servant."
        ],
        "rlw_lines": []
      }
    ]
  },
