    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 57"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Prayer for Rescue from Persecutors."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the music director; set to Al-tashheth. A Mikhtam of David, when he fled from Saul in the cave."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Be gracious to me, God, be gracious to me,",
          "For my soul takes refuge in You;",
          "And in the shadow of Your wings I will take refuge",
          "Until destruction passes by."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "I will cry to God Most High,",
          "To God who accomplishes all things for me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "He will send from heaven and save me;",
          "He rebukes the one who tramples upon me."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "God will send His favor and His truth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶My soul is among lions;",
          "I must lie among those who devour,",
          "Among sons of mankind whose teeth are spears and arrows,",
          "And their tongue is a sharp sword."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Be exalted above the heavens, God;",
          "May Your glory be above all the earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "They have prepared a net for my steps;",
          "My soul is bowed down;",
          "They dug a pit before me;",
          "They themselves have fallen into the midst of it."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶My heart is steadfast, God, my heart is steadfast;",
          "I will sing, yes, I will sing praises!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Awake, my glory!",
          "Awake, harp and lyre!",
          "I will awaken the dawn."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "I will praise You, Lord, among the peoples;",
          "I will sing praises to You among the nations."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "For Your goodness is great to the heavens",
          "And Your truth to the clouds."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Be exalted above the heavens, God;",
          "May Your glory be above all the earth."
        ],
        "rlw_lines": []
      }
    ]
