      "human": "Ezekiel 1"
    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Prayer for Mercy"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Remember, Lord, what has come upon us;",
          "Look, and see our disgrace!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Our inheritance has been turned over to strangers,",
          "Our houses to foreigners."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "We have become orphans, without a father;",
          "Our mothers are like widows."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "We have to pay for our drinking water,",
          "Our wood comes to us at a price."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Our pursuers are at our necks;",
          "We are worn out, we are given no rest."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "We have submitted to Egypt and Assyria to get enough bread."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Our fathers sinned, and are gone;",
          "It is we who have been burdened with the punishment for their wrongdoings."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Slaves rule over us;",
          "There is no one to rescue us from their hand."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "We get our bread at the risk of our lives",
          "Because of the sword in the wilderness."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Our skin has become as hot as an oven,",
          "Because of the ravages of hunger."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "They violated the women in Zion,",
          "The virgins in the cities of Judah."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Leaders were hung by their hands;",
          "Elders were not respected."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Young men worked at the grinding mill,",
          "And youths staggered under loads of wood."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Elders are absent from the gate,",
          "Young men from their music."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "The joy of our hearts has ended;",
          "Our dancing has been turned into mourning."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "The crown has fallen from our head;",
          "Woe to us, for we have sinned!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Because of this our heart is faint,",
          "Because of these things our eyes are dim;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Because of Mount Zion which lies desolate,",
          "Jackals prowl in it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¶You, Lord, rule forever;",
          "Your throne is from generation to generation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Why will You forget us forever?",
          "Why do You abandon us for so long?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Restore us to You, Lord, so that we may be restored;",
          "Renew our days as of old,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Unless You have utterly rejected us",
          "And are exceedingly angry with us."
        ],
        "rlw_lines": []
      }
    ]
  },
