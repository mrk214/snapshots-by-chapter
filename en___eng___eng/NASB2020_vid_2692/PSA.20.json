    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 20"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Prayer for Victory over Enemies."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the music director. A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "May the Lord answer you on a day of trouble!",
          "May the name of the God of Jacob protect you!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "May He send you help from the sanctuary,",
          "And support you from Zion!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "May He remember all your meal offerings",
          "And accept your burnt offering!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶May He grant you your heart’s desire",
          "And fulfill your whole plan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "We will sing for joy over your victory,",
          "And in the name of our God we will set up our banners.",
          "May the Lord fulfill all your desires."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Now I know that the Lord saves His anointed;",
          "He will answer him from His holy heaven",
          "With the saving strength of His right hand."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Some praise their chariots and some their horses,",
          "But we will praise the name of the Lord, our God."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "They have bowed down and fallen,",
          "But we have risen and stood upright."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Save, Lord;",
          "May the King answer us on the day we call."
        ],
        "rlw_lines": []
      }
    ]
  },
