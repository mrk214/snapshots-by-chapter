    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 147"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Praise for Jerusalem’s Restoration and Prosperity."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Praise the Lord!",
          "For it is good to sing praises to our God;",
          "For it is pleasant and praise is beautiful."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "The Lord builds up Jerusalem;",
          "He gathers the outcasts of Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "He heals the brokenhearted",
          "And binds up their wounds."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He counts the number of the stars;",
          "He gives names to all of them."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Great is our Lord and abundant in strength;",
          "His understanding is infinite."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "The Lord supports the afflicted;",
          "He brings the wicked down to the ground."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Sing to the Lord with thanksgiving;",
          "Sing praises to our God on the lyre;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "It is He who covers the heavens with clouds,",
          "Who provides rain for the earth,",
          "Who makes grass sprout on the mountains."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "It is He who gives an animal its food,",
          "And feeds young ravens that cry."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "He does not delight in the strength of the horse;",
          "He does not take pleasure in the legs of a man."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "The Lord favors those who fear Him,",
          "Those who wait for His faithfulness."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶Praise the Lord, Jerusalem!",
          "Praise your God, Zion!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "For He has strengthened the bars of your gates;",
          "He has blessed your sons among you."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "He makes peace in your borders;",
          "He satisfies you with the finest of the wheat."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "He sends His command to the earth;",
          "His word runs very swiftly."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "He showers snow like wool;",
          "He scatters the frost like ashes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "He hurls His ice as fragments;",
          "Who can stand before His cold?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "He sends His word and makes them melt;",
          "He makes His wind blow, and the waters flow."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "He declares His words to Jacob,",
          "His statutes and His judgments to Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "He has not dealt this way with any other nation;",
          "And as for His judgments, they have not known them.",
          "Praise the Lord!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
