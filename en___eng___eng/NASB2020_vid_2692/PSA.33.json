    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 33"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Praise to the Creator and Protector."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Sing for joy in the Lord, you righteous ones;",
          "Praise is becoming to the upright."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Give thanks to the Lord with the lyre;",
          "Sing praises to Him with a harp of ten strings."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sing to Him a new song;",
          "Play skillfully with a shout of joy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "For the word of the Lord is right,",
          "And all His work is done in faithfulness."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "He loves righteousness and justice;",
          "The earth is full of the goodness of the Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶By the word of the Lord the heavens were made,",
          "And by the breath of His mouth all their lights."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "He gathers the waters of the sea together as a heap;",
          "He puts the depths in storehouses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Let all the earth fear the Lord;",
          "Let all the inhabitants of the world stand in awe of Him."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "For He spoke, and it was done;",
          "He commanded, and it stood firm."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "The Lord nullifies the plan of nations;",
          "He frustrates the plans of peoples."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "The plan of the Lord stands forever,",
          "The plans of His heart from generation to generation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Blessed is the nation whose God is the Lord,",
          "The people He has chosen for His own inheritance."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¶The Lord looks from heaven;",
          "He sees all the sons of mankind;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "From His dwelling place He looks out",
          "On all the inhabitants of the earth,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "He who fashions the hearts of them all,",
          "He who understands all their works."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "The king is not saved by a mighty army;",
          "A warrior is not rescued by great strength."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A horse is a false hope for victory;",
          "Nor does it rescue anyone by its great strength."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¶Behold, the eye of the Lord is on those who fear Him,",
          "On those who wait for His faithfulness,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "To rescue their soul from death",
          "And to keep them alive in famine."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Our soul waits for the Lord;",
          "He is our help and our shield."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "For our heart rejoices in Him,",
          "Because we trust in His holy name."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Let Your favor, Lord, be upon us,",
          "Just as we have waited for You."
        ],
        "rlw_lines": []
      }
    ]
  },
