    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 34"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Lord, a Provider and the One Who Rescues Me."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Psalm of David, when he pretended to be insane before Abimelech, who drove him away, and he departed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "I will bless the Lord at all times;",
          "His praise shall continually be in my mouth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "My soul will make its boast in the Lord;",
          "The humble will hear it and rejoice."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Exalt the Lord with me,",
          "And let’s exalt His name together."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶I sought the Lord and He answered me,",
          "And rescued me from all my fears."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "They looked to Him and were radiant,",
          "And their faces will never be ashamed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "This wretched man cried out, and the Lord heard him,",
          "And saved him out of all his troubles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "The angel of the Lord encamps around those who fear Him,",
          "And rescues them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Taste and see that the Lord is good;",
          "How blessed is the man who takes refuge in Him!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Fear the Lord, you His saints;",
          "For to those who fear Him there is no lack of anything."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "The young lions do without and suffer hunger;",
          "But they who seek the Lord will not lack any good thing."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Come, you children, listen to me;",
          "I will teach you the fear of the Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Who is the person who desires life",
          "And loves length of days, that he may see good?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Keep your tongue from evil",
          "And your lips from speaking deceit."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Turn from evil and do good;",
          "Seek peace and pursue it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¶The eyes of the Lord are toward the righteous,",
          "And His ears are toward their cry for help."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "The face of the Lord is against evildoers,",
          "To eliminate the memory of them from the earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "The righteous cry out, and the Lord hears",
          "And rescues them from all their troubles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "The Lord is near to the brokenhearted",
          "And saves those who are crushed in spirit."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¶The afflictions of the righteous are many,",
          "But the Lord rescues him from them all."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "He protects all his bones,",
          "Not one of them is broken."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Evil will bring death to the wicked,",
          "And those who hate the righteous will suffer for their guilt."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "The Lord redeems the souls of His servants,",
          "And none of those who take refuge in Him will suffer for their guilt."
        ],
        "rlw_lines": []
      }
    ]
  },
