    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Psalm 26"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Protestation of Integrity and Prayer for Protection."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Vindicate me, Lord, for I have walked in my integrity,",
          "And I have trusted in the Lord without wavering."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Examine me, Lord, and put me to the test;",
          "Refine my mind and my heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For Your goodness is before my eyes,",
          "And I have walked in Your truth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "I do not sit with deceitful people,",
          "Nor will I go with pretenders."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "I hate the assembly of evildoers,",
          "And I will not sit with the wicked."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I will wash my hands in innocence,",
          "And I will go around Your altar, Lord,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "That I may proclaim with the voice of thanksgiving",
          "And declare all Your wonders."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Lord, I love the dwelling of Your house,",
          "And the place where Your glory remains."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Do not take my soul away along with sinners,",
          "Nor my life with men of bloodshed,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "In whose hands is a wicked scheme,",
          "And whose right hand is full of bribes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "But as for me, I will walk in my integrity;",
          "Redeem me, and be gracious to me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "My foot stands on level ground;",
          "In the congregations I will bless the Lord."
        ],
        "rlw_lines": []
      }
    ]
  },
