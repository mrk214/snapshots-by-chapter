    "book_usfm": "JOB",
    "name": "Job"
  },
  "chapter": {
    "chapter_usfm": "JOB.41",
    "is_chapter": true,
    "previous": {
      "usfm": "JOB.40",
      "human": "Job 40"
    },
    "current": {
