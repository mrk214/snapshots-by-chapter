        "lines": [
          "Thanksgiving to God for His Enduring Mercy"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh, give thanks to the Lord, for He is good!",
          "For His mercy endures forever."
