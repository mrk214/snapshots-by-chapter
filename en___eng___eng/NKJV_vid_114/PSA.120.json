        "lines": [
          "Plea for Relief from Bitter Foes"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Song of Ascents."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "In my distress I cried to the Lord,",
          "And He heard me."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deliver my soul, O Lord, from lying lips",
          "And from a deceitful tongue."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "What shall be given to you,",
          "Or what shall be done to you,",
          "You false tongue?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sharp arrows of the warrior,",
          "With coals of the broom tree!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Woe is me, that I dwell in Meshech,",
          "That I dwell among the tents of Kedar!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "My soul has dwelt too long",
          "With one who hates peace."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "I am for peace;",
          "But when I speak, they are for war."
        ],
        "rlw_lines": [],
        "np": true
      }
