    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Majesty of God in Judgment"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "To the Chief Musician. On stringed instruments. A Psalm of Asaph. A Song."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "In Judah God is known;",
          "His name is great in Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "In Salem also is His tabernacle,",
          "And His dwelling place in Zion."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "There He broke the arrows of the bow,",
          "The shield and sword of battle."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "You are more glorious and excellent",
          "Than the mountains of prey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "The stouthearted were plundered;",
          "They have sunk into their sleep;",
          "And none of the mighty men have found the use of their hands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "At Your rebuke, O God of Jacob,",
          "Both the chariot and horse were cast into a dead sleep."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "You, Yourself, are to be feared;",
          "And who may stand in Your presence",
          "When once You are angry?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "You caused judgment to be heard from heaven;",
          "The earth feared and was still,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "When God arose to judgment,",
          "To deliver all the oppressed of the earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Surely the wrath of man shall praise You;",
          "With the remainder of wrath You shall gird Yourself."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Make vows to the Lord your God, and pay them;",
          "Let all who are around Him bring presents to Him who ought to be feared."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "He shall cut off the spirit of princes;",
          "He is awesome to the kings of the earth."
        ],
        "rlw_lines": []
      }
    ]
  },
