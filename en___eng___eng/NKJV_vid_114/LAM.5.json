    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Prayer for Restoration"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Remember, O Lord, what has come upon us;",
          "Look, and behold our reproach!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Our inheritance has been turned over to aliens,",
          "And our houses to foreigners."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "We have become orphans and waifs,",
          "Our mothers are like widows."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "We pay for the water we drink,",
          "And our wood comes at a price."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "They pursue at our heels;",
          "We labor and have no rest."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "We have given our hand to the Egyptians",
          "And the Assyrians, to be satisfied with bread."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Our fathers sinned and are no more,",
          "But we bear their iniquities."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Servants rule over us;",
          "There is none to deliver us from their hand."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "We get our bread at the risk of our lives,",
          "Because of the sword in the wilderness."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Our skin is hot as an oven,",
          "Because of the fever of famine."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "They ravished the women in Zion,",
          "The maidens in the cities of Judah."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Princes were hung up by their hands,",
          "And elders were not respected."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Young men ground at the millstones;",
          "Boys staggered under loads of wood."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "The elders have ceased gathering at the gate,",
          "And the young men from their music."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "The joy of our heart has ceased;",
          "Our dance has turned into mourning."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "The crown has fallen from our head.",
          "Woe to us, for we have sinned!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Because of this our heart is faint;",
          "Because of these things our eyes grow dim;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Because of Mount Zion which is desolate,",
          "With foxes walking about on it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "You, O Lord, remain forever;",
          "Your throne from generation to generation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Why do You forget us forever,",
          "And forsake us for so long a time?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Turn us back to You, O Lord, and we will be restored;",
          "Renew our days as of old,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Unless You have utterly rejected us,",
          "And are very angry with us!"
        ],
        "rlw_lines": []
      }
    ]
  },
