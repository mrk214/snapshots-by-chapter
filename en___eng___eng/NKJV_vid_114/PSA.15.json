        ],
        "lines": [
          "He who does not backbite with his tongue,",
          "Nor does evil to his neighbor,",
          "Nor does he take up a reproach against his friend;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "In whose eyes a vile person is despised,",
