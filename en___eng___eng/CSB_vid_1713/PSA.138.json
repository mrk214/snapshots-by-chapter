    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Thankful Heart"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "I will give you thanks with all my heart;",
          "I will sing your praise before the heavenly beings. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "I will bow down toward your holy temple",
          "and give thanks to your name",
          "for your constant love and truth.",
          "You have exalted your name",
          "and your promise above everything else. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "On the day I called, you answered me;",
          "you increased strength within me. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "All the kings on earth will give you thanks, Lord,",
          "when they hear what you have promised. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "They will sing of the Lord’s ways,",
          "for the Lord’s glory is great."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Though the Lord is exalted,",
          "he takes note of the humble;",
          "but he knows the haughty from a distance."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "If I walk into the thick of danger,",
          "you will preserve my life",
          "from the anger of my enemies.",
          "You will extend your hand;",
          "your right hand will save me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "The Lord will fulfill his purpose for me.",
          "Lord, your faithful love endures forever;",
          "do not abandon the work of your hands."
        ],
        "rlw_lines": []
      }
    ]
  },
