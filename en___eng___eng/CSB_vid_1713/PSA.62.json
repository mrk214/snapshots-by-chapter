    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Trust in God Alone"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the choir director: according to Jeduthun. A psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "I am at rest in God alone;",
          "my salvation comes from him."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "He alone is my rock and my salvation,",
          "my stronghold; I will never be shaken."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "How long will you threaten a man?",
          "Will all of you attack",
          "as if he were a leaning wall",
          "or a tottering fence?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "They only plan to bring him down",
          "from his high position.",
          "They take pleasure in lying;",
          "they bless with their mouths,",
          "but they curse inwardly."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Rest in God alone, my soul,",
          "for my hope comes from him."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He alone is my rock and my salvation,",
          "my stronghold; I will not be shaken."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "My salvation and glory depend on God, my strong rock.",
          "My refuge is in God."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Trust in him at all times, you people;",
          "pour out your hearts before him.",
          "God is our refuge."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Common people are only a vapor;",
          "important people, an illusion.",
          "Together on a scale,",
          "they weigh less than a vapor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Place no trust in oppression",
          "or false hope in robbery.",
          "If wealth increases,",
          "don’t set your heart on it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "God has spoken once;",
          "I have heard this twice:",
          "strength belongs to God,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "and faithful love belongs to you, Lord.",
          "For you repay each according to his works."
        ],
        "rlw_lines": []
      }
    ]
  },
