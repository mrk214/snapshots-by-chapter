    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Lord Is Great"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hallelujah!",
          "Praise the name of the Lord.",
          "Give praise, you servants of the Lord"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "who stand in the house of the Lord,",
          "in the courts of the house of our God."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Praise the Lord, for the Lord is good;",
          "sing praise to his name, for it is delightful."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "For the Lord has chosen Jacob for himself,",
          "Israel as his treasured possession."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "For I know that the Lord is great;",
          "our Lord is greater than all gods."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "The Lord does whatever he pleases",
          "in heaven and on earth,",
          "in the seas and all the depths."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "He causes the clouds to rise from the ends of the earth.",
          "He makes lightning for the rain",
          "and brings the wind from his storehouses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "He struck down the firstborn of Egypt,",
          "both people and animals."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "He sent signs and wonders against you, Egypt,",
          "against Pharaoh and all his officials."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "He struck down many nations",
          "and slaughtered mighty kings:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Sihon king of the Amorites,",
          "Og king of Bashan,",
          "and all the kings of Canaan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "He gave their land as an inheritance,",
          "an inheritance to his people Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Lord, your name endures forever,",
          "your reputation, Lord,",
          "through all generations."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "For the Lord will vindicate his people",
          "and have compassion on his servants."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "The idols of the nations are of silver and gold,",
          "made by human hands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "They have mouths but cannot speak,",
          "eyes, but cannot see."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "They have ears but cannot hear;",
          "indeed, there is no breath in their mouths."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Those who make them are just like them,",
          "as are all who trust in them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "House of Israel, bless the Lord!",
          "House of Aaron, bless the Lord!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "House of Levi, bless the Lord!",
          "You who revere the Lord, bless the Lord!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Blessed be the Lord from Zion;",
          "he dwells in Jerusalem.",
          "Hallelujah!"
        ],
        "rlw_lines": []
      }
    ]
  },
