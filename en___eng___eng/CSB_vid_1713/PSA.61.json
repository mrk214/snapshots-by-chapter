    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Security in God"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the choir director: on stringed instruments. Of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "God, hear my cry;",
          "pay attention to my prayer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "I call to you from the ends of the earth",
          "when my heart is without strength.",
          "Lead me to a rock that is high above me,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "for you have been a refuge for me,",
          "a strong tower in the face of the enemy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "I will dwell in your tent forever",
          "and take refuge under the shelter of your wings."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "God, you have heard my vows;",
          "you have given a heritage",
          "to those who fear your name."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Add days to the king’s life;",
          "may his years span many generations."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "May he sit enthroned before God forever.",
          "Appoint faithful love and truth to guard him."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Then I will continually sing of your name,",
          "fulfilling my vows day by day."
        ],
        "rlw_lines": []
      }
    ]
  },
