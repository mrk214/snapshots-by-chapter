    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "God Restores Jerusalem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hallelujah!",
          "How good it is to sing to our God,",
          "for praise is pleasant and lovely."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "The Lord rebuilds Jerusalem;",
          "he gathers Israel’s exiled people."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "He heals the brokenhearted",
          "and bandages their wounds."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He counts the number of the stars;",
          "he gives names to all of them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Our Lord is great, vast in power;",
          "his understanding is infinite. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "The Lord helps the oppressed",
          "but brings the wicked to the ground."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sing to the Lord with thanksgiving;",
          "play the lyre to our God,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "who covers the sky with clouds,",
          "prepares rain for the earth,",
          "and causes grass to grow on the hills."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "He provides the animals with their food,",
          "and the young ravens what they cry for."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "He is not impressed by the strength of a horse;",
          "he does not value the power of a warrior. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "The Lord values those who fear him,",
          "those who put their hope in his faithful love."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Exalt the Lord, Jerusalem;",
          "praise your God, Zion!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "For he strengthens the bars of your city gates",
          "and blesses your children within you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "He endows your territory with prosperity; ,",
          "he satisfies you with the finest wheat."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "He sends his command throughout the earth;",
          "his word runs swiftly."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "He spreads snow like wool;",
          "he scatters frost like ashes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "he throws his hailstones like crumbs.",
          "Who can withstand his cold?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "He sends his word and melts them;",
          "he unleashes his winds, and the water flows."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "He declares his word to Jacob,",
          "his statutes and judgments to Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "He has not done this for every nation;",
          "they do not know his judgments.",
          "Hallelujah!"
        ],
        "rlw_lines": []
      }
    ]
  },
