    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Glory to God Alone"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Not to us, Lord, not to us,",
          "but to your name give glory",
          "because of your faithful love, because of your truth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Why should the nations say,",
          "“Where is their God? ”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Our God is in heaven",
          "and does whatever he pleases."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Their idols are silver and gold,",
          "made by human hands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "They have mouths but cannot speak,",
          "eyes, but cannot see."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "They have ears but cannot hear,",
          "noses, but cannot smell."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "They have hands but cannot feel,",
          "feet, but cannot walk.",
          "They cannot make a sound with their throats."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Those who make them are just like them,",
          "as are all who trust in them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Israel, trust in the Lord!",
          "He is their help and shield."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "House of Aaron, trust in the Lord!",
          "He is their help and shield."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "You who fear the Lord, trust in the Lord!",
          "He is their help and shield."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "The Lord remembers us and will bless us.",
          "He will bless the house of Israel;",
          "he will bless the house of Aaron;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "he will bless those who fear the Lord —",
          "small and great alike."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "May the Lord add to your numbers,",
          "both yours and your children’s."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "May you be blessed by the Lord,",
          "the Maker of heaven and earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "The heavens are the Lord’s,",
          "but the earth he has given to the human race."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "It is not the dead who praise the Lord,",
          "nor any of those descending into the silence of death."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "But we will bless the Lord,",
          "both now and forever.",
          "Hallelujah!"
        ],
        "rlw_lines": []
      }
    ]
  },
