    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Prayer for Mercy"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the choir director: with stringed instruments, according to Sheminith. A psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Lord, do not rebuke me in your anger;",
          "do not discipline me in your wrath."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Be gracious to me, Lord, for I am weak; ,",
          "heal me, Lord, for my bones are shaking;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "my whole being is shaken with terror.",
          "And you, Lord #— #how long?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Turn, Lord! Rescue me;",
          "save me because of your faithful love."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "For there is no remembrance of you in death;",
          "who can thank you in Sheol?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I am weary from my groaning;",
          "with my tears I dampen my bed",
          "and drench my couch every night."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "My eyes are swollen from grief;",
          "they grow old because of all my enemies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Depart from me, all evildoers,",
          "for the Lord has heard the sound of my weeping."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "The Lord has heard my plea for help;",
          "the Lord accepts my prayer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "All my enemies will be ashamed and shake with terror;",
          "they will turn back and suddenly be disgraced."
        ],
        "rlw_lines": []
      }
    ]
  },
