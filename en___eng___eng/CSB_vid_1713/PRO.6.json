    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Financial Entanglements"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "My son, if you have put up security for your neighbor",
          "or entered into an agreement with a stranger,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "you have been snared by the words of your mouth —",
          "trapped by the words from your mouth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Do this, then, my son, and free yourself,",
          "for you have put yourself in your neighbor’s power:",
          "Go, humble yourself, and plead with your neighbor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Don’t give sleep to your eyes",
          "or slumber to your eyelids."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Escape like a gazelle from a hunter,",
          "like a bird from a hunter’s trap. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Laziness"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Go to the ant, you slacker!",
          "Observe its ways and become wise."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Without leader, administrator, or ruler,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "it prepares its provisions in summer;",
          "it gathers its food during harvest."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "How long will you stay in bed, you slacker?",
          "When will you get up from your sleep?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A little sleep, a little slumber,",
          "a little folding of the arms to rest,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "and your poverty will come like a robber,",
          "your need, like a bandit."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Malicious Man"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A worthless person, a wicked man",
          "goes around speaking dishonestly,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "winking his eyes, signaling with his feet,",
          "and gesturing with his fingers."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "He always plots evil with perversity in his heart;",
          "he stirs up trouble."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Therefore calamity will strike him suddenly;",
          "he will be shattered instantly, beyond recovery."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "What the Lord Hates"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "The Lord hates six things;",
          "in fact, seven are detestable to him:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "arrogant eyes, a lying tongue,",
          "hands that shed innocent blood,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "a heart that plots wicked schemes,",
          "feet eager to run to evil,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "a lying witness who gives false testimony,",
          "and one who stirs up trouble among brothers."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Warning against Adultery"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "My son, keep your father’s command,",
          "and don’t reject your mother’s teaching."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Always bind them to your heart;",
          "tie them around your neck."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "When you walk here and there, they will guide you;",
          "when you lie down, they will watch over you;",
          "when you wake up, they will talk to you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "For a command is a lamp, teaching is a light,",
          "and corrective discipline is the way to life."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "They will protect you from an evil woman,",
          "from the flattering tongue of a wayward woman."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Don’t lust in your heart for her beauty",
          "or let her captivate you with her eyelashes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "For a prostitute’s fee is only a loaf of bread,",
          "but the wife of another man goes after a precious life."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Can a man embrace fire",
          "and his clothes not be burned?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Can a man walk on burning coals",
          "without scorching his feet?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "So it is with the one who sleeps with",
          "another man’s wife;",
          "no one who touches her will go unpunished."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "People don’t despise the thief if he steals",
          "to satisfy himself when he is hungry."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Still, if caught, he must pay seven times as much;",
          "he must give up all the wealth in his house."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "The one who commits adultery lacks sense;",
          "whoever does so destroys himself."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "He will get a beating and dishonor,",
          "and his disgrace will never be removed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "For jealousy enrages a husband,",
          "and he will show no mercy when he takes revenge."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "He will not be appeased by anything",
          "or be persuaded by lavish bribes."
        ],
        "rlw_lines": []
      }
    ]
  },
