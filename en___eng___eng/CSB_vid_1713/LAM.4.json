{"version":{"version_id":1713,"local_abbreviation":"CSB","local_title":"Christian Standard Bible","language":{"iso_639_1":"en","iso_639_3":"eng","language_tag":"eng","local_name":"English","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-en-eng","publisher":{"name":"LifeWay Christian Resources"},"copyright":{"html":"<p>© 2017 Holman Bible Publishers</p>","text":"© 2017 Holman Bible Publishers"}},"book":{"book_usfm":"LAM","name":"Lamentations"},"chapter":{"chapter_usfm":"LAM.4","is_chapter":true,"previous":{"usfm":"LAM.3","human":"Lamentations 3","canonical":true,"toc":true},"current":{"usfm":"LAM.4","human":"Lamentations 4"},"next":{"usfm":"LAM.5","human":"Lamentations 5","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Terrors of the Besieged City"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["א Aleph"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["How the gold has become tarnished,","the fine gold become dull!","The stones of the temple lie scattered","at the head of every street."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ב Beth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Zion’s precious children —","once worth their weight in pure gold —","how they are regarded as clay jars,","the work of a potter’s hands!"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ג Gimel"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Even jackals offer their breasts","to nurse their young,","but my dear people have become cruel","like ostriches in the wilderness."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ד Daleth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["The nursing baby’s tongue","clings to the roof of his mouth from thirst.","Infants beg for food,","but no one gives them any."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ה He"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Those who used to eat delicacies","are destitute in the streets;","those who were reared in purple garments","huddle in trash heaps."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ו Waw"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["The punishment of my dear people","is greater than that of Sodom,","which was overthrown in an instant","without a hand laid on it."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ז Zayin"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Her dignitaries were brighter than snow,","whiter than milk;","their bodies were more ruddy than coral,","their appearance like lapis lazuli."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ח Cheth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Now they appear darker than soot;","they are not recognized in the streets.","Their skin has shriveled on their bones;","it has become dry like wood."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ט Teth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Those slain by the sword are better off","than those slain by hunger,","who waste away, pierced with pain","because the fields lack produce."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["י Yod"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["The hands of compassionate women","have cooked their own children;","they became their food","during the destruction of my dear people."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["כ Kaph"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["The Lord has exhausted his wrath,","poured out his burning anger;","he has ignited a fire in Zion,","and it has consumed her foundations."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ל Lamed"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["The kings of the earth","and all the world’s inhabitants did not believe","that an enemy or adversary","could enter Jerusalem’s gates."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["מ Mem"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Yet it happened because of the sins of her prophets","and the iniquities of her priests,","who shed the blood of the righteous within her."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["נ Nun"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Blind, they stumbled in the streets,","defiled by this blood,","so that no one dared","to touch their garments."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ס Samek"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["“Stay away! Unclean! ” people shouted at them.","“Away, away! Don’t touch us! ”","So they wandered aimlessly.","It was said among the nations,","“They can stay here no longer.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["פ Pe"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["The Lord himself has scattered them;","he no longer watches over them.","The priests are not respected;","the elders find no favor."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ע Ayin"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["All the while our eyes were failing","as we looked in vain for help;","we watched from our towers","for a nation that would not save us."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["צ Tsade"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Our steps were closely followed","so that we could not walk in our streets.","Our end approached; our time ran out.","Our end had come!"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ק Qoph"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Those who chased us were swifter","than eagles in the sky;","they relentlessly pursued us over the mountains","and ambushed us in the wilderness."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ר Resh"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["The Lord’s anointed, the breath of our life, ,","was captured in their traps.","We had said about him,","“We will live under his protection among the nations.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ׂש Sin"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["So rejoice and be glad, Daughter Edom,","you resident of the land of Uz!","Yet the cup will pass to you as well;","you will get drunk and expose yourself."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ת Taw"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Daughter Zion, your punishment is complete;","he will not lengthen your exile.","But he will punish your iniquity, Daughter Edom,","and will expose your sins."],"rlw_lines":[]}]}}