{"version":{"version_id":1713,"local_abbreviation":"CSB","local_title":"Christian Standard Bible","language":{"iso_639_1":"en","iso_639_3":"eng","language_tag":"eng","local_name":"English","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-en-eng","publisher":{"name":"LifeWay Christian Resources"},"copyright":{"html":"<p>© 2017 Holman Bible Publishers</p>","text":"© 2017 Holman Bible Publishers"}},"book":{"book_usfm":"LAM","name":"Lamentations"},"chapter":{"chapter_usfm":"LAM.1","is_chapter":true,"previous":{"usfm":"JER.52","human":"Jeremiah 52","canonical":true,"toc":true},"current":{"usfm":"LAM.1","human":"Lamentations 1"},"next":{"usfm":"LAM.2","human":"Lamentations 2","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Lament over Jerusalem"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["א Aleph"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["How she sits alone,","the city once crowded with people!","She who was great among the nations","has become like a widow.","The princess among the provinces","has been put to forced labor."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ב Beth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["She weeps bitterly during the night,","with tears on her cheeks.","There is no one to offer her comfort,","not one from all her lovers. ,","All her friends have betrayed her;","they have become her enemies."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ג Gimel"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Judah has gone into exile","following affliction and harsh slavery;","she lives among the nations","but finds no place to rest.","All her pursuers have overtaken her","in narrow places."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ד Daleth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["The roads to Zion mourn,","for no one comes to the appointed festivals.","All her gates are deserted;","her priests groan,","her young women grieve,","and she herself is bitter."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ה He"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Her adversaries have become her masters;","her enemies are at ease,","for the Lord has made her suffer","because of her many transgressions.","Her children have gone away","as captives before the adversary."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ו Waw"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["All the splendor has vanished","from Daughter Zion.","Her leaders are like stags","that find no pasture;","they stumble away exhausted","before the hunter."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ז Zayin"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["During the days of her affliction and homelessness","Jerusalem remembers all her precious belongings","that were hers in days of old.","When her people fell into the adversary’s hand,","she had no one to help.","The adversaries looked at her,","laughing over her downfall."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ח Cheth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Jerusalem has sinned grievously;","therefore, she has become an object of scorn.","All who honored her now despise her,","for they have seen her nakedness.","She herself groans and turns away."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ט Teth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Her uncleanness stains her skirts.","She never considered her end.","Her downfall was astonishing;","there was no one to comfort her.","Lord, look on my affliction,","for the enemy boasts."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["י Yod"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["The adversary has seized","all her precious belongings.","She has even seen the nations","enter her sanctuary —","those you had forbidden","to enter your assembly."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["כ Kaph"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["All her people groan","while they search for bread.","They have traded their precious belongings for food","in order to stay alive.","Lord, look and see","how I have become despised."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ל Lamed"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Is this nothing to you, all you who pass by?","Look and see!","Is there any pain like mine,","which was dealt out to me,","which the Lord made me suffer","on the day of his burning anger?"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["מ Mem"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["He sent fire from on high into my bones;","he made it descend. ,","He spread a net for my feet","and turned me back.","He made me desolate,","sick all day long."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["נ Nun"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["My transgressions have been formed into a yoke, ,,","fastened together by his hand;","they have been placed on my neck,","and the Lord has broken my strength.","He has handed me over","to those I cannot withstand."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ס Samek"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["The Lord has rejected","all the mighty men within me.","He has summoned an army against me","to crush my young warriors.","The Lord has trampled Virgin Daughter Judah","like grapes in a winepress."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ע Ayin"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["I weep because of these things;","my eyes flow with tears.","For there is no one nearby to comfort me,","no one to keep me alive.","My children are desolate","because the enemy has prevailed."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["פ Pe"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Zion stretches out her hands;","there is no one to comfort her.","The Lord has issued a decree against Jacob","that his neighbors should be his adversaries.","Jerusalem has become","something impure among them."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["צ Tsade"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["The Lord is just,","for I have rebelled against his command.","Listen, all you people;","look at my pain.","My young women and young men","have gone into captivity."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ק Qoph"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["I called to my lovers,","but they betrayed me.","My priests and elders","perished in the city","while searching for food","to keep themselves alive."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ר Resh"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Lord, see how I am in distress.","I am churning within;","my heart is broken,","for I have been very rebellious.","Outside, the sword takes the children;","inside, there is death."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["שׁ Shin"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["People have heard me groaning,","but there is no one to comfort me.","All my enemies have heard of my misfortune;","they are glad that you have caused it.","Bring on the day you have announced,","so that they may become like me."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ת Taw"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Let all their wickedness come before you,","and deal with them","as you have dealt with me","because of all my transgressions.","For my groans are many,","and I am sick at heart."],"rlw_lines":[]}]}}