    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Plea for Protection"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the choir director. A psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Lord, I seek refuge in you;",
          "let me never be disgraced.",
          "Save me by your righteousness."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Listen closely to me; rescue me quickly.",
          "Be a rock of refuge for me,",
          "a mountain fortress to save me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For you are my rock and my fortress;",
          "you lead and guide me",
          "for your name’s sake."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "You will free me from the net",
          "that is secretly set for me,",
          "for you are my refuge."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Into your hand I entrust my spirit;",
          "you have redeemed me, Lord, God of truth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I hate those who are devoted to worthless idols,",
          "but I trust in the Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "I will rejoice and be glad in your faithful love",
          "because you have seen my affliction.",
          "You know the troubles of my soul"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "and have not handed me over to the enemy.",
          "You have set my feet in a spacious place."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Be gracious to me, Lord,",
          "because I am in distress;",
          "my eyes are worn out from frustration —",
          "my whole being as well."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Indeed, my life is consumed with grief",
          "and my years with groaning;",
          "my strength has failed",
          "because of my iniquity,",
          "and my bones waste away."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "I am ridiculed by all my adversaries",
          "and even by my neighbors.",
          "I am dreaded by my acquaintances;",
          "those who see me in the street run from me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "I am forgotten: gone from memory",
          "like a dead person #— #like broken pottery."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "I have heard the gossip of many;",
          "terror is on every side.",
          "When they conspired against me,",
          "they plotted to take my life."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "But I trust in you, Lord;",
          "I say, “You are my God.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "The course of my life is in your power;",
          "rescue me from the power of my enemies",
          "and from my persecutors."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Make your face shine on your servant;",
          "save me by your faithful love."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Lord, do not let me be disgraced when I call on you.",
          "Let the wicked be disgraced;",
          "let them be quiet , in Sheol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Let lying lips",
          "that arrogantly speak against the righteous",
          "in proud contempt be silenced."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "How great is your goodness,",
          "which you have stored up for those who fear you.",
          "In the presence of everyone you have acted",
          "for those who take refuge in you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "You hide them in the protection of your presence;",
          "you conceal them in a shelter",
          "from human schemes,",
          "from quarrelsome tongues."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Blessed be the Lord,",
          "for he has wondrously shown his faithful love to me",
          "in a city under siege."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "In my alarm I said,",
          "“I am cut off from your sight.”",
          "But you heard the sound of my pleading",
          "when I cried to you for help."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Love the Lord, all his faithful ones.",
          "The Lord protects the loyal,",
          "but fully repays the arrogant."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Be strong, and let your heart be courageous,",
          "all you who put your hope in the Lord."
        ],
        "rlw_lines": []
      }
    ]
  },
