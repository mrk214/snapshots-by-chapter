    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Zion, the City of God"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A psalm of the sons of Korah. A song."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "The city he founded is on the holy mountains."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "The Lord loves Zion’s city gates",
          "more than all the dwellings of Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Glorious things are said about you,",
          "city of God."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“I will make a record of those who know me:",
          "Rahab, Babylon, Philistia, Tyre, and Cush —",
          "each one was born there.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "And it will be said of Zion,",
          "“This one and that one were born in her.”",
          "The Most High himself will establish her."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "When he registers the peoples,",
          "the Lord will record,",
          "“This one was born there.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Singers and dancers alike will say,",
          "“My whole source of joy is in you.”"
        ],
        "rlw_lines": []
      }
    ]
  },
