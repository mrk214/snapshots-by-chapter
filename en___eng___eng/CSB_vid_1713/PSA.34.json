    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Lord Delivers the Righteous"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Concerning David, when he pretended to be insane in the presence of Abimelech, who drove him out, and he departed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "I will bless the Lord at all times;",
          "his praise will always be on my lips."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "I will boast in the Lord;",
          "the humble will hear and be glad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Proclaim the Lord’s greatness with me;",
          "let us exalt his name together."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "I sought the Lord, and he answered me",
          "and rescued me from all my fears."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Those who look to him are radiant with joy;",
          "their faces will never be ashamed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "This poor man cried, and the Lord heard him",
          "and saved him from all his troubles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "The angel of the Lord encamps",
          "around those who fear him, and rescues them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Taste and see that the Lord is good.",
          "How happy is the person who takes refuge in him!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "You who are his holy ones, fear the Lord,",
          "for those who fear him lack nothing."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Young lions lack food and go hungry,",
          "but those who seek the Lord",
          "will not lack any good thing."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Come, children, listen to me;",
          "I will teach you the fear of the Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Who is someone who desires life,",
          "loving a long life to enjoy what is good?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Keep your tongue from evil",
          "and your lips from deceitful speech."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Turn away from evil and do what is good;",
          "seek peace and pursue it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "The eyes of the Lord are on the righteous,",
          "and his ears are open to their cry for help."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "The face of the Lord is set",
          "against those who do what is evil,",
          "to remove all memory of them from the earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "The righteous cry out, and the Lord hears,",
          "and rescues them from all their troubles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "The Lord is near the brokenhearted;",
          "he saves those crushed in spirit."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "One who is righteous has many adversities,",
          "but the Lord rescues him from them all."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "He protects all his bones;",
          "not one of them is broken."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Evil brings death to the wicked,",
          "and those who hate the righteous will be punished."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "The Lord redeems the life of his servants,",
          "and all who take refuge in him will not be punished."
        ],
        "rlw_lines": []
      }
    ]
  },
