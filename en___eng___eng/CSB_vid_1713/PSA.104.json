    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "God the Creator"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "My soul, bless the Lord!",
          "Lord my God, you are very great;",
          "you are clothed with majesty and splendor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "He wraps himself in light as if it were a robe,",
          "spreading out the sky like a canopy,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "laying the beams of his palace",
          "on the waters above,",
          "making the clouds his chariot,",
          "walking on the wings of the wind,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "and making the winds his messengers,",
          "flames of fire his servants."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "He established the earth on its foundations;",
          "it will never be shaken."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "You covered it with the deep",
          "as if it were a garment;",
          "the water stood above the mountains."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "At your rebuke the water fled;",
          "at the sound of your thunder they hurried away —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "mountains rose and valleys sank —",
          "to the place you established for them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "You set a boundary they cannot cross;",
          "they will never cover the earth again."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "He causes the springs to gush into the valleys;",
          "they flow between the mountains."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "They supply water for every wild beast;",
          "the wild donkeys quench their thirst."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "The birds of the sky live beside the springs;",
          "they make their voices heard among the foliage."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "He waters the mountains from his palace;",
          "the earth is satisfied by the fruit of your labor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "He causes grass to grow for the livestock",
          "and provides crops for man to cultivate,",
          "producing food from the earth,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "wine that makes human hearts glad —",
          "making his face shine with oil —",
          "and bread that sustains human hearts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "The trees of the Lord flourish,",
          "the cedars of Lebanon that he planted."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "There the birds make their nests;",
          "storks make their homes in the pine trees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "The high mountains are for the wild goats;",
          "the cliffs are a refuge for hyraxes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "He made the moon to mark the festivals;",
          "the sun knows when to set."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "You bring darkness, and it becomes night,",
          "when all the forest animals stir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "The young lions roar for their prey",
          "and seek their food from God."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "The sun rises; they go back",
          "and lie down in their dens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Man goes out to his work",
          "and to his labor until evening."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "How countless are your works, Lord!",
          "In wisdom you have made them all;",
          "the earth is full of your creatures. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Here is the sea, vast and wide,",
          "teeming with creatures beyond number —",
          "living things both large and small."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "There the ships move about,",
          "and Leviathan, which you formed to play there."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "All of them wait for you",
          "to give them their food at the right time."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "When you give it to them,",
          "they gather it;",
          "when you open your hand,",
          "they are satisfied with good things."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "When you hide your face,",
          "they are terrified;",
          "when you take away their breath,",
          "they die and return to the dust."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "When you send your breath,",
          "they are created,",
          "and you renew the surface of the ground."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "May the glory of the Lord endure forever;",
          "may the Lord rejoice in his works."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "He looks at the earth, and it trembles;",
          "he touches the mountains,",
          "and they pour out smoke."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "I will sing to the Lord all my life;",
          "I will sing praise to my God while I live."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "May my meditation be pleasing to him;",
          "I will rejoice in the Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "May sinners vanish from the earth",
          "and wicked people be no more.",
          "My soul, bless the Lord!",
          "Hallelujah!"
        ],
        "rlw_lines": []
      }
    ]
  },
