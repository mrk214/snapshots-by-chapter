    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lament and Petition"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A prayer of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Listen, Lord, and answer me,",
          "for I am poor and needy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Protect my life, for I am faithful.",
          "You are my God; save your servant who trusts in you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Be gracious to me, Lord,",
          "for I call to you all day long."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Bring joy to your servant’s life,",
          "because I appeal to you, Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "For you, Lord, are kind and ready to forgive,",
          "abounding in faithful love to all who call on you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Lord, hear my prayer;",
          "listen to my cries for mercy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "I call on you in the day of my distress,",
          "for you will answer me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Lord, there is no one like you among the gods,",
          "and there are no works like yours."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "All the nations you have made",
          "will come and bow down before you, Lord,",
          "and will honor your name."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "For you are great and perform wonders;",
          "you alone are God."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Teach me your way, Lord,",
          "and I will live by your truth.",
          "Give me an undivided mind to fear your name."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "I will praise you with all my heart, Lord my God,",
          "and will honor your name forever."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "For your faithful love for me is great,",
          "and you rescue my life from the depths of Sheol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "God, arrogant people have attacked me;",
          "a gang of ruthless men intends to kill me.",
          "They do not let you guide them. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "But you, Lord, are a compassionate and gracious God,",
          "slow to anger and abounding in faithful love and truth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Turn to me and be gracious to me.",
          "Give your strength to your servant;",
          "save the son of your female servant."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Show me a sign of your goodness;",
          "my enemies will see and be put to shame",
          "because you, Lord, have helped and comforted me."
        ],
        "rlw_lines": []
      }
    ]
  },
