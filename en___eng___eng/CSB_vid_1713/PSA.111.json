    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Praise for the Lord’s Works"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hallelujah!",
          "I will praise the Lord with all my heart",
          "in the assembly of the upright and in the congregation."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "The Lord’s works are great,",
          "studied by all who delight in them."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "All that he does is splendid and majestic;",
          "his righteousness endures forever."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He has caused his wondrous works to be remembered.",
          "The Lord is gracious and compassionate."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "He has provided food for those who fear him;",
          "he remembers his covenant forever."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He has shown his people the power of his works",
          "by giving them the inheritance of the nations."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "The works of his hands are truth and justice;",
          "all his instructions are trustworthy."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "They are established forever and ever,",
          "enacted in truth and in uprightness."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "He has sent redemption to his people.",
          "He has ordained his covenant forever.",
          "His name is holy and awe-inspiring."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "The fear of the Lord is the beginning of wisdom;",
          "all who follow his instructions have good insight.",
          "His praise endures forever."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
