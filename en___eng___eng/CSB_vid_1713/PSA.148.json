    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Creation’s Praise of the Lord"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hallelujah!",
          "Praise the Lord from the heavens;",
          "praise him in the heights."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Praise him, all his angels;",
          "praise him, all his heavenly armies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Praise him, sun and moon;",
          "praise him, all you shining stars."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Praise him, highest heavens,",
          "and you waters above the heavens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Let them praise the name of the Lord,",
          "for he commanded, and they were created."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He set them in position forever and ever;",
          "he gave an order that will never pass away."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Praise the Lord from the earth,",
          "all sea monsters and ocean depths,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "lightning and hail, snow and cloud,",
          "stormy wind that executes his command,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "mountains and all hills,",
          "fruit trees and all cedars,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "wild animals and all cattle,",
          "creatures that crawl and flying birds,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "kings of the earth and all peoples,",
          "princes and all judges of the earth,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "young men as well as young women,",
          "old and young together."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Let them praise the name of the Lord,",
          "for his name alone is exalted.",
          "His majesty covers heaven and earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "He has raised up a horn for his people,",
          "resulting in praise to all his faithful ones,",
          "to the Israelites, the people close to him.",
          "Hallelujah!"
        ],
        "rlw_lines": []
      }
    ]
  },
