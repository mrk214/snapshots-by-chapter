    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "I am a wildflower of Sharon,",
          "a lily of the valleys."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Man"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Like a lily among thorns,",
          "so is my darling among the young women."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Woman"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Like an apricot tree among the trees of the forest,",
          "so is my love among the young men.",
          "I delight to sit in his shade,",
          "and his fruit is sweet to my taste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He brought me to the banquet hall, ,",
          "and he looked on me with love. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sustain me with raisins;",
          "refresh me with apricots,",
          "for I am lovesick."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "May his left hand be under my head,",
          "and his right arm embrace me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Young women of Jerusalem, I charge you",
          "by the gazelles and the wild does of the field,",
          "do not stir up or awaken love",
          "until the appropriate time. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Listen! My love is approaching.",
          "Look! Here he comes,",
          "leaping over the mountains,",
          "bounding over the hills."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "My love is like a gazelle",
          "or a young stag.",
          "See, he is standing behind our wall,",
          "gazing through the windows,",
          "peering through the lattice."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "My love calls to me:"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Man"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Arise, my darling.",
          "Come away, my beautiful one."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "For now the winter is past;",
          "the rain has ended and gone away."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "The blossoms appear in the countryside.",
          "The time of singing has come,",
          "and the turtledove’s cooing is heard in our land."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "The fig tree ripens its figs;",
          "the blossoming vines give off their fragrance.",
          "Arise, my darling.",
          "Come away, my beautiful one."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "My dove, in the clefts of the rock,",
          "in the crevices of the cliff,",
          "let me see your face,",
          "let me hear your voice;",
          "for your voice is sweet,",
          "and your face is lovely."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Woman"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Catch the foxes for us —",
          "the little foxes that ruin the vineyards —",
          "for our vineyards are in bloom."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Woman"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "My love is mine and I am his;",
          "he feeds among the lilies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Until the day breaks",
          "and the shadows flee,",
          "turn around, my love, and be like a gazelle",
          "or a young stag on the divided mountains. ,"
        ],
        "rlw_lines": []
      }
    ]
  },
