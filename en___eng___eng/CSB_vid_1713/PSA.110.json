    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Priestly King"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "This is the declaration of the Lord",
          "to my Lord:",
          "“Sit at my right hand",
          "until I make your enemies your footstool.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "The Lord will extend your mighty scepter from Zion.",
          "Rule over your surrounding enemies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Your people will volunteer",
          "on your day of battle. ,",
          "In holy splendor, from the womb of the dawn,",
          "the dew of your youth belongs to you. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "The Lord has sworn an oath and will not take it back:",
          "“You are a priest forever",
          "according to the pattern of Melchizedek.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "The Lord is at your right hand;",
          "he will crush kings on the day of his anger."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He will judge the nations, heaping up corpses;",
          "he will crush leaders over the entire world."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "He will drink from the brook by the road;",
          "therefore, he will lift up his head."
        ],
        "rlw_lines": []
      }
    ]
  },
