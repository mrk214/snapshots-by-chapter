    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Praise for God’s Protection"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the choir director: “Do Not Destroy.” A Miktam of David. When he fled before Saul into the cave."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Be gracious to me, God, be gracious to me,",
          "for I take refuge in you.",
          "I will seek refuge in the shadow of your wings",
          "until danger passes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "I call to God Most High,",
          "to God who fulfills his purpose for me. ,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "He reaches down from heaven and saves me,",
          "challenging the one who tramples me."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "God sends his faithful love and truth."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "I am surrounded by lions;",
          "I lie down among devouring lions —",
          "people whose teeth are spears and arrows,",
          "whose tongues are sharp swords."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "God, be exalted above the heavens;",
          "let your glory be over the whole earth."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "They prepared a net for my steps;",
          "I was despondent.",
          "They dug a pit ahead of me,",
          "but they fell into it!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "My heart is confident, God, my heart is confident.",
          "I will sing; I will sing praises."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Wake up, my soul!",
          "Wake up, harp and lyre!",
          "I will wake up the dawn."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "I will praise you, Lord, among the peoples;",
          "I will sing praises to you among the nations."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "For your faithful love is as high as the heavens;",
          "your faithfulness reaches the clouds."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "God, be exalted above the heavens;",
          "let your glory be over the whole earth."
        ],
        "rlw_lines": [],
        "np": true
      }
