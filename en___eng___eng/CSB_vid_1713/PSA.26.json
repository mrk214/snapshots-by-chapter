    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Prayer for Vindication"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Vindicate me, Lord,",
          "because I have lived with integrity",
          "and have trusted in the Lord without wavering."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Test me, Lord, and try me;",
          "examine my heart and mind."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For your faithful love guides me,",
          "and I live by your truth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "I do not sit with the worthless",
          "or associate with hypocrites."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "I hate a crowd of evildoers,",
          "and I do not sit with the wicked."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I wash my hands in innocence",
          "and go around your altar, Lord,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "raising my voice in thanksgiving",
          "and telling about your wondrous works."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Lord, I love the house where you dwell,",
          "the place where your glory resides."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Do not destroy me along with sinners,",
          "or my life along with men of bloodshed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "in whose hands are evil schemes",
          "and whose right hands are filled with bribes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "But I live with integrity;",
          "redeem me and be gracious to me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "My foot stands on level ground;",
          "I will bless the Lord in the assemblies."
        ],
        "rlw_lines": []
      }
    ]
  },
