{"version":{"version_id":1713,"local_abbreviation":"CSB","local_title":"Christian Standard Bible","language":{"iso_639_1":"en","iso_639_3":"eng","language_tag":"eng","local_name":"English","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-en-eng","publisher":{"name":"LifeWay Christian Resources"},"copyright":{"html":"<p>© 2017 Holman Bible Publishers</p>","text":"© 2017 Holman Bible Publishers"}},"book":{"book_usfm":"LAM","name":"Lamentations"},"chapter":{"chapter_usfm":"LAM.3","is_chapter":true,"previous":{"usfm":"LAM.2","human":"Lamentations 2","canonical":true,"toc":true},"current":{"usfm":"LAM.3","human":"Lamentations 3"},"next":{"usfm":"LAM.4","human":"Lamentations 4","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Hope through God’s Mercy"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["א Aleph"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["I am the man who has seen affliction","under the rod of God’s wrath."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["He has driven me away and forced me to walk","in darkness instead of light."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Yes, he repeatedly turns his hand","against me all day long."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ב Beth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["He has worn away my flesh and skin;","he has broken my bones."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["He has laid siege against me,","encircling me with bitterness and hardship."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["He has made me dwell in darkness","like those who have been dead for ages."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ג Gimel"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["He has walled me in so I cannot get out;","he has weighed me down with chains."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Even when I cry out and plead for help,","he blocks out my prayer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["He has walled in my ways with blocks of stone;","he has made my paths crooked."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ד Daleth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["He is a bear waiting in ambush,","a lion in hiding."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["He forced me off my way and tore me to pieces;","he left me desolate."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["He strung his bow","and set me as the target for his arrow."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ה He"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["He pierced my kidneys","with shafts from his quiver."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["I am a laughingstock to all my people,","mocked by their songs all day long."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["He filled me with bitterness,","satiated me with wormwood."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ו Waw"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["He ground my teeth with gravel","and made me cower in the dust."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["I have been deprived of peace;","I have forgotten what prosperity is."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Then I thought, “My future is lost,","as well as my hope from the Lord.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ז Zayin"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Remember my affliction and my homelessness,","the wormwood and the poison."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["I continually remember them","and have become depressed. ,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Yet I call this to mind,","and therefore I have hope:"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ח Cheth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Because of the Lord’s faithful love","we do not perish,","for his mercies never end."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["They are new every morning;","great is your faithfulness!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["I say, “The Lord is my portion,","therefore I will put my hope in him.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ט Teth"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["The Lord is good to those who wait for him,","to the person who seeks him."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["It is good to wait quietly","for salvation from the Lord."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["It is good for a man to bear the yoke","while he is still young."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["י Yod"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Let him sit alone and be silent,","for God has disciplined him."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Let him put his mouth in the dust —","perhaps there is still hope."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Let him offer his cheek","to the one who would strike him;","let him be filled with disgrace."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["כ Kaph"],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["For the Lord","will not reject us forever."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["Even if he causes suffering,","he will show compassion","according to the abundance of his faithful love."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["For he does not enjoy bringing affliction","or suffering on mankind."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ל Lamed"],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Crushing all the prisoners of the land","beneath one’s feet,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["denying justice to a man","in the presence of the Most High,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[36],"lines":["or subverting a person in his lawsuit —","the Lord does not approve of these things."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["מ Mem"],"rlw_lines":[]},{"type":"verse","verse_numbers":[37],"lines":["Who is there who speaks and it happens,","unless the Lord has ordained it?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[38],"lines":["Do not both adversity and good","come from the mouth of the Most High?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[39],"lines":["Why should any living person complain,","any man, because of the punishment for his sins?"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["נ Nun"],"rlw_lines":[]},{"type":"verse","verse_numbers":[40],"lines":["Let’s examine and probe our ways,","and turn back to the Lord."],"rlw_lines":[]},{"type":"verse","verse_numbers":[41],"lines":["Let’s lift up our hearts and our hands","to God in heaven:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[42],"lines":["“We have sinned and rebelled;","you have not forgiven."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ס Samek"],"rlw_lines":[]},{"type":"verse","verse_numbers":[43],"lines":["“You have covered yourself in anger and pursued us;","you have killed without compassion."],"rlw_lines":[]},{"type":"verse","verse_numbers":[44],"lines":["You have covered yourself with a cloud","so that no prayer can get through."],"rlw_lines":[]},{"type":"verse","verse_numbers":[45],"lines":["You have made us disgusting filth","among the peoples."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["פ Pe"],"rlw_lines":[]},{"type":"verse","verse_numbers":[46],"lines":["“All our enemies","open their mouths against us."],"rlw_lines":[]},{"type":"verse","verse_numbers":[47],"lines":["We have experienced panic and pitfall,","devastation and destruction.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[48],"lines":["My eyes flow with streams of tears","because of the destruction of my dear people."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ע Ayin"],"rlw_lines":[]},{"type":"verse","verse_numbers":[49],"lines":["My eyes overflow unceasingly,","without end,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[50],"lines":["until the Lord looks down","from heaven and sees."],"rlw_lines":[]},{"type":"verse","verse_numbers":[51],"lines":["My eyes bring me grief","because of the fate of all the women in my city."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["צ Tsade"],"rlw_lines":[]},{"type":"verse","verse_numbers":[52],"lines":["For no reason, my enemies","hunted me like a bird."],"rlw_lines":[]},{"type":"verse","verse_numbers":[53],"lines":["They smothered my life in a pit","and threw stones on me."],"rlw_lines":[]},{"type":"verse","verse_numbers":[54],"lines":["Water flooded over my head,","and I thought, “I’m going to die! ”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ק Qoph"],"rlw_lines":[]},{"type":"verse","verse_numbers":[55],"lines":["I called on your name, Lord,","from the depths of the pit."],"rlw_lines":[]},{"type":"verse","verse_numbers":[56],"lines":["You heard my plea:","Do not ignore my cry for relief."],"rlw_lines":[]},{"type":"verse","verse_numbers":[57],"lines":["You came near whenever I called you;","you said, “Do not be afraid.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ר Resh"],"rlw_lines":[]},{"type":"verse","verse_numbers":[58],"lines":["You championed my cause, Lord;","you redeemed my life."],"rlw_lines":[]},{"type":"verse","verse_numbers":[59],"lines":["Lord, you saw the wrong done to me;","judge my case."],"rlw_lines":[]},{"type":"verse","verse_numbers":[60],"lines":["You saw all their vengefulness,","all their plots against me."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ׂש Sin / שׁ Shin"],"rlw_lines":[]},{"type":"verse","verse_numbers":[61],"lines":["Lord, you heard their insults,","all their plots against me."],"rlw_lines":[]},{"type":"verse","verse_numbers":[62],"lines":["The slander and murmuring of my opponents","attack me all day long."],"rlw_lines":[]},{"type":"verse","verse_numbers":[63],"lines":["When they sit and when they rise, look,","I am mocked by their songs."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["ת Taw"],"rlw_lines":[]},{"type":"verse","verse_numbers":[64],"lines":["You will pay them back what they deserve, Lord,","according to the work of their hands."],"rlw_lines":[]},{"type":"verse","verse_numbers":[65],"lines":["You will give them a heart filled with anguish. ,","May your curse be on them!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[66],"lines":["You will pursue them in anger and destroy them","under your heavens. ,"],"rlw_lines":[]}]}}