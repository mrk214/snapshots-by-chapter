    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Words of Lemuel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "The words of King Lemuel,",
          "a pronouncement , that his mother taught him:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "What should I say, my son?",
          "What, son of my womb?",
          "What, son of my vows?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Don’t spend your energy on women",
          "or your efforts on those who destroy kings."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "It is not for kings, Lemuel,",
          "it is not for kings to drink wine",
          "or for rulers to desire beer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Otherwise, he will drink,",
          "forget what is decreed,",
          "and pervert justice for all the oppressed. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Give beer to one who is dying",
          "and wine to one whose life is bitter."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Let him drink so that he can forget his poverty",
          "and remember his trouble no more."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Speak up for those who have no voice, ,",
          "for the justice of all who are dispossessed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Speak up, judge righteously,",
          "and defend the cause of the oppressed and needy."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "In Praise of a Wife of Noble Character"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Who can find a wife of noble character? ,",
          "She is far more precious than jewels."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "The heart of her husband trusts in her,",
          "and he will not lack anything good."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "She rewards him with good, not evil,",
          "all the days of her life."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "She selects wool and flax",
          "and works with willing hands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "She is like the merchant ships,",
          "bringing her food from far away."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "She rises while it is still night",
          "and provides food for her household",
          "and portions for her female servants."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "She evaluates a field and buys it;",
          "she plants a vineyard with her earnings. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "She draws on her strength",
          "and reveals that her arms are strong."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "She sees that her profits are good,",
          "and her lamp never goes out at night."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "She extends her hands to the spinning staff,",
          "and her hands hold the spindle."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Her hands reach out to the poor,",
          "and she extends her hands to the needy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "She is not afraid for her household when it snows,",
          "for all in her household are doubly clothed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "She makes her own bed coverings;",
          "her clothing is fine linen and purple."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Her husband is known at the city gates,",
          "where he sits among the elders of the land."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "She makes and sells linen garments;",
          "she delivers belts to the merchants."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Strength and honor are her clothing,",
          "and she can laugh at the time to come."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Her mouth speaks wisdom,",
          "and loving instruction is on her tongue."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "She watches over the activities of her household",
          "and is never idle."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Her children rise up and call her blessed;",
          "her husband also praises her:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "“Many women have done noble deeds,",
          "but you surpass them all! ”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Charm is deceptive and beauty is fleeting,",
          "but a woman who fears the Lord will be praised."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Give her the reward of her labor,",
          "and let her works praise her at the city gates."
        ],
        "rlw_lines": []
      }
    ]
  },
