    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "My Strength"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Lord, I call to you;",
          "my rock, do not be deaf to me.",
          "If you remain silent to me,",
          "I will be like those going down to the Pit."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Listen to the sound of my pleading",
          "when I cry to you for help,",
          "when I lift up my hands",
          "toward your holy sanctuary."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Do not drag me away with the wicked,",
          "with the evildoers,",
          "who speak in friendly ways with their neighbors",
          "while malice is in their hearts."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Repay them according to what they have done —",
          "according to the evil of their deeds.",
          "Repay them according to the work of their hands;",
          "give them back what they deserve."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Because they do not consider",
          "what the Lord has done",
          "or the work of his hands,",
          "he will tear them down and not rebuild them."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Blessed be the Lord,",
          "for he has heard the sound of my pleading."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "The Lord is my strength and my shield;",
          "my heart trusts in him, and I am helped.",
          "Therefore my heart celebrates,",
          "and I give thanks to him with my song."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "The Lord is the strength of his people;",
          "he is a stronghold of salvation for his anointed."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Save your people, bless your possession,",
          "shepherd them, and carry them forever."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
