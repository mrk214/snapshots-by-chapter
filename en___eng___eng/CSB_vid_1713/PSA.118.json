    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Thanksgiving for Victory"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Give thanks to the Lord, for he is good;",
          "his faithful love endures forever."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Let Israel say,",
          "“His faithful love endures forever.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Let the house of Aaron say,",
          "“His faithful love endures forever.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Let those who fear the Lord say,",
          "“His faithful love endures forever.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "I called to the Lord in distress;",
          "the Lord answered me",
          "and put me in a spacious place. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "The Lord is for me; I will not be afraid.",
          "What can a mere mortal do to me?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "The Lord is my helper;",
          "therefore, I will look in triumph on those who hate me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "It is better to take refuge in the Lord",
          "than to trust in humanity."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "It is better to take refuge in the Lord",
          "than to trust in nobles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "All the nations surrounded me;",
          "in the name of the Lord I destroyed them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "They surrounded me, yes, they surrounded me;",
          "in the name of the Lord I destroyed them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "They surrounded me like bees;",
          "they were extinguished like a fire among thorns;",
          "in the name of the Lord I destroyed them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "They pushed me hard to make me fall,",
          "but the Lord helped me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "The Lord is my strength and my song;",
          "he has become my salvation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "There are shouts of joy and victory",
          "in the tents of the righteous:",
          "“The Lord’s right hand performs valiantly!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "The Lord’s right hand is raised.",
          "The Lord’s right hand performs valiantly! ”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "I will not die, but I will live",
          "and proclaim what the Lord has done."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "The Lord disciplined me severely",
          "but did not give me over to death."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Open the gates of righteousness for me;",
          "I will enter through them",
          "and give thanks to the Lord."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "This is the Lord’s gate;",
          "the righteous will enter through it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "I will give thanks to you",
          "because you have answered me",
          "and have become my salvation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "The stone that the builders rejected",
          "has become the cornerstone."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "This came from the Lord;",
          "it is wondrous in our sight."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "This is the day the Lord has made;",
          "let’s rejoice and be glad in it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Lord, save us!",
          "Lord, please grant us success!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "He who comes in the name",
          "of the Lord is blessed.",
          "From the house of the Lord we bless you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "The Lord is God and has given us light.",
          "Bind the festival sacrifice with cords",
          "to the horns of the altar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "You are my God, and I will give you thanks.",
          "You are my God; I will exalt you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Give thanks to the Lord, for he is good;",
          "his faithful love endures forever."
        ],
        "rlw_lines": []
      }
    ]
  },
