    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Blessings for Those Who Fear God"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A song of ascents."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "How happy is everyone who fears the Lord,",
          "who walks in his ways!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "You will surely eat",
          "what your hands have worked for.",
          "You will be happy,",
          "and it will go well for you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Your wife will be like a fruitful vine",
          "within your house,",
          "your children, like young olive trees",
          "around your table."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "In this very way",
          "the man who fears the Lord",
          "will be blessed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "May the Lord bless you from Zion,",
          "so that you will see the prosperity of Jerusalem",
          "all the days of your life"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "and will see your children’s children!",
          "Peace be with Israel."
        ],
        "rlw_lines": []
      }
    ]
  },
