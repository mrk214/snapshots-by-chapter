    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Cry for Help"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Lord, hear my prayer.",
          "In your faithfulness listen to my plea,",
          "and in your righteousness answer me."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Do not bring your servant into judgment,",
          "for no one alive is righteous in your sight."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "For the enemy has pursued me,",
          "crushing me to the ground,",
          "making me live in darkness",
          "like those long dead."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "My spirit is weak within me;",
          "my heart is overcome with dismay."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "I remember the days of old;",
          "I meditate on all you have done;",
          "I reflect on the work of your hands."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I spread out my hands to you;",
          "I am like parched land before you."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Answer me quickly, Lord;",
          "my spirit fails.",
          "Don’t hide your face from me,",
          "or I will be like those",
          "going down to the Pit."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Let me experience",
          "your faithful love in the morning,",
          "for I trust in you.",
          "Reveal to me the way I should go",
          "because I appeal to you."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Rescue me from my enemies, Lord;",
          "I come to you for protection. ,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Teach me to do your will,",
          "for you are my God.",
          "May your gracious Spirit",
          "lead me on level ground."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "For your name’s sake, Lord,",
          "let me live.",
          "In your righteousness deliver me from trouble,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "and in your faithful love destroy my enemies.",
          "Wipe out all those who attack me,",
          "for I am your servant."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
