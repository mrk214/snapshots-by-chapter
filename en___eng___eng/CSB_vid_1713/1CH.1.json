    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "From Adam to Abraham"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Adam, Seth, Enosh,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Kenan, Mahalalel, Jared,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enoch, Methuselah, Lamech,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Noah, Noah’s sons:",
          "Shem, Ham, and Japheth."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Japheth’s sons: Gomer, Magog, Madai, Javan, Tubal, Meshech, and Tiras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Gomer’s sons: Ashkenaz, Riphath, and Togarmah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Javan’s sons: Elishah, Tarshish, Kittim, and Rodanim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ham’s sons: Cush, Mizraim, Put, and Canaan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Cush’s sons: Seba, Havilah, Sabta, Raama, and Sabteca.",
          "Raama’s sons: Sheba and Dedan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cush fathered Nimrod, who was the first to become a great warrior on earth."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mizraim fathered the people of Lud, Anam, Lehab, Naphtuh,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Pathrus, Casluh (the Philistines came from them), and Caphtor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Canaan fathered Sidon as his firstborn and Heth,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "as well as the Jebusites, Amorites, Girgashites,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Hivites, Arkites, Sinites,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Arvadites, Zemarites, and Hamathites."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Shem’s sons: Elam, Asshur, Arpachshad, Lud, Aram, Uz, Hul, Gether, and Meshech."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Arpachshad fathered Shelah, and Shelah fathered Eber."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Two sons were born to Eber. One of them was named Peleg because the earth was divided during his lifetime, and the name of his brother was Joktan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Joktan fathered Almodad, Sheleph, Hazarmaveth, Jerah,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Hadoram, Uzal, Diklah,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ebal, Abimael, Sheba,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ophir, Havilah, and Jobab. All of these were Joktan’s sons."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Shem, Arpachshad, Shelah,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Eber, Peleg, Reu,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Serug, Nahor, Terah,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "and Abram (that is, Abraham)."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Abraham’s Descendants"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Abraham’s sons: Isaac and Ishmael."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "These are their family records: Nebaioth, Ishmael’s firstborn, Kedar, Adbeel, Mibsam,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Mishma, Dumah, Massa, Hadad, Tema,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Jetur, Naphish, and Kedemah.",
          "These were Ishmael’s sons."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "The sons born to Keturah, Abraham’s concubine: Zimran, Jokshan, Medan, Midian, Ishbak, and Shuah.",
          "Jokshan’s sons: Sheba and Dedan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Midian’s sons: Ephah, Epher, Hanoch, Abida, and Eldaah.",
          "All of these were Keturah’s descendants."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Abraham fathered Isaac.",
          "Isaac’s sons: Esau and Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Esau’s sons: Eliphaz, Reuel, Jeush, Jalam, and Korah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Eliphaz’s sons: Teman, Omar, Zephi, Gatam, and Kenaz; and by Timna, Amalek."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Reuel’s sons: Nahath, Zerah, Shammah, and Mizzah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Edomites"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Seir’s sons: Lotan, Shobal, Zibeon, Anah, Dishon, Ezer, and Dishan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Lotan’s sons: Hori and Homam. Timna was Lotan’s sister."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Shobal’s sons: Alian, Manahath, Ebal, Shephi, and Onam.",
          "Zibeon’s sons: Aiah and Anah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Anah’s son: Dishon.",
          "Dishon’s sons: Hamran, Eshban, Ithran, and Cheran."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Ezer’s sons: Bilhan, Zaavan, and Jaakan.",
          "Dishan’s sons: Uz and Aran."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "These were the kings who reigned in the land of Edom",
          "before any king reigned over the Israelites:",
          "Bela son of Beor.",
          "Bela’s town was named Dinhabah."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "When Bela died, Jobab son of Zerah from Bozrah reigned in his place."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "When Jobab died, Husham from the land of the Temanites reigned in his place."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "When Husham died, Hadad son of Bedad, who defeated Midian in the territory of Moab, reigned in his place.",
          "Hadad’s town was named Avith."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "When Hadad died, Samlah from Masrekah reigned in his place."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "When Samlah died, Shaul from Rehoboth on the Euphrates River reigned in his place."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "When Shaul died, Baal-hanan son of Achbor reigned in his place."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "When Baal-hanan died, Hadad reigned in his place.",
          "Hadad’s city was named Pai, and his wife’s name was Mehetabel",
          "daughter of Matred, daughter of Me-zahab."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Then Hadad died.",
          "Edom’s chiefs: Timna, Alvah, Jetheth,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Oholibamah, Elah, Pinon,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Kenaz, Teman, Mibzar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Magdiel, and Iram.",
          "These were Edom’s chiefs."
        ],
        "rlw_lines": []
      }
    ]
  },
