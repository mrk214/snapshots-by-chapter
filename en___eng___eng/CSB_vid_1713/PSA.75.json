    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "God Judges the Wicked"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the choir director: “Do Not Destroy.” A psalm of Asaph. A song."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "We give thanks to you, God;",
          "we give thanks to you, for your name is near.",
          "People tell about your wondrous works."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“When I choose a time,",
          "I will judge fairly."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "When the earth and all its inhabitants shake,",
          "I am the one who steadies its pillars."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "I say to the boastful, ‘Do not boast,’",
          "and to the wicked, ‘Do not lift up your horn."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Do not lift up your horn against heaven",
          "or speak arrogantly.’ ”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Exaltation does not come",
          "from the east, the west, or the desert,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "for God is the Judge:",
          "He brings down one and exalts another."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "For there is a cup in the Lord’s hand,",
          "full of wine blended with spices, and he pours from it.",
          "All the wicked of the earth will drink,",
          "draining it to the dregs."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "As for me, I will tell about him forever;",
          "I will sing praise to the God of Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“I will cut off all the horns of the wicked,",
          "but the horns of the righteous will be lifted up.”"
        ],
        "rlw_lines": []
      }
    ]
  },
