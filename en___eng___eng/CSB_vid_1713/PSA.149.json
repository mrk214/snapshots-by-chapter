    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Praise for God’s Triumph"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hallelujah!",
          "Sing to the Lord a new song,",
          "his praise in the assembly of the faithful."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Let Israel celebrate its Maker;",
          "let the children of Zion rejoice in their King."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Let them praise his name with dancing",
          "and make music to him with tambourine and lyre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "For the Lord takes pleasure in his people;",
          "he adorns the humble with salvation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Let the faithful celebrate in triumphal glory;",
          "let them shout for joy on their beds."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Let the exaltation of God be in their mouths",
          "and a double-edged sword in their hands,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "inflicting vengeance on the nations",
          "and punishment on the peoples,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "binding their kings with chains",
          "and their dignitaries with iron shackles,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "carrying out the judgment decreed against them.",
          "This honor is for all his faithful people.",
          "Hallelujah!"
        ],
        "rlw_lines": []
      }
    ]
  },
