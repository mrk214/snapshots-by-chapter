    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Praising God’s Greatness"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A hymn of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "I exalt you, my God the King,",
          "and bless your name forever and ever."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "I will bless you every day;",
          "I will praise your name forever and ever."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "The Lord is great and is highly praised;",
          "his greatness is unsearchable."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "One generation will declare your works to the next",
          "and will proclaim your mighty acts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "I will speak of your splendor and glorious majesty",
          "and your wondrous works."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "They will proclaim the power of your awe-inspiring acts,",
          "and I will declare your greatness. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "They will give a testimony of your great goodness",
          "and will joyfully sing of your righteousness."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "The Lord is gracious and compassionate,",
          "slow to anger and great in faithful love."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "The Lord is good to everyone;",
          "his compassion rests on all he has made."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "All you have made will thank you, Lord;",
          "the faithful will bless you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "They will speak of the glory of your kingdom",
          "and will declare your might,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "informing all people of your mighty acts",
          "and of the glorious splendor of your kingdom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Your kingdom is an everlasting kingdom;",
          "your rule is for all generations.",
          "The Lord is faithful in all his words",
          "and gracious in all his actions. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "The Lord helps all who fall;",
          "he raises up all who are oppressed. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "All eyes look to you,",
          "and you give them their food at the proper time."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "You open your hand",
          "and satisfy the desire of every living thing."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "The Lord is righteous in all his ways",
          "and faithful in all his acts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "The Lord is near all who call out to him,",
          "all who call out to him with integrity."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "He fulfills the desires of those who fear him;",
          "he hears their cry for help and saves them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "The Lord guards all those who love him,",
          "but he destroys all the wicked."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "My mouth will declare the Lord’s praise;",
          "let every living thing",
          "bless his holy name forever and ever."
        ],
        "rlw_lines": []
      }
    ]
  },
