    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Majestic King"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "The Lord reigns! Let the earth rejoice;",
          "let the many coasts and islands be glad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Clouds and total darkness surround him;",
          "righteousness and justice are the foundation of his throne."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Fire goes before him",
          "and burns up his foes on every side."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "His lightning lights up the world;",
          "the earth sees and trembles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "The mountains melt like wax",
          "at the presence of the Lord —",
          "at the presence of the Lord of the whole earth."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "The heavens proclaim his righteousness;",
          "all the peoples see his glory."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "All who serve carved images,",
          "those who boast in worthless idols, will be put to shame.",
          "All the gods must worship him."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Zion hears and is glad,",
          "Judah’s villages rejoice",
          "because of your judgments, Lord."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "For you, Lord,",
          "are the Most High over the whole earth;",
          "you are exalted above all the gods."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "You who love the Lord, hate evil!",
          "He protects the lives of his faithful ones;",
          "he rescues them from the power of the wicked."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Light dawns , for the righteous,",
          "gladness for the upright in heart."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Be glad in the Lord, you righteous ones,",
          "and give thanks to his holy name. ,"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
