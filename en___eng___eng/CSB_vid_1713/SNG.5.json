    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Man"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "I have come to my garden #— #my sister, my bride.",
          "I gather my myrrh with my spices.",
          "I eat my honeycomb with my honey.",
          "I drink my wine with my milk."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Narrator"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eat, friends!",
          "Drink, be intoxicated with caresses! ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Woman"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "I was sleeping, but my heart was awake.",
          "A sound! My love was knocking!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Man"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Open to me, my sister, my darling,",
          "my dove, my perfect one.",
          "For my head is drenched with dew,",
          "my hair with droplets of the night."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Woman"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "I have taken off my clothing.",
          "How can I put it back on?",
          "I have washed my feet.",
          "How can I get them dirty?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "My love thrust his hand through the opening,",
          "and my feelings were stirred for him."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "I rose to open for my love.",
          "My hands dripped with myrrh,",
          "my fingers with flowing myrrh",
          "on the handles of the bolt."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I opened to my love,",
          "but my love had turned and gone away.",
          "My heart sank because he had left.",
          "I sought him, but did not find him.",
          "I called him, but he did not answer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "The guards who go about the city found me.",
          "They beat and wounded me;",
          "they took my cloak from me —",
          "the guardians of the walls."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Young women of Jerusalem, I charge you,",
          "if you find my love,",
          "tell him that I am lovesick."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Young Women"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "What makes the one you love better than another,",
          "most beautiful of women?",
          "What makes him better than another,",
          "that you would give us this charge?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Woman"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "My love is fit and strong, ,",
          "notable among ten thousand."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "His head is purest gold.",
          "His hair is wavy ,",
          "and black as a raven."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "His eyes are like doves",
          "beside flowing streams,",
          "washed in milk",
          "and set like jewels."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "His cheeks are like beds of spice,",
          "mounds of perfume.",
          "His lips are lilies,",
          "dripping with flowing myrrh."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "His arms are rods of gold",
          "set with beryl.",
          "His body is an ivory panel",
          "covered with lapis lazuli."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "His legs are alabaster pillars",
          "set on pedestals of pure gold.",
          "His presence is like Lebanon,",
          "as majestic as the cedars."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "His mouth is sweetness.",
          "He is absolutely desirable.",
          "This is my love, and this is my friend,",
          "young women of Jerusalem."
        ],
        "rlw_lines": []
      }
    ]
  },
