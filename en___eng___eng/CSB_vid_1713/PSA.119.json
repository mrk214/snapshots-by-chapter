    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Delight in God’s Word"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "א Aleph"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "How happy are those whose way is blameless,",
          "who walk according to the Lord’s instruction!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Happy are those who keep his decrees",
          "and seek him with all their heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "They do nothing wrong;",
          "they walk in his ways."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "You have commanded that your precepts",
          "be diligently kept."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "If only my ways were committed",
          "to keeping your statutes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Then I would not be ashamed",
          "when I think about all your commands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "I will praise you with an upright heart",
          "when I learn your righteous judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "I will keep your statutes;",
          "never abandon me."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ב Beth"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "How can a young man keep his way pure?",
          "By keeping your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "I have sought you with all my heart;",
          "don’t let me wander from your commands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "I have treasured your word in my heart",
          "so that I may not sin against you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Lord, may you be blessed;",
          "teach me your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "With my lips I proclaim",
          "all the judgments from your mouth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "I rejoice in the way revealed by your decrees",
          "as much as in all riches."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "I will meditate on your precepts",
          "and think about your ways."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "I will delight in your statutes;",
          "I will not forget your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ג Gimel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Deal generously with your servant",
          "so that I might live;",
          "then I will keep your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Open my eyes so that I may contemplate",
          "wondrous things from your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "I am a resident alien on earth;",
          "do not hide your commands from me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "I am continually overcome",
          "with longing for your judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "You rebuke the arrogant,",
          "the ones under a curse,",
          "who wander from your commands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Take insult and contempt away from me,",
          "for I have kept your decrees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Though princes sit together speaking against me,",
          "your servant will think about your statutes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "your decrees are my delight",
          "and my counselors."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ד Daleth"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "My life is down in the dust;",
          "give me life through your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "I told you about my life,",
          "and you answered me;",
          "teach me your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Help me understand",
          "the meaning of your precepts",
          "so that I can meditate on your wonders."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "I am weary from grief;",
          "strengthen me through your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Keep me from the way of deceit",
          "and graciously give me your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "I have chosen the way of truth;",
          "I have set your ordinances before me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "I cling to your decrees;",
          "Lord, do not put me to shame."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "I pursue the way of your commands,",
          "for you broaden my understanding. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ה He"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Teach me, Lord, the meaning of your statutes,",
          "and I will always keep them. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Help me understand your instruction,",
          "and I will obey it",
          "and follow it with all my heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Help me stay on the path of your commands,",
          "for I take pleasure in it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Turn my heart to your decrees",
          "and not to dishonest profit."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Turn my eyes",
          "from looking at what is worthless;",
          "give me life in your ways. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Confirm what you said to your servant,",
          "for it produces reverence for you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Turn away the disgrace I dread;",
          "indeed, your judgments are good."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "How I long for your precepts!",
          "Give me life through your righteousness."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ו Waw"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Let your faithful love come to me, Lord,",
          "your salvation, as you promised."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Then I can answer the one who taunts me,",
          "for I trust in your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Never take the word of truth from my mouth,",
          "for I hope in your judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "I will always obey your instruction,",
          "forever and ever."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "I will walk freely in an open place",
          "because I study your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "I will speak of your decrees before kings",
          "and not be ashamed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "I delight in your commands,",
          "which I love."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "I will lift up my hands to your commands,",
          "which I love,",
          "and will meditate on your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ז Zayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Remember your word to your servant;",
          "you have given me hope through it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "This is my comfort in my affliction:",
          "Your promise has given me life."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "The arrogant constantly ridicule me,",
          "but I do not turn away from your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Lord, I remember your judgments from long ago",
          "and find comfort."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Fury seizes me because of the wicked",
          "who reject your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Your statutes are the theme of my song",
          "during my earthly life."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Lord, I remember your name in the night,",
          "and I obey your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "This is my practice:",
          "I obey your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ח Cheth"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "The Lord is my portion; ,",
          "I have promised to keep your words."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "I have sought your favor with all my heart;",
          "be gracious to me according to your promise."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "I thought about my ways",
          "and turned my steps back to your decrees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "I hurried, not hesitating",
          "to keep your commands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Though the ropes of the wicked",
          "were wrapped around me,",
          "I did not forget your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "I rise at midnight to thank you",
          "for your righteous judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "I am a friend to all who fear you,",
          "to those who keep your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Lord, the earth is filled with your faithful love;",
          "teach me your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ט Teth"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Lord, you have treated your servant well,",
          "just as you promised."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Teach me good judgment and discernment,",
          "for I rely on your commands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Before I was afflicted I went astray,",
          "but now I keep your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "You are good, and you do what is good;",
          "teach me your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "The arrogant have smeared me with lies,",
          "but I obey your precepts with all my heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "Their hearts are hard and insensitive,",
          "but I delight in your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "It was good for me to be afflicted",
          "so that I could learn your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "Instruction from your lips is better for me",
          "than thousands of gold and silver pieces."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "י Yod"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "Your hands made me and formed me;",
          "give me understanding",
          "so that I can learn your commands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "Those who fear you will see me and rejoice,",
          "for I put my hope in your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "I know, Lord, that your judgments are just",
          "and that you have afflicted me fairly."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "May your faithful love comfort me",
          "as you promised your servant."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "May your compassion come to me",
          "so that I may live,",
          "for your instruction is my delight."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "Let the arrogant be put to shame",
          "for slandering me with lies;",
          "I will meditate on your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Let those who fear you,",
          "those who know your decrees, turn to me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "May my heart be blameless regarding your statutes",
          "so that I will not be put to shame."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "כ Kaph"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "I long for your salvation;",
          "I put my hope in your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          82
        ],
        "lines": [
          "My eyes grow weary",
          "looking for what you have promised;",
          "I ask, “When will you comfort me? ”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          83
        ],
        "lines": [
          "Though I have become like a wineskin dried by smoke,",
          "I do not forget your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          84
        ],
        "lines": [
          "How many days must your servant wait?",
          "When will you execute judgment on my persecutors?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          85
        ],
        "lines": [
          "The arrogant have dug pits for me;",
          "they violate your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          86
        ],
        "lines": [
          "All your commands are true;",
          "people persecute me with lies #— #help me!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          87
        ],
        "lines": [
          "They almost ended my life on earth,",
          "but I did not abandon your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          88
        ],
        "lines": [
          "Give me life in accordance with your faithful love,",
          "and I will obey the decree you have spoken."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ל Lamed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          89
        ],
        "lines": [
          "Lord, your word is forever;",
          "it is firmly fixed in heaven."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          90
        ],
        "lines": [
          "Your faithfulness is for all generations;",
          "you established the earth, and it stands firm."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          91
        ],
        "lines": [
          "Your judgments stand firm today,",
          "for all things are your servants."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          92
        ],
        "lines": [
          "If your instruction had not been my delight,",
          "I would have died in my affliction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          93
        ],
        "lines": [
          "I will never forget your precepts,",
          "for you have given me life through them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          94
        ],
        "lines": [
          "I am yours; save me,",
          "for I have studied your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          95
        ],
        "lines": [
          "The wicked hope to destroy me,",
          "but I contemplate your decrees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          96
        ],
        "lines": [
          "I have seen a limit to all perfection,",
          "but your command is without limit."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "מ Mem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          97
        ],
        "lines": [
          "How I love your instruction!",
          "It is my meditation all day long."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          98
        ],
        "lines": [
          "Your command makes me wiser than my enemies,",
          "for it is always with me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          99
        ],
        "lines": [
          "I have more insight than all my teachers",
          "because your decrees are my meditation."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          100
        ],
        "lines": [
          "I understand more than the elders",
          "because I obey your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          101
        ],
        "lines": [
          "I have kept my feet from every evil path",
          "to follow your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          102
        ],
        "lines": [
          "I have not turned from your judgments,",
          "for you yourself have instructed me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          103
        ],
        "lines": [
          "How sweet your word is to my taste —",
          "sweeter than honey in my mouth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          104
        ],
        "lines": [
          "I gain understanding from your precepts;",
          "therefore I hate every false way."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "נ Nun"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          105
        ],
        "lines": [
          "Your word is a lamp for my feet",
          "and a light on my path."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          106
        ],
        "lines": [
          "I have solemnly sworn",
          "to keep your righteous judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          107
        ],
        "lines": [
          "I am severely afflicted;",
          "Lord, give me life according to your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          108
        ],
        "lines": [
          "Lord, please accept my freewill offerings of praise,",
          "and teach me your judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          109
        ],
        "lines": [
          "My life is constantly in danger,",
          "yet I do not forget your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          110
        ],
        "lines": [
          "The wicked have set a trap for me,",
          "but I have not wandered from your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          111
        ],
        "lines": [
          "I have your decrees as a heritage forever;",
          "indeed, they are the joy of my heart."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          112
        ],
        "lines": [
          "I am resolved to obey your statutes",
          "to the very end. ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ס Samek"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          113
        ],
        "lines": [
          "I hate those who are double-minded,",
          "but I love your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          114
        ],
        "lines": [
          "You are my shelter and my shield;",
          "I put my hope in your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          115
        ],
        "lines": [
          "Depart from me, you evil ones,",
          "so that I may obey my God’s commands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          116
        ],
        "lines": [
          "Sustain me as you promised, and I will live;",
          "do not let me be ashamed of my hope."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          117
        ],
        "lines": [
          "Sustain me so that I can be safe",
          "and always be concerned about your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          118
        ],
        "lines": [
          "You reject all who stray from your statutes,",
          "for their deceit is a lie."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          119
        ],
        "lines": [
          "You remove all the wicked on earth",
          "as if they were dross from metal;",
          "therefore, I love your decrees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          120
        ],
        "lines": [
          "I tremble in awe of you;",
          "I fear your judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ע Ayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          121
        ],
        "lines": [
          "I have done what is just and right;",
          "do not leave me to my oppressors."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          122
        ],
        "lines": [
          "Guarantee your servant’s well-being;",
          "do not let the arrogant oppress me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          123
        ],
        "lines": [
          "My eyes grow weary looking for your salvation",
          "and for your righteous promise."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          124
        ],
        "lines": [
          "Deal with your servant based on your faithful love;",
          "teach me your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          125
        ],
        "lines": [
          "I am your servant; give me understanding",
          "so that I may know your decrees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          126
        ],
        "lines": [
          "It is time for the Lord to act,",
          "for they have violated your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          127
        ],
        "lines": [
          "Since I love your commands",
          "more than gold, even the purest gold,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          128
        ],
        "lines": [
          "I carefully follow all your precepts",
          "and hate every false way."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "פ Pe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          129
        ],
        "lines": [
          "Your decrees are wondrous;",
          "therefore I obey them."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          130
        ],
        "lines": [
          "The revelation of your words brings light",
          "and gives understanding to the inexperienced."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          131
        ],
        "lines": [
          "I open my mouth and pant",
          "because I long for your commands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          132
        ],
        "lines": [
          "Turn to me and be gracious to me,",
          "as is your practice toward those who love your name."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          133
        ],
        "lines": [
          "Make my steps steady through your promise;",
          "don’t let any sin dominate me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          134
        ],
        "lines": [
          "Redeem me from human oppression,",
          "and I will keep your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          135
        ],
        "lines": [
          "Make your face shine on your servant,",
          "and teach me your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          136
        ],
        "lines": [
          "My eyes pour out streams of tears",
          "because people do not follow your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "צ Tsade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          137
        ],
        "lines": [
          "You are righteous, Lord,",
          "and your judgments are just."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          138
        ],
        "lines": [
          "The decrees you issue are righteous",
          "and altogether trustworthy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          139
        ],
        "lines": [
          "My anger overwhelms me",
          "because my foes forget your words."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          140
        ],
        "lines": [
          "Your word is completely pure,",
          "and your servant loves it."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          141
        ],
        "lines": [
          "I am insignificant and despised,",
          "but I do not forget your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          142
        ],
        "lines": [
          "Your righteousness is an everlasting righteousness,",
          "and your instruction is true."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          143
        ],
        "lines": [
          "Trouble and distress have overtaken me,",
          "but your commands are my delight."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          144
        ],
        "lines": [
          "Your decrees are righteous forever.",
          "Give me understanding, and I will live."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ק Qoph"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          145
        ],
        "lines": [
          "I call with all my heart; answer me, Lord.",
          "I will obey your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          146
        ],
        "lines": [
          "I call to you; save me,",
          "and I will keep your decrees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          147
        ],
        "lines": [
          "I rise before dawn and cry out for help;",
          "I put my hope in your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          148
        ],
        "lines": [
          "I am awake through each watch of the night",
          "to meditate on your promise."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          149
        ],
        "lines": [
          "In keeping with your faithful love, hear my voice.",
          "Lord, give me life in keeping with your justice."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          150
        ],
        "lines": [
          "Those who pursue evil plans , come near;",
          "they are far from your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          151
        ],
        "lines": [
          "You are near, Lord,",
          "and all your commands are true."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          152
        ],
        "lines": [
          "Long ago I learned from your decrees",
          "that you have established them forever."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ר Resh"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          153
        ],
        "lines": [
          "Consider my affliction and rescue me,",
          "for I have not forgotten your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          154
        ],
        "lines": [
          "Champion my cause and redeem me;",
          "give me life as you promised."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          155
        ],
        "lines": [
          "Salvation is far from the wicked",
          "because they do not study your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          156
        ],
        "lines": [
          "Your compassions are many, Lord;",
          "give me life according to your judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          157
        ],
        "lines": [
          "My persecutors and foes are many.",
          "I have not turned from your decrees."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          158
        ],
        "lines": [
          "I have seen the disloyal and feel disgust",
          "because they do not keep your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          159
        ],
        "lines": [
          "Consider how I love your precepts;",
          "Lord, give me life according to your faithful love."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          160
        ],
        "lines": [
          "The entirety of your word is truth,",
          "each of your righteous judgments endures forever."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "שׂ Sin / שׁ Shin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          161
        ],
        "lines": [
          "Princes have persecuted me without cause,",
          "but my heart fears only your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          162
        ],
        "lines": [
          "I rejoice over your promise",
          "like one who finds vast treasure."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          163
        ],
        "lines": [
          "I hate and abhor falsehood,",
          "but I love your instruction."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          164
        ],
        "lines": [
          "I praise you seven times a day",
          "for your righteous judgments."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          165
        ],
        "lines": [
          "Abundant peace belongs to those",
          "who love your instruction;",
          "nothing makes them stumble."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          166
        ],
        "lines": [
          "Lord, I hope for your salvation",
          "and carry out your commands."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          167
        ],
        "lines": [
          "I obey your decrees",
          "and love them greatly."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          168
        ],
        "lines": [
          "I obey your precepts and decrees,",
          "for all my ways are before you."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "ת Taw"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          169
        ],
        "lines": [
          "Let my cry reach you, Lord;",
          "give me understanding according to your word."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          170
        ],
        "lines": [
          "Let my plea reach you;",
          "rescue me according to your promise."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          171
        ],
        "lines": [
          "My lips pour out praise,",
          "for you teach me your statutes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          172
        ],
        "lines": [
          "My tongue sings about your promise,",
          "for all your commands are righteous."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          173
        ],
        "lines": [
          "May your hand be ready to help me,",
          "for I have chosen your precepts."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          174
        ],
        "lines": [
          "I long for your salvation, Lord,",
          "and your instruction is my delight."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          175
        ],
        "lines": [
          "Let me live, and I will praise you;",
          "may your judgments help me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          176
        ],
        "lines": [
          "I wander like a lost sheep;",
          "seek your servant,",
          "for I do not forget your commands."
        ],
        "rlw_lines": []
      }
    ]
  },
