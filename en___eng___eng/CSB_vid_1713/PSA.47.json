    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "God Our King"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the choir director. A psalm of the sons of Korah."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Clap your hands, all you peoples;",
          "shout to God with a jubilant cry."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "For the Lord, the Most High, is awe-inspiring,",
          "a great King over the whole earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "He subdues peoples under us",
          "and nations under our feet."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He chooses for us our inheritance —",
          "the pride of Jacob, whom he loves."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "God ascends among shouts of joy,",
          "the Lord, with the sound of a ram’s horn."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sing praise to God, sing praise;",
          "sing praise to our King, sing praise!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sing a song of wisdom,",
          "for God is King of the whole earth."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "God reigns over the nations;",
          "God is seated on his holy throne."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "The nobles of the peoples have assembled",
          "with the people of the God of Abraham.",
          "For the leaders of the earth belong to God;",
          "he is greatly exalted."
        ],
        "rlw_lines": []
      }
    ]
  },
