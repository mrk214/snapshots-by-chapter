    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "The Refuge of the Righteous"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "For the choir director: with the flutes. A psalm of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Listen to my words, Lord;",
          "consider my sighing."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pay attention to the sound of my cry,",
          "my King and my God,",
          "for I pray to you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "In the morning, Lord, you hear my voice;",
          "in the morning I plead my case to you and watch expectantly."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "For you are not a God who delights in wickedness;",
          "evil cannot dwell with you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "The boastful cannot stand in your sight;",
          "you hate all evildoers."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "You destroy those who tell lies;",
          "the Lord abhors violent and treacherous people."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "But I enter your house",
          "by the abundance of your faithful love;",
          "I bow down toward your holy temple",
          "in reverential awe of you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Lord, lead me in your righteousness",
          "because of my adversaries;",
          "make your way straight before me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "For there is nothing reliable in what they say;",
          "destruction is within them;",
          "their throat is an open grave;",
          "they flatter with their tongues."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Punish them, God;",
          "let them fall by their own schemes.",
          "Drive them out because of their many crimes,",
          "for they rebel against you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "But let all who take refuge in you rejoice;",
          "let them shout for joy forever.",
          "May you shelter them,",
          "and may those who love your name boast about you."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "For you, Lord, bless the righteous one;",
          "you surround him with favor like a shield."
        ],
        "rlw_lines": []
      }
    ]
  },
