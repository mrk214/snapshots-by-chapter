      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Cry for Truth and Peace"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A song of ascents."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "In my distress I called to the Lord,",
          "and he answered me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Lord, rescue me from lying lips",
          "and a deceitful tongue.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "What will he give you,",
          "and what will he do to you,",
          "you deceitful tongue?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A warrior’s sharp arrows",
          "with burning charcoal! ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "What misery that I have stayed in Meshech, ,",
          "that I have lived among the tents of Kedar! ,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "I have dwelt too long",
          "with those who hate peace."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "I am for peace; but when I speak,",
          "they are for war."
        ],
        "rlw_lines": []
      }
    ]
