    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Praise the King"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A psalm."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Sing a new song to the Lord,",
          "for he has performed wonders;",
          "his right hand and holy arm",
          "have won him victory."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "The Lord has made his victory known;",
          "he has revealed his righteousness",
          "in the sight of the nations."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "He has remembered his love",
          "and faithfulness to the house of Israel;",
          "all the ends of the earth",
          "have seen our God’s victory."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Let the whole earth shout to the Lord;",
          "be jubilant, shout for joy, and sing."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sing to the Lord with the lyre,",
          "with the lyre and melodious song."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "With trumpets and the blast of the ram’s horn",
          "shout triumphantly",
          "in the presence of the Lord, our King."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Let the sea and all that fills it,",
          "the world and those who live in it, resound."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Let the rivers clap their hands;",
          "let the mountains shout together for joy"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "before the Lord,",
          "for he is coming to judge the earth.",
          "He will judge the world righteously",
          "and the peoples fairly."
        ],
        "rlw_lines": []
      }
    ]
  },
