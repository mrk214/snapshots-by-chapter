    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deliver Me, O Lord"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Song of Ascents."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "In my distress I called to the Lord,",
          "and he answered me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deliver me, O Lord,",
          "from lying lips,",
          "from a deceitful tongue."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "What shall be given to you,",
          "and what more shall be done to you,",
          "you deceitful tongue?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A warrior’s sharp arrows,",
          "with glowing coals of the broom tree!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Woe to me, that I sojourn in Meshech,",
          "that I dwell among the tents of Kedar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Too long have I had my dwelling",
          "among those who hate peace."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "I am for peace,",
          "but when I speak, they are for war!"
        ],
        "rlw_lines": []
      }
    ]
