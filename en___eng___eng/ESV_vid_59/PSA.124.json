    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Our Help Is in the Name of the Lord"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Song of Ascents. Of David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "If it had not been the Lord who was on our side—",
          "let Israel now say—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "if it had not been the Lord who was on our side",
          "when people rose up against us,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "then they would have swallowed us up alive,",
          "when their anger was kindled against us;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "then the flood would have swept us away,",
          "the torrent would have gone over us;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "then over us would have gone",
          "the raging waters."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Blessed be the Lord,",
          "who has not given us",
          "as prey to their teeth!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "We have escaped like a bird",
          "from the snare of the fowlers;",
          "the snare is broken,",
          "and we have escaped!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Our help is in the name of the Lord,",
          "who made heaven and earth."
        ],
        "rlw_lines": []
      }
    ]
