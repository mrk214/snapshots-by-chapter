    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Reprensión por la apostasía del pueblo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Oigan esto, sacerdotes!",
          "¡Estén atentos, casa de Israel!",
          "¡Escuchen casa del rey!",
          "Porque para ustedes es el juicio;",
          "Pues han sido lazo en Mizpa,",
          "Y red tendida en el monte Tabor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Los rebeldes se han ahondado en la perversión;",
          "Pero Yo los castigaré a todos ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Yo conozco a Efraín, e Israel no se me oculta;",
          "Porque ahora te has prostituido, Efraín,",
          "Se ha contaminado Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No les permiten sus obras",
          "Volver a su Dios,",
          "Porque hay un espíritu de prostitución dentro de ellos,",
          "Y no conocen al Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Además, el orgullo de Israel testifica contra él,",
          "E Israel y Efraín tropiezan en su iniquidad;",
          "También Judá ha tropezado con ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Irán con sus rebaños y sus ganados",
          "En busca del Señor, pero no lo encontrarán;",
          "Él se ha retirado de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Han obrado perversamente contra el Señor,",
          "Porque han tenido hijos ilegítimos.",
          "Ahora los devorará la luna nueva junto con sus heredades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Toquen la bocina en Guibeá,",
          "La trompeta en Ramá.",
          "Suenen alarma en Bet Avén:",
          "¡Estate alerta, Benjamín!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Efraín será una desolación en el día de la reprensión;",
          "En las tribus de Israel Yo hago saber lo que es cierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los príncipes de Judá son como los que mueven los linderos;",
          "Sobre ellos derramaré Mi furor como agua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Efraín está oprimido, quebrantado por el juicio,",
          "Porque insistía en seguir mandato de hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Yo, pues, soy como polilla para Efraín,",
          "Y como carcoma para la casa de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Cuando Efraín vio su enfermedad",
          "Y Judá su herida,",
          "Efraín fue a Asiria",
          "Y envió mensaje al rey Jareb;",
          "Pero él no los podrá sanar,",
          "Ni curar su herida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque Yo seré como león para Efraín,",
          "Y como leoncillo para la casa de Judá.",
          "Yo, Yo mismo, desgarraré y me iré,",
          "Arrebataré y no habrá quien libre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Me iré y volveré a Mi lugar",
          "Hasta que reconozcan su culpa y busquen Mi rostro;",
          "En su angustia me buscarán con diligencia."
        ],
        "rlw_lines": []
      }
    ]
  },
