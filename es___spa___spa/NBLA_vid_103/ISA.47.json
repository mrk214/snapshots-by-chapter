    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Juicio sobre Babilonia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»Desciende y siéntate en el polvo,",
          "Virgen hija de Babilonia.",
          "Siéntate en la tierra, sin trono,",
          "Hija de los caldeos,",
          "Porque nunca más serás llamada tierna y delicada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "-»Toma las piedras de molino y muele la harina.",
          "Quítate el velo, despójate de la falda,",
          "Descubre tus piernas, pasa los ríos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "-»Será descubierta tu desnudez,",
          "También será expuesta tu vergüenza.",
          "Tomaré venganza y no perdonaré a hombre alguno»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Nuestro Redentor, el Señor de los ejércitos es Su nombre,",
          "El Santo de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "«Siéntate en silencio y entra en las tinieblas,",
          "Hija de los caldeos,",
          "Porque nunca más te llamarán",
          "Soberana de reinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "-»Estaba enojado contra Mi pueblo,",
          "Profané Mi heredad",
          "Y en tu mano los entregué.",
          "No les mostraste compasión,",
          "Sobre el anciano hiciste muy pesado tu yugo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Y dijiste: “Seré soberana para siempre”.",
          "No consideraste esto en tu corazón,",
          "Ni te acordaste de su resultado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶»Ahora pues, oye esto, voluptuosa,",
          "Tú que moras confiadamente,",
          "Que dices en tu corazón:",
          "“Yo, y nadie más.",
          "No me quedaré viuda,",
          "Ni sabré de pérdida de hijos”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "-»Pero estas dos cosas vendrán de repente sobre ti en un mismo día:",
          "Pérdida de hijos y viudez.",
          "Vendrán sobre ti en toda su plenitud",
          "A pesar de tus muchas hechicerías,",
          "A pesar del gran poder de tus encantamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "-»Te sentiste segura en tu maldad y dijiste:",
          "“Nadie me ve”.",
          "Tu sabiduría y tu conocimiento te han engañado,",
          "Y dijiste en tu corazón:",
          "“Yo, y nadie más”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "-»Pero un mal vendrá sobre ti",
          "Que no sabrás impedir;",
          "Caerá sobre ti un desastre",
          "Que no podrás remediar.",
          "Vendrá de repente sobre ti",
          "Una destrucción que no conoces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶»Permanece ahora en tus encantamientos",
          "Y en tus muchas hechicerías",
          "En las cuales te has ocupado desde tu juventud.",
          "Tal vez podrás sacar provecho,",
          "Tal vez causarás temor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "-»Estás fatigada por los muchos consejos.",
          "Que se levanten ahora los que contemplan los cielos,",
          "Los que profetizan por medio de las estrellas,",
          "Los que pronostican cada luna nueva,",
          "Y te salven de lo que vendrá sobre ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "-»Ellos se han vuelto como rastrojo,",
          "El fuego los quema;",
          "No librarán sus vidas del poder de la llama.",
          "No habrá brasas para calentarse,",
          "Ni lumbre ante la cual sentarse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "-»Así han venido a ser para ti aquellos con quienes has trabajado,",
          "Que han negociado contigo desde tu juventud.",
          "Cada cual vaga por su camino,",
          "No hay nadie que te salve."
        ],
        "rlw_lines": []
      }
    ]
  },
