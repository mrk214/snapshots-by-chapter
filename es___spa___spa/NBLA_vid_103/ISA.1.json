    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Rebelión del pueblo de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Visión que tuvo Isaías, hijo de Amoz, con relación a Judá y Jerusalén, en los días de Uzías, Jotam, Acaz y Ezequías, reyes de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Oigan, cielos, y escucha, tierra,",
          "Porque el Señor habla:",
          "«Hijos crié y los hice crecer,",
          "Pero ellos se han rebelado contra Mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "-»El buey conoce a su dueño",
          "Y el asno el pesebre de su amo;",
          "Pero Israel no conoce,",
          "Mi pueblo no tiene entendimiento»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶¡Ay, nación pecadora,",
          "Pueblo cargado de iniquidad,",
          "Generación de malvados,",
          "Hijos corrompidos!",
          "Han abandonado al Señor,",
          "Han despreciado al Santo de Israel,",
          "Se han apartado de Él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶¿Dónde más serán castigados?",
          "¿Continuarán en rebelión?",
          "Toda cabeza está enferma,",
          "Y todo corazón desfallecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Desde la planta del pie hasta la cabeza",
          "No hay nada sano en él,",
          "Sino golpes, verdugones y heridas recientes;",
          "No han sido curadas, ni vendadas,",
          "Ni suavizadas con aceite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶La tierra de ustedes está desolada,",
          "Sus ciudades quemadas por el fuego,",
          "Su suelo lo devoran los extraños delante de ustedes,",
          "Y es una desolación, como destruida por extraños."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "La hija de Sión ha quedado como cobertizo en una viña,",
          "Como choza en un pepinar, como ciudad sitiada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Si el Señor de los ejércitos",
          "No nos hubiera dejado algunos sobrevivientes,",
          "Seríamos como Sodoma,",
          "Y semejantes a Gomorra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Oigan la palabra del Señor,",
          "Gobernantes de Sodoma.",
          "Escuchen la instrucción de nuestro Dios,",
          "Pueblo de Gomorra:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "«¿Qué es para Mí la abundancia de sus sacrificios?»,",
          "Dice el Señor.",
          "«Cansado estoy de holocaustos de carneros,",
          "Y de sebo de ganado cebado;",
          "La sangre de novillos, corderos y machos cabríos no me complace."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "-»Cuando vienen a presentarse delante de Mí,",
          "¿Quién demanda esto de ustedes, de que pisoteen Mis atrios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "-»No traigan más sus vanas ofrendas,",
          "El incienso me es abominación.",
          "Luna nueva y día de reposo, el convocar asambleas:",
          "¡No tolero iniquidad y asamblea solemne!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "-»Sus lunas nuevas y sus fiestas señaladas las aborrece Mi alma.",
          "Se han vuelto una carga para Mí,",
          "Estoy cansado de soportarlas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "-»Cuando extiendan sus manos,",
          "Esconderé Mis ojos de ustedes.",
          "Sí, aunque multipliquen las oraciones,",
          "No escucharé.",
          "Sus manos están llenas de sangre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶»Lávense, límpiense,",
          "Quiten la maldad de sus obras de delante de Mis ojos.",
          "Cesen de hacer el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "-»Aprendan a hacer el bien,",
          "Busquen la justicia,",
          "Reprendan al opresor,",
          "Defiendan al huérfano,",
          "Aboguen por la viuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¶»Vengan ahora, y razonemos»,",
          "Dice el Señor,",
          "«Aunque sus pecados sean como la grana,",
          "Como la nieve serán emblanquecidos.",
          "Aunque sean rojos como el carmesí,",
          "Como blanca lana quedarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "-»Si ustedes quieren y obedecen,",
          "Comerán lo mejor de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "-»Pero si rehúsan y se rebelan,",
          "Por la espada serán devorados».",
          "Ciertamente, la boca del Señor ha hablado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¶¡Cómo se ha convertido en ramera la ciudad fiel,",
          "La que estaba llena de justicia!",
          "Moraba en ella la rectitud,",
          "Pero ahora, asesinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Tu plata se ha vuelto escoria,",
          "Tu vino está mezclado con agua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Tus gobernantes son rebeldes",
          "Y compañeros de ladrones;",
          "Cada uno ama el soborno",
          "Y corre tras las dádivas.",
          "No defienden al huérfano,",
          "Ni llega a ellos la causa de la viuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Juicio y redención de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¶Por tanto, declara el Señor, Dios de los ejércitos,",
          "El Poderoso de Israel:",
          "«¡Ah!, me libraré de Mis adversarios,",
          "Y me vengaré de Mis enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "-»También volveré Mi mano contra ti,",
          "Te limpiaré de tu escoria como con lejía,",
          "Y quitaré toda tu impureza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "-»Entonces restauraré tus jueces como al principio,",
          "Y tus consejeros como al comienzo.",
          "Después de lo cual serás llamada Ciudad de Justicia,",
          "Ciudad Fiel»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "¶Sión será redimida con juicio,",
          "Y sus arrepentidos con justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Pero los transgresores y los pecadores serán aplastados a una,",
          "Y los que abandonan al Señor perecerán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Ciertamente ustedes se avergonzarán de las encinas que han deseado,",
          "Y se avergonzarán de los jardines que han escogido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Porque ustedes serán como encina cuya hoja está marchita,",
          "Y como jardín en que no hay agua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "El fuerte se convertirá en estopa,",
          "Y su trabajo en chispa.",
          "Arderán ambos a una,",
          "Y no habrá quien los apague."
        ],
        "rlw_lines": []
      }
    ]
  },
