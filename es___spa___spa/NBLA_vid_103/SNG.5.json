{"version":{"version_id":103,"local_abbreviation":"NBLA","local_title":"Nueva Biblia de las Américas","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"The Lockman Foundation"},"copyright":{"html":"1986, 1995, 1997, 2005 by The Lockman Foundation","text":"1986, 1995, 1997, 2005 by The Lockman Foundation"}},"book":{"book_usfm":"SNG","name":"Cantares"},"chapter":{"chapter_usfm":"SNG.5","is_chapter":true,"previous":{"usfm":"SNG.4","human":"Cantares 4","canonical":true,"toc":true},"current":{"usfm":"SNG.5","human":"Cantares 5"},"next":{"usfm":"SNG.6","human":"Cantares 6","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["EL ESPOSO:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["«He entrado en mi huerto, hermana mía, esposa mía;","He recogido mi mirra con mi bálsamo.","He comido mi panal y mi miel;","He bebido mi vino y mi leche.","Coman, amigos;","Beban y embriáguense, oh amados»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El tormento de la separación"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["LA ESPOSA:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["¶«Yo dormía, pero mi corazón velaba,","¡Una voz! ¡Mi amado toca a la puerta!","“Ábreme, hermana mía, amada mía,","Paloma mía, perfecta mía,","Pues mi cabeza está empapada de rocío,","Mis cabellos empapados de la humedad de la noche”."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["-»Me he quitado la ropa,","¿Cómo he de vestirme de nuevo?","Me he lavado los pies,","¿Cómo he de ensuciarlos de nuevo?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["-»Mi amado metió su mano por la abertura de la puerta,","Y se estremecieron por él mis entrañas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["-»Yo me levanté para abrir a mi amado;","Y mis manos destilaron mirra,","Y mis dedos mirra líquida,","Sobre las manecillas de la cerradura."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["-»Abrí yo a mi amado,","Pero mi amado se había retirado, se había ido.","Tras su hablar salió mi alma.","Lo busqué, y no lo hallé;","Lo llamé, y no me respondió."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["-»Me hallaron los guardas que rondan la ciudad,","Me golpearon y me hirieron;","Me quitaron de encima mi chal los guardas de las murallas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["-»Yo les ruego, oh hijas de Jerusalén,","Si encuentran a mi amado,","¿Qué le han de decir?:","Que estoy enferma de amor»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["EL CORO:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["¶«¿Qué clase de amado es tu amado,","Oh la más hermosa de las mujeres?","¿Qué clase de amado es tu amado,","Que así nos ruegas?»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["LA ESPOSA:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["¶«Mi amado es apuesto y sonrosado,","Distinguido entre diez mil."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["-»Su cabeza es como oro, oro puro,","Sus cabellos, como racimos de dátiles,","Negros como el cuervo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["-»Sus ojos son como palomas","Junto a corrientes de agua,","Bañados en leche,","Colocados en su engaste."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["-»Sus mejillas, como eras de bálsamo,","Como riberas de hierbas aromáticas;","Sus labios son lirios","Que destilan mirra líquida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["-»Sus manos son barras de oro","Engastadas de berilo;","Su vientre es marfil tallado","Recubierto de zafiros."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["-»Sus piernas son columnas de alabastro","Asentadas sobre basas de oro puro;","Su aspecto es como el Líbano,","Gallardo como los cedros."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["-»Su paladar es dulcísimo,","Y todo él, deseable.","Este es mi amado y este es mi amigo,","Hijas de Jerusalén»."],"rlw_lines":[]}]}}