    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 108"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza y súplica"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mi corazón está firme, oh Dios;",
          "Cantaré, cantaré alabanzas, aun con mi alma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Despierten, arpa y lira!",
          "¡A la aurora despertaré!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Te daré gracias entre los pueblos, Señor;",
          "Te cantaré alabanzas entre las naciones."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque grande, por encima de los cielos, es Tu misericordia,",
          "Y hasta el firmamento Tu verdad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Exaltado seas sobre los cielos, oh Dios,",
          "Sobre toda la tierra sea Tu gloria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Para que sean librados Tus amados,",
          "Salva con Tu diestra, y respóndeme."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Dios ha hablado en Su santuario:",
          "«Me alegraré, repartiré a Siquem",
          "Y mediré el valle de Sucot."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "-»Mío es Galaad, Mío es Manasés,",
          "Efraín es el casco de Mi cabeza,",
          "Judá es Mi cetro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "-»Moab es la vasija en que me lavo;",
          "Sobre Edom arrojaré Mi calzado;",
          "Sobre Filistea lanzaré gritos»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶¿Quién me conducirá a la ciudad fortificada?",
          "¿Quién me guiará hasta Edom?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿No eres Tú, oh Dios, el que nos ha rechazado?",
          "¿No saldrás, oh Dios, con nuestros ejércitos?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Danos ayuda contra el adversario,",
          "Pues vano es el auxilio del hombre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "En Dios haremos proezas,",
          "Y Él pisoteará a nuestros adversarios."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
