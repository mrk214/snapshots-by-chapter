    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 62"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, el único refugio"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; según Jedutún. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En Dios solamente espera en silencio mi alma;",
          "De Él viene mi salvación."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Solo Él es mi roca y mi salvación,",
          "Mi baluarte, nunca seré sacudido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶¿Hasta cuándo atacarán a un hombre,",
          "Todos ustedes, para derribarlo,",
          "Como pared inclinada, como cerca que se tambalea?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ellos solamente consultan para derribarlo de su eminencia;",
          "En la falsedad se deleitan;",
          "Bendicen con la boca,",
          "Pero por dentro maldicen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Alma mía, espera en silencio solamente en Dios,",
          "Pues de Él viene mi esperanza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Solo Él es mi roca y mi salvación,",
          "Mi refugio, nunca seré sacudido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En Dios descansan mi salvación y mi gloria;",
          "La roca de mi fortaleza, mi refugio, está en Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Confíen en Él en todo tiempo,",
          "Oh pueblo; derramen su corazón delante de Él;",
          "Dios es nuestro refugio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Los hombres de baja condición solo son vanidad, y los de alto rango son mentira;",
          "En la balanza suben,",
          "Todos juntos pesan menos que un soplo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No confíen ustedes en la opresión,",
          "Ni en el robo pongan su esperanza;",
          "Si las riquezas aumentan, no pongan el corazón en ellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Una vez ha hablado Dios;",
          "Dos veces he oído esto:",
          "Que de Dios es el poder;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Y Tuya es, oh Señor, la misericordia,",
          "Pues Tú pagas al hombre conforme a sus obras."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
