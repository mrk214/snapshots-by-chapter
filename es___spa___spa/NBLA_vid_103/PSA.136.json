    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 136"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Gratitud por la misericordia del Señor para con Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Den gracias al Señor porque Él es bueno,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Den gracias al Dios de dioses,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Den gracias al Señor de señores,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Al único que hace grandes maravillas,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Al que con sabiduría hizo los cielos,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Al que extendió la tierra sobre las aguas,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Al que hizo las grandes lumbreras,",
          "Porque para siempre es Su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El sol para que reine de día,",
          "Porque para siempre es Su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "La luna y las estrellas para que reinen de noche,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Al que hirió a Egipto en sus primogénitos,",
          "Porque para siempre es Su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Y sacó a Israel de en medio de ellos,",
          "Porque para siempre es Su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Con mano fuerte y brazo extendido,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Al que dividió en dos el mar Rojo,",
          "Porque para siempre es Su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "E hizo pasar a Israel por en medio de él,",
          "Porque para siempre es Su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero a Faraón y a su ejército destruyó en el mar Rojo,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Al que condujo a Su pueblo por el desierto,",
          "Porque para siempre es Su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Al que hirió a grandes reyes,",
          "Porque para siempre es Su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Y mató a reyes poderosos,",
          "Porque para siempre es Su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A Sehón, rey de los amorreos,",
          "Porque para siempre es Su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Y a Og, rey de Basán,",
          "Porque para siempre es Su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Y dio la tierra de ellos en heredad,",
          "Porque para siempre es Su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "En heredad a Israel Su siervo,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¶El que se acordó de nosotros en nuestra humillación,",
          "Porque para siempre es Su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Y nos rescató de nuestros adversarios,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "El que da sustento a toda carne,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Den gracias al Dios del cielo,",
          "Porque para siempre es Su misericordia."
        ],
        "rlw_lines": []
      }
    ]
