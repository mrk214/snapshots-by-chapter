    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 63"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El alma sedienta se satisface en Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David, cuando estaba en el desierto de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Dios, Tú eres mi Dios; te buscaré con afán.",
          "Mi alma tiene sed de Ti, mi carne te anhela",
          "Cual tierra seca y árida donde no hay agua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Así te contemplaba en el santuario,",
          "Para ver Tu poder y Tu gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque Tu misericordia es mejor que la vida,",
          "Mis labios te alabarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Así te bendeciré mientras viva,",
          "En Tu nombre alzaré mis manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Como con médula y grasa está saciada mi alma;",
          "Y con labios jubilosos te alaba mi boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Cuando en mi lecho me acuerdo de Ti,",
          "En Ti medito durante las vigilias de la noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque Tú has sido mi ayuda,",
          "Y a la sombra de Tus alas canto gozoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A Ti se aferra mi alma;",
          "Tu diestra me sostiene."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Pero los que buscan mi vida para destruirla,",
          "Caerán a las profundidades de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Serán entregados al poder de la espada;",
          "Presa serán de las zorras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pero el rey se regocijará en Dios;",
          "Y todo el que por Él jura se gloriará,",
          "Porque la boca de los que dicen mentiras será cerrada."
        ],
        "rlw_lines": []
      }
    ]
  },
