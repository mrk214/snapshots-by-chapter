      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Den gracias a Dios las naciones"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; con instrumentos de cuerda. Salmo. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios tenga piedad de nosotros y nos bendiga,",
          "Y haga resplandecer Su rostro sobre nosotros,"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Para que sea conocido en la tierra Tu camino,",
          "Entre todas las naciones Tu salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Te den gracias los pueblos, oh Dios,",
          "Todos los pueblos te den gracias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alégrense y canten con júbilo las naciones,",
          "Porque Tú juzgarás a los pueblos con equidad,",
          "Y guiarás a las naciones en la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Te den gracias los pueblos, oh Dios,",
          "Todos los pueblos te den gracias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "La tierra ha dado su fruto;",
          "Dios, nuestro Dios, nos bendice."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios nos bendice,",
          "Para que le teman todos los términos de la tierra."
        ],
        "rlw_lines": []
      }
