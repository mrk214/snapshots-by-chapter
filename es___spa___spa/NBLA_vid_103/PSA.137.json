    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 137"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lamento de los cautivos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Junto a los ríos de Babilonia,",
          "Nos sentábamos y llorábamos",
          "Al acordarnos de Sión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sobre los sauces en medio de ella",
          "Colgamos nuestras arpas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pues allí los que nos habían llevado cautivos nos pedían canciones,",
          "Y los que nos atormentaban nos pedían alegría, diciendo:",
          "«Cántennos alguno de los cánticos de Sión»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶¿Cómo cantaremos la canción del Señor",
          "En tierra extraña?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Si me olvido de ti, oh Jerusalén,",
          "Pierda mi diestra su destreza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Péguese mi lengua al paladar",
          "Si no me acuerdo de ti,",
          "Si no enaltezco a Jerusalén",
          "Sobre mi supremo gozo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Recuerda, oh Señor, contra los hijos de Edom",
          "El día de Jerusalén,",
          "Quienes dijeron: «Arrásenla, arrásenla",
          "Hasta sus cimientos»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oh hija de Babilonia, la devastada,",
          "Bienaventurado el que te devuelva",
          "El pago con que nos pagaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Bienaventurado será el que tome y estrelle tus pequeños",
          "Contra la peña."
        ],
        "rlw_lines": []
      }
    ]
  },
