    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La sabiduría y la insensatez"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La sabiduría ha edificado su casa,",
          "Ha labrado sus siete columnas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ha preparado su alimento, ha mezclado su vino,",
          "Ha puesto también su mesa;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ha enviado a sus doncellas, y clama",
          "Desde los lugares más altos de la ciudad:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«El que sea simple que entre aquí».",
          "Al falto de entendimiento le dice:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "«Ven, come de mi pan,",
          "Y bebe del vino que he mezclado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "-»Abandona la necedad y vivirás;",
          "Anda por el camino del entendimiento»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶El que instruye al insolente, atrae sobre sí deshonra,",
          "Y el que reprende al impío recibe insultos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No reprendas al insolente, para que no te aborrezca;",
          "Reprende al sabio, y te amará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Da instrucción al sabio, y será aún más sabio,",
          "Enseña al justo, y aumentará su saber."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El principio de la sabiduría es el temor del Señor,",
          "Y el conocimiento del Santo es inteligencia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pues por mí se multiplicarán tus días,",
          "Y años de vida te serán añadidos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si eres sabio, eres sabio para provecho tuyo,",
          "Y si escarneces, tú solo lo sufrirás."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¶La mujer insensata es alborotadora,",
          "Es simple y no sabe nada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Se sienta a la puerta de su casa,",
          "En un asiento, en los lugares altos de la ciudad,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Llamando a los que pasan,",
          "A los que van derechos por sus sendas:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "«El que sea simple, que entre aquí».",
          "Y al falto de entendimiento, le dice:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "«Dulces son las aguas hurtadas,",
          "Y el pan comido en secreto es sabroso»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero él no sabe que allí están los muertos,",
          "Que sus invitados están en las profundidades del Seol."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
