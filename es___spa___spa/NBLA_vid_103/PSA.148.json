    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 148"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabe la creación al Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "Alaben al Señor desde los cielos;",
          "Alábenlo en las alturas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alábenlo, todos Sus ángeles;",
          "Alábenlo, todos Sus ejércitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Alábenlo, sol y luna;",
          "Alábenlo, todas las estrellas luminosas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alábenlo, cielos de los cielos,",
          "Y las aguas que están sobre los cielos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Alaben ellos el nombre del Señor,",
          "Pues Él ordenó y fueron creados;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los estableció eternamente y para siempre,",
          "Les dio ley que no pasará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Alaben al Señor desde la tierra,",
          "Monstruos marinos y todos los abismos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Fuego y granizo, nieve y bruma;",
          "Viento tempestuoso que cumple Su palabra;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los montes y todas las colinas;",
          "Árboles frutales y todos los cedros;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Las fieras y todo el ganado;",
          "Reptiles y aves que vuelan;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Reyes de la tierra y todos los pueblos;",
          "Príncipes y todos los jueces de la tierra;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Jóvenes y también vírgenes;",
          "Los ancianos junto con los niños."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¶Alaben ellos el nombre del Señor,",
          "Porque solo Su nombre es exaltado;",
          "Su gloria es sobre tierra y cielos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Él ha exaltado el poder de Su pueblo,",
          "Alabanza para todos Sus santos,",
          "Para los israelitas, pueblo a Él cercano.",
          "¡Aleluya!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
