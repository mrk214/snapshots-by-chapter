    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Respuesta del pueblo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "«Vengan, volvamos al Señor.",
          "Pues Él nos ha desgarrado, pero nos sanará;",
          "Nos ha herido, pero nos vendará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "-»Nos dará vida después de dos días,",
          "Al tercer día nos levantará",
          "Y viviremos delante de Él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "-»Conozcamos, pues, esforcémonos por conocer al Señor.",
          "Su salida es tan cierta como la aurora,",
          "Y Él vendrá a nosotros como la lluvia,",
          "Como la lluvia de primavera que riega la tierra»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶¿Qué haré contigo, Efraín?",
          "¿Qué haré contigo, Judá?",
          "Porque la lealtad de ustedes es como nube matinal,",
          "Y como el rocío, que temprano desaparece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Por tanto los he despedazado por medio de los profetas,",
          "Los he matado con las palabras de Mi boca;",
          "Los juicios sobre ti son como la luz que sale."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque me deleito más en la lealtad que en el sacrificio,",
          "Y en el conocimiento de Dios que en los holocaustos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pero ellos, como Adán, han transgredido el pacto;",
          "Allí me han traicionado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Galaad es ciudad de malhechores,",
          "Con huellas de sangre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Como bandidos al acecho de un hombre,",
          "Es la banda de sacerdotes que asesina en el camino a Siquem;",
          "Ciertamente han cometido iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "En la casa de Israel he visto una cosa horrible:",
          "Allí está la prostitución de Efraín, se ha contaminado Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Para ti también, oh Judá, hay preparada una cosecha,",
          "Cuando Yo restaure el bienestar de Mi pueblo."
        ],
        "rlw_lines": []
      }
    ]
  },
