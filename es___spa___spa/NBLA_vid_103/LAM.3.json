    "name": "Lamentaciones"
  },
  "chapter": {
    "chapter_usfm": "LAM.3",
    "is_chapter": true,
    "previous": {
      "usfm": "LAM.2",
      "human": "Lamentaciones 2"
    },
    "current": {
      "usfm": "LAM.3",
