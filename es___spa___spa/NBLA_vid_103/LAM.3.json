      "human": "Lamentaciones 4"
    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lamentación del afligido"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Yo soy el hombre que ha visto la aflicción",
          "A causa de la vara de Su furor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Él me ha llevado y me ha hecho andar",
          "En tinieblas y no en luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ciertamente contra mí ha vuelto y revuelto",
          "Su mano todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ha hecho que se consuman mi carne y mi piel,",
          "Ha quebrado mis huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me ha sitiado y rodeado",
          "De amargura y de fatiga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "En lugares tenebrosos me ha hecho morar,",
          "Como los que han muerto hace tiempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Con muro me ha cercado y no puedo salir,",
          "Ha hecho pesadas mis cadenas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Aun cuando clamo y pido auxilio,",
          "Él cierra el paso a mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ha cerrado mis caminos con piedra labrada,",
          "Ha hecho tortuosos mis senderos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Él es para mí como oso en acecho,",
          "Como león en lugares ocultos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ha desviado mis caminos y me ha destrozado,",
          "Me ha dejado desolado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ha tensado Su arco",
          "Y me ha puesto como blanco de la flecha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Hizo que penetraran en mis entrañas",
          "Las flechas de Su aljaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "He venido a ser objeto de burla de todo mi pueblo,",
          "Su canción todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Él me ha llenado de amargura,",
          "Me ha embriagado con ajenjo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ha quebrado con guijarro mis dientes,",
          "Ha hecho que me revuelque en el polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Y mi alma ha sido privada de la paz,",
          "He olvidado la felicidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Digo, pues: «Se me acabaron las fuerzas,",
          "Y mi esperanza que venía del Señor»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¶Acuérdate de mi aflicción y de mi vagar,",
          "Del ajenjo y de la amargura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Ciertamente mi alma lo recuerda",
          "Y se abate mi alma dentro de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Esto traigo a mi corazón,",
          "Por esto tengo esperanza:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Que las misericordias del Señor jamás terminan,",
          "Pues nunca fallan Sus bondades;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Son nuevas cada mañana;",
          "¡Grande es Tu fidelidad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "«El Señor es mi porción», dice mi alma,",
          "«Por tanto en Él espero»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Bueno es el Señor para los que en Él esperan,",
          "Para el alma que lo busca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Bueno es esperar en silencio",
          "La salvación del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Bueno es para el hombre llevar",
          "El yugo en su juventud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Que se siente solo y en silencio",
          "Ya que Él se lo ha impuesto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Que ponga su boca en el polvo,",
          "Quizá haya esperanza;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Que dé la mejilla al que lo hiere;",
          "Que se sacie de oprobios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Porque el Señor no rechaza para siempre,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Antes bien, si aflige, también se compadecerá",
          "Según Su gran misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Porque Él no castiga por gusto",
          "Ni aflige a los hijos de los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Aplastar bajo los pies",
          "A todos los prisioneros de un país,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Privar del derecho a un hombre",
          "En presencia del Altísimo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Defraudar a un hombre en su litigio:",
          "Estas cosas no aprueba el Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "¿Quién es aquel que habla y así sucede,",
          "A menos que el Señor lo haya ordenado?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "¿No salen de la boca del Altísimo",
          "Tanto el mal como el bien?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "¶¿Por qué ha de quejarse el ser viviente?",
          "¡Sea valiente frente a sus pecados!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Examinemos nuestros caminos y escudriñémoslos,",
          "Y volvamos al Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Alcemos nuestro corazón en nuestras manos",
          "Hacia Dios en los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Nosotros hemos transgredido y nos hemos rebelado;",
          "Tú no has perdonado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Te has cubierto de ira y nos has perseguido;",
          "Has matado y no has perdonado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Te has cubierto de una nube",
          "Para que no pase la oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Basura y escoria nos has hecho",
          "En medio de los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Han abierto su boca contra nosotros",
          "Todos nuestros enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Nos han sobrevenido terror y foso,",
          "Desolación y destrucción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Arroyos de lágrimas derraman mis ojos",
          "A causa de la destrucción de la hija de mi pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Mis ojos fluyen sin cesar,",
          "Ya que no hay descanso"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Hasta que el Señor mire",
          "Y vea desde los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Mis ojos traen dolor a mi alma",
          "Por todas las hijas de mi ciudad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Mis enemigos, sin haber causa,",
          "Constantemente me han dado caza como a un ave."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Silenciaron mi vida en la fosa,",
          "Pusieron piedra sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Cubrieron las aguas mi cabeza,",
          "Dije: «¡Estoy perdido!»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Invoqué Tu nombre, oh Señor,",
          "Desde la fosa más profunda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Tú oíste mi voz: «No escondas",
          "Tu oído a mi clamor, a mi grito de auxilio»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "Te acercaste el día que te invoqué,",
          "Dijiste: «¡No temas!»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Tú has defendido, oh Señor, la causa de mi alma,",
          "Tú has redimido mi vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Tú has visto, oh Señor, mi opresión,",
          "Juzga mi causa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Has visto toda su venganza,",
          "Todas sus tramas contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Has oído sus oprobios, oh Señor,",
          "Todas sus tramas contra mí;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "Los labios de mis agresores y sus murmuraciones",
          "Están contra mí todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Se sienten o se levanten, míralos,",
          "Yo soy el objeto de su canción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Tú les darás su pago, oh Señor,",
          "Conforme a la obra de sus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Les darás dureza de corazón,",
          "Tu maldición será sobre ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Los perseguirás con ira y los destruirás",
          "De debajo de los cielos del Señor."
        ],
        "rlw_lines": []
      }
    ]
  },
