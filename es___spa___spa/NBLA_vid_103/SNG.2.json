    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "«Yo soy la rosa de Sarón,",
          "El lirio de los valles»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL ESPOSO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¶«Como el lirio entre los espinos,",
          "Así es mi amada entre las doncellas»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶«Como el manzano entre los árboles del bosque,",
          "Así es mi amado entre los jóvenes.",
          "A su sombra placentera me he sentado,",
          "Y su fruto es dulce a mi paladar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "-»Él me ha traído a la sala del banquete,",
          "Y su estandarte sobre mí es el amor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "-»Susténtenme con tortas de pasas,",
          "Reanímenme con manzanas,",
          "Porque estoy enferma de amor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "-»Que su izquierda esté bajo mi cabeza",
          "Y su derecha me abrace»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL ESPOSO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶«Yo les ruego, oh hijas de Jerusalén,",
          "Por las gacelas o por las ciervas del campo,",
          "Que no levanten ni despierten a mi amor",
          "Hasta que quiera»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶«¡Una voz! ¡Mi amado!",
          "¡Miren, él viene,",
          "Saltando por los montes,",
          "Brincando por los collados!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "-»Mi amado es semejante a una gacela o a un cervatillo.",
          "¡Miren, se detiene detrás de nuestro muro,",
          "Mirando por las ventanas,",
          "Espiando por las celosías!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶»Mi amado habló, y me dijo:",
          "“Levántate, amada mía, hermosa mía,",
          "Y ven conmigo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "-”Pues mira, ha pasado el invierno,",
          "Ha cesado la lluvia y se ha ido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "-”Han aparecido las flores en la tierra;",
          "Ha llegado el tiempo de podar las vides,",
          "Y se oye la voz de la tórtola en nuestra tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "-”La higuera ha madurado sus higos,",
          "Y las vides en flor han esparcido su fragancia.",
          "¡Levántate amada mía, hermosa mía,",
          "Y ven conmigo!” »."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL ESPOSO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¶«Paloma mía, en las grietas de la peña,",
          "En lo secreto de la senda escarpada,",
          "Déjame ver tu semblante,",
          "Déjame oír tu voz;",
          "Porque tu voz es dulce,",
          "Y precioso tu semblante»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL CORO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¶«Agarren las zorras,",
          "Las zorras pequeñas que arruinan las viñas,",
          "Pues nuestras viñas están en flor»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶«Mi amado es mío, y yo soy suya;",
          "Él apacienta su rebaño entre los lirios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "-»Hasta que sople la brisa del día y huyan las sombras,",
          "Vuelve, amado mío, y sé semejante a una gacela",
          "O a un cervatillo sobre los montes de Beter»."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
