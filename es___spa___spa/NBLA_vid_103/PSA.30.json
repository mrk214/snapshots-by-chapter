    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 30"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Acción de gracias por haber sido librado de la muerte"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo. Cántico para la dedicación de la Casa. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Te ensalzaré, oh Señor, porque me has elevado,",
          "Y no has permitido que mis enemigos se rían de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Oh Señor, Dios mío,",
          "A Ti pedí auxilio y me sanaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Oh Señor, has sacado mi alma del Seol;",
          "Me has guardado con vida, para que no descienda al sepulcro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Canten alabanzas al Señor, ustedes Sus santos,",
          "Y alaben Su santo nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque Su ira es solo por un momento,",
          "Pero Su favor es por toda una vida.",
          "El llanto puede durar toda la noche,",
          "Pero a la mañana vendrá el grito de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶En cuanto a mí, en mi prosperidad dije:",
          "«Jamás seré conmovido»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Oh Señor, con Tu favor has hecho que mi monte permanezca fuerte;",
          "Tú escondiste Tu rostro, fui conturbado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A Ti, oh Señor, clamé,",
          "Y al Señor dirigí mi súplica:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "«¿Qué provecho hay en mi sangre si desciendo al sepulcro?",
          "¿Acaso te alabará el polvo? ¿Anunciará Tu fidelidad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶»Escucha, oh Señor, y ten piedad de mí;",
          "Oh Señor, sé Tú mi ayuda»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tú has cambiado mi lamento en danza;",
          "Has desatado mi ropa de luto y me has ceñido de alegría;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Para que mi alma te cante alabanzas y no esté callada.",
          "Oh Señor, Dios mío, te daré gracias por siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
