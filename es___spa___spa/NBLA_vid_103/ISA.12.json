    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cántico de acción de gracias"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Y en aquel día dirás:",
          "«Te doy gracias, oh Señor,",
          "Porque aunque estabas enojado conmigo,",
          "Tu ira se ha apartado",
          "Y me has consolado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "-»Dios es mi salvación,",
          "Confiaré y no temeré;",
          "Porque mi fortaleza y mi canción es el Señor Dios,",
          "Él ha sido mi salvación»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Con gozo sacarás agua",
          "De los manantiales de la salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Y en aquel día dirás:",
          "«Den gracias al Señor, invoquen Su nombre,",
          "Hagan conocer entre los pueblos Sus obras,",
          "Hagan recordar que Su nombre es exaltado»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Canten alabanzas al Señor, porque ha hecho cosas maravillosas.",
          "Sea conocido esto por toda la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Clama y grita de júbilo, habitante de Sión,",
          "Porque grande es en medio de ti el Santo de Israel."
        ],
        "rlw_lines": []
      }
    ]
  },
