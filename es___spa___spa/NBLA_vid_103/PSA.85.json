    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 85"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración pidiendo misericordia para la nación"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Señor, Tú mostraste favor a Tu tierra,",
          "Cambiaste la cautividad de Jacob."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Perdonaste la iniquidad de Tu pueblo,",
          "Cubriste todo su pecado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Retiraste toda Tu furia,",
          "Te apartaste del ardor de Tu ira."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Restáuranos, oh Dios de nuestra salvación,",
          "Haz cesar Tu indignación contra nosotros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Estarás enojado con nosotros para siempre?",
          "¿Prolongarás Tu ira de generación en generación?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿No volverás a darnos vida",
          "Para que Tu pueblo se regocije en Ti?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Muéstranos, oh Señor, Tu misericordia,",
          "Y danos Tu salvación."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Escucharé lo que dirá Dios el Señor,",
          "Porque hablará paz a Su pueblo, a Sus santos;",
          "Pero que no vuelvan ellos a la insensatez."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ciertamente cercana está Su salvación para los que le temen,",
          "Para que more Su gloria en nuestra tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "La misericordia y la verdad se han encontrado,",
          "La justicia y la paz se han besado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "La verdad brota de la tierra,",
          "Y la justicia mira desde los cielos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ciertamente el Señor dará lo que es bueno,",
          "Y nuestra tierra dará su fruto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La justicia irá delante de Él",
          "Y pondrá por camino Sus pasos."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
