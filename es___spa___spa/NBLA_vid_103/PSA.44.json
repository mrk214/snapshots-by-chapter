    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 44"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración nacional de intercesión"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro. Masquil de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Dios, con nuestros oídos hemos oído,",
          "Nuestros padres nos han contado",
          "La obra que hiciste en sus días,",
          "En los tiempos antiguos:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tú con Tu mano echaste fuera las naciones,",
          "Pero a ellos los plantaste.",
          "Afligiste a los pueblos,",
          "Pero a ellos los hiciste crecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pues no fue por su espada que tomaron posesión de la tierra,",
          "Ni fue su brazo el que los salvó,",
          "Sino Tu diestra y Tu brazo, y la luz de Tu presencia,",
          "Porque te complaciste en ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Tú eres mi Rey, oh Dios;",
          "Manda victorias a Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Contigo rechazaremos a nuestros adversarios;",
          "En Tu nombre pisotearemos a los que contra nosotros se levanten."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque yo no confiaré en mi arco,",
          "Ni me podrá salvar mi espada;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pues Tú nos has salvado de nuestros adversarios,",
          "Y has avergonzado a los que nos aborrecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "En Dios nos hemos gloriado todo el día.",
          "Por siempre alabaremos Tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Sin embargo, Tú nos has rechazado y nos has confundido,",
          "Y no sales con nuestros ejércitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Nos haces retroceder ante el adversario,",
          "Y los que nos aborrecen tomaron botín para sí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Nos entregas como ovejas para ser devorados,",
          "Y nos has esparcido entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Vendes a Tu pueblo a bajo precio,",
          "Y nada has ganado con su venta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Nos haces el oprobio de nuestros vecinos,",
          "Escarnio y burla de los que nos rodean."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Nos pones por proverbio entre las naciones,",
          "Causa de risa entre los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Todo el día mi ignominia está delante de mí,",
          "Y la vergüenza de mi rostro me ha abrumado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por la voz del que me reprocha e insulta,",
          "Por la presencia del enemigo y del vengativo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¶Todo esto nos ha sobrevenido, pero no nos hemos olvidado de Ti,",
          "Ni hemos faltado a Tu pacto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "No se ha vuelto atrás nuestro corazón,",
          "Ni se han desviado nuestros pasos de Tu senda;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Sin embargo, nos has quebrantado en la región de los chacales,",
          "Y nos has cubierto con la sombra de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¶Si nos hubiéramos olvidado del nombre de nuestro Dios,",
          "O extendido nuestras manos a un dios extraño,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¿No se habría dado cuenta Dios de esto?",
          "Pues Él conoce los secretos del corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Pero por causa Tuya nos matan cada día;",
          "Se nos considera como ovejas para el matadero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¡Despierta! ¿Por qué duermes, Señor?",
          "¡Levántate! No nos rechaces para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¿Por qué escondes Tu rostro",
          "Y te olvidas de nuestra aflicción y de nuestra opresión?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Porque nuestra alma se ha hundido en el polvo;",
          "Nuestro cuerpo está pegado a la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡Levántate! Sé nuestra ayuda,",
          "Y redímenos por amor de Tu misericordia."
        ],
        "rlw_lines": []
      }
    ]
  },
