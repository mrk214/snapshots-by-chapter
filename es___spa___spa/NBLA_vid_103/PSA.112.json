    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 112"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Prosperidad del que teme al Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "Cuán bienaventurado es el hombre que teme al Señor,",
          "Que mucho se deleita en Sus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Poderosa en la tierra será su descendencia;",
          "La generación de los rectos será bendita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Bienes y riquezas hay en su casa,",
          "Y su justicia permanece para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Luz resplandece en las tinieblas para el que es recto;",
          "Él es clemente, compasivo y justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Bien le va al hombre que se apiada y presta;",
          "Arreglará sus asuntos con juicio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque nunca será sacudido;",
          "Para siempre será recordado el justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶No temerá recibir malas noticias;",
          "Su corazón está firme, confiado en el Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Su corazón está seguro, no temerá,",
          "Hasta que vea vencidos a sus adversarios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Con liberalidad ha dado a los pobres;",
          "Su justicia permanece para siempre;",
          "Su poder será exaltado con honor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Lo verá el impío y se irritará;",
          "Rechinará los dientes y se consumirá;",
          "El deseo de los impíos perecerá."
        ],
        "rlw_lines": []
      }
    ]
  },
