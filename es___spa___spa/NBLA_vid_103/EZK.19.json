    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Elegía por los príncipes de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "«Y tú, eleva una elegía por los príncipes de Israel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "y di:",
          "“¿Qué era tu madre?",
          "Una leona entre leones.",
          "Echada en medio de leoncillos,",
          "Crió a sus cachorros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "-”Cuando exaltó a uno de sus cachorros,",
          "Este se hizo león,",
          "Y aprendió a desgarrar su presa;",
          "Devoró hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "-”Entonces las naciones oyeron de él;",
          "En su foso fue capturado,",
          "Y lo llevaron con garfios",
          "A la tierra de Egipto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "-”Cuando ella vio, mientras aguardaba,",
          "Que su esperanza estaba perdida,",
          "Tomó otro de sus cachorros",
          "Y lo hizo un leoncillo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "-”Y él andaba entre los leones;",
          "Hecho ya un leoncillo,",
          "Aprendió a desgarrar su presa;",
          "Devoró hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "-”Destruyó sus torres fortificadas",
          "Y asoló sus ciudades;",
          "La tierra y cuanto había en ella estaban aterrados",
          "Por el estruendo de sus rugidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "-”Entonces se pusieron contra él los pueblos",
          "De las provincias de alrededor,",
          "Y tendieron sobre él su red;",
          "En su foso fue capturado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "-”Lo pusieron en una jaula con garfios",
          "Y lo llevaron al rey de Babilonia;",
          "Lo llevaron enjaulado",
          "Para que su voz no se oyera más",
          "En los montes de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "-”Tu madre era como una vid en tu viña,",
          "Plantada junto a las aguas;",
          "Estaba llena de frutos y ramas",
          "Por la abundancia de aguas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "-”Tenía ramas fuertes",
          "Propias para cetros de gobernantes,",
          "Y su estatura se elevó",
          "Hasta en medio de las nubes,",
          "Y fue vista a causa de su altura",
          "Y por sus muchos sarmientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "-”Pero fue arrancada con furor,",
          "Derribada a tierra,",
          "Y el viento del este secó su fruto;",
          "Su rama fuerte fue quebrada",
          "Y se secó;",
          "El fuego la consumió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "-”Y ahora está plantada en el desierto,",
          "En una tierra árida y reseca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "-”De su rama ha salido fuego,",
          "Que ha consumido sus pámpanos y su fruto,",
          "Y no queda en ella rama fuerte,",
          "Para cetro de gobernante” ».",
          "Esta es una elegía, y de elegía servirá."
        ],
        "rlw_lines": []
      }
    ]
  },
