    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 52"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lo vano de la maldad que se gloría"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro. Masquil de David, cuando fue Doeg el edomita e informó a Saúl, diciéndole: «David está en casa de Ahimelec»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿Por qué te glorías del mal, oh poderoso?",
          "La misericordia de Dios es constante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tu lengua trama destrucción",
          "Como afilada navaja, oh artífice de engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Amas el mal más que el bien,",
          "La mentira más que decir lo que es justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Amas toda palabra destructora,",
          "Oh lengua de engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Pero Dios te destruirá para siempre;",
          "Te arrebatará y te arrancará de tu tienda,",
          "Y te desarraigará de la tierra de los vivientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los justos verán esto y temerán,",
          "Y se reirán de él, diciendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "«Ese es el hombre que no quiso hacer de Dios su refugio,",
          "Sino que confió en la abundancia de sus riquezas",
          "Y se hizo fuerte en sus malos deseos»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Pero yo soy como olivo verde en la casa de Dios;",
          "En la misericordia de Dios confío eternamente y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Te daré gracias para siempre por lo que has hecho,",
          "Y esperaré en Tu nombre, porque es bueno delante de Tus santos."
        ],
        "rlw_lines": []
      }
    ]
  },
