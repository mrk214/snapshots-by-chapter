    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 48"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hermosura y gloria de Sión"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Grande es el Señor, y muy digno de ser alabado",
          "En la ciudad de nuestro Dios, Su santo monte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Hermoso en su elevación, el gozo de toda la tierra",
          "Es el monte Sión, en el extremo norte,",
          "La ciudad del gran Rey."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios en sus palacios",
          "Se dio a conocer como baluarte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Pues los reyes se reunieron;",
          "Pasaron juntos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ellos la vieron y quedaron pasmados;",
          "Se aterrorizaron y huyeron alarmados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Allí se apoderó de ellos un temblor;",
          "Dolor como el de mujer que está de parto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Con el viento del este",
          "Tú destrozas las naves de Tarsis."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como lo hemos oído, así lo hemos visto",
          "En la ciudad del Señor de los ejércitos, en la ciudad de nuestro Dios;",
          "Dios la afirmará para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Hemos meditado en Tu misericordia, oh Dios,",
          "En medio de Tu templo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Oh Dios, como es Tu nombre,",
          "Así es Tu alabanza hasta los confines de la tierra;",
          "Llena de justicia está Tu diestra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Alégrese el monte Sión,",
          "Regocíjense las hijas de Judá,",
          "A causa de Tus juicios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Caminen por Sión y vayan alrededor de ella;",
          "Cuenten sus torres;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Consideren atentamente sus murallas,",
          "Recorran sus palacios,",
          "Para que lo cuenten a la generación venidera."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque Este es Dios,",
          "Nuestro Dios para siempre;",
          "Él nos guiará hasta la muerte."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
