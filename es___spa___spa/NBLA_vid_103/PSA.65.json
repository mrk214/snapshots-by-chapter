    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 65"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La abundante generosidad de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro. Salmo de David. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Silencio habrá delante de Ti, y alabanza en Sión, oh Dios.",
          "A Ti se cumplirá el voto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Oh Tú, que escuchas la oración!",
          "Hasta Ti viene todo hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Las iniquidades prevalecen contra mí,",
          "Pero nuestras transgresiones Tú las perdonas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cuán bienaventurado es aquel que Tú escoges, y acercas a Ti,",
          "Para que more en Tus atrios.",
          "Seremos saciados con el bien de Tu casa,",
          "Tu santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Con grandes prodigios nos respondes en justicia,",
          "Oh Dios de nuestra salvación,",
          "Tú eres la confianza de todos los términos de la tierra y del más lejano mar;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El que afirma los montes con Su poder,",
          "Ceñido de potencia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El que calma el rugido de los mares,",
          "El estruendo de las olas,",
          "Y el tumulto de los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por eso los que moran en los confines de la tierra temen Tus obras,",
          "Tú haces cantar de júbilo a la aurora y al ocaso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Tú visitas la tierra y la riegas en abundancia,",
          "En gran manera la enriqueces.",
          "El río de Dios rebosa de agua;",
          "Tú les preparas su grano, porque así preparas la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Riegas sus surcos abundantemente,",
          "Allanas sus camellones,",
          "La ablandas con lluvias,",
          "Bendices sus renuevos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tú has coronado el año con Tus bienes,",
          "Y Tus huellas destilan grasa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Destilan los pastos del desierto,",
          "Y los collados se adornan de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Las praderas se visten de rebaños,",
          "Y los valles se cubren de grano;",
          "Dan voces de júbilo, sí, cantan."
        ],
        "rlw_lines": []
      }
    ]
  },
