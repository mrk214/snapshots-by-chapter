    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 43"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria implorando liberación"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hazme justicia, oh Dios, y defiende mi causa contra una nación impía;",
          "Líbrame del hombre engañoso e injusto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ya que Tú eres el Dios de mi fortaleza, ¿por qué me has rechazado?",
          "¿Por qué ando sombrío por la opresión del enemigo?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶Envía Tu luz y Tu verdad; que ellas me guíen,",
          "Que me lleven a Tu santo monte",
          "Y a Tus moradas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Entonces llegaré al altar de Dios,",
          "A Dios, mi supremo gozo;",
          "Y al son de la lira te alabaré, oh Dios, Dios mío."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶¿Por qué te desesperas, alma mía,",
          "Y por qué te turbas dentro de mí?",
          "Espera en Dios, pues lo he de alabar otra vez.",
          "¡Él es la salvación de mi ser, y mi Dios!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
