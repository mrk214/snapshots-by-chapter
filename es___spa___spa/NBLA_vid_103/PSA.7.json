    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 7"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria del justo perseguido"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Sigaión de David, que cantó al Señor acerca de Cus, el benjamita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Señor, Dios mío, en Ti me refugio;",
          "Sálvame de todo el que me persigue, y líbrame,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "No sea que alguno desgarre mi vida como león,",
          "Y me despedace sin que haya quien me libre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶Oh Señor, Dios mío, si yo he hecho esto,",
          "Si hay en mis manos injusticia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Si he pagado con el mal al que estaba en paz conmigo,",
          "O he despojado al que sin causa era mi adversario,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que el enemigo me persiga y me alcance;",
          "Que pisotee en tierra mi vida",
          "Y eche en el polvo mi gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Levántate, oh Señor, en Tu ira;",
          "Álzate contra la furia de mis adversarios,",
          "Y despiértate en favor mío; Tú has establecido juicio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que te rodee la asamblea de los pueblos,",
          "Y Tú en lo alto regresa sobre ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El Señor juzga a los pueblos.",
          "Júzgame oh Señor, conforme a mi justicia y a la integridad que hay en mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Que se acabe la maldad de los impíos, pero establece Tú al justo,",
          "Porque el Dios justo prueba los corazones y las mentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mi escudo está en Dios,",
          "Que salva a los rectos de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios es juez justo,",
          "Y un Dios que se indigna cada día contra el impío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶Y si el impío no se arrepiente, Él afilará Su espada;",
          "Tensado y preparado está Su arco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ha preparado también Sus armas de muerte;",
          "Hace de Sus flechas saetas ardientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Miren, el impío con la maldad sufre dolores,",
          "Y concibe la iniquidad y da a luz el engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ha cavado una fosa y la ha ahondado,",
          "Y ha caído en el hoyo que hizo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Su iniquidad volverá sobre su cabeza,",
          "Y su violencia descenderá sobre su coronilla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¶Daré gracias al Señor conforme a Su justicia,",
          "Y cantaré alabanzas al nombre del Señor, el Altísimo."
        ],
        "rlw_lines": []
      }
    ]
  },
