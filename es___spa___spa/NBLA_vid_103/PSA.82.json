        "lines": [
          "Salmo 82"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, juez supremo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios ocupa Su lugar en Su congregación;",
          "Él juzga en medio de los jueces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Hasta cuándo juzgarán ustedes injustamente",
          "Y favorecerán a los impíos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Defiendan al débil y al huérfano;",
          "Hagan justicia al afligido y al menesteroso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Rescaten al débil y al necesitado;",
          "Líbrenlos de la mano de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Ellos no saben ni entienden;",
          "Caminan en tinieblas;",
          "Son sacudidos todos los cimientos de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Yo dije: «Ustedes son dioses,",
          "Y todos son hijos del Altísimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "-»Sin embargo, como hombres morirán,",
          "Y caerán como cualquiera de los príncipes»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Levántate, oh Dios, juzga la tierra!",
          "Porque Tú posees todas las naciones."
        ],
        "rlw_lines": []
      }
    ]
  },
