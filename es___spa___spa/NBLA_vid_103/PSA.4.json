    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 4"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración vespertina de confianza en Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; para instrumentos de cuerda. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cuando clamo, respóndeme, oh Dios de mi justicia.",
          "En la angustia me has aliviado;",
          "Ten piedad de mí, escucha mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¶Hijos de hombres, ¿hasta cuándo cambiarán mi honra en deshonra?",
          "¿Hasta cuándo amarán la vanidad y buscarán la mentira?"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sepan, pues, que el Señor ha apartado al piadoso para sí;",
          "El Señor oye cuando a Él clamo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Tiemblen, y no pequen;",
          "Mediten en su corazón sobre su lecho, y callen."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ofrezcan sacrificios de justicia,",
          "Y confíen en el Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Muchos dicen: «¿Quién nos mostrará el bien?».",
          "¡Alza, oh Señor, sobre nosotros la luz de Tu rostro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Alegría pusiste en mi corazón,",
          "Mayor que la de ellos cuando abundan su grano y su vino nuevo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "En paz me acostaré y así también dormiré,",
          "Porque solo Tú, Señor, me haces vivir seguro."
        ],
        "rlw_lines": []
      }
    ]
  },
