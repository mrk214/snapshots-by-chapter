    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 9"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Salmo de acción de gracias por la justicia de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; sobre Mut Laben. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Daré gracias al Señor con todo mi corazón;",
          "Todas Tus maravillas contaré."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En Ti me alegraré y me regocijaré;",
          "Cantaré alabanzas a Tu nombre, oh Altísimo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶Cuando mis enemigos retroceden,",
          "Tropiezan y perecen delante de Ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque Tú has mantenido mi derecho y mi causa;",
          "Te sientas en el trono juzgando con justicia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Has reprendido a las naciones, has destruido al impío,",
          "Has borrado su nombre para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El enemigo ha llegado a su fin en desolación eterna,",
          "Y Tú has destruido sus ciudades;",
          "Su recuerdo ha perecido con ellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Pero el Señor permanece para siempre;",
          "Ha establecido Su trono para juicio,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Y juzgará al mundo con justicia;",
          "Con equidad ejecutará juicio sobre los pueblos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El Señor será también baluarte para el oprimido,",
          "Baluarte en tiempos de angustia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "En Ti pondrán su confianza los que conocen Tu nombre,",
          "Porque Tú, oh Señor, no abandonas a los que te buscan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Canten alabanzas al Señor, que mora en Sión;",
          "Proclamen entre los pueblos Sus proezas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque el que pide cuentas de la sangre derramada, se acuerda de ellos;",
          "No olvida el clamor de los afligidos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Oh Señor, ten piedad de mí;",
          "Mira mi aflicción por causa de los que me aborrecen,",
          "Tú que me levantas de las puertas de la muerte;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Para que yo cuente todas Tus alabanzas,",
          "Para que en las puertas de la hija de Sión",
          "Me regocije en Tu salvación."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Las naciones se han hundido en el foso que hicieron;",
          "En la red que escondieron, su propio pie quedó prendido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El Señor se ha dado a conocer;",
          "Ha ejecutado juicio.",
          "El impío es atrapado en la obra de sus propias manos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Higaion, Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¶Los impíos volverán al Seol,",
          "O sea, todas las naciones que se olvidan de Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pues el necesitado no será olvidado para siempre,",
          "Ni la esperanza de los afligidos perecerá eternamente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Levántate, oh Señor; no prevalezca el hombre;",
          "Sean juzgadas las naciones delante de Ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Pon temor en ellas, oh Señor;",
          "Aprendan las naciones que no son más que hombres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      }
    ]
  },
