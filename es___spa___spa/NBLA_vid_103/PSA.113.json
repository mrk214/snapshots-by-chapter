    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 113"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El Señor exalta al humilde"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "Alaben, siervos del Señor,",
          "Alaben el nombre del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bendito sea el nombre del Señor",
          "Desde ahora y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Desde el nacimiento del sol hasta su ocaso,",
          "Alabado sea el nombre del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Excelso sobre todas las naciones es el Señor;",
          "Su gloria está sobre los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶¿Quién es como el Señor nuestro Dios,",
          "Que está sentado en las alturas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Que se humilla para mirar",
          "Lo que hay en el cielo y en la tierra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él levanta al pobre del polvo,",
          "Y al necesitado saca del muladar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Para sentarlos con príncipes,",
          "Con los príncipes de Su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Hace habitar en casa a la mujer estéril,",
          "Gozosa de ser madre de hijos.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
