    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 66"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Himno a Dios por su poderosa liberación"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro. Cántico. Salmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aclamen con júbilo a Dios, habitantes de toda la tierra;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Canten la gloria de Su nombre;",
          "Hagan gloriosa Su alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Digan a Dios: «¡Cuán portentosas son Tus obras!",
          "Por la grandeza de Tu poder, Tus enemigos fingirán que te obedecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "-»Toda la tierra te adorará,",
          "Y cantará alabanzas a Ti,",
          "Cantará alabanzas a Tu nombre»."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Vengan y vean las obras de Dios,",
          "Admirable en Sus hechos a favor de los hijos de los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Convirtió el mar en tierra seca;",
          "Cruzaron el río a pie;",
          "Regocijémonos allí en Él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él domina con Su poder para siempre;",
          "Sus ojos velan sobre las naciones;",
          "No se enaltezcan los rebeldes."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Bendigan, oh pueblos, a nuestro Dios,",
          "Y hagan oír la voz de Su alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Él es quien nos guarda con vida,",
          "Y no permite que nuestros pies resbalen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque Tú nos has probado, oh Dios;",
          "Nos has refinado como se refina la plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Nos metiste en la red;",
          "Carga pesada pusiste sobre nuestros lomos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Hiciste cabalgar hombres sobre nuestras cabezas;",
          "Pasamos por el fuego y por el agua,",
          "Pero Tú nos sacaste a un lugar de abundancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Entraré en Tu casa con holocaustos;",
          "A Ti cumpliré mis votos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los que pronunciaron mis labios",
          "Y habló mi boca cuando yo estaba en angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Te ofreceré holocaustos de animales engordados,",
          "Con el humo de la ofrenda de carneros;",
          "Haré una ofrenda de toros y machos cabríos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶Vengan y oigan, todos los que temen a Dios,",
          "Y contaré lo que Él ha hecho por mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Con mi boca clamé a Él,",
          "Y ensalzado fue con mi lengua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si observo iniquidad en mi corazón,",
          "El Señor no me escuchará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pero ciertamente Dios me ha oído;",
          "Él atendió a la voz de mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Bendito sea Dios,",
          "Que no ha desechado mi oración,",
          "Ni apartado de mí Su misericordia."
        ],
        "rlw_lines": []
      }
    ]
  },
