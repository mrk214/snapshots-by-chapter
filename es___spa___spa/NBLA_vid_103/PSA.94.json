    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 94"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración pidiendo justicia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Señor, Dios de las venganzas,",
          "Oh Dios de las venganzas, ¡resplandece!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Levántate, Juez de la tierra;",
          "Da su merecido a los soberbios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Hasta cuándo los impíos, Señor,",
          "Hasta cuándo los impíos se regocijarán?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Charlan, hablan con arrogancia;",
          "Todos los que hacen iniquidad se vanaglorían."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aplastan a Tu pueblo, Señor,",
          "Y afligen a Tu heredad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Matan a la viuda y al extranjero,",
          "Y asesinan a los huérfanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Y dicen: «El Señor no ve nada",
          "Ni hace caso el Dios de Jacob»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Hagan caso, torpes del pueblo;",
          "Necios, ¿cuándo entenderán?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El que hizo el oído, ¿acaso no oye?",
          "El que dio forma al ojo, ¿acaso no ve?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿No reprenderá el que castiga a las naciones,",
          "El que enseña conocimiento al hombre?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El Señor conoce los pensamientos del hombre,",
          "Sabe que son solo un soplo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶Bienaventurado el hombre a quien reprendes, Señor,",
          "Y lo instruyes en Tu ley;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Para darle descanso en los días de aflicción,",
          "Hasta que se cave una fosa para el impío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque el Señor no abandonará a Su pueblo,",
          "Ni desamparará a Su heredad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Porque el juicio volverá a ser justo,",
          "Y todos los rectos de corazón lo seguirán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¿Quién se levantará por mí contra los malhechores?",
          "¿Quién me defenderá de los que hacen iniquidad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¶Si el Señor no hubiera sido mi ayuda,",
          "Pronto habría habitado mi alma en el lugar del silencio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si digo: «Mi pie ha resbalado»,",
          "Tu misericordia, oh Señor, me sostendrá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Cuando mis inquietudes se multiplican dentro de mí,",
          "Tus consuelos deleitan mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Puede ser aliado Tuyo un trono de destrucción,",
          "Que planea el mal por decreto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Se unen contra la vida del justo,",
          "Y condenan a muerte al inocente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Pero el Señor ha sido mi baluarte,",
          "Y mi Dios la roca de mi refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Él ha hecho volver sobre ellos su propia iniquidad,",
          "Y los destruirá en su maldad;",
          "El Señor, nuestro Dios, los destruirá."
        ],
        "rlw_lines": []
      }
    ]
  },
