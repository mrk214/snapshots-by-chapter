        "lines": [
          "Salmo 120"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La lengua engañosa y los enemigos de la paz"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En mi angustia clamé al Señor,",
          "Y Él me respondió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Libra mi alma, Señor, de labios mentirosos,",
          "Y de lengua engañosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Qué te dará, y qué te añadirá,",
          "Oh lengua engañosa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Agudas flechas de guerrero,",
          "Con brasas de enebro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶¡Ay de mí, porque soy peregrino en Mesec,",
          "Y habito entre las tiendas de Cedar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Demasiado tiempo ha morado mi alma",
          "Con los que odian la paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Yo amo la paz, pero cuando hablo,",
          "Ellos están por la guerra."
        ],
        "rlw_lines": []
      }
    ]
  },
