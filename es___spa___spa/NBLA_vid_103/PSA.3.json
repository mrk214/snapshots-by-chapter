    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 3"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración matutina de confianza en Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David, cuando huía de su hijo Absalón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Oh Señor, cómo se han multiplicado mis adversarios!",
          "Muchos se levantan contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Muchos dicen de mí:",
          "«Para él no hay salvación en Dios»."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶Pero Tú, oh Señor, eres escudo en derredor mío,",
          "Mi gloria, y el que levanta mi cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Con mi voz clamé al Señor,",
          "Y Él me respondió desde Su santo monte."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Yo me acosté y me dormí;",
          "Desperté, pues el Señor me sostiene."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No temeré a los diez millares de enemigos",
          "Que se han puesto en derredor contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶¡Levántate, Señor! ¡Sálvame, Dios mío!",
          "Porque Tú hieres a todos mis enemigos en la mejilla;",
          "Rompes los dientes de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "La salvación es del Señor.",
          "¡Sea sobre Tu pueblo Tu bendición!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      }
    ]
  },
