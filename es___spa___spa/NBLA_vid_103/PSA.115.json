    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 115"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contraste entre los ídolos y el Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No a nosotros, Señor, no a nosotros,",
          "Sino a Tu nombre da gloria,",
          "Por Tu misericordia, por Tu fidelidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Por qué han de decir las naciones:",
          "«¿Dónde está ahora su Dios?»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Nuestro Dios está en los cielos;",
          "Él hace lo que le place."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Los ídolos de ellos son plata y oro,",
          "Obra de manos de hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tienen boca, y no hablan;",
          "Tienen ojos, y no ven;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tienen oídos, y no oyen;",
          "Tienen nariz, y no huelen;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tienen manos, y no tocan;",
          "Tienen pies, y no caminan;",
          "No emiten sonido alguno con su garganta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Se volverán como ellos los que los hacen,",
          "Y todos los que en ellos confían."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Oh Israel, confía en el Señor;",
          "Él es tu ayuda y tu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Oh casa de Aarón, confíen ustedes en el Señor;",
          "Él es su ayuda y su escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Los que temen al Señor, confíen en el Señor;",
          "Él es su ayuda y su escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El Señor se ha acordado de nosotros; Él nos bendecirá;",
          "Bendecirá a la casa de Israel;",
          "Bendecirá a la casa de Aarón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Él bendecirá a los que temen al Señor,",
          "Tanto a pequeños como a grandes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El Señor los prospere,",
          "A ustedes y a sus hijos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Benditos sean del Señor,",
          "Que hizo los cielos y la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶Los cielos son los cielos del Señor,",
          "Pero la tierra la ha dado a los hijos de los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los muertos no alaban al Señor,",
          "Ni ninguno de los que descienden al silencio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero nosotros bendeciremos al Señor",
          "Desde ahora y para siempre.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
