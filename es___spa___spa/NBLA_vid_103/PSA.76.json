    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 76"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El poder victorioso del Dios de Jacob"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; con instrumentos de cuerdas. Salmo de Asaf. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios es conocido en Judá;",
          "Grande es Su nombre en Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En Salem está Su tabernáculo,",
          "Y en Sión Su morada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Allí quebró las flechas encendidas del arco,",
          "El escudo, la espada y las armas de guerra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Resplandeciente eres,",
          "Más majestuoso que los montes de caza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Fueron despojados los fuertes de corazón;",
          "Durmieron su sueño,",
          "Y ninguno de los guerreros pudo usar sus manos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A Tu reprensión, oh Dios de Jacob,",
          "Jinete y caballo cayeron en profundo sueño."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tú, solo Tú, has de ser temido;",
          "¿Y quién podrá estar en pie en Tu presencia en el momento de Tu ira?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Hiciste oír juicio desde los cielos;",
          "Temió la tierra y enmudeció"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Cuando Dios se levantó para juzgar,",
          "Para salvar a todos los humildes de la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pues el furor del hombre te alabará;",
          "Con un residuo de furor te ceñirás."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Hagan votos ustedes al Señor su Dios, y cúmplanlos;",
          "Todos los que están alrededor de Él traigan presentes al que debe ser temido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Él cortará el espíritu de los príncipes;",
          "Temido es por los reyes de la tierra."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
