    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David. Masquil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dichoso aquel",
          "a quien se le perdonan sus transgresiones,",
          "cuyos pecados son cubiertos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Dichoso aquel",
          "cuyo pecado el Señor no le toma en cuenta,",
          "y en cuyo espíritu no hay engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mientras guardé silencio,",
          "mis huesos se fueron consumiendo",
          "por mi gemir de todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi fuerza se fue debilitando",
          "como al calor del verano,",
          "porque día y noche",
          "tu mano pesaba sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero te confesé mi pecado",
          "y no te oculté mi maldad.",
          "Me dije: «Voy a confesar mis transgresiones al Señor».",
          "Y tú perdonaste la culpa de mi pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Que te invoquen todos los fieles",
          "en momentos que puedas ser hallado;",
          "caudalosas aguas podrán desbordarse,",
          "pero no los alcanzarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tú eres mi refugio;",
          "tú me protegerás del peligro",
          "y me rodearás con cánticos de liberación."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El Señor dice:",
          "«Yo te instruiré,",
          "yo te mostraré el camino que debes seguir;",
          "yo te daré consejos y velaré por ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No seas como el mulo o el caballo,",
          "que no tienen discernimiento,",
          "y cuyo brío hay que domar con brida y freno",
          "para acercarlos a ti»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Muchos son los sufrimientos de los malvados,",
          "pero el gran amor del Señor",
          "envuelve a los que en él confían."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Alégrense, ustedes los justos;",
          "regocíjense en el Señor!",
          "¡Canten todos ustedes,",
          "los de corazón sincero!"
        ],
        "rlw_lines": []
      }
    ]
  },
