    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cuarto discurso de Eliú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eliú continuó diciendo:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Ten un poco más de paciencia conmigo y te mostraré",
          "que aún quiero decir más en favor de Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mi conocimiento proviene de muy lejos;",
          "voy a demostrar que mi Hacedor está en lo justo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Te aseguro que no hay falsedad en mis palabras;",
          "¡tienes ante ti a la sabiduría en persona!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Dios es poderoso, pero no rechaza a nadie;",
          "Dios es poderoso y firme en su propósito."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Al malvado no lo mantiene con vida;",
          "al afligido le hace justicia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuida siempre de los justos;",
          "los hace reinar en compañía de reyes",
          "y los exalta para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pero si son encadenados,",
          "si la aflicción los domina,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dios denuncia sus acciones",
          "y la arrogancia de su pecado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Les hace prestar oído a la corrección",
          "y pide que se aparten del mal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Si ellos obedecen y le sirven,",
          "pasan el resto de su vida en prosperidad;",
          "pasan felices los años que les quedan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Pero si no hacen caso,",
          "sin darse cuenta, cruzarán el umbral de la muerte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Los de corazón impío abrigan resentimiento;",
          "no piden ayuda aun cuando Dios los ata."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Mueren en la flor de la vida,",
          "entre los que se prostituyen en los santuarios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "A los que sufren, Dios los libra mediante el sufrimiento;",
          "se vale de la aflicción para instruirlos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "»Dios te atrae para sacarte de las fauces de la angustia,",
          "te lleva a un lugar amplio y espacioso,",
          "y llena tu mesa con la mejor comida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pero tú te has ganado el juicio que merecen los impíos;",
          "el juicio y la justicia te tienen atrapado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cuídate de no dejarte seducir por las riquezas;",
          "no te dejes desviar por el soborno."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Tus grandes riquezas no podrán sostenerte,",
          "ni tampoco todos tus esfuerzos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No ansíes que caiga la noche",
          "cuando la gente es arrancada de su sitio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Cuídate de no inclinarte a la maldad,",
          "pues, por haberla preferido, ahora sufres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "»Dios es exaltado por su poder.",
          "¿Qué maestro hay que se le compare?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¿Quién puede pedirle cuentas de sus actos?",
          "¿Quién puede decirle que ha actuado mal?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "No te olvides de exaltar sus obras,",
          "que con cánticos han sido alabadas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Todo el género humano puede contemplarlas,",
          "aunque solo desde lejos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡Tan grande es Dios que no lo conocemos!",
          "¡Incontable es el número de sus años!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "»Él atrae las gotas de agua",
          "que fluyen como lluvia hacia los manantiales;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "las nubes derraman su lluvia,",
          "que cae a raudales sobre el género humano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¿Quién entiende la extensión de las nubes",
          "y el estruendo que sale de su morada?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Vean a Dios esparcir su luz en torno suyo",
          "y bañar con ella las profundidades del océano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Gobierna a las naciones de esa manera",
          "y les da comida en abundancia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Toma entre sus manos el relámpago",
          "y le ordena dar en el blanco."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Su trueno anuncia la inminente tormenta",
          "y hasta el ganado presagia su llegada."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
