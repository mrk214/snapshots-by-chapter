    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David, para las ofrendas memoriales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, no me reprendas en tu enojo",
          "ni me castigues en tu ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque tus flechas me han atravesado",
          "y sobre mí ha caído tu mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Por causa de tu indignación no hay nada sano en mi cuerpo;",
          "por causa de mi pecado no me quedan huesos sanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mis maldades me abruman,",
          "son una carga demasiado pesada para mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Por causa de mi insensatez",
          "mis llagas hieden y supuran."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Estoy agobiado, del todo abatido;",
          "todo el día ando afligido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mi espalda está llena de dolores punzantes;",
          "no hay nada sano en mi cuerpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Me siento débil, completamente deshecho;",
          "mi corazón gime angustiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ante ti, Señor, están todos mis deseos;",
          "no te son un secreto mis suspiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Late mi corazón con violencia,",
          "las fuerzas me abandonan,",
          "hasta la luz de mis ojos se apaga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mis amigos y vecinos se apartan de mis llagas;",
          "mis parientes se mantienen a distancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Tienden sus trampas los que quieren matarme;",
          "maquinan mi ruina los que buscan mi mal",
          "y todo el día urden engaños."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pero yo, como un sordo, no escucho;",
          "como un mudo, no respondo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Soy como los que no oyen",
          "ni pueden hablar para defenderse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Yo, Señor, espero en ti;",
          "tú, Señor y Dios mío, serás quien responda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tan solo pido que no se burlen de mí,",
          "que cuando tropiece no se crean superiores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Estoy por desfallecer;",
          "el dolor no me deja un solo instante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Voy a confesar mi iniquidad,",
          "pues mi pecado me angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Mis enemigos son muchos y poderosos;",
          "abundan los que me odian sin motivo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por hacer el bien, me pagan con el mal;",
          "por procurar lo bueno, se ponen en mi contra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Señor, no me abandones;",
          "Dios mío, no te alejes de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Señor de mi salvación,",
          "¡ven pronto en mi ayuda!"
        ],
        "rlw_lines": []
      }
    ]
  },
