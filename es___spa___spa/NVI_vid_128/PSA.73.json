    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "Libro III"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "Salmos 73–89"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En verdad, ¡cuán bueno es Dios con Israel,",
          "con los de corazón puro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Yo estuve a punto de caer;",
          "poco me faltó para que resbalara."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sentí envidia de los arrogantes,",
          "al ver la prosperidad de esos malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ellos no tienen ningún problema;",
          "su cuerpo está fuerte y saludable."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Libres están de los afanes de la gente;",
          "no les afectan los infortunios humanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por eso lucen su orgullo como un collar",
          "y hacen gala de su violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Están que revientan de malicia",
          "y hasta se les ven sus malas intenciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ellos se burlan, hablan con maldad,",
          "y arrogantes oprimen y amenazan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Con la boca increpan al cielo",
          "y su lengua se pasea por la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por eso la gente acude a ellos",
          "y bebe sus palabras como agua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Hasta dicen: «¿Cómo puede Dios saberlo?",
          "¿Acaso el Altísimo tiene entendimiento?»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Así son los malvados;",
          "sin afanarse, aumentan sus riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "En verdad, ¿de qué me sirve mantener mi corazón limpio",
          "y mis manos lavadas en la inocencia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "si todo el día me golpean",
          "y de mañana me castigan?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Si hubiera dicho: «Voy a hablar como ellos»,",
          "habría traicionado al linaje de tus hijos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Cuando traté de comprender todo esto,",
          "me resultó una carga insoportable,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "hasta que entré en el santuario de Dios;",
          "allí comprendí el fin que les espera:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "En verdad, los has puesto en terreno resbaladizo",
          "y los empujas a su propia destrucción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡En un instante serán destruidos,",
          "totalmente consumidos por el terror!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Como quien despierta de un sueño,",
          "así, Señor, cuando tú te levantes,",
          "los despreciarás como una ilusión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Se me afligía el corazón",
          "y se me amargaba el ánimo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "por mi necedad e ignorancia.",
          "¡Me porté contigo como una bestia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Pero yo siempre estoy contigo,",
          "pues tú me sostienes de la mano derecha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Me guías con tu consejo",
          "y más tarde me acogerás en gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "¿A quién tengo en el cielo sino a ti?",
          "Si estoy contigo, ya nada quiero en la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Podrán desfallecer mi cuerpo y mi corazón,",
          "pero Dios es la roca de mi corazón;",
          "él es mi herencia eterna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Perecerán los que se alejen de ti;",
          "tú destruyes a los que te son infieles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Para mí el bien es estar cerca de Dios.",
          "He hecho del Señor Soberano mi refugio",
          "para contar todas sus obras."
        ],
        "rlw_lines": []
      }
    ]
  },
