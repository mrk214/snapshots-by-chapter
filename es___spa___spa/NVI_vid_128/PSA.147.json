    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "¡Cuán bueno es cantar salmos a nuestro Dios,",
          "cuán agradable y justo es alabarlo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El Señor reconstruye a Jerusalén",
          "y reúne a los exiliados de Israel;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "sana a los de corazón quebrantado",
          "y venda sus heridas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Él determina el número de las estrellas",
          "y a cada una de ellas llama por su nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Excelso es nuestro Señor y grande su poder;",
          "su entendimiento es infinito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El Señor sostiene a los humildes,",
          "pero a los malvados lanza contra el suelo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Canten al Señor con gratitud;",
          "canten salmos a nuestro Dios al son del arpa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Él cubre de nubes el cielo,",
          "envía la lluvia sobre la tierra",
          "y hace crecer la hierba en los montes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Él alimenta a los ganados",
          "y a las crías de los cuervos cuando graznan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Él no se deleita en los bríos del caballo",
          "ni se complace en la fuerza del hombre;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "el Señor se complace en los que le temen,",
          "en los que confían en su gran amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡Alaba al Señor, Jerusalén!",
          "¡Alaba a tu Dios, oh Sión!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Él refuerza los cerrojos de tus puertas",
          "y bendice a los que en ti habitan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Él trae la paz a tus fronteras",
          "y te sacia con lo mejor del trigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Envía sus órdenes a la tierra;",
          "su palabra corre a toda prisa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Extiende la nieve como lana,",
          "esparce la escarcha cual ceniza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Deja caer el granizo como grava;",
          "¿quién puede resistir su frío?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero envía su palabra y lo derrite;",
          "hace que el viento sople y las aguas fluyan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A Jacob le ha revelado su palabra;",
          "sus estatutos y leyes a Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Esto no lo ha hecho con ninguna otra nación;",
          "jamás han conocido ellas sus leyes.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
