    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Para Jedutún. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Solo en Dios halla descanso mi alma;",
          "de él viene mi salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Solo él es mi roca y mi salvación;",
          "él es mi refugio,",
          "¡jamás caeré!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Hasta cuándo atacarán todos ustedes",
          "a un hombre para derribarlo,",
          "como si fuera un muro inclinado",
          "o una cerca a punto de derrumbarse?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Solo quieren derribarlo",
          "de su lugar de honor.",
          "Se complacen en la mentira:",
          "bendicen con la boca,",
          "pero maldicen con el corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Solo en Dios halla descanso mi alma;",
          "de él viene mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Solo él es mi roca y mi salvación;",
          "él es mi refugio,",
          "¡no caeré!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios es mi salvación y mi gloria;",
          "es la roca que me fortalece;",
          "mi refugio está en Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oh, pueblo, confía en él siempre,",
          "derrama ante él tu corazón,",
          "pues Dios es nuestro refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Una quimera es la gente de humilde cuna,",
          "y una mentira la gente de alta alcurnia;",
          "si se les pusiera juntos en la balanza,",
          "pesarían menos que un soplo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No confíen en la extorsión",
          "ni se hagan ilusiones con sus rapiñas;",
          "y aunque se multipliquen sus riquezas,",
          "no pongan el corazón en ellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Una cosa ha dicho Dios",
          "y dos veces lo he escuchado:",
          "Que tú, oh Dios, eres poderoso;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "que tú, Señor, eres todo amor;",
          "que tú pagarás a cada uno",
          "según lo que merezcan sus obras."
        ],
        "rlw_lines": []
      }
    ]
  },
