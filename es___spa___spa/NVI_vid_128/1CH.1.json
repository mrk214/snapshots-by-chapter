    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Adán"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Adán, Set, Enós,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cainán, Malalel, Jared,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enoc, Matusalén, Lamec,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Noé."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Noé"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Hijos de Noé: Sem, Cam y Jafet."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los hijos de Jafet:",
          "Gómer, Magog, Maday, Javán, Tubal, Mésec y Tirás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Hijos de Gómer:",
          "Asquenaz, Rifat y Togarma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Hijos de Javán:",
          "Elisá, Tarsis, Quitín y Rodanín."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Hijos de Cam:",
          "Cus, Misrayin, Fut y Canaán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Hijos de Cus:",
          "Seba, Javilá, Sabtá, Ragama y Sabteca.",
          "Hijos de Ragama:",
          "Sabá y Dedán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cus fue el padre de",
          "Nimrod, conocido como el primer gran guerrero en la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Misrayin fue el antepasado de",
          "los ludeos, los anameos, los leabitas, los naftuitas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "los patruseos, los caslujitas —de quienes descienden los filisteos— y los caftoritas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Canaán fue el padre de",
          "Sidón, su primogénito, y de Het,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "y el antepasado de los jebuseos, los amorreos, los gergeseos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "los heveos, los araceos, los sineos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "los arvadeos, los zemareos y los jamatitas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Hijos de Sem:",
          "Elam, Asur, Arfaxad, Lud y Aram.",
          "Hijos de Aram:",
          "Uz, Hul, Guéter y Mésec."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Arfaxad fue el padre de Selaj.",
          "Selaj fue el padre de Éber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Éber tuvo dos hijos:",
          "El primero se llamó Péleg porque en su tiempo se dividió la tierra; su hermano se llamó Joctán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Joctán fue el padre de",
          "Almodad, Sélef, Jazar Mávet, Yeraj,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Hadorán, Uzal, Diclá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Obal, Abimael, Sabá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ofir, Javilá y Jobab. Todos estos fueron hijos de Joctán."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Sem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Sem, Arfaxad, Selaj,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Éber, Péleg, Reú,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Serug, Najor, Téraj"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "y Abram, que es también Abraham."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Abraham"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Hijos de Abraham: Isaac e Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Sus descendientes:",
          "Nebayot, primogénito de Ismael, Cedar, Adbel, Mibsán,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Mismá, Dumá, Masá, Hadad, Temá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Jetur, Nafis y Cedema.",
          "Estos fueron los hijos de Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Los hijos de Cetura, la concubina de Abraham:",
          "Zimrán, Jocsán, Medán, Madián, Isbac y Súaj.",
          "Hijos de Jocsán:",
          "Sabá y Dedán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Hijos de Madián:",
          "Efá, Éfer, Janoc, Abidá y Eldá.",
          "Todos estos fueron hijos de Cetura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Abraham también fue el padre de Isaac.",
          "Los hijos de Isaac:",
          "Esaú e Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Esaú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Hijos de Esaú:",
          "Elifaz, Reuel, Jeús, Jalán y Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Hijos de Elifaz:",
          "Temán, Omar, Zefo, Gatán y Quenaz,",
          "Timná y Amalec."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Hijos de Reuel:",
          "Najat, Zera, Sama y Mizá."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Seír"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Hijos de Seír:",
          "Lotán, Sobal, Zibeón, Aná, Disón, Ezer y Disán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Hijos de Lotán:",
          "Horí y Homán. Lotán tenía una hermana llamada Timná."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Hijos de Sobal:",
          "Alván, Manajat, Ebal, Sefó y Onam.",
          "Hijos de Zibeón:",
          "Ayá y Aná."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "El hijo de Aná:",
          "Disón.",
          "Hijos de Disón:",
          "Amirán, Esbán, Itrán y Querán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Hijos de Ezer:",
          "Bilán, Zaván y Yacán.",
          "Hijos de Disán:",
          "Uz y Arán."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Reyes de Edom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Los reyes que a continuación se mencionan reinaron en la tierra de Edom antes de que los israelitas tuvieran rey:",
          "Bela, hijo de Beor; su ciudad se llamaba Dinaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Cuando murió Bela, reinó en su lugar Jobab, hijo de Zera, que provenía de Bosra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Cuando murió Jobab, reinó en su lugar Jusán, que provenía de la región de Temán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Cuando murió Jusán, reinó en su lugar Hadad, hijo de Bedad. Este derrotó a Madián en el campo de Moab. El nombre de su ciudad era Avit."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Cuando murió Hadad, reinó en su lugar Samla, que provenía de Masreca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Cuando murió Samla, reinó en su lugar Saúl, que provenía de Rejobot, que está junto al río Éufrates."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Cuando murió Saúl, reinó en su lugar Baal Janán, hijo de Acbor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Cuando murió Baal Janán, reinó en su lugar Hadad. Su ciudad se llamaba Pau y su esposa fue Mehetabel, hija de Matred y nieta de Mezab."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Después de que murió Hadad, gobernaron en Edom los siguientes jefes:",
          "Timná, Alvá, Jetet,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Aholibama, Elá, Pinón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Quenaz, Temán, Mibzar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Magdiel e Iram.",
          "Estos fueron los jefes de Edom."
        ],
        "rlw_lines": []
      }
    ]
  },
