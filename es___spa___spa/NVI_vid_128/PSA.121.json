    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico de los peregrinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A las montañas levanto mis ojos;",
          "¿de dónde ha de venir mi ayuda?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi ayuda proviene del Señor,",
          "que hizo el cielo y la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No permitirá que tu pie resbale;",
          "jamás duerme el que te cuida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Jamás duerme ni se adormece",
          "el que cuida de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El Señor es quien te cuida;",
          "el Señor es tu sombra a tu mano derecha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "De día el sol no te hará daño",
          "ni la luna de noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El Señor te cuidará;",
          "de todo mal guardará tu vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El Señor cuidará tu salida y tu entrada,",
          "desde ahora y para siempre."
        ],
        "rlw_lines": []
      }
    ]
