    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ventajas de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hijo mío, si haces tuyas mis palabras",
          "y atesoras mis mandamientos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "si tu oído inclinas hacia la sabiduría",
          "y de corazón te entregas a la inteligencia;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "si la llamas y pides entendimiento;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "si la buscas como a la plata,",
          "como a un tesoro escondido,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "entonces comprenderás el temor del Señor",
          "y hallarás el conocimiento de Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque el Señor da la sabiduría;",
          "conocimiento e inteligencia brotan de sus labios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él reserva el éxito para los íntegros",
          "y es escudo a los de conducta intachable."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Él cuida el sendero de los justos",
          "y protege el camino de sus fieles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Entonces comprenderás la justicia y el derecho,",
          "la equidad y todo buen camino;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "la sabiduría vendrá a tu corazón",
          "y el conocimiento te endulzará la vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "La discreción te cuidará;",
          "la inteligencia te protegerá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "La sabiduría te librará del camino de los malvados,",
          "de los que dicen palabras perversas,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "de los que se apartan del camino recto",
          "para andar por sendas tenebrosas,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "de los que se complacen en hacer lo malo",
          "y festejan la perversidad,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "de los que andan por caminos torcidos",
          "y por sendas extraviadas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "te librará de la mujer ajena,",
          "de la extraña de palabras seductoras"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "que, olvidándose de su pacto con Dios,",
          "abandona al compañero de su juventud."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ciertamente su casa conduce a la muerte;",
          "sus sendas van hacia los muertos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El que se enreda con ella no vuelve jamás",
          "ni alcanza los senderos de la vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Así andarás por el camino de los buenos",
          "y seguirás la senda de los justos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Pues los íntegros habitarán en la tierra",
          "y los rectos permanecerán en ella."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Pero los malvados serán desarraigados",
          "y los infieles expulsados de la tierra."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
