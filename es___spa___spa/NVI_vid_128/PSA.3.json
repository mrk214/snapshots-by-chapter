    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David, cuando huía de su hijo Absalón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Muchos son, Señor, mis enemigos;",
          "muchos son los que se me oponen,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "y muchos los que de mí aseguran:",
          "«Dios no lo salvará»."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pero tú, Señor, eres el escudo que me protege;",
          "tú eres mi gloria;",
          "tú mantienes en alto mi cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Clamo al Señor a voz en cuello",
          "y desde su monte santo él me responde."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Yo me acuesto, me duermo y vuelvo a despertar,",
          "porque el Señor me sostiene."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No me asustan los miles de escuadrones",
          "que me acosan por doquier."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Levántate, Señor!",
          "¡Ponme a salvo, Dios mío!",
          "¡Rómpeles la quijada a mis enemigos!",
          "¡Rómpeles los dientes a los malvados!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tuya es, Señor, la salvación;",
          "¡envía tu bendición sobre tu pueblo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      }
    ]
  },
