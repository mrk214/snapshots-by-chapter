    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿A dónde se ha ido tu amado,",
          "oh bella entre las bellas?",
          "¿Hacia dónde se ha encaminado?",
          "¡Iremos contigo a buscarlo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi amado ha bajado a su jardín,",
          "a los lechos de bálsamo,",
          "para retozar en los jardines",
          "y recoger azucenas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Yo soy de mi amado y mi amado es mío;",
          "él apacienta su rebaño entre azucenas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Quinto Canto"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tú, amada mía, eres bella como Tirsá,",
          "hermosa como Jerusalén",
          "imponente como ejército con sus banderas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aparta de mí la mirada,",
          "que tus ojos me tienen fascinado.",
          "Tus cabellos son como los rebaños de cabras",
          "que descienden de Galaad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tus dientes son como rebaños de ovejas",
          "que ascienden después de haber sido bañadas.",
          "Cada una de ellas tiene gemelas,",
          "ninguna de ellas está sola."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tus mejillas, tras el velo,",
          "parecen dos mitades de granadas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pueden ser sesenta las reinas,",
          "ochenta las concubinas",
          "e innumerables las vírgenes,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "pero una sola es preciosa, paloma mía,",
          "la hija consentida de su madre,",
          "la favorita de quien le dio la vida.",
          "Las doncellas la ven y la bendicen;",
          "las reinas y las concubinas la alaban."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Quién es esta, admirable como la aurora?",
          "¡Es bella como la luna,",
          "radiante como el sol,",
          "imponente como ejército con sus banderas!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Descendí al huerto de los nogales",
          "para admirar los nuevos brotes en el valle,",
          "para admirar los retoños de las vides",
          "y los granados en flor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sin darme cuenta, mi pasión me puso",
          "entre las carrozas reales de mi pueblo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Los amigos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Vuelve, Sulamita, vuelve;",
          "vuélvete a nosotros,",
          "¡queremos contemplarte!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Y por qué han de contemplar a la Sulamita,",
          "como en las danzas de los campamentos?"
        ],
        "rlw_lines": []
      }
    ]
  },
