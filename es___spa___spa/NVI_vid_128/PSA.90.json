    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "Libro IV"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "Salmos 90–106"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oración de Moisés, hombre de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, tú has sido nuestro refugio",
          "generación tras generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Desde antes que nacieran los montes",
          "y que crearas la tierra y el mundo,",
          "desde los tiempos antiguos y hasta los tiempos postreros,",
          "tú eres Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tú haces que los hombres vuelvan al polvo,",
          "cuando dices: «¡Vuélvanse al polvo, mortales!»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mil años, para ti,",
          "son como el día de ayer, que ya pasó;",
          "son como una vigilia de la noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Arrasas a los mortales que son como un sueño:",
          "nacen por la mañana, como la hierba"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "que al amanecer brota y florece,",
          "y por la noche ya está marchita y seca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tu ira en verdad nos consume;",
          "tu indignación nos aterra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ante ti has puesto nuestras maldades;",
          "a la luz de tu presencia, nuestros pecados secretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por causa de tu ira se nos va la vida entera;",
          "se esfuman nuestros años como un suspiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Algunos llegamos hasta los setenta años,",
          "quizás alcancemos hasta los ochenta,",
          "si las fuerzas nos acompañan.",
          "Tantos años de vida, sin embargo,",
          "solo traen problemas y penas:",
          "pronto pasan y volamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Quién puede comprender el poder de tu ira?",
          "Tu ira es tan grande como el temor que se te debe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Enséñanos a contar bien nuestros días,",
          "para que nuestro corazón adquiera sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Cuándo, Señor, te volverás hacia nosotros?",
          "¡Compadécete ya de tus siervos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sácianos de tu gran amor por la mañana,",
          "y toda nuestra vida cantaremos de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Alégranos conforme a los días que nos has afligido",
          "y a los años que nos has hecho sufrir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Sean manifiestas tus obras a tus siervos",
          "y tu esplendor a sus descendientes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Que el favor del Señor nuestro Dios esté sobre nosotros.",
          "Confirma en nosotros la obra de nuestras manos;",
          "sí, confirma la obra de nuestras manos."
        ],
        "rlw_lines": []
      }
    ]
  },
