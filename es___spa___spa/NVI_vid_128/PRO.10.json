    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Proverbios de Salomón"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Proverbios de Salomón:",
          "El hijo sabio es la alegría de su padre;",
          "el hijo necio es el pesar de su madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Las riquezas mal habidas no sirven de nada,",
          "pero la justicia libra de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El Señor no deja sin comer al justo,",
          "pero frustra la ambición de los malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Las manos ociosas conducen a la pobreza;",
          "las manos diligentes atraen riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El hijo prevenido se abastece en el verano,",
          "pero el sinvergüenza duerme en tiempo de cosecha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El justo se ve coronado de bendiciones,",
          "pero la boca del malvado encubre violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "La memoria de los justos es una bendición,",
          "pero la fama de los malvados se pudrirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El sabio de corazón acata los mandamientos,",
          "pero el de palabras tontas va camino al desastre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Quien se conduce con integridad anda seguro;",
          "quien anda en caminos perversos será descubierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quien guiña el ojo con malicia provoca pesar;",
          "el necio y murmurador va camino al desastre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Fuente de vida es la boca del justo,",
          "pero la boca del malvado encubre violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El odio es motivo de disensiones,",
          "pero el amor cubre todas las faltas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "En los labios del prudente hay sabiduría;",
          "en la espalda del falto de juicio, solo garrotazos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El que es sabio atesora el conocimiento,",
          "pero la boca del necio es un peligro inminente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "La riqueza del rico es su baluarte;",
          "la pobreza del pobre es su ruina."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El salario del justo es la vida;",
          "la ganancia del malvado es el pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "El que atiende a la corrección va camino a la vida;",
          "el que la rechaza se pierde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El de labios mentirosos disimula su odio,",
          "y el que propaga calumnias es un necio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El que mucho habla, mucho yerra;",
          "el que es sabio refrena su lengua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Plata refinada es la lengua del justo;",
          "el corazón del malvado es de poco valor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Los labios del justo orientan a muchos;",
          "los necios mueren por falta de juicio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La bendición del Señor trae riquezas",
          "que no vienen acompañadas de tristezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El necio se divierte con su mala conducta,",
          "pero el sabio se recrea con la sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Lo que el malvado teme, eso le ocurre;",
          "lo que el justo desea, eso recibe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Pasa la tormenta y desaparece el malvado,",
          "pero el justo permanece firme para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Como vinagre a los dientes y humo a los ojos",
          "es el perezoso para quienes lo emplean."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El temor del Señor prolonga la vida,",
          "pero los años del malvado se acortan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "El futuro de los justos es dichoso;",
          "la esperanza de los malvados se desvanece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "El camino del Señor es refugio de los íntegros",
          "y ruina de los malhechores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Los justos no tropezarán jamás;",
          "los malvados no habitarán la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "La boca del justo expresa sabiduría,",
          "pero la lengua perversa será cercenada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Los labios del justo saben lo que conviene,",
          "pero de la boca del malvado brota perversidad."
        ],
        "rlw_lines": []
      }
    ]
  },
