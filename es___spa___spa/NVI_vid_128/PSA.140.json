    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Señor, líbrame de los malvados;",
          "protégeme de los violentos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "de los que urden en su corazón planes malvados",
          "y todos los días fomentan la guerra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Afilan su lengua cual lengua de serpiente;",
          "¡veneno de víbora hay en sus labios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Señor, protégeme del poder de los malvados;",
          "protégeme de los violentos,",
          "de los que piensan hacerme caer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Esos engreídos me han tendido una trampa;",
          "han puesto los lazos de su red,",
          "han tendido trampas en mi camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Yo digo al Señor: «Tú eres mi Dios.",
          "Atiende, Señor, mi voz suplicante»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Señor Soberano, mi poderoso salvador,",
          "¡tú proteges mi cabeza en el día de la batalla!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No satisfagas, Señor, los caprichos de los impíos;",
          "no permitas que sus planes prosperen,",
          "para que no se enorgullezcan."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Que sobre la cabeza de los que me rodean",
          "recaiga el mal que sus labios proclaman."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Que lluevan brasas sobre ellos",
          "y sean echados en el fuego,",
          "en abismos profundos, de donde no vuelvan a salir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Que no eche raíces en la tierra",
          "la gente de lengua mentirosa;",
          "que la calamidad persiga y destruya",
          "a la gente que practica la violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Yo sé que el Señor hace justicia al pobre",
          "y defiende el derecho de los necesitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ciertamente los justos alabarán tu nombre",
          "y los íntegros vivirán en tu presencia."
        ],
        "rlw_lines": []
      }
    ]
  },
