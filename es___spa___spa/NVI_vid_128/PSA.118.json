    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Den gracias al Señor porque él es bueno;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Que lo diga Israel:",
          "«Su gran amor perdura para siempre»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que lo diga la familia de Aarón:",
          "«Su gran amor perdura para siempre»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Que lo digan los que temen al Señor:",
          "«Su gran amor perdura para siempre»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Desde mi angustia clamé al Señor",
          "y él respondió dándome libertad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El Señor está conmigo y no tengo miedo;",
          "¿qué me puede hacer un simple mortal?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El Señor está conmigo, él es mi ayuda;",
          "veré por los suelos a los que me odian."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Es mejor refugiarse en el Señor",
          "que confiar en el hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Es mejor refugiarse en el Señor",
          "que confiar en gente poderosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todas las naciones me rodearon,",
          "pero en el nombre del Señor las aniquilé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Me rodearon por completo,",
          "pero en el nombre del Señor las aniquilé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Me rodearon como abejas,",
          "pero se consumieron como zarzas en el fuego.",
          "En el nombre del Señor las aniquilé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Me empujaron con violencia para que cayera,",
          "pero el Señor me ayudó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El Señor es mi fuerza y mi canción;",
          "¡él es mi salvación!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Gritos de júbilo y salvación",
          "resuenan en las casas de los justos:",
          "«¡La diestra del Señor hace proezas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡La diestra del Señor es exaltada!",
          "¡La diestra del Señor hace proezas!»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No he de morir; he de vivir",
          "para proclamar las obras del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El Señor me ha castigado con dureza,",
          "pero no me ha entregado a la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ábranme las puertas de la justicia",
          "para que entre yo a dar gracias al Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Esta es la puerta del Señor,",
          "por ella entran los justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Te daré gracias porque me respondiste,",
          "porque eres mi salvación!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La piedra que desecharon los constructores",
          "ha llegado a ser la piedra angular."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Esto ha sido obra del Señor",
          "y nos deja maravillados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Este es el día que hizo el Señor;",
          "regocijémonos y alegrémonos en él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Señor, te ruego, ¡danos la salvación!",
          "Señor, te ruego, ¡concédenos la victoria!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Bendito el que viene en el nombre del Señor.",
          "Desde la casa del Señor los bendecimos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El Señor es Dios",
          "y nos ilumina.",
          "Con ramas en las manos, únanse a la procesión festiva",
          "hasta los cuernos del altar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Tú eres mi Dios, por eso te doy gracias;",
          "tú eres mi Dios, por eso te exalto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Den gracias al Señor porque él es bueno;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
