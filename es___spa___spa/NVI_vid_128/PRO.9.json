    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Invitación de la sabiduría y de la necedad"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La sabiduría construyó su casa",
          "y labró sus siete pilares."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Preparó la carne, mezcló su vino",
          "y también tendió la mesa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Envió a sus doncellas y ahora clama",
          "desde lo más alto de la ciudad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«¡Vengan conmigo los inexpertos!",
          "—dice a los faltos de juicio—."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Vengan, disfruten de mi pan",
          "y beban del vino que he mezclado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dejen su insensatez y vivirán;",
          "anden por el camino del discernimiento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»El que corrige al insolente se gana que lo insulten;",
          "el que reprende al malvado se gana su desprecio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No reprendas al insolente, no sea que acabe por odiarte;",
          "reprende al sabio y te amará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Instruye al sabio, y se hará más sabio;",
          "enseña al justo, y aumentará su saber."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "»El comienzo de la sabiduría es el temor del Señor;",
          "conocer al Santo es tener entendimiento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por mí aumentarán tus días;",
          "años de vida te serán añadidos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si eres sabio, tu premio será tu sabiduría;",
          "si eres insolente, solo tú lo sufrirás»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La mujer necia es escandalosa,",
          "frívola y desvergonzada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Se sienta a las puertas de su casa,",
          "en lo más alto de la ciudad"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "y llama a los que van por el camino,",
          "a los que no se apartan de su senda."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "«¡Vengan conmigo los inexpertos!",
          "—dice a los faltos de juicio—"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¡Las aguas robadas saben a gloria!",
          "¡El pan sabe a miel si se come a escondidas!»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero estos ignoran que allí están los muertos,",
          "que sus invitados están en lo profundo de los dominios de la muerte."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
