    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, tú has sido bondadoso con esta tierra tuya",
          "al restaurar a Jacob;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "perdonaste la iniquidad de tu pueblo",
          "y cubriste todos sus pecados;"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "depusiste por completo tu furor",
          "y contuviste el ardor de tu ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Restáuranos una vez más, Dios y Salvador nuestro;",
          "pon fin a tu disgusto con nosotros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Vas a estar enojado con nosotros para siempre?",
          "¿Vas a seguir airado por todas las generaciones?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿No volverás a darnos nueva vida",
          "para que tu pueblo se regocije en ti?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Muéstranos, Señor, tu gran amor",
          "y concédenos tu salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Voy a escuchar lo que Dios el Señor dice:",
          "él promete paz a su pueblo y a sus fieles,",
          "para que no se vuelvan a la necedad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Muy cercano está para salvar a los que le temen,",
          "para establecer su gloria en nuestra tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El amor y la verdad se encontrarán;",
          "se besarán la justicia y la paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "De la tierra brotará la verdad",
          "y desde el cielo se asomará la justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El Señor mismo nos dará bienestar",
          "y nuestra tierra rendirá su fruto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La justicia será su heraldo",
          "y preparará el camino para sus pasos."
        ],
        "rlw_lines": []
      }
    ]
  },
