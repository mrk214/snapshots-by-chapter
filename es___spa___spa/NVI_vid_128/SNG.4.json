    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Cuán bella eres, amada mía!",
          "¡Cuán bella eres!",
          "Tus dos ojos, tras el velo, son como palomas.",
          "Tus cabellos son como los rebaños de cabras",
          "que descienden de los montes de Galaad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tus dientes son como rebaños de ovejas recién trasquiladas,",
          "que ascienden después de haber sido bañadas.",
          "Cada una de ellas tiene gemelas,",
          "ninguna de ellas está sola."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tus labios son cual cinta carmesí;",
          "tu boca es hermosa.",
          "Tus mejillas, tras el velo,",
          "parecen dos mitades de granadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tu cuello se asemeja a la torre de David",
          "construida con piedras labradas;",
          "de ella penden mil escudos,",
          "escudos de guerreros todos ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tus pechos parecen dos cervatillos,",
          "dos crías mellizas de gacela",
          "que pastan entre azucenas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Antes de que el día despunte",
          "y se desvanezcan las sombras,",
          "subiré a la montaña de la mirra,",
          "a la colina del incienso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Toda tú eres bella, amada mía;",
          "no hay en ti defecto alguno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Desciende del Líbano conmigo, novia mía;",
          "desciende del Líbano conmigo.",
          "Baja de la cumbre del Amaná,",
          "de la cima del Senir y del Hermón.",
          "Baja de las guaridas de los leones,",
          "de los montes donde habitan los leopardos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Cautivaste mi corazón, hermana y novia mía,",
          "con una mirada de tus ojos;",
          "con una vuelta de tu collar",
          "cautivaste mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Cuán delicioso es tu amor,",
          "hermana y novia mía!",
          "¡Más agradable que el vino es tu amor,",
          "y más que toda especia",
          "la fragancia de tu perfume!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tus labios, novia mía, destilan miel;",
          "leche y miel escondes bajo la lengua.",
          "Cual perfume del Líbano",
          "es el perfume de tus vestidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Jardín cerrado eres tú,",
          "hermana y novia mía.",
          "Fuente cerrada y sellado manantial."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tus plantas son un huerto de granadas",
          "con frutos exquisitos",
          "flores de nardo y azahar;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "con toda clase de árbol de incienso,",
          "nardo y azafrán;",
          "con cálamo y canela,",
          "mirra y áloe",
          "y con las más finas especias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eres fuente de los jardines,",
          "manantial de aguas vivas,",
          "arroyo que del Líbano desciende."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Viento del norte, despierta!",
          "¡Viento del sur, ven acá!",
          "Soplen en mi jardín;",
          "¡esparzan su fragancia!",
          "Que venga mi amado a su jardín",
          "y pruebe sus frutos exquisitos."
        ],
        "rlw_lines": []
      }
    ]
  },
