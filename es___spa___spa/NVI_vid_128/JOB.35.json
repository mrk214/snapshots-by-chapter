    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tercer discurso de Eliú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Además, Eliú dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Job, ¿crees tener la razón cuando afirmas:",
          "“Mi justicia es mayor que la de Dios”?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Igual cuando te atreves a preguntarle:",
          "“¿En qué me beneficio si no peco?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "»Pues bien, voy a responderles",
          "a ti y a tus amigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mira hacia el cielo y fíjate bien;",
          "contempla las nubes en lo alto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Si pecas, ¿en qué afectas a Dios?",
          "Si multiplicas tus faltas, ¿en qué lo dañas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Si actúas con justicia, ¿qué puedes darle?",
          "¿Qué puede recibir de parte tuya?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Hagas el mal o hagas el bien,",
          "los únicos afectados por tu justicia serán tus semejantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "»Todo el mundo clama bajo el peso de la opresión,",
          "y pide ser librado del brazo de los poderosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pero nadie dice: “¿Dónde está Dios, mi Hacedor,",
          "que me inspira cánticos por las noches,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "que nos enseña más que a las bestias del campo,",
          "que nos hace más sabios que las aves del cielo?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si Dios no responde al clamor de la gente,",
          "es por la arrogancia de los malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Dios no escucha sus vanas peticiones;",
          "el Todopoderoso no les presta atención."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Aun cuando digas que no puedes verlo,",
          "tu caso está delante de él y debes aguardarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Tú dices que Dios no se enoja ni castiga",
          "y que no se da cuenta de tanta iniquidad;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "pero tú, Job, abres la boca y dices tonterías;",
          "hablas mucho y no sabes lo que dices»."
        ],
        "rlw_lines": []
      }
    ]
  },
