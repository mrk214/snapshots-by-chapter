    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hijos de David"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Estos fueron los hijos de David nacidos en Hebrón:",
          "Su primogénito fue Amnón, hijo de Ajinoán, la jezrelita;",
          "el segundo, Daniel, hijo de Abigaíl de Carmel;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "el tercero, Absalón, hijo de Macá, la hija del rey Talmay de Guesur;",
          "el cuarto, Adonías, hijo de Jaguit;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "el quinto, Sefatías, hijo de Abital;",
          "y el sexto, Itreán, hijo de Eglá, que era otra esposa de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Estos seis nacieron en Hebrón, donde reinó siete años y seis meses.",
          "David reinó en Jerusalén treinta y tres años."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Allí nacieron:",
          "Simá, Sobab, Natán y Salomón, hijos de Betsabé, la hija de Amiel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tuvo también a Ibjar, Elisama, Elifelet,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Noga, Néfeg, Jafía,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Elisama, Eliadá y Elifelet; nueve en total."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Todos estos fueron hijos de David, sin contar los hijos que tuvo con sus concubinas. La hermana de ellos fue Tamar."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Salomón"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Estos fueron los descendientes de Salomón en línea directa:",
          "Roboán,",
          "Abías,",
          "Asá,",
          "Josafat,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Jorán,",
          "Ocozías,",
          "Joás,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Amasías,",
          "Azarías,",
          "Jotán,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Acaz,",
          "Ezequías,",
          "Manasés,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Amón",
          "y Josías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los hijos de Josías:",
          "Johanán, el primero;",
          "Joacim, el segundo;",
          "Sedequías, el tercero,",
          "y Salún, el cuarto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los hijos de Joacim:",
          "Jeconías",
          "y Sedequías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los descendientes de Jeconías, el cautivo:",
          "Salatiel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Malquirán, Pedaías, Senazar, Jecamías, Hosamá y Nedabías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Los hijos de Pedaías:",
          "Zorobabel y Simí.",
          "Los hijos de Zorobabel:",
          "Mesulán y Jananías; Selomit fue hermana de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Tuvo también estos cinco: Jasubá, Ohel, Berequías, Jasadías y Yusab Jésed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Los descendientes de Jananías:",
          "Pelatías e Isaías, y también los hijos de Refaías, los de Arnán, los de Abdías y los de Secanías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Los descendientes de Secanías:",
          "Semaías y sus hijos Jatús, Igal, Barías, Nearías y Safat; seis en total."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Los hijos de Nearías:",
          "Elihoenay, Ezequías y Azricán; tres en total."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Los hijos de Elihoenay:",
          "Hodavías, Eliasib, Pelaías, Acub, Johanán, Delaías y Ananí; siete en total."
        ],
        "rlw_lines": []
      }
    ]
