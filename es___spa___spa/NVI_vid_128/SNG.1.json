    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantar de los cantares de Salomón."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primer Canto"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ah, si me besaras con los besos de tu boca…",
          "¡Mejor es tu amor que el vino!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "La fragancia de tus perfumes es placentera;",
          "tu nombre es bálsamo aromático.",
          "¡Con razón te aman las doncellas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Arrástrame en pos de ti! ¡Date prisa!",
          "¡Llévame, oh rey, a tu alcoba!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Los amigos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Regocijémonos y deleitémonos juntos;",
          "celebraremos tus caricias más que el vino.",
          "¡Sobran las razones para amarte!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Soy morena y hermosa,",
          "hijas de Jerusalén;",
          "morena como las tiendas de campaña de Cedar,",
          "hermosa como las cortinas de Salomón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No se fijen en mi tez morena",
          "ni en que el sol me bronceó la piel.",
          "Mis hermanos se enfadaron contra mí",
          "y me obligaron a cuidar las viñas;",
          "¡y mi propia viña descuidé!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuéntame, amor de mi vida,",
          "¿dónde apacientas tus rebaños?,",
          "¿dónde al mediodía los haces reposar?",
          "¿Por qué he de andar como mujer con velo",
          "entre los rebaños de tus amigos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Los amigos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Si no lo sabes, la más bella de las mujeres,",
          "ve tras la huella del rebaño",
          "y apacienta tus cabritos",
          "junto a las moradas de los pastores."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Te comparo, amada mía, con una yegua",
          "entre los caballos del carro del faraón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Qué hermosas lucen tus mejillas entre los pendientes!",
          "¡Qué hermoso luce tu cuello entre los collares!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Haremos para ti pendientes de oro",
          "con incrustaciones de plata!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mientras el rey se halla sentado a la mesa,",
          "mi nardo esparce su fragancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mi amado es para mí como el saquito de mirra",
          "que duerme entre mis pechos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Mi amado es para mí como un ramito de azahar",
          "de las viñas de Engadi."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Cuán bella eres, amada mía!",
          "¡Cuán bella eres!",
          "¡Tus ojos son dos palomas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Cuán hermoso eres, amado mío!",
          "¡Eres un encanto!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Una alfombra de hojas es nuestro lecho,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "los cedros son las vigas de la casa",
          "y nos cubre un techo de cipreses."
        ],
        "rlw_lines": []
      }
    ]
  },
