    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Leví"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Estos fueron los hijos de Leví:",
          "Guersón, Coat y Merari."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Hijos de Coat:",
          "Amirán, Izar, Hebrón y Uziel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Hijos de Amirán:",
          "Aarón, Moisés y Miriam.",
          "Hijos de Aarón:",
          "Nadab, Abiú, Eleazar e Itamar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eleazar fue el padre de Finés.",
          "Finés fue el padre de Abisúa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Abisúa fue el padre de Buquí,",
          "Buquí fue el padre de Uzi,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Uzi fue el padre de Zeraías,",
          "Zeraías fue el padre de Merayot,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Merayot fue el padre de Amarías,",
          "Amarías fue el padre de Ajitob,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ajitob fue el padre de Sadoc,",
          "Sadoc fue el padre de Ajimaz,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ajimaz fue el padre de Azarías,",
          "Azarías fue el padre de Johanán,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Johanán fue el padre de Azarías, quien ejerció el sacerdocio en el Templo que Salomón construyó en Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Azarías fue el padre de Amarías,",
          "Amarías fue el padre de Ajitob,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ajitob fue el padre de Sadoc,",
          "Sadoc fue el padre de Salún,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Salún fue el padre de Jilquías,",
          "Jilquías fue el padre de Azarías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Azarías fue el padre de Seraías,",
          "y Seraías fue el padre de Josadac."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Josadac fue llevado al cautiverio cuando el Señor deportó a Judá y a Jerusalén por medio de Nabucodonosor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los hijos de Leví:",
          "Guersón, Coat y Merari."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Hijos de Guersón:",
          "Libní y Simí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Hijos de Coat:",
          "Amirán, Izar, Hebrón y Uziel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Hijos de Merari:",
          "Majlí y Musí.",
          "Estos fueron los descendientes de los levitas por sus familias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Los descendientes de Guersón en línea directa fueron:",
          "Libní, Yajat,",
          "Zimá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Joa,",
          "Idó, Zera",
          "y Yatray."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Los descendientes de Coat en línea directa fueron:",
          "Aminadab, Coré,",
          "Asir,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Elcaná,",
          "Ebiasaf, Asir,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Tajat, Uriel,",
          "Uzías y Saúl."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Los hijos de Elcaná fueron:",
          "Amasay y Ajimot."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Los descendientes de Ajimot en línea directa fueron:",
          "Elcaná, Zofay,",
          "Najat,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Eliab,",
          "Jeroán",
          "y Elcaná."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Los hijos de Samuel fueron:",
          "Joel, el primogénito,",
          "y Abías, el segundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Los descendientes de Merari en línea directa fueron:",
          "Majlí, Libní,",
          "Simí, Uza,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Simá, Jaguías",
          "y Asaías."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cantores del Templo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Estos fueron los que David puso a cargo del canto en el Templo del Señor, desde que se colocó allí el arca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Ellos ya cantaban en la Tienda de reunión, delante del santuario, antes de que Salomón edificara el Templo del Señor en Jerusalén. Luego continuaron su ministerio según las ordenanzas establecidas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Estos y sus hijos estuvieron a cargo del canto:",
          "De los descendientes de Coat,",
          "el cantor Hemán",
          "fue hijo de Joel, descendiente en línea directa de Samuel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Elcaná, Jeroán,",
          "Eliel, Toa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Zuf, Elcaná,",
          "Mahat, Amasay,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Elcaná, Joel,",
          "Azarías, Sofonías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Tajat, Asir,",
          "Ebiasaf, Coré,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Izar, Coat,",
          "Leví e Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "A la derecha de Hemán se colocaba su pariente Asaf,",
          "hijo de Berequías, descendiente en línea directa de Simá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Micael, Baseías,",
          "Malquías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Etní,",
          "Zera, Adaías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Etán, Zimá,",
          "Simí,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Yajat,",
          "Guersón y Leví."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "A la izquierda de Hemán se colocaba",
          "Etán, hijo de Quisi, que era de sus parientes los meraritas",
          "y descendiente en línea directa de Abdí, Maluc,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Jasabías,",
          "Amasías, Jilquías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Amsí, Baní,",
          "Sémer,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Majlí, Musí, Merari",
          "y Leví."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Sus hermanos los levitas estaban al servicio del santuario, en el Templo de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Aarón y sus hijos estaban encargados de quemar las ofrendas sobre el altar de los holocaustos y sobre el altar del incienso. De acuerdo con lo ordenado por Moisés, siervo de Dios, eran también responsables de todo lo relacionado con el Lugar Santísimo y de ofrecer el sacrificio por el perdón de pecados de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Los descendientes de Aarón en línea directa fueron:",
          "Eleazar, Finés,",
          "Abisúa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Buquí,",
          "Uzi, Zeraías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Merayot, Amarías,",
          "Ajitob,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Sadoc",
          "y Ajimaz."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ciudades de los levitas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Estos fueron los territorios donde vivían los descendientes de Aarón. A las familias de los coatitas se les adjudicó por sorteo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Hebrón, en la tierra de Judá, con sus campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "A Caleb, hijo de Jefone, le tocaron el campo de la ciudad y sus aldeas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "A los descendientes de Aarón les entregaron las siguientes ciudades de refugio: Hebrón, Libná, Jatir, Estemoa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Hilén, Debir,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Asán y Bet Semes, con sus respectivos campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "De la tribu de Benjamín les dieron Gueba, Alemet y Anatot, con sus respectivos campos de pastoreo.",
          "En total les tocaron trece ciudades, distribuidas entre sus familias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Al resto de los descendientes de Coat les tocaron por sorteo diez ciudades de la media tribu de Manasés."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "A los descendientes de Guersón, según sus familias, les dieron trece ciudades de las tribus de Isacar, Aser y Neftalí, y de la tribu de Manasés que estaba en Basán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "A los descendientes de Merari, según sus familias, les tocaron por sorteo doce ciudades de las tribus de Rubén, Gad y Zabulón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Fue así como los israelitas entregaron a los levitas estas ciudades con sus campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Les adjudicaron por sorteo las ciudades de las tribus de Judá, Simeón y Benjamín, las cuales ya han sido mencionadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Algunas de las familias descendientes de Coat recibieron por sorteo ciudades de la tribu de Efraín."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Como ciudades de refugio les dieron Siquén, en la región montañosa de Efraín, Guézer,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Jocmeán, Bet Jorón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "Ayalón y Gat Rimón, con sus respectivos campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "De la media tribu de Manasés les entregaron Aner y Bileán, con sus respectivos campos de pastoreo. Estas fueron las ciudades asignadas al resto de las familias de Coat."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "Los descendientes de Guersón recibieron las siguientes ciudades de la media tribu de Manasés:",
          "Golán de Basán, y Astarot, con sus respectivos campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "De la tribu de Isacar recibieron: Cedes, Daberat,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "Ramot y Anén, con sus respectivos campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "De la tribu de Aser recibieron: Masal, Abdón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "Hucoc y Rejob, con sus respectivos campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "De la tribu de Neftalí recibieron: Cedes de Galilea, Hamón y Quiriatayin, con sus respectivos campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "Los demás descendientes de Merari recibieron las siguientes ciudades de la tribu de Zabulón:",
          "Rimmono y Tabor, con sus respectivos campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "De la tribu de Rubén, que está en la ribera oriental del Jordán, frente a Jericó, recibieron: Béser, que está en el desierto, Yahaza,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Cademot y Mefat, con sus respectivos campos de pastoreo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "De la tribu de Gad recibieron: Ramot de Galaad, Majanayin,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "Hesbón y Jazer, con sus respectivos campos de pastoreo."
        ],
        "rlw_lines": []
      }
    ]
  },
