    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lámed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿Por qué, Señor, te mantienes distante?",
          "¿Por qué te escondes en momentos de angustia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Con arrogancia persigue el malvado al indefenso,",
          "pero quedará atrapado en sus propias artimañas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El malvado hace alarde de su propia codicia;",
          "alaba al ambicioso y menosprecia al Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El malvado, con su nariz en alto, no busca a Dios.",
          "No hay lugar para él en sus pensamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Todas sus empresas son siempre exitosas;",
          "tan altas y alejadas de él están tus leyes",
          "que se burla de todos sus enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Y se dice a sí mismo: «Nada me hará caer jamás.",
          "Nadie me hará daño»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Llena está su boca de maldiciones,",
          "de mentiras y amenazas;",
          "bajo su lengua esconde maldad y violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Se pone al acecho en las aldeas,",
          "se esconde en espera de sus víctimas",
          "y asesina en emboscada al inocente."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Cual león que acecha en su guarida,",
          "listo para atrapar al indefenso;",
          "le cae encima y lo arrastra en su red."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Bajo el peso de su poder,",
          "sus víctimas son abatidas y caen desechas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Se dice a sí mismo: «Dios se ha olvidado.",
          "Se cubre el rostro. Nunca ve nada»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Qof"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡Levántate, Señor!",
          "¡Levanta, oh Dios, tu brazo!",
          "¡No te olvides de los indefensos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Por qué te ha de menospreciar el malvado?",
          "¿Por qué ha de pensar que no lo llamarás a cuentas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resh"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pero tú ves la maldad y la aflicción,",
          "las tomas en cuenta y te harás cargo de ellas.",
          "Las víctimas se encomiendan a ti;",
          "tú eres la ayuda de los huérfanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Shin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Rómpeles el brazo al malvado y al impío!",
          "¡Pídeles cuentas de su maldad",
          "hasta que desaparezca!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El Señor es Rey eterno;",
          "los paganos serán borrados de su tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tav"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tú, Señor, escuchas el deseo de los indefensos,",
          "les infundes aliento y atiendes a su clamor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tú defiendes al huérfano y al oprimido,",
          "para que el hombre, hecho de tierra,",
          "no siga ya sembrando el terror."
        ],
        "rlw_lines": []
      }
    ]
  },
