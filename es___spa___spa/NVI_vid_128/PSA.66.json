    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Cántico. Salmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aclamen alegres a Dios, habitantes de toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Canten salmos a su glorioso nombre;",
          "¡ríndanle gloriosas alabanzas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Díganle a Dios:",
          "«¡Cuán imponentes son tus obras!",
          "Es tan grande tu poder",
          "que tus enemigos se rinden ante ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Toda la tierra se postra en tu presencia",
          "y te canta salmos;",
          "canta salmos a tu nombre»."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Vengan y vean las proezas de Dios,",
          "sus obras portentosas en nuestro favor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Convirtió el mar en tierra seca,",
          "y el pueblo cruzó el río a pie.",
          "¡Regocijémonos en él!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Con su poder gobierna eternamente;",
          "sus ojos vigilan a las naciones,",
          "para que no se levanten contra él los rebeldes."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Bendigan, pueblos, a nuestro Dios,",
          "hagan oír la voz de su alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Él ha protegido nuestra vida,",
          "ha evitado que resbalen nuestros pies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tú, oh Dios, nos has puesto a prueba;",
          "nos has purificado como a la plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Nos has hecho caer en una trampa;",
          "has echado sobre nuestra espalda una pesada carga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Dejaste que cabalgaran sobre nuestra cabeza;",
          "hemos pasado por el fuego y por el agua,",
          "pero al fin nos has llevado a un lugar de abundancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Me presentaré en tu Templo con holocaustos",
          "y cumpliré las promesas que te hice,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "las promesas de mis labios y mi boca",
          "que pronuncié en medio de mi angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Te ofreceré holocaustos de animales engordados,",
          "junto con el humo de ofrendas de carneros;",
          "te ofreceré toros y machos cabríos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Vengan ustedes, temerosos de Dios,",
          "escuchen, que voy a contarles todo lo que él ha hecho por mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Clamé a él con mi boca;",
          "lo alabé con mi lengua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si en mi corazón hubiera yo abrigado maldad,",
          "el Señor no me habría escuchado;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "pero Dios sí me ha escuchado,",
          "ha atendido a la voz de mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Bendito sea Dios,",
          "que no rechazó mi oración",
          "ni me negó su gran amor!"
        ],
        "rlw_lines": []
      }
    ]
  },
