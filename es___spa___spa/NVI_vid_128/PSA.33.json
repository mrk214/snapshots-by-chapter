    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Canten al Señor con alegría, ustedes los justos;",
          "es propio de los íntegros alabar al Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alaben al Señor al son del arpa;",
          "entonen alabanzas con la lira de diez cuerdas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cántenle una canción nueva;",
          "toquen con destreza",
          "y den voces de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "La palabra del Señor es justa;",
          "fieles son todas sus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El Señor ama la justicia y el derecho;",
          "llena está la tierra de su gran amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por la palabra del Señor fueron hechos los cielos",
          "y por el soplo de su boca, todo lo que en ellos hay."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él recoge en cántaros las aguas del mar",
          "y junta en depósitos las profundidades del océano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Que toda la tierra tema al Señor;",
          "que lo honren todos los pueblos del mundo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "porque él habló, todo fue hecho;",
          "dio una orden y todo quedó firme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El Señor frustra los planes de las naciones;",
          "desbarata los designios de los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pero los planes del Señor quedan firmes para siempre;",
          "los designios de su corazón son eternos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Dichosa la nación cuyo Dios es el Señor,",
          "el pueblo que escogió por su heredad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "El Señor observa desde el cielo",
          "y ve a toda la humanidad;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "él contempla desde su morada",
          "a todos los habitantes de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Él es quien formó el corazón de todos",
          "y quien conoce a fondo todas sus acciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "No se salva el rey por sus muchos soldados",
          "ni por su mucha fuerza se libra el valiente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Vana esperanza de victoria es el caballo;",
          "a pesar de su mucha fuerza no puede salvar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Los ojos del Señor están sobre los que le temen;",
          "de los que esperan en su gran amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Él los libra de la muerte",
          "y en épocas de hambre los mantiene con vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Esperamos confiados en el Señor;",
          "él es nuestro socorro y nuestro escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "En él se regocija nuestro corazón,",
          "porque confiamos en su santo nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Que tu gran amor, Señor, nos acompañe,",
          "tal como lo esperamos de ti."
        ],
        "rlw_lines": []
      }
    ]
  },
