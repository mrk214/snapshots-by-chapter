  "book": {
    "book_usfm": "PSA",
    "name": "Salmo"
  },
  "chapter": {
    "chapter_usfm": "PSA.89",
    "current": {
      "usfm": "PSA.89",
      "human": "Salmo 89"
    },
    "previous": {
      "usfm": "PSA.88",
