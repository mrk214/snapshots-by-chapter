    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de los hijos de Coré. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Los cimientos de la ciudad de Dios están en el santo monte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El Señor ama las entradas de Sión",
          "más que a todas las moradas de Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "De ti, ciudad de Dios,",
          "se dicen cosas gloriosas:"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«Entre los que me reconocen",
          "puedo contar a Rahab y a Babilonia,",
          "a Filistea y a Tiro, lo mismo que a Cus.",
          "Se dice: “Este nació en Sión”»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "De Sión se dirá, en efecto:",
          "«Este y aquel nacieron en ella.",
          "El Altísimo mismo la ha establecido»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El Señor anotará en el registro de los pueblos:",
          "«Este nació en Sión»."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Y mientras cantan y bailan, dicen:",
          "«Todas mis fuentes están en ti»."
        ],
        "rlw_lines": []
      }
    ]
  },
