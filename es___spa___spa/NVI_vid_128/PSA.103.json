    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Alaba, alma mía, al Señor;",
          "alabe todo mi ser su santo nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alaba, alma mía, al Señor",
          "y no olvides ninguno de sus beneficios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Él perdona todos tus pecados",
          "y sana todas tus dolencias;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "él rescata tu vida del sepulcro",
          "y te corona de gran amor y misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "él te colma de bienes",
          "y tu juventud se renueva como el águila."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El Señor hace justicia",
          "y defiende a todos los oprimidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dio a conocer sus caminos a Moisés;",
          "reveló sus obras al pueblo de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El Señor es compasivo y misericordioso,",
          "lento para la ira y grande en amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No sostiene para siempre su querella",
          "ni guarda rencor eternamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No nos trata conforme a nuestros pecados",
          "ni nos paga según nuestras iniquidades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tan grande es su amor por los que le temen",
          "como alto es el cielo sobre la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Tan lejos de nosotros echó nuestras transgresiones",
          "como lejos del oriente está el occidente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tan compasivo es el Señor con los que le temen",
          "como lo es un padre con sus hijos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Él conoce de qué hemos sido formados;",
          "recuerda que somos polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El hombre es como la hierba,",
          "sus días florecen como la flor del campo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "cuando el viento pasa",
          "desaparece sin dejar rastro alguno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pero el amor del Señor es eterno",
          "y siempre está con los que le temen;",
          "su justicia está con los hijos de sus hijos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "con los que cumplen su pacto",
          "y se acuerdan de sus preceptos para ponerlos por obra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El Señor ha establecido su trono en el cielo;",
          "su reinado domina sobre todos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Bendigan al Señor, ustedes sus ángeles,",
          "paladines que ejecutan su palabra",
          "y obedecen a su voz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Bendigan al Señor, todos sus ejércitos,",
          "siervos suyos que cumplen su voluntad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Bendigan al Señor, todas sus obras",
          "en todos los ámbitos de su dominio.",
          "¡Bendice, alma mía, al Señor!"
        ],
        "rlw_lines": []
      }
    ]
  },
