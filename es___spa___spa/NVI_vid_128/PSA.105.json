  "book": {
    "book_usfm": "PSA",
    "name": "Salmo"
  },
  "chapter": {
    "chapter_usfm": "PSA.105",
    "is_chapter": true,
    "previous": {
      "usfm": "PSA.104",
      "human": "Salmo 104"
    },
    "current": {
      "usfm": "PSA.105",
      "human": "Salmo 105"
    },
    "next": {
      "usfm": "PSA.106",
      "human": "Salmo 106"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Den gracias al Señor; proclamen su nombre.",
          "¡Den a conocer sus obras entre las naciones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Cántenle, entónenle salmos!",
          "¡Hablen de todas sus maravillas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Gloríense en su santo nombre!",
          "¡Alégrese el corazón de los que buscan al Señor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Busquen al Señor y su fuerza;",
          "anhelen siempre su rostro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Recuerden las maravillas que ha hecho,",
          "las señales y las leyes que ha emitido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Ustedes, descendientes de Abraham, su siervo!",
          "¡Ustedes, hijos de Jacob, elegidos suyos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él es el Señor nuestro Dios;",
          "en toda la tierra están sus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Se acordó siempre de su pacto,",
          "la palabra que ordenó para mil generaciones;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "del pacto que hizo con Abraham",
          "y del juramento que hizo a Isaac."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Se lo confirmó a Jacob como un estatuto,",
          "a Israel como un pacto eterno,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "cuando dijo: «Te daré la tierra de Canaán",
          "como la herencia que te corresponde»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Aun cuando eran pocos en número,",
          "unos cuantos extranjeros en la tierra,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "que andaban siempre de nación en nación",
          "y de reino en reino,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "a nadie permitió que los oprimiera,",
          "sino que por causa de ellos reprendió a los reyes:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "«¡No toquen a mis ungidos!",
          "¡No maltraten a mis profetas!»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Dios provocó hambre en la tierra",
          "al hacer escasear el alimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pero envió delante de ellos a un hombre:",
          "a José, vendido como esclavo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Le sujetaron los pies con grilletes,",
          "entre hierros aprisionaron su cuello,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "hasta que se cumplió lo que él predijo",
          "y la palabra del Señor probó que él era veraz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El rey ordenó ponerlo en libertad;",
          "el gobernante de los pueblos lo dejó libre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Lo nombró señor sobre su casa",
          "y administrador de todas sus posesiones,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "con pleno poder para instruir a sus príncipes",
          "e impartir sabiduría a sus jefes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Entonces Israel vino a Egipto;",
          "Jacob fue extranjero en el país de Cam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "El Señor hizo que su pueblo se multiplicara;",
          "lo hizo más poderoso que sus adversarios,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "a quienes les cambió su sentir para que odiaran a su pueblo",
          "y se confabularan contra sus siervos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Envió a su siervo Moisés,",
          "y a Aarón, a quien había escogido,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "y estos hicieron señales milagrosas entre ellos,",
          "maravillas en el país de Cam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Envió tinieblas y la tierra se oscureció,",
          "pero ellos se rebelaron contra sus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Convirtió en sangre sus aguas",
          "y causó la muerte de sus peces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Todo Egipto se infestó de ranas,",
          "hasta las habitaciones de sus reyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Habló Dios e invadieron todo el país",
          "enjambres de tábanos y mosquitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Convirtió la lluvia en granizo",
          "y lanzó rayos sobre su tierra;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "derribó sus vides y sus higueras,",
          "y destrozó los árboles de su territorio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Dio una orden y llegaron las langostas",
          "y una infinidad de saltamontes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Arrasaron con toda la vegetación del país,",
          "devoraron los frutos de sus campos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Hirió de muerte a todos los primogénitos del país,",
          "las primicias de su virilidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Sacó a los israelitas cargados de plata y oro",
          "y no hubo entre sus tribus nadie que tropezara."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Los egipcios se alegraron de su partida,",
          "pues el miedo a los israelitas los dominaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Él los cubrió con una nube",
          "y con fuego los alumbró de noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Pidió el pueblo comida y les envió codornices;",
          "los sació con pan del cielo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Abrió la roca y brotó agua",
          "que corrió por el desierto como un río."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Se acordó Dios de su santa promesa,",
          "la que hizo a su siervo Abraham."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Sacó a su pueblo, a sus escogidos,",
          "en medio de gran alegría y de gritos jubilosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Les entregó las tierras que poseían las naciones;",
          "heredaron el fruto del trabajo de otros pueblos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "para que ellos observaran sus estatutos",
          "y pusieran en práctica sus leyes.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
