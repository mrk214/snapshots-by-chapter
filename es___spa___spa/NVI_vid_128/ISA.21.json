{"version":{"version_id":128,"local_abbreviation":"NVI","local_title":"Nueva Versión Internacional - Español","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"Biblica, Inc."},"copyright":{"html":"<p>Santa Biblia, Nueva Versión Internacional® NVI®</p> <p>© 1999, 2015, 2022 por Biblica, Inc.</p> <p>Usado con permiso. Reservados todos los derechos en todo el mundo.</p>","text":"Santa Biblia, Nueva Versión Internacional® NVI® © 1999, 2015, 2022 por Biblica, Inc. Usado con permiso. Reservados todos los derechos en todo el mundo."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.21","is_chapter":true,"previous":{"usfm":"ISA.20","human":"Isaías 20","canonical":true,"toc":true},"current":{"usfm":"ISA.21","human":"Isaías 21"},"next":{"usfm":"ISA.22","human":"Isaías 22","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Profecía contra Babilonia"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Profecía contra el desierto junto al mar:","Como torbellinos que pasan por el Néguev,","se acercan invasores","de una temible tierra del desierto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Una visión terrible me ha sido revelada:","el traidor traiciona, el destructor destruye.","¡Al ataque, Elam! ¡Al asedio, Media!","Pondré fin a todo su gemido."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Por eso mi cuerpo se estremece de angustia,","sufro de agudos dolores, como los de una parturienta;","lo que oigo, me aturde;","lo que veo, me desconcierta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Se estremece mi corazón,","me hace temblar el terror;","el crepúsculo tan anhelado","se me ha vuelto un espanto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["¡Ellos tienden las mesas,","extienden los tapices,","y comen y beben!","¡Oficiales, pónganse de pie!","¡Levántense y brillen los escudos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Porque así me ha dicho el Señor:","«Ve y pon un centinela,","que informe de todo lo que vea."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Cuando vea carros de combate","tirados por parejas de caballos,","o gente montada en asnos","o en camellos,","que preste atención,","mucha atención»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Y el centinela gritó:","«¡Día tras día, Señor,","estoy de pie en la torre;","cada noche permanezco","en mi puesto de guardia!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["¡Ahí viene un hombre","en un carro de combate tirado por un par de caballos!","Y este es su mensaje:","“¡Ha caído, ha caído Babilonia!","¡Todas las imágenes de sus dioses","han rodado por el suelo!”»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Pueblo mío, trillado y aventado como el trigo,","yo te he anunciado lo que he oído","de parte del Señor de los Ejércitos,","del Dios de Israel."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Profecía contra Edom"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Profecía contra Dumá:","Alguien me grita desde Seír:","«Centinela, ¿cuánto queda de la noche?","Centinela, ¿cuánto falta para que amanezca?»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["El centinela responde:","«Ya viene la mañana, pero también la noche.","Si quieren preguntar, pregunten;","si quieren volver, vuelvan»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Profecía contra Arabia"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Profecía contra Arabia:","Caravanas de Dedán,","acampadas en los bosques de Arabia:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["salgan al encuentro del sediento","y ofrézcanle agua.","Habitantes de la tierra de Temá,","ofrezcan alimento a los fugitivos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["porque huyen de la espada,","de la espada desenvainada,","del arco tenso","y del fragor de la batalla."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Porque así me dijo el Señor: «Dentro de un año, contado como lo cuenta un jornalero, toda la magnificencia de Cedar llegará a su fin."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Pocos serán los arqueros, los guerreros de Cedar, que sobrevivan». Lo ha dicho el Señor, el Dios de Israel."],"rlw_lines":[]}]}}