    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La gloria, Señor, no es para nosotros;",
          "no es para nosotros, sino para tu nombre,",
          "por causa de tu gran amor y tu fidelidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Por qué tienen que decirnos las naciones:",
          "«Dónde está su Dios»?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Nuestro Dios está en los cielos",
          "y puede hacer todo cuanto quiere."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero sus ídolos son de plata y oro,",
          "producto de manos humanas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tienen boca, pero no pueden hablar;",
          "ojos, pero no pueden ver."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tienen oídos, pero no pueden oír;",
          "nariz, pero no pueden oler."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tienen manos, pero no pueden palpar;",
          "pies, pero no pueden andar.",
          "Ni un solo sonido emite su garganta."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Semejantes a ellos son sus hacedores",
          "y todos los que confían en ellos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pueblo de Israel, confía en el Señor;",
          "él es tu ayuda y tu escudo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Descendientes de Aarón, confíen en el Señor;",
          "él es su ayuda y su escudo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Los que temen al Señor, confíen en él;",
          "él es su ayuda y su escudo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El Señor nos recuerda y nos bendice:",
          "bendice a su pueblo Israel,",
          "bendice a la familia de Aarón,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "bendice a los que temen al Señor,",
          "bendice a grandes y pequeños."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Que el Señor multiplique la descendencia",
          "de ustedes y de sus hijos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Que reciban bendiciones del Señor,",
          "él hizo el cielo y la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los cielos pertenecen al Señor,",
          "pero a la humanidad le ha dado la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los muertos no alaban al Señor,",
          "ninguno de los que bajan al silencio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Somos nosotros los que alabamos al Señor",
          "desde ahora y para siempre.",
          "¡Aleluya!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
