    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico de los peregrinos. De David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Yo me alegré con los que me dijeron:",
          "«Vamos a la casa del Señor»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Jerusalén, ya nuestros pies",
          "se han plantado ante tus portones!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Jerusalén, ciudad edificada",
          "para que en ella todos se congreguen!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A ella suben las tribus,",
          "las tribus del Señor,",
          "para alabar su nombre",
          "conforme al mandato que recibió Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Allí están los tribunales de justicia,",
          "los tribunales de la casa de David."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pidan por la paz de Jerusalén:",
          "«Que vivan en paz los que te aman."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que haya paz dentro de tus murallas,",
          "seguridad en tus fortalezas»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "En favor de mis hermanos y amigos, diré:",
          "«¡Que la paz sea contigo!»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por la casa del Señor nuestro Dios",
          "procuraré tu bienestar."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
