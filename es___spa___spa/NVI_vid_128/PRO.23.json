    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "7"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cuando te sientes a comer con un gobernante,",
          "fíjate bien en lo que tienes ante ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Si eres dado a la glotonería,",
          "domina tu apetito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No codicies sus manjares,",
          "pues tal comida no es más que un engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "8"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No te afanes acumulando riquezas;",
          "no te obsesiones con ellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Acaso has podido verlas? ¡No existen!",
          "Es como si les salieran alas,",
          "pues se van volando como las águilas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "9"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No te sientes a la mesa de un tacaño",
          "ni codicies sus manjares,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "pues él solo piensa en los gastos.",
          "«Come y bebe», te dirá,",
          "pero no te lo dirá de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Acabarás vomitando lo que hayas comido",
          "y tus cumplidos no habrán servido de nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "10"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A oídos del necio jamás dirijas palabra,",
          "pues se burlará de tus sabios consejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "11"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No cambies de lugar los linderos antiguos",
          "ni invadas la propiedad de los huérfanos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "porque su Redentor es muy poderoso",
          "y contra ti defenderá su causa."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "12"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Trae disciplina a tu corazón",
          "y conocimiento a tus oídos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "13"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "No dejes de disciplinar al joven;",
          "si lo castigas con vara, no se morirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Castígalo con vara",
          "y así lo librarás de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "14"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Hijo mío, si tu corazón es sabio,",
          "también mi corazón se regocijará;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "en lo íntimo de mi ser me alegraré",
          "cuando tus labios hablen con rectitud."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "15"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No envidies en tu corazón a los pecadores;",
          "más bien, muéstrate siempre celoso en el temor del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cuentas con una esperanza futura,",
          "la cual no será destruida."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "16"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Hijo mío, presta atención y sé sabio;",
          "mantén tu corazón en lo que es correcto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No te juntes con los que beben mucho vino",
          "ni con los que se hartan de carne,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "pues borrachos y glotones, por su indolencia,",
          "acaban harapientos y en la pobreza."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "17"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Escucha a tu padre, que te engendró,",
          "y no desprecies a tu madre cuando sea anciana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Adquiere la verdad y la sabiduría,",
          "la disciplina y el discernimiento,",
          "¡y no los vendas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "El padre del justo experimenta gran regocijo;",
          "quien tiene un hijo sabio se deleita en él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "¡Que se alegren tu padre y tu madre!",
          "¡Que se regocije la que te dio la vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "18"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Dame, hijo mío, tu atención",
          "y no pierdas de vista mi ejemplo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Porque fosa profunda es la prostituta,",
          "y estrecho pozo, la mujer ajena."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Se pone al acecho, como un bandido,",
          "y multiplica la infidelidad de los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "19"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¿De quién son los lamentos? ¿De quién los pesares?",
          "¿De quién son los pleitos? ¿De quién las quejas?",
          "¿De quién son las heridas gratuitas?",
          "¿De quién los ojos morados?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "¡Del que no suelta la botella de vino",
          "ni deja de probar licores!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "No te fijes en lo rojo que es el vino,",
          "ni en cómo brilla en la copa,",
          "ni en la suavidad con que se desliza;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "porque acaba mordiendo como serpiente",
          "y envenenando como víbora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Tus ojos verán alucinaciones",
          "y tu mente imaginará perversidades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Te parecerá estar durmiendo en alta mar,",
          "acostado sobre el mástil mayor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Y dirás: «Me han herido, pero no me duele.",
          "Me han golpeado, pero no lo siento.",
          "¿Cuándo despertaré de este sueño",
          "para ir a buscar otro trago?»."
        ],
        "rlw_lines": []
      }
    ]
  },
