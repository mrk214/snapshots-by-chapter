    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Sígase la tonada de «No destruyas». Mictam de David, cuando David había huido de Saúl y estaba en una cueva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ten piedad de mí, oh Dios;",
          "ten piedad de mí, pues en ti me refugio.",
          "A la sombra de tus alas me refugiaré,",
          "hasta que haya pasado el peligro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Clamo al Dios Altísimo,",
          "al Dios que me brinda su apoyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Desde el cielo me envía la salvación",
          "y reprende a mis perseguidores."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Dios me envía su gran amor y su verdad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Me encuentro en medio de leones,",
          "rodeado de gente rapaz.",
          "Sus dientes son lanzas y flechas;",
          "su lengua, una espada afilada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Sé exaltado, oh Dios, sobre los cielos!",
          "¡Alza tu gloria sobre toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tendieron una red en mi camino",
          "y mi ánimo quedó por los suelos.",
          "En mi senda cavaron una fosa,",
          "pero ellos mismos cayeron en ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Firme está, oh Dios, mi corazón;",
          "firme está mi corazón.",
          "¡Voy a cantarte y entonarte salmos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Despierta, alma mía!",
          "¡Despierten, lira y arpa!",
          "¡Haré despertar al nuevo día!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Te alabaré, Señor, entre los pueblos;",
          "te cantaré salmos entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pues tu gran amor se eleva hasta los cielos",
          "y tu verdad llega hasta las nubes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Sé exaltado, oh Dios, sobre los cielos!",
          "¡Alza tu gloria sobre toda la tierra!"
        ],
        "rlw_lines": []
      }
    ]
