    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico para la dedicación de la Casa. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Te exaltaré, Señor, porque me levantaste,",
          "porque no dejaste que mis enemigos se burlaran de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Señor mi Dios, te pedí ayuda",
          "y me sanaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tú, Señor, me libraste de los dominios de la muerte;",
          "me hiciste revivir de entre los muertos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Canten al Señor, ustedes sus fieles;",
          "alaben su santo nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque solo un instante dura su enojo,",
          "pero su buena voluntad, toda una vida.",
          "Si por la noche hay llanto,",
          "por la mañana habrá gritos de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cuando me sentí seguro, exclamé:",
          "«Jamás caeré»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tú, Señor, en tu buena voluntad,",
          "me exaltaste como monte poderoso;",
          "pero cuando escondiste tu rostro,",
          "yo quedé angustiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A ti clamo, Señor Soberano;",
          "a ti me vuelvo suplicante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Qué ganas tú con que yo muera,",
          "con que descienda yo al sepulcro?",
          "¿Acaso el polvo te alabará",
          "o proclamará tu verdad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Oye, Señor; compadécete de mí.",
          "¡Sé tú, Señor, mi ayuda!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Convertiste mi lamento en danza;",
          "me quitaste la ropa de luto",
          "y me vestiste de alegría,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "para que te cante y te glorifique",
          "y no me quede callado.",
          "¡Señor mi Dios, siempre te daré gracias!"
        ],
        "rlw_lines": []
      }
    ]
  },
