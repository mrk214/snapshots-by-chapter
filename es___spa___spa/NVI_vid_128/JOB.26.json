    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Interrupción de Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Pero Job intervino:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¡Tú sí que ayudas al débil!",
          "¡Tú sí que salvas al que no tiene fuerza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Qué consejos sabes dar al ignorante!",
          "¡Qué gran discernimiento has demostrado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Quién te ayudó a pronunciar tal discurso?",
          "¿Qué espíritu ha hablado por tu boca?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Un estremecimiento invade a los muertos,",
          "a los que habitan debajo de las aguas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ante Dios, los dominios de la muerte quedan al descubierto;",
          "nada hay que oculte el abismo destructor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios extiende el cielo del norte sobre el vacío;",
          "sobre la nada tiene suspendida la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "En sus nubes envuelve las aguas,",
          "pero las nubes no se revientan con su peso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Cubre la faz de la luna llena",
          "al extender sobre ella sus nubes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dibuja el horizonte sobre la superficie de las aguas",
          "para dividir la luz de las tinieblas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Aterrados por su reprensión,",
          "tiemblan los pilares de los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Con su poder Dios agita el mar;",
          "con su sabiduría descuartizó a Rahab."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Un soplo suyo despeja los cielos;",
          "con su mano ensartó a la serpiente escurridiza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡Y esto es solo una muestra de sus obras,",
          "un murmullo que logramos escuchar!",
          "¿Quién podrá comprender su trueno poderoso?»."
        ],
        "rlw_lines": []
      }
    ]
  },
