    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, Dios de las venganzas;",
          "Dios de las venganzas, ¡resplandece!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Levántate, Juez de la tierra,",
          "y dales su merecido a los soberbios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Hasta cuándo, Señor, hasta cuándo",
          "habrán de ufanarse los malvados?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todos esos malhechores son unos fanfarrones;",
          "a borbotones escupen su arrogancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A tu pueblo, Señor, lo pisotean;",
          "oprimen tu herencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Matan a las viudas y a los extranjeros;",
          "a los huérfanos los asesinan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Y hasta dicen: «El Señor no ve;",
          "el Dios de Jacob no se da cuenta»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Entiendan esto, gente necia;",
          "¿cuándo, insensatos, lo comprenderán?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Acaso no oirá el que nos hizo los oídos",
          "ni podrá ver el que nos formó los ojos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Y no habrá de castigar el que corrige a las naciones",
          "e imparte conocimiento a todo ser humano?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El Señor conoce los pensamientos humanos,",
          "y sabe que son vanidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Dichoso aquel a quien tú, Señor, corriges;",
          "aquel a quien instruyes en tu Ley,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "para que enfrente tranquilo los días malos,",
          "mientras al impío se le cava una fosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El Señor no rechazará a su pueblo;",
          "no dejará a su herencia en el abandono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El juicio volverá a basarse en la justicia",
          "y todos los de corazón sincero la seguirán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¿Quién se levantará a defenderme de los malvados?",
          "¿Quién se pondrá de mi parte contra los malhechores?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Si el Señor no me hubiera brindado su ayuda,",
          "muy pronto me habría quedado en mortal silencio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "No bien decía: «Mis pies resbalan»,",
          "cuando ya tu gran amor, Señor, venía en mi ayuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Cuando en mí la angustia iba en aumento,",
          "tu consuelo llenaba mi alma de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Te asociarías con reyes corruptos",
          "que por decreto fraguan la maldad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "que conspiran contra la vida de los justos",
          "y condenan a muerte al inocente?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Pero el Señor es mi protector,",
          "es mi Dios y la Roca en que me refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Él les hará pagar por sus pecados",
          "y los destruirá por su maldad;",
          "el Señor nuestro Dios los destruirá."
        ],
        "rlw_lines": []
      }
    ]
  },
