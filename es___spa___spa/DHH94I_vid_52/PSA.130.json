    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confianza en el Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1a (1a) Cántico de las subidas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Desde el fondo del abismo",
          "clamo a ti, Señor:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Escucha, Señor, mi voz!,",
          "¡atiendan tus oídos mi grito suplicante!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Señor, Señor,",
          "si tuvieras en cuenta la maldad,",
          "¿quién podría mantenerse en pie?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero en ti encontramos perdón,",
          "para que te honremos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Con toda mi alma espero al Señor,",
          "y confío en su palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Yo espero al Señor",
          "más que los centinelas a la mañana.",
          "Así como los centinelas esperan a la mañana,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "espera tú, Israel, al Señor,",
          "pues en él hay amor y completa libertad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Él librará a Israel de toda su maldad!"
        ],
        "rlw_lines": []
      }
    ]
  },
