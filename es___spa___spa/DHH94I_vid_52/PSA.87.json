    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza a la ciudad de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1a (1a) Salmo y cántico de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Los cimientos de la ciudad de Dios",
          "están sobre los montes santos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El Señor ama las puertas de Sión",
          "más que a todas las casas de Jacob."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ciudad de Dios,",
          "qué cosas tan hermosas se dicen de ti:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«Entre los pueblos que me conocen",
          "puedo nombrar a Egipto y Babilonia,",
          "Filistea, Tiro y Etiopía;",
          "todos ellos nacieron en ti.»"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "De la ciudad de Sión dirán:",
          "«Este y aquel nacieron en ella.»",
          "El Altísimo mismo la ha afirmado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El Señor escribe en el libro",
          "donde constan los nombres de los pueblos:",
          "«Este nació en ella.»"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Y los que cantan y los que bailan dicen:",
          "«Mi hogar está en ti.»"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
