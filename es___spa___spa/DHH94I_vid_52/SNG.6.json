    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿A dónde se ha ido tu amado,",
          "hermosa entre las hermosas?",
          "¿A dónde se ha dirigido?",
          "¡Iremos contigo a buscarlo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ella"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi amado ha ido a su jardín,",
          "a su jardín perfumado,",
          "a apacentar su rebaño",
          "y cortar las rosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Yo soy de mi amado, y él es mío.",
          "Él apacienta sus rebaños entre las rosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Quinto canto"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Él"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tú, amor mío,",
          "eres hermosa y encantadora",
          "como las ciudades de Tirsá y Jerusalén;",
          "irresistible como un ejército en marcha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Deja ya de mirarme,",
          "pues tus ojos me han vencido!",
          "Tus cabellos son como cabritos",
          "que retozan por los montes de Galaad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tus dientes, todos perfectos,",
          "son cual rebaño de ovejas",
          "recién salidas del baño",
          "y listas para la trasquila."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tus mejillas son dos gajos de granada",
          "escondidos tras tu velo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sesenta son las reinas,",
          "ochenta las concubinas",
          "y muchísimas las doncellas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "pero mi palomita virginal es una sola;",
          "una sola es la hija preferida",
          "de la mujer que la dio a luz.",
          "Al verla, las jóvenes la felicitan;",
          "reinas y concubinas la alaban."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Quién es esta que se asoma",
          "como el sol en la mañana?",
          "Es hermosa como la luna,",
          "radiante como el sol,",
          "¡irresistible como un ejército en marcha!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ella"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Fui al bosque de los nogales",
          "a admirar el verdor en el arroyo;",
          "quería ver los brotes de los viñedos",
          "y las flores de los granados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Después ya no supe qué pasó",
          "hasta que me vi en un carro junto a mi príncipe."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (7.1) ¡Regresa, Sulamita, regresa!",
          "¡Regresa, queremos verte!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ella"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Y qué quieren ver de la Sulamita?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Una danza, como en los campamentos!"
        ],
        "rlw_lines": []
      }
    ]
  },
