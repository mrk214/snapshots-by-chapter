    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración ante el peligro"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1a (1a) Cántico de las subidas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Cuando estoy angustiado, llamo al Señor,",
          "y él me responde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Señor, líbrame de los labios mentirosos",
          "y de la lengua embustera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Qué más puedes recibir, lengua embustera?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Flechas puntiagudas de guerrero!",
          "¡Ardientes brasas de retama!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Pobre de mí, que vivo como extranjero en Mésec,",
          "que he acampado entre las tiendas de Quedar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Demasiado he vivido entre los que odian la paz;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡cuando yo hablo de paz, ellos hablan de guerra!"
        ],
        "rlw_lines": []
      }
    ]
  },
