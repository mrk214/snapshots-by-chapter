    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, el vencedor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1 (1) Del maestro de coro, con instrumentos de cuerda. Salmo y cántico de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios es conocido en Judá;",
          "su nombre es famoso en Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Su templo está sobre el monte Sión,",
          "en Jerusalén;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) allí rompió las armas de guerra:",
          "escudos, espadas, arcos y flechas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) ¡Tú eres glorioso, oh Dios!",
          "¡Eres más grandioso que las montañas eternas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Los más valientes fueron despojados;",
          "los más fuertes nada pudieron hacer;",
          "¡durmieron su último sueño!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Ni aun moverse pueden el carro y el caballo",
          "cuando tú, Dios de Jacob, los amenazas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) ¡Tú eres terrible!",
          "¿Quién puede estar en pie delante de ti",
          "cuando se enciende tu furor?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Desde el cielo das a conocer tu juicio;",
          "la tierra tiene miedo y se queda quieta,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) oh Dios,",
          "cuando te levantas para hacer justicia",
          "y salvar a todos los oprimidos de este mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) El enojo del hombre se convierte en tu alabanza;",
          "¡aun su más mínimo enojo se convierte en tu corona!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Hagan ustedes promesas al Señor, su Dios,",
          "pero cúmplanselas.",
          "Ustedes, que rodean al que es digno de temor,",
          "¡tráiganle ofrendas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Pues él quita la vida a los gobernantes",
          "y causa temor a los reyes del mundo."
        ],
        "rlw_lines": []
      }
    ]
  },
