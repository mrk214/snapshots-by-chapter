    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Personas que merecen alabanza"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hay tres cosas que me gustan",
          "y que agradan a Dios y a los hombres:",
          "la concordia entre los hermanos, la amistad entre los vecinos",
          "y la armonía entre los esposos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Y hay tres clases de personas que detesto,",
          "cuyo modo de vivir me molesta mucho:",
          "el pobre orgulloso, el rico tacaño",
          "y el viejo mujeriego y tonto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Si no buscas la sabiduría siendo joven,",
          "¿cómo la vas a encontrar cuando ya seas viejo?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Qué bien queda a las canas el juzgar,",
          "y a los ancianos el dar buenos consejos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Qué bien queda a los ancianos el ser sabios,",
          "y a los respetables dar consejos acertados!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "La experiencia es la corona de los viejos,",
          "y su mayor gloria es honrar a Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Hay nueve y hasta diez personas",
          "que declaro dichosas:",
          "¡Dichoso el hombre que se alegra con sus hijos,",
          "y el que vive hasta ver la caída de sus enemigos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Dichoso el hombre casado con mujer sensata,",
          "y el que no ara con yunta formada por buey y burro!",
          "¡Dichoso el que no peca con la lengua,",
          "y el que no sirve a uno menos respetable que él!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Dichoso el que encuentra un amigo,",
          "y el que no habla a oídos sordos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Grandemente dichoso es el que encuentra la sabiduría,",
          "pero nunca comparable a quien respeta al Señor!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El respeto al Señor está por encima de todo;",
          "nadie puede compararse a quien lo tiene."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La mala y la buena mujer"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡No hay peor herida que la del corazón,",
          "ni peor maldad que la de la mujer!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡No hay peor sufrimiento que el causado por el odio,",
          "ni peor venganza que la venganza de rivales!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡No hay veneno como el de la serpiente,",
          "ni enojo como el de la mujer!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Prefiero vivir con un león o un dragón,",
          "que vivir con una mujer malvada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "La maldad de la mujer hace que el marido",
          "ponga peor cara que un oso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cuando él se encuentra entre sus amigos,",
          "suspira sin querer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Cualquier maldad es poca, comparada con la de la mujer;",
          "ese será el castigo para el pecador."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Como cuesta arenosa para los pies de un viejo",
          "es la mujer charlatana para un hombre tranquilo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No te dejes seducir por la belleza de una mujer",
          "ni codicies lo que posee,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "porque es muy feo y vergonzoso",
          "que la mujer mantenga a su marido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Manos débiles, rodillas temblorosas:",
          "así es el hombre a quien su mujer no hace feliz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Por una mujer comenzó el pecado,",
          "y por ella todos morimos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "No des salida al agua de un río,",
          "ni libertad a una mujer malvada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Si no se somete a ti,",
          "apártala de tu compañía."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
