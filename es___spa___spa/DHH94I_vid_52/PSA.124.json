    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, Salvador de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1a (1a) Cántico de las subidas, de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Si el Señor no hubiera estado de nuestra parte",
          "—que lo diga ahora Israel—,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "si el Señor no hubiera estado de nuestra parte",
          "cuando los hombres se levantaron para atacarnos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "nos habrían tragado vivos",
          "al encenderse su furor contra nosotros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Entonces las aguas nos habrían arrastrado;",
          "¡un río habría pasado sobre nosotros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Entonces las aguas turbulentas",
          "habrían pasado sobre nosotros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Bendito sea el Señor,",
          "que no dejó que nos despedazaran con sus dientes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nos hemos escapado de la trampa",
          "como un ave que escapa del cazador;",
          "la trampa se rompió, y nosotros escapamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "La ayuda nos viene del Señor,",
          "creador del cielo y de la tierra."
        ],
        "rlw_lines": []
      }
    ]
  },
