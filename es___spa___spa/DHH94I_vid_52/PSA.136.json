    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Amor eterno de Dios a Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Den gracias al Señor, porque él es bueno,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Den gracias al Dios de dioses,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Den gracias al Señor de señores,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Al único que hace grandes maravillas,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Al que hizo los cielos con sabiduría,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Al que extendió la tierra sobre las aguas,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Al que hizo el sol y la luna,",
          "porque su amor es eterno:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "el sol, para alumbrar de día,",
          "porque su amor es eterno;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "la luna y las estrellas, para alumbrar de noche,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Al que hirió al primer hijo de toda familia egipcia,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Al que sacó de Egipto a los israelitas,",
          "porque su amor es eterno;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "extendiendo su brazo con gran poder,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Al que partió en dos el Mar Rojo,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Al que hizo pasar a Israel por en medio del mar,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Al que hundió en el Mar Rojo al Faraón y su ejército,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Al que llevó a su pueblo por el desierto,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Al que hirió de muerte a grandes reyes,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Al que a reyes poderosos quitó la vida,",
          "porque su amor es eterno:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "a Sihón, el rey amorreo,",
          "porque su amor es eterno;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "y a Og, el rey de Basán,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Al que repartió la tierra de esos reyes,",
          "porque su amor es eterno,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "y la dio como herencia a su siervo Israel,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Al que nos recuerda cuando estamos abatidos,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Al que nos libra de nuestros enemigos,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Al que da de comer a hombres y animales,",
          "porque su amor es eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡Den gracias al Dios del cielo,",
          "porque su amor es eterno!"
        ],
        "rlw_lines": []
