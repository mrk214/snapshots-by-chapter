    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanzas a Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1a (1a) Cántico de las subidas, de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) ¡Qué alegría cuando me dicen:",
          "«Vamos al templo del Señor»!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Jerusalén,",
          "¡ya estamos dentro de tus puertas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Jerusalén, ciudad construida",
          "para que en ella se reúna la comunidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A ella vienen las tribus del Señor",
          "para alabar su nombre,",
          "como se le ordenó a Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "En ella están los tribunales de justicia,",
          "los tribunales de la casa real de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Digan ustedes de corazón:",
          "«Que haya paz en ti, Jerusalén;",
          "que vivan tranquilos los que te aman."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que haya paz en tus murallas;",
          "que haya seguridad en tus palacios.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Y ahora, por mis hermanos y amigos diré:",
          "«Que haya paz en ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por el templo del Señor nuestro Dios,",
          "procuraré tu bien.»"
        ],
        "rlw_lines": []
      }
    ]
  },
