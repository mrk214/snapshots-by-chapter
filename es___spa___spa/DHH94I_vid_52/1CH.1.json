    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "I. DESDE ADÁN HASTA DAVID"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "(1—9)"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Adán"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Adán, Set, Enós,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cainán, Mahalalel, Jéred,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Henoc, Matusalén, Lámec,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Noé."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Noé"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Hijos de Noé: Sem, Cam y Jafet."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Hijos de Jafet: Gómer, Magog, Madai, Javán, Tubal, Mésec y Tirás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Hijos de Gómer: Asquenaz, Rifat y Togarmá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Hijos de Javán: Elisá, Tarsis, Quitim y Rodanim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Hijos de Cam: Cus, Misraim, Fut y Canaán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Hijos de Cus: Sebá, Havilá, Sabtá, Raamá y Sabtecá. Hijos de Raamá: Sebá y Dedán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cus fue el padre de Nimrod, el primer hombre poderoso de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "De Misraim descienden los ludeos, los anameos, los lehabitas, los naftuhítas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "los patruseos, los casluhítas y los caftoritas, de quienes descienden los filisteos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Canaán fue padre de Sidón, su primer hijo, y de Het."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "De Canaán descienden los jebuseos, amorreos, gergeseos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "heveos, araceos, sineos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "arvadeos, semareos y hamateos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Hijos de Sem: Elam, Asur, Arfaxad, Lud y Aram. Los hijos de Aram fueron Us, Hul, Guéter y Mas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Arfaxad fue el padre de Sélah, y Sélah fue el padre de Éber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Éber tuvo dos hijos: el primero se llamaba Péleg, porque en su tiempo la gente de la tierra se dividió. El hermano de Péleg se llamaba Joctán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Joctán fue el padre de Almodad, Sélef, Hasar-mávet, Jérah,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Hadoram, Uzal, Diclá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Obal, Abimael, Sebá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ofir, Havilá y Jobab. Todos estos fueron hijos de Joctán."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Sem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Sem, Arfaxad, Sélah,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Éber, Péleg, Reú,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Serug, Nahor, Térah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "y Abram, que es Abraham."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Ismael y de Queturá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Hijos de Abraham: Isaac e Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Sus descendientes fueron: Nebaiot, hijo mayor de Ismael, Quedar, Adbeel, Mibsam,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Mismá, Dumá, Masá, Hadad, Temá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Jetur, Nafís y Quedmá. Estos fueron los hijos de Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Hijos de Queturá, concubina de Abraham: Zimrán, Jocsán, Medán, Madián, Isbac y Súah. Hijos de Jocsán: Sebá y Dedán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Hijos de Madián: Efá, Éfer, Hanoc, Abidá y Eldaá. Todos estos fueron descendientes de Queturá."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Esaú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Abraham fue el padre de Isaac. Hijos de Isaac: Esaú e Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Hijos de Esaú: Elifaz, Reuel, Jeús, Jaalam y Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Hijos de Elifaz: Temán, Omar, Sefó, Gatam y Quenaz; de Timná tuvo a Amalec."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Hijos de Reuel: Náhat, Zérah, Samá y Mizá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Hijos de Seír: Lotán, Sobal, Sibón, Aná, Disón, Éser y Disán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Hijos de Lotán: Horí y Hemam. Timná era hermana de Lotán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Hijos de Sobal: Alván, Manáhat, Ebal, Sefó y Onam. Hijos de Sibón: Aiá y Aná."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Aná fue padre de Disón. Hijos de Disón: Hemdán, Esbán, Itrán y Querán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Hijos de Éser: Bilhán, Zaaván y Jaacán. Hijos de Disán: Us y Arán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Estos fueron los reyes que gobernaron en Edom antes que los israelitas tuvieran rey: Bela, hijo de Beor; su ciudad se llamaba Dinhaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Cuando Bela murió, gobernó en su lugar Jobab, el hijo de Zérah, que era del pueblo de Bosrá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Cuando Jobab murió, gobernó en su lugar Husam, que era de la región de Temán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Cuando Husam murió, gobernó en su lugar Hadad, el hijo de Bedad, que derrotó a Madián en el campo de Moab; y su ciudad se llamaba Avit."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Cuando murió Hadad, gobernó en su lugar Samlá, que era del pueblo de Masrecá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Cuando Samlá murió, gobernó en su lugar Saúl, que era de Rehobot, el pueblo que está junto al río."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Cuando Saúl murió, gobernó en su lugar Baal-hanán, que era hijo de Acbor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Y cuando murió Baal-hanán, gobernó en su lugar Hadad; y su ciudad se llamaba Pau. La esposa de Hadad se llamaba Mehetabel y era hija de Matred y nieta de Mezaab."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Después de la muerte de Hadad, los jefes de Edom fueron: Timná, Alvá, Jetet,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Oholibamá, Elá, Pinón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Quenaz, Temán, Mibsar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Magdiel e Iram. Estos fueron los jefes de Edom."
        ],
        "rlw_lines": []
      }
    ]
  },
