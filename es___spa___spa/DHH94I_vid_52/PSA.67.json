        "lines": [
          "¡Que te alaben todos los pueblos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1 (1) Del maestro de coro, con instrumentos de cuerda. Salmo y cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Que el Señor tenga compasión y nos bendiga,",
          "que nos mire con buenos ojos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) para que todas las naciones de la tierra",
          "conozcan su voluntad y salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Oh Dios,",
          "que te alaben los pueblos;",
          "¡que todos los pueblos te alaben!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Que las naciones griten de alegría,",
          "pues tú gobiernas los pueblos con justicia;",
          "¡tú diriges las naciones del mundo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Oh Dios,",
          "que te alaben los pueblos;",
          "¡que todos los pueblos te alaben!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) La tierra ha dado su fruto;",
          "¡nuestro Dios nos ha bendecido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) ¡Que Dios nos bendiga!",
          "¡Que le rinda honor el mundo entero!"
        ],
        "rlw_lines": []
      }
