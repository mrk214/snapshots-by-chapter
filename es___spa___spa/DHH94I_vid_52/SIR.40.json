    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Penalidades humanas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios ha destinado grandes penas",
          "y duros trabajos a los hombres,",
          "desde el día en que salen del seno de su madre",
          "hasta el día en que vuelven a la madre de todos los vivientes:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "preocupaciones, temor del corazón",
          "y la angustiada espera del día de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Desde el que se sienta en elevado trono",
          "hasta el que está echado entre el polvo y la ceniza,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "desde el que lleva diadema y corona",
          "hasta el que se envuelve en capa de cuero,",
          "¡cuánta aflicción, envidia, angustia, miedo,",
          "temor a la muerte, furia y peleas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aun cuando se acuesta a descansar,",
          "mientras duerme, lo agitan las mismas inquietudes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Trata en vano de descansar por un momento,",
          "pero se agita entre pesadillas,",
          "lleno de miedo por sus sueños,",
          "como queriendo escapar de uno que lo persigue."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuando ya se pone a salvo, se despierta,",
          "y se calma al ver que no era nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Esto vale para todos, hombres y animales,",
          "pero siete veces más para los pecadores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Peste, homicidios, fiebre, guerras,",
          "destrucción, ruina, hambres y muerte,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "son los males creados para los malvados,",
          "para terminar con ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Todo lo que de la tierra viene, a la tierra vuelve;",
          "y al cielo vuelve lo que del cielo vino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Todo soborno e injusticia desaparecerán,",
          "pero la fidelidad durará por siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La riqueza mal habida es como torrente que se seca",
          "o como arroyo que se hincha entre relámpagos y truenos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "cuando crece, hace rodar las rocas,",
          "pero en un momento se acaba por completo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los violentos no podrán prosperar;",
          "el impío echa raíces en el filo de una roca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Son como los juncos a la orilla de un torrente,",
          "que se secan antes que cualquiera de las hierbas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pero la bondad estará firme por siempre,",
          "y la rectitud se mantendrá siempre estable."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lo mejor de todo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El vino y los licores son sabrosos,",
          "pero aún mejor es encontrar un tesoro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Los hijos y la fundación de una ciudad dan fama duradera,",
          "pero aún mejor es hallar la sabiduría.",
          "Ganado y siembras hacen próspero a un hombre,",
          "pero aún mejor es una esposa afectuosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El vino y los licores alegran el corazón,",
          "pero aún mejor es el amor de los enamorados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "La flauta y el arpa acompañan bien el canto,",
          "pero aún mejor es una lengua sincera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La belleza y la gracia son un placer para los ojos,",
          "pero aún mejor es un campo bien verde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Amigo y compañero son guías oportunos,",
          "pero aún mejor es una esposa inteligente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Hermano y protector salvan en tiempo de calamidad,",
          "pero aún mejor salva la honradez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Oro y plata dan firmeza al hombre,",
          "pero aún mayor firmeza la da un buen consejo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Riqueza y poder alegran el corazón,",
          "pero aún mejor es respetar a Dios.",
          "Al que respeta a Dios no le falta nada,",
          "no necesita buscar más ayuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El respeto a Dios es como jardín florido,",
          "todo cubierto de esplendor."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "No vivas a costa de otros"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Hijo mío, no vivas de limosna;",
          "más vale morir que mendigar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "El que vive pendiente de la mesa ajena",
          "lleva una vida que no merece tal nombre.",
          "Comer a costa de otros es deshonroso;",
          "al sensato le repugna hacerlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Al goloso le encanta andar pidiendo,",
          "pero por dentro siente un fuego que le quema."
        ],
        "rlw_lines": []
      }
    ]
  },
