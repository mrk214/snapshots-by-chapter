ines":["Tú eres mi refugio:","me proteges del peligro,","me rodeas de gritos de liberación."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["El Señor dice:","«Mis ojos están puestos en ti.","Yo te daré instrucciones,","te daré consejos,","te enseñaré el camino que debes seguir."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["No seas como el mulo o el caballo,","que no pueden entender","y hay que detener su brío","con el freno y con la rienda,","pues de otra manera no se acercan a ti.»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Los malvados tendrán muchos dolores,","pero el amor del Señor envuelve","a los que en él confían."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Alégrense en el Señor,","hombres buenos y honrados;","¡alégrense y griten de alegría!"],"rlw_lines":[]}]}}