    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ven pronto en mi ayuda"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1 (1) Del maestro de coro. De David, para hacer recordar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío, ¡ven a librarme!",
          "Señor, ¡ven pronto en mi ayuda!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) ¡Que sean puestos en ridículo",
          "los que tratan de matarme!",
          "¡Que huyan en forma vergonzosa",
          "los que quieren hacerme daño!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) ¡Que huyan avergonzados",
          "los que se burlan de mí!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Pero que todos los que te buscan",
          "se llenen de alegría;",
          "que los que desean tu salvación",
          "digan siempre: «¡Dios es grande!»"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Y a mí, que estoy pobre y afligido,",
          "Dios mío, ¡ven pronto a ayudarme!",
          "Tú eres quien me ayuda y me liberta;",
          "¡no te tardes, Señor!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
