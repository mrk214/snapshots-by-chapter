    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1,
          2
        ],
        "lines": [
          "Tú, que querías entablarme juicio",
          "a mí, al Todopoderoso,",
          "¿insistes todavía en responder?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3,
          4
        ],
        "lines": [
          "¿Qué puedo responder yo, que soy tan poca cosa?",
          "Prefiero guardar silencio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ya he hablado una y otra vez,",
          "y no tengo nada que añadir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios vuelve a interpelar a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Volvió el Señor a hablarle a Job de en medio de la tempestad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Muéstrame ahora tu valentía,",
          "y respóndeme a estas preguntas:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¿Pretendes declararme injusto y culpable,",
          "a fin de que tú aparezcas inocente?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Acaso eres tan fuerte como yo?",
          "¿Es tu voz de trueno, como la mía?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Revístete entonces de grandeza y majestad,",
          "cúbrete de gloria y esplendor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mira a todos los orgullosos:",
          "da rienda suelta a tu furor y humíllalos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sí, derríbalos con tu mirada,",
          "aplasta a los malvados donde se encuentren."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sepúltalos a todos en la tierra,",
          "enciérralos en la prisión de los muertos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Entonces yo mismo reconoceré",
          "que fue tu poder el que te dio la victoria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Fíjate en el monstruo Behemot,",
          "criatura mía igual que tú:",
          "come hierba, como los bueyes;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "mira qué fuertes son sus lomos,",
          "y qué poderosos sus músculos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Su cola es dura como el cedro,",
          "los tendones de sus patas forman nudos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Sus huesos son como tubos de bronce, como barras de hierro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Es mi obra maestra;",
          "solo yo, su creador, puedo derrotarlo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "De los montes, donde juegan las fieras,",
          "le traen hierba para que coma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Se echa debajo de los lotos,",
          "se esconde entre las cañas del pantano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Los lotos le dan sombra,",
          "los álamos del arroyo lo rodean."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Si el río crece, no se asusta;",
          "aunque el agua le llegue al hocico, está tranquilo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¿Quién es capaz de agarrarlo y sacarle los ojos,",
          "o de pasarle un lazo por la nariz?"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
