    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios merece nuestra alabanza"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Tú mereces alabanzas, Dios nuestro,",
          "y no nosotros;",
          "tú mereces alabanzas",
          "por tu amor y tu fidelidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Las otras naciones",
          "preguntan en son de burla:",
          "«¿Qué pasó con su Dios?»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Pero tú estás en el cielo,",
          "y haces todo lo que quieres!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Los ídolos de esas naciones",
          "son objetos de oro y plata;",
          "¡son hechura humana!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Y qué es lo que tienen?",
          "Una boca que no habla,",
          "y ojos que no ven;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "orejas que no oyen,",
          "y narices que no huelen;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "manos que no tocan,",
          "y pies que no andan;",
          "garganta tienen,",
          "¡pero no emiten ningún sonido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Iguales a esos ídolos",
          "son quienes los hacen",
          "y quienes confían en ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Israelitas,",
          "pongan su confianza en Dios;",
          "¡él nos ayuda y nos protege!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Sacerdotes,",
          "pongan su confianza en Dios;",
          "¡él nos ayuda y nos protege!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Y ustedes, que adoran a Dios,",
          "pongan en él su confianza;",
          "¡él nos ayuda y nos protege!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Dios se acuerda de nosotros",
          "y nos llena de bendiciones:",
          "Bendice a los israelitas,",
          "bendice a los sacerdotes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "y bendice a quienes lo adoran,",
          "sean o no gente importante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡Que Dios añada bendiciones",
          "sobre ustedes y sobre sus hijos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Que los bendiga Dios,",
          "creador del cielo y de la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los cielos son de Dios,",
          "y a nosotros nos confió la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los muertos ya han bajado",
          "al mundo del silencio",
          "y no pueden alabar a Dios;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¡nos toca a nosotros alabarlo",
          "desde ahora y para siempre!",
          "¡Alabemos a nuestro Dios!"
        ],
        "rlw_lines": []
      }
    ]
  },
