    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios es un juez justo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1,
          2
        ],
        "lines": [
          "Dios mío,",
          "tú eres el juez de la tierra;",
          "¡hazte presente,",
          "entra en acción,",
          "y castiga a los culpables!",
          "¡Dales su merecido a los orgullosos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios mío,",
          "¡basta ya de malvados,",
          "basta ya de sus burlas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todos ellos son malhechores;",
          "¡son unos habladores y orgullosos!",
          "¡Se creen la gran cosa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aplastan y afligen",
          "a tu pueblo elegido:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "matan a las viudas,",
          "asesinan a los huérfanos,",
          "masacran a los refugiados,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "y aun se atreven a decir:",
          "«El Dios de Israel",
          "no se da cuenta de nada»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Gente torpe,",
          "quiero que entiendan esto;",
          "¿cuándo van a comprenderlo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Si Dios nos dio",
          "la vista y el oído,",
          "¡de seguro él puede ver y oír!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Cómo no va a castigar",
          "el que corrige a las naciones!",
          "¡Como no va a saber",
          "el que nos instruye a todos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Bien sabe nuestro Dios",
          "las tonterías que se nos ocurren!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mi Dios,",
          "tú bendices a los que corriges,",
          "a los que instruyes en tu ley,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "para que enfrenten tranquilos",
          "los tiempos difíciles;",
          "en cambio, a los malvados",
          "se les echará en la tumba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tú, mi Dios,",
          "jamás abandonarás a tu pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los jueces volverán a ser justos,",
          "y la gente honrada los imitará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Cuando los malvados me atacaron,",
          "nadie se levantó a defenderme;",
          "¡nadie se puso de mi parte",
          "y en contra de los malhechores!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Si tú no me hubieras ayudado,",
          "muy pronto habría perdido la vida;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "pero te llamé",
          "al sentir que me caía,",
          "y tú, con mucho amor,",
          "me sostuviste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "En medio de mis angustias",
          "y grandes preocupaciones,",
          "tú me diste consuelo y alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Tú no puedes ser amigo",
          "de gobernantes corruptos,",
          "que violan la ley",
          "y hacen planes malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Esa clase de gobernantes",
          "siempre está haciendo planes",
          "contra la gente honrada,",
          "y dicta sentencia de muerte",
          "contra la gente inocente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22,
          23
        ],
        "lines": [
          "Esa gente es tan malvada",
          "que acabarás por destruirla.",
          "Pero tú, mi Dios,",
          "eres mi más alto escondite;",
          "¡eres como una roca",
          "en la que encuentro refugio!"
        ],
        "rlw_lines": []
      }
    ]
  },
