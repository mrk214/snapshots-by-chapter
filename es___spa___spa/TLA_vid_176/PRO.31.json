    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dichos del rey Lemuel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Con estas palabras el rey Lemuel fue educado por su madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Querido hijo mío,",
          "que naciste como respuesta",
          "de mis oraciones a Dios,",
          "¿qué consejos podría darte?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡No te vuelvas loco por las mujeres!,",
          "pues han llevado a la ruina",
          "a muchos reyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "»Querido Lemuel,",
          "no conviene que los reyes",
          "tomen bebidas alcohólicas,",
          "ni que se emborrachen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque en cuanto se emborrachan",
          "se olvidan de la ley",
          "y no protegen a los pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El alcohol es para",
          "los que viven amargados",
          "y ya no tienen esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Déjalos que se emborrachen",
          "y se olviden de su miseria!",
          "¡Que no se acuerden",
          "de lo mucho que sufren!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»Habla en favor de las viudas;",
          "defiende los derechos de los huérfanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Habla en favor de ellos;",
          "¡hazles justicia!",
          "¡Defiende a los pobres y humildes!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La mujer ejemplar"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Qué difícil es hallar",
          "una esposa extraordinaria!",
          "¡Hallarla es como encontrarse",
          "una joya muy valiosa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Quien se casa con ella",
          "puede darle toda su confianza;",
          "dinero nunca le faltará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A ella todo le sale bien;",
          "nunca nada le sale mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sale a comprar lana y lino,",
          "y con sus propias manos",
          "trabaja con alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Se parece a los barcos mercantes:",
          "de muy lejos trae su comida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Se levanta muy temprano,",
          "y da de comer a sus hijos",
          "y asigna tareas a sus sirvientas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Calcula el precio de un campo;",
          "con sus ganancias lo compra,",
          "planta un viñedo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "y en él trabaja",
          "de sol a sol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ella misma se asegura",
          "de que el negocio marche bien;",
          "toda la noche hay luz en su casa,",
          "pues toda la noche trabaja."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ella fabrica su propia ropa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "y siempre ayuda a los pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No le preocupa que haga frío,",
          "pues todos en su casa",
          "andan siempre bien abrigados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Toma telas de lino y de púrpura,",
          "y ella misma hace colchas y vestidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "En la ciudad y en el país",
          "su esposo es bien conocido,",
          "pues ocupa un lugar importante",
          "entre la gente de autoridad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "La ropa y los cinturones",
          "que ella misma fabrica",
          "los vende a los comerciantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Es mujer de carácter;",
          "mantiene su dignidad,",
          "y enfrenta confiada el futuro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Siempre habla con sabiduría,",
          "y enseña a sus hijos con amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Siempre está pendiente de su casa",
          "y de que todo marche bien.",
          "Cuando come pan,",
          "es porque se lo ha ganado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Sus hijos la felicitan;",
          "su esposo la alaba y le dice:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "«Mujeres buenas hay muchas,",
          "pero tú las superas a todas»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "La hermosura es engañosa,",
          "la belleza es una ilusión;",
          "¡solo merece alabanzas",
          "la mujer que obedece a Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "¡Que todo el mundo reconozca",
          "los frutos de su esfuerzo!",
          "¡Que todos en la ciudad",
          "la alaben por sus acciones!"
        ],
        "rlw_lines": []
      }
    ]
  },
