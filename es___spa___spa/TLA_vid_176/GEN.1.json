{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"GEN","name":"Génesis"},"chapter":{"chapter_usfm":"GEN.1","is_chapter":true,"previous":{"usfm":"GEN.INTRO1","human":"Génesis Introducción","canonical":false,"toc":true},"current":{"usfm":"GEN.1","human":"Génesis 1"},"next":{"usfm":"GEN.2","human":"Génesis 2","canonical":true,"toc":true},"items":[{"type":"section1","verse_numbers":[],"lines":["Principio de todas las cosas"],"rlw_lines":[]},{"type":"section2","verse_numbers":[],"lines":["(1.1—11.32)"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["La creación del mundo"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Cuando Dios comenzó a crear","el cielo y la tierra,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["la tierra no tenía forma,","ni había en ella nada","que tuviera vida.","Las aguas estaban cubiertas","por una gran oscuridad,","pero sobre la superficie del agua","se movía el espíritu de Dios."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El primer día de la creación"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Dijo entonces Dios:","«¡Quiero que haya luz!»","¡Y al instante hubo luz!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Al ver Dios la belleza de la luz,","la apartó de la oscuridad"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["y le puso por nombre «día».","A la oscuridad la llamó «noche».","Y cayó la noche,","y llegó la mañana.","Ese fue el primer día."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El segundo día de la creación"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Dijo entonces Dios:","«Quiero que haya entre las aguas","algo firme que las separe»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["¡Y al instante se hizo así!","Dios puso algo firme entre las aguas,","y la mitad de las aguas quedó abajo","y la otra mitad quedó arriba."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Al ver la belleza del firmamento,","Dios le puso por nombre «cielo».","Y cayó la noche,","y llegó la mañana.","Ese fue el segundo día."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El tercer día de la creación"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Dijo entonces Dios:","«Quiero que las aguas","que están debajo del cielo","se junten en un solo lugar,","y que aparezca lo seco».","¡Y al instante se hizo así!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Dios llamó «tierra» a lo seco,","y llamó «mar» a las aguas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Al ver Dios tal belleza, dijo:","«Quiero que haya en la tierra","árboles y plantas","que den fruto y semilla».","¡Y al instante se hizo así!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["La tierra produjo árboles y plantas;","los árboles dieron frutos,","y las plantas dieron semillas.","Mientras Dios admiraba tal belleza,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["cayó la noche,","y llegó la mañana.","Ese fue el tercer día."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El cuarto día de la creación"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Dijo entonces Dios:","«Quiero que haya en el cielo","luces que separen el día de la noche;","luces que indiquen las estaciones,","los días y los años;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["luces en el cielo azul","que iluminen la tierra».","¡Y al instante se hizo así!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Dios hizo las dos grandes luces:","el sol, para que domine en el día,","y la luna, para que domine en la noche.","También hizo las estrellas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Dios puso estas luces en el cielo","para alumbrar la tierra,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["para dominar en el día y en la noche,","y para separar la luz de la oscuridad.","Mientras Dios admiraba tal belleza,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["cayó la noche,","y llegó la mañana.","Ese fue el cuarto día."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El quinto día de la creación"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Dijo entonces Dios:","«Quiero que los mares","se llenen con seres vivos.","Quiero que las aves","vuelen sobre la tierra","y crucen el cielo azul»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Así creó Dios","los grandes monstruos marinos.","Creó todos los seres vivos","que se mueven en el agua,","y todas las aves del cielo.","Al ver Dios tal belleza,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["les dio esta bendición:","«Quiero que los peces","se reproduzcan y llenen los mares;","quiero que las aves","se multipliquen sobre la tierra»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Y cayó la noche,","y llegó la mañana.","Ese fue el quinto día."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El sexto día de la creación"],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Dijo entonces Dios:","«Quiero que haya en la tierra","toda clase de seres vivos:","animales domésticos,","animales salvajes,","reptiles e insectos».","¡Y al instante se hizo así!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Dios hizo los animales salvajes,","los animales domésticos,","los reptiles y los insectos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Al ver Dios tal belleza, dijo:","«Hagamos ahora al ser humano","tal y como somos nosotros.","Que domine a los peces del mar","y a las aves del cielo,","a todos los animales de la tierra,","y a todos los reptiles e insectos»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Fue así como Dios creó","al ser humano","tal y como es Dios.","Lo creó a su semejanza.","Creó al hombre y a la mujer,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["y les dio esta bendición:","«Quiero que se reproduzcan,","quiero que se multipliquen,","quiero que llenen la tierra","y la pongan bajo su dominio.","Que dominen a los peces del mar","y a las aves del cielo,","y a todos los seres vivos","que se arrastran por el suelo»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["También les dijo Dios:","«Hoy les entrego a ustedes","toda planta que da semilla","y todo árbol que da fruto.","Todo esto les servirá de alimento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Pero la hierba verde","será para todos los animales».","¡Y al instante se hizo así!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Mientras Dios admiraba","la gran belleza de su creación,","cayó la noche,","y llegó la mañana.","Ese fue el sexto día."],"rlw_lines":[]}]}}