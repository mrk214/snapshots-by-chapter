    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lamento por la ciudad de Tiro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios también me dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Dedica este lamento a la ciudad de Tiro por su destrucción. Dale este mensaje de parte del Dios de Israel:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“Tú, ciudad de Tiro,",
          "te creías bella y perfecta;",
          "te aprovechaste de estar junto al mar",
          "para comerciar con muchos países."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ciertamente, dominabas los mares.",
          "Tenías la belleza",
          "de un barco bien construido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu casco lo hicieron",
          "con pinos del monte Senir;",
          "tu palo mayor fue labrado",
          "en cedro del monte Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tus remos eran de roble,",
          "fina madera del monte de Basán.",
          "Las tablas de tu cubierta",
          "eran de ciprés traído de Chipre.",
          "Todas ellas estaban adornadas",
          "con incrustaciones de marfil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tus velas te servían de bandera,",
          "y eran de fino bordado egipcio.",
          "Tus toldos, de tela roja y morada,",
          "los trajeron de las costas de Elisá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "”Contabas con una tripulación experta.",
          "Tenías los mejores capitanes y marinos:",
          "gente de Tiro, Arvad y Sidón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tus daños los reparaban",
          "expertos carpinteros de Guebal.",
          "Marineros de todas partes",
          "hacían negocios en tus puertos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tu ejército estaba formado",
          "por gente de Persia, Lidia y Libia;",
          "cuando te adornaban con sus armas,",
          "hacían que te vieras muy hermosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "”Soldados de Arvad y de Gamad",
          "defendían tus murallas",
          "con la ayuda de tu ejército.",
          "Todo el tiempo vigilaban tus torres,",
          "y cuando colgaban sus escudos",
          "a lo largo de tus murallas,",
          "hacían que te vieras más hermosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "”Tú, ciudad de Tiro, eras tan rica que la gente de Tarsis venía para hacer negocios contigo. Tu mercancía la pagaban con plata, plomo, hierro y estaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "También los comerciantes de Grecia, Tubal y Mésec compraban tus mercancías, y te pagaban con esclavos y con utensilios de bronce."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "La gente de Bet-togarmá te pagaba con finos caballos para montar, y con caballos y mulas para el trabajo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "También hacías negocios con los comerciantes de Dedán y de otros puertos lejanos, los cuales te pagaban con marfil y con madera de ébano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16,
          17,
          18
        ],
        "lines": [
          "”Tus mercancías eran tan variadas, y tu riqueza tan grande, que hasta los sirios comerciaban contigo, y te pagaban con piedras preciosas y telas muy finas. También Israel y Judá te compraban mercancías, y te pagaban con su mejor trigo, y con pasteles, miel, aceite de oliva y especias aromáticas. Damasco te pagaba con vino de Helbón y con lana de Sahar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Los comerciantes de Dan y los griegos te traían de Uzal hierro forjado y especias aromáticas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "”La gente de Dedán te pagaba con sillas de montar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Los de Arabia y todos los príncipes de Quedar te pagaban con corderos, chivos y carneros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Tus clientes de Sabá y Raamá te pagaban con finos perfumes, y con oro y piedras preciosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Entre tus clientes estaban también los comerciantes de Harán, Cané, Edén, Sabá, Asiria y Media;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "ellos te vendían telas finas, mantos bordados de color púrpura, tapices de muchos colores y fuertes cuerdas trenzadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "¡Las naves de Tarsis transportaban tus mercancías!",
          "”Tú, ciudad de Tiro,",
          "parecías un barco en alta mar",
          "cuando va cargado de riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Pero tus marinos te llevaron",
          "por los mares más profundos,",
          "y allí te hizo pedazos",
          "el fuerte viento del este."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "¡Al fondo del mar se fueron",
          "tus mercancías y tus productos!",
          "El día que te hundiste,",
          "se fueron al fondo del mar",
          "todas tus riquezas,",
          "tus marineros y tus capitanes,",
          "tus carpinteros y tus comerciantes,",
          "tus soldados y tus pasajeros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "”Tus capitanes pedían ayuda,",
          "y temblaba la gente de las costas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "los marineros se lanzaron al agua,",
          "y bajaron a tierra junto con los capitanes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30,
          31
        ],
        "lines": [
          "Sus gritos eran desesperados;",
          "amargamente lloraban por ti,",
          "se pusieron ropa de luto,",
          "y de muchas otras maneras",
          "mostraron su dolor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Entonaron por ti un lamento,",
          "y exclamaron con gran tristeza:",
          "‘¡Ay, ciudad incomparable,",
          "ahora estás en el fondo del mar!’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "”Cuando bajaban de los barcos",
          "las mercancías que vendías,",
          "las naciones quedaban satisfechas;",
          "con tus riquezas y abundantes productos",
          "se enriquecían los reyes del mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Pero te hundiste en el océano;",
          "ya descansas en el fondo del mar.",
          "¡Y contigo se hundieron también",
          "tus mercancías y tus pasajeros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "”Esto que te ha sucedido",
          "hace que tiemble de miedo",
          "la gente que vive en las costas.",
          "Sus reyes están espantados;",
          "en la cara se les nota el terror."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Los comerciantes de otras naciones",
          "te lanzan silbidos de burla.",
          "¡Eres motivo de espanto",
          "porque has dejado de existir!”»"
        ],
        "rlw_lines": []
      }
    ]
  },
