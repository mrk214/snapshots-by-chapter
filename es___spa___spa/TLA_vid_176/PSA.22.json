{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.22","is_chapter":true,"previous":{"usfm":"PSA.21","human":"Salmos 21","canonical":true,"toc":true},"current":{"usfm":"PSA.22","human":"Salmos 22"},"next":{"usfm":"PSA.23","human":"Salmos 23","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Alabanza en medio del sufrimiento"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["(1) Himno de David."],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["Instrucciones para el director del coro: Este himno deberá cantarse con la melodía «La gacela de la aurora»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["1 (2) Dios mío, Dios mío,","¿por qué me has abandonado?","¡Tan lejos te mantienes","que no vienes en mi ayuda","ni escuchas mis gritos de dolor!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["2 (3) Dios mío,","te llamo de día,","y no me escuchas;","te llamo de noche,","y no me respondes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["3 (4) Entre los dioses","tú eres único,","tú eres rey,","tú mereces que Israel te alabe."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["4 (5) Nuestros padres confiaron en ti;","en ti confiaron, y tú los libraste;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["5 (6) te pidieron ayuda, y los salvaste;","en ti confiaron, y no les fallaste."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["6 (7) En cambio yo,","más que hombre parezco un gusano.","Soy la burla de hombres y mujeres;","todo el mundo me desprecia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["7 (8) Todos los que me ven,","se ríen de mí,","y en son de burla","tuercen la boca y mueven la cabeza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["8 (9) Hasta dicen:","«Ya que este confió en Dios,","¡que venga Dios a salvarlo!","Ya que Dios tanto lo quiere,","¡que venga él mismo a librarlo!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["9 (10) Pero digan lo que digan,","fuiste tú quien me hizo nacer;","fuiste tú quien me hizo descansar","en los brazos de mi madre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["10 (11) Todavía no había nacido yo,","cuando tú ya me cuidabas.","Aún estaba yo dentro de mi madre,","cuando tú ya eras mi Dios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["11 (12) ¡No me dejes solo!","¡Me encuentro muy angustiado,","y nadie me brinda su ayuda!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["12 (13) Me rodean mis enemigos,","parecen toros bravos de Basán."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["13 (14) Parecen leones feroces,","que se lanzan contra mí","con ganas de despedazarme."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["14 (15) Me he quedado sin fuerzas,","¡estoy totalmente deshecho!","¡Mi corazón ha quedado","como cera derretida!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["15 (16) Tengo reseca la garganta,","y pegada la lengua al paladar;","me dejaste tirado en el suelo,","como si ya estuviera muerto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["16 (17) Una banda de malvados,","que parece manada de perros,","me rodea por todos lados","y me desgarra pies y manos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["17 (18) ¡hasta puedo verme los huesos!","Mis enemigos me vigilan sin cesar,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["18 (19) hicieron un sorteo","para ver quién se queda con mi ropa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["19 (20) Dios mío, tú eres mi apoyo,","¡no me dejes!","¡Ven pronto en mi ayuda!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20,21],"lines":["20-21 (21-22) ¡Respóndeme, sálvame la vida!","¡No dejes que me maten!","¡No dejes que me despedacen!","Mis enemigos parecen perros,","parecen toros que quieren atacarme,","parecen leones que quieren devorarme."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["22 (23) Cuando mi pueblo se junte","para adorarte en el templo,","yo les hablaré de ti,","y te cantaré alabanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["23 (24) Ustedes, pueblo de Israel,","que saben honrar a Dios,","¡reconozcan su poder y adórenlo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["24 (25) Dios recibe a los pobres","con los brazos abiertos.","Dios no les vuelve la espalda,","sino que atiende sus ruegos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["25 (26) Dios mío, solo a ti te alabaré;","te cumpliré mis promesas","cuando el pueblo que te honra","se reúna para alabarte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["26 (27) Los pobres comerán","y quedarán satisfechos;","los que te buscan, Dios mío,","te cantarán alabanzas.","¡Dales larga vida!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["27 (28) Dios mío,","desde países lejanos,","todas las tribus y naciones","se acordarán de ti","y vendrán a adorarte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["28 (29) Tú eres rey","y gobiernas a todas las naciones."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["29 (30) Nadie es dueño de su vida.","Por eso los que habitan este mundo,","y los que están a punto de morir","se inclinarán ante ti,","y harán fiestas en tu honor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["30 (31) Mis hijos te rendirán culto;","las generaciones futuras te alabarán,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["31 (32) y los que nacerán después","sabrán que tú eres justo","y que haces grandes maravillas."],"rlw_lines":[]}]}}