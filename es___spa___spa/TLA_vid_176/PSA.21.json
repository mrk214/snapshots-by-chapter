    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios le da la victoria al rey"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "el rey está muy alegre",
          "porque tú le has dado fuerzas;",
          "el rey se alegra mucho",
          "porque le has dado la victoria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Le has concedido",
          "lo que él más deseaba,",
          "jamás le negaste",
          "lo que él te pidió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Saliste a su encuentro",
          "con ricas bendiciones,",
          "le pusiste en la cabeza",
          "una corona de oro fino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Te pidió que le dieras vida,",
          "y lo dejaste vivir muchos años."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Gracias a tu ayuda",
          "aumentó su poder,",
          "gracias a tu ayuda",
          "aumentó su fama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Nunca dejas de bendecirlo;",
          "tu presencia lo llena de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) El rey confía en tu amor,",
          "y tú, Dios altísimo,",
          "no lo dejarás fracasar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8,
          9
        ],
        "lines": [
          "8-9 (9-10) Rey mío,",
          "cuando tú te hagas presente,",
          "apresarás con tu poder",
          "a todos tus enemigos;",
          "¡apresarás a los que no te quieren",
          "y les prenderás fuego!",
          "Acabarás con ellos,",
          "¡en tu enojo los consumirás!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Borrarás de este mundo",
          "a todos sus hijos.",
          "Borrarás de esta tierra",
          "a todos sus descendientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Tal vez quieran hacerte daño",
          "y hagan planes contra ti,",
          "pero no lograrán su propósito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Cuando los ataques,",
          "huirán por todos lados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (14) ¡Dios mío, muestra tu gran poder,",
          "y cantaremos himnos",
          "por tus grandes victorias!"
        ],
        "rlw_lines": []
      }
    ]
  },
