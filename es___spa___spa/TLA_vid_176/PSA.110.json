    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios da poder al rey"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Mi Dios le dijo a mi señor el rey:",
          "«Siéntate a la derecha de mi trono",
          "hasta que yo derrote a tus enemigos»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Que Dios te permita",
          "derrotar a tus enemigos,",
          "y extienda desde Jerusalén",
          "el poder de tu reinado!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Que tus soldados te juren lealtad",
          "sobre los cerros de Dios",
          "en el día de la batalla!",
          "Cuando salga el sol,",
          "se renovarán tus fuerzas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dios ha hecho un juramento,",
          "y lo cumplirá:",
          "«Tú eres sacerdote para siempre,",
          "como lo fue Melquisedec»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5,
          6
        ],
        "lines": [
          "Mi Dios está a tu derecha,",
          "y siempre te ayudará.",
          "Cuando manifieste su enojo,",
          "aplastará reyes y gobernantes,",
          "juzgará naciones,",
          "y por toda la tierra",
          "amontonará cadáveres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Junto al camino,",
          "el rey apagará su sed",
          "con el agua de un arroyo,",
          "y así recobrará las fuerzas."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
