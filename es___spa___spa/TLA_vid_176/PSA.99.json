    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "No hay otro Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Pueblos de toda la tierra:",
          "¡pónganse a temblar!",
          "¡Dios es nuestro rey,",
          "y reina entre los querubines!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "La grandeza de nuestro Dios",
          "está por encima de Jerusalén",
          "y de todos los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Dios es grande y poderoso!",
          "¡No hay otro Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dios nuestro,",
          "tú eres un rey poderoso",
          "que ama la justicia;",
          "has establecido la igualdad;",
          "has actuado en Israel",
          "con rectitud y justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Alaben a nuestro Dios!",
          "¡Inclínense a adorarlo!",
          "¡No hay otro Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Moisés y Aarón fueron sus sacerdotes;",
          "Samuel estuvo a su servicio.",
          "Todos ellos llamaron a Dios,",
          "y él los escuchó;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "les habló desde una nube,",
          "y ellos cumplieron fielmente",
          "las órdenes que les dio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dios nuestro,",
          "tú atendiste a su llamado,",
          "y aunque castigaste su maldad",
          "también los perdonaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Alaben a nuestro Dios!",
          "¡Adórenlo en su propio templo!",
          "¡No hay otro Dios!"
        ],
        "rlw_lines": []
      }
    ]
  },
