    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Este es el poema más hermoso de Salomón."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primer canto"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Ay, amado mío,",
          "cómo deseo que me beses!",
          "Prefiero tus caricias,",
          "más que el vino;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "prefiero disfrutar",
          "del aroma de tus perfumes.",
          "Y eso eres tú:",
          "¡perfume agradable!",
          "¡Ahora me doy cuenta",
          "por qué te aman las mujeres!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Vamos, date prisa",
          "y llévame contigo!",
          "¡Llévame ya a tus habitaciones,",
          "rey de mi vida!",
          "Por ti haremos fiesta,",
          "por ti estaremos alegres;",
          "nos olvidaremos del vino",
          "y disfrutaré de tus caricias.",
          "¡Ahora me doy cuenta",
          "por qué las mujeres te aman tanto!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Mujeres de Jerusalén!",
          "Yo soy morena, sí,",
          "como las tiendas de Quedar.",
          "Y soy también hermosa,",
          "como las cortinas de Salomón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No se fijen en mi piel morena,",
          "pues el sol la requemó.",
          "Mis hermanos se enojaron contra mí,",
          "y me obligaron a cuidar sus viñas,",
          "¡y así mi propia viña descuidé!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuéntame, amor de mi vida,",
          "¿a dónde llevas tus rebaños?",
          "A la hora de la siesta,",
          "¿dónde los haces descansar?",
          "No tengo por qué andar",
          "como una vagabunda;",
          "¡no tengo por qué buscarte",
          "entre los rebaños de tus amigos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Los pastores"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Si acaso no lo sabes,",
          "mujer bella entre las bellas,",
          "sigue las huellas del rebaño",
          "y lleva a pastar tus cabritos",
          "junto a las carpas de los pastores."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "El novio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Amada mía,",
          "tu andar tiene la gracia",
          "del trote de las yeguas",
          "que tiran del carro del rey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Preciosas se ven tus mejillas",
          "en medio de tus trenzas!",
          "¡Bellísimo luce tu cuello",
          "entre tan bellos collares!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Voy a regalarte",
          "joyas de oro,",
          "incrustadas de plata!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mientras el rey se recuesta,",
          "mi perfume esparce su fragancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mi amado es para mí",
          "como el saquito perfumado",
          "que llevo entre mis pechos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Mi amado es para mí",
          "como un ramito de flores",
          "de las viñas de En-gadi."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "El novio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Tú eres bella, amada mía;",
          "eres muy bella!",
          "¡Tus ojos son dos luceros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Tú eres hermoso, amado mío!",
          "¡Eres un hombre encantador!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Los novios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "La verde hierba será",
          "nuestro lecho de bodas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "y a la sombra de los cedros",
          "pondremos nuestro nido de amor."
        ],
        "rlw_lines": []
      }
    ]
  },
