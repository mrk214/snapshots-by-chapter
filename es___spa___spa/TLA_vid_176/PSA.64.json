    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El destino del malvado"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "¡escucha mi queja!",
          "¡No dejes que mis enemigos",
          "acaben con mi vida!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Son una banda de malvados;",
          "son una pandilla de malhechores;",
          "¡escóndeme de sus planes secretos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Sus palabras hieren",
          "como espada afilada;",
          "sus palabras matan",
          "como flechas envenenadas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Se esconden, y desde allí",
          "disparan contra la gente inocente;",
          "no tienen miedo de nada ni de nadie;",
          "¡disparan sin que nadie se lo espere!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Cuando hacen sus planes malvados,",
          "se animan los unos a los otros;",
          "piensan dónde esconder sus trampas,",
          "y creen que nadie las verá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Planean muy bien sus maldades",
          "y creen tener el plan perfecto;",
          "piensan que nadie los descubrirá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Por eso, sin que lo esperen,",
          "Dios les disparará sus flechas"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) y caerán heridos de muerte.",
          "Su propia lengua será su ruina,",
          "y quienes los vean",
          "acabarán burlándose de ellos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) El mundo entero alabará a Dios,",
          "hablará de sus acciones,",
          "y llegará a entenderlas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) ¡Que se alegre la gente buena",
          "por todo lo que Dios ha hecho!",
          "¡Que todos los justos lo alaben",
          "y pongan en él su confianza!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
