    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Invitación de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡La sabiduría está llamando!",
          "¡Gritando está la experiencia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Se para a la orilla del camino",
          "o a la mitad de la calle,",
          "para que todos puedan verla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Se para junto a los portones,",
          "a la entrada de la ciudad,",
          "y grita a voz en cuello:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«Gente de todo el mundo,",
          "¡a ustedes estoy llamando!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Jovencitos ignorantes,",
          "muchachitos inexpertos,",
          "¡piensen bien lo que hacen!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Préstenme atención,",
          "pues voy a decirles algo importante;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7,
          8
        ],
        "lines": [
          "no me gusta la mentira",
          "ni tampoco la hipocresía,",
          "siempre digo la verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "La gente que sabe entender",
          "reconoce que mis palabras",
          "son justas y verdaderas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No busquen las riquezas,",
          "mejor busquen mis enseñanzas",
          "y adquieran mis conocimientos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "pues son más valiosos",
          "que el oro y la plata.",
          "¡Los más ricos tesoros",
          "no se comparan conmigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Yo soy la sabiduría,",
          "y mi compañera es la experiencia;",
          "siempre pienso antes de actuar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Los que obedecen a Dios",
          "aborrecen la maldad.",
          "Yo aborrezco a la gente",
          "que es orgullosa y presumida,",
          "que nunca dice la verdad",
          "ni vive como es debido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Yo tengo en mi poder",
          "el consejo y el buen juicio,",
          "el valor y el entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15,
          16
        ],
        "lines": [
          "Yo hago que actúen con justicia",
          "reyes, príncipes y gobernantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Yo amo a los que me aman,",
          "y me dejo encontrar",
          "por todos los que me buscan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Mis compañeras son",
          "la riqueza, el honor,",
          "la abundancia y la justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Lo que tengo para ofrecer",
          "vale más que el oro y la plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Siempre actúo con justicia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "y lleno de riquezas",
          "a todos los que me aman."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22,
          23
        ],
        "lines": [
          "»Dios fue quien me creó.",
          "Me formó desde el principio,",
          "desde antes de crear el mundo.",
          "Aún no había creado nada",
          "cuando me hizo nacer a mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Nací cuando aún no había",
          "mares ni manantiales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25,
          26
        ],
        "lines": [
          "Nací mucho antes",
          "de que Dios hiciera",
          "los cerros y las montañas,",
          "la tierra y sus paisajes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Yo vi cuando Dios puso",
          "el cielo azul sobre los mares;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "cuando puso las nubes en el cielo",
          "y cerró las fuentes del gran mar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29,
          30
        ],
        "lines": [
          "cuando les ordenó a las aguas",
          "no salirse de sus límites.",
          "»Cuando Dios afirmó la tierra,",
          "yo estaba allí, a su lado,",
          "como su consejera.",
          "Mi dicha de todos los días",
          "era siempre gozar de su presencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "El mundo creado por Dios",
          "me llenaba de alegría;",
          "¡la humanidad creada por Dios",
          "me llenaba de felicidad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "»Querido jovencito,",
          "¡escúchame bien!",
          "Dios te bendecirá",
          "si sigues mis consejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Acepta mis enseñanzas;",
          "no las rechaces.",
          "¡Piensa con la cabeza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Si todos los días",
          "vienes a mi casa",
          "y escuchas mis enseñanzas,",
          "Dios te bendecirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Los que me encuentran,",
          "encuentran también la vida",
          "y reciben bendiciones de Dios;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "pero los que me ofenden",
          "ponen su vida en peligro;",
          "odiarme es amar la muerte»."
        ],
        "rlw_lines": []
      }
    ]
  },
