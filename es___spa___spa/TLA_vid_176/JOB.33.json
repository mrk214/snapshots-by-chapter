    "name": "Job"
  },
  "chapter": {
    "usfm": "JOB.33",
    "human": "Job 33",
    "previous": {
      "usfm": "JOB.32",
      "human": "Job 32"
    },
    "next": {
      "usfm": "JOB.34",
