    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»Yo te ruego, amigo Job,",
          "que prestes mucha atención",
          "a cada una de mis palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ya estoy por abrir la boca;",
          "la lengua me hace cosquillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cada una de mis palabras",
          "nace de un corazón sincero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El Dios todopoderoso me hizo,",
          "y con su espíritu me dio vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Si puedes responderme,",
          "estoy listo para discutir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A los ojos de Dios,",
          "tú y yo somos iguales;",
          "estamos hechos de barro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Así que no te alarmes,",
          "pues no soy mejor que tú."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»Tú has estado insistiendo,",
          "y aún me parece escucharte:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“¡Soy inocente, soy inocente!",
          "¡No tengo de qué avergonzarme!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios me encuentra culpable",
          "y me ve como su enemigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Me tiene encadenado",
          "y a todas horas me vigila”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12,
          13
        ],
        "lines": [
          "»¿Por qué te quejas",
          "de que Dios no te responde?",
          "Estás muy equivocado;",
          "Dios es más grande que nosotros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tal vez no nos damos cuenta,",
          "pero Dios no deja de hablarnos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "algunas veces nos habla en sueños,",
          "mientras dormimos profundamente;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "otras veces nos habla al oído;",
          "claramente nos advierte"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "que ya no hagamos lo malo",
          "ni sigamos siendo orgullosos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "así nos libra de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "»A veces Dios nos castiga",
          "con agudos dolores de huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Perdemos el apetito,",
          "y no soportamos ningún alimento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "la carne se nos va secando,",
          "y hasta se nos ven los huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Así se nos acerca la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23,
          24,
          25
        ],
        "lines": [
          "»Si un solo ángel",
          "se compadece de ti",
          "y le ruega a Dios",
          "que te salve de la muerte,",
          "volverás a ser como un niño.",
          "Pero el ángel tendrá que demostrar",
          "que tú eres inocente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Entonces orarás a Dios,",
          "y lo verás cara a cara;",
          "Dios te brindará su favor",
          "y te hará justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Entonces dirás a todo el mundo:",
          "“Aunque he pecado y he sido injusto,",
          "Dios no me castigó como merecía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "¡Estoy vivo, y puedo ver la luz",
          "porque Dios me salvó de la muerte!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "»Todo esto lo hace Dios",
          "cuantas veces sea necesario,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "para salvarnos de la muerte",
          "y dejarnos seguir con vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "»Amigo Job,",
          "no me interrumpas,",
          "¡escúchame con atención!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Pero si tienes algo que decir,",
          "no te quedes con las ganas;",
          "me gustaría saber que eres inocente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Si no tienes nada que decir,",
          "escúchame en silencio;",
          "yo te enseñaré a ser sabio»."
        ],
        "rlw_lines": []
      }
    ]
  },
