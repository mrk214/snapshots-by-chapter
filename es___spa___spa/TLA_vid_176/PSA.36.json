    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La inmensa bondad de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David, fiel servidor de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) El pecador solo piensa",
          "en cómo hacer lo malo.",
          "No ve ninguna razón",
          "para respetar a Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Se cree digno de alabanza,",
          "y no reconoce su maldad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Cuando habla, miente y ofende;",
          "jamás piensa en hacer el bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Aun cuando está acostado,",
          "solo piensa en hacer lo malo;",
          "no deja su mal camino",
          "ni se aparta de la maldad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Dios mío,",
          "tu amor es tan grande",
          "que llega hasta el cielo;",
          "tan grande es tu bondad",
          "que llega hasta las nubes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Tus decisiones son justas,",
          "son firmes como las montañas",
          "y profundas como el mar.",
          "¡Hombres y animales",
          "están bajo tu cuidado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Dios mío,",
          "¡tu amor es incomparable!",
          "Bajo tu sombra protectora",
          "todos hallamos refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Con la abundancia de tu casa",
          "nos dejas satisfechos;",
          "en tu río de bendiciones",
          "apagas nuestra sed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Solo en ti se encuentra",
          "la fuente de la vida,",
          "y solo en tu presencia",
          "podemos ver la luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) ¡Bendice con tu amor",
          "a todos los que te aman!",
          "¡Salva con tu justicia",
          "a los que son sinceros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) ¡No dejes que los orgullosos",
          "me pongan el pie encima!",
          "¡No permitas que los malvados",
          "hagan conmigo lo que quieran!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Fíjense en los malvados:",
          "¡han rodado por los suelos,",
          "y no volverán a levantarse!"
        ],
        "rlw_lines": []
      }
    ]
  },
