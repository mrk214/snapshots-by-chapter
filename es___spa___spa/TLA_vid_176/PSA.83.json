    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Derrota a nuestros enemigos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío, Dios mío,",
          "no guardes silencio;",
          "no te quedes callado",
          "y sin hacer nada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) ¡Fíjate en tus enemigos:",
          "mira cómo se alborotan!",
          "¡Fíjate en los que no te quieren:",
          "mira cómo te desafían!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Hacen planes contra tu pueblo amado,",
          "con intenciones de hacerle daño,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) y hasta se atreven a decir:",
          "«¡Vamos a destruirlos por completo!",
          "¡Jamás volverá a mencionarse",
          "el nombre de Israel!»"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5,
          6,
          7,
          8
        ],
        "lines": [
          "5-8 (6-9) Los ejércitos de muchos pueblos",
          "se han puesto de acuerdo",
          "para hacerte la guerra:",
          "se han juntado Edom, Moab,",
          "Asiria y las tribus del desierto;",
          "a ellos se han unido",
          "los ejércitos de Guebal,",
          "Amón, Amalec, Tiro y Filistea."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) ¡Acaba con ellos,",
          "como acabaste con Madián!",
          "¡Acaba con ellos,",
          "como acabaste con Sísara y Jabín",
          "a orillas del río Quisón!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Ellos fueron derrotados en Endor,",
          "y quedaron tendidos en el suelo,",
          "tirados como el estiércol."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) ¡Acaba con su gente de importancia,",
          "como acabaste con Oreb y con Zeeb!",
          "¡Acaba con todos sus jefes,",
          "como acabaste con Zalmuná y Zébah,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) que pensaban adueñarse",
          "de nuestras valiosas tierras!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (14) Dios mío,",
          "haz que el viento se los lleve",
          "como se lleva a la paja."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14,
          15
        ],
        "lines": [
          "14-15 (15-16) ¡Persíguelos con tus tormentas!",
          "¡Espántalos con tus tempestades!",
          "¡Sé como las llamas de fuego",
          "que acaban con cerros y bosques!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "16 (17) Dios mío,",
          "¡llénalos de vergüenza,",
          "para que te reconozcan como Dios!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "17 (18) ¡Derrótalos para siempre!",
          "¡Derrótalos y acaba con ellos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "18 (19) ¡Así conocerán tu poder,",
          "y sabrán que solo tú",
          "gobiernas sobre toda la tierra!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
