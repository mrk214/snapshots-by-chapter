    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Entra ya en acción!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Poema educativo compuesto por la familia de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "nuestros padres nos han contado",
          "las grandes maravillas",
          "que tú hiciste en el pasado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Tú mismo echaste de su tierra",
          "a los otros pueblos;",
          "los destruiste por completo,",
          "y en lugar de ellos pusiste",
          "a nuestro propio pueblo,",
          "y lo hiciste prosperar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) No fue con la espada",
          "como ellos conquistaron esta tierra;",
          "no fue la fuerza de su brazo",
          "lo que les dio la victoria.",
          "¡Fue tu mano poderosa!",
          "¡Fue la luz de tu presencia,",
          "porque tú los amabas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Tú eres mi Dios y mi rey;",
          "¡tú nos diste la victoria!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Por tu gran poder",
          "vencimos a nuestros enemigos;",
          "¡destruimos a nuestros agresores!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Yo no pondría mi confianza",
          "en mi arco y en mis flechas,",
          "ni pensaría que mi espada",
          "podría darme la victoria;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) ¡fuiste tú quien nos hizo vencer",
          "a nuestros enemigos!,",
          "¡fuiste tú quien puso en vergüenza",
          "a nuestros adversarios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Dios nuestro,",
          "¡siempre te alabaremos!,",
          "¡siempre te daremos gracias!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Pero ahora nos has rechazado;",
          "nos has hecho pasar vergüenza.",
          "Ya no marchas con nuestros ejércitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Nos has hecho huir;",
          "¡el enemigo nos ha quitado",
          "todo lo que teníamos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Has dejado que nos devoren",
          "como si fuéramos ovejas;",
          "has dejado que nos dispersemos",
          "entre las otras naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Nos vendiste muy barato,",
          "¿y qué ganaste con eso?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13,
          14
        ],
        "lines": [
          "13-14 (14-15) Nos pusiste en ridículo",
          "delante de nuestros vecinos;",
          "las naciones y los pueblos",
          "se burlan de nosotros;",
          "¡somos el hazmerreír",
          "de todo el mundo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "15 (16) Me muero de vergüenza,",
          "pues a todas horas me ofenden;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "16 (17) ¡mis enemigos me gritan",
          "y buscan vengarse de mí!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "17 (18) Todo esto lo hemos sufrido",
          "a pesar de no haberte olvidado;",
          "jamás hemos faltado a tu pacto;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "18 (19) jamás te hemos sido infieles,",
          "ni te hemos desobedecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "19 (20) Y a pesar de todo eso,",
          "nos has echado en lugares de miseria;",
          "¡nos has dejado en profunda oscuridad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "20 (21) Si te hubiéramos olvidado,",
          "o hubiéramos adorado",
          "a dioses de otros pueblos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "21 (22) tú te habrías dado cuenta,",
          "pues sabes lo que pensamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "22 (23) Pero por causa tuya nos matan;",
          "¡por ti nos tratan siempre",
          "como a ovejas para el matadero!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "23 (24) ¡Despierta ya, Dios mío!",
          "¿Por qué sigues durmiendo?",
          "¡Entra ya en acción!",
          "¡No nos sigas rechazando!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "24 (25) ¿Por qué te escondes?",
          "¿Por qué nos olvidas?",
          "¡Mira cómo nos oprimen!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "25 (26) Estamos derrotados por completo;",
          "tenemos que arrastrarnos por el suelo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "26 (27) ¡Ven ya en nuestra ayuda!",
          "¡Sálvanos por tu gran amor!"
        ],
        "rlw_lines": []
      }
    ]
  },
