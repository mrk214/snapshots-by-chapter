    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Israel volverá de Babilonia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El Dios de Israel declara:",
          "«El día que vuelvan de Babilonia, yo seré el Dios de todos los israelitas, y ellos serán mi pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "»Cuando andaban por el desierto,",
          "yo les demostré mi gran amor.",
          "A los que no murieron en la guerra,",
          "los hice descansar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3,
          4
        ],
        "lines": [
          "Hace mucho, mucho tiempo",
          "me aparecí ante ellos y les dije:",
          "“Pueblo de Israel,",
          "siempre te he amado,",
          "siempre te he sido fiel.",
          "Por eso nunca dejaré",
          "de tratarte con bondad.",
          "Volveré a reconstruirte,",
          "y volverás a danzar alegremente,",
          "a ritmo de panderetas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "En las colinas de Samaria",
          "volverás a plantar viñedos,",
          "y disfrutarás de las uvas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Muy pronto los guardias gritarán",
          "por las colinas de Efraín:",
          "‘¡Vengan, vayamos a Jerusalén,",
          "y adoremos a nuestro Dios!’”»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El Dios de Israel dice:",
          "«¡Canten alegres, israelitas!",
          "¡Ustedes son los más importantes",
          "entre todas las naciones!",
          "En sus alabanzas canten:",
          "“¡Tú, Dios nuestro, nos salvaste!",
          "¡Salvaste a los pocos israelitas",
          "que aún quedábamos con vida!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»Yo los haré volver de Babilonia;",
          "los haré volver",
          "de todos los rincones del mundo,",
          "y los llevaré a su tierra.",
          "Serán muchos los que vuelvan.",
          "Volverán los ciegos y los cojos,",
          "las que estén embarazadas,",
          "y las que llevan bebés en brazos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Vendrán arrepentidos,",
          "con lágrimas en los ojos,",
          "y yo los llevaré por un camino seguro.",
          "Israel, yo soy tu padre,",
          "y tú eres mi hijo mayor»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios les dice a las naciones:",
          "«Escuchen mi mensaje.",
          "Digan a las islas lejanas",
          "que yo dispersé a Israel,",
          "pero que volveré a reunirlo.",
          "Ahora voy a cuidarlos,",
          "como cuida el pastor a sus ovejas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Rescataré a los israelitas;",
          "los libraré del poder de ustedes,",
          "pues son más fuertes que ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Cuando ellos lleguen a Jerusalén",
          "disfrutarán de mis bendiciones.",
          "Yo les daré trigo, vino y aceite,",
          "y también vacas y ovejas,",
          "para que hagan fiesta.",
          "Serán como un jardín bien regado,",
          "y nunca más perderán su fuerza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Yo les daré consuelo;",
          "cambiaré su dolor en danza",
          "y su tristeza en alegría.",
          "Bailarán alegres jóvenes y viejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los sacerdotes y mi pueblo",
          "disfrutarán de mis bendiciones,",
          "y tendrán más de lo que necesitan.",
          "Les juro que así lo haré»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El Dios de Israel dice:",
          "«Grandes llantos y lamentos",
          "oyó la gente de Ramá.",
          "Es Raquel, que llora",
          "por la muerte de sus hijos,",
          "y no quiere ser consolada»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16,
          17
        ],
        "lines": [
          "Pero Dios le dice:",
          "«Sécate las lágrimas, Raquel;",
          "ya no sigas llorando",
          "ni pierdas la esperanza.",
          "Tus hijos volverán a su patria;",
          "volverán de ese país enemigo,",
          "y tu sufrimiento se verá recompensado.",
          "Te juro que así será."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "»Ya he escuchado a mi pueblo",
          "llorar amargamente.",
          "Los he oído reclamarme:",
          "“Dios de Israel,",
          "¡tú eres nuestro Dios!",
          "Éramos como un toro salvaje,",
          "pero tú pudiste domarnos",
          "y ahora sabemos obedecer.",
          "¡Acéptanos de nuevo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "”Cuando jóvenes, te abandonamos;",
          "pero ahora estamos arrepentidos.",
          "¡Estamos tan avergonzados",
          "que nosotros mismos nos herimos!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "»Pero yo les he dicho:",
          "“Ustedes son mi pueblo preferido;",
          "¡y los quiero más que a nadie!",
          "Es verdad que los reprendo,",
          "pero siempre pienso en ustedes.",
          "¡Los amo de todo corazón!",
          "¡Les tengo un gran cariño!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "”Amado pueblo de Israel,",
          "¡regresa ya a tus ciudades!",
          "¡Pon señales en el camino",
          "para que puedas encontrarlo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¡Deja ya de andar perdido!",
          "¡Deja ya de serme infiel!",
          "Yo soy el Dios de Israel,",
          "y he creado algo nuevo y sorprendente,",
          "tanto que nadie podría imaginárselo”»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El sueño de Jeremías"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "En un sueño, el Dios todopoderoso me dijo:",
          "«Cuando yo haga volver a los israelitas del país donde ahora son esclavos, los que viven en las ciudades de Judá volverán a decir:",
          "“¡Dios te bendiga, Jerusalén!",
          "¡Ciudad elegida por Dios!",
          "¡Dios te bendiga, templo de Dios,",
          "pues en ti habita la justicia!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "»Allí vivirán todos los que ahora viven en las ciudades de Judá, junto con los campesinos y los pastores de ovejas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "A los que tengan hambre les daré de comer, y a los que tengan sed les daré de beber»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Cuando me desperté y abrí los ojos, me di cuenta de que había tenido un sueño muy hermoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Responsabilidad personal"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El Dios de Israel dice:",
          "«Viene el día en que haré que Israel y Judá vuelvan a poblarse de gente y de animales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Así como antes me dediqué a derribarlos, arrancarlos y destruirlos, ahora me dedicaré a plantarlos, reconstruirlos y ayudarlos a crecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Cuando llegue ese día, nadie volverá a decir: “Los padres la hacen, y los hijos la pagan”,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "porque cada quien será responsable de sus propios actos. En otras palabras, cada uno de ustedes morirá por su propio pecado»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El nuevo pacto"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "El Dios de Israel dice:",
          "«Viene el día en que haré un nuevo pacto con el pueblo de Israel y con el pueblo de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32,
          33
        ],
        "lines": [
          "En el pasado, tomé de la mano a sus antepasados y los saqué de Egipto, y luego hice un pacto con ellos. Pero no lo cumplieron, a pesar de que yo era su Dios. Por eso, mi nuevo pacto con el pueblo de Israel será este:",
          "»Haré que mis enseñanzas",
          "las aprendan de memoria,",
          "y que sean la guía de su vida.",
          "Yo seré su Dios,",
          "y ellos serán mi pueblo.",
          "Les juro que así será."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "»Ya no hará falta que unos sean maestros de otros, y que les enseñen a conocerme, porque todos me conocerán, desde el más joven hasta el más viejo. Yo les perdonaré todas sus maldades, y nunca más me acordaré de sus pecados. Les juro que así será»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El gran poder de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "El Dios todopoderoso dice:",
          "«Yo hago que el sol alumbre de día,",
          "y que la luna y las estrellas",
          "alumbren de noche.",
          "Yo hago que ruja el mar",
          "y que se agiten las olas.",
          "¡Yo soy el Dios de Israel!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36,
          37
        ],
        "lines": [
          "»El día que estas leyes naturales",
          "lleguen a faltar,",
          "ese día el pueblo de Israel",
          "dejará de ser mi nación preferida.",
          "El día que alguien pueda",
          "medir la altura del cielo",
          "o explorar lo profundo de la tierra,",
          "ese día yo rechazaré a mi pueblo",
          "por todo el mal que ha hecho.",
          "¡Pero eso nunca sucederá!",
          "¡Les doy mi palabra!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jerusalén será reconstruida"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "El Dios de Israel dice:",
          "«Viene el día en que Jerusalén, mi ciudad, será reconstruida desde la torre de Hananel hasta el portón de la Esquina,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "y de allí hasta la colina de Gareb y el barrio de Goá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Y serán dedicados a mí el valle donde se arrojan los cadáveres y las cenizas, y también los campos que llegan hasta el arroyo de Cedrón y hasta la entrada de los Caballos, en la esquina del este. ¡Nunca más la ciudad de Jerusalén volverá a ser arrancada ni destruida!»"
        ],
        "rlw_lines": []
      }
    ]
  },
