    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ayúdanos y protégenos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1,
          2
        ],
        "lines": [
          "1-2 (1b-2) Mi Señor y Dios,",
          "a ti dirijo mis ruegos",
          "porque en ti confío.",
          "No me hagas pasar vergüenza;",
          "no permitas que mis enemigos",
          "se burlen de mí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tampoco dejes que pasen vergüenza",
          "los que en ti confían;",
          "¡la vergüenza deben pasarla",
          "los que traicionan a otros!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4,
          5
        ],
        "lines": [
          "Dios mío,",
          "enséñame a vivir",
          "como tú siempre has querido.",
          "Tú eres mi Dios y salvador,",
          "y en ti siempre confío."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6,
          7
        ],
        "lines": [
          "Dios mío,",
          "por tu amor y tu bondad",
          "acuérdate de mí.",
          "Recuerda que siempre me has mostrado",
          "tu ternura y gran amor;",
          "pero olvídate de los pecados",
          "que cometí cuando era joven."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8,
          9,
          10
        ],
        "lines": [
          "Dios mío, tú eres bueno",
          "y siempre actúas con justicia.",
          "Enseñas a los pecadores",
          "a hacer lo bueno;",
          "enseñas a los humildes",
          "a hacer lo bueno y lo justo.",
          "Con quienes cumplen tu pacto",
          "y obedecen tus mandamientos",
          "tú siempre actúas",
          "con amor y fidelidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios mío,",
          "es muy grande mi maldad;",
          "pero por todo lo que tú eres,",
          "te ruego que me perdones."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A los que te honran,",
          "tú les muestras cómo deben vivir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mientras vivan, les irá bien,",
          "y sus hijos heredarán la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tú, mi Dios, te haces amigo",
          "de aquellos que te honran,",
          "y les das a conocer tu pacto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Siempre dirijo a ti mis ojos,",
          "pues solo tú puedes librarme",
          "de todo peligro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mírame, y tenme compasión,",
          "pues estoy solo y afligido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Más y más mi corazón",
          "se va llenando de angustia;",
          "¡quítame la tristeza!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Toma en cuenta que me encuentro",
          "afligido y con problemas;",
          "¡perdona todos mis pecados!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Mira cuántos enemigos tengo!",
          "¡Mira su odio tan violento contra mí!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Líbrame de ellos!",
          "¡No me hagas pasar vergüenza!",
          "¡No dejes que me maten,",
          "porque en ti busco refugio!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "En ti he puesto mi confianza.",
          "Mi honradez y mi inocencia",
          "me harán salir victorioso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¡Salva a tu pueblo, Dios mío;",
          "mira la angustia de Israel!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
