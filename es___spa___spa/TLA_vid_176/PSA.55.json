{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.55","is_chapter":true,"previous":{"usfm":"PSA.54","human":"Salmos 54","canonical":true,"toc":true},"current":{"usfm":"PSA.55","human":"Salmos 55"},"next":{"usfm":"PSA.56","human":"Salmos 56","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Yo siempre confío en Dios"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["(1) Poema de David."],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["Instrucciones para el director del coro: Este poema deberá cantarse acompañado de instrumentos de cuerda."],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["1 (2) Dios mío,","no me des la espalda;","presta oído a mi oración."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2,3],"lines":["2-3 (3-4) ¡Atiéndeme!","¡Respóndeme!","Estoy angustiado,","y no encuentro paz.","Me asusta oír los gritos","de los malvados enemigos","que me oprimen.","No solo se enojan conmigo;","para colmo, me persiguen."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["4 (5) Siento que el corazón","se me sale del pecho;","el miedo a la muerte me domina."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["5 (6) Estoy temblando de susto;","¡realmente estoy espantado!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["6 (7) ¡Quisiera yo tener alas,","y volar como paloma","hasta un lugar tranquilo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["7 (8) Me iría muy lejos de aquí:","¡me iría a vivir al desierto!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["8 (9) ¡Buscaría refugio,","y me pondría a salvo","de los que me atormentan!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["9 (10) Dios mío,","destruye sus planes;","no los dejes ponerse de acuerdo.","En la ciudad solo veo","sangre y violencia;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["10 (11) dentro de sus murallas","reinan día y noche,","la intriga y la maldad;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["11 (12) el engaño y la opresión","dominan en todas sus calles."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12,13,14],"lines":["12-14 (13-15) ¡Amigo mío,","hasta tú me has ofendido!","Tú, que eres igual que yo,","tú, que eres como mi hermano,","y que ibas conmigo al templo.","Si otro me hubiera insultado,","lo podría soportar;","si otro me hubiera humillado,","podría esconderme de él."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["15 (16) ¡Ojalá que a mis enemigos","la muerte los tome por sorpresa!","¡Ojalá que los entierren vivos,","porque en ellos solo hay maldad!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["16 (17) Yo, por mi parte,","voy a pedirle ayuda a Dios;","¡él habrá de salvarme!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["17 (18) Mañana, tarde y noche,","no dejaré de rogarle;","¡él habrá de escucharme!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["18 (19) Mucha gente me ataca,","pero él me rescatará;","me hará salir sano y salvo","de la lucha que ahora libro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["19 (20) Dios, el rey eterno,","humillará a mis enemigos.","Son gente que nunca cambia","ni sabe honrar a Dios;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["20 (21) amenazan a sus amigos,","y nunca cumplen sus promesas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["21 (22) Dentro de ellos","solo piensan en pelear.","Sus palabras son amables","y suaves como la mantequilla;","¡son más suaves que el aceite,","pero más cortantes que un cuchillo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22,23],"lines":["22-23 (23-24) Dios mío,","¡tú echarás a los malvados","hasta el fondo de la tumba!","¡Esos asesinos mentirosos","no vivirán ni la mitad de su vida!","Mi amigo, te aconsejo","que pongas en manos de Dios","todo lo que te preocupa;","¡él te dará su apoyo!","¡Dios nunca deja fracasar","a los que lo obedecen!","¡Por eso siempre confío en él!"],"rlw_lines":[]}]}}