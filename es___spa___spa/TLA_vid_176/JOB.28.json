{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"JOB","name":"Job"},"chapter":{"chapter_usfm":"JOB.28","is_chapter":true,"previous":{"usfm":"JOB.27","human":"Job 27","canonical":true,"toc":true},"current":{"usfm":"JOB.28","human":"Job 28"},"next":{"usfm":"JOB.29","human":"Job 29","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["El canto de la sabiduría"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["«El oro y la plata","se sacan de las minas","y se limpian con fuego."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["El hierro y el cobre","se sacan de la tierra","y se les quita la impureza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Ya no hay para los mineros","lugar demasiado oscuro;","en los más lejanos rincones","buscan piedras preciosas;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["con la ayuda de cuerdas,","bajan a profundos barrancos;","cavan largos túneles","donde nadie ha puesto el pie."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["»En esas profundas minas,","donde el calor es insoportable,","se gana la vida el minero."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["De las rocas saca zafiros,","y de entre el polvo saca oro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7,8],"lines":["Ningún león, ninguna fiera,","ha llegado a esos lugares;","¡ni siquiera la mirada del halcón","ha podido descubrirlos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Los mineros golpean la dura roca","y dejan al descubierto","el corazón de las montañas;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["abren túneles en las rocas,","y contemplan grandes tesoros;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["llegan a donde nacen los ríos,","y entonces sacan a la luz","lo que había permanecido oculto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["»¿Dónde está la sabiduría?","¿Dónde puede encontrarse?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Nadie aprecia su valor","porque no pertenece a este mundo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Tampoco se encuentra","en las profundidades del mar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15,16],"lines":["Su precio no puede pagarse","con todo el oro del mundo,","ni con plata, ni piedras preciosas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Ni el oro ni el cristal,","ni las joyas más caras","se le pueden comparar,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18,19],"lines":["¡mucho menos el coral,","el jaspe y el topacio!","La sabiduría vale más que las joyas;","¡ni todo el oro del mundo","puede pagar su precio!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["»Vuelvo, pues, a preguntar:","¿dónde está la sabiduría?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Ella se esconde del mundo,","y hasta de las aves del cielo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Aunque la muerte destructora","dice conocerla,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["solo Dios sabe dónde vive,","y cómo llegar hasta ella."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Dios ve los rincones más lejanos","y todo lo que hay debajo del cielo,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25,26,27],"lines":["y mientras daba su fuerza al viento","y medía el agua de los mares","fijó su mirada en la sabiduría;","mientras establecía la época de lluvias","y la dirección de las tormentas,","decidió ponerla a prueba;","una vez que confirmó su gran valor,","le dio su aprobación."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Luego dijo a todo el mundo:","“Si ustedes me obedecen","y se apartan del mal,","habrán hallado la sabiduría”»."],"rlw_lines":[]}]}}