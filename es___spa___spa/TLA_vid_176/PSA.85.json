    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Devuélvenos la vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de la Escuela de música de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "tú has sido bondadoso",
          "con esta tierra tuya:",
          "le devolviste a Israel",
          "su antigua felicidad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) le perdonaste a tu pueblo",
          "su maldad y sus pecados,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) ¡tu enojo con ellos se calmó!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Dios y salvador nuestro,",
          "deja ya de enojarte con nosotros,",
          "y devuélvenos la felicidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) ¿Acaso para siempre",
          "vas a estar enojado con nosotros?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Estamos como muertos;",
          "¡devuélvenos la vida!",
          "Nosotros somos tu pueblo;",
          "de ti esperamos alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Dios mío,",
          "danos muestras de tu amor",
          "y bríndanos tu ayuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Dejemos de hacer locuras",
          "y obedezcamos a Dios.",
          "Recordemos que somos suyos,",
          "y que él nos ha prometido paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Dios está siempre cerca",
          "para salvar a quienes lo honran,",
          "y para que su poder",
          "nunca nos abandone."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) El amor y la lealtad,",
          "la paz y la justicia,",
          "sellarán su encuentro con un beso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) La lealtad brotará de la tierra,",
          "y la justicia se asomará desde el cielo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Dios nos dará bienestar,",
          "nuestra tierra dará buenas cosechas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (14) y la justicia, como mensajera,",
          "anunciará la llegada de Dios."
        ],
        "rlw_lines": []
      }
    ]
  },
