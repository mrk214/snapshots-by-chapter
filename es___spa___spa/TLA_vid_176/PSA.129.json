    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios es justo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Cántico para las peregrinaciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Dejemos que nuestra gente",
          "nos hable de las angustias",
          "que ha pasado desde su juventud:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Hemos pasado muchas angustias",
          "desde nuestra juventud,",
          "pero no han podido vencernos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El enemigo nos hirió la espalda;",
          "¡nos hizo profundas heridas,",
          "como quien abre surcos",
          "con un arado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero Dios es justo",
          "y nos libró de los malvados»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Que sean derrotados",
          "y puestos en vergüenza",
          "todos los que odian a Jerusalén!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Que se marchiten como la hierba",
          "que crece en el techo de la casa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Esa gente es como la hierba,",
          "de la que no se ocupan",
          "ni los que la cortan",
          "ni los que la recogen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Cuando pasan, nadie los saluda;",
          "y si saludan, nadie les contesta."
        ],
        "rlw_lines": []
      }
    ]
  },
