{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"ZEP","name":"Sofonías"},"chapter":{"chapter_usfm":"ZEP.1","is_chapter":true,"previous":{"usfm":"ZEP.INTRO1","human":"Sofonías Introducción","canonical":false,"toc":true},"current":{"usfm":"ZEP.1","human":"Sofonías 1"},"next":{"usfm":"ZEP.2","human":"Sofonías 2","canonical":true,"toc":true},"items":[{"type":"verse","verse_numbers":[1],"lines":["Yo soy Sofonías hijo de Cusí. Mi padre era descendiente de Guedalías, Amarías y Ezequías. Dios me dio este mensaje cuando Josías hijo de Amón era rey de Judá."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Dios destruirá a Judá"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2,3],"lines":["Nuestro Dios dice:","«Voy a destruir por completo","todo lo que hay sobre la tierra.","Destruiré a la humanidad entera,","y también a los animales,","a las aves y a los peces.","¡Voy a hacer que tropiecen los malvados!","Yo soy el Dios de Israel,","y juro que así lo haré."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["»Castigaré a los habitantes de Judá;","quitaré de Jerusalén a los ídolos;","quitaré a sus sacerdotes,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["a los que adoran a las estrellas","en los techos de sus casas,","y a los que me adoran a mí,","pero también adoran al dios Milcom."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Y voy a destruir igualmente","a los que se han apartado de mí","y jamás buscan mis consejos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["»¡Silencio!","¡Ya se acerca el día del castigo!","¡Todo está preparado!","¡Los invitados ya están aquí!","¡Voy a destruir a mi pueblo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["»Ese día castigaré","a los hijos del rey,","a los jefes principales","y a los que siguen el mal ejemplo","de los que no creen en mí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Ese día castigaré también","a los que adoran a otros dioses","y llenan los templos de esos dioses","con riquezas conseguidas","mediante el engaño y la violencia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["»Ese día gritarán pidiendo ayuda","desde la Puerta de los Pescados;","un gran clamor se escuchará","desde el Segundo Barrio","y desde las colinas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["¡Griten también ustedes,","vecinos del Barrio del Mortero!","¡Ese día morirán los comerciantes","y los que cambian dinero!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["»Cuando llegue ese día,","tomaré una lámpara y buscaré","en la ciudad de Jerusalén","a los que viven tranquilos;","cuando los encuentre, los castigaré.","Se parecen al vino","que se pone a reposar,","y hasta se atreven a decir:","“¡Dios no hace nada bueno,","pero tampoco hace nada malo!”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Construyeron casas,","pero no habitarán en ellas;","cultivaron viñas,","pero no beberán el vino;","¡sus riquezas les serán quitadas,","y sus casas serán destruidas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["»¡Ya se acerca el gran día","en que vendré a castigarlos!","¡Se acerca con gran rapidez!","¡Ese día se oirán gritos tan horribles","que hasta los más valientes llorarán!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Será un día de gran enojo,","un día de aflicción y angustia,","un día de completa destrucción,","un día de grandes nubarrones,","un día de profunda oscuridad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Entre gritos y toques de trompeta,","ese día se dará la orden de ataque","contra las ciudades amuralladas","y contra sus altas torres."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["»Todos han pecado contra mí.","Por eso haré que se angustien","y que caminen como ciegos.","Su sangre se esparcirá como el polvo,","y sus cuerpos se volverán estiércol."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["El día que yo me enoje,","le prenderé fuego a la tierra.","No habrá nada que los salve;","¡ni siquiera su oro y su plata!","¡En un instante serán destruidos","todos los que habitan este mundo!»"],"rlw_lines":[]}]}}