as declarado:","«Cuando yo triunfe,","repartiré entre mi pueblo","las tierras de Siquem","y las del valle de Sucot."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["8 (9) Las tierras de Galaad son mías;","al norte están las tribus de José","para proteger a mi pueblo,","y en Judá he puesto al rey."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["9 (10) Los de Moab son mis esclavos,","Edom es mi propiedad,","y en territorio filisteo","lanzo gritos de victoria»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["10 (11) ¿Quién quiere llevarme","hasta la ciudad con muros?","¿Quién quiere enseñarme","el camino que lleva a Edom?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["11 (12) ¡Tú, Dios mío,","te has alejado de nosotros","y ya no sales a pelear","al frente de nuestros ejércitos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["12 (13) La ayuda humana resulta inútil;","¡ayúdanos a vencer al enemigo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["13 (14) Dios nuestro, tú los vencerás;","¡con tu ayuda saldremos victoriosos!"],"rlw_lines":[]}]}}