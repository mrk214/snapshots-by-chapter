    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios dirige nuestra vida"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Es de tontos emborracharse,",
          "porque se pierde el control",
          "y se provoca mucho alboroto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cuando el rey se enoja",
          "es como un león que ruge;",
          "quien lo hace enojar,",
          "pone en peligro su vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cualquier tonto inicia un pleito,",
          "pero quien lo evita merece aplausos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Quien no trabaja en otoño",
          "se muere de hambre en invierno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los planes de la mente humana",
          "son profundos como el mar;",
          "quien es inteligente los descubre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Hay muchos que afirman ser leales,",
          "pero nadie encuentra gente confiable."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios bendice",
          "a los hijos del hombre honrado,",
          "cuando ellos siguen su ejemplo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "En cuanto el rey se sienta",
          "para juzgar al acusado,",
          "con una mirada suya",
          "acaba con el malvado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Nadie puede decir",
          "que tiene buenos pensamientos",
          "ni que está limpio de pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios no soporta dos cosas:",
          "que engañes al que te vende,",
          "y que engañes al que te compra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por los hechos se llega a saber",
          "si el joven tiene buena conducta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Dios ha creado dos cosas:",
          "los oídos para oír",
          "y los ojos para ver."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Si solo piensas en dormir",
          "terminarás en la pobreza.",
          "Mejor piensa en trabajar,",
          "y nunca te faltará comida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Para el que compra,",
          "ninguna mercancía es buena;",
          "para el que vende,",
          "ninguna mercancía es mejor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Podrá haber mucho oro,",
          "y muchas piedras preciosas,",
          "pero nada hay más valioso",
          "que las enseñanzas del sabio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Si te comprometes a pagar",
          "las deudas de un desconocido,",
          "te pedirán dar algo en garantía",
          "y perderás hasta el abrigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tal vez te sepa muy sabroso",
          "ganarte el pan con engaños,",
          "pero acabarás comiendo basura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Siempre que hagas planes,",
          "sigue los buenos consejos;",
          "nunca vayas a la guerra",
          "sin un buen plan de batalla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El que habla mucho",
          "no sabe guardar secretos.",
          "No te juntes con gente chismosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El que maldice a sus padres",
          "morirá antes de tiempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Lo que al principio",
          "se gana fácilmente,",
          "al final no trae ninguna alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Nunca hables de tomar venganza;",
          "mejor confía en Dios,",
          "y él vendrá en tu ayuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Dios no soporta dos cosas:",
          "que engañes al que te vende,",
          "y que engañes al que te compra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Nadie sabe cuál será su futuro;",
          "por eso debemos dejar",
          "que Dios dirija nuestra vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "No caigas en la trampa",
          "de prometerle algo a Dios,",
          "para luego no cumplirle."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Cuando el rey sabio",
          "castiga al malvado,",
          "lo destruye por completo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Dios nos ha dado la conciencia",
          "para que podamos examinarnos",
          "a nosotros mismos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "El rey afirma su reinado",
          "cuando es fiel a Dios",
          "y trata bien a su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "El orgullo del joven es su fuerza;",
          "el del anciano, su experiencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Con golpes y con azotes",
          "se corrigen los malos pensamientos."
        ],
        "rlw_lines": []
      }
    ]
  },
