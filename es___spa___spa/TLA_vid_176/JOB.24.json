  "book": {
    "book_usfm": "JOB",
    "name": "Job"
  },
  "chapter": {
    "usfm": "JOB.24",
    "human": "Job 24",
    "previous": {
      "usfm": "JOB.23",
      "human": "Job 23"
    },
    "next": {
      "usfm": "JOB.25",
