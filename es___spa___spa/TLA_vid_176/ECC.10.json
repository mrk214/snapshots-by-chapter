{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"ECC","name":"Eclesiastés"},"chapter":{"chapter_usfm":"ECC.10","is_chapter":true,"previous":{"usfm":"ECC.9","human":"Eclesiastés 9","canonical":true,"toc":true},"current":{"usfm":"ECC.10","human":"Eclesiastés 10"},"next":{"usfm":"ECC.11","human":"Eclesiastés 11","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Otros dichos sabios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["La mejor sopa se echa a perder si le cae una mosca. La menor tontería echa a perder tu fama de sabio."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["El sabio siempre piensa en hacer lo bueno; el tonto solo piensa en hacer lo malo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Tiene el tonto tan poco cerebro que sin abrir la boca anuncia su tontería."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Si el gobernante se enoja contigo, no renuncies a tu cargo. Para los grandes errores, un gran remedio: la paciencia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["En esta vida he visto algo muy grave, parecido al error que cometen los gobernantes:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["que a la gente incapaz se le dan puestos de gran responsabilidad, mientras que a la gente capaz se le dan los puestos más bajos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["¡Y resulta que los esclavos andan a caballo, mientras que la gente que vale anda a pie!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Si haces hoyos,","puedes caerte en ellos.","Si partes en dos un muro,","puede morderte una serpiente."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Si partes piedras,","puedes salir herido.","Si partes leña,","puedes salir lastimado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["El hacha sin filo no corta.","Si no se le saca filo,","hay que golpear con más fuerza.","Si quieres prosperar,","tienes que saber qué hacer","y hacerlo bien."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["¿De qué te sirve tener","un encantador de serpientes,","si la serpiente te muerde","antes de ser encantada?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Cuando el sabio habla,","a todos les cae bien;","cuando el tonto abre la boca,","provoca su propia ruina."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Comienza diciendo tonterías,","y acaba diciendo estupideces,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["¡pero palabras no le faltan!","¿Qué va a pasar mañana?","¿Qué va a pasar después?","¡Nadie puede saberlo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["No tiene ningún sentido","que tanto trabaje el tonto,","si no sabe ni en dónde está."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["¡Qué lástima da el país","que tiene un rey incapaz","y malos gobernantes","que siempre están de fiesta!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["¡Pero qué dichoso es el país","que tiene un rey bien preparado,","con gobernantes que comen para vivir","y no viven para comer!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["En la casa del perezoso","pasan muchas desgracias:","primero se cae el techo,","y después toda la casa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Para estar feliz","hace falta pan,","para estar contento","hace falta vino,","y para gozar de todo","hace falta dinero."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Nunca hables mal del rey","ni de la gente poderosa,","aunque creas que nadie te oye.","Las palabras vuelan;","son como los pájaros,","y todo llega a saberse."],"rlw_lines":[]}]}}