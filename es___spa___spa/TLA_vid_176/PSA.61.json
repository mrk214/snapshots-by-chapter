    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Protégeme toda la vida"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: Este himno deberá cantarse acompañado de instrumentos de cuerda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "oye mis gritos,",
          "escucha mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) ¡Ya no aguanto más!",
          "Por eso te llamo",
          "desde el último rincón del mundo.",
          "Ponme sobre una gran piedra,",
          "donde quede a salvo del peligro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) ¡Tú eres mi protector!",
          "¡Tú me defiendes del enemigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Quiero pasar toda mi vida",
          "viviendo en tu santuario,",
          "bajo tu protección."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Tú, Dios mío,",
          "conoces mis promesas;",
          "tú me entregaste mi parte",
          "en la tierra que le diste",
          "al pueblo que te adora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Concédeme reinar mucho tiempo,",
          "y vivir una larga vida;",
          "que dure mi reinado una eternidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Déjame reinar para siempre;",
          "¡protégeme con tu amor toda la vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Yo te prometo",
          "que siempre te alabaré con himnos,",
          "y que todos los días",
          "te cumpliré mis promesas."
        ],
        "rlw_lines": []
      }
    ]
  },
