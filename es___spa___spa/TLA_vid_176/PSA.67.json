        "lines": [
          "Dios, guía de todas las naciones"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Instrucciones para el director musical: Este himno deberá cantarse acompañado de instrumentos de cuerda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "ten compasión de nosotros",
          "y danos tu bendición.",
          "Míranos con alegría",
          "y muéstranos tu amor;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) así todas las naciones del mundo",
          "conocerán tus enseñanzas",
          "y tu poder para salvar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Dios mío,",
          "¡que te alaben los pueblos!",
          "¡Que todos los pueblos te alaben!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) ¡Que todas las naciones se alegren",
          "y canten llenas de felicidad!",
          "Tú gobiernas a los pueblos con justicia;",
          "¡tú guías a las naciones de la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Dios mío,",
          "¡que te alaben los pueblos!",
          "¡Que todos los pueblos te alaben!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) La tierra dará grandes cosechas,",
          "y tú nos bendecirás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Sí, tú nos bendecirás;",
          "a ti te alabarán",
          "los más lejanos países de la tierra."
        ],
        "rlw_lines": []
      }
