{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.40","is_chapter":true,"previous":{"usfm":"ISA.39","human":"Isaías 39","canonical":true,"toc":true},"current":{"usfm":"ISA.40","human":"Isaías 40"},"next":{"usfm":"ISA.41","human":"Isaías 41","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Dios consuela a Jerusalén"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Dios dijo:","«¡Consuelen a mi pueblo!","¡Denle ánimo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Hablen con mucho cariño","a los habitantes de Jerusalén,","y anúncienles de mi parte","que ya han dejado de ser esclavos.","Ya les hice pagar por sus pecados,","y el castigo que han recibido","es más que suficiente»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El camino de Dios en el desierto"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Isaías anunció:","«Preparen para Dios","un camino en el desierto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Rellenen todos los valles","y conviertan en llanura","la región montañosa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Entonces Dios mostrará su poder","y lo verá la humanidad entera.","Dios así lo ha dicho."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El poder de la palabra de Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["»Alguien me ordenó que gritara,","y yo pregunté: “¿Qué debo gritar?”","Entonces escuché:","“Grita que todo ser humano","es como la hierba","y como las flores del campo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Grita que la hierba se seca,","y las flores se marchitan,","cuando Dios lanza sobre ellas","el viento del desierto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["En cambio, la palabra de Dios","permanece para siempre”»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["¡Dios llega con poder!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Dios le dijo a Isaías:","«Súbete a una montaña","y anuncia esta buena noticia","a los habitantes de Jerusalén.","No tengas miedo;","grita con todas tus fuerzas","y di a las ciudades de Judá:","“¡Aquí viene nuestro Dios!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["¡Viene con todo su poder!","Dios es un rey poderoso,","y trae con él a su pueblo,","el pueblo que ha liberado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Viene cuidando a su pueblo,","como cuida un pastor a su rebaño:","lleva en brazos a los corderos","y guía con cuidado a las ovejas","que acaban de tener su cría”»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Nadie es más grande que Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Isaías dijo:","«Dios puede medir el océano","con la palma de su mano.","Puede calcular con los dedos","toda la extensión del cielo.","Dios es capaz de recoger","todo el polvo de la tierra,","y de pesar en una balanza","los cerros y las montañas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13,14],"lines":["»A Dios nadie le enseña nada;","nadie le da consejos","ni lecciones de ciencia y sabiduría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["»Las naciones son, para él,","como una gota de agua;","¡como un grano de polvo en la balanza!","Los poderosos países","que están en las islas del mar","son para él lo mismo","que un simple grano de arena."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["»No hay en los bosques del Líbano,","animales ni leña suficientes","para presentar en su altar","una ofrenda como él se la merece."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Para Dios, nada valen las naciones;","¡son lo mismo que nada!"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Los ídolos no son Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18,19,20],"lines":["»A Dios no podemos compararlo","con nada ni con nadie.","No puede ser representado","con ninguna imagen.","Los escultores fabrican estatuas,","los joyeros las recubren de oro","y les ponen cadenitas de plata.","Los que no tienen dinero","buscan un palo que no se pudra","y se lo llevan a un artesano;","pero este, por más hábil que sea,","hace un ídolo que ni pararse puede.","¡Pero a Dios no podemos compararlo","con ninguna de estas imágenes!"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El poder de Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["»Ustedes saben muy bien,","y ya lo han oído decir,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["que Dios tiene su trono","muy por encima del cielo.","Desde allí, Dios nos ve","como si fuéramos insectos.","Dios extiende el cielo como un toldo,","lo levanta como una carpa","para vivir en ella."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23,24],"lines":["Dios hace que los poderosos de este mundo","desaparezcan como plantas","tiernas y sin raíces.","¡Esas plantas se marchitan","y se las lleva el huracán!"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["La grandeza de Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["»Nuestro santo Dios afirma:","“Con nadie me pueden comparar.","Nadie puede igualarse a mí”»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Isaías dijo:","«Levanten los ojos al cielo:","¿quién ha creado todo esto?","Dios hace que salgan las estrellas;","las llama por su nombre","y las ordena una por una.","¡Es tan grande su poder","que nunca falta una estrella!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["»Pueblo de Israel,","¿por qué te quejas?","¿Por qué crees que Dios","no se preocupa por ti?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Tú debes saber que Dios","no se cansa como nosotros;","debes saber que su inteligencia","es más de lo que imaginamos.","Y debes saber que su poder","ha creado todo lo que existe."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Dios les da nuevas fuerzas","a los débiles y cansados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Los jóvenes se cansan","por más fuertes que sean,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["pero los que confían en Dios","siempre tendrán nuevas fuerzas.","Podrán volar como las águilas,","podrán caminar sin cansarse","y correr sin fatigarse»."],"rlw_lines":[]}]}}