    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hacer el bien trae alegría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quien no acepta las reprensiones",
          "será destruido,",
          "y nadie podrá evitarlo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cuando la gente buena prospera,",
          "el pueblo se pone alegre;",
          "cuando gobiernan los malvados,",
          "el pueblo se pone triste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El que ama la sabiduría",
          "trae alegría a su padre;",
          "el que anda con prostitutas",
          "malgasta todo lo que tiene."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El rey que hace justicia",
          "da seguridad al país;",
          "el que solo cobra impuestos",
          "lleva el país a la ruina."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quien mucho alaba al amigo,",
          "mucho lo engaña."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El malvado cae en su propia trampa;",
          "pero el que es bueno",
          "vive con gran alegría."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "La gente buena se preocupa",
          "por defender al indefenso;",
          "pero a los malvados",
          "eso ni les preocupa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los que aman la intriga",
          "enredan a todos en pleitos,",
          "pero los sabios siembran la paz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Solo burlas y enojos saca el sabio",
          "que discute con un tonto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los asesinos desean la muerte",
          "de la gente buena y honrada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El necio no esconde su enojo;",
          "el sabio sabe controlarse."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El gobernante que presta atención",
          "a toda clase de mentiras,",
          "vivirá rodeado de ayudantes malvados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Al pobre y al que lo maltrata",
          "Dios les ha dado la vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El rey afirma su reinado",
          "cuando gobierna bien a los pobres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los golpes y la disciplina",
          "enseñan a ser sabio,",
          "pero el que es malcriado",
          "solo avergüenza a su madre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Donde aumentan los malvados,",
          "aumenta la maldad;",
          "¡pero la gente buena los verá fracasar!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Corrige a tu hijo",
          "y vivirás tranquilo y satisfecho."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Donde no hay un buen gobernante,",
          "el pueblo no sabe qué hacer;",
          "pero Dios bendice",
          "a los que obedecen su ley."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Cuando el esclavo es necio,",
          "no bastan las palabras;",
          "solo con golpes obedece."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Fíjate en la gente",
          "que no piensa lo que dice:",
          "¡más puedes esperar de un tonto",
          "que de esa clase de gente!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Si empiezas por consentir a tu sirviente,",
          "al final tendrás que lamentarlo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La gente que fácilmente se enoja",
          "siempre provoca peleas;",
          "la gente violenta",
          "comete muchos errores."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El orgulloso será humillado,",
          "y el humilde será alabado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Si te juntas con ladrones",
          "no aprecias en nada tu vida;",
          "pues cuando ellos sean acusados,",
          "no podrás negar que eres culpable."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Si tienes miedo de la gente,",
          "tú mismo te tiendes una trampa;",
          "pero si confías en Dios",
          "estarás fuera de peligro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "No busques la amistad del gobernante",
          "para que él te haga justicia;",
          "mejor confía en Dios,",
          "pues él es justo con todos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Ni el hombre justo soporta al malvado,",
          "ni el malvado soporta al hombre justo."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
