    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Líbrame de los mentirosos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Cántico para las peregrinaciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Dios mío,",
          "cuando me siento angustiado,",
          "te llamo y tú me respondes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Dios mío,",
          "sálvame de la gente mentirosa;",
          "sálvame de la gente embustera."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Muy mal les va a ir a ustedes,",
          "mentirosos!",
          "¡Dios los va a castigar!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Les disparará flechas",
          "puntiagudas y encendidas,",
          "como las que lanzan los guerreros!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Pobre de mí!",
          "¡Soy un hombre sin patria",
          "que vive entre gente salvaje!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Ya he vivido mucho tiempo",
          "entre los que aborrecen la paz!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Yo soy un hombre tranquilo,",
          "¡pero ellos hablan de guerra",
          "mientras yo hablo de paz!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
