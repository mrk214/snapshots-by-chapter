    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Quiero que me protejas"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) David compuso este himno cuando huyó de Saúl y se escondió en una cueva."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: Este himno deberá cantarse con la melodía «No destruyas»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) ¡Ten compasión de mí,",
          "Dios mío!",
          "¡Ten compasión de mí,",
          "porque en ti busco protección!",
          "¡Quiero que me protejas",
          "bajo la sombra de tus alas",
          "hasta que pase el peligro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Dios altísimo,",
          "te llamo porque siempre me ayudas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Tiéndeme la mano desde el cielo,",
          "porque tu amor es constante.",
          "Tiéndeme la mano, Dios mío,",
          "y sálvame de mis enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Estoy por el suelo,",
          "rodeado de leones;",
          "rodeado de hombres",
          "que parecen bestias.",
          "En vez de dientes,",
          "tienen lanzas y flechas;",
          "en vez de lengua,",
          "tienen una espada afilada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Pero tú, mi Dios,",
          "estás por encima del cielo;",
          "¡eres tan grande",
          "que cubres toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Esa gente me tendió una trampa",
          "para hacerme caer en ella.",
          "¡Eso me puso muy triste!",
          "Querían que me cayera en ese hoyo,",
          "pero ellos fueron los que cayeron."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Dios mío,",
          "mi corazón está dispuesto",
          "a cantarte himnos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) ¡Voy a despertarme!",
          "¡Despertaré al arpa y a la lira!",
          "¡Despertaré al nuevo día!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Dios mío,",
          "yo te alabaré entre los pueblos,",
          "te cantaré himnos entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Tan grande y constante es tu amor",
          "que llega hasta los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Tú, mi Dios,",
          "sobrepasas los cielos;",
          "¡eres tan grande",
          "que cubres toda la tierra!"
        ],
        "rlw_lines": []
      }
    ]
  },
