{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.119","is_chapter":true,"previous":{"usfm":"PSA.118","human":"Salmos 118","canonical":true,"toc":true},"current":{"usfm":"PSA.119","human":"Salmos 119"},"next":{"usfm":"PSA.120","human":"Salmos 120","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Himno a la palabra de Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1,2],"lines":["Dios, tú bendices","a los que van por buen camino,","a los que de todo corazón","siguen tus enseñanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Ellos no hacen nada malo:","solo a ti te obedecen."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Tú has ordenado","que tus mandamientos","se cumplan al pie de la letra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Quiero corregir mi conducta","y cumplir tus mandamientos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Si los cumplo,","no tendré de qué avergonzarme."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Si me enseñas tu palabra,","te alabaré de todo corazón"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["y seré obediente a tus mandatos.","¡No me abandones!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Solo obedeciendo tu palabra","pueden los jóvenes corregir su vida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10,11],"lines":["Yo te busco de todo corazón","y llevo tu palabra en mi pensamiento.","Manténme fiel a tus enseñanzas","para no pecar contra ti."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["¡Bendito seas, mi Dios!","¡Enséñame a obedecer tus mandatos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13,14,15],"lines":["Siempre estoy repitiendo","las enseñanzas que nos diste.","En ellas pongo toda mi atención,","pues me hacen más feliz","que todo el oro del mundo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Mi mayor placer son tus mandatos;","jamás me olvido de ellos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17,18,19],"lines":["Yo estoy a tu servicio;","trátame bien, y cumpliré tus órdenes.","Estoy de paso en este mundo;","dame a conocer tus mandamientos.","¡Ayúdame a entender","tus enseñanzas maravillosas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Todo el día siento grandes deseos","por conocerlas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["¡Qué lástima me dan","los que no cumplen tus mandamientos!","¡Tú reprendes a esos orgullosos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["No permitas que me desprecien","pues siempre obedezco tus mandatos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Los poderosos hacen planes contra mí,","pero yo solo pienso en tus enseñanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Ellas me hacen feliz,","y me dan buenos consejos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25,26,27,28],"lines":["Cumple tu promesa y dame ánimo,","pues estoy muy decaído","y el dolor me está matando.","Yo te conté mi vida,","y tú me respondiste.","¡Enséñame a cumplir tus mandatos","y a pensar solo en tus maravillas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["No me dejes decir mentiras;","¡por favor, enséñame tu palabra!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[30,31],"lines":["Dios mío, no me hagas quedar mal,","pues confío en tus mandamientos","y he decidido obedecerlos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["No me tardo en cumplirlos","porque me ayudaste a entenderlos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33,34,35],"lines":["Dios mío,","enséñame a cumplir tus mandamientos,","pues obedecerlos me hace feliz;","¡los cumpliré toda mi vida!","Aclara mi entendimiento,","y los seguiré de todo corazón."],"rlw_lines":[]},{"type":"verse","verse_numbers":[36],"lines":["Hazme pensar solo en tu palabra,","y no en las ganancias egoístas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[37,38],"lines":["No me dejes seguir a dioses falsos,","pues quiero adorarte solo a ti.","¡Cumple tu promesa y dame ánimo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[39,40],"lines":["Lo que más deseo es tu palabra.","Me asusta pensar","que mis enemigos me desprecien.","Ponme a salvo y dame ánimo,","pues tú eres un juez justo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[41],"lines":["Dios mío,","muéstrame tu amor y sálvame,","tal como lo has prometido."],"rlw_lines":[]},{"type":"verse","verse_numbers":[42,43],"lines":["Así podré responder a mis enemigos.","Permíteme hablar con la verdad,","pues confío en tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[44,45],"lines":["Puedo andar con toda libertad","porque sigo tus enseñanzas,","y siempre las cumpliré."],"rlw_lines":[]},{"type":"verse","verse_numbers":[46],"lines":["En la presencia de reyes","podré hablar de tus mandamientos","y no sentirme avergonzado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[47,48],"lines":["Yo amo y deseo tu palabra,","pues me llena de alegría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[49],"lines":["Tus promesas me dan esperanza;","¡no te olvides de ellas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[50],"lines":["Tus promesas me dan vida;","me consuelan en mi dolor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[51,52,53],"lines":["Dios mío,","yo nunca olvido tu palabra eterna,","pues ella me da consuelo.","Los orgullosos me ofenden;","me molesta saber que esos malvados","no siguen tus enseñanzas.","Pero yo las cumplo sin falta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[54],"lines":["Poco tiempo estaré en este mundo,","pero siempre diré","que es buena tu enseñanza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[55],"lines":["Dios mío,","por las noches pronuncio tu nombre;","quiero seguir tus enseñanzas,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[56],"lines":["pues es lo que me corresponde."],"rlw_lines":[]},{"type":"verse","verse_numbers":[57,58],"lines":["Dios mío,","tú eres todo lo que tengo;","de todo corazón","quiero obedecerte y agradarte.","¡Cumple tu promesa y dame ánimo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[59,60],"lines":["No dejaré pasar más tiempo:","me he puesto a pensar en mi conducta,","y he decidido seguir tus mandamientos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[61],"lines":["Los malvados quieren atraparme,","pero yo no descuido tus enseñanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[62],"lines":["A medianoche me levanto y te alabo","porque tus sentencias son justas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[63],"lines":["Soy amigo de los que te adoran","y de los que te obedecen."],"rlw_lines":[]},{"type":"verse","verse_numbers":[64],"lines":["Dios mío,","tu amor llena toda la tierra;","¡enséñame tus mandamientos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[65],"lines":["Dios mío, ¡trátame bien,","tal como lo has prometido!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[66],"lines":["Yo creo en tu palabra.","¡Dame más sabiduría e inteligencia!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[67],"lines":["Antes de que me castigaras,","estuve alejado de ti,","pero ahora obedezco tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[68],"lines":["Tú eres bueno, y haces el bien;","enséñame a obedecer tus mandamientos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[69,70],"lines":["Los orgullosos hablan mal de mí;","son gente que no tiene sentimientos.","Pero yo sigo tus enseñanzas","porque ellas me hacen feliz."],"rlw_lines":[]},{"type":"verse","verse_numbers":[71],"lines":["Estuvo bien que me hicieras sufrir","porque así entendí tus enseñanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[72],"lines":["Para mí, ellas son de más valor","que el oro y la plata."],"rlw_lines":[]},{"type":"verse","verse_numbers":[73],"lines":["Tú me hiciste con tus propias manos;","¡hazme obedecer tus mandamientos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[74],"lines":["Los que te adoran","se alegran al verme,","pues confío en tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[75],"lines":["Dios mío,","yo sé que tus mandatos son justos,","y merezco que me castigues."],"rlw_lines":[]},{"type":"verse","verse_numbers":[76,77,78],"lines":["Ven con tu amor a darme ánimo,","pues soy feliz con tus enseñanzas.","Yo medito en ellas,","así que cumple tu promesa.","Avergüenza a esos orgullosos","que sin motivo me hacen daño,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[79],"lines":["haz que se junten conmigo","todos los que te adoran,","para que conozcan tus mandamientos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[80],"lines":["Hazme entender tus enseñanzas,","para que yo no pase vergüenza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[81,82],"lines":["La vida se me escapa,","la vista se me nubla,","esperando que cumplas tu promesa","de venir a salvarme,","pues yo confío en tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[83],"lines":["Aunque ya estoy viejo y arrugado,","no me olvido de tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[84,85,86,87],"lines":["Esos orgullosos y embusteros","que no siguen tus enseñanzas,","me ponen trampas.","¿Cuándo vas a castigarlos?","Casi han acabado conmigo,","pero yo obedezco tus mandamientos","porque son la verdad.","¡Dame tu ayuda!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[88],"lines":["¡Dame ánimo y te obedeceré,","pues tú eres un Dios de amor!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[89,90,91],"lines":["Dios mío,","tú eres eterno y siempre fiel.","Mientras el cielo y la tierra existan,","tu palabra permanecerá;","¡todo lo creado está a tu servicio!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[92],"lines":["Si tu palabra no me hiciera tan feliz,","¡ya me hubiera muerto de tristeza!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[93],"lines":["Jamás me olvido de tu palabra,","pues ella me da vida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[94],"lines":["¡Sálvame, pues soy tuyo","y busco cumplir tus mandamientos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[95],"lines":["Hay malvados que quieren matarme,","pero yo quiero entender tus enseñanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[96],"lines":["Todo en este mundo acabará;","¡solo tu palabra no tiene fin!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[97],"lines":["¡Tanto amo tus enseñanzas","que a todas horas medito en ellas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[98,99],"lines":["Siempre están conmigo,","y me hacen aún más sabio","que mis enemigos y mis maestros."],"rlw_lines":[]},{"type":"verse","verse_numbers":[100],"lines":["Hasta entiendo mejor que los ancianos,","porque las pongo en práctica."],"rlw_lines":[]},{"type":"verse","verse_numbers":[101],"lines":["Me he apartado de todo mal camino","porque quiero obedecer tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[102],"lines":["No me he apartado de tu enseñanza","porque tú eres mi maestro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[103,104],"lines":["Me das tanta sabiduría","que no soporto la mentira.","¡Tu palabra es para mí","más dulce que la miel!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[105],"lines":["Tu palabra es una lámpara","que alumbra mi camino."],"rlw_lines":[]},{"type":"verse","verse_numbers":[106],"lines":["Cumpliré la promesa que te hice:","obedeceré tus justos mandamientos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[107,108,109,110],"lines":["Dios mío,","¡ya es mucho lo que he sufrido!","Mi vida está siempre en peligro,","pero nunca olvido tus enseñanzas.","Los malvados me ponen trampas,","pero yo obedezco tus mandamientos.","Recibe con agrado","esta alabanza que te ofrezco,","y enséñame tu palabra.","Cumple tu promesa y dame ánimo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[111,112],"lines":["Tus enseñanzas son mías;","¡son la alegría de mi corazón!","He decidido cumplirlas","para siempre y hasta el fin."],"rlw_lines":[]},{"type":"verse","verse_numbers":[113,114,115],"lines":["¡Déjenme solo, gente malvada!","¡Los odio porque no son sinceros!","Pero a ti, Dios mío, te amo","y quiero seguir tus enseñanzas.","Tú me das refugio y protección;","tus promesas me llenan de esperanza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[116],"lines":["Dame fuerza y seguiré con vida,","tal como lo has prometido;","¡no defraudes mi confianza!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[117],"lines":["¡Ayúdame y ponme a salvo","para que obedezca tu palabra!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[118,119],"lines":["A los malvados de este mundo","que desprecian tus enseñanzas","no los quieres tener cerca;","los tratas como a basura.","De nada les sirve hacer planes malvados;","yo, en cambio, obedezco tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[120],"lines":["Tiemblo de miedo en tu presencia;","¡tu palabra me hace temblar!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[121],"lines":["Dios mío, ¡no me dejes caer","en manos de mis enemigos!","Yo hago lo que es bueno y justo;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[122],"lines":["haz que siempre me vaya bien,","y que no me molesten los orgullosos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[123],"lines":["La vista se me nubla","esperando que cumplas tu promesa","de venir a ayudarme."],"rlw_lines":[]},{"type":"verse","verse_numbers":[124],"lines":["¡Trátame con mucho amor,","y enséñame tus mandamientos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[125],"lines":["Permíteme llegar a entenderlos,","pues los quiero comprender."],"rlw_lines":[]},{"type":"verse","verse_numbers":[126],"lines":["Dios mío,","ya es hora de que actúes,","pues nadie cumple tus mandatos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[127],"lines":["Prefiero tus mandamientos","que tener muchas riquezas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[128],"lines":["Por eso los sigo","y no soporto la mentira."],"rlw_lines":[]},{"type":"verse","verse_numbers":[129],"lines":["¡Tus enseñanzas son maravillosas!","¡Por eso las sigo fielmente!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[130],"lines":["Cuando un maestro las explica,","hasta la gente sencilla las entiende."],"rlw_lines":[]},{"type":"verse","verse_numbers":[131],"lines":["Deseo conocer tus mandamientos;","¡me muero por entenderlos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[132],"lines":["Dios mío,","¡atiéndeme y tenme compasión","como acostumbras hacerlo","con todos los que te aman!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[133,134],"lines":["Guíame, como lo has prometido;","¡yo quiero cumplir tus mandamientos!","No dejes que me maltraten,","ni me dejes caer en la maldad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[135],"lines":["Dame muestras de tu bondad","y enséñame tus mandamientos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[136],"lines":["Me dan ganas de llorar","cuando veo que nadie los cumple."],"rlw_lines":[]},{"type":"verse","verse_numbers":[137],"lines":["Dios mío,","tú eres justo y juzgas con rectitud."],"rlw_lines":[]},{"type":"verse","verse_numbers":[138],"lines":["Los mandamientos que nos diste","son justos y dignos de confianza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[139,140,141],"lines":["Mis enemigos me humillan","pero yo no olvido tus enseñanzas.","Me muero de enojo","porque ellos no las cumplen.","En cambio, yo las amo,","pues son puras como oro refinado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[142],"lines":["Tú siempre actúas con justicia,","y tus enseñanzas son verdaderas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[143],"lines":["Cuando estoy afligido y en problemas,","tus mandamientos son mi alegría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[144],"lines":["Tus leyes son siempre justas;","¡dame entendimiento y vida!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[145,146],"lines":["Dios mío,","te llamo con todas mis fuerzas;","¡respóndeme, sálvame!","¡Quiero cumplir tus mandamientos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[147],"lines":["Muy temprano me levanto","para pedirte que me ayudes,","pues confío en tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[148],"lines":["Me paso la noche en vela","meditando en ella."],"rlw_lines":[]},{"type":"verse","verse_numbers":[149],"lines":["Dios mío,","tú eres todo amor, ¡escúchame!","Eres todo justicia, ¡dame vida!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[150],"lines":["Cada vez siento más cerca","a los que se han alejado","de tus enseñanzas","y procuran mi mal."],"rlw_lines":[]},{"type":"verse","verse_numbers":[151],"lines":["Pero a ti, Dios mío, te siento cerca,","y confío en tus mandamientos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[152],"lines":["Desde hace mucho tiempo","conozco tu palabra;","tú la estableciste para siempre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[153],"lines":["¡Mira mi sufrimiento, y sálvame!","¡Yo no me olvido de tus enseñanzas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[154],"lines":["¡Ponte de mi parte, y rescátame!","¡Cumple tu promesa y dame ánimo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[155,156,157,158],"lines":["Dios mío,","tú eres muy bueno;","eres todo justicia.","¡Dame vida!","Mis enemigos y perseguidores","se cuentan por millares;","¡a esos malvados no los salvarás","porque no siguen tus enseñanzas!","No los soporto,","porque no creen en tus promesas,","pero yo siempre obedezco tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[159],"lines":["Dios mío,","mira cuánto amo tus mandamientos;","¡por tu gran amor, dame vida!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[160],"lines":["Todas tus palabras","se basan en la verdad;","todas ellas son justas","y permanecen para siempre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[161],"lines":["Yo no les tengo miedo","a los poderosos que me persiguen;","solo tiemblo ante tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[162],"lines":["¡Ella me hace más feliz","que si encontrara un tesoro!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[163],"lines":["Aborrezco la mentira;","¡no la soporto!","Pero amo tus enseñanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[164],"lines":["Ellas son tan justas","que no me canso de alabarte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[165],"lines":["Los que aman tu palabra","disfrutan de mucha paz","y no sufren ningún tropiezo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[166,167,168],"lines":["Dios mío,","espero que me salves,","pues amo tus mandamientos.","Tú bien sabes que los cumplo","de todo corazón."],"rlw_lines":[]},{"type":"verse","verse_numbers":[169,170],"lines":["Dios mío,","¡acepta mi oración y mis ruegos!","¡Dame entendimiento, y sálvame,","tal como lo has prometido!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[171],"lines":["Yo te cantaré alabanzas","porque me enseñas tu palabra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[172],"lines":["Alabaré tus promesas,","pues todos tus mandamientos son justos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[173],"lines":["Ven y tiéndeme la mano,","pues he decidido obedecerte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[174],"lines":["Dios mío,","ansioso espero que me salves;","tus enseñanzas son mi alegría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[175],"lines":["Dame vida y te alabaré;","¡que tu palabra me sostenga!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[176],"lines":["Ando como oveja perdida;","ven a buscarme, pues te pertenezco","y tengo presentes tus mandamientos."],"rlw_lines":[]}]}}