    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»Si doy rienda suelta a mi queja",
          "y a la amargura que llevo dentro,",
          "es porque estoy cansado de la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Por eso le he dicho a Dios:",
          "“Dios mío, no seas injusto conmigo;",
          "¡dime qué mal he cometido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tú eres mi creador,",
          "y no está bien que me maltrates",
          "ni que permitas que los malvados",
          "hagan planes contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tú no ves las cosas",
          "como nosotros las vemos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "ni vives los pocos años",
          "que nos toca vivir;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿por qué, entonces, quieres saber",
          "qué pecados he cometido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Tú sabes que no soy culpable,",
          "y yo bien sé que no es posible",
          "que me libre de tu poder!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8,
          9,
          10
        ],
        "lines": [
          "”Tú, con tus propias manos,",
          "me fuiste dando forma,",
          "como quien hace una olla de barro,",
          "como quien derrama crema",
          "para hacer queso;",
          "¿por qué quieres quitarme la vida",
          "y hacerme volver al polvo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tú recubriste mis huesos",
          "con carne y con piel;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "tú me diste vida",
          "y me trataste con bondad;",
          "¡siempre cuidaste de mí!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pero ahora me doy cuenta",
          "de algo que no me dijiste:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡que me estarías vigilando",
          "para ver si yo pecaba,",
          "pues no perdonarías mi pecado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero, inocente o culpable,",
          "estoy en un gran problema",
          "y no puedo mirarte a los ojos.",
          "¡Estoy muy avergonzado",
          "y me muero de tristeza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Siempre me estás vigilando,",
          "como si fueras un león al acecho;",
          "apenas hago el menor movimiento,",
          "me haces sentir tu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tu enojo contra mí va en aumento;",
          "presentas nuevos testigos que me acusan;",
          "tus ejércitos me atacan sin cesar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "”¿Por qué me dejaste nacer?",
          "¡Ojalá me hubiera muerto,",
          "sin que nadie llegara a conocerme!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Más me valdría no haber nacido,",
          "y pasar directamente a la tumba!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Mis días están contados;",
          "ya están llegando a su fin.",
          "¡Por favor, déjame en paz!",
          "¡Quiero tener un momento de alegría,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21,
          22
        ],
        "lines": [
          "antes de emprender el viaje sin regreso",
          "al país de las tinieblas y el desorden!”»"
        ],
        "rlw_lines": []
      }
    ]
  },
