    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Yo soy una flor",
          "de los llanos de Sarón;",
          "soy una rosa de los valles."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "El novio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi amada es una rosa",
          "entre las espinas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mi amado es un manzano",
          "entre árboles silvestres.",
          "¡Me muero por sentarme a su sombra",
          "y saborear sus deliciosos frutos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi amado me llevó",
          "a la sala de banquetes,",
          "y allí me cubrió de besos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Denme a comer uvas!",
          "¡Denme a comer manzanas!",
          "¡Ayúdenme a recobrar las fuerzas,",
          "que me estoy muriendo de amor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Que ponga él su brazo izquierdo",
          "debajo de mi cabeza!",
          "¡Que me apriete contra su cuerpo",
          "con el brazo derecho!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "El novio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mujeres de Jerusalén,",
          "quiero que me prometan,",
          "por las gacelas y venaditas",
          "que corren por los bosques,",
          "que no molestarán a mi amada",
          "ni la despertarán de su sueño de amor",
          "hasta que ella sola se despierte."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segundo canto"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Oigo la voz de mi amado!",
          "¡Ya lo veo venir!",
          "Viene saltando por las colinas,",
          "viene brincando por las montañas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mi amado es como un cabrito.",
          "¡Allí está, tras el muro!",
          "¡Se asoma por las ventanas,",
          "me espía por las rejas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mi amado me dijo:",
          "«Acompáñame, amada mía;",
          "¡ven conmigo, bella mujer!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El invierno ya se ha ido;",
          "las lluvias han terminado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ya hay flores en los campos;",
          "ha llegado el tiempo de cantar.",
          "¡El arrullo de las tórtolas",
          "se escucha en nuestra tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "En las higueras hay higos,",
          "y las flores de las viñas",
          "esparcen suave aroma.",
          "Acompáñame, amada mía;",
          "¡ven conmigo, bella mujer!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "El novio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Palomita amada,",
          "no te escondas en las rocas.",
          "Muéstrame tu rostro,",
          "déjame oír tu voz.",
          "¡Tu voz es dulce!",
          "¡Tu rostro es bello!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Los novios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Las zorras pequeñas",
          "causan daño a nuestras viñas.",
          "¡Ayúdennos a atraparlas,",
          "pues nuestras viñas están en flor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mi amado es mío,",
          "y yo soy suya;",
          "mi amado cuida de su rebaño",
          "entre las rosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Regresa a mí, amado mío,",
          "mientras sopla todavía",
          "la brisa de la tarde,",
          "y las sombras van cayendo.",
          "¡Corre como un venado!",
          "¡Corre como cabrito",
          "por las colinas que nos separan!"
        ],
        "rlw_lines": []
      }
    ]
  },
