{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.41","is_chapter":true,"previous":{"usfm":"PSA.40","human":"Salmos 40","canonical":true,"toc":true},"current":{"usfm":"PSA.41","human":"Salmos 41"},"next":{"usfm":"PSA.42","human":"Salmos 42","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Devuélveme la salud"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["(1) Himno de David."],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["1 (2) Dios bendice","a los que cuidan de los pobres,","y los pondrá a salvo","cuando vengan las dificultades."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["2 (3) Los cuidará y les dará vida,","los hará vivir felices","en la tierra prometida","y no dejará que sus enemigos","les hagan ningún daño."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["3 (4) Cuando se enfermen,","Dios les dará fuerzas","y les devolverá la salud."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["4 (5) Yo le he pedido a Dios:","«Tenme compasión;","devuélveme la salud,","pues he pecado contra ti»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["5 (6) Mis enemigos desean mi mal,","y hasta dicen:","«¡Ya quisiéramos verlo muerto,","para que todos lo olviden!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["6 (7) Cuando vienen a visitarme","solo me traen chismes;","y cuando se van","salen hablando de mí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["7 (8) Mis enemigos se juntan","con la idea de perjudicarme;","con las peores intenciones","hablan mal de mí:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["8 (9) «Está en cama,","y no volverá a levantarse.","¡Un demonio lo ha atacado!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["9 (10) Hasta mi mejor amigo,","en quien yo más confiaba,","y con quien compartía mi pan,","se ha puesto en contra mía."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["10 (11) Pero tú, Dios mío,","compadécete de mí;","¡devuélveme la salud,","y les daré su merecido!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["11 (12) Yo estaré seguro","de haberte complacido","cuando mis enemigos se den cuenta","que he salido victorioso."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["12 (13) Tú siempre me sostendrás","y me mantendrás en tu presencia,","porque soy inocente."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["13 (14) ¡Bendito sea el Dios de Israel,","ayer, hoy y siempre!","¡Así sea!"],"rlw_lines":[]}]}}