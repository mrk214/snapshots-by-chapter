{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"JOB","name":"Job"},"chapter":{"chapter_usfm":"JOB.19","is_chapter":true,"previous":{"usfm":"JOB.18","human":"Job 18","canonical":true,"toc":true},"current":{"usfm":"JOB.19","human":"Job 19"},"next":{"usfm":"JOB.20","human":"Job 20","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Quinta respuesta de Job"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Job respondió:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["«Tanta palabrería de ustedes","me atormenta y me lastima;","¿Cuándo van a dejarme en paz?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Una y otra vez","me insultan sin compasión.","¡Debería darles vergüenza!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Aun cuando yo haya pecado,","eso no les afecta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Lo que ustedes realmente quieren","es sentirse mejores que yo;","se aprovechan de verme humillado","para lanzarme sus ataques."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Pero voy a decirles algo:","es Dios quien me hizo daño,","¡es Dios quien me tendió una trampa!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["»A gritos pido ayuda,","pero nadie me responde,","ni conoce la justicia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Dios no me deja pasar,","me tiene cerrado el camino."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Me quitó mis riquezas;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["me dejó como a un árbol","destrozado y sin raíces."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["»Tan grande es su enojo contra mí","que me considera su enemigo;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["me ataca como un ejército,","¡me tiene completamente rodeado!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["»Dios ha hecho que me abandonen","mis amigos y mis hermanos;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["también ha hecho que me olviden","mis parientes y conocidos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Los que antes comían en mi mesa,","hoy me ven como a un extraño;","¡aun las jóvenes que me servían","ahora dicen que no me conocen!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Pido que mis esclavos me sirvan,","y ni con ruegos me atienden."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Tengo tan mal aliento","que nadie en la casa me aguanta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18,19],"lines":["Todos mis amigos y seres queridos","se han puesto en mi contra;","¡hasta los niños se burlan de mí!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["La piel se me pega a los huesos;","¡estoy a un paso de la muerte!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21,22],"lines":["»Amigos míos,","¡tengan lástima de mí!","Dios se ha vuelto mi enemigo,","no hagan ustedes lo mismo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23,24],"lines":["»¡Cómo quisiera que mis palabras","quedaran grabadas para siempre","en una placa de hierro!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Yo sé que mi Dios vive,","sé que triunfará sobre la muerte,","y me declarará inocente."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Cuando mi cuerpo haya sido destruido,","veré a Dios con mis propios ojos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Estoy seguro de que lo veré,","¡con ansias espero el momento!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["»Ustedes solo piensan en perseguirme,","pues creen que soy culpable;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["pero tengan mucho cuidado.","Dios es el juez de todos nosotros;","cuando él los juzgue,","los castigará con la muerte»."],"rlw_lines":[]}]}}