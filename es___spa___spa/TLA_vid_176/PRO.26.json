    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La necedad"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No es posible imaginar",
          "que caiga nieve en la selva",
          "ni que llueva en el desierto",
          "ni que se alabe a un tonto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "La maldición sin motivo",
          "jamás surte efecto;",
          "es como un ave sin rumbo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Para el caballo, el látigo;",
          "para el burro, el freno;",
          "para el necio, el garrote."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No te pongas al nivel del necio,",
          "o resultará que el necio eres tú."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pon al tonto en su lugar,",
          "para que no se crea muy sabio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Enviar como mensajero a un tonto",
          "da lo mismo que no enviar a nadie."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dime de qué sirve",
          "que el tonto diga proverbios,",
          "y te diré de qué sirve",
          "una carreta sin bueyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dime de qué sirve",
          "alabar al tonto,",
          "y te diré de qué sirve",
          "un arco sin flechas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Un proverbio en labios de un tonto",
          "es lo mismo que un cuchillo",
          "en manos de un borracho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tan peligroso es que lances",
          "piedras al aire,",
          "como que a un tonto",
          "le des trabajo en tu casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El perro vuelve a su vómito,",
          "y el necio insiste en su necedad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Más puede esperarse",
          "de quien reconoce que es tonto,",
          "que de un tonto que se cree muy sabio."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La pereza"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "El perezoso pone como pretexto",
          "que en la calle hay leones",
          "que se lo quieren comer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¿En qué se parece",
          "el perezoso a la puerta?",
          "¡En que los dos se mueven,",
          "pero ninguno avanza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Al que es perezoso",
          "hasta comer le cuesta trabajo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El perezoso se cree muy sabio;",
          "piensa que no hay nadie como él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tan peligroso resulta",
          "meterse en pleitos ajenos,",
          "como querer agarrar por la cola",
          "a un perro bravo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Como loco que lanza piedras al aire,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "es quien engaña al amigo",
          "y dice que estaba bromeando."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El fuego se apaga",
          "si no se le echa más leña,",
          "y el pleito se acaba",
          "si no siguen los chismes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¿En qué se parecen",
          "la leña y el peleador?",
          "En que la leña aviva el fuego,",
          "y el peleador aviva el pleito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Los chismes son muy sabrosos,",
          "pero también hacen mucho daño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Los piropos del malvado",
          "son tan engañosos",
          "como una olla de barro",
          "cubierta de plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "El que esconde sus rencores,",
          "en el fondo es mentiroso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "No creas lo que te diga,",
          "pues te habla con dulzura",
          "pero busca hacerte daño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Miente al decir que te quiere,",
          "pues todos saben que te odia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "No abras zanjas",
          "si no quieres caer en ellas,",
          "ni hagas rodar piedras",
          "si no quieres que te aplasten."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Quien miente, no se quiere a sí mismo;",
          "quien a todos alaba, se busca problemas."
        ],
        "rlw_lines": []
      }
    ]
  },
