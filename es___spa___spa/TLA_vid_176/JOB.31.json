    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»Yo siempre me propuse",
          "no mirar con deseos",
          "a ninguna jovencita."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Y qué recibí del Dios del cielo?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Tan solo la ruina y el desastre",
          "que merecen los malhechores!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Tal parece que Dios no me ve",
          "ni se fija en lo que hago!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Yo nunca he hecho nada malo.",
          "Nunca a nadie le he mentido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Que Dios me ponga a prueba,",
          "y verá que soy inocente!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nunca me aparté del buen camino,",
          "ni me dejé llevar por mis deseos.",
          "Si se encuentra en mis manos",
          "alguna cosa robada,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡que otros disfruten mis cosechas,",
          "y se queden con mis campos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "»Si acaso he esperado",
          "que se vaya mi vecino",
          "para estar a solas con su esposa,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡que mi esposa se convierta",
          "en esclava y amante de otros!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11,
          12
        ],
        "lines": [
          "Eso sería una vergüenza.",
          "Sería un terrible castigo,",
          "¡peor que si un incendio destructor",
          "acabara con mis cosechas!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Cuando mis esclavos",
          "me hacían algún reclamo",
          "siempre fui justo con ellos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "De otra manera,",
          "¿cómo podría responder a Dios",
          "si él me llamara a cuentas?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Tanto a ellos como a mí",
          "Dios nos hizo iguales!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "»Jamás he dejado de atender",
          "los ruegos de los pobres;",
          "jamás he dejado que las viudas",
          "se desmayen de hambre;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "jamás he probado un bocado",
          "sin compartirlo con los huérfanos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Desde mi más temprana edad,",
          "siempre he sido el apoyo",
          "de huérfanos y viudas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "jamás he dejado que los pobres",
          "mueran por falta de ropa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Muchos me agradecieron",
          "el abrigarlos con ropa de lana."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Nunca abusé de mi autoridad",
          "para amenazar a los huérfanos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22,
          23
        ],
        "lines": [
          "¡No quiero que Dios me castigue!",
          "¡No podría resistir su poder!",
          "Pero si acaso he actuado así,",
          "¡que me quede yo sin brazos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "»Jamás he puesto mi confianza",
          "en el poder de las riquezas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "jamás las muchas riquezas",
          "me fueron motivo de orgullo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26,
          27
        ],
        "lines": [
          "El sol y la luna",
          "son dos astros maravillosos,",
          "pero jamás les he rendido culto,",
          "ni en público ni en secreto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Si hubiera cometido tal pecado,",
          "Dios tendría que juzgarme",
          "por haberlo traicionado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "»Jamás me he alegrado",
          "de ver la desgracia de mi enemigo;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "jamás he cometido el pecado",
          "de pedir que le vaya mal;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "jamás nadie visitó mi casa",
          "sin calmar su hambre en mi mesa;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "jamás un extraño tocó a mi puerta",
          "sin ser invitado a pasar la noche;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33,
          34
        ],
        "lines": [
          "a diferencia de otros,",
          "jamás he guardado en secreto",
          "ninguno de mis pecados,",
          "y no por miedo a mis parientes",
          "o por temor al qué dirán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "»Juro que digo la verdad.",
          "¡Espero que el Dios todopoderoso",
          "me escuche y me responda!",
          "Si de algo puede acusarme,",
          "que lo ponga por escrito."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Llevaré su acusación",
          "en los hombros y en la frente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Me presentaré ante Dios",
          "con la frente en alto,",
          "y le daré cuenta de mis actos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          38,
          39
        ],
        "lines": [
          "»Jamás he abusado de mis tierras,",
          "pues las he dejado descansar.",
          "Jamás he explotado a mis trabajadores",
          "pues les he pagado su justo salario."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Si lo que digo no es cierto,",
          "¡que en vez de trigo y cebada",
          "produzca mi tierra espinas!»",
          "Así fue como Job dio por terminado su discurso."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
