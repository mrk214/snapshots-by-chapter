    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tú eres quien me protege"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios de Israel,",
          "tú eres un Dios justo;",
          "no me dejes pasar vergüenza.",
          "¡Sálvame, pues confío en ti!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Préstame atención,",
          "ven pronto a socorrerme.",
          "Protégeme como una enorme roca,",
          "rodéame como una alta muralla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) ¡Tú eres la roca que me protege!",
          "¡Tú eres la muralla que me salva!",
          "Guíame y dirígeme,",
          "pues así lo prometiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) No me dejes caer en la trampa",
          "que me han puesto mis enemigos;",
          "¡tú eres mi protector!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Tú eres un Dios fiel.",
          "¡Sálvame!",
          "¡Mi vida está en tus manos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Odio a los que adoran ídolos,",
          "pues estos no sirven para nada;",
          "¡pero yo en ti confío!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Tu bondad me llena de alegría,",
          "pues me viste sufrir y me cuidaste,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) me libraste de mis enemigos,",
          "y me diste libertad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Dios mío, tenme compasión,",
          "pues estoy muy angustiado,",
          "siento dolor en todo el cuerpo",
          "y mis ojos ya no aguantan más."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Toda mi vida he sufrido,",
          "toda mi vida he llorado;",
          "mi maldad me debilita,",
          "mis huesos no me sostienen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Amigos y enemigos",
          "me ven como poca cosa;",
          "al verme en la calle",
          "se espantan y huyen de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Me tienen olvidado,",
          "como si ya me hubiera muerto;",
          "¡parezco un vaso hecho pedazos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (14) Mucha gente habla mal de mí,",
          "y hasta mí llegan sus chismes",
          "de que parezco un fantasma.",
          "Todos se han puesto en mi contra,",
          "y hasta quieren matarme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "14 (15) ¡Pero tú eres mi Dios!",
          "¡En ti he puesto mi confianza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "15 (16) Mi vida está en tus manos;",
          "¡sálvame de mis enemigos!,",
          "¡sálvame de los que me persiguen!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "16 (17) Yo estoy a tu servicio:",
          "¡muéstrame tu buena voluntad!",
          "¡Por tu gran amor, sálvame!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "17 (18) Dios mío,",
          "mira que te estoy llamando;",
          "no me dejes pasar vergüenza.",
          "¡Que pasen vergüenza los malvados!",
          "¡Échalos a la tumba!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "18 (19) ¡Calla a esos mentirosos,",
          "que me desprecian y me humillan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "19 (20) Tú eres muy bondadoso",
          "con la gente que te honra;",
          "a la vista de todo el mundo",
          "derramas tu bondad",
          "sobre los que en ti confían."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "20 (21) Tu presencia los pone a salvo",
          "de los planes malvados;",
          "tú los proteges de la maldad",
          "como protege la gallina a sus pollitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "21 (22) ¡Bendito seas, Dios mío!",
          "Cuando yo estuve en problemas",
          "me mostraste tu gran amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "22 (23) Estaba yo tan confundido",
          "que hasta llegué a pensar",
          "que no querías ni verme.",
          "Pero a gritos pedí tu ayuda,",
          "y tú escuchaste mis ruegos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "23 (24) Ustedes, los que aman a Dios,",
          "¡demuéstrenle su amor!",
          "Nuestro Dios protege",
          "a los que merecen su confianza,",
          "pero a los orgullosos",
          "les da su merecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "24 (25) Todos ustedes,",
          "los que confían en Dios,",
          "¡anímense y sean valientes!"
        ],
        "rlw_lines": []
      }
    ]
  },
