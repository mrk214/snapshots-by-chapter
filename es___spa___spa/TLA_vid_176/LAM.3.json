{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"LAM","name":"Lamentaciones"},"chapter":{"chapter_usfm":"LAM.3","is_chapter":true,"previous":{"usfm":"LAM.2","human":"Lamentaciones 2","canonical":true,"toc":true},"current":{"usfm":"LAM.3","human":"Lamentaciones 3"},"next":{"usfm":"LAM.4","human":"Lamentaciones 4","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Tercer lamento acróstico"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["El profeta"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Yo soy el que ha sufrido","el duro castigo de Dios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Él me forzó a caminar","por los caminos más oscuros;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["no hay un solo momento","en que no me castigue."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4,5,6],"lines":["Oscura tumba es mi vida;","¡es como si ya estuviera muerto!","Dios me rodeó por completo","de la miseria más terrible.","Me dejó sin fuerzas;","¡no tengo un solo hueso sano!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7,8,9],"lines":["Se niega Dios a escucharme,","aunque siempre le pido ayuda.","A cada paso me pone tropiezos","y me hace perder el camino.","Me tiene preso y encadenado.","¡No puedo escaparme de él!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10,11,12],"lines":["Objeto soy de sus ataques;","¡soy el blanco de sus flechas!","Como animal feroz me vigila,","esperando el momento de atacarme.","¡Me obliga a apartarme del camino","para que no pueda defenderme!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13,14,15],"lines":["Ya me partió el corazón","con sus terribles flechas.","Dios ha llenado mi vida","de tristeza y amargura.","Todo el día y a todas horas,","la gente se burla de mí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Estoy completamente derrotado,","porque Dios me hizo caer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Ya no tengo tranquilidad;","la felicidad es solo un recuerdo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Me parece que de Dios","ya no puedo esperar nada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Los más tristes recuerdos","me llenan de amargura."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Siempre los tengo presentes,","y eso me quita el ánimo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Pero también me acuerdo","de algo que me da esperanza:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Sé que no hemos sido destruidos","porque Dios nos tiene compasión."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Sé que cada mañana se renuevan","su gran amor y su fidelidad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Por eso digo que en él confío;","¡Dios es todo para mí!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Invito a todos a confiar en Dios","porque él es bondadoso."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Es bueno esperar con paciencia","que Dios venga a salvarnos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["y aprender desde nuestra juventud","que debemos soportar el sufrimiento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Es conveniente callar","cuando Dios así lo ordena."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29,30],"lines":["Y olvidar la venganza","cuando alguien nos golpea.","Debemos esperar con paciencia","que Dios venga a ayudarnos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Realmente Dios nos ha rechazado,","pero no lo hará para siempre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32,33],"lines":["Nos hace sufrir y nos aflige,","pero no porque le guste hacerlo.","Nos hiere, pero nos tiene compasión,","porque su amor es muy grande."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34,35,36],"lines":["Violar los derechos humanos","es algo que Dios no soporta.","Maltratar a los prisioneros","o no darles un juicio justo,","es algo que Dios no aprueba."],"rlw_lines":[]},{"type":"verse","verse_numbers":[37],"lines":["¡Oye bien esto: Nada puedes hacer","sin que Dios te lo ordene!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[38],"lines":["¡Todo lo bueno y lo malo","pasa porque él así lo ordena!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[39],"lines":["¡No tenemos razón para quejarnos","si nos castiga por nuestros pecados!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[40,41,42],"lines":["Si pecamos contra Dios,","y él no quiere perdonarnos,","pensemos en qué lo hemos ofendido.","Dirijamos al Dios del cielo","nuestras oraciones más sinceras,","y corrijamos nuestra conducta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[43,44],"lines":["Una nube envuelve a Dios;","no le deja escuchar nuestra oración.","Lleno de enojo, Dios nos persigue;","nos destruye sin ninguna compasión."],"rlw_lines":[]},{"type":"verse","verse_numbers":[45],"lines":["Nos ha expuesto ante las naciones","como si fuéramos lo peor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[46],"lines":["Fuimos la burla del enemigo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[47],"lines":["Sufrimos en carne propia","los horrores de la destrucción."],"rlw_lines":[]},{"type":"verse","verse_numbers":[48],"lines":["Cuando vi destruida mi ciudad","no pude contener las lágrimas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[49,50,51],"lines":["Realmente me duele ver sufrir","a las mujeres de Jerusalén.","Se me llenan de lágrimas los ojos,","pero no hay quien me consuele.","¡Espero que desde el cielo","Dios nos mire y nos tenga compasión!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[52,53],"lines":["¡Intentaron matarme,","y no sé por qué razón!","Mis enemigos me atraparon,","me encerraron en un pozo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[54],"lines":["Estuve a punto de ahogarme;","¡creí que había llegado mi fin!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[55],"lines":["En la profundidad de ese pozo","te pedí ayuda, Dios mío,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[56],"lines":["y tú atendiste mis ruegos;","¡escuchaste mi oración!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[57],"lines":["Te llamé, y viniste a mí;","me dijiste que no tuviera miedo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[58],"lines":["No me negaste tu ayuda,","sino que me salvaste la vida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[59],"lines":["Dios mío, ¡ayúdame!","Mira el mal que me causaron,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[60],"lines":["mira el mal que piensan hacerme,","¡quieren vengarse de mí!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[61],"lines":["Tú sabes cómo me ofenden;","tú sabes que me hacen daño."],"rlw_lines":[]},{"type":"verse","verse_numbers":[62],"lines":["Tú bien sabes que mis enemigos","siempre hacen planes contra mí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[63],"lines":["¡Míralos! No importa lo que hagan,","siempre están burlándose de mí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[64,65,66],"lines":["¡Espero que los castigues","con toda tu furia!","¡Bórralos de este mundo!","Mi Dios, ¡dales su merecido","por todo lo que han hecho!","¡Maldícelos y hazlos sufrir!"],"rlw_lines":[]}]}}