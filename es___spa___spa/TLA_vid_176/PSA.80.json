    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Muéstranos tu bondad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: Este himno deberá cantarse con la melodía «Los lirios del pacto»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1,
          2
        ],
        "lines": [
          "1-2 (2-3) Dios y Pastor nuestro,",
          "tú guiaste como a un rebaño",
          "a tu pueblo Israel,",
          "tú reinas entre los querubines,",
          "¡ahora escúchanos!",
          "¡Hazte presente y muestra tu poder",
          "a las tribus de Efraín,",
          "de Manasés y de Benjamín!",
          "¡Ven a salvarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Dios nuestro,",
          "¡cambia nuestra triste situación!",
          "¡Muéstranos tu bondad y sálvanos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Dios nuestro, Señor del universo,",
          "¿hasta cuándo, por tu enojo,",
          "no atenderás la oración de tu pueblo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) En vez de comida,",
          "nos has dado el pan amargo",
          "que nuestras lágrimas amasaron;",
          "en vez de bebida,",
          "has hecho que nos bebamos",
          "nuestras propias lágrimas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Has hecho que nuestros vecinos",
          "se burlen de nosotros;",
          "¡nos ven, y se ríen de nosotros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Dios del universo,",
          "¡cambia nuestra triste situación!",
          "¡Muéstranos tu bondad y sálvanos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Nosotros somos como una vid",
          "que trajiste de Egipto,",
          "y para plantarnos en esta tierra",
          "echaste fuera a las naciones;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) una vez limpio el terreno,",
          "nosotros echamos raíces",
          "y nos extendimos por todo el país."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) De tal manera crecimos",
          "que llegamos a poblar las montañas;",
          "¡extendimos nuestro dominio",
          "hasta las montañas del Líbano!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Nuestra frontera oriental",
          "llegó hasta el río Éufrates;",
          "nuestra frontera occidental",
          "llegó hasta el mar Mediterráneo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12,
          13,
          14
        ],
        "lines": [
          "12-14 (13-15) Dios del universo,",
          "¿por qué dejaste a tu vid",
          "sin tu protección?",
          "Todos nuestros enemigos",
          "pasan y nos hacen daño;",
          "¡nos devoran como fieras!",
          "¡Deja ya de castigarnos!",
          "¡Asómate desde el cielo",
          "y muéstranos tu cariño!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "15 (16) ¡Tú mismo nos plantaste!",
          "¡Tú mismo nos cuidaste!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "16 (17) El enemigo nos ha derrotado;",
          "le ha prendido fuego a nuestras ciudades.",
          "¡Repréndelos, destrúyelos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "17 (18) Pero no dejes de apoyar",
          "al pueblo en quien confías,",
          "al pueblo que has fortalecido;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "18 (19) así, no nos apartaremos de ti.",
          "¡Danos vida, y te alabaremos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "19 (20) Dios nuestro, Señor del universo,",
          "¡cambia nuestra triste situación!",
          "¡Muéstranos tu bondad y sálvanos!"
        ],
        "rlw_lines": []
      }
    ]
  },
