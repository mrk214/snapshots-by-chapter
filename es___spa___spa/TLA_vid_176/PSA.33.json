{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.33","is_chapter":true,"previous":{"usfm":"PSA.32","human":"Salmos 32","canonical":true,"toc":true},"current":{"usfm":"PSA.33","human":"Salmos 33"},"next":{"usfm":"PSA.34","human":"Salmos 34","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Alabanzas al Dios creador"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Ustedes, pueblo de Dios,","¡canten a Dios con alegría!","En labios de gente sincera,","suenan bien las alabanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["¡Alaben a Dios con himnos","y con música de arpas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["¡Alábenlo con buena música!","Cántenle canciones","nunca antes escuchadas,","y lancen gritos en su honor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4,5],"lines":["Dios es digno de confianza;","Dios ama lo que es justo y recto.","Por todas partes se pueden ver","sus grandes actos de bondad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Con su sola palabra","Dios hizo los cielos,","el sol, la luna y las estrellas,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["y juntó en un solo lugar","el agua de todos los mares."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Habitantes de toda la tierra,","¡honren a Dios!","Habitantes del mundo entero,","¡muéstrenle reverencia!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Él creó todo lo que existe","por medio de su palabra.","Bastó una orden suya","para que todo quedara firme."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Dios no deja que las naciones","lleven a cabo sus planes;","Dios no deja que los pueblos","realicen sus planes malvados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Pero Dios cumple sus propios planes,","y realiza sus propósitos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["¡Dios mío,","tú bendices al pueblo","que te reconoce como Dios!","¡Tú bendices a la nación","que te acepta como dueño!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13,14],"lines":["Desde tu trono en el cielo","te fijas en toda la gente;","desde tu trono vigilas","a todos los habitantes del mundo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Tú creaste la mente humana","y sabes bien lo que todos hacen."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["No hay rey que se salve","por tener muchos soldados,","ni hay valiente que se libre","por tener mucha fuerza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["De nada sirven los caballos","para ganar una guerra,","pues a pesar de su fuerza","no pueden salvar a nadie."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Pero tú cuidas siempre","de quienes te respetan","y confían en tu amor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["En tiempos de escasez,","no los dejas morir de hambre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Tú nos das tu ayuda,","nos proteges como escudo.","Por eso confiamos en ti."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Nuestro corazón se alegra","porque en ti confiamos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Dios nuestro,","¡que nunca nos falte tu amor,","pues eso esperamos de ti!"],"rlw_lines":[]}]}}