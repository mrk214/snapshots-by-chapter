{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.37","is_chapter":true,"previous":{"usfm":"PSA.36","human":"Salmos 36","canonical":true,"toc":true},"current":{"usfm":"PSA.37","human":"Salmos 37"},"next":{"usfm":"PSA.38","human":"Salmos 38","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Triunfo del bueno, fracaso del malvado"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["(1a) Himno de David."],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["1 (1b) No te enojes","por causa de los malvados,","ni sientas envidia","de los malhechores,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["pues son como la hierba","que al cortarla pronto se seca."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Tú debes confiar en Dios.","Dedícate a hacer el bien,","establécete en la tierra","y mantente fiel a Dios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Entrégale a Dios tu amor,","y él te dará lo que más deseas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Pon tu vida en sus manos,","confía plenamente en él,","y él actuará en tu favor;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["así todos verán con claridad","que tú eres justo y recto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Calla en presencia de Dios,","y espera paciente a que actúe;","no te enojes","por causa de los que prosperan","ni por los que hacen planes malvados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["No des lugar al enojo","ni te dejes llevar por la ira;","eso es lo peor que puedes hacer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Los malvados serán destruidos,","pero los que esperan en Dios","recibirán la tierra prometida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Dentro de poco no habrá malvados;","podrás buscar y rebuscar,","pero no encontrarás uno solo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["En cambio, la gente humilde","recibirá la tierra prometida","y disfrutará de mucha paz."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Los malvados, en su enojo,","miran con rabia a los buenos","y buscan hacerles mal;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["pero Dios se burla de ellos,","pues sabe que pronto serán destruidos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Los malvados sacan la espada","y preparan sus arcos y flechas","para matar a la gente pobre,","a los que viven honradamente."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["¡Pero sus arcos y sus flechas","quedarán hechos pedazos,","y será su propia espada","la que les parta el corazón!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Más vale un pobre honrado","que muchos ricos malvados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Dios pondrá fin","al poder de los malvados,","pero apoyará a los que son honrados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Dios conoce la conducta","de los que viven honradamente;","la tierra prometida","será de ellos para siempre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Cuando lleguen los días malos","no pasarán vergüenzas;","cuando otros no tengan comida,","a ellos les sobrará."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Los malvados serán destruidos;","¡se desvanecerán como humo!","Los enemigos de Dios se marchitarán","como si fueran flores silvestres."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Los malvados piden prestado","y nunca pagan sus deudas,","pero los justos prestan","y dan con generosidad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Los que Dios ha bendecido","vivirán en la tierra prometida,","pero los que él ha maldecido","serán eliminados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Cuando a Dios le agrada","la conducta de un hombre,","lo ayuda a mantenerse firme."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Tal vez tenga tropiezos,","pero no llegará a fracasar","porque Dios le dará su apoyo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Ni antes cuando era joven,","ni ahora que ya soy viejo,","he visto jamás gente honrada","viviendo en la miseria,","ni tampoco que sus hijos","anden pidiendo pan."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Cuando la gente honrada regala algo,","siempre lo hace con generosidad;","sus hijos son una bendición."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Así que aléjate de la maldad","y haz siempre lo bueno,","así te quedarás para siempre","en la tierra prometida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28,29],"lines":["Dios ama la justicia","y jamás abandonará a su pueblo.","¡Siempre lo protegerá!","Los suyos vivirán para siempre","en la tierra prometida,","pero los malvados y sus hijos","serán destruidos por completo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Cuando los buenos hablan,","lo hacen siempre con sabiduría,","y siempre dicen lo que es justo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Siempre tienen presentes","las enseñanzas de su Dios;","por eso jamás tienen tropiezos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["Los malvados espían a los buenos","para matarlos cuando menos lo esperan,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["pero Dios no permite","que caigan en sus manos;","y si los llevan a juicio,","no permite que los condenen."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Pero tú, confía en Dios","y cumple su voluntad.","Él te pondrá muy en alto","y te dará la tierra prometida.","¡Ya verás con tus propios ojos","cuando los malvados sean destruidos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["A mí me ha tocado ver","a gente malvada y grosera,","que se extiende por todos lados","como si fuera un árbol frondoso."],"rlw_lines":[]},{"type":"verse","verse_numbers":[36],"lines":["Pero esa gente pronto pasa;","en un instante deja de existir;","cuando la buscas, ya no la encuentras."],"rlw_lines":[]},{"type":"verse","verse_numbers":[37],"lines":["Fíjate bien en la gente honrada,","observa a los que hacen lo bueno;","para esta gente de paz","hay un futuro brillante,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[38],"lines":["pero los pecadores","serán todos destruidos;","¡el único futuro de los malvados","es su total destrucción!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[39],"lines":["Dios salva a los buenos.","Cuando llegan los días malos,","Dios es su único refugio."],"rlw_lines":[]},{"type":"verse","verse_numbers":[40],"lines":["Dios les brinda su ayuda","y los salva de los malvados;","les da la victoria","porque en él confían."],"rlw_lines":[]}]}}