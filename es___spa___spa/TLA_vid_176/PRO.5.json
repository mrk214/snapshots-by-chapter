    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertencias contra la mujer infiel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Querido jovencito,",
          "atiende a mis sabios consejos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "para que cuando hables",
          "lo hagas con sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "La mujer infiel te engaña",
          "con palabras suaves y dulces,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "que al fin de cuentas",
          "resultan más amargas que la hiel",
          "y más peligrosas que una espada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quien se enreda con ella,",
          "¡va derecho a la tumba!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A ella no le importa",
          "lo que digan de su conducta;",
          "lleva una vida sin control,",
          "pero no lo reconoce."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Querido jovencito, escúchame:",
          "¡no desprecies mis consejos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Apártate de esa mujer",
          "y no te acerques a su casa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "o acabarás entregando tu salud",
          "y los mejores años de tu vida",
          "a gente cruel y peligrosa;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡todo tu salario, y el dinero",
          "que con tanto esfuerzo te ganaste,",
          "irá a parar en otras manos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11,
          12
        ],
        "lines": [
          "Cuando te hayas quedado pobre,",
          "dirás entre llantos y lamentos:",
          "«¡Pobre de mí, pobre de mí!",
          "¡Nunca acepté ningún consejo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Jamás les hice caso a mis maestros,",
          "ni obedecí a los que me orientaban."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡Ahora estoy casi en la desgracia",
          "ante toda la comunidad!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sé fiel a tu esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Si quieres disfrutar del amor,",
          "disfrútalo con tu esposa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Guarda tu amor solo para ella!",
          "¡No se lo des a ninguna otra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No compartas con nadie",
          "el gozo de tu matrimonio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¡Bendita sea tu esposa,",
          "la novia de tu juventud!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Es como una linda venadita;",
          "deja que su amor y sus caricias",
          "te hagan siempre feliz."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios mira tu conducta"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Querido jovencito,",
          "no dejes que otra mujer te cautive",
          "ni busques las caricias",
          "de la mujer casada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Dios mira con mucha atención",
          "la conducta de todos nosotros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "El pecado y las malas acciones",
          "son trampas para el malvado,",
          "y lo hacen su prisionero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Así muere esta clase de gente",
          "que no quiere ser corregida;",
          "¡su falta de entendimiento",
          "acaba por destruirla!"
        ],
        "rlw_lines": []
      }
    ]
  },
