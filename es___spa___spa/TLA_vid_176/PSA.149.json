    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabemos a Dios, nuestro rey"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Alabemos a nuestro Dios!",
          "¡Alabémoslo todos juntos,",
          "pues somos su pueblo fiel!",
          "¡Cantémosle un cántico nuevo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nosotros, los israelitas",
          "que vivimos en Jerusalén,",
          "cantemos alegres a Dios,",
          "nuestro creador y rey;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3,
          4
        ],
        "lines": [
          "pues él se agrada de su pueblo",
          "y da la victoria a los humildes.",
          "¡Alabémoslo con danzas!",
          "¡Cantémosle himnos",
          "con música de arpas y panderos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pueblo fiel de Dios,",
          "¡alégrate por la victoria obtenida!",
          "Aunque estés dormido,",
          "¡grita de alegría!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Lanza a voz en cuello",
          "alabanzas a tu Dios,",
          "y toma entre tus manos",
          "una espada de dos filos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para que tomes venganza",
          "de pueblos y naciones;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "para que pongas cadenas de hierro",
          "sobre reyes y gobernantes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para que se cumpla la sentencia",
          "que Dios dictó contra ellos.",
          "Pueblo fiel de Dios,",
          "¡esto será para ti",
          "un motivo de orgullo!",
          "¡Alabemos a nuestro Dios!"
        ],
        "rlw_lines": []
      }
    ]
  },
