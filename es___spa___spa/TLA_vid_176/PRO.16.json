    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Planes humanos, respuesta de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El hombre propone",
          "y Dios dispone."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Todo el mundo cree hacer lo mejor,",
          "pero Dios juzga las intenciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Deja en manos de Dios",
          "todo lo que haces,",
          "y tus proyectos se harán realidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todo lo que Dios hace",
          "tiene un propósito;",
          "¡hasta creó al malvado",
          "para el día del castigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios no soporta a los orgullosos,",
          "y una cosa es segura:",
          "no los dejará sin castigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El pecado se perdona",
          "cuando se ama de verdad;",
          "uno se aleja del mal",
          "cuando obedece a Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuando Dios está contento",
          "con nuestro comportamiento,",
          "hasta con nuestros enemigos",
          "nos hace vivir en paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Más vale ser pobre pero honrado,",
          "que ser rico pero tramposo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El hombre planea su futuro,",
          "pero Dios le marca el rumbo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No hay rey que cometa errores,",
          "si deja que Dios lo aconseje."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios quiere que seas honrado",
          "en todos tus negocios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ningún rey soporta a los malvados;",
          "todo buen reinado depende",
          "de que se practique la justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Los reyes aprecian a la gente",
          "que les habla con la verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El enojo del rey",
          "es amenaza de muerte;",
          "el que es sabio procura calmarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "La sonrisa del rey",
          "es promesa de vida;",
          "contar con su apoyo",
          "es recibir un premio inesperado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "La sabiduría y el entendimiento",
          "valen más que el oro y la plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "La gente honrada se aparta del mal,",
          "y así protege su vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El orgulloso y arrogante",
          "al fin de cuentas fracasa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Vale más compartir",
          "la pobreza de los humildes",
          "que las riquezas de los orgullosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El buen administrador prospera;",
          "¡Dios bendice a quienes en él confían!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Al que piensa bien las cosas",
          "se le llama inteligente;",
          "quien habla con dulzura",
          "convence mejor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "El que piensa antes de actuar",
          "vivirá por muchos años,",
          "pero es una tontería",
          "corregir a los tontos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Quien piensa bien las cosas",
          "se fija en lo que dice;",
          "quien se fija en lo que dice",
          "convence mejor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Las palabras amables",
          "son como la miel:",
          "endulzan la vida",
          "y sanan el cuerpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Hay quienes piensan",
          "que está bien todo lo que hacen,",
          "pero al fin de cuentas",
          "acaban en la tumba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Mientras más hambre se tiene,",
          "más duro se trabaja."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El malvado es un horno lleno de maldad;",
          "sus palabras queman como el fuego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "El que es malvado y chismoso",
          "provoca peleas y causa divisiones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "El violento engaña a su amigo,",
          "y lo lleva por camino de maldad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Quien te hace señas con los ojos",
          "y te sonríe sin razón,",
          "algo malo trama contra ti,",
          "o algo malo ha cometido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Llegar a viejo es una honra;",
          "las canas son la corona",
          "que se gana por ser honrado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Vale más ser paciente que valiente;",
          "vale más dominarse uno mismo",
          "que dominar a los demás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "El hombre propone,",
          "y Dios dispone."
        ],
        "rlw_lines": []
      }
    ]
  },
