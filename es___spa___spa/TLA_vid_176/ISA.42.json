{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.42","is_chapter":true,"previous":{"usfm":"ISA.41","human":"Isaías 41","canonical":true,"toc":true},"current":{"usfm":"ISA.42","human":"Isaías 42"},"next":{"usfm":"ISA.43","human":"Isaías 43","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["El elegido de Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Dios dijo:","«¡Miren a mi elegido,","al que he llamado a mi servicio!","Él cuenta con mi apoyo;","yo mismo lo elegí,","y él me llena de alegría.","»He puesto en él mi espíritu,","y hará justicia entre las naciones."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Mi fiel servidor no gritará,","no levantará la voz,","ni se le oirá en las calles."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["No les causará más daño","a los que estén heridos,","ni acabará de matar","a los que estén agonizando.","Al contrario, fortalecerá a los débiles","y hará que reine la justicia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["No tendrá un momento de descanso","hasta que haya establecido","la justicia en esta tierra.","¡Los países de las islas del mar","esperan recibir sus enseñanzas!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Dios le dijo a su fiel servidor:","«Yo soy Dios,","yo soy el creador del cielo;","yo soy quien formó la tierra","y todo lo que en ella crece;","yo soy quien da vida y aliento","a los hombres y a las mujeres","que habitan este mundo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["»Yo soy el Dios único;","yo te llamé y te tomé de la mano","para que hagas justicia,","para que seas ante mi pueblo","señal de mi pacto con ellos,","para que seas ante las naciones","la luz que las ilumine."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["»Esto quiero de ti:","que abras los ojos de los ciegos,","que des libertad a los presos,","y que hagas ver la luz","a los que viven en tinieblas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["»Yo soy el Dios todopoderoso.","Ese es mi nombre.","No permito que otros dioses reciban","la honra y la alabanza","que solo yo merezco recibir."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Lo que antes anuncié","ya se ha cumplido,","y ahora les anuncio cosas nuevas","que aún están por ocurrir»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Gracias a Dios por la salvación"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Isaías dijo:","«Canten a Dios","una canción nueva.","¡Que lo alaben","los países más lejanos!","¡Que lo alaben el mar","y todo lo que hay en él!","¡Que lo alaben las costas lejanas","y todos sus habitantes!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["»¡Alégrense ustedes,","ciudades del desierto!","¡Alégrense también ustedes,","campamentos de la tribu de Quedar!","¡Canten de gozo ustedes,","habitantes de Selá!","¡Hagan oír su canto","desde la cumbre de los montes!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["¡Den gloria a Dios","y alábenlo en todas partes!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Dios saldrá marchando","con toda la furia de un guerrero:","¡lanzará un grito de guerra","y derrotará a sus enemigos!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Dios dijo:","«Yo estuve callado","durante mucho tiempo;","he guardado silencio","y no he dicho nada;","pero ahora voy a gritar:","voy a gemir como una mujer","a punto de tener un hijo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Voy a acabar con montañas y cerros;","voy a secar todas sus plantas;","voy a convertir sus ríos","en lugares desiertos,","y a dejar sin agua las lagunas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Llevaré a los ciegos por caminos","que nunca antes conocieron;","los guiaré por senderos","que nunca antes transitaron,","y convertiré en luz sus tinieblas.","Convertiré los caminos rocosos","en sendas totalmente llanas.","Todo esto voy a hacerlo","porque no he abandonado a mi pueblo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["»Esos que confían en los ídolos,","esos que adoran a las estatuas,","se alejarán de ellos llenos de vergüenza»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Israel, pueblo ciego y sordo"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Isaías dijo:","«¡Sordos, escuchen!","¡Ciegos, miren con atención!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Israel está al servicio de Dios;","él lo eligió como su mensajero;","¡pero no hay otro pueblo","más ciego ni más sordo","que el pueblo de Israel!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Ha visto muchas cosas,","pero no ha prestado atención;","tiene abiertos los oídos,","pero no ha escuchado nada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["»Dios es un Dios que salva,","y quiso que su enseñanza","fuera maravillosa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Pero Israel es un pueblo","que todo lo ha perdido;","sus enemigos le han quitado","todo lo que tenía;","unos se esconden en cuevas","y otros son hechos prisioneros,","¡y no hay nadie que los libre!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["A pesar de todo esto,","Israel no quiere obedecer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["»Dios permitió que Israel","fuera vencido y secuestrado.","Israel pecó contra Dios;","no quiso andar por el camino","que Dios le había señalado,","ni quiso obedecer sus enseñanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Por eso Dios se enojó con ellos,","los hizo entrar en guerra","y con fuego los castigó.","¡Pero ni así lo obedecieron!»"],"rlw_lines":[]}]}}