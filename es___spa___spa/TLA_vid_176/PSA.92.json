    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Qué bueno es alabar a Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno para cantarlo el día de reposo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios altísimo,",
          "¡qué bueno es poder alabarte",
          "y cantarte himnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) ¡Qué bueno es poder alabar",
          "tu amor y tu fidelidad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Día y noche te alabaré",
          "con música de arpas y liras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4,
          5
        ],
        "lines": [
          "4-5 (5-6) Dios mío,",
          "quiero gritar de alegría",
          "por todo lo que has hecho;",
          "todo lo que haces es impresionante",
          "y me llena de felicidad.",
          "Tus pensamientos son tan profundos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) que la gente ignorante",
          "ni los conoce ni los entiende."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Aunque los malvados y los malhechores",
          "se multiplican por todas partes,",
          "un día serán destruidos para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Solo tú, mi Dios,",
          "reinas por siempre en el cielo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) ¡Tus enemigos serán destruidos!",
          "¡Todos los malhechores serán derrotados!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Tú has llenado mi vida de poder;",
          "de ti he recibido un trato especial,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) y he podido presenciar",
          "la derrota de mis enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12,
          13
        ],
        "lines": [
          "12-13 (13-14) Dios nuestro, en tu presencia",
          "la gente buena crece y prospera",
          "como palmeras bien plantadas,",
          "¡como los cedros del Líbano!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "14 (15) Vivirán muchos años,",
          "se mantendrán sanos y fuertes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "15 (16) Siempre hablarán de tu justicia",
          "y de tu constante protección."
        ],
        "rlw_lines": []
      }
    ]
  },
