    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Creación y palabra"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) El cielo azul nos habla",
          "de la grandeza de Dios",
          "y de todo lo que ha hecho."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Los días y las noches",
          "lo comentan entre sí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Aunque no hablan ni dicen nada,",
          "ni se oye un solo sonido,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) sus palabras recorren toda la tierra",
          "y llegan hasta el fin del mundo.",
          "En el cielo Dios ha puesto",
          "una casa para el sol."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Y sale el sol de su casa",
          "feliz como un novio;",
          "alegre como un atleta,",
          "se dispone a recorrer su camino."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Sale por un lado",
          "y se oculta por el otro,",
          "sin que nada ni nadie",
          "se libre de su calor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) La ley de Dios es perfecta,",
          "y nos da nueva vida.",
          "Sus mandatos son dignos de confianza,",
          "pues dan sabiduría a los jóvenes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Las normas de Dios son rectas",
          "y alegran el corazón.",
          "Sus mandamientos son puros",
          "y nos dan sabiduría."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) La palabra de Dios es limpia",
          "y siempre se mantiene firme.",
          "Sus decisiones son al mismo tiempo",
          "verdaderas y justas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Yo prefiero sus decisiones",
          "más que montones de oro,",
          "me endulzan la vida",
          "más que la miel del panal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Me sirven de advertencia;",
          "el premio es grande",
          "si uno cumple con ellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Nadie parece darse cuenta",
          "de los errores que comete.",
          "¡Perdóname, Dios mío,",
          "los pecados que cometo",
          "sin darme cuenta!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (14) ¡Líbrame del orgullo!",
          "¡No dejes que me domine!",
          "¡Líbrame de la desobediencia",
          "para no pecar contra ti!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "14 (15) ¡Tú eres mi Dios y mi protector!",
          "¡Tú eres quien me defiende!",
          "¡Recibe, pues, con agrado",
          "lo que digo y lo que pienso!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
