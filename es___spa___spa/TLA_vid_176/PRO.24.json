    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-19-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No envidies ni busques",
          "la amistad de los malvados,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "pues solo piensan en la violencia",
          "y solo hablan de matar."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-20-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Construye tu casa",
          "con sabiduría y entendimiento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "y llena sus cuartos de conocimiento",
          "que es el más bello tesoro."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-21-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Más vale maña que fuerza;",
          "más vale el saber que el poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quien quiera pelear,",
          "primero debe pensar;",
          "quien quiera ganar,",
          "debe saber escuchar."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-22-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El necio nunca llegará a ser sabio.",
          "Cuando está ante el juez,",
          "ni siquiera abre la boca,",
          "pues no sabe qué decir."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-23-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El que solo piensa en la maldad",
          "se gana el título de malvado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El que solo piensa en pecar",
          "se gana el título de necio.",
          "¡Y nadie los aguanta!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-24-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quien se rinde ante un problema,",
          "no demuestra fuerza ni carácter."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-25-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Haz cuanto puedas por salvar",
          "a los que van camino a la muerte,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "porque Dios todo lo sabe",
          "y no podrás alegar ignorancia.",
          "¡Si no lo haces, recibirás tu merecido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-26-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Una delicia al paladar",
          "es la dulce miel del panal!",
          "Cómela, jovencito;",
          "¡saboréala!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Quiera Dios que en la sabiduría",
          "halles esa misma dulzura.",
          "Si la encuentras, tendrás buen futuro",
          "y tus deseos se verán cumplidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-27-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "No tiendas trampas al hombre honrado",
          "ni destruyas la casa donde vive."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "No importa cuántas veces caiga,",
          "siempre se levantará.",
          "En cambio, el malvado cae",
          "y no vuelve a levantarse."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-28-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No te burles de tu enemigo",
          "cuando lo veas fracasar,",
          "ni te alegres de su desgracia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "si Dios te ve,",
          "no aprobará tu conducta",
          "y se enojará contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-29-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "No te enojes con los malvados",
          "ni les tengas envidia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "pues no tendrán un final feliz;",
          "¡su vida será una lámpara apagada!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-30-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Querido jovencito,",
          "obedece a Dios y al rey,",
          "y no te juntes con gente rebelde,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "pues tal vez Dios los castigue",
          "cuando tú menos lo esperes,",
          "¡y quién sabe qué puede pasar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Otra colección de proverbios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "La siguiente es otra lista de dichos:",
          "Todo juez debe ser justo",
          "y no favorecer a nadie."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Si declara inocente al culpable,",
          "merece que todo el mundo",
          "lo maldiga y lo desprecie."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Si condena al culpable,",
          "es bien visto y alabado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Una respuesta sincera",
          "es tan dulce como un beso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Si piensas construir tu casa,",
          "atiende primero a tus negocios,",
          "y no desatiendas a tu familia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "No des falso testimonio",
          "ni mientas en contra de tu amigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Nunca pienses en la venganza,",
          "¡abandona esa idea!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "En cierta ocasión pasé",
          "por el campo y por la viña",
          "de un tipo tonto y perezoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Por todos lados vi espinas.",
          "El terreno estaba lleno de hierba,",
          "y la cerca de piedras, derribada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Lo que vi jamás se me olvidó,",
          "y de allí saqué una lección:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Si te duermes un poco",
          "y te tomas la siesta,",
          "y si tomas un descansito",
          "y te cruzas de brazos…"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "acabarás en la más terrible pobreza."
        ],
        "rlw_lines": []
      }
    ]
  },
