{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"JOB","name":"Job"},"chapter":{"chapter_usfm":"JOB.22","is_chapter":true,"previous":{"usfm":"JOB.21","human":"Job 21","canonical":true,"toc":true},"current":{"usfm":"JOB.22","human":"Job 22"},"next":{"usfm":"JOB.23","human":"Job 23","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Tercera participación de Elifaz"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Entonces respondió Elifaz:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["«Tú podrás ser muy sabio,","pero eso a Dios no le sirve de nada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Nada gana el Dios todopoderoso","con que seas un hombre bueno."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Si realmente obedecieras a Dios,","él no te reclamaría nada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["¡Pero tu maldad es demasiada,","y tus pecados ni se pueden contar!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Y hasta por deudas pequeñas","exigiste ropa en garantía,","¡y dejaste desnudo al pobre!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["No dabas agua al que tenía sed,","ni comida al que tenía hambre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Fuiste un hombre poderoso","que se adueñó de la tierra;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["a las viudas no les diste nada,","y a los huérfanos les quitaste todo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Por eso ahora te ves atrapado,","y de pronto te asustas,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["como si anduvieras en la oscuridad,","o la corriente de un río te arrastrara."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["»Dios está en los cielos,","entre las altas y lejanas estrellas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13,14],"lines":["Vive entre espesas nubes,","pero eso no le impide","ver y saber lo que haces.","Si crees que no puede vernos,","recuerda que él recorre el cielo","de un extremo al otro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["»Si quieres seguir","el ejemplo de los malvados,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["recuerda que ellos murieron","en plena juventud,","cuando un río destruyó sus casas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17,18],"lines":["Aunque el Dios todopoderoso","les dio todo lo mejor,","ellos le exigieron","que los dejara tranquilos.","No creyeron que él los castigaría.","¡Pero yo no pienso como ellos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["»La gente buena e inocente","se burla de los malvados,","y al verlos en desgracia dicen:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["“¡El fuego ha destruido","las riquezas de nuestros enemigos!”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["»Job, ponte en paz con Dios;","y él te hará prosperar de nuevo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22,23],"lines":["Vuelve la mirada al Todopoderoso;","apréndete de memoria sus enseñanzas,","y él te devolverá la felicidad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24,25],"lines":["Arroja entre las piedras de los ríos","todo el oro y la plata que tienes,","y tu riqueza será Dios mismo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Él te hará muy feliz,","y ya no sentirás vergüenza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Si tú le cumples tus promesas,","él escuchará tus oraciones;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["entonces te irá bien","en todo lo que hagas,","y tu vida estará siempre iluminada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Dios humilla a los orgullosos,","y levanta a los humildes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Dios salva al que es inocente;","si tú lo eres, también te salvará»."],"rlw_lines":[]}]}}