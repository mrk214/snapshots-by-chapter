    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segunda participación de Elifaz"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces Elifaz le respondió a Job:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2,
          3
        ],
        "lines": [
          "«Si en verdad eres inteligente,",
          "no debieras ser tan violento.",
          "Solo dices tonterías,",
          "y de tu boca no sale nada bueno."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tu falta de respeto a Dios",
          "hace que otros no lo obedezcan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5,
          6
        ],
        "lines": [
          "»No necesito ser tu juez,",
          "pues tus palabras te condenan.",
          "Tienes tan sucia la mente",
          "que solo dices mentiras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Tú no eres el primer hombre",
          "que hubo sobre la tierra.",
          "El mundo ya existía",
          "antes de que nacieras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tampoco eres el único sabio,",
          "ni Dios te pide consejos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Cualquier cosa que tú sepas,",
          "también nosotros la sabemos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Nuestros años y experiencia",
          "nos hacen aun mejores que tu padre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios mismo te consuela",
          "y te habla con cariño,",
          "pero eso no te importa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12,
          13
        ],
        "lines": [
          "»¿Por qué te enojas contra Dios",
          "y hablas más de la cuenta?",
          "¡En tus ojos se ve el odio que sientes!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14,
          15,
          16
        ],
        "lines": [
          "Ante Dios",
          "nadie es puro ni inocente;",
          "ni aun los ángeles lo son.",
          "¿Qué oportunidad tenemos los humanos,",
          "si Dios ni en sus ángeles confía?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "»Job, préstame atención,",
          "voy a decirte lo que sé."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Es la sabiduría que los sabios",
          "aprendieron hace mucho."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡No la aprendieron de gente extraña!",
          "Por eso, como premio,",
          "Dios les dio la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Pero el miedo y el sufrimiento",
          "son el premio de los malvados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Siempre escuchan ruidos extraños,",
          "y cuando se encuentran en paz",
          "no faltan ladrones que los ataquen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22,
          23
        ],
        "lines": [
          "Los malvados no tienen esperanza;",
          "saben que no escaparán de la muerte,",
          "y que acabarán devorados por los buitres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24,
          25,
          26
        ],
        "lines": [
          "Por eso sufren y tienen miedo",
          "como si un rey los atacara;",
          "saben que les viene la desgracia,",
          "pues se atrevieron a desafiar",
          "al Dios todopoderoso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "»La gordura se les nota",
          "en la cara y en la cintura,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28,
          29
        ],
        "lines": [
          "pero acabarán perdiendo",
          "sus terrenos y riquezas,",
          "y al final vivirán en chozas",
          "a punto de derrumbarse."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "No podrán escapar de la muerte,",
          "sino que serán como un árbol",
          "consumido por el fuego;",
          "¡de un soplo, Dios los destruirá!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "»Los malvados no debieran engañarse",
          "ni confiar en ilusiones,",
          "porque de ellas nada sacarán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32,
          33
        ],
        "lines": [
          "Morirán antes de tiempo.",
          "Se quedarán como los viñedos",
          "cuando se les caen las uvas,",
          "y como los árboles de olivo",
          "cuando no llegan a florecer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34,
          35
        ],
        "lines": [
          "Los malvados dejarán de existir;",
          "los que se hacen ricos con engaños",
          "verán sus casas destruidas por el fuego»."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
