    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios nos da paz"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: Este himno deberá cantarse acompañado de instrumentos de cuerda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Tú, Dios mío,",
          "eres mi defensor;",
          "¡respóndeme cuando te llame!",
          "Siempre que tengo problemas,",
          "me ayudas a salir de ellos;",
          "¡compadécete de mí,",
          "y escucha mi oración!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Ustedes los que se creen importantes,",
          "¿me van a seguir insultando,",
          "y jugando con mi honor?",
          "¿Van a seguir",
          "con sus mentiras y engaños?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Sépanlo de una vez:",
          "Dios me muestra su amor",
          "porque le soy fiel;",
          "¡por eso me escucha",
          "cuando lo llamo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) ¡Cuidado, no pequen más!",
          "Cuando llegue la noche",
          "y se acuesten a dormir,",
          "pónganse a pensar",
          "en todo lo que han hecho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Ofrézcanle a Dios",
          "lo que él les ha pedido,",
          "y pongan su confianza en él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) ¡Hazte presente, Dios mío,",
          "y muéstranos tu bondad,",
          "pues no faltan los que dicen",
          "que tú no eres bondadoso!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Hay muchos que son felices",
          "comiendo y bebiendo de más,",
          "pero yo soy muy feliz",
          "porque mi alegría viene de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Cuando me acuesto,",
          "me duermo enseguida,",
          "porque solo tú, mi Dios,",
          "me das tranquilidad."
        ],
        "rlw_lines": []
      }
    ]
  },
