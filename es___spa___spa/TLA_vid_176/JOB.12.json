{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"JOB","name":"Job"},"chapter":{"chapter_usfm":"JOB.12","is_chapter":true,"previous":{"usfm":"JOB.11","human":"Job 11","canonical":true,"toc":true},"current":{"usfm":"JOB.12","human":"Job 12"},"next":{"usfm":"JOB.13","human":"Job 13","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Tercera respuesta de Job"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Job le respondió a Zofar:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["«¡Ustedes se creen los maestros del pueblo!","¡Y piensan que al morir,","se acabarán los sabios!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Pero no creo que ustedes","sean más inteligentes que yo.","¡Ustedes no han dicho nada nuevo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["»Antes, cuando yo llamaba a Dios,","él siempre me respondía;","en cambio, ahora,","hasta mis amigos se burlan de mí;","no soy culpable de nada,","pero todos se burlan de mí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["¡Qué fácil es criticar al que sufre,","cuando no se tienen problemas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Los ladrones creen","que ya dominaron a Dios,","y por eso viven tranquilos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["»Pero pregúntales a las aves,","y también a los animales,","y ellos te lo contarán todo;","¡te darán una gran lección!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Habla con la tierra,","y con los peces del mar,","y hasta ellos te lo dirán."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Ellos saben muy bien","que Dios lo ha creado todo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["¡Dios tiene en sus manos","la vida de todos los seres vivos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Así como el oído capta los sonidos","y la lengua capta los sabores,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["los que han vivido muchos años","captan la sabiduría y el entendimiento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["»Dios tiene sabiduría y poder;","hace planes y estos se cumplen."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Si Dios derriba algo,","nadie puede volver a levantarlo.","Si Dios apresa a alguien,","nadie puede ponerlo en libertad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Si él quiere que no llueva,","todo en el campo se seca;","pero si quiere que llueva,","la tierra entera se inunda."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["En sus manos están","el poder y la sabiduría,","el engañador y el engañado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17,18,19],"lines":["Dios hace que pierdan su puesto","los jueces y los consejeros,","los sacerdotes y los poderosos;","a los reyes los quita del trono","y los hace trabajar como esclavos;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["a los consejeros les calla la boca,","y hace que los ancianos","pierdan su sabiduría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["»Dios pone en vergüenza","a los fuertes y poderosos;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Dios pone al descubierto","las profundidades del sepulcro;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["a las naciones","las hace prosperar o fracasar,","las engrandece o las destruye."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["»A los gobernantes","les hace olvidar su sabiduría","para que no sepan qué hacer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Así andarán a tientas en la oscuridad,","tropezando como ciegos y borrachos."],"rlw_lines":[]}]}}