    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primera respuesta de Elifaz"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Elifaz le dijo a Job:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Puede ser que no te guste",
          "lo que tengo que decirte,",
          "pero no puedo quedarme callado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Si bien recuerdo,",
          "tú fuiste maestro de muchos",
          "y animabas a los desanimados;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "palabras no te faltaban",
          "para alentar a los tristes",
          "y apoyar a los débiles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero ahora que sufres,",
          "no lo soportas",
          "y te das por vencido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Según tú, no haces nada malo,",
          "¿por qué entonces desconfías de Dios?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»¡No me vayas a decir",
          "que quien hace lo bueno",
          "sufre y acaba mal!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "He podido comprobar",
          "que quien mal anda mal acaba."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "»Cuando Dios se enoja,",
          "con un soplo destruye al malvado,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10,
          11
        ],
        "lines": [
          "y aunque ruja o gruña como león,",
          "Dios le romperá los dientes.",
          "Como no podrá comer,",
          "se morirá de hambre,",
          "y sus hijos tendrán que huir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Alguien me confió un secreto,",
          "que apenas pude escuchar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mientras todo el mundo dormía,",
          "tuve un sueño, y perdí la calma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡Fue tanto el miedo que sentí,",
          "que todo el cuerpo me temblaba!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Sentí en la cara un viento helado,",
          "y se me erizaron los pelos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Sabía que alguien estaba allí,",
          "pero no podía verlo!",
          "Todo alrededor era silencio.",
          "De pronto oí que alguien decía:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Nadie es mejor que su creador.",
          "¡Ante él, no hay inocentes!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Dios ni en sus ángeles confía,",
          "pues hasta ellos le fallan;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡mucho menos va a confiar",
          "en nosotros los humanos!",
          "Estamos hechos de barro,",
          "y somos frágiles como polillas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20,
          21
        ],
        "lines": [
          "”En esta vida estamos de paso;",
          "un día nacemos",
          "y otro día morimos.",
          "¡Desaparecemos para siempre,",
          "sin que a nadie le importe!",
          "¡Morimos sin llegar a ser sabios!”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
