    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Dios mío, ayúdame!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Dios mío, yo te alabo;",
          "¡no te quedes callado!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Hay un mentiroso y malvado",
          "que miente acerca de mí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tanto odio me tiene",
          "que me ataca sin razón;",
          "¡me tiene acorralado!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Habla mal de mí,",
          "a pesar de que lo amo",
          "y hago oración por él."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me odia, me trata mal,",
          "a pesar de que lo amo",
          "y lo trato bien."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dios mío,",
          "¡págale con la misma moneda!",
          "¡Haz que lo acuse",
          "su propio abogado!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Haz que lo declare culpable",
          "el juez que le dicte sentencia!",
          "¡Haz que lo condenen",
          "sus propias mentiras!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Quítale la vida",
          "antes de tiempo,",
          "y que otro haga su trabajo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Que se queden huérfanos sus hijos!",
          "¡Que deje viuda a su esposa!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Convierte a sus hijos",
          "en vagos y limosneros;",
          "¡haz que los echen",
          "de esas ruinas donde viven!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Que les quiten todo lo que tienen",
          "los que antes les prestaban dinero!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡Que a esos huérfanos",
          "nadie los trate con cariño",
          "ni les tenga compasión!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Haz que sus descendientes",
          "pronto desaparezcan!",
          "¡Haz que en el futuro",
          "nadie recuerde que existieron!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Dios mío,",
          "no te olvides nunca",
          "de la maldad de su padre",
          "ni del pecado de su madre,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "y que nadie recuerde que existieron.",
          "No pierdas de vista a mi enemigo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "pues jamás se le ocurrió",
          "ser bondadoso con nadie;",
          "persiguió a los pobres,",
          "a los humildes y necesitados,",
          "hasta quitarles la vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17,
          18
        ],
        "lines": [
          "Ya que le encantaba maldecir,",
          "¡que le caiga una maldición!",
          "Ya que no le gustaba bendecir,",
          "¡que nadie lo bendiga!",
          "¡Castígalo donde más le duela!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Que esa maldición",
          "lo cubra como un manto!",
          "¡Que lo apriete hasta ahogarlo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Dios mío,",
          "¡trata así al que me acuse,",
          "y al que mienta contra mí!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Pero a mí, trátame bien;",
          "tú eres un Dios bondadoso,",
          "¡sálvame, por tu gran bondad!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Yo soy pobre y humilde,",
          "y es muy grande mi dolor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Poco a poco me voy debilitando",
          "como las sombras de la noche;",
          "¡hasta parezco una mariposa",
          "sacudida por el viento!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Ya casi no como;",
          "tan flaco estoy",
          "que me tiemblan las rodillas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Cuando la gente me ve,",
          "se ríe y se burla de mí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Dios mío, ¡ayúdame!",
          "Por tu gran amor, ¡sálvame!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Que sepan que esto me sucede",
          "porque tú así lo has querido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Pero si tú me bendices,",
          "no me importa que me maldigan.",
          "Mis enemigos están listos para atacarme,",
          "pero tú los pondrás en vergüenza",
          "y a mí me llenarás de alegría."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29,
          30
        ],
        "lines": [
          "Dios mío,",
          "cubre a mis acusadores",
          "de vergüenza y deshonra.",
          "Yo te daré gracias",
          "con el gran pueblo que te alaba,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "porque tú defiendes a los pobres",
          "y los salvas de los malvados",
          "que los condenan a muerte."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
