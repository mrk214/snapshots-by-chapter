    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios responde a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios le respondió a Job desde la tormenta:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¿Quién eres tú",
          "para dudar de mi sabiduría,",
          "si solo tonterías has dicho?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Vamos a ver qué tan valiente eres!",
          "Ahora yo voy a hablar,",
          "y tú me vas a escuchar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "»Si de veras sabes tanto,",
          "dime dónde estabas",
          "cuando puse las bases de la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Tú no sabes",
          "quién la midió metro a metro,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "quién puso la primera piedra",
          "y en qué descansan sus cimientos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Tú no estabas allí,",
          "mientras cantaban las estrellas",
          "y los ángeles danzaban!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8,
          9,
          10,
          11
        ],
        "lines": [
          "»Dime quién puso límites al mar",
          "cuando este cubrió la tierra;",
          "dime cuándo lo envolví entre nubes",
          "y lo dejé en la oscuridad;",
          "dime cuándo les mandé a las olas",
          "no pasar más allá de la playa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»¿Alguna vez en tu vida",
          "le has dado órdenes al sol",
          "para que comience un nuevo día?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Alguna vez en tu vida",
          "le has dado órdenes a la tierra",
          "para que se quite de encima",
          "a los malvados?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cuando la luz del nuevo día",
          "se asoma tras las montañas,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "los malvados no soportan su luz,",
          "y allí se acaba su poder."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "»¿Has bajado al fondo del mar",
          "para ver dónde nace el agua?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¿Has bajado al reino de la muerte",
          "y visitado a los muertos?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si en verdad lo sabes todo,",
          "dime cuánto mide la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "»¿Sabes dónde viven",
          "la luz y la oscuridad?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Puedes llevarlas al trabajo,",
          "y regresarlas a su casa?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Claro que no!",
          "No has vivido tantos años",
          "ni naciste antes que ellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "»¿Has estado en los depósitos",
          "donde guardo la nieve y el granizo?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Yo los tengo guardados",
          "para los tiempos de guerra",
          "y para castigar a los malvados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¿Sabes hacia dónde",
          "se dirigen los relámpagos,",
          "y a qué regiones de la tierra",
          "viajan los vientos del este?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "¿Sabes quién deja caer",
          "las lluvias torrenciales,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "y quién riega los desiertos,",
          "donde nadie vive?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "¿Quién riega los campos secos",
          "y los convierte en verdes prados?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "¿Quién produce la lluvia y el rocío?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29,
          30
        ],
        "lines": [
          "¡Dime de dónde salen",
          "el hielo y la escarcha,",
          "cuando el agua del mar profundo",
          "se endurece como la roca!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31,
          32
        ],
        "lines": [
          "»¿Puedes hacer que las estrellas",
          "se agrupen en constelaciones",
          "y aparezcan todas las noches?",
          "Allí tienes a la Osa Mayor, a Orión,",
          "las Siete Cabritas y la Cruz del Sur."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "¡Si no sabes gobernar la tierra,",
          "cómo podrías gobernar el cielo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "»¿Puedes ordenar que llueva",
          "con solo levantar la voz?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "¿Puedes darle órdenes al rayo,",
          "y hacer que te obedezca?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Dime quién les dio sabiduría",
          "al gallo y a las otras aves."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Dime si eres capaz",
          "de contar las nubes",
          "y hacer que llueva"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "para humedecer la tierra",
          "cuando esta se reseca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "»Tú no consigues comida",
          "para las leonas y sus cachorros,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "mientras duermen o descansan",
          "en el fondo de sus cuevas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Tú no alimentas a los cuervos,",
          "cuando sus polluelos andan perdidos",
          "y me piden de comer."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
