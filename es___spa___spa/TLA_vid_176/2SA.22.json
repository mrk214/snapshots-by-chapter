    "name": "2 Samuel"
  },
  "chapter": {
    "chapter_usfm": "2SA.22",
    "is_chapter": true,
    "previous": {
      "usfm": "2SA.21",
      "human": "2 Samuel 21"
    },
    "current": {
      "usfm": "2SA.22",
