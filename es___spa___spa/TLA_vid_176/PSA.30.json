    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cambiaste mi tristeza en baile"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David para la dedicación del templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "yo alabo tu grandeza",
          "porque me salvaste del peligro,",
          "porque no dejaste que mis enemigos",
          "se burlaran de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Mi Señor y Dios,",
          "te pedí ayuda, y me sanaste;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) ¡me salvaste de la muerte!",
          "Estaba a punto de morir",
          "¡y me libraste de la tumba!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Ustedes, los que aman a Dios,",
          "alábenlo y cántenle himnos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Cuando Dios se enoja,",
          "el enojo pronto se le pasa;",
          "pero cuando ama,",
          "su amor dura toda la vida.",
          "Tal vez lloremos por la noche,",
          "pero en la mañana estaremos felices."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Yo vivía tan tranquilo",
          "que hasta llegué a pensar",
          "que jamás fracasaría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Tú, mi Dios, en tu bondad,",
          "me habías puesto en lugar seguro,",
          "pero me diste la espalda",
          "y me quedé lleno de espanto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Dios mío, te estoy llamando;",
          "escucha mis ruegos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) ¡Nada ganas con mi muerte!",
          "¡Nada ganas con verme en la tumba!",
          "¡Los muertos no pueden alabarte",
          "ni hablar de tu verdad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Mi Señor y Dios,",
          "¡escúchame y tenme compasión!",
          "¡No me niegues tu ayuda!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Tú cambiaste mi tristeza",
          "y la convertiste en baile.",
          "Me quitaste la ropa de luto",
          "y me pusiste ropa de fiesta,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) para que te cante himnos",
          "y alabe tu poder.",
          "Mi Señor y Dios,",
          "no puedo quedarme callado,",
          "por eso siempre te alabaré."
        ],
        "rlw_lines": []
      }
    ]
  },
