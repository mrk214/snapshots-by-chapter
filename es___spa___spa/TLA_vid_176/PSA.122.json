    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Que haya paz en Jerusalén!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Cántico de David para las peregrinaciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Me da gusto que me digan:",
          "«¡Vamos al templo de Dios!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ciudad de Jerusalén,",
          "¡aquí nos tienes!",
          "¡Ya llegamos a tus portones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ciudad de Jerusalén,",
          "¡construida como punto de reunión",
          "de la comunidad de Israel!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Hasta ti llegan las tribus,",
          "todas las tribus de Israel!",
          "¡Hasta ti llega el pueblo",
          "para adorar a Dios,",
          "tal como él lo ordenó!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "En ti se encuentran",
          "los tribunales de justicia;",
          "en ti se encuentra",
          "el palacio de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por ti le pedimos a Dios:",
          "«¡Que tengas paz, Jerusalén!",
          "»¡Que vivan en paz los que te aman!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Que dentro de tus murallas",
          "y dentro de tus palacios",
          "haya paz y seguridad!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A mis hermanos y amigos",
          "les deseo que tengan paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Y a ti, Jerusalén,",
          "te deseo mucho bienestar",
          "porque en ti se encuentra",
          "el templo de nuestro Dios."
        ],
        "rlw_lines": []
      }
    ]
  },
