    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (40.25) »No puedes pescar un cocodrilo",
          "con un simple anzuelo,",
          "ni atarle la lengua con una cuerda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (40.26) No puedes perforarle la quijada",
          "ni atarle el hocico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (40.27) ¡Un cocodrilo no va a rogarte",
          "que le tengas compasión,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (40.28) ni va a servirte como esclavo",
          "por el resto de su vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (40.29) Tampoco podrás jugar con él",
          "como juegas con los pájaros,",
          "y atarle una cuerda a una pata",
          "para que jueguen tus hijas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (40.30) No se despedaza un cocodrilo",
          "para venderlo en el mercado;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (40.31) ¡las lanzas no le atraviesan",
          "la piel ni la cabeza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (40.32) Si quieres sujetarlo,",
          "acabarás peleando con él,",
          "y te arrepentirás de hacerlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (1) No tiene caso que pienses",
          "en llegar a dominarlo;",
          "¡con solo verlo, caerás desmayado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (2) Si nadie puede con él,",
          "¿quién va a poder conmigo,",
          "que soy el Dios todopoderoso?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (3) ¡Mío es todo lo que hay",
          "debajo del cielo!",
          "¿Quién me puede pedir cuentas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12,
          13
        ],
        "lines": [
          "12-13 (4-5) »No olvides que el cocodrilo",
          "tiene patas muy fuertes",
          "una piel impenetrable,",
          "y un cuerpo enorme",
          "que nadie puede dominar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "14 (6) No hay quien se atreva",
          "a abrirle el enorme hocico",
          "para ver sus filosos colmillos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15,
          16,
          17
        ],
        "lines": [
          "15-17 (7-9) Su cuerpo está cubierto",
          "con hileras de pequeños escudos,",
          "que ni el aire dejan pasar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "18 (10) Cuando el cocodrilo resopla,",
          "sus ojos brillan más que el rayo",
          "y que el sol del nuevo día;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "19 (11) de su hocico salen",
          "chispas de lumbre y llamas de fuego;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20,
          21
        ],
        "lines": [
          "20-21 (12-13) lanza humo por la nariz",
          "y fuego por la boca;",
          "¡parece una olla puesta al fuego!",
          "¡Un soplo suyo enciende la leña!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "22 (14) Es tan fuerte su cuello",
          "que solo de verlo da miedo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "23 (15) la piel más blanda de su cuerpo",
          "es impenetrable;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "24 (16) su pecho es firme como roca",
          "y duro como piedra de molino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "25 (17) Cuando el cocodrilo se sacude,",
          "hasta los más poderosos",
          "tiemblan y echan a correr."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26,
          27,
          28,
          29
        ],
        "lines": [
          "26-29 (18-21) No hay arma capaz de herirlo,",
          "pues rompe el hierro como paja,",
          "y el bronce como madera podrida;",
          "las flechas no lo penetran,",
          "y las piedras de las hondas",
          "tan solo le hacen cosquillas;",
          "golpearlo con un martillo",
          "es como golpearlo con una pluma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "30 (22) Cuando se arrastra por el lodo,",
          "abre surcos como el arado;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "31 (23) cuando se lanza al fondo del lago,",
          "el agua parece una olla hirviendo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "32 (24) y a su paso va dejando",
          "una estela blanca y brillante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "33 (25) El cocodrilo a nadie le teme,",
          "y no hay animal que se le parezca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "34 (26) Desprecia a los poderosos,",
          "pues es el rey de los monstruos»."
        ],
        "rlw_lines": []
      }
    ]
  },
