{"version":{"version_id":176,"local_abbreviation":"TLA","local_title":"Traducción en Lenguaje Actual","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.135","is_chapter":true,"previous":{"usfm":"PSA.134","human":"Salmos 134","canonical":true,"toc":true},"current":{"usfm":"PSA.135","human":"Salmos 135"},"next":{"usfm":"PSA.136","human":"Salmos 136","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Alabanzas a Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["¡Alabemos a Dios!","¡Alábenlo ustedes,","los que lo obedecen!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["¡Alábenlo ustedes,","que siempre están en los patios","del templo de nuestro Dios!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["¡Alabemos a Dios","porque él es bueno!","¡Cantémosle himnos,","porque él es bondadoso!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["¡Nuestro Dios eligió a Israel","para que siempre fuera su pueblo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Yo sé que nuestro Dios,","es más poderoso que todos los dioses."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Dios hace lo que quiere","en el cielo y en la tierra,","en el mar y en sus profundidades."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Dios nos trae las nubes","desde lo más lejano de la tierra.","Dios nos manda los relámpagos","que anuncian la lluvia.","Dios saca el viento","del lugar donde lo tiene guardado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8,9],"lines":["En Egipto hirió de muerte","al hijo mayor de cada familia;","también les quitó la vida","a las primeras crías de los animales.","Hizo señales y milagros","contra el faraón y sus oficiales,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["hirió de muerte a muchos pueblos,","y acabó con reyes poderosos:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["acabó con Sihón, el rey amorreo;","acabó con Og, el rey de Basán;","¡acabó con todos los reyes cananeos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["A su pueblo Israel le entregó","las tierras de esos reyes","para que fueran suyas para siempre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Dios mío,","¡tú vives para siempre!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Tú defiendes a tu pueblo","y le tienes compasión."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Los dioses de otros pueblos","son hechura humana;","¡son ídolos de oro y plata!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["De nada les sirve tener boca,","porque no pueden hablar;","tienen ojos, pero no pueden ver;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["tienen orejas, pero no pueden oír;","¡ni siquiera pueden respirar!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["¡Pues iguales a esos ídolos","son quienes los hacen","y quienes creen en ellos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Israelitas, ¡bendigan a Dios!","Sacerdotes, ¡bendigan al Dios de Israel!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Levitas, ¡bendigan a Dios!","Ustedes, los que lo obedecen,","¡bendigan al Dios de Israel!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["¡Alabemos a nuestro Dios,","el Dios que vive en Jerusalén!","¡Alabémoslo!"],"rlw_lines":[]}]}}