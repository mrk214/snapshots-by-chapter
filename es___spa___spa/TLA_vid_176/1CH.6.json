        "verse_numbers": [
          44
        ],
        "lines": [
          "44 (29) A la izquierda de Hemán se colocaba Etán, descendiente de Merarí. Estos fueron los antepasados de Etán:",
          "Quisí,",
          "Abdí,",
          "Maluc,"
        ],
        "rlw_lines": []
      },
      {
