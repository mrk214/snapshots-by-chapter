    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Qué bello es tu templo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de la Escuela de música de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: Este himno deberá cantarse con la melodía que se canta al exprimir las uvas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios del universo,",
          "¡qué bello es tu templo,",
          "la casa donde vives!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Deseo con toda el alma",
          "estar en los patios de tu templo;",
          "¡me muero por llegar a ellos!",
          "Tú eres el Dios de la vida,",
          "por eso te canto alegre",
          "con todas las fuerzas de mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Mi Dios y rey,",
          "Dios del universo,",
          "cerca de tu altar",
          "gorriones y golondrinas",
          "hallan lugar para sus nidos",
          "y allí ponen a sus polluelos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) ¡Qué felices son",
          "los que viven en tu templo!",
          "¡Nunca dejan de alabarte!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) ¡Qué felices son",
          "los que de ti reciben fuerzas,",
          "y de todo corazón desean",
          "venir hasta tu templo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Cuando cruzan el valle del Llanto,",
          "lo convierten en manantial;",
          "hasta las lluvias tempranas",
          "cubren el valle con sus bendiciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Mientras más avanzan,",
          "más fuerzas tienen,",
          "y cuando llegan a tu templo",
          "te contemplan a ti, el Dios verdadero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Dios mío,",
          "¡atiéndeme!",
          "Dios de Israel,",
          "Dios del universo,",
          "¡escucha mi oración!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Dios y protector nuestro,",
          "muéstranos tu bondad,",
          "pues somos tu pueblo elegido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Prefiero pasar un día en tu templo",
          "que estar mil días lejos de él;",
          "prefiero dedicarme a barrer tu templo",
          "que convivir con los malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Señor y Dios nuestro,",
          "tú nos das calor y protección;",
          "nos das honor y gloria.",
          "Tu bondad no tiene medida",
          "para los que siempre hacen lo bueno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Dios del universo,",
          "¡bendice a los que en ti confían!"
        ],
        "rlw_lines": []
      }
    ]
  },
