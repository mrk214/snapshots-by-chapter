    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»Tiemblo ante la tormenta,",
          "y siento que el corazón",
          "se me sale del pecho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Escuchen la voz de Dios!",
          "¡Escuchen su voz de trueno!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Dios deja oír su voz",
          "de un lado a otro del cielo,",
          "y hasta el fin del mundo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mientras se oye su voz poderosa,",
          "¡rayos luminosos cruzan el cielo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Cuando Dios deja oír sus truenos,",
          "suceden cosas maravillosas",
          "que no alcanzamos a comprender."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dios les ordena",
          "a la nieve y a la lluvia",
          "que caigan sobre la tierra",
          "y demuestren su poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Así todos se quedan en sus casas",
          "y reconocen el poder de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los animales corren a sus cuevas",
          "para protegerse de la tormenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Con los vientos del sur",
          "llega la tormenta;",
          "con los vientos del norte",
          "se presenta el frío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios sopla sobre el agua,",
          "y esta se hace hielo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11,
          12
        ],
        "lines": [
          "A una orden de Dios,",
          "las nubes se llenan de lluvia",
          "y se van a recorrer la tierra,",
          "cubriéndola con sus relámpagos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Y Dios deja caer la lluvia:",
          "para unos como bendición;",
          "para otros como castigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "»Job, ponte a pensar",
          "en las maravillas de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¿Puedes decirme cómo",
          "controla las nubes,",
          "y cómo nos deslumbra",
          "con sus relámpagos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tú, que dices saberlo todo,",
          "¿puedes decirme cómo hace Dios",
          "para que las nubes floten?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17,
          18
        ],
        "lines": [
          "Dios puede cubrir con nubes",
          "el cielo más ardiente,",
          "y así evitar que sufras",
          "el calor que viene del sur.",
          "¡Eso tú no lo puedes hacer!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "»Soy tan ignorante",
          "que no sé qué decirle a Dios;",
          "enséñame cómo responderle."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Yo ni me atrevo a hablarle,",
          "pues podría perder la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Si el cielo está despejado,",
          "nadie puede mirar al sol,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¡y ahora viene del norte",
          "un brillante resplandor!",
          "¡Es Dios,",
          "que viene con todo su poder!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "No podemos ir a su encuentro,",
          "su justicia y rectitud no tienen límite;",
          "su poder es enorme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Él no toma en cuenta",
          "a los que se creen muy sabios,",
          "por eso todos le temen»."
        ],
        "rlw_lines": []
      }
    ]
  },
