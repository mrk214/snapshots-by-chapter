    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La marcha de Israel por el desierto"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La sabiduría le dio el triunfo a Israel,",
          "por medio de Moisés,",
          "el mejor profeta de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Los israelitas cruzaron un gran desierto",
          "y acamparon en lugares solitarios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enfrentaron a sus enemigos",
          "y triunfaron sobre ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cuando tuvieron sed, oraron a ti, Dios nuestro;",
          "y tú hiciste que de una roca brotara agua,",
          "para así calmar su sed."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El castigo de los enemigos de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Las mismas cosas con que castigaste",
          "a los enemigos de tu pueblo,",
          "también las usaste",
          "para ayudar a tu pueblo Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Las aguas del río Nilo",
          "se llenaron de sangre y de barro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ese fue el castigo que tú, Dios nuestro,",
          "les diste a los egipcios",
          "cuando ellos mandaron matar",
          "a los niños de tu pueblo.",
          "A todos los de tu pueblo,",
          "les diste agua en abundancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Hiciste que los israelitas tuvieran sed,",
          "porque querías mostrarles",
          "cómo castigabas a sus enemigos",
          "por su terrible maldad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Al mismo tiempo que tú, Dios nuestro,",
          "corregías a tu pueblo con amor,",
          "también hacías sufrir a los malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A tu pueblo Israel",
          "lo corregías como un padre a su hijo,",
          "pero a sus enemigos, tú los castigabas",
          "como un rey poderoso castiga",
          "a sus enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Los egipcios sufrieron mucho",
          "dentro y fuera de sus casas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Cuando vieron lo que les pasaba,",
          "su tristeza y dolor fue aún más grande."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Y cuando vieron que su castigo",
          "era para el bien del pueblo de Israel,",
          "comprendieron que tú, el Dios de Israel,",
          "eras el que había hecho todo aquello."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cuando Moisés era apenas un niño",
          "los egipcios quisieron matarlo,",
          "después se burlaron de él y lo despreciaron,",
          "pero al fin tuvieron que admirarlo.",
          "El castigo que sufrieron los malvados",
          "no fue como la disciplina",
          "que le diste a tu pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios es poderoso y compasivo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los egipcios adoraban a los reptiles",
          "y a otros horribles animales.",
          "Eso lo hacían porque eran muy malos",
          "y les faltaba entendimiento.",
          "Por eso, para castigarlos,",
          "tú, Dios de Israel, les enviaste",
          "plagas de insectos y reptiles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Así, les enseñaste que,",
          "con lo mismo que pecaban,",
          "tú después los castigarías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Para ti no hubiera sido nada difícil",
          "enviarles cientos de osos y leones feroces.",
          "Pues tú, Dios mío,",
          "creaste el mundo de la nada;",
          "¡tú eres un Dios poderoso!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "También podrías haber mandado",
          "contra los egipcios,",
          "animales peligrosos y horribles,",
          "que jamás habían visto.",
          "Animales que lanzaran terribles rugidos,",
          "arrojaran fuego y humo,",
          "y echaran chispas por los ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Esas fieras espantosas",
          "no tendrían necesidad",
          "de atacarlos para matarlos,",
          "sino que su sola presencia",
          "habría hecho que los egipcios",
          "se murieran de miedo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Es más, tú podrías haberlos matado",
          "con un pequeño soplo,",
          "sin haber tenido que usar",
          "esos terribles animales.",
          "De esa manera habrían sentido tu poder",
          "y recibido su justo castigo.",
          "Sin embargo,",
          "tú actúas de acuerdo",
          "con las leyes naturales que has creado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Nunca pierdes tu poder,",
          "de modo que nadie puede sobornarte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "El mundo es para ti",
          "como un grano de arena en la balanza,",
          "como una gota de rocío en una hoja."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Pero tú te compadeces de todos,",
          "porque todo lo puedes hacer.",
          "También eres bondadoso con el que peca,",
          "y le das la oportunidad de arrepentirse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Tú amas todo lo que existe",
          "y no odias nada de lo que has hecho,",
          "porque si algo odiaras,",
          "no lo habrías creado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Nada puede existir y mantenerse",
          "si tú no lo quieres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Dios, tú eres bueno con todos,",
          "porque a ti todo te pertenece,",
          "y amas todo lo que existe."
        ],
        "rlw_lines": []
      }
    ]
  },
