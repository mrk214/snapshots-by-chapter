    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "El novio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ya estoy dentro de mi jardín,",
          "amada mía;",
          "y encuentro en él bálsamo y mirra.",
          "Allí pruebo la miel de mi panal,",
          "y bebo vino y leche."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Los pastores"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Vamos, amigos,",
          "coman y beban!",
          "¡Queden saciados de amor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cuarto canto"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En medio de mis sueños",
          "mi corazón despertó",
          "y alcancé a oír una voz.",
          "Era la voz de mi amado,",
          "que estaba a la puerta:"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "El novio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Amada mía;",
          "mi preciosa palomita,",
          "¡déjame pasar!",
          "Tengo la cabeza bañada en rocío;",
          "¡me corre por el cabello",
          "la lluvia de la noche!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "«Pero ya me quité la ropa,",
          "¡tendría que volver a vestirme!",
          "Ya me lavé los pies;",
          "¡me los ensuciaría de nuevo!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi amado metió la mano",
          "por un hoyo de la puerta;",
          "¡todo mi ser se estremeció!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Salté de la cama",
          "para abrirle a mi amado;",
          "¡por las manos y los dedos",
          "me corrían gotas de perfume,",
          "y caían sobre la aldaba!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Al oír la voz de mi amado,",
          "sentí que me moría.",
          "Le abrí la puerta,",
          "pero él se había marchado;",
          "¡ya no estaba allí!",
          "Me dispuse a seguirlo:",
          "lo busqué y no lo encontré;",
          "lo llamé y no me respondió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Me topé con los guardias,",
          "con los que vigilan la ciudad;",
          "y ellos me hirieron, me golpearon,",
          "¡y me dejaron desnuda!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mujeres de Jerusalén,",
          "quiero que me prometan",
          "que, si encuentran a mi amado,",
          "le digan que…",
          "¡Que me estoy muriendo de amor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Las mujeres de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Qué tiene de especial tu amado,",
          "mujer bella entre las bellas?",
          "¿En qué es diferente tu amado",
          "del resto de los hombres,",
          "que nos pides tales promesas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tan elegante es mi amado,",
          "y tan rosada es su piel,",
          "que entre diez mil hombres",
          "es fácil reconocerlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Su cabeza es oro puro;",
          "sus cabellos son rizados",
          "y negros como un cuervo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sus ojos son dos palomas",
          "bañadas en leche",
          "y sentadas junto a los arroyos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sus mejillas son un huerto",
          "de hierbas aromáticas.",
          "Sus labios parecen rosas,",
          "y por ellos corre miel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Por brazos tiene",
          "un par de barras de oro",
          "adornadas con topacios.",
          "Su cuerpo es tan terso",
          "como el pulido marfil,",
          "y lo adorna un cielo de zafiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Son sus poderosas piernas,",
          "dos pilares de mármol",
          "apoyados sobre bases de oro puro.",
          "Su presencia es majestuosa",
          "como los cedros del Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Hay dulzura en sus labios;",
          "¡es un hombre encantador!",
          "¡Así es mi amado,",
          "mujeres de Jerusalén!",
          "¡Así es mi amado!"
        ],
        "rlw_lines": []
      }
    ]
  },
