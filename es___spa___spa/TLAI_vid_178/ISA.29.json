{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.29","is_chapter":true,"previous":{"usfm":"ISA.28","human":"Isaías 28","canonical":true,"toc":true},"current":{"usfm":"ISA.29","human":"Isaías 29"},"next":{"usfm":"ISA.30","human":"Isaías 30","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Ataque contra Jerusalén"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Dios anunció:","«Jerusalén, ciudad de David,","¡qué mal te va a ir!","Sigue con tus celebraciones","y haz fiesta año tras año,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["pero yo te pondré en problemas.","»Entonces gritarás y llorarás,","y la ciudad arderá en llamas,","como se queman los animales","que se ofrecen en el altar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Yo te rodearé con mi ejército;","pondré alrededor de ti","fortalezas y torres de asalto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Tú serás humillada,","quedarás tirada en el suelo;","apenas se oirán tus palabras,","tu voz parecerá la de un fantasma."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5,6],"lines":["»Yo, el Dios todopoderoso,","castigaré de repente a tus enemigos.","Los castigaré con truenos,","con el estruendo de un terremoto,","con incendios, tormentas y tempestades.","Los muchos enemigos que te persiguen","quedarán hechos polvo;","¡serán arrastrados como paja!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["»Los ejércitos que atacan a Jerusalén","y quieren derribar sus fortalezas","desaparecerán por completo,","como la niebla al salir el sol."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Los grandes ejércitos","que atacan a Jerusalén,","morirán de hambre y de sed.","Soñarán que comen y beben,","pero cuando se despierten","tendrán el estómago vacío","y la garganta reseca»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Israel parece estar ciego"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Isaías dijo:","«¡Ustedes los profetas,","sigan actuando como unos tontos!","¡Sigan como ciegos, sin ver nada!","¡Sigan tambaleándose como borrachos,","aun sin haber tomado vino!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Dios ha hecho caer sobre ustedes","un sueño muy profundo.","Ustedes los profetas","deberían ser los ojos del pueblo,","pero son incapaces de ver nada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Las visiones que reciben de Dios","no pueden entenderlas;","es como si quisieran leer","el texto de un libro cerrado.","Si se les diera ese libro","para que lo leyeran,","dirían: “No podemos leerlo,","porque el libro está cerrado”."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Mientras tanto, otros dicen:","“No podemos leerlo","porque no sabemos leer”»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Dios le dijo a Isaías:","«Este pueblo dice que me ama,","pero no me obedece;","me rinde culto,","pero no es sincero","ni lo hace de corazón."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Por eso, voy a hacer","cosas tan maravillosas","que este pueblo quedará asombrado.","Entonces destruiré","la sabiduría de sus hombres sabios","y la inteligencia","de sus personas inteligentes»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Advertencia de Isaías"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Isaías dijo:","«¡Qué mal les va a ir","a los que tratan de esconderse","para que Dios no los vea","cuando hacen sus planes malvados!","¡Qué mal les va a ir","a los que andan diciendo:","“Nadie nos ve, nadie se da cuenta”!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["¡Pero eso es un disparate!","Es como si el plato de barro","quisiera ser igual a quien lo hizo.","Pero no hay un solo objeto","que pueda decir a quien lo hizo:","“¡Tú no me hiciste!”","Tampoco puede decirle:","“¡No sabes lo que estás haciendo!”"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Promesa de salvación a Israel"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["»Dentro de muy poco tiempo,","el bosque se convertirá","en un campo de cultivo,","y el campo de cultivo","se parecerá a un bosque."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["En ese día los sordos podrán oír","cuando alguien les lea en voz alta,","y los ciegos podrán ver,","porque para ellos","no habrá más oscuridad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Los más pobres y necesitados","se alegrarán en nuestro santo Dios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Ese día desaparecerán","los insolentes, los orgullosos,","y los que solo piensan","en hacer el mal."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["»Se acabarán los mentirosos","que acusan a otros falsamente.","Se acabarán también","los que ponen trampas a los jueces","y los que con engaños","niegan justicia al inocente»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Por eso dice el Dios de Israel, el que rescató a Abraham:","«De ahora en adelante,","los israelitas no sentirán más vergüenza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Cuando sus descendientes vean","todo lo que hice entre ellos,","reconocerán que soy un Dios santo","y me mostrarán su respeto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Los que estaban confundidos","aprenderán a ser sabios;","¡hasta los más testarudos","aceptarán mis enseñanzas!»"],"rlw_lines":[]}]}}