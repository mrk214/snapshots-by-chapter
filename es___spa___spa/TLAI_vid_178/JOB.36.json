    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cuarta participación de Elihú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Todavía siguió diciendo Elihú:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Tenme paciencia.",
          "Quiero explicarte algunas cosas",
          "que hablarán bien de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mi creador actúa con justicia;",
          "toda mi sabiduría viene de él,",
          "y te lo voy a demostrar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Te aseguro que no miento;",
          "¡si buscas un sabio, aquí me tienes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Dios es poderoso,",
          "y todo lo entiende;",
          "no rechaza a nadie,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "defiende los derechos del pobre,",
          "pero no deja con vida al malvado;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "tiene cuidado de la gente buena",
          "y le concede un alto puesto:",
          "¡la hace reinar para siempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A los que están afligidos",
          "o han sido encarcelados,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dios les hace ver",
          "que su pecado es el orgullo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "les pide apartarse del mal",
          "y aceptar su corrección."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Si ellos aceptan obedecerlo,",
          "pasan el resto de su vida",
          "felices y con gran prosperidad;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "pero si no lo obedecen,",
          "cuando menos lo piensen,",
          "les llegará la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Los malvados son rencorosos;",
          "como Dios los castiga,",
          "jamás le piden ayuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Por eso mueren antes de tiempo,",
          "como la gente de mala fama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "»Dios usa el sufrimiento",
          "para hacernos entender,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "y ahora mismo",
          "te ha librado de la angustia,",
          "te ha servido un banquete,",
          "y te ha dado plena libertad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "»Bien mereces que Dios te juzgue",
          "como él juzga a los malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¡Así que mucho cuidado!",
          "No te dejes engañar por las riquezas,",
          "mucho menos si son mal ganadas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "pues ni ellas ni tus esfuerzos",
          "podrán servirte de nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No esperes que caiga la noche,",
          "pues la oscuridad no te esconderá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Mucho cuidado!",
          "¡Apártate de la maldad,",
          "pues por eso estás sufriendo ahora!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "»Dios es grande y poderoso;",
          "no hay maestro que se le compare."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Nadie puede pedirle cuentas,",
          "ni acusarlo de haberse equivocado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Muchos alaban sus acciones;",
          "tú también debieras hacerlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Todos podemos ver sus obras,",
          "aunque solo desde lejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Tan grande es Dios",
          "que no podemos conocerlo,",
          "ni saber cuántos años tiene."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27,
          28
        ],
        "lines": [
          "»Dios nos manda la lluvia,",
          "y con esa agua llena los ríos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Pero nadie puede explicar",
          "cómo se mueven las nubes",
          "ni de dónde salen los truenos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Dios está rodeado de luz,",
          "y con ella cubre el fondo del mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Dios gobierna a las naciones",
          "y les da abundante comida;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "toma el relámpago en sus manos",
          "y lo lanza a donde él quiere."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "El trueno anuncia la tormenta,",
          "y el ganado la presiente."
        ],
        "rlw_lines": []
      }
    ]
  },
