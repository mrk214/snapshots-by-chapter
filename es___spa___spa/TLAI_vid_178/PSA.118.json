    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios nos ama"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Alabemos a nuestro Dios!",
          "¡Démosle gracias porque él es bueno!",
          "¡Él nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Que lo repitan los israelitas:",
          "«¡Dios nunca deja de amarnos!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que lo repitan los sacerdotes:",
          "«¡Dios nunca deja de amarnos!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Que lo repitan",
          "los que adoran a Dios:",
          "«¡Dios nunca deja de amarnos!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Perdida ya toda esperanza,",
          "llamé a mi Dios,",
          "y él me respondió;",
          "¡me liberó de la angustia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dios está conmigo:",
          "no tengo miedo.",
          "Nadie puede hacerme daño,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios está conmigo",
          "y me brinda su ayuda.",
          "¡Estoy seguro de ver la derrota",
          "de los que me odian!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8,
          9
        ],
        "lines": [
          "Vale más confiar en Dios",
          "que confiar en gente importante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10,
          11
        ],
        "lines": [
          "Todas las naciones me rodearon;",
          "me rodearon por completo,",
          "pero Dios me ayudó a derrotarlas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Me rodearon como avispas,",
          "pero ardieron en el fuego como espinas;",
          "¡Dios me ayudó a derrotarlas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Me empujaron con violencia",
          "para hacerme tropezar,",
          "pero Dios vino en mi ayuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Dios me da fuerzas,",
          "Dios inspira mi canto;",
          "¡Dios es mi salvador!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15,
          16
        ],
        "lines": [
          "Los justos, en sus casas,",
          "repiten este grito de alegría:",
          "«¡Dios con su poder",
          "ha alcanzado la victoria!",
          "¡Alabemos su poder!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Aún no quiero morir.",
          "Quiero vivir y seguir hablando",
          "de lo que Dios ha hecho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Él me castigó con dureza,",
          "pero no me entregó a la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19,
          20
        ],
        "lines": [
          "¡Ábranme paso,",
          "puertas del templo de Dios!",
          "Por ustedes solo pasan",
          "los que Dios considera justos.",
          "¡Ábranme paso,",
          "que quiero darle gracias a Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Gracias, Dios mío,",
          "porque me respondiste",
          "y me salvaste!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La piedra que rechazaron",
          "los constructores del templo",
          "es ahora la piedra principal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Esto nos deja maravillados,",
          "pues Dios es quien lo hizo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Hagamos fiesta en este día,",
          "porque en un día como este",
          "Dios actuó en nuestro favor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Dios, Dios mío,",
          "¡danos tu salvación,",
          "concédenos tu victoria!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡Bendito el rey que viene",
          "en el nombre de Dios!",
          "Desde su templo",
          "los bendecimos a todos ustedes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Dios es nuestra luz.",
          "¡Llevemos flores al altar",
          "y acompañemos al pueblo de Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Tú eres mi Dios;",
          "por eso te doy gracias",
          "y alabo tu grandeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¡Alabemos a nuestro Dios!",
          "¡Démosle gracias porque él es bueno!",
          "¡Él nunca deja de amarnos!"
        ],
        "rlw_lines": []
      }
    ]
  },
