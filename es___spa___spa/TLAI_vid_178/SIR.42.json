    "name": "Eclesiástico"
  },
  "chapter": {
    "chapter_usfm": "SIR.42",
    "current": {
      "usfm": "SIR.42",
      "human": "Eclesiástico 42"
    },
    "previous": {
      "usfm": "SIR.41",
