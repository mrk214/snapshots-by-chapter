    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "En Dios confío"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Dios mío,",
          "¡escucha mi oración!",
          "¡Atiende mis ruegos!",
          "Tú eres fiel y justo:",
          "¡respóndeme!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "No me llames a cuentas,",
          "que ante ti, nadie en el mundo",
          "puede considerarse inocente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mis enemigos quieren matarme;",
          "me tienen acorralado",
          "y en constante peligro de muerte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ya no siento latir mi corazón;",
          "¡ya he perdido el ánimo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me vienen a la mente",
          "los tiempos pasados",
          "y me pongo a pensar",
          "en todas tus acciones;",
          "¡tengo muy presente",
          "todo lo que has hecho!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Hacia ti extiendo mis manos,",
          "pues me haces falta,",
          "como el agua a la tierra seca!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios mío,",
          "¡respóndeme pronto,",
          "pues la vida se me escapa!",
          "¡No me des la espalda,",
          "o ya puedo darme por muerto!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "En ti confío;",
          "¡a ti dirijo mi oración!",
          "Cada nuevo día",
          "hazme saber que me amas;",
          "¡dime qué debo hacer!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dios mío,",
          "líbrame de mis enemigos,",
          "pues en ti busco refugio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tú eres mi Dios.",
          "¡Enséñame a hacer",
          "lo que quieres que yo haga!",
          "¡Permite que tu buen espíritu",
          "me lleve a hacer el bien!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11,
          12
        ],
        "lines": [
          "Dios mío,",
          "tú eres un Dios justo;",
          "¡acaba con mis enemigos!",
          "¡Destruye a los que me persiguen!",
          "Tú eres un Dios de amor",
          "y yo estoy a tu servicio;",
          "¡demuestra tu poder y dame vida!",
          "¡Sácame de este aprieto!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
