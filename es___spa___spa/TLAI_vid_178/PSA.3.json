    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confiando en Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) David compuso este salmo cuando estaba huyendo de su hijo Absalón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "son muchos mis enemigos;",
          "son muchos los que me atacan,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) son muchos los que me dicen",
          "que tú no vas a salvarme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Solo tú, Dios mío,",
          "me proteges como un escudo;",
          "y con tu poder",
          "me das nueva vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) A gritos te llamo,",
          "y desde tu templo me respondes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Yo me acuesto,",
          "y me duermo,",
          "y vuelvo a despertar,",
          "porque tú vigilas mi sueño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) No me asustan los muchos enemigos",
          "que me tienen acorralado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) ¡Dios mío,",
          "levántate y ponme a salvo!",
          "¡Rómpeles la cara a mis enemigos!",
          "¡Rómpeles los dientes a los malvados!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Dios mío,",
          "solo tú puedes salvarme;",
          "¡bendice a tu pueblo!"
        ],
        "rlw_lines": []
      }
    ]
  },
