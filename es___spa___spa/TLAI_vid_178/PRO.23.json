{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PRO","name":"Proverbios"},"chapter":{"chapter_usfm":"PRO.23","is_chapter":true,"previous":{"usfm":"PRO.22","human":"Proverbios 22","canonical":true,"toc":true},"current":{"usfm":"PRO.23","human":"Proverbios 23"},"next":{"usfm":"PRO.24","human":"Proverbios 24","canonical":true,"toc":true},"items":[{"type":"heading2","verse_numbers":[],"lines":["-6-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Cuando comas con gente importante,","piensa bien ante quién te encuentras."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Si te gusta comer mucho,","no demuestres que tienes hambre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["No dejes que te engañe","la apariencia de esos platillos."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-7-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["No hagas de las riquezas","tu única meta en la vida,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["pues son como las águilas:","abren las alas y salen volando.","Si acaso llegas a verlas,","muy pronto desaparecen."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-8-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Nunca comas con gente tacaña,","ni dejes que sus platillos","te despierten el apetito."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Esa gente te invita a comer,","pero su invitación no es sincera;","esa gente es tan tacaña","que se fija en cuánto comes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Al fin de cuentas vomitarás","todo lo que hayas comido,","y todos tus halagos","no habrán servido de nada."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-9-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["No des buenos consejos a los tontos","porque se burlarán de ti."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-10-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Mantén el tamaño de tu propiedad","tal como la recibiste de tus padres,","y no invadas el terreno","de los huérfanos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Dios es su pariente más cercano","y los defenderá de ti."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-11-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Recibe la enseñanza con agrado,","y presta atención a los buenos consejos."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-12-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["A los niños hay que corregirlos.","Unos buenos golpes no los matarán,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["pero sí los librarán de la muerte."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-13-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Querido jovencito,","cuando alcances la sabiduría,","seré muy feliz."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Muy grande será mi alegría","cuando hables como se debe."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-14-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["No envidies a los pecadores,","y obedece siempre a Dios;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["así tu futuro será feliz."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-15-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Querido jovencito,","préstame atención,","actúa con inteligencia,","y no dejes de hacer el bien."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["No te juntes con borrachos","ni te hagas amigo de glotones,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["pues unos y otros","acaban en la ruina."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-16-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Presta atención a tus padres,","pues ellos te dieron la vida;","y cuando lleguen a viejos,","no los abandones."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Acumula verdad y sabiduría,","disciplina y entendimiento,","¡y no los cambies por nada!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[24,25],"lines":["El hijo bueno y sabio","es motivo de gran alegría","para su padre y su madre","que le dieron la vida."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-17-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Querido jovencito,","prométeme que pensarás en mis consejos","y harás tuyas mis enseñanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["No hay nada más angustioso","que enredarse con la mujer infiel."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Esa mujer es como los bandidos:","se esconde para atrapar a sus víctimas,","y una a una las hace caer en sus redes."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["-18-"],"rlw_lines":[]},{"type":"verse","verse_numbers":[29,30],"lines":["El borracho llora y sufre;","anda en pleitos y se queja,","lo hieren sin motivo","y le ponen los ojos morados.","Eso le pasa por borracho,","y por probar nuevas bebidas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Querido jovencito,","no te fijes en bebidas embriagantes","que atraen por su color y brillo,","pues se beben fácilmente,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["pero muerden como víboras","y envenenan como serpientes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["Si las bebes, verás cosas raras","y te vendrán las ideas más tontas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Sentirás que estás en un barco,","navegando en alta mar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["Te herirán, y no te darás cuenta;","te golpearán, y no lo sentirás.","Y cuando te despiertes","solo una idea vendrá a tu mente:","«Quiero que me sirvan otra copa»."],"rlw_lines":[]}]}}