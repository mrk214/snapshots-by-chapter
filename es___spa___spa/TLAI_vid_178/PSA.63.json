    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tu amor vale más que la vida"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) David compuso este himno cuando estaba en el desierto de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío, tú eres mi Dios.",
          "Con ansias te busco",
          "desde que amanece,",
          "como quien busca una fuente",
          "en el más ardiente desierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) ¡Quiero verte en tu santuario,",
          "y contemplar tu poder y tu grandeza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Más que vivir,",
          "prefiero que me ames.",
          "Te alabaré con mis labios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) ¡Mientras viva te alabaré!",
          "¡Alzaré mis manos para alabarte!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) ¡Con mis labios te alabaré",
          "y daré gritos de alegría!",
          "¡Eso me dejará más satisfecho",
          "que la comida más deliciosa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Me acuesto y me acuerdo de ti;",
          "durante toda la noche",
          "estás en mi pensamiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) ¡Tú eres quien me ayuda!",
          "¡Soy feliz bajo tu protección!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) ¡A ti me entrego por completo,",
          "porque tu gran poder es mi apoyo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) ¡Destruye a los que quieren matarme!",
          "¡Échalos en el hoyo más profundo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) ¡Que los maten en la guerra!",
          "¡Que se los coman los perros salvajes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Concédele al rey",
          "y al pueblo que te adora",
          "alabarte y alegrarse en ti,",
          "pero a los mentirosos,",
          "¡tápales la boca!"
        ],
        "rlw_lines": []
      }
    ]
  },
