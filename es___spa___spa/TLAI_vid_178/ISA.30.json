    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contra los que confían en Egipto"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios dijo:",
          "«¡Qué mal les va a ir a ustedes,",
          "israelitas rebeldes!",
          "Hacen planes sin tomarme en cuenta,",
          "y pecan una y otra vez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Piden ayuda al rey de Egipto,",
          "pero sin consultarme;",
          "buscan refugio bajo su poder,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "pero ese rey no podrá protegerlos;",
          "Egipto no les dará refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "»Ustedes, los israelitas,",
          "han mandado embajadores",
          "hasta las ciudades egipcias",
          "de Soan y de Hanés;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "pero van a quedar avergonzados,",
          "porque esa gente inútil,",
          "en vez de ayudarlos,",
          "les causará muchas desgracias»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La ayuda de Egipto no servirá de nada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Isaías dijo:",
          "«Esto dice nuestro Dios acerca de Egipto,",
          "ese animal feroz del desierto del sur:",
          "“Los israelitas llevan a Egipto",
          "todos sus tesoros y riquezas.",
          "Todo eso lo llevan",
          "a lomo de burro y de camello.",
          "Cruzan el desierto,",
          "que está lleno de peligros.",
          "Allí hay leones feroces,",
          "víboras y dragones voladores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pero Egipto no podrá ayudarlos.",
          "Por eso he dicho acerca de él:",
          "‘Perro que ladra, no muerde’.”»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Entonces Dios le dijo a Isaías:",
          "«Ven ahora y escribe este refrán;",
          "ponlo sobre una tablilla",
          "para que sirva de testimonio",
          "y siempre se recuerde»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El castigo de la rebeldía"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Isaías dijo:",
          "«Los israelitas son un pueblo",
          "que no quiere obedecer",
          "las enseñanzas de Dios.",
          "Son infieles y rebeldes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No quieren que los videntes",
          "cuenten sus visiones;",
          "tampoco quieren que los profetas",
          "les digan la verdad.",
          "Prefieren que les hablen",
          "de cosas agradables;",
          "prefieren seguir creyendo",
          "que todo les saldrá bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A unos y a otros les piden",
          "que dejen de obedecer a Dios;",
          "no quieren que sigan hablando",
          "del Dios santo de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Por eso, Dios les dijo:",
          "“Ustedes rechazan mis advertencias,",
          "y prefieren confiar en la violencia",
          "y en palabras mentirosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Por lo tanto,",
          "su pecado caerá sobre ustedes",
          "como un muro alto y agrietado,",
          "que se viene abajo",
          "cuando uno menos lo espera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Será como un jarro",
          "que se rompe por completo.",
          "Tan pequeños son los pedazos",
          "que no sirven para nada;",
          "¡ni para remover el fuego",
          "ni para sacar agua de un pozo!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "»Por lo tanto,",
          "así dice el Dios santo de Israel:",
          "“Vuelvan a obedecerme,",
          "y yo les daré poder.",
          "Si en verdad confían en mí,",
          "manténganse en calma",
          "y quedarán a salvo.",
          "Pero ustedes me rechazan;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "prefieren escapar a caballo",
          "o en carros muy veloces.",
          "”Pues bien, si así lo prefieren,",
          "tendrán que huir a caballo;",
          "¡pero sus perseguidores",
          "serán más veloces que ustedes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Bastará un solo enemigo",
          "para llenar de miedo a mil;",
          "¡serán suficientes cinco de ellos",
          "para amenazar a todos ustedes!",
          "Y cuando todo haya terminado,",
          "de ustedes quedarán tan pocos",
          "que parecerán un poste solitario",
          "en la parte alta de un monte”»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Promesas de salvación"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Isaías continuó diciendo:",
          "«Nuestro Dios ama la justicia y quiere demostrarles cuánto los ama. En verdad, Dios ama a los que confían en él, y desea mostrarles compasión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "»Y ustedes, israelitas que viven en la ciudad de Jerusalén, ya no tienen por qué llorar. Dios les tendrá compasión tan pronto como le pidan ayuda. En cuanto oiga sus gritos, les responderá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Y si acaso les envía algún sufrimiento, ya no se quedará escondido. Dios es su maestro, y ustedes lo verán con sus propios ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»Si acaso dejan de adorarlo, oirán una voz que les dirá: “No hagan eso, porque eso no me agrada. Adórenme solo a mí”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ustedes llegarán a ver como basura sus ídolos de oro y plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Entonces, cuando siembren sus campos, Dios les enviará lluvia. Así la tierra producirá trigo en abundancia.",
          "»Ese día, su ganado tendrá mucho lugar donde pastar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "También los bueyes y los burros que trabajan en sus campos podrán alimentarse de ricos pastos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "»Cuando Dios castigue a sus enemigos y destruya sus fortalezas, bajarán de las colinas y de las altas montañas grandes corrientes de agua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Ese día Dios les sanará las heridas, porque ustedes son su pueblo. La luz de la luna será tan brillante como la del sol, y el sol brillará siete veces más. ¡Será como si brillaran siete soles juntos!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El castigo de Asiria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Isaías continuó diciendo:",
          "«¡Miren a lo lejos!",
          "¡Dios mismo se acerca!",
          "Su furia es como fuego ardiente;",
          "sus labios y su lengua",
          "son un fuego destructor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "El aliento de Dios",
          "parece un río desbordado",
          "que todo lo inunda.",
          "Dios viene contra las naciones,",
          "para derrotarlas por completo",
          "y hacerlas perder el rumbo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "»Ustedes, en cambio,",
          "escucharán canciones",
          "como en una noche de fiesta;",
          "irán con el corazón alegre,",
          "como los que caminan",
          "al ritmo de las flautas.",
          "Irán al monte de Dios,",
          "pues él es nuestro refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "»Dios dejará oír su voz majestuosa",
          "y nos demostrará su poder.",
          "Sus rayos, aguaceros y granizos",
          "son destructores como el fuego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "»Cuando Asiria oiga la voz de Dios,",
          "sabrá el castigo que le espera",
          "y se llenará de miedo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Dios la atacará en la guerra,",
          "y cuando la destruya,",
          "sonarán arpas y tambores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Desde hace mucho tiempo",
          "Dios tiene preparado",
          "un lugar de castigo",
          "para Asiria y para su rey.",
          "Es un lugar ancho y profundo,",
          "y tiene mucha leña.",
          "Cuando Dios sople sobre ella,",
          "la leña se encenderá",
          "como una lluvia de azufre»."
        ],
        "rlw_lines": []
      }
    ]
  },
