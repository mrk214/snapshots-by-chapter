    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jonás ora a Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Desde allí, Jonás oró a Dios:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) «Cuando estaba sufriendo,",
          "tú, mi Dios, me ayudaste.",
          "Cuando estaba casi muerto,",
          "pedí ayuda y me la diste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) »Me arrojaste a lo más hondo del mar.",
          "Solo agua veía yo por todos lados;",
          "grandes olas cruzaban sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) »Llegué a pensar que ya no me querías,",
          "que no volvería a entrar en tu templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) »Me había hundido por completo.",
          "El mar me cubría todo,",
          "y las algas se enredaban en mi cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) »Creí que ya nunca saldría del fondo del mar.",
          "Pero tú, Dios mío, me salvaste la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) »Cuando ya estaba sin fuerzas,",
          "me acordé de ti, y oré.",
          "Mi oración llegó hasta tu santuario."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) »Los que adoran a otros dioses,",
          "a los ídolos sin vida,",
          "no pueden decir que tú eres su Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) »Pero yo voy a adorarte",
          "y a cantarte con alegría.",
          "Cumpliré las promesas que te hice.",
          "¡Porque solo tú puedes salvar!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Por fin, Dios le ordenó al pez: «¡Arroja a Jonás en la orilla del mar!»"
        ],
        "rlw_lines": []
      }
    ]
  },
