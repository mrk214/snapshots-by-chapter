{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PRO","name":"Proverbios"},"chapter":{"chapter_usfm":"PRO.13","is_chapter":true,"previous":{"usfm":"PRO.12","human":"Proverbios 12","canonical":true,"toc":true},"current":{"usfm":"PRO.13","human":"Proverbios 13"},"next":{"usfm":"PRO.14","human":"Proverbios 14","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Recompensa de los buenos, castigo de los malos"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["El hijo sabio acepta","que su padre lo castigue;","el hijo malcriado no permite","que le llamen la atención."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Los que hablan de hacer el bien","reciben su justo premio,","pero los traidores reciben","el castigo que se merecen."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["El que cuida lo que dice","protege su vida;","el que solo dice tonterías","provoca su propia desgracia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["El que desea tener sin trabajar,","al final no consigue nada;","¡trabaja, y todo lo tendrás!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["La gente honrada odia la mentira;","el malvado siempre causa","vergüenza y deshonra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Al bueno lo protege su honradez;","al pecador lo arruina su maldad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Algunos dicen ser ricos","y no tienen nada;","otros dicen ser pobres","y nada les falta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["El rico, por su dinero,","corre el peligro de ser secuestrado;","el pobre no tiene ese problema,","pues nadie lo amenaza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["La vida de los buenos","es luz que llena de alegría;","la vida de los malvados","es una lámpara apagada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["La gente orgullosa","provoca peleas;","la gente humilde","escucha consejos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Lo que fácilmente se gana,","fácilmente se acaba;","ahorra poco a poco,","y un día serás rico."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["¡Qué tristeza da","que los deseos no se cumplan!","¡Y cómo nos llena de alegría","ver cumplidos nuestros deseos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Si te burlas de una orden,","tendrás tu merecido;","si la obedeces,","tendrás tu recompensa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Las enseñanzas del sabio","son una fuente de vida","y pueden salvarte de la muerte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["El que da buenos consejos","se gana el aprecio de todos,","pero el que da malos consejos","acabará en la ruina."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["El sabio piensa bien lo que hace;","el tonto deja ver su estupidez."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["El mensajero malvado","te mete en problemas;","el buen mensajero","te saca de ellos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Si no aprecias la disciplina,","te esperan la pobreza y la deshonra;","si aceptas que se te corrija,","recibirás grandes honores."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["¡Cómo nos alegramos","cuando se cumplen nuestros deseos!","¡Y cómo le cuesta trabajo al necio","apartarse del mal!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Quien con sabios anda","a pensar aprende;","quien con tontos se junta","acaba en la ruina."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["El bien te trae bendiciones;","el mal solo te trae problemas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Las riquezas del hombre bueno","serán para sus nietos;","las riquezas del pecador","serán la herencia de la gente honrada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["En los campos de los pobres","hay comida de sobra;","donde hay maldad, todo se pierde."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Si amas a tu hijo, corrígelo;","si no lo amas, no lo castigues."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Los buenos comen hasta llenarse,","pero los malvados se quedan con hambre."],"rlw_lines":[]}]}}