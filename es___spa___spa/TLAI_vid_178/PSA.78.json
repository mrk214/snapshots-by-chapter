    "name": "Salmos"
  },
  "chapter": {
    "chapter_usfm": "PSA.78",
    "is_chapter": true,
    "previous": {
      "usfm": "PSA.77",
      "human": "Salmos 77"
    },
    "current": {
      "usfm": "PSA.78",
      "human": "Salmos 78"
