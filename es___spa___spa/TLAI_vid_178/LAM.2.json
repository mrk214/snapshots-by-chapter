{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"LAM","name":"Lamentaciones"},"chapter":{"chapter_usfm":"LAM.2","is_chapter":true,"previous":{"usfm":"LAM.1","human":"Lamentaciones 1","canonical":true,"toc":true},"current":{"usfm":"LAM.2","human":"Lamentaciones 2"},"next":{"usfm":"LAM.3","human":"Lamentaciones 3","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Segundo lamento acróstico"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["El profeta"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["¡Pobrecita de ti, Jerusalén!","Cuando Dios se enojó contigo,","derribó tu templo","y acabó con tu belleza.","Ni siquiera se acordó","de tu reino en este mundo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Ofendido y enojado,","Dios destruyó por completo","todas las casas de Israel.","Derribó las fortalezas de Judá;","quitó al rey de su trono,","y puso en vergüenza a sus capitanes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Borró Dios nuestro poder","cuando se enojó con nosotros.","Nos enfrentamos al enemigo,","pero Dios nos retiró su ayuda.","¡Todo Israel arde en llamas!","¡Todo lo destruye el fuego!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Rompió en mil pedazos","las casas de Jerusalén,","y acabó con nuestros seres queridos.","Como si fuera nuestro enemigo,","decidió quitarnos la vida;","su enojo fue como un fuego","que nos destruyó por completo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["El llanto por los muertos","se oye por todo Judá.","Dios parece nuestro enemigo,","pues ha acabado con nosotros.","¡Todas sus fortalezas y palacios","han quedado en ruinas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Como quien derriba una choza,","Dios destruyó su templo.","Ya nadie en Jerusalén celebra","los sábados ni los días de fiesta.","Dio rienda suelta a su enojo","contra el rey y los sacerdotes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Incitó al ejército enemigo","a conquistar Jerusalén,","y el enemigo gritó en su templo","como si estuviera de fiesta.","¡Dios ha rechazado por completo","su altar y su santuario!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Todos los muros y las rampas","son ahora un montón de escombros.","Dios decidió derribar","el muro que protegía a Jerusalén.","Todo lo tenía planeado;","¡la destruyó sin compasión!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["¡Adiós, maestros de la ley!","¡Adiós, profetas!","¡Dios ya no habla con nosotros!","El rey y los capitanes","andan perdidos entre las naciones.","La ciudad quedó desprotegida,","pues Dios derribó sus portones."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["De luto están vestidos","los ancianos de Jerusalén.","En silencio se sientan en el suelo","y se cubren de ceniza la cabeza.","¡Las jóvenes de Jerusalén","bajan la cabeza llenas de vergüenza!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Estoy muy triste y desanimado","porque ha sido destruida mi ciudad.","¡Ya no me quedan lágrimas!","¡Siento que me muero!","Por las calles de Jerusalén","veo morir a los recién nacidos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Tímidamente claman los niños:","«¡Mamá, tengo hambre!»;","luego van cerrando los ojos","y mueren en las calles,","en brazos de su madre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Incomparable eres tú, Jerusalén;","¿qué más te puedo decir?","¿Qué puedo hacer para consolarte,","bella ciudad de Jerusalén?","Tus heridas son muy profundas;","¿quién podría sanarlas?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Jamás te dijeron la verdad;","los profetas te mintieron.","Si no te hubieran engañado,","ahora estarías a salvo.","Pero te hicieron creer en mentiras","y no señalaron tu maldad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["«¿En dónde quedó la hermosura","de la bella Jerusalén,","la ciudad más alegre del mundo?»","Eso preguntan al verte","los que pasan por el camino,","y se burlan de tu desgracia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Rabiosos están tus enemigos,","y no dejan de hablar mal de ti.","Gritan en son de victoria:","«¡Llegó el día que habíamos esperado!","¡Hemos acabado con Jerusalén,","y hemos vivido para contarlo!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Una vez, años atrás,","Dios juró que te destruiría,","y ha cumplido su palabra:","te destruyó sin compasión,","y permitió que tus enemigos","te vencieran y te humillaran."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Sí, bella Jerusalén,","deja que tus habitantes","se desahoguen ante Dios.","Y tú, no dejes de llorar;","¡da rienda suelta a tu llanto","de día y de noche!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Alza la voz y ruega a Dios","por la vida de tus niños,","que por falta de comida","caen muertos por las calles.","Clama a Dios en las noches;","cuéntale cómo te sientes."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Jerusalén"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Las madres están por comerse","a los hijos que tanto aman.","Los sacerdotes y los profetas","agonizan en tu templo.","Piensa por favor, Dios mío,","¿a quién has tratado así?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["En tu enojo les quitaste la vida","a los jóvenes y a los ancianos.","Mis muchachos y muchachas","cayeron muertos por las calles","bajo el golpe de la espada;","¡no les tuviste compasión!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Nadie quedó con vida","el día que nos castigaste;","fue como una gran fiesta","para el ejército enemigo:","murieron todos mis familiares,","¡nos atacaste por todos lados!"],"rlw_lines":[]}]}}