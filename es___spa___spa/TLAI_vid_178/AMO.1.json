{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"AMO","name":"Amós"},"chapter":{"chapter_usfm":"AMO.1","is_chapter":true,"previous":{"usfm":"JOL.3","human":"Joel 3","canonical":true,"toc":true},"current":{"usfm":"AMO.1","human":"Amós 1"},"next":{"usfm":"AMO.2","human":"Amós 2","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["De ganadero a profeta"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["En el pueblo de Tecoa vivía un ganadero llamado Amós, que comunicó a los israelitas varios mensajes de parte de Dios. Esto sucedió dos años antes del terremoto, cuando Ozías era rey de Judá y Jeroboam hijo de Joás era rey de Israel."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Estos fueron los mensajes de Amós:","«Cuando Dios se enoja","y habla desde Jerusalén,","se marchitan los pastos;","¡se reseca el monte Carmelo!»"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Mensajes contra las naciones"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Contra Damasco"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["El Dios de Israel ha dicho:","«Ustedes, habitantes de Damasco,","han llegado al colmo de la maldad.","Por eso, ¡no los perdonaré!","Hicieron pedazos a la gente de Galaad","como si desgranaran trigo","con una máquina de hierro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Por eso, les prenderé fuego","al palacio del rey Hazael","y al de su hijo Ben-hadad;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["derribaré los portones de Damasco,","destruiré a los reyes","de Bicat-avén y Bet-edén,","y haré que a todos ustedes","se los lleven a la ciudad de Quir.","Les juro que así será»."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Contra Gaza"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["El Dios de Israel ha dicho:","«Ustedes, habitantes de Gaza,","han llegado al colmo de la maldad.","Por eso, ¡no los perdonaré!","Tomaron presos pueblos enteros,","y en Edom los vendieron como esclavos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["»Por eso les prenderé fuego","a las murallas de Gaza","y sus palacios quedarán hechos cenizas;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["destruiré a los reyes","de Asdod y de Ascalón,","y descargaré mi poder contra Ecrón,","hasta que mueran todos ustedes.","Les juro que así será»."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Contra Tiro"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["El Dios de Israel ha dicho:","«Ustedes, habitantes de Tiro,","han llegado al colmo de la maldad.","Por eso, ¡no los perdonaré!","Tomaron presos pueblos enteros","y en Edom los vendieron como esclavos;","¡no respetaron el pacto de hermanos","que habían hecho con esos pueblos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Por eso les prenderé fuego","a las murallas de Tiro","y sus palacios quedarán hechos cenizas»."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Contra Edom"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["El Dios de Israel ha dicho:","«Ustedes, habitantes de Edom,","han llegado al colmo de la maldad.","Por eso, ¡no los perdonaré!","Persiguieron a sus propios hermanos","y los mataron sin ninguna compasión;","dieron rienda suelta a su enojo,","y siempre guardaron su rencor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Por eso les prenderé fuego","a las ciudades de Temán y Bosrá,","y sus palacios quedarán hechos cenizas»."],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Contra Amón"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["El Dios de Israel ha dicho:","«Ustedes, habitantes de Amón,","han llegado al colmo de la maldad.","Por eso, ¡no los perdonaré!","Para agrandar su territorio,","en Galaad partieron en dos","a las mujeres embarazadas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Por eso les prenderé fuego","a las murallas de Rabá,","y sus palacios quedarán hechos cenizas.","Lo haré el día de la batalla,","en medio del estruendo","de un día de tempestad,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["y su rey y sus jefes","serán llevados a otro país.","Les juro que así será»."],"rlw_lines":[]}]}}