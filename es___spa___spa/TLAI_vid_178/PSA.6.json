    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios mío, ayúdame"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: Este himno deberá cantarse acompañado de instrumentos de ocho cuerdas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1,
          2
        ],
        "lines": [
          "1-2 (2-3) Dios mío, ¡tenme compasión!",
          "No me reprendas cuando estés enojado",
          "ni me castigues cuando estés furioso,",
          "pues ya no me quedan fuerzas.",
          "Devuélveme la salud,",
          "pues todo el cuerpo me tiembla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3,
          4
        ],
        "lines": [
          "3-4 (4-5) Dios mío, estoy muy tembloroso;",
          "¿cuándo vendrás en mi ayuda?",
          "¡Vuélvete a mirarme, y sálvame!",
          "¡Por tu gran amor,",
          "te ruego que me salves!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) En el mundo de los muertos",
          "nadie se acuerda de ti.",
          "Si dejas que me muera,",
          "ya no podré alabarte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) ¡Ya estoy cansado de llorar!",
          "Por las noches lloro tanto",
          "que mis lágrimas empapan mi almohada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Es tanto lo que sufro",
          "que los ojos se me nublan;",
          "¡por culpa de mis enemigos",
          "ya estoy perdiendo la vista!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8,
          9
        ],
        "lines": [
          "8-9 (9-10) ¡Gente malvada, apártense de mí,",
          "porque Dios ha escuchado mis ruegos",
          "y ha aceptado mi oración!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Ustedes, mis enemigos,",
          "quedarán confundidos y avergonzados.",
          "¡En un instante huirán",
          "llenos de vergüenza!"
        ],
        "rlw_lines": []
      }
    ]
  },
