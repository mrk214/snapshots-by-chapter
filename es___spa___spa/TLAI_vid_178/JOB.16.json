    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cuarta respuesta de Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Job le contestó a Elifaz:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Todo lo que ustedes han dicho",
          "lo he escuchado muchas veces;",
          "¡y no fue ningún consuelo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Qué es lo que tanto les molesta?",
          "¿Por qué no me dejan en paz?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4,
          5
        ],
        "lines": [
          "Si estuvieran en mi lugar,",
          "verían que no necesito tanta palabrería.",
          "¡Lo que necesito es que me animen,",
          "que calmen mi sufrimiento!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "»¿Qué se gana con hablar?",
          "¡Mi dolor no me deja",
          "ni tampoco se calma!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios ha acabado conmigo",
          "y con toda mi familia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Me tiene arrinconado,",
          "se levanta y me condena;",
          "lo que ha dejado de mí",
          "es solo un montón de huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "»Tan enojado está Dios conmigo",
          "que me persigue y me despedaza;",
          "me considera su enemigo.",
          "Me mira con rabia",
          "y me muestra los dientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mis enemigos",
          "se han puesto en mi contra;",
          "se burlan de mí y me dan bofetadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios me dejó caer",
          "en manos de gente malvada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12,
          13,
          14
        ],
        "lines": [
          "Antes, yo vivía tranquilo;",
          "pero Dios me agarró por el cuello",
          "y me hizo objeto de sus ataques.",
          "Se lanzó contra mí como un guerrero",
          "y me abrió una herida tras otra,",
          "destrozándome sin ninguna compasión.",
          "¡Regados por el suelo quedaron",
          "mi hígado y mis riñones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "»Me vestí con ropas ásperas,",
          "para mostrar mi angustia;",
          "¡mi orgullo ha quedado por el suelo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "De tanto llorar tengo roja la cara;",
          "mis ojos muestran profundas ojeras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¿Por qué no aceptan",
          "que no soy un malvado,",
          "y que es sincera mi oración?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "»Si acaso muero,",
          "espero que la tierra",
          "no oculte mi inocencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Yo sé que en el cielo",
          "tengo un testigo a mi favor.",
          "Allí sin duda, está mi abogado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Ante Dios lloro amargamente,",
          "porque mis amigos se burlan de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Dios me defenderá",
          "como quien defiende a un amigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "En unos cuantos años",
          "estaré en la tumba, y ya no volveré."
        ],
        "rlw_lines": []
      }
    ]
  },
