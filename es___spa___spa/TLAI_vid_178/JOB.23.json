    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Séptima respuesta de Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Job le respondió a Elifaz:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«A pesar de todo lo dicho,",
          "y de lo amargo de mis quejas,",
          "Dios me sigue castigando."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Si yo supiera dónde vive,",
          "iría corriendo a buscarlo;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "le presentaría mi defensa",
          "en forma detallada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Entonces él me explicaría",
          "por qué me ha tratado así."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Trataría de entenderme,",
          "y sin violencia me respondería."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En la presencia de Dios,",
          "el inocente puede defenderse.",
          "Yo creo que Dios es mi juez,",
          "y me declarará inocente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8,
          9
        ],
        "lines": [
          "»Busco a Dios por todas partes,",
          "y no puedo encontrarlo;",
          "ni en el este, ni en el oeste,",
          "ni en el norte, ni en el sur."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pero si lo encuentro,",
          "y él me pone a prueba,",
          "yo saldré tan puro como el oro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11,
          12
        ],
        "lines": [
          "Jamás lo he desobedecido;",
          "siempre he seguido sus enseñanzas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Dios hace lo que quiere,",
          "pues es el único Dios.",
          "Nadie lo hace cambiar de planes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Así que él hará conmigo",
          "todo lo que quiera hacer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Cuando pienso en todo esto,",
          "me asusta el presentarme ante él."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡El Dios todopoderoso",
          "me hace temblar de miedo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pero nada hará que me calle;",
          "¡ni aun mi gran sufrimiento!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
