    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Quinto lamento"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "El pueblo de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios mío, fíjate en nuestra desgracia;",
          "date cuenta de que nos ofenden."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nuestras tierras y nuestra patria",
          "han caído en manos de extranjeros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Nos hemos quedado sin padre;",
          "nuestras madres han quedado viudas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Hasta el agua y la leña",
          "tenemos que pagarlas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El enemigo nos persigue.",
          "Nos tiene acorralados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡A nuestros peores enemigos,",
          "tenemos que pedirles alimento!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pecaron nuestros antepasados,",
          "¡y Dios nos castigó a nosotros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los esclavos se creen reyes,",
          "¡y no podemos librarnos de ellos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Para conseguir alimentos,",
          "arriesgamos la vida en el desierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tanta es el hambre que tenemos",
          "que hasta deliramos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "En todas nuestras ciudades",
          "violaron a nuestras mujeres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "No respetaron a nuestros jefes;",
          "¡los colgaron de las manos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Nuestros jóvenes y niños",
          "cargan leña como esclavos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ya los jóvenes no cantan",
          "ni se reúnen los ancianos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "No tenemos motivo de alegría;",
          "en vez de danzas, hay tristeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Pobres de nosotros!",
          "Por el pecado perdimos el reino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Vamos perdiendo las fuerzas;",
          "estamos a punto de morir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El monte Sión ha quedado desierto;",
          "solo se ven animales salvajes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pero tú, Dios nuestro,",
          "reinas para siempre.",
          "¡Tú eres nuestro rey!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Por qué te olvidas de nosotros",
          "y nos abandonas tanto tiempo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Déjanos volver a ti, y volveremos!",
          "¡Devuélvenos el poder que tuvimos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "En verdad nos diste la espalda;",
          "¡se te fue la mano!"
        ],
        "rlw_lines": []
      }
    ]
  },
