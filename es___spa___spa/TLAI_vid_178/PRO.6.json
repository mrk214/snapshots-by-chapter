{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PRO","name":"Proverbios"},"chapter":{"chapter_usfm":"PRO.6","is_chapter":true,"previous":{"usfm":"PRO.5","human":"Proverbios 5","canonical":true,"toc":true},"current":{"usfm":"PRO.6","human":"Proverbios 6"},"next":{"usfm":"PRO.7","human":"Proverbios 7","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Piensa antes de actuar"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Querido jovencito,","si algún amigo te pide","que respondas por él","y te comprometas","a pagar sus deudas,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["no aceptes ese compromiso,","pues caerás en la trampa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["No dejes que tu amigo te atrape;","¡mejor ponte a salvo!","Te recomiendo que vayas a verlo","y le ruegues que no te comprometa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Que no te agarren de tonto;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["mejor ponte a salvo,","como huyen del cazador,","las aves y los venados."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["No seas perezoso"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["¡Vamos, joven perezoso,","fíjate en la hormiga!","¡Fíjate en cómo trabaja,","y aprende a ser sabio como ella!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["La hormiga no tiene jefes,","ni capataces ni gobernantes,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["pero durante la cosecha","recoge su comida y la guarda."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Jovencito perezoso,","¿cuánto más seguirás durmiendo?,","¿cuándo vas a despertar?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Te duermes un poco,","te tomas la siesta,","tomas un descansito","y te cruzas de brazos…"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["¡Así acabarás","en la más terrible pobreza!"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["No seas mentiroso"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Hay gente mala y sinvergüenza","que anda contando mentiras;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["para engañar a los otros,","guiña el ojo,","apunta con los dedos,","y hace señas con los pies."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Esa gente solo piensa hacer lo malo,","y siempre anda provocando pleitos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Por eso la desgracia","vendrá sobre ellos de repente;","cuando menos lo esperen,","serán destruidos sin remedio."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["No provoques peleas"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Hay seis clases de gente,","y puede añadirse una más","que Dios no puede soportar:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["La gente orgullosa,","la gente violenta,","la gente mentirosa,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["la gente malvada,","la gente ansiosa de hacer lo malo,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["la gente que miente en un juicio,","y la que provoca pleitos familiares."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Cuidado con la mujer infiel"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Querido jovencito,","cumple al pie de la letra","con los mandamientos de tu padre","y con las enseñanzas de tu madre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Grábatelos en la memoria,","y tenlos siempre presentes;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["te mostrarán el camino a seguir,","velarán tu sueño mientras duermes,","y hablarán contigo cuando despiertes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Los mandamientos y las enseñanzas","son como una lámpara encendida;","la corrección y la disciplina","te mostrarán cómo debes vivir;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["te cuidarán de la mujer infiel,","que con palabras dulces te convence."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["No pienses en esa malvada;","no te dejes engañar por su hermosura","ni te dejes cautivar por su mirada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Por una prostituta","puedes perder la comida,","pero por la mujer de otro","puedes perder la vida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Si te echas brasas en el pecho,","te quemarás la ropa;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["si caminas sobre brasas,","te quemarás los pies;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["si te enredas con la esposa de otro,","no quedarás sin castigo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["No se ve mal que un ladrón","robe para calmar su hambre,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["aunque si lo sorprenden robando","debe devolver siete veces","el valor de lo robado;","a veces tiene que pagar","con todas sus posesiones."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32,33],"lines":["Pero el que se enreda","con la mujer de otro","comete la peor estupidez:","busca golpes,","encuentra vergüenzas,","¡y acaba perdiendo la vida!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Además, el marido engañado","da rienda suelta a su furia;","si de vengarse se trata,","no perdona a nadie."],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["Un marido ofendido","no acepta nada a cambio;","no se da por satisfecho","ni con todo el oro del mundo."],"rlw_lines":[]}]}}