s":["6 (8) Cuando el pueblo de Dios vea esto","quedará muy impresionado,","y entre burlas te dirá:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["7 (9) «¡Así acabarás,","campeón de la violencia,","pues no buscas refugio en Dios!","¡Y así acabarán los ricos,","que solo confían en las riquezas!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["8 (10) Por lo que a mí toca,","siempre pongo mi confianza","en el gran amor de Dios;","yo, en su presencia, cobro vida","como árbol cargado de frutos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["9 (11) Dios mío,","yo siempre te daré gracias","por todo lo que has hecho;","en ti pondré mi confianza","porque tú eres bueno.","¡Pongo por testigo","al pueblo que te ama!"],"rlw_lines":[]}]}}