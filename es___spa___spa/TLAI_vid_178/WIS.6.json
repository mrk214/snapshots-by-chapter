    "human": "Sabiduría"
  },
  "chapter": {
    "usfm": "WIS.6",
    "human": "Sabiduría 6",
    "previous": {
      "usfm": "WIS.5",
      "human": "Sabiduría 5"
    },
    "next": {
      "usfm": "WIS.7",
      "human": "Sabiduría 7"
    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Busquen la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Ustedes, reyes del mundo,",
          "escuchen, entiendan y aprendan!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Presten atención ustedes,",
          "gobernantes de las naciones!",
          "¡No se vuelvan orgullosos",
          "por ser reyes de muchos pueblos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El Dios altísimo,",
          "les ha dado el poder y la autoridad.",
          "Dios conoce sus pensamientos,",
          "y solo él les pedirá cuentas",
          "de todo lo que hacen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Reyes de la tierra,",
          "Dios les ha dado autoridad",
          "para que reinen en su nombre.",
          "Ustedes, sin embargo,",
          "no han actuado bien,",
          "ni han cumplido su ley;",
          "¡no viven de acuerdo",
          "con su voluntad!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios pronto vendrá",
          "a castigarlos con fuerza.",
          "Dios castiga sin piedad",
          "a los que hacen mucho daño",
          "y abusan del poder."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A los pobres de la tierra,",
          "Dios les tiene compasión",
          "y los perdona;",
          "pero castiga con dureza",
          "a los que abusan del poder."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios no retrocede ante nadie;",
          "no le tiene miedo",
          "a los poderosos.",
          "Él hizo al grande y al chico,",
          "y no hace diferencia",
          "entre unos y otros;",
          "a todos cuida por igual."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A los poderosos",
          "Dios les pedirá cuentas",
          "con mucho rigor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por eso, ustedes,",
          "reyes y gobernantes,",
          "aprendan a ser sabios",
          "y no pequen contra Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Si cumplen sus leyes",
          "y se dejan enseñar por ellas,",
          "esas mismas leyes los defenderán",
          "en el día del juicio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Amen mis palabras!",
          "Escúchenlas con atención,",
          "y aprendan de ellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amor a la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "La sabiduría alumbra como una luz,",
          "y nada puede apagarla.",
          "Los que la aman y la buscan",
          "la encontrarán fácilmente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ella misma busca",
          "a los que la desean."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El que la busca desde niño,",
          "no perderá su tiempo,",
          "pues ella misma irá a su encuentro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "La prudencia perfecta se consigue",
          "cuando se piensa en ella.",
          "El que se esfuerza en encontrarla",
          "vivirá sin preocupaciones."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "La sabiduría busca con entusiasmo",
          "a los que la merecen,",
          "y les sale al encuentro",
          "en todos sus pensamientos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "El interés sincero por aprender",
          "es el primer paso para ser sabio.",
          "Solo el que ama la sabiduría",
          "se interesa por aprender."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El que ama la sabiduría",
          "obedece sus leyes,",
          "y el que obedece sus leyes",
          "vivirá para siempre"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "y estará cerca de Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Solo el que ama la sabiduría",
          "puede ser un buen gobernante."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Por eso, reyes de los pueblos,",
          "si ustedes quieren reinar mucho tiempo,",
          "tienen que amar la sabiduría."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El sabio comunica su sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ahora voy a decirles",
          "lo que es la sabiduría",
          "y de dónde proviene.",
          "Les contaré todo",
          "desde el principio;",
          "nada les ocultaré",
          "ni les diré mentiras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "La envidia,",
          "que solo busca destruir,",
          "no me obligará",
          "a ocultarles lo que sé.",
          "La envidia y la sabiduría",
          "no pueden ser amigas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Los sabios",
          "son la salvación del mundo,",
          "y un gobernante sabio",
          "da seguridad a su pueblo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Dejen, entonces,",
          "que les enseñe con mis palabras;",
          "ya verán cuánto ganarán con ellas."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
