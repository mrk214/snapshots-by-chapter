    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La ciudad de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno compuesto por la familia de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1,
          2
        ],
        "lines": [
          "1-2 (2-3) Poderoso es nuestro Dios",
          "y merece nuestra alabanza.",
          "En el templo del monte Sión",
          "habita nuestro Dios y Rey.",
          "¡Allí la tierra se alegra!",
          "¡Allí la tierra lo adora!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Dios protege nuestra ciudad;",
          "por él vivimos confiados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Algunos reyes se unieron",
          "para atacar la ciudad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) pero cuando la vieron",
          "ya no supieron qué hacer;",
          "se asustaron por completo",
          "y se echaron a correr."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Tú los llenaste de miedo.",
          "Como heridos de muerte,",
          "se retorcían de dolor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Tú los llenaste de miedo,",
          "parecían marineros",
          "en violenta tempestad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Eso ya lo sabíamos;",
          "en la ciudad de nuestro Dios",
          "lo hemos confirmado:",
          "el Dios del universo,",
          "hará que esta ciudad",
          "permanezca para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Dios mío, Dios mío,",
          "en tu templo nos ponemos a pensar",
          "en la grandeza de tu amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Tu fama llega",
          "hasta el fin del mundo;",
          "por todas partes",
          "se habla bien de ti.",
          "¡Tú gobiernas con justicia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) En el monte Sión,",
          "y entre los pueblos de Judá",
          "tus justas decisiones",
          "son motivo de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) ¡Vengan a Jerusalén!",
          "¡Den un paseo por ella",
          "y vean cuántas torres tiene!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (14) ¡Fíjense en sus murallas,",
          "y revisen sus fortalezas!",
          "Así podrán contárselo",
          "a los que todavía no han nacido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "14 (15) ¡Este es nuestro Dios!",
          "¡Nuestro Dios es un Dios eterno",
          "que siempre guiará nuestra vida!"
        ],
        "rlw_lines": []
      }
    ]
  },
