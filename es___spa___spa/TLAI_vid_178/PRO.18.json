    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Premio o castigo, tú lo decides"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El que es egoísta",
          "solo piensa en sí mismo",
          "y no acepta ningún consejo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Al tonto no le interesa aprender,",
          "sino mostrar lo poco que sabe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "La maldad nunca llega sola;",
          "viene siempre acompañada",
          "de vergüenza y desprecio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Las palabras del sabio",
          "son fuente de sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Qué malo es",
          "declarar inocente al malvado",
          "y no hacerle justicia al inocente!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cuando el tonto abre la boca,",
          "causa discusiones y pleitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuando el necio abre la boca,",
          "pone su vida en peligro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Qué sabrosos son los chismes,",
          "pero cuánto daño causan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El vago y el destructor,",
          "¡hasta parecen hermanos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios es como una alta torre;",
          "hacia él corren los buenos",
          "para ponerse a salvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El rico cree estar protegido,",
          "piensa que sus riquezas",
          "son como una ciudad con murallas",
          "donde nadie puede hacerle daño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El orgullo acaba en fracaso;",
          "la honra comienza con la humildad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Es muy tonto y vergonzoso",
          "responder antes de escuchar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Con ánimo se alivia al enfermo,",
          "pero no a quien está deprimido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El que es sabio e inteligente",
          "presta atención y aprende más."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Con un regalo generoso",
          "todo el mundo te recibe;",
          "¡hasta la gente más importante",
          "te abre sus puertas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "El primero en defenderse",
          "alega ser inocente,",
          "pero llegan los testigos",
          "y afirman lo contrario."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Los pleitos más difíciles",
          "hay que ponerlos en manos de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Es más fácil derribar un muro",
          "que calmar al amigo ofendido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Cada uno recibe por sus palabras",
          "su premio o su castigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "La lengua tiene poder",
          "para dar vida y para quitarla;",
          "los que no paran de hablar",
          "sufren las consecuencias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Si ya tienes esposa,",
          "ya tienes lo mejor:",
          "¡Dios te ha demostrado su amor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El pobre suplica;",
          "el rico insulta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Con ciertos amigos,",
          "no hacen falta enemigos,",
          "pero hay otros amigos",
          "que valen más que un hermano."
        ],
        "rlw_lines": []
      }
    ]
  },
