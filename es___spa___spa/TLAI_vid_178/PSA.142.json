    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios es mi refugio"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) David compuso este himno cuando huía de Saúl y se escondió en una cueva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Mi Dios,",
          "a ti elevo mi voz",
          "para pedirte ayuda;",
          "a ti elevo mi voz",
          "para pedirte compasión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2,
          3
        ],
        "lines": [
          "2-3 (3-4) Cuando me siento deprimido,",
          "a ti te hago saber lo que me angustia.",
          "Tú sabes cómo me comporto.",
          "Hay algunos que a mi paso",
          "me tienden una trampa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Mira bien a mi derecha:",
          "¡nadie me presta atención!",
          "¡No hay nadie que me proteja!",
          "¡A nadie le importo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Dios mío,",
          "a ti te ruego y te digo:",
          "«¡Tú eres mi refugio!",
          "¡En este mundo",
          "tú eres todo lo que tengo!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) ¡Atiende mis ruegos,",
          "pues me encuentro muy débil!",
          "¡Líbrame de mis enemigos,",
          "pues son más fuertes que yo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) ¡Sácame de esta angustia,",
          "para que pueda alabarte!",
          "Al ver que me tratas bien,",
          "los justos harán fiesta."
        ],
        "rlw_lines": []
      }
    ]
  },
