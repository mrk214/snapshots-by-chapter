    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Marcha triunfal de los israelitas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Desde que los israelitas",
          "salieron de Egipto,",
          "de ese país extranjero,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Judá llegó a ser",
          "el lugar donde Dios puso su templo.",
          "La tierra de Israel",
          "llegó a ser su dominio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Al ver a los israelitas,",
          "el mar les abrió paso",
          "y el río Jordán dejó de correr;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "las montañas y las colinas",
          "saltaron como corderos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Qué te pasó, mar?",
          "¿Por qué les abriste paso?",
          "¿Qué te pasó, río Jordán?",
          "¿Por qué dejaste de correr?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Y ustedes, montañas y colinas,",
          "¿por qué saltaron como corderos?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7,
          8
        ],
        "lines": [
          "Tierra,",
          "¡ponte a temblar",
          "en presencia de nuestro Dios!",
          "Él convirtió la roca en manantial.",
          "¡Él es el Dios de Israel!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
