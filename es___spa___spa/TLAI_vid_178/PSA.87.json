    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Himno a Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Himno de la Escuela de música de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Dios mismo fundó",
          "la ciudad de Jerusalén",
          "sobre su montaña."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "No hay en todo Israel",
          "otra ciudad más amada por Dios",
          "que la ciudad de Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ciudad de Dios,",
          "de ti se dicen cosas muy bellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4,
          5
        ],
        "lines": [
          "Dios ha dicho:",
          "«Entre los pueblos que me adoran",
          "se encuentran Egipto y Babilonia,",
          "Tiro, Etiopía y Filistea.",
          "La gente de esas naciones dirá:",
          "“¡Conocí a Dios en Jerusalén!”",
          "Y lo mismo dirán los del monte Sión.",
          "»Yo, el Dios altísimo,",
          "fundé Jerusalén",
          "con mis propias manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "En mi lista de naciones,",
          "yo mismo escribí:",
          "“Toda esta gente",
          "me conoció en Jerusalén”»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Y entre cantos y danzas,",
          "esas naciones dirán:",
          "«Conocimos a Dios en Jerusalén»."
        ],
        "rlw_lines": []
      }
    ]
  },
