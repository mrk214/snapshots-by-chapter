    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tú eres mi Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Oración de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Dios mío,",
          "yo soy muy pobre y humilde,",
          "pero te ruego que me atiendas.",
          "¡Respóndeme!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sálvame la vida,",
          "pues te he sido fiel.",
          "Tú eres mi Dios;",
          "sálvame, pues tuyo soy",
          "y en ti he puesto mi confianza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios mío,",
          "ten compasión de mí,",
          "pues a todas horas te llamo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Yo estoy a tu servicio;",
          "alégrame la vida,",
          "pues a ti dirijo mis ruegos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios mío,",
          "tú eres bueno y sabes perdonar;",
          "¡qué grande es tu amor",
          "por los que te buscan!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dios mío,",
          "¡atiende mi oración,",
          "presta atención a mis ruegos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuando estoy angustiado,",
          "te llamo y tú me respondes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dios mío,",
          "no hay entre todos los dioses",
          "un Dios como tú,",
          "que haga lo que tú haces."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Todas las naciones que tú hiciste",
          "vendrán a adorarte y alabarte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Solo tú eres imponente!",
          "¡Solo tú haces grandes maravillas!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios mío,",
          "yo quiero hacer siempre",
          "lo que tú ordenes;",
          "¡enséñame a hacerlo!",
          "Pon en mí este único deseo:",
          "¡adorarte solo a ti!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mi Señor y Dios,",
          "yo quiero alabarte siempre",
          "con todo el corazón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tanto me amas",
          "que no me dejas morir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Dios mío,",
          "una banda de asesinos",
          "que presume de su maldad",
          "me ataca y quiere matarme.",
          "No quieren nada contigo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero tú, mi Dios,",
          "eres bondadoso y compasivo;",
          "no te enojas fácilmente,",
          "y tu amor es siempre el mismo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Dirige a mí tu mirada",
          "y tenme compasión.",
          "Soy tu servidor más humilde,",
          "¡concédeme tu fuerza",
          "y ven a salvarme!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Haz que mi vida refleje",
          "lo bueno que eres tú.",
          "Quedarán en ridículo mis enemigos",
          "cuando vean que tú",
          "me das ayuda y consuelo."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
