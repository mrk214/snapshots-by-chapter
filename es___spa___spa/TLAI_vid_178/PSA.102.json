    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Dios mío, tus años no tienen fin!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Oración de un afligido que se desahoga en la presencia de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1,
          2
        ],
        "lines": [
          "1-2 (2-3) Dios mío,",
          "escucha mi oración;",
          "atiende a mis ruegos.",
          "No tardes en responderme",
          "cuando te llame;",
          "no me des la espalda",
          "cuando me encuentre angustiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) La vida es como el humo",
          "y se me escapa.",
          "Los huesos me arden de dolor;",
          "parecen carbones encendidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Me siento muy afligido;",
          "hasta parezco hierba marchita.",
          "¡Ni ganas de comer tengo,",
          "y hasta los huesos se me ven!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) ¡Es muy grande mi angustia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6,
          7
        ],
        "lines": [
          "6-7 (7-8) Estoy tan triste y solitario",
          "como un buitre en el desierto,",
          "como un búho entre las ruinas,",
          "como un gorrión sobre el tejado.",
          "¡Hasta he perdido el sueño!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) No pasa un solo día",
          "sin que mis enemigos me ofendan;",
          "¡hasta me echan maldiciones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Mi comida y mi bebida",
          "son mi propio llanto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) ¡Te enojaste,",
          "te llenaste de furia!",
          "¡Me levantaste,",
          "para derribarme después!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Mi vida va pasando",
          "como las sombras en la noche;",
          "¡me estoy marchitando como la hierba!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Pero tú, mi Dios,",
          "eres el rey eterno",
          "y vives para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13,
          14
        ],
        "lines": [
          "13-14 (14-15) Un día te levantarás",
          "y tendrás compasión de tu pueblo.",
          "¡Ese día ha llegado!",
          "¡Ya es tiempo de que lo perdones!",
          "Nosotros estamos a tu servicio",
          "y amamos a la ciudad de Jerusalén;",
          "¡verla en ruinas y entre escombros",
          "nos causa mucho dolor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "15 (16) Dios mío,",
          "todas las naciones te adorarán;",
          "todos los reyes de la tierra",
          "reconocerán tu grandeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "16 (17) Tú reconstruirás a Jerusalén",
          "y así demostrarás tu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "17 (18) Prestarás toda tu atención",
          "a los ruegos de los desamparados,",
          "y no dejarás de atenderlos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "18 (19) Que esto quede por escrito",
          "para los que aún no han nacido;",
          "para que alabe a Dios",
          "el pueblo que está por nacer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "19 (20) Mientras Dios miraba",
          "desde su palacio celestial,",
          "se fijó en la tierra;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "20 (21) al escuchar los lamentos",
          "de los presos condenados a muerte,",
          "los puso en libertad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "21 (22) Por eso en Jerusalén",
          "se alaba su nombre;",
          "por eso en Jerusalén",
          "se le cantan alabanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "22 (23) Todos los pueblos y reinos",
          "se juntan para adorarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "23 (24) En el transcurso de mi vida,",
          "Dios usó su poder para humillarme",
          "y para acortar mi existencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "24 (25) Entonces le rogué:",
          "«Para ti, Dios mío,",
          "los años no tienen fin;",
          "¡no me lleves en plena juventud!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "25 (26) En el principio",
          "tú afirmaste la tierra;",
          "tú mismo hiciste los cielos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "26 (27) pero se irán gastando,",
          "como la ropa,",
          "y un día, los destruirás.",
          "Pero tú te mantendrás firme;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "27 (28) siempre serás el mismo,",
          "y tus años no tendrán fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "28 (29) Nuestros hijos y nuestros nietos",
          "estarán a tu servicio,",
          "como lo estamos nosotros,",
          "y vivirán contigo para siempre»."
        ],
        "rlw_lines": []
      }
    ]
  },
