    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Acerca de las deudas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La gente buena y compasiva",
          "presta ayuda a quien la necesita,",
          "y así cumple los mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cuando tu prójimo esté necesitado,",
          "préstale lo que te pida,",
          "y paga a tiempo tus deudas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cumple tus promesas,",
          "confía en los demás,",
          "y siempre tendrás quien te ayude."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Hay muchos que piden prestado,",
          "y creen que el préstamo es un regalo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Son amables cuando reciben,",
          "pero groseros a la hora de pagar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "En el mejor de los casos,",
          "pagan solo la mitad",
          "y creen que hacen un favor;",
          "en el peor de los casos,",
          "¡se pierde el dinero",
          "y se gana un enemigo,",
          "quien para colmo te ofende!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Por eso muchos no quieren prestar,",
          "por miedo a perder lo que tienen."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hay que dar limosna"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tú debes ayudar a los pobres",
          "y dar limosna sin pensarlo mucho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Cumple los mandamientos:",
          "No dejes que el necesitado",
          "se vaya con las manos vacías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El dinero escondido se pudre;",
          "vale más que lo pierdas",
          "por un hermano o un amigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Haz con tus riquezas",
          "lo que te manda el Dios altísimo,",
          "y te rendirán más que el oro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "En vez de amontonar dinero,",
          "repártelo entre los pobres,",
          "y te librarás de todo mal;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "ellos te defenderán de tus enemigos",
          "mejor que un escudo o una lanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Las fianzas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El hombre de buen corazón",
          "sale fiador de su prójimo,",
          "pero el que no tiene vergüenza",
          "lo deja abandonado a su suerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Cuando alguien te haga un favor,",
          "no olvides que se arriesgó por ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pero hay gente malvada,",
          "y además malagradecida,",
          "que gasta el dinero de su fiador",
          "y abandona a quien lo salvó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17,
          18,
          19
        ],
        "lines": [
          "Por dar fianza a otros,",
          "mucha gente de buena posición",
          "perdió todo lo que tenía",
          "y tuvo que abandonar su país."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Hasta donde te sea posible,",
          "tú debes ayudar a tu prójimo;",
          "pero ten cuidado de no perderlo todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Es malo vivir de prestado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Para vivir debemos tener",
          "agua, comida, ropa y techo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Más vale vivir en la pobreza",
          "bajo tu propio techo,",
          "que comer como rico en casa ajena."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Cuando uno vive feliz",
          "con lo poco o mucho que tiene,",
          "nunca oye ningún reproche de nadie."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¡Es verdaderamente triste",
          "andar de casa en casa!",
          "Cuando estás en tierra ajena,",
          "no puedes ni abrir la boca;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "sirves a gente malagradecida,",
          "y tienes que aguantar que te digan:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "«¡Ven aquí, extranjero!",
          "¡Prepara la mesa y sírveme!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "«¡Fuera de aquí, extranjero,",
          "que espero a gente importante!",
          "Un paisano mío viene a visitarme",
          "y necesito el cuarto que ocupas»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "¡Es verdaderamente triste",
          "que te desprecien por ser extranjero,",
          "y vivir en casa ajena!"
        ],
        "rlw_lines": []
      }
    ]
  },
