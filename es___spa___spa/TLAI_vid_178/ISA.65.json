{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.65","is_chapter":true,"previous":{"usfm":"ISA.64","human":"Isaías 64","canonical":true,"toc":true},"current":{"usfm":"ISA.65","human":"Isaías 65"},"next":{"usfm":"ISA.66","human":"Isaías 66","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Dios condena la idolatría"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Dios dijo:","«Yo he salido al encuentro","de gente que no me buscaba;","a un pueblo que no me había llamado,","yo le dije: “Aquí estoy”."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Siempre he estado dispuesto","a recibir a ese pueblo rebelde,","que va por malos caminos","y sigue sus propios caprichos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Ese pueblo siempre me ofende:","ofrece sacrificios a los ídolos","y quema incienso sobre unos ladrillos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["»Este pueblo se sienta en los sepulcros","y pasa la noche en las cuevas","para rendirles culto a sus muertos;","hasta come carne de cerdo","y llena sus ollas con el caldo","que ha ofrecido a los ídolos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["»Este pueblo anda diciendo:","“No se metan con nosotros;","somos un pueblo elegido por Dios”.","»Pero son un pueblo tan molesto","como el humo en las narices,","como un fuego que arde todo el día."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Por eso llevo la cuenta","de todo lo que hace,","y no me quedaré callado,","sino que le daré su merecido."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["»Castigaré a este pueblo","por todos los crímenes que ha cometido.","Me ofendió grandemente","al quemar incienso a los ídolos","sobre los montes y las colinas.","Por eso, ajustaremos cuentas,","y le daré su merecido.","Les juro que así será»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Dios da a cada uno su merecido"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Dios también dijo:","«Cuando las uvas están jugosas,","la gente no las desecha,","porque puede sacar mucho vino.","Por eso yo,","por amor a mis servidores,","no destruiré a toda la nación."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Haré que Israel y Judá","tengan muchos descendientes,","y que habiten esta tierra","llena de colinas y montañas.","Mis elegidos poseerán la tierra,","mis servidores habitarán allí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["En la llanura de Sarón","habrá muchas ovejas,","y en el valle de Acor","pastará el ganado","que tendrá mi pueblo fiel."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["»Pero a ustedes,","que se apartan de mí,","que se olvidan de mi templo,","y ofrecen comida y vino","a los dioses de la buena fortuna","y del destino,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["no les espera nada bueno.","Porque yo los llamé","y ustedes no me respondieron,","les hablé y no me obedecieron;","hicieron lo que no me gusta,","y eligieron lo que no me agrada»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Dios también dijo:","«Mis fieles seguidores tendrán comida,","pero ustedes,","los que se apartan de mí,","sentirán hambre;","mis seguidores tendrán agua,","pero ustedes tendrán sed.","»Mis seguidores se alegrarán,","pero ustedes quedarán avergonzados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Ellos cantarán con el corazón alegre,","mientras que ustedes gritarán y llorarán","con el corazón hecho pedazos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["»A mis seguidores les daré","un nombre hermoso;","en cambio, el nombre de ustedes","se usará para maldecir a otros."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["»Yo soy un Dios fiel,","y prometo que mis fieles seguidores","dejarán de sufrir.","Todo el que pida","una bendición en el país,","la pedirá en mi nombre,","porque yo cumplo lo que prometo;","y todo el que haga un juramento","jurará en mi nombre,","porque yo cumplo mis juramentos»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El cielo nuevo y la tierra nueva"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17,18],"lines":["Dios dijo:","«Llénense de alegría,","porque voy a crear algo nuevo.","Voy a crear un cielo nuevo","y una tierra nueva.","Todo lo del pasado será olvidado,","y nadie lo recordará más.","»Voy a crear una nueva Jerusalén;","será una ciudad feliz","y en ella vivirá un pueblo alegre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Yo mismo me alegraré con Jerusalén","y haré fiesta con mi pueblo.","En Jerusalén no habrá más llanto","ni se oirán gritos de angustia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["»No habrá niños","que mueran al nacer,","ni ancianos que mueran","antes de tiempo.","Morir a los cien años","será morir joven;","no llegar a esa edad","será una maldición."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21,22],"lines":["»Mi pueblo construirá casas,","y vivirá en ellas;","sembrará viñedos y campos de trigo,","y comerá pan y beberá vino.","Mi pueblo tendrá una larga vida,","y podrá disfrutar del trabajo de sus manos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["»Mi pueblo no trabajará en vano,","ni sus hijos morirán antes de tiempo.","Porque yo los bendeciré","a ellos, a sus hijos y a sus nietos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Antes de que me llamen,","yo les responderé;","antes de que terminen de hablar,","ya los habré escuchado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["»El lobo y el cordero comerán juntos,","el león comerá pasto como el buey,","y la serpiente solo comerá tierra.","No habrá en toda Jerusalén","nadie que haga daño a los demás.","Les juro que así será»."],"rlw_lines":[]}]}}