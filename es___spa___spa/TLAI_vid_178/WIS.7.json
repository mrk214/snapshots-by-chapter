    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El rey es igual a los demás"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El rey Salomón dijo:",
          "«Yo soy un ser mortal",
          "como todos los demás.",
          "Soy descendiente",
          "del primer humano",
          "creado del polvo de la tierra,",
          "y mi cuerpo fue formado",
          "en el seno de mi madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Durante nueve meses",
          "su sangre me dio forma.",
          "Soy el fruto del amor",
          "de mi padre y de mi madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "»Cuando nací,",
          "me recibió la tierra",
          "como recibe a todos por igual.",
          "Y como todos al nacer,",
          "lo primero que hice fue llorar y respirar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi madre me envolvió en pañales,",
          "y todos me cuidaron con cariño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Los que somos reyes,",
          "nacemos igual que todos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Del mismo modo llegamos a la vida,",
          "y del mismo modo la abandonamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La alabanza de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Yo pedí a Dios",
          "sabiduría y prudencia,",
          "y las recibí sin medida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No hay tesoro más valioso",
          "que la sabiduría de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por eso, ni riquezas",
          "ni piedras preciosas",
          "valen tanto para mí.",
          "El oro, frente a ella,",
          "vale igual que un puñado de arena.",
          "La plata, con su brillo,",
          "vale tanto como el barro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "»Amo la sabiduría",
          "más que a la belleza y la salud.",
          "La prefiero más que el día,",
          "porque este termina al caer la noche,",
          "pero la sabiduría nunca se acaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "»Fue la sabiduría",
          "quien me trajo bienes y riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Gocé de todos esos bienes,",
          "sin saber que ellos",
          "vienen de la sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La estudio con sinceridad,",
          "la comparto sin envidia,",
          "y no guardo para mí su riqueza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Dios aprueba la sabiduría",
          "y la recomienda.",
          "Ella es un tesoro",
          "que nunca se acaba.",
          "Los sabios son amigos de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El sabio pide a Dios sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "»Ruego a Dios que yo pueda",
          "hablar como es debido,",
          "y que mis pensamientos",
          "merezcan los dones que él me dio.",
          "Solo Dios muestra",
          "el camino a la sabiduría;",
          "solo él enseña a los sabios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Nuestras vidas,",
          "nuestras palabras,",
          "y lo que somos capaces de hacer",
          "están en las manos de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "»Dios me enseñó",
          "cómo está hecho el mundo,",
          "y para qué sirve todo lo que existe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Me enseñó a conocer el pasado,",
          "el presente y el futuro.",
          "También me dio a conocer",
          "los movimientos del sol,",
          "los cambios de las estaciones,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "de los días y los meses,",
          "y la posición de los planetas",
          "y las estrellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "»Dios me enseñó",
          "cómo viven los animales,",
          "tanto domésticos como salvajes.",
          "Dios también me enseñó",
          "los movimientos del viento;",
          "me hizo conocer las distintas",
          "clases de plantas y sus raíces.",
          "Pero, sobre todo,",
          "Dios me enseñó a conocer",
          "el pensamiento de la gente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»Así aprendí a conocerlo todo,",
          "tanto lo que se ve",
          "como lo que no se ve.",
          "»La sabiduría,",
          "que creó todo cuanto existe,",
          "fue la que me regaló",
          "ese conocimiento»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Las cualidades de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Salomón continuó diciendo:",
          "«La sabiduría es inteligente,",
          "única, libre, movible y clara;",
          "es pura, está en todo, y ama el bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Es generosa y siempre hace lo bueno;",
          "ama a la gente y es buena observadora.",
          "»Entra en el pensamiento de todos:",
          "de los inteligentes, de los puros",
          "y de los que admiran la belleza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Se mueve con más rapidez",
          "que cualquier otra cosa,",
          "y como es tan pura",
          "lo atraviesa y penetra todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "»La sabiduría es una demostración",
          "del poder de Dios;",
          "es un resplandor",
          "del Dios perfecto y todopoderoso.",
          "Por eso nada impuro",
          "puede penetrar en ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Es un reflejo de la luz eterna,",
          "¡imagen del poder y la bondad de Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "»Como la sabiduría",
          "no tiene quien la iguale,",
          "puede hacerlo todo",
          "y renovar todo lo creado.",
          "»En todas las épocas,",
          "se hace amiga de la gente buena,",
          "y la hace amiga de Dios",
          "y la convierte en su mensajera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Dios ama muchísimo",
          "a los que viven unidos a la sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "»La sabiduría",
          "es más brillante que el sol",
          "y que todas las estrellas.",
          "Brilla más que la luz del día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "La noche vence a la luz,",
          "pero a la sabiduría no la vence",
          "ni el poder del mal."
        ],
        "rlw_lines": []
      }
    ]
  },
