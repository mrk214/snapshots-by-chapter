    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Nuestra esperanza está en Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Cántico para las peregrinaciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Dios mío, yo te llamo",
          "pues estoy muy angustiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Escúchame, Dios mío!",
          "¡Presta oído a mis gritos",
          "que te piden compasión!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Si tomaras en cuenta",
          "todos nuestros pecados,",
          "nadie podría presentarse ante ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero tú nos perdonas.",
          "¡Por eso mereces nuestra adoración!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "En Dios he puesto mi esperanza;",
          "con toda el alma confío en él,",
          "pues confío en sus promesas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Con ansias espero a Dios;",
          "¡con más ansias lo espero",
          "que los vigilantes a la mañana!",
          "Los vigilantes esperan",
          "que llegue la mañana,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "y tú, Israel, esperas",
          "la llegada de Dios",
          "porque él nos ama",
          "y nos da plena libertad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Dios salvará a Israel",
          "de todos sus pecados!"
        ],
        "rlw_lines": []
      }
    ]
  },
