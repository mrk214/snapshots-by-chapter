{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"HAB","name":"Habacuc"},"chapter":{"chapter_usfm":"HAB.2","is_chapter":true,"previous":{"usfm":"HAB.1","human":"Habacuc 1","canonical":true,"toc":true},"current":{"usfm":"HAB.2","human":"Habacuc 2"},"next":{"usfm":"HAB.3","human":"Habacuc 3","canonical":true,"toc":true},"items":[{"type":"verse","verse_numbers":[1],"lines":["Ya te he presentado mi queja,","y ahora voy a estar muy atento;","voy a esperar tu respuesta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Y Dios me respondió:","«Voy a darte a conocer","lo que está por suceder.","Escríbelo en unas tablas,","para que se lea de corrido."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Tardará un poco en cumplirse,","pero tú no te desesperes;","aún no ha llegado la hora","de que todo esto se cumpla,","pero puedo asegurarte","que se cumplirá sin falta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["»Esos babilonios son muy orgullosos,","pero ustedes, que son humildes,","vivirán porque confían en mí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Los babilonios son orgullosos,","son traicioneros como el vino;","su hambre de poder los hace","conquistar naciones y pueblos enteros.","Son como la muerte,","que siempre quiere más;","son como la tumba,","que nunca está satisfecha."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Pero un día serán humillados.","Las naciones se burlarán de ellos","y les cantarán esta canción:","“¡Qué mal te va a ir Babilonia!","¡Te hiciste rica con lo ajeno!","¿Cuándo vas a dejar de robar?”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["»El día que menos lo esperes,","tus víctimas se vengarán de ti;","te harán temblar de miedo","y te quitarán todo lo que tienes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Tú les robaste a muchas naciones,","pero otras naciones te robarán a ti.","Así pagarás todos tus crímenes,","tu violencia contra nuestro país,","contra nuestras ciudades y sus habitantes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["»¡Qué mal te va a ir Babilonia!","Hiciste ricos a los tuyos","mediante el robo y el engaño.","Creíste que así los librarías","de caer en la desgracia,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["pero lo único que hiciste","fue ponerlos en vergüenza.","Quisiste acabar con muchos pueblos,","y tú misma te hiciste el daño."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["¡Las paredes de tus ciudades","son testigos de tu maldad!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["»¡Qué mal te va a ir Babilonia!","¡Has construido tus ciudades","mediante el crimen y la violencia!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Pero yo soy el Dios de Israel,","y de nada va a servirte","todo lo que has hecho;","yo lo quemaré por completo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Y así como el agua llena los mares,","también la tierra se llenará","de gente que reconocerá mi poder."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["»¡Qué mal te va a ir Babilonia!","Humillaste a las naciones vecinas","y las dejaste en vergüenza;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["pero yo te humillaré a ti,","pues no mereces ninguna alabanza;","yo te dejaré en vergüenza;","tu orgullo se volverá humillación."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["»La violencia con que trataste","a los animales del monte Líbano","se volverá en contra tuya;","así pagarás por todos tus crímenes,","por tu violencia contra nuestro país,","contra nuestras ciudades y sus habitantes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18,19],"lines":["»¡Qué mal te va a ir, Babilonia!","¿Cómo puedes confiar en dioses falsos?","¿Cómo puedes pedirles que te ayuden?","Son ídolos de madera,","son figuras de piedra","que tú misma te has hecho,","pero que no valen nada.","Son simples figuras de metal","recubiertas de oro y plata,","que no son capaces ni de hablar;","¡simplemente, no tienen vida!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Pero yo estoy en mi santo templo;","¡ante mí debe callar toda la tierra!»"],"rlw_lines":[]}]}}