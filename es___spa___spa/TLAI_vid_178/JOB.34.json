    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segunda participación de Elihú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Elihú dijo también:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«A ustedes, los sabios,",
          "y a ustedes, los inteligentes,",
          "les ruego que me presten atención."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Si podemos distinguir los sabores,",
          "podemos distinguir las palabras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Así que examinemos este caso,",
          "y veamos quién tiene la razón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Job nos ha dicho:",
          "“Soy inocente,",
          "pero Dios no lo quiere aceptar;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "soy un hombre justo,",
          "pero parezco un mentiroso;",
          "no he cometido ningún pecado,",
          "pero Dios me hirió de muerte”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»¿Habrá otro como Job,",
          "que siempre se burla de todo?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Le encanta andar con malvados",
          "y tenerlos por amigos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Y ahora anda diciendo",
          "que no vale la pena",
          "ser amigo de Dios!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10,
          11,
          12
        ],
        "lines": [
          "»Ustedes son inteligentes,",
          "así que préstenme atención.",
          "¡No debemos siquiera pensar",
          "que el Dios todopoderoso",
          "pudiera hacer algo injusto!",
          "Al contrario, nos premia o castiga,",
          "según lo que merecemos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Su poder sobre este mundo",
          "no lo ha recibido de nadie;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "el día que él decida",
          "quitarnos su espíritu de vida,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡todos nosotros moriremos",
          "y volveremos a ser polvo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "»Job,",
          "si en verdad eres inteligente,",
          "préstame atención."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Si Dios no amara la justicia,",
          "no podría gobernar el mundo.",
          "Así que no puedes condenar",
          "al Dios justo y poderoso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Dios no considera superiores",
          "ni a reyes ni a gobernantes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Dios nos hizo a todos,",
          "seamos pobres o ricos;",
          "él no tiene favoritos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Unos y otros mueren de repente,",
          "en medio de la noche."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»Dios está siempre vigilando",
          "todo lo que hacemos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ni en la noche más oscura",
          "pueden esconderse los malvados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Dios no tiene que decidir",
          "cuándo llevarlos a juicio,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "ni necesita permiso",
          "para acabar con los poderosos",
          "y darles su merecido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Él sabe todo lo que hacen;",
          "por la noche les quita su poder",
          "y los destruye por completo;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "los castiga por su maldad",
          "donde todos puedan verlos,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "pues dejaron de obedecerlo",
          "y no siguieron sus enseñanzas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "tanto maltrataron a los pobres",
          "que sus gritos de auxilio",
          "llegaron hasta Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Pero, si Dios decide no actuar,",
          "¿quién puede exigirle que lo haga?",
          "Si él decide que nadie lo vea,",
          "¿quién puede ver su cara?",
          "Sin embargo, Dios vigila",
          "a todos los pueblos del mundo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "para que los malvados no dominen",
          "ni engañen a su pueblo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31,
          32
        ],
        "lines": [
          "»Aunque te reconozcas culpable,",
          "y prometas no volver a pecar,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Dios no te premiará.",
          "Tú lo has rechazado,",
          "y no voy a responder por ti.",
          "Así que di lo que piensas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "»Ustedes que me escuchan",
          "son sabios e inteligentes,",
          "así que tienen que admitir"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "que Job habla por hablar,",
          "y no sabe lo que dice."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Ha respondido como un malvado,",
          "y debe enfrentar el juicio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "No solo ha sido rebelde,",
          "sino que en nuestra propia cara",
          "se ha burlado de nosotros",
          "y ha insultado a Dios»."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
