{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"JOB","name":"Job"},"chapter":{"chapter_usfm":"JOB.18","is_chapter":true,"previous":{"usfm":"JOB.17","human":"Job 17","canonical":true,"toc":true},"current":{"usfm":"JOB.18","human":"Job 18"},"next":{"usfm":"JOB.19","human":"Job 19","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Segunda participación de Bildad"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Bildad respondió:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["«¡Hablemos menos y pensemos más;","entonces podremos conversar!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Job cree que somos tontos;","nos trata como si fuéramos animales."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Tan enojado está","que él mismo se despedaza;","¡pero eso no cambia nada!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5,6],"lines":["»La vida de los malvados","es como lámpara que se apaga;","es como la luz de una casa,","que de pronto deja de alumbrar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7,8,9,10],"lines":["Sus pasos van perdiendo fuerza;","caen en sus propias trampas,","y allí se quedan atrapados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11,12],"lines":["El miedo y el desastre","los siguen por todas partes;","¡no los dejan ni un momento!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["La enfermedad y la muerte","les devoran todo el cuerpo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["La muerte los arranca","de la tranquilidad del hogar;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["en su casa hay olor a azufre","porque el fuego la consume."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Los malvados son como un árbol,","al que se le secan las raíces","y se le marchitan las ramas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17,18],"lines":["Nadie se acuerda de ellos;","son lanzados a la oscuridad","y su fama queda en el olvido."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["En el pueblo donde vivían,","no les queda ningún pariente."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["De un extremo al otro de la tierra,","la gente se asombra y se asusta","al saber cómo acabaron."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Así terminan los malvados,","los que no reconocen a Dios»."],"rlw_lines":[]}]}}