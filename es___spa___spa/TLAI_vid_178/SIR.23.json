  "book": {
    "book_usfm": "SIR",
    "name": "Eclesiástico"
  },
  "chapter": {
    "chapter_usfm": "SIR.23",
    "current": {
      "usfm": "SIR.23",
      "human": "Eclesiástico 23"
    },
    "previous": {
      "usfm": "SIR.22",
