    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La sabiduría y sus ventajas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Querido jovencito,",
          "acepta mis enseñanzas;",
          "valora mis mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Trata de ser sabio",
          "y actúa con inteligencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3,
          4
        ],
        "lines": [
          "Pide entendimiento",
          "y busca la sabiduría",
          "como si buscaras plata",
          "o un tesoro escondido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Así llegarás a entender",
          "lo que es obedecer a Dios",
          "y conocerlo de verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Solo Dios puede hacerte sabio;",
          "solo Dios puede darte conocimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios ayuda y protege",
          "a quienes son honrados",
          "y siempre hacen lo bueno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dios cuida y protege",
          "a quienes siempre lo obedecen",
          "y se preocupan por el débil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Solo él te hará entender",
          "lo que es bueno y justo,",
          "y lo que es siempre tratar",
          "a todos por igual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "La sabiduría y el conocimiento",
          "llenarán tu vida de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Piensa bien antes de actuar,",
          "y estarás bien protegido;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "el mal no te alcanzará",
          "ni los malvados podrán contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Esa gente deja de hacer el bien",
          "para solo hacer el mal;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "son felices haciendo lo malo",
          "y festejando sus malas acciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Todo lo que hacen",
          "es para destruir a los demás!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16,
          17
        ],
        "lines": [
          "La sabiduría te librará",
          "de la mujer que engaña a su esposo,",
          "y también te engaña a ti",
          "con sus dulces mentiras;",
          "de esa mujer que se olvida",
          "de su promesa ante Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El que se mete con ella",
          "puede darse por muerto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡El que se mete con ella",
          "ya no vuelve a la vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Querido jovencito,",
          "tú sigue por el buen camino",
          "y haz siempre lo correcto,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "porque solo habitarán la tierra",
          "y permanecerán en ella",
          "los que siempre hagan lo bueno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "En cambio, esos malvados,",
          "en los que no se puede confiar,",
          "serán destruidos por completo."
        ],
        "rlw_lines": []
      }
    ]
  },
