    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ven a defenderme"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1-2) David compuso este poema cuando la gente de Zif fue a decirle a Saúl: «Parece que David se ha escondido entre nosotros»."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: Este himno deberá cantarse acompañado de instrumentos de cuerda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (3) Dios mío,",
          "ven a salvarme,",
          "ven a defenderme;",
          "haz uso de tu poder,",
          "¡muestra quién eres!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (4) Dios mío,",
          "escucha mi oración;",
          "atiende mis palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (5) Gente extraña y violenta",
          "me ataca y me quiere matar.",
          "¡Esa gente no quiere nada contigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4,
          5,
          6
        ],
        "lines": [
          "4-6 (6-8) Tú, mi Dios y Señor,",
          "me das tu ayuda y tu apoyo;",
          "harás caer sobre mis enemigos",
          "el mal que quieren hacerme.",
          "¡Destrúyelos, Dios mío,",
          "pues tú eres fiel!",
          "Yo, con mucho gusto,",
          "te presentaré una ofrenda",
          "y alabaré tu bondad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (9) pues me dejaste ver",
          "la derrota de mis enemigos,",
          "y me libraste de todos mis problemas."
        ],
        "rlw_lines": []
      }
    ]
  },
