    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios siempre nos ayuda"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Cántico de David para las peregrinaciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Si Dios no nos hubiera ayudado,",
          "¿qué habría sido de nosotros?",
          "¡Todos en Israel lo sabemos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Si Dios no nos hubiera ayudado",
          "cuando nos atacaba todo el mundo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "nos habrían matado a todos,",
          "pues nuestros enemigos",
          "estaban muy enojados con nosotros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Habrían acabado con nosotros",
          "como aguas desbordadas",
          "que arrasan con todo a su paso,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "como aguas turbulentas",
          "que todo lo destruyen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Alabemos a Dios,",
          "que no dejó que esos malvados",
          "nos despedazaran con sus dientes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡La trampa está hecha pedazos!",
          "¡Hemos logrado escapar,",
          "como los pájaros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡El creador de cielo y tierra",
          "nos ayudó a escapar!"
        ],
        "rlw_lines": []
      }
    ]
  },
