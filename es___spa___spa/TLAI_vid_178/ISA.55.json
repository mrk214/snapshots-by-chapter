{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.55","is_chapter":true,"previous":{"usfm":"ISA.54","human":"Isaías 54","canonical":true,"toc":true},"current":{"usfm":"ISA.55","human":"Isaías 55"},"next":{"usfm":"ISA.56","human":"Isaías 56","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Dios se unirá a su pueblo"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Dios dijo:","«Todos los que tengan sed","vengan a beber agua;","y los que no tengan dinero","vengan y lleven trigo, vino y leche","sin pagar nada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["¡Óiganme bien,","y comerán una comida","buena y deliciosa!","No vale la pena ganar dinero","y gastarlo en comidas","que no quitan el hambre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["»¡Vengan a mí","y presten atención;","obedézcanme y vivirán!","Yo me uniré a ustedes para siempre,","y así cumpliré las promesas","que hice a mi amado rey David."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Yo lo puse a él por testigo,","para que guiara y enseñara","a todas las naciones."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["»Pueblo de Israel,","llamarás a pueblos que no conocías,","y ellos irán corriendo hacia ti,","porque yo, tu Dios,","te pondré sobre todas las naciones»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Isaías dijo:","«Ahora es el momento oportuno:","¡busquen a Dios!;","¡llámenlo ahora que está cerca!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Arrepiéntanse,","porque Dios está siempre","dispuesto a perdonar;","él tiene compasión de ustedes.","»Que cambien los malvados","su manera de pensar,","y que dejen su mala conducta»."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8,9],"lines":["Dios dijo:","«Yo no pienso","como piensan ustedes","ni actúo como ustedes actúan.","Mis pensamientos y mis acciones","están muy por encima","de lo que ustedes piensan y hacen:","¡están más altos que los cielos!","Les juro que así es»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El poder de la palabra de Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Dios dijo:","«La lluvia y la nieve bajan del cielo,","y no vuelven a subir","sin antes mojar y alimentar la tierra.","Así es como brotan las semillas","y el trigo que comemos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Lo mismo pasa con mi palabra","cuando sale de mis labios:","no vuelve a mí","sin antes cumplir mis órdenes,","sin antes hacer lo que yo quiero."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Últimas palabras de consuelo"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["»Ustedes, los israelitas,","saldrán de Babilonia con alegría","y volverán con bien a su propio país.","Cuando los montes y los cerros los vean,","cantarán canciones muy alegres,","y los árboles del campo aplaudirán."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Crecerán pinos en lugar de espinos","y arrayanes en lugar de ortigas.","»El mundo entero alabará a Dios,","y eso será muestra","de su maravilloso poder»."],"rlw_lines":[]}]}}