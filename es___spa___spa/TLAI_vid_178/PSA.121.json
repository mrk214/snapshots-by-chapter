    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios te protegerá"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Cántico para las peregrinaciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Dirijo la mirada a las montañas;",
          "¿de dónde vendrá mi ayuda?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi ayuda viene de Dios,",
          "creador del cielo y de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios jamás permitirá",
          "que sufras daño alguno.",
          "Dios te cuida y nunca duerme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Dios cuida de Israel,",
          "y nunca duerme!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios te cuida y te protege;",
          "Dios está siempre a tu lado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Durante el día,",
          "el sol no te quemará;",
          "durante la noche,",
          "no te dañará la luna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios te protegerá",
          "y te pondrá a salvo",
          "de todos los peligros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dios te cuidará",
          "ahora y siempre",
          "por dondequiera que vayas."
        ],
        "rlw_lines": []
      }
    ]
  },
