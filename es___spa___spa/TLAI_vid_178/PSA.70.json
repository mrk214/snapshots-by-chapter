      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Mi Dios,",
          "¡ven pronto a salvarme!",
          "¡Ven pronto en mi ayuda!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) ¡Pon en completa vergüenza",
          "a los que quieren matarme!",
          "¡Haz que huyan avergonzados",
          "los que quieren hacerme daño!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) ¡Haz que huyan avergonzados",
          "los que se burlan de mí!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Pero que se alegren",
          "y se pongan contentos",
          "todos los que te buscan.",
          "Que siempre reconozcan tu grandeza",
          "aquellos a quienes tú has salvado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Dios mío,",
          "yo soy muy pobre,",
          "y estoy muy necesitado;",
          "¡ven pronto!",
          "Dame tu ayuda,",
          "dame la libertad;",
          "¡no te tardes!"
        ],
        "rlw_lines": []
      }
    ]
