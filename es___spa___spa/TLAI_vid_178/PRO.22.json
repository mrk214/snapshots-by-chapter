    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "De nada valen las riquezas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Vale más ser conocido y respetado",
          "que andar presumiendo de rico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Los ricos y los pobres",
          "son criaturas de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El que es inteligente",
          "ve el peligro y lo evita;",
          "el que es tonto sigue adelante",
          "y sufre las consecuencias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Humíllate y obedece a Dios,",
          "y recibirás riquezas, honra y vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "La conducta de los malvados",
          "es una trampa para los demás;",
          "si te cuidas a ti mismo",
          "te apartarás de ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Educa a tu hijo desde niño,",
          "y aun cuando llegue a viejo",
          "seguirá tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El pobre trabaja para el rico;",
          "el que pide prestado",
          "se hace esclavo del prestamista."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Siembra maldad",
          "y cosecharás desgracia;",
          "con el palo que pegues,",
          "serás golpeado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dios bendice al que es generoso",
          "y al que comparte su pan con los pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Aleja de ti al buscapleitos",
          "y se acabarán los problemas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Al que convence con su sinceridad",
          "el rey le brinda su amistad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Dios protege al sabio,",
          "pero pone en vergüenza al mentiroso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "El haragán siempre pone pretextos",
          "para no ir al trabajo;",
          "dice que un león en la calle",
          "se lo quiere comer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los besos de la mujer infiel",
          "son una trampa sin fondo;",
          "Dios no deja sin castigo",
          "a los que se enredan con ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "La necedad del niño",
          "a golpes se corrige."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El rico que roba al pobre",
          "para hacerse más rico",
          "acabará en la miseria."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cucharadas de sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Presta atención a mis palabras,",
          "que son consejos sabios,",
          "y ponte a pensar en mis enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si te las aprendes de memoria",
          "y las repites al pie de la letra,",
          "tendrás una grata experiencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19,
          20
        ],
        "lines": [
          "Confía siempre en Dios.",
          "Hoy te doy treinta sabios consejos;",
          "los he escrito pensando en ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Son dignos de confianza,",
          "para que sepas responder",
          "a quienes te pregunten."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-1-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "No abuses del pobre",
          "solo porque es pobre,",
          "ni seas injusto con él",
          "en los tribunales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Dios es abogado de los pobres,",
          "y dejará sin nada",
          "a quienes les quiten todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-2-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "No te juntes con gente de mal genio",
          "ni te hagas amigo de gente violenta,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "porque puedes volverte como ellos",
          "y pondrás tu vida en peligro."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-3-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "No te comprometas a pagar",
          "deudas que no sean tuyas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "porque si no las pagas",
          "te quedarás en la calle."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-4-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Mantén el tamaño de tu terreno",
          "tal como lo recibiste de tus padres."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "-5-"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Dime quién se esfuerza en el trabajo",
          "y te diré quién comerá como rey."
        ],
        "rlw_lines": []
      }
    ]
  },
