    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios es rey de toda la tierra"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Poema compuesto por la familia de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) ¡Aplaudan felices,",
          "pueblos del mundo!",
          "¡Alaben a Dios con alegría!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) ¡El Dios altísimo",
          "es el rey de toda la tierra",
          "y merece toda honra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) El gran rey nos dio la victoria",
          "sobre pueblos y naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Dios nos ama,",
          "pues somos su pueblo.",
          "Por eso nos dio",
          "la tierra prometida;",
          "¡esa tierra es nuestro orgullo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Dios se ha sentado en su trono",
          "entre gritos de alegría",
          "y toques de trompeta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) ¡Vamos a cantarle himnos a Dios!",
          "¡Vamos a cantarle a nuestro rey!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) ¡Cantémosle un himno hermoso,",
          "pues él reina en toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Dios reina desde su templo",
          "sobre todas las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10a) Los jefes de las naciones",
          "y el pueblo del Dios de Abraham,",
          "se juntan para adorarlo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (10b) pues a Dios le pertenecen",
          "todos los pueblos del mundo."
        ],
        "rlw_lines": []
      }
    ]
  },
