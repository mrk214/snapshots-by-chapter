    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tus enseñanzas son mi guía"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Poema de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Cuídame, Dios mío,",
          "porque en ti busco protección."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Yo te he dicho:",
          "«Tú eres mi Dios;",
          "todo lo bueno que tengo,",
          "lo he recibido de ti.",
          "Sin ti, no tengo nada»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "La gente de mi pueblo,",
          "que solo a ti te adora,",
          "me hace sentir feliz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero quienes adoran ídolos",
          "sufrirán en gran manera.",
          "¡Jamás rendiré culto a los ídolos!",
          "¡Jamás les presentaré ofrendas!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tú eres mi Dios,",
          "eres todo lo que tengo;",
          "tú llenas mi vida",
          "y me das seguridad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Gracias a ti,",
          "la herencia que me tocó",
          "es una tierra muy bella."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Yo te bendigo",
          "por los consejos que me das;",
          "tus enseñanzas me guían",
          "en las noches más oscuras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Yo siempre te tengo presente;",
          "si tú estás a mi lado,",
          "nada me hará caer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por eso estoy muy contento,",
          "por eso me siento feliz,",
          "por eso vivo confiado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Tú no me dejarás morir",
          "ni me abandonarás en el sepulcro,",
          "pues soy tu fiel servidor!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tú me enseñaste a vivir",
          "como a ti te gusta.",
          "¡En tu presencia soy muy feliz!",
          "¡A tu lado soy siempre dichoso!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
