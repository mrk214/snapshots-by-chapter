{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.9","is_chapter":true,"previous":{"usfm":"PSA.8","human":"Salmos 8","canonical":true,"toc":true},"current":{"usfm":"PSA.9","human":"Salmos 9"},"next":{"usfm":"PSA.10","human":"Salmos 10","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["La justicia de Dios"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["(1) Himno de David."],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["Instrucciones para el director del coro: Este himno deberá cantarse acompañado de flautas y arpas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[1,2],"lines":["1-2 (2-3) Dios mío, Dios altísimo,","yo quiero alabarte de todo corazón.","Quiero expresarte mi alegría;","¡quiero cantarte himnos","y hablar de tus maravillas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3,4],"lines":["3-4 (4-5) Tú eres un juez justo:","juzgaste mi caso","y me declaraste inocente.","Por ti mis enemigos huyen,","tropiezan y son destruidos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["5 (6) Reprendiste a los pueblos","que no te adoran;","destruiste a esos malvados,","¡y nadie volvió a recordarlos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["6 (7) Para siempre cayó la desgracia","sobre nuestros enemigos;","dejaste sin gente sus ciudades,","y ya nadie se acuerda de ellos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["7 (8) Dios mío, tú reinas para siempre,","estás sentado en tu trono,","y vas a dictar la sentencia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["8 (9) Juzgarás a los pueblos del mundo","con justicia y sin preferencias."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9,10],"lines":["9-10 (10-11) Tú, Dios mío,","proteges a los que son maltratados","y los libras de la angustia.","Los que te conocen","confían en ti,","pues nunca los abandonas","cuando te buscan."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["11 (12) ¡Canten himnos a Dios,","que es el rey de Jerusalén!","¡Den a conocer entre los pueblos","todo lo que ha hecho!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["12 (13) Dios sabe que ustedes han sufrido,","y les hará justicia;","Dios siempre atiende a los pobres","cuando le piden ayuda."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["13 (14) Dios mío, ¡compadécete de mí!","¡Fíjate en los que me odian!","¡Mira cómo me afligen!","¡No dejes que me maten!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["14 (15) Tú me salvaste;","por eso estoy feliz.","Iré a donde todos me oigan,","y les diré a los que pasen","que también deben alabarte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["15 (16) Los pueblos que no te conocen","han caído en su propia trampa;","han quedado atrapados","en la red que ellos tendieron."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["16 (17) Tú te has dado a conocer","como un juez siempre justo;","en cambio, los malvados","caen en su propia trampa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["17 (18) ¡Que se mueran los malvados,","esas naciones que no te conocen","ni te toman en cuenta!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["18 (19) Pero tú, Dios mío,","nunca te olvides de los pobres","ni pongas fin a sus esperanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19,20],"lines":["19-20 (20-21) ¡Vamos, mi Dios!","¡Llama a cuentas a las naciones!","¡Hazlos que sientan miedo!","¡No permitas que te desafíen!","¡Que sepan esos paganos","que no son más que polvo!"],"rlw_lines":[]}]}}