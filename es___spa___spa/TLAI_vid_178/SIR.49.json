{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"SIR","name":"Eclesiástico"},"chapter":{"chapter_usfm":"SIR.49","is_chapter":true,"previous":{"usfm":"SIR.48","human":"Eclesiástico 48","canonical":true,"toc":true},"current":{"usfm":"SIR.49","human":"Eclesiástico 49"},"next":{"usfm":"SIR.50","human":"Eclesiástico 50","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["El rey Josías"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Recordar al rey Josías","es como oler un suave perfume,","como paladear la dulzura de la miel","o escuchar la música de un banquete."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["A Josías le daba mucha tristeza","ver que el pueblo no se arrepentía;","por eso acabó con la idolatría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Aunque vivió en tiempos de violencia,","buscó a Dios de todo corazón","y fue siempre un ejemplo de bondad."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Jeremías y los últimos reyes"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Con la excepción de David,","de Ezequías y de Josías,","todos los reyes de Judá","no hicieron más que pecar.","Se apartaron de las enseñanzas de Dios,","y por eso Dios se apartó de ellos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Tuvieron que rendirse ante reyes extranjeros,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["los cuales prendieron fuego","al templo y a la ciudad,","y dejaron desiertas las calles."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Todo esto les sucedió","por maltratar al profeta Jeremías,","a quien Dios había elegido","desde antes de su nacimiento","para destruir o derribar,","pero también para levantar y reconstruir."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El profeta Ezequiel"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Ezequiel vio al Dios glorioso","sobre un carro que llevaban","unos querubines."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["También mencionó a Job,","quien se mantuvo firme","en medio de los problemas."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Los profetas menores"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["¡Que Dios dé nueva vida","a los huesos de los doce profetas!","Porque consolaron al pueblo de Dios","y lo ayudaron a mantenerse firme","y a no perder la esperanza."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Zorobabel y Josué"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11,12],"lines":["¡No encuentro las palabras","para alabar al gran Zorobabel!","¡Tampoco sé cómo alabar","al sacerdote Josué hijo de Josadac!","Reconstruyeron el altar y el templo","que había sido consagrado","para honrar a Dios por siempre."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Nehemías"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Nehemías fue un gran hombre,","pues reconstruyó los muros de Jerusalén,","puso a la ciudad puertas y cerraduras,","y reconstruyó nuestros hogares."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Los primeros antepasados"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["No hay nadie en el mundo","que pueda compararse con Henoc,","pues Dios se lo llevó al cielo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Tampoco hay otro igual a José,","que llegó a ser jefe de sus hermanos","y siempre apoyó a su pueblo.","Por eso sus restos mortales","fueron enterrados con respeto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Sem y Set merecen ser alabados,","pero no hay en toda la creación","nadie que esté por encima de Adán."],"rlw_lines":[]}]}}