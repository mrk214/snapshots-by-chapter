{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"SIR","name":"Eclesiástico"},"chapter":{"chapter_usfm":"SIR.39","is_chapter":true,"previous":{"usfm":"SIR.38","human":"Eclesiástico 38","canonical":true,"toc":true},"current":{"usfm":"SIR.39","human":"Eclesiástico 39"},"next":{"usfm":"SIR.40","human":"Eclesiástico 40","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["El estudio de la ley"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1,2],"lines":["Muy distinta es la vida","de quien se entrega por completo","al estudio de la ley de Dios.","Lo que alguien así quiere","es llegar a conocer la sabiduría","de todos nuestros antepasados.","También desea entender","lo que significa el mensaje de los profetas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Además, busca explicar los proverbios","y entender los dichos de gente famosa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Su meta es servir a gente importante","y viajar por otros países,","para conocer lo bueno y lo malo","que hay en los seres humanos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["El sabio se levanta muy temprano","y habla con Dios, su Creador;","en sus oraciones pide a Dios","que le perdone sus pecados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Si Dios así lo quiere,","ese hombre recibirá inteligencia","para que sus sabias palabras","sean como lluvia sobre la tierra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Así sabrá dar sabios consejos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["y brillarán como la luz","sus enseñanzas de la ley de Dios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Muchos alabarán su inteligencia,","y su nombre jamás será olvidado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Su pueblo y las naciones","alabarán su sabiduría;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["mientras viva,","será más famoso que mil sabios,","y cuando muera, descansará en paz."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Himno a la sabiduría de Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Ahora estoy inspirado,","y no puedo quedarme callado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Queridos jovencitos,","si me escuchan,","crecerán como rosas junto a un río;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["florecerán como los lirios,","¡perfumarán como el incienso!","¡Alaben a Dios con himnos","y bendíganlo por todo lo que ha hecho!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["¡Alábenlo con música de arpas","y denle gracias con sus cantos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["¡Dios ha hecho todo hermoso!","Cuando llega el momento,","todas sus órdenes se cumplen.","No es necesario preguntar","para qué es esto o aquello,","pues todo se sabrá a su tiempo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Dios pronunció una palabra","y se formaron los mares;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Dios da una orden,","y se cumple su voluntad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19,20],"lines":["Dios está siempre atento","a todo lo que hacemos;","para él nada es pequeño,","ni extraordinario ni difícil;","¡nada se escapa de su mirada!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Todo lo que Dios ha creado","tiene un claro propósito."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Las bendiciones de Dios","son como un río caudaloso."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23,24],"lines":["A los que hacen el bien","Dios les hace fácil la vida;","pero a los que hacen el mal","les pone muchos obstáculos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Dios creó desde el principio","el bien para los buenos,","y el mal para los malos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Para vivir, necesitamos","agua, fuego, hierro y sal,","trigo, leche, miel y vino,","y además aceite y ropa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Todo esto beneficia a los buenos,","pero en mano de los pecadores","puede hacer daño."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Para castigar a los malvados","Dios creó algunos vientos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["y también el fuego y el granizo,","el hambre y las enfermedades,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["los colmillos de las fieras,","las serpientes y la espada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Todo esto obedece a Dios,","y cumple sin protestar","todo lo que Dios ordena."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["Estoy convencido de todo esto;","por eso lo he puesto por escrito."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["Dios ha hecho todo bueno,","y a la gente le da lo que necesita."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["No digas ni pienses","que esto es mejor que aquello,","porque llegado el momento","verás que todo es bueno."],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["Y ahora, canten a Dios himnos,","y alábenlo de todo corazón."],"rlw_lines":[]}]}}