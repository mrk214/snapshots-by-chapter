    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "El novio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Princesa mía,",
          "lucen bellos tus pies",
          "en las sandalias.",
          "Las curvas de tus caderas",
          "son la obra maestra",
          "de un experto joyero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Tu ombligo es una copa",
          "llena del mejor vino.",
          "Tu vientre, un montón de trigo",
          "rodeado de rosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Tus pechos son dos gacelas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) tu cuello me recuerda",
          "a una torre de marfil.",
          "Tienen tus ojos el brillo",
          "de los manantiales de Hesbón.",
          "Afilada es tu nariz,",
          "como la torre del Líbano",
          "orientada hacia Damasco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Tu cabeza sobresale",
          "como la cumbre del monte Carmelo;",
          "hilos de púrpura",
          "parecen tus cabellos;",
          "¡cautivo de tus rizos",
          "ha quedado el rey!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) ¡Eres muy bella, amada mía!",
          "¡Eres una mujer encantadora!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Eres alta como palmera,",
          "y tus pechos son dos racimos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) He pensado en treparme",
          "y hacer míos esos racimos.",
          "Tus pechos se volverán",
          "dos racimos de uvas,",
          "y tu aliento tendrá",
          "fragancia de manzanas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Habrá en tus labios",
          "el gusto del buen vino",
          "que al correr moja y acaricia",
          "los labios y los dientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Yo soy de mi amado,",
          "y su pasión lo obliga a buscarme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Ven conmigo, amado mío,",
          "acompáñame a los campos.",
          "Pasaremos la noche",
          "entre flores de azahar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Cuando amanezca,",
          "iremos a los viñedos",
          "y veremos sus retoños,",
          "los capullos abiertos,",
          "y los granados en flor.",
          "¡Allí te entregaré mi amor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (14) Ya esparcen las mandrágoras",
          "la fragancia de sus frutos;",
          "hay a nuestra puerta",
          "fruta fresca y fruta seca.",
          "Amado mío,",
          "¡los frutos más variados",
          "los he guardado para ti!"
        ],
        "rlw_lines": []
      }
    ]
  },
