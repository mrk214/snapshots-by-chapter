{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.56","is_chapter":true,"previous":{"usfm":"ISA.55","human":"Isaías 55","canonical":true,"toc":true},"current":{"usfm":"ISA.56","human":"Isaías 56"},"next":{"usfm":"ISA.57","human":"Isaías 57","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Dios premia a los que son fieles"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Dios dijo:","«Hagan lo que es justo y bueno","porque pronto voy a mostrar","mi poder salvador."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Dichoso el que obedece","mis mandamientos","y los cumple con fidelidad.","Dichoso el que respeta","el día de descanso","y nunca hace nada malo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["»Si un extranjero me adora,","no tiene por qué decir:","“Dios me apartará de su pueblo”.","El hombre que no puede tener hijos","tampoco debe decir:","“Yo parezco un árbol seco”."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Porque si estos hombres","respetan el día de descanso,","si me obedecen y son fieles a mi pacto,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["yo les daré algo mejor","que tener hijos e hijas:","haré que el nombre de ellos","quede grabado para siempre","en los muros de mi templo.","Les daré un nombre eterno","que nunca será borrado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6,7],"lines":["»A los extranjeros que me adoran,","que respetan el día de descanso,","y son fieles a mi pacto,","yo los traeré a mi monte santo","y los haré dichosos","en mi casa de oración.","Si esos extranjeros me adoran,","me sirven y me aman,","yo aceptaré los sacrificios","que ofrecen sobre mi altar,","porque mi casa será llamada:","“Casa de oración","para todos los pueblos”."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["»Yo haré que los israelitas","que aún están fuera de su tierra","vuelvan a reunirse en su país.","Les juro que así será»."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Dios reprende a los jefes malos"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Dios dijo:","«Naciones enemigas,","vengan y ataquen a mi pueblo;","devórenlo como animales salvajes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["»Ustedes, jefes de mi pueblo,","deberían protegerlo","como perros guardianes;","pero parecen estar ciegos,","no se dan cuenta de nada;","parecen estar mudos,","no hacen ni dicen nada;","les gusta mucho dormir,","se pasan la vida durmiendo y soñando."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["»Ustedes, jefes de mi pueblo,","son como perros hambrientos","que nunca se llenan.","Son gente que no entiende nada,","cada uno va por su camino,","siempre detrás de sus ganancias."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["»Ustedes, jefes de mi pueblo,","dicen:","“¡Vengan!","Vamos a emborracharnos.","Y mañana haremos lo mismo,","o beberemos mucho más”»."],"rlw_lines":[]}]}}