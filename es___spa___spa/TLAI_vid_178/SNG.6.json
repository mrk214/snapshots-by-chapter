    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Las mujeres de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dinos entonces,",
          "mujer bella entre las bellas,",
          "¿a dónde se ha ido tu amado?",
          "¿Qué rumbo tomó?",
          "¡Vamos juntas a buscarlo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi amado ha venido a su jardín,",
          "al huerto de hierbas aromáticas,",
          "para juguetear entre las flores",
          "y para cortar rosas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Yo soy de mi amado,",
          "y mi amado es mío;",
          "mi amado cuida de su rebaño",
          "entre las rosas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Quinto canto"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Cántico del novio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eres bella, amada mía;",
          "bella como la ciudad de Tirsá,",
          "hermosa como Jerusalén,",
          "majestuosa como las estrellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Por favor, ya no me mires,",
          "que tus ojos me conquistaron!",
          "Son tus negros cabellos",
          "cabritos que juguetean",
          "en los montes de Galaad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Son tus blancos dientes",
          "cabritas recién bañadas.",
          "Son perfectos,",
          "no te falta ninguno."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tus mejillas, tras el velo,",
          "son rojas como manzanas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Puede haber sesenta reinas,",
          "y más de ochenta mujeres;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "pero mi palomita amada",
          "es una mujer singular;",
          "¡es una mujer perfecta!",
          "Es la hija preferida de su madre.",
          "Hasta las mujeres mismas",
          "la ven y la felicitan;",
          "reinas y princesas",
          "no se cansan de alabarla."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Los amigos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Y quién es esta hermosura?",
          "Es admirable, como la aurora;",
          "bella es, como la luna,",
          "y esplendorosa como el sol;",
          "¡majestuosa como las estrellas!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Bajé al jardín de los nogales",
          "para ver las nuevas flores del valle,",
          "los retoños de las vides",
          "y los manzanos en flor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Pero, antes de darme cuenta,",
          "¡mi pasión me condujo",
          "hasta el carro de mi príncipe!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Los amigos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (7.1) Danza, Sulamita;",
          "danza para nosotros:",
          "¡queremos verte danzar!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "La novia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Por qué me quieren ver danzar?",
          "¿Por qué quieren que baile en público?"
        ],
        "rlw_lines": []
      }
    ]
  },
