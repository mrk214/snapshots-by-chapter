{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"SIR","name":"Eclesiástico"},"chapter":{"chapter_usfm":"SIR.1","is_chapter":true,"previous":{"usfm":"WIS.19","human":"Sabiduría 19","canonical":true,"toc":true},"current":{"usfm":"SIR.1","human":"Eclesiástico 1"},"next":{"usfm":"SIR.2","human":"Eclesiástico 2","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["La sabiduría es un regalo de Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1,2],"lines":["Solo Dios puede darnos sabiduría,","porque solo él la tiene.","Solo Dios puede contar","la arena del mar,","las gotas de lluvia","y la eternidad del tiempo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Solo Dios puede medir","la altura del cielo,","la anchura de la tierra","y la profundidad del mar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Antes de crear todas las cosas,","Dios creó la sabiduría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Las enseñanzas de Dios","son la fuente de la sabiduría,","y ella nos enseña a obedecer","sus mandamientos eternos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Solo Dios es capaz de comprender","todos los secretos de la sabiduría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Nadie más puede dar a conocer","todo el conocimiento que ella tiene."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Solo Dios es sabio;","solo él merece el mayor respeto,","pues es nuestro gran rey."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Fue Dios quien creó la sabiduría.","Con mucho cuidado la midió","y llenó con ella todas sus obras."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Dios ha dado sabiduría","a todos los seres humanos,","pero los que lo aman","reciben aún más sabiduría."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Qué significa ser sabio"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11,12],"lines":["Los que obedecen a Dios","serán también respetados.","Vivirán una larga vida","llena de alegría y satisfacción."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Los que obedecen a Dios","tendrán una muerte tranquila,","y serán alabados por todos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Todo el que quiera ser sabio","debe empezar por obedecer a Dios.","La sabiduría acompaña","a los que son fieles a Dios,","desde el momento en que nacen."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Desde el principio ha estado","con todos los seres humanos,","y nunca dejará abandonados","a los que nazcan después."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16,17],"lines":["La verdadera sabiduría","consiste en obedecer a Dios.","Los que la buscan fielmente","la reciben en abundancia.","Ella misma les da muchas riquezas","y llena sus graneros con trigo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Todos los que obedecen a Dios","reciben de la sabiduría","una corona de paz y bienestar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Dios vio y midió a la sabiduría,","y la dejó caer sobre nosotros","como lluvia sobre la tierra.","Fue así como recompensó","a todos los que querían ser sabios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["La sabiduría se parece a un árbol:","sus raíces son la obediencia a Dios","y sus ramas son largos años de vida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["La obediencia a Dios","aleja el pecado y evita su enojo."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El que es sabio es paciente"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["No es posible disculpar","a quien se enoja sin razón;","el mucho enojo lleva al desastre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23,24],"lines":["El que es sabio es paciente;","sabe controlar su enojo","y habla cuando conviene hacerlo;","la gente alaba su inteligencia","y su premio es la alegría."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El que es sabio es obediente"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Los que realmente son sabios","piensan antes de hablar,","pero a la gente pecadora","no le gusta obedecer a Dios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Si ustedes quieren ser sabios,","deben obedecer a Dios,","y él les dará mucha sabiduría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["El que es sabio y educado","lo demuestra obedeciendo a Dios;","lo que más le agrada","es la gente fiel y humilde."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Ser sabio es ser sincero"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Adoren a Dios de todo corazón;","no sean hipócritas ni mentirosos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Tengan cuidado con lo que dicen;","no digan una cosa y hagan otra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["No se crean más que los otros,","porque pueden fracasar","y quedar en vergüenza.","Dios sacará a la luz lo que son,","y los humillará delante de todos."],"rlw_lines":[]}]}}