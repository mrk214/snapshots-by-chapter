{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"WIS","name":"Sabiduría"},"chapter":{"chapter_usfm":"WIS.9","is_chapter":true,"previous":{"usfm":"WIS.8","human":"Sabiduría 8","canonical":true,"toc":true},"current":{"usfm":"WIS.9","human":"Sabiduría 9"},"next":{"usfm":"WIS.10","human":"Sabiduría 10","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Salomón pide a Dios sabiduría"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["El rey Salomón pide a Dios sabiduría:","«Dios de mis padres,","Dios misericordioso,","por medio de tu palabra","tú creaste todo lo que existe."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Con tu sabiduría","formaste a los seres humanos","para que tuvieran dominio","sobre los animales y las plantas","que tú creaste;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["para que gobernaran el mundo","de acuerdo con tus mandatos","y fueran honestos","al practicar la justicia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["»Por eso te pido, Dios mío,","que me llenes de la sabiduría","que siempre te acompaña,","y que yo nunca deje de ser","uno de tus hijos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["»Yo soy tu servidor,","hijo de una servidora tuya.","Soy un simple mortal,","débil y de corta vida;","es poco lo que entiendo de leyes","y de lo que pasa en los juzgados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["»Cualquier persona,","por perfecta que sea,","nada vale sin la sabiduría,","que solo tú puedes dar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Fuiste tú, Dios mío,","quien me hiciste rey de tu pueblo,","para gobernar a todos por igual."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Me mandaste construir un templo","para rendirte culto en tu ciudad.","Me pediste hacerlo de acuerdo con el modelo","que preparaste desde el principio."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["»Contigo está la sabiduría;","ella sabe todo lo que haces,","y estaba presente cuando creabas el mundo.","Ella sabe lo que te agrada","y lo que está de acuerdo con tu voluntad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["»Envíala, Dios mío,","desde tu trono maravilloso,","desde tu palacio en el cielo.","Necesito que me acompañe","en cada tarea que realice","y me enseñe lo que a ti te agrada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Como la sabiduría todo lo conoce","y todo lo comprende,","será mi guía en todo lo que yo haga,","y con su poder me protegerá."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Con su ayuda,","haré todo lo que te agrada;","gobernaré a tu pueblo con justicia,","y ocuparé con orgullo","el trono de mi padre David."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["»Dios mío,","los hombres y las mujeres","somos simples seres mortales;","nos es difícil conocer tus planes,","y saber lo que tú quieres."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Nuestros pensamientos son limitados","y mucho de lo que planeamos","termina en fracaso."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["»Nuestro cuerpo mortal,","hecho de barro,","limita las capacidades de nuestra mente","y es una carga pesada","para el desarrollo de nuestro espíritu."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Si nos cuesta tanto trabajo","conocer todo lo que hay en la tierra,","y con mucho esfuerzo descubrimos","lo que nos rodea,","¡como seres humanos nos es imposible","descubrir lo que está en los cielos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["»El único que puede conocer tu voluntad,","es aquel a quien tú le das sabiduría","y le mandas del cielo tu santo espíritu."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Gracias a la sabiduría,","la humanidad ha podido hacer lo bueno.","Gracias a la sabiduría,","hemos aprendido a obedecerte.","¡Gracias a la sabiduría,","los mortales nos salvamos!»"],"rlw_lines":[]}]}}