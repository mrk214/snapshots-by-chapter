    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Haz el bien y vivirás"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quien ama la corrección,",
          "también ama el conocimiento;",
          "¡hay que ser tonto",
          "para no aprender del castigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Al que es bondadoso",
          "Dios le muestra su bondad,",
          "pero al que es tramposo",
          "Dios le da su merecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "La maldad no es apoyo seguro;",
          "la bondad es una base firme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "La buena esposa",
          "llena de orgullo a su esposo;",
          "la mala esposa le arruina la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "La gente buena hace planes justos;",
          "la malvada solo piensa en engañar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cuando habla la gente malvada,",
          "tiende trampas mortales;",
          "cuando habla la gente buena,",
          "libra a otros de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Caen los malvados,",
          "y termina su existencia;",
          "solo queda con vida",
          "toda la gente buena."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Al sabio se le alaba",
          "por su sabiduría;",
          "al tonto se le desprecia",
          "por su estupidez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Más vale pobre acompañado,",
          "que rico abandonado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los buenos saben",
          "que hasta los animales sufren,",
          "pero los malvados",
          "de nadie tienen compasión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El que trabaja la tierra",
          "siempre tiene comida de sobra,",
          "pero el que sueña despierto",
          "es un gran tonto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Los malvados son esclavos",
          "de sus malos deseos;",
          "pero los buenos son como árboles",
          "que dan mucho fruto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Los malvados caen en la trampa",
          "de sus propias mentiras;",
          "los buenos triunfan sobre el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cada uno recibe lo que merecen",
          "sus palabras y sus hechos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El tonto está seguro",
          "de que hace lo correcto;",
          "el sabio hace caso del consejo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los tontos fácilmente se enojan;",
          "los sabios perdonan la ofensa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "La gente honrada",
          "siempre dice la verdad,",
          "pero el testigo falso",
          "dice puras mentiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El que habla sin pensar",
          "hiere como un cuchillo,",
          "pero el que habla sabiamente",
          "sabe sanar la herida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El que dice la verdad",
          "vive una larga vida;",
          "el que solo dice mentiras",
          "no vive mucho tiempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "En la mente de los malvados",
          "solo hay engaño;",
          "entre los que aman la paz",
          "reina la alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "El bueno no sufre ningún daño;",
          "al malvado los males le llegan juntos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Dios no soporta a los mentirosos,",
          "pero ama a la gente sincera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Si realmente eres sabio,",
          "no presumas de lo que sabes;",
          "solo los tontos",
          "se jactan de su estupidez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Trabaja, y triunfarás;",
          "no trabajes, y fracasarás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "La angustia causa tristeza;",
          "pero una palabra amable",
          "trae alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "El buen amigo da buenos consejos;",
          "el malvado se pierde en su maldad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El perezoso se queda sin comida;",
          "el trabajador la tiene en abundancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Hacer lo bueno da larga vida;",
          "haz el bien y vivirás."
        ],
        "rlw_lines": []
      }
    ]
  },
