    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios nunca deja de amarnos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Alabemos a Dios, porque él es bueno!",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alabemos al Dios de dioses.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Alabemos al Señor de señores.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Solo Dios hace grandes maravillas.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios hizo los cielos con sabiduría.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Extendió la tierra sobre el agua.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Hizo los astros luminosos.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Hizo el sol, para alumbrar el día.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Hizo la luna y las estrellas,",
          "para alumbrar la noche.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "En Egipto hirió de muerte",
          "al hijo mayor de cada familia.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Sacó de Egipto a Israel.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Allí mostró su gran poder.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Partió en dos el Mar de los Juncos.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Hizo que Israel cruzara el mar.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Hundió en el mar",
          "al faraón y a su ejército.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Guió a Israel por el desierto.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Derrotó a reyes poderosos.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Quitó la vida a reyes famosos.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Hirió a Sihón, el rey amorreo.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Hirió a Og, el rey de Basán.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Entregó a su pueblo,",
          "las tierras de esos reyes.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Esa fue la herencia de Israel.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Dios no se olvidó de nosotros",
          "cuando nos vio derrotados.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Nos libró de nuestros enemigos.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Alimenta a toda su creación.",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡Alabemos al Dios del cielo!",
          "¡Dios nunca deja de amarnos!"
        ],
        "rlw_lines": []
      }
    ]
