    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Con Dios, jamás seré derrotado"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David, dedicado a Jedutún."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1,
          2
        ],
        "lines": [
          "1-2 (2-3) Solo Dios me da tranquilidad,",
          "solo él puede salvarme;",
          "solo él me da su protección,",
          "¡jamás seré derrotado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Ustedes, todos ustedes,",
          "¡ya dejen de atacarme",
          "y de querer acabar conmigo!",
          "¡Hasta parezco una pared inclinada,",
          "una cerca a punto de caerse!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Ustedes solo piensan humillarme.",
          "Les encanta decir mentiras:",
          "de labios para afuera",
          "me expresan buenos deseos,",
          "pero en su pensamiento",
          "me desean las peores cosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Solo Dios me da tranquilidad;",
          "solo él me da confianza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Solo él me da su protección,",
          "solo él puede salvarme;",
          "¡jamás seré derrotado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Dios es mi salvador;",
          "Dios es mi motivo de orgullo;",
          "me protege y me llena de fuerza.",
          "¡Dios es mi refugio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Pueblo mío,",
          "¡confía siempre en Dios!",
          "Cuando vayas a su templo,",
          "cuéntale todos tus problemas.",
          "¡Dios es nuestro refugio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) No hay un solo hombre",
          "que valga más que un suspiro;",
          "todos son pura ilusión.",
          "Si los pesaran en una balanza,",
          "¡ni juntos pesarían gran cosa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) No pongan su confianza",
          "en el dinero mal ganado;",
          "no se hagan ilusiones",
          "con el fruto de sus robos.",
          "¡No vivan solo para hacerse ricos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Dios ha dicho muchas veces:",
          "«Soy un Dios poderoso,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) pero también, un Dios de amor.»",
          "Dios mío,",
          "tú nos das a cada uno",
          "lo que merecen nuestros hechos."
        ],
        "rlw_lines": []
      }
    ]
  },
