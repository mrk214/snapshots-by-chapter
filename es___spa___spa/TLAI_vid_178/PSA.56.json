    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confío en tus promesas"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) David compuso este himno cuando los filisteos lo tomaron preso en Gat."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: Este himno deberá cantarse con la melodía «La tórtola que vive en los robles lejanos»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "ten compasión de mí,",
          "pues hay quienes me persiguen.",
          "A toda hora",
          "me atacan y me atormentan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Mis enemigos no dejan de atacarme",
          "ni de noche ni de día;",
          "¡son ya demasiados",
          "los orgullosos que me atacan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3,
          4
        ],
        "lines": [
          "3-4 (4-5) Cuando siento miedo,",
          "confío en ti, mi Dios,",
          "y te alabo por tus promesas;",
          "Confío en ti, mi Dios,",
          "y ya no siento miedo.",
          "¡Nadie podrá",
          "hacerme daño jamás!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Siempre cambian mis palabras,",
          "y solo piensan en perjudicarme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Se ponen a espiarme",
          "y hacen planes contra mí;",
          "¡tantas ganas tienen de matarme",
          "que vigilan todos mis pasos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Dios mío,",
          "¡enójate con mis enemigos",
          "y ponlos en vergüenza!",
          "¡No los dejes escapar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Anota en tu libro",
          "todas las veces que he huido;",
          "tú bien sabes",
          "las veces que he llorado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Cuando yo te pida ayuda,",
          "mis enemigos saldrán huyendo.",
          "Yo estoy seguro, Dios mío,",
          "que cuento con tu apoyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Confío en ti, mi Dios,",
          "y te alabo por tus promesas.",
          "Confío en ti, Señor,",
          "y te alabo por tus promesas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Confío en ti, mi Dios,",
          "y ya no siento miedo.",
          "¡Nadie podrá",
          "hacerme daño jamás!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Yo te prometo, Dios mío,",
          "que te cumpliré mis promesas,",
          "y delante de tu altar",
          "te daré las gracias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (14) Tú, mi Dios,",
          "me libraste de caer,",
          "me libraste de morir,",
          "para que nunca deje yo",
          "de andar en tu presencia",
          "que es la luz de la vida."
        ],
        "rlw_lines": []
      }
    ]
  },
