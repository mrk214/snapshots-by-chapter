    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios es el rey"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios mío,",
          "tú eres nuestro rey.",
          "Has mostrado tu majestad,",
          "tu grandeza y tu poder.",
          "Has afirmado el mundo,",
          "y jamás se moverá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Desde el principio eres rey;",
          "tú siempre has existido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios mío,",
          "se revuelven los ríos,",
          "se levantan las olas,",
          "¡se agitan los mares!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero tú, en el cielo,",
          "te muestras más poderoso",
          "que el rugido de los mares;",
          "¡más poderoso que las olas del mar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios mío,",
          "tus leyes tienen valor permanente.",
          "Tu presencia da a tu templo",
          "una belleza sin igual."
        ],
        "rlw_lines": []
      }
    ]
  },
