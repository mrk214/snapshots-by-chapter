    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»¡Ahora resulta que soy",
          "la burla de unos chiquillos!",
          "¡Yo ni a sus padres les confiaría",
          "el trabajo de mis perros ovejeros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Con ellos como empleados,",
          "me hubiera quedado pobre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Toda la noche la pasan",
          "en los lugares más apartados,",
          "sufriendo de hambre y dolor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Andan entre los matorrales,",
          "juntando hierbas amargas",
          "y comiendo solo raíces!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Nadie en el pueblo los quiere,",
          "pues los acusan de ladrones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por eso tienen que vivir",
          "en el lecho de arroyos secos,",
          "en cuevas y entre las rocas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "andan entre los matorrales,",
          "rebuznando como burros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Son gente de mala fama;",
          "¡por eso los echaron del país!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "»¡Ahora resulta que soy",
          "la burla de esos chiquillos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Me escupen en la cara,",
          "y con asco se apartan de mí!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ahora que Dios me humilló,",
          "y me encuentro indefenso,",
          "descaradamente me ofenden."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Estos bandidos me atacan",
          "por el lado derecho;",
          "me rodean como un ejército,",
          "y me hacen retroceder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sin ayuda de nadie",
          "me cierran el paso,",
          "pues me quieren destruir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Me atacan como un ejército",
          "cuando ha conquistado una ciudad",
          "y avanza entre los escombros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Estoy temblando de miedo,",
          "mi dignidad se va perdiendo;",
          "he perdido la esperanza de triunfar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "»Ya la vida se me escapa;",
          "los días de aflicción me aplastan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No tiene fin el dolor",
          "que sufro por las noches;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "me oprime y me ahoga,",
          "como soga al cuello;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "me convierte en ceniza",
          "y me deja caer en el fango."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "»Dios mío, yo te llamo,",
          "pero tú no me respondes;",
          "me presento ante ti,",
          "y tú apenas me miras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Eres muy cruel conmigo;",
          "me golpeas con tu brazo poderoso,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "me levantas con el viento,",
          "y me lanzas a la tormenta,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "y un día me arrojarás a la tumba,",
          "que es nuestro destino final."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "»Yo nunca le negué ayuda",
          "a quien me la pidió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Al contrario,",
          "he llorado con los que sufren,",
          "y me he dolido con los pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Pero vinieron los días malos",
          "cuando esperaba mejores tiempos;",
          "llegaron los días de sombras",
          "cuando esperaba la luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Todo el tiempo estoy inquieto;",
          "me enfrento a días de aflicción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Estoy triste, como un día nublado,",
          "pues pido ayuda a mi gente",
          "y los jefes no me la dan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Las lechuzas y los chacales",
          "son mis amigos y mis hermanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "La piel se me pudre",
          "y se me cae a pedazos;",
          "estoy ardiendo en fiebre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "De mi arpa y de mi flauta",
          "brotan notas de tristeza."
        ],
        "rlw_lines": []
      }
    ]
  },
