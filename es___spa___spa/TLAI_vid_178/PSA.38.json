    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Ven en mi ayuda!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David para cantarlo cuando se presentan las ofrendas de incienso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "si estás enojado, no me reprendas;",
          "si estás furioso, no me castigues."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Me has herido con tu enojo,",
          "has descargado tu mano sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Tan grande ha sido tu disgusto",
          "que nada sano tengo en el cuerpo;",
          "tan grande ha sido mi pecado",
          "que no tengo paz en los huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Ya no aguanto mi maldad;",
          "¡no soporto carga tan pesada!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Tan necio he sido,",
          "que hasta mis llagas apestan;",
          "¡están llenas de pus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Me siento cansado,",
          "y totalmente deprimido;",
          "todo el día ando muy triste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Estoy ardiendo en fiebre;",
          "nada en mi cuerpo está sano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Estoy muy débil y adolorido;",
          "tengo la mente aturdida.",
          "¡Por eso me quejo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Dios mío, pongo ante ti",
          "mis más grandes deseos;",
          "¡no te los puedo esconder!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Mi corazón late con ansias,",
          "las fuerzas me abandonan,",
          "la vista se me nubla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Mis amigos más queridos",
          "se quedan lejos de mí",
          "por causa de mis males;",
          "mis parientes cercanos",
          "se mantienen a distancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Los que quieren matarme",
          "me ponen trampas;",
          "los que buscan mi mal",
          "amenazan con destruirme,",
          "¡no hay un solo momento",
          "en que no hagan planes contra mí!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13,
          14
        ],
        "lines": [
          "13-14 (14-15) Pero yo cierro los oídos",
          "y hago como que no los oigo;",
          "me hago el mudo y no digo nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "15 (16) Mi Señor y Dios,",
          "yo en ti confío;",
          "tú serás quien les responda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "16 (17) Solo una cosa te pido:",
          "si acaso llego a caer,",
          "no les concedas el gusto",
          "de burlarse de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "17 (18) Casi me doy por vencido;",
          "este dolor no me deja en paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "18 (19) Debo reconocer mi maldad;",
          "me llena de angustia haber pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "19 (20) Mis enemigos son poderosos,",
          "son muchos y me odian sin razón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "20 (21) Yo los traté bien,",
          "y ahora ellos me tratan mal;",
          "procuré su bienestar,",
          "y ahora ellos me atacan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21,
          22
        ],
        "lines": [
          "21-22 (22-23) Mi Señor y Dios,",
          "¡tú eres mi salvador!",
          "No me abandones;",
          "no te alejes de mí,",
          "¡ven pronto en mi ayuda!"
        ],
        "rlw_lines": []
      }
    ]
  },
