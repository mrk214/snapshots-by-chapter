{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"SIR","name":"Eclesiástico"},"chapter":{"chapter_usfm":"SIR.6","is_chapter":true,"previous":{"usfm":"SIR.5","human":"Eclesiástico 5","canonical":true,"toc":true},"current":{"usfm":"SIR.6","human":"Eclesiástico 6"},"next":{"usfm":"SIR.7","human":"Eclesiástico 7","canonical":true,"toc":true},"items":[{"type":"verse","verse_numbers":[1],"lines":["Si tienen amigos,","no los traten como a enemigos.","Esa conducta es de pecadores,","y les creará mala fama."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Los malos deseos"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2,3],"lines":["Si se dejan dominar por sus deseos,","arruinarán sus vidas.","Los caprichos son como el fuego,","que quema las ramas de un árbol","y arruina sus frutos,","dejando un tronco seco."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Los que tienen malos deseos","siempre acaban en la ruina","y son la burla de sus enemigos."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Amigos buenos y malos"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["El que habla con dulzura","se gana muchos amigos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["De mil personas que saludan,","solo uno puede llamarse amigo,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["pero antes de confiar en él","hay que poner a prueba su amistad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Hay amigos según la ocasión:","lo son cuando todo va bien,","pero se olvidan de ti","cuando más los necesitas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Otros se vuelven tus enemigos,","y para hacerte quedar mal","cuentan por qué se pelearon."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Otros se sientan a tu mesa,","pero no los vuelves a ver","cuando te hallas en problemas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Mientras te va bien,","son uña y carne contigo;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["pero si te va mal,","se ponen en contra tuya","y no los vuelves a ver."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Es mejor alejarse de los enemigos,","y tener precaución con los amigos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Encontrar un amigo fiel","es como dar con un tesoro","o como hallar un refugio seguro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Un amigo fiel no tiene precio:","su valor no se mide con dinero."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16,17],"lines":["Un amigo así nos salvará la vida.","Si obedecemos a Dios,","hallaremos ese amigo,","y sabremos reconocerlo","porque él también obedece a Dios."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Hay que adquirir sabiduría"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Queridos jovencitos,","acepten las buenas enseñanzas","ahora que son jóvenes;","así, cuando lleguen a viejos","seguirán siendo sabios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Sigan el ejemplo del campesino:","primero trabaja la tierra,","después siembra la semilla,","y luego espera tranquilo","una abundante cosecha.","Si se esfuerzan por ser sabios","tal vez se fatiguen un poco,","pero luego podrán disfrutar","de muchos beneficios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["La gente tonta y necia","no soporta que se le enseñe."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["La sabiduría es para ellos","una carga muy pesada,","y buscan librarse de ella."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Como su nombre lo indica,","la sabiduría es conocimiento,","¡pero no todos la conocen!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Queridos jovencitos,","presten atención a mis enseñanzas","y no rechacen mis consejos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24,25],"lines":["Únanse a la sabiduría","y no abandonen sus enseñanzas;","manténganse unidos a ella,","como si fueran sus esclavos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Búsquenla, quédense a su lado,","y ámenla con todas sus fuerzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27,28,29],"lines":["Busquen la sabiduría,","no descansen hasta encontrarla;","y cuando al fin la encuentren,","no la dejen escapar.","Aunque al principio les sea difícil,","al final ella los protegerá,","y les dará paz y alegría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30,31],"lines":["Vístanse de sabiduría","como si llevaran el vestido de un rey,","como si lucieran una corona,","como si llevaran joyas","y cintas de color púrpura."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["Queridos jovencitos,","si realmente lo desean,","podrán aprender muchas cosas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["Si saben escuchar y prestan atención,","podrán llegar a ser sabios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Vayan a las reuniones de los adultos,","y cuando encuentren a un sabio,","háganse amigos de él."],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["Presten atención a los buenos consejos","y no rechacen las sabias enseñanzas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[36],"lines":["Cuando conozcan a un sabio,","visítenlo siempre que puedan."],"rlw_lines":[]},{"type":"verse","verse_numbers":[37],"lines":["Si meditan todo el tiempo","en los mandamientos de Dios,","él cumplirá sus deseos","y les dará sabiduría."],"rlw_lines":[]}]}}