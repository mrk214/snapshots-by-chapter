    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tú eres un Dios de justicia"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Poema de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: Este himno deberá cantarse con la melodía «No destruyas»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Yo les pregunto, gobernantes,",
          "¿de veras actúan con justicia?",
          "Y ustedes, hombres mortales,",
          "¿son justos en sus juicios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) ¡Al contrario!",
          "¡Todo lo que piensan",
          "lleva malas intenciones!",
          "¡Todo lo que hacen",
          "provoca violencia en el país!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Los malvados ya son malos",
          "desde antes de nacer;",
          "desde que están en el vientre",
          "ya dicen mentiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Son gente tan venenosa",
          "que hasta parecen víboras.",
          "Son venenosos como las cobras,",
          "que se hacen las sordas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) para no oír lo que dice el mago,",
          "el que hace encantamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Dios mío,",
          "¡rómpele los dientes a esa gente!,",
          "¡rómpeles los colmillos a esos leones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) ¡Haz que desaparezcan",
          "como agua entre los dedos!",
          "¡Haz que los pisoteen",
          "como a la hierba del camino!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) ¡Haz que se derritan",
          "como si fueran de hielo!",
          "¡No los dejes venir al mundo!",
          "¡Destrúyelos antes de nacer!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Antes de que sepan lo que pasa,",
          "¡hazlos que ardan como espinos!",
          "¡Haz que el viento los arrastre,",
          "aunque todavía estén con vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) Tu pueblo verá",
          "el castigo que vas a darles,",
          "y se pondrá muy contento",
          "de poder empaparse los pies",
          "en la sangre de esos malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) Y dirán hombres y mujeres:",
          "«¡Vale la pena que seamos",
          "el pueblo de Dios!",
          "¡Hay en este mundo",
          "un Dios que hace justicia!»"
        ],
        "rlw_lines": []
      }
    ]
  },
