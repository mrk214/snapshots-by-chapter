,"al que es charlatán.","La gente de bien reconoce","cuando ha cometido una falta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Quien construye con dinero prestado,","está cavando su propia tumba."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Los malvados son como leña seca,","que fácilmente se quema."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Los pecadores gozan de la vida,","pero su fin es la muerte."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Sabios y tontos"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["El que obedece a Dios","llega a ser sabio.","El que cumple sus mandamientos","domina sus malos deseos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Si no usas tu inteligencia,","nunca podrás aprender.","Aunque hay una inteligencia","que solo trae amarguras."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["El consejo de los sabios","es fuente de vida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["El cerebro del tonto","es como un vaso roto:","no retiene lo que aprende."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Cuando la persona bien educada","escucha un consejo sabio,","lo aprueba y añade un consejo más;","pero si lo escucha un tonto,","hace gestos y no lo entiende."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Hacerle caso a un tonto","es como llevar una carga pesada;","¡pero oír a una persona inteligente","es una verdadera delicia!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["El pueblo reunido pide","la opinión de la gente sabia,","y toma en cuenta lo que dice;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["pero cuando habla un tonto,","solo dice tonterías.","Para el tonto, la sabiduría","no es más que una casa en ruinas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["El tonto cree que el conocimiento","le ata las manos y los pies."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["El tonto se ríe a carcajadas;","el sabio sonríe silenciosamente."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["La instrucción adorna al sabio","más que un brazalete de oro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["El tonto entra de golpe en la casa;","la gente bien educada lo hace con respeto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["El tonto espía a través de la puerta;","la gente bien educada se queda afuera."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["El tonto escucha detrás de la puerta;","la gente bien educada jamás lo haría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25,26],"lines":["El charlatán habla sin pensar","y el sabio piensa antes de hablar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Los malos deseos del malvado","recaerán sobre sí mismo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["El chismoso se vuelve odioso","y él solo se perjudica."],"rlw_lines":[]}]}}