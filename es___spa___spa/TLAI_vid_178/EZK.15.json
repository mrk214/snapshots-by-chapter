    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jerusalén no vale nada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios también me dijo:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Hombre mortal,",
          "si fueras a sacar madera,",
          "no la sacarías de una vid."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Su tronco no sirve",
          "para hacer muebles,",
          "ni para colgar nada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Solo sirve como leña;",
          "en cuanto se queman sus puntas,",
          "y el centro se hace carbón,",
          "¡ya no sirve para nada!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Y si no es buena como leña,",
          "¡mucho menos como carbón!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "»Por eso yo les digo:",
          "Los habitantes de Jerusalén",
          "son como esa leña;",
          "¡sirven solo para avivar el fuego!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Yo pelearé contra ellos,",
          "y aunque se escapen de un fuego,",
          "otro fuego los consumirá.",
          "Cuando yo me enfrente a ellos,",
          "reconocerán que yo soy su Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Puesto que fueron infieles,",
          "yo convertiré su país en desierto.",
          "Yo soy el Dios de Israel,",
          "y cumpliré mi palabra»."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
