    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Perdóname, Dios mío"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1-2) David compuso este salmo después de que tuvo relaciones sexuales con Betsabé. El profeta Natán lo reprendió por haber cometido adulterio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (3) Dios mío,",
          "tú eres todo bondad,",
          "ten compasión de mí;",
          "tú eres muy compasivo,",
          "no tomes en cuenta mis pecados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (4) ¡Quítame toda mi maldad!",
          "¡Quítame todo mi pecado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (5) Sé muy bien que soy pecador,",
          "y sé muy bien que he pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (6) A ti, y solo a ti",
          "te he ofendido;",
          "he hecho lo malo,",
          "en tu propia cara.",
          "Tienes toda la razón",
          "al declararme culpable;",
          "no puedo alegar",
          "que soy inocente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (7) Tengo que admitir",
          "que soy malo de nacimiento,",
          "y que desde antes de nacer",
          "ya era un pecador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (8) Tú quieres que yo sea sincero;",
          "por eso me diste sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (9) Quítame la mancha del pecado,",
          "y quedaré limpio.",
          "Lava todo mi ser,",
          "y quedaré más blanco que la nieve."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (10) Ya me hiciste sufrir mucho;",
          "¡devuélveme la felicidad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (11) No te fijes en mi maldad",
          "ni tomes en cuenta mis pecados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (12) Dios mío,",
          "no me dejes tener",
          "malos pensamientos;",
          "cambia todo mi ser."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (13) No me apartes de ti;",
          "¡no me quites tu santo espíritu!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (14) Dame tu ayuda y tu apoyo;",
          "enséñame a ser obediente,",
          "y así volveré a ser feliz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (15) A los pecadores les diré",
          "que deben obedecerte",
          "y cambiar su manera de vivir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14,
          15
        ],
        "lines": [
          "14-15 (16-17) Señor y Dios mío,",
          "Dios de mi salvación,",
          "líbrame de la muerte,",
          "y entre gritos de alegría",
          "te daré gracias",
          "por declararme inocente.",
          "Abre mis labios",
          "y te cantaré alabanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "16 (18) Yo con gusto te ofrecería",
          "animales para ser sacrificados,",
          "pero eso no es lo que quieres;",
          "eso no te complace."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "17 (19) Para ti,",
          "la mejor ofrenda es la humildad.",
          "Tú, mi Dios, no desprecias",
          "a quien con sinceridad",
          "se humilla y se arrepiente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "18 (20) Trata con bondad a Jerusalén;",
          "vuelve a levantar sus murallas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "19 (21) Entonces recibirás con gusto",
          "las ofrendas que mereces,",
          "y en tu altar se presentarán",
          "toros en tu honor."
        ],
        "rlw_lines": []
      }
    ]
  },
