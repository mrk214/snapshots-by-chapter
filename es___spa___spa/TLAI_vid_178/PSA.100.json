      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "¡Viva nuestro Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1a) Himno de alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Habitantes de toda la tierra,",
          "griten con todas sus fuerzas:",
          "¡Viva Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Adórenlo con alegría!",
          "¡Vengan a su templo",
          "lanzando gritos de felicidad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Reconozcan que él es Dios;",
          "él nos hizo, y somos suyos.",
          "Nosotros somos su pueblo:",
          "¡él es nuestro pastor,",
          "y nosotros somos su rebaño!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Vengan a las puertas de su templo;",
          "¡denle gracias y alábenlo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Él es un Dios bueno;",
          "su amor es siempre el mismo,",
          "y su fidelidad jamás cambia."
        ],
        "rlw_lines": []
      }
    ]
