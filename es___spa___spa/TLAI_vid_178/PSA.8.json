    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Grandeza divina, grandeza humana"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Instrucciones para el director del coro: para cantarlo con la melodía que se toca cuando se exprimen las uvas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Nuestro Dios y nuestro rey,",
          "¡qué grande eres",
          "en toda la tierra!",
          "¡Tu grandeza está por encima",
          "de los cielos más altos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) Con las primeras palabras",
          "de los niños más pequeños,",
          "y con los cantos",
          "de los niños mayores",
          "has construido una fortaleza",
          "por causa de tus enemigos.",
          "¡Así has hecho callar",
          "a tus enemigos que buscan venganza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Cuando contemplo el cielo,",
          "y la luna y las estrellas",
          "que tú mismo hiciste,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) no puedo menos que pensar:",
          "«¿Qué somos los mortales",
          "para que pienses en nosotros",
          "y nos tomes en cuenta?»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) ¡Nos creaste casi igual a ti!",
          "Nos trataste como a reyes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) nos diste plena autoridad",
          "sobre todo lo que hiciste;",
          "nos diste dominio",
          "sobre toda tu creación:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) sobre ovejas y vacas,",
          "sobre animales salvajes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) sobre aves y peces,",
          "¡sobre todo lo que se mueve",
          "en lo profundo del mar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) Nuestro Dios y nuestro rey,",
          "¡qué grande eres",
          "en toda la tierra!"
        ],
        "rlw_lines": []
      }
    ]
  },
