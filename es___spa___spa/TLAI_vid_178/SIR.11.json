{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"SIR","name":"Eclesiástico"},"chapter":{"chapter_usfm":"SIR.11","is_chapter":true,"previous":{"usfm":"SIR.10","human":"Eclesiástico 10","canonical":true,"toc":true},"current":{"usfm":"SIR.11","human":"Eclesiástico 11"},"next":{"usfm":"SIR.12","human":"Eclesiástico 12","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Las apariencias engañan"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["El sabio, aunque sea pobre,","no tiene de qué avergonzarse;","por eso tiene un lugar","entre la gente importante."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["No alabes ni desprecies","a nadie por su apariencia;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["¡la abeja es un insecto pequeño,","pero produce la miel más dulce!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["No te sientas orgulloso","por la ropa que llevas","ni porque todo te salga bien:","Dios hace maravillas","y no alcanzamos a comprenderlas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Hay reyes que lo han perdido todo,","y hay pobres que llegaron a ser reyes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Hay gente importante y famosa","que al final cayó en desgracia."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Hay que actuar con cuidado"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7,8],"lines":["Querido jovencito,","primero averigua y luego critica;","primero escucha y luego responde.","No interrumpas mientras otro habla,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["no te metas en asuntos ajenos,","ni discutas con gente malvada."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El que mucho abarca poco aprieta"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Querido jovencito,","no trates de hacerlo todo,","pues no lo lograrás."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Por más que corras","siempre llegarás tarde."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Aunque estés pobre y necesitado,","Dios te verá con bondad","y te sacará de la miseria;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["te hará andar con la frente en alto,","y al verte todos se admirarán."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Hay que confiar en Dios"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14,15],"lines":["Todo viene de Dios:","lo bueno y lo malo,","la vida y la muerte,","la pobreza y la riqueza,","la sabiduría, el entendimiento,","el conocimiento de la ley","y la práctica de las buenas obras."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16,17],"lines":["Y es que Dios es tan bondadoso","que concede sus dones a los buenos","y siempre los hace prosperar.","Pero para los malos","Dios preparó la estupidez y la oscuridad,","y el mal los acompañará","hasta el día de su muerte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Tú puedes hacerte rico,","si trabajas y ahorras tu dinero;","pero eso, ¿de qué te servirá?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Cuando al fin decidas","disfrutar de tus ganancias,","puedes morirte en cualquier momento","y otros se quedarán con tus riquezas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Querido jovencito,","cumple con tu deber","y siempre mantendrás tu trabajo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Lo que hacen los pecadores","no es digno de admiración;","más te vale confiar en Dios","y seguir haciendo tu trabajo.","Para Dios es cosa fácil","hacer rico al pobre en un instante."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Dios bendice a los buenos","y muy pronto los hace prosperar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23,24],"lines":["Nunca digas que ya tienes bastante,","y que nada te hace falta;","tampoco creas que, por tenerlo todo,","nada malo te habrá de suceder."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Con lo bueno olvidamos lo malo,","y con lo malo olvidamos lo bueno."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26,27],"lines":["Cuando llega la desgracia","olvidamos la alegría,","y cuando llega la muerte,","para Dios es cosa fácil","darnos lo que nos merecemos.","¡Y al fin de cuentas se descubre","lo que en realidad somos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["A la gente se le conoce","a la hora de su muerte.","Por eso, antes de que muera","no hay que llamar feliz a nadie."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Cuidado con los extraños"],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["No dejes entrar en tu casa","a todo el que te encuentres,","porque hay gente mañosa"],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["que te espía y te pone trampas.","Son como los que cazan pájaros:","solo esperan que des un mal paso."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["La gente chismosa","convierte lo bueno en malo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["Basta una sola chispa","para causar un gran incendio,","y basta un solo malvado","para cometer un gran crimen."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["Por eso, cuídate de los malvados,","porque pueden causarte daño","y hasta manchar tu buen nombre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Un extraño en tu casa","te causará muchos problemas,","y aun hará que tú mismo","resultes un extraño en tu casa."],"rlw_lines":[]}]}}