  "book": {
    "book_usfm": "WIS",
    "name": "Sabiduría"
  },
  "chapter": {
    "usfm": "WIS.5",
    "human": "Sabiduría 5",
    "previous": {
      "usfm": "WIS.4",
      "human": "Sabiduría 4"
    },
    "next": {
      "usfm": "WIS.6",
      "human": "Sabiduría 6"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En el día del juicio,",
          "los que fueron fieles a Dios",
          "estarán frente a los malvados.",
          "No les tendrán miedo",
          "a quienes los habían hecho sufrir,",
          "ni temblarán ante",
          "los que se burlaron de su dolor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2,
          3
        ],
        "lines": [
          "Más bien, serán los malvados",
          "quienes llorarán",
          "y sentirán un miedo terrible,",
          "cuando vean a Dios salvar a sus fieles.",
          "Los malvados verán su error,",
          "y se dirán unos a otros:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«¡Qué tontos fuimos",
          "al burlarnos de la gente fiel a Dios!",
          "Su vida nos parecía una locura",
          "y su muerte una desgracia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero Dios los ha puesto entre sus hijos,",
          "y les ha dado un lugar entre su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "»¡Nunca actuamos con justicia!",
          "¡Nos alejamos de la verdad!",
          "¡Vivíamos como si el sol",
          "no nos alumbrara!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nunca quisimos buscar a Dios.",
          "Siempre practicamos el mal.",
          "Nuestra vida está llena de maldad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Nuestro orgullo y riquezas",
          "ya no sirven para nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Todo eso desapareció",
          "con la rapidez de un mensajero",
          "que lleva una noticia urgente;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "como barco que navega por el mar",
          "sin dejar huella alguna;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "como pájaro que vuela por el aire",
          "y no deja rastro alguno;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "como flecha que cruza por el aire",
          "sin dejar marcas de su paso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Así también nosotros:",
          "tan pronto como nacemos",
          "dejamos de existir;",
          "tan pronto como morimos",
          "caemos en el olvido.",
          "¡Nuestra propia maldad nos destruye!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "La esperanza de los malvados",
          "es como el polvo que se lleva el viento;",
          "como humo que arrastra el viento;",
          "como recuerdo de un viajero,",
          "que nunca más regresó."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El futuro glorioso de los buenos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los buenos viven para siempre;",
          "el Dios altísimo los cuida",
          "y tiene un premio para ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Dios los hará príncipes,",
          "les pondrá una hermosa corona,",
          "y con su gran poder",
          "los protegerá y los defenderá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Con los malvados será diferente,",
          "Dios usará la fuerza de su enojo",
          "y movilizará a su creación",
          "para destruir a sus enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "La justicia es la coraza de Dios,",
          "y la rectitud, su casco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Su santidad es su escudo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "y su enojo, su espada.",
          "Su aliado es el universo entero,",
          "y juntos destruirán a los malvados,",
          "porque fueron muy necios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Desde el cielo,",
          "Dios lanzará rayos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "y hará caer granizo.",
          "Así los malvados",
          "serán arrastrados por los ríos,",
          "y acabarán ahogados en el mar.",
          "No habrá para ellos compasión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Un fuerte viento los barrerá;",
          "un huracán los hará desaparecer.",
          "Porque su maldad arruinó la tierra",
          "y destruyó a los reyes."
        ],
        "rlw_lines": []
      }
    ]
  },
