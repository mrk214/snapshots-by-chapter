    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios me protege"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "(1) Himno de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Dios mío,",
          "¡líbrame de la gente malvada!",
          "¡Protégeme de la gente violenta,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) que solo piensa hacer lo malo",
          "y todo el tiempo busca pleito!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Más que gente, parecen víboras;",
          "hablan, y sus palabras",
          "son venenosas e hirientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) Dios mío,",
          "protégeme de esos malvados;",
          "protégeme de esos violentos,",
          "que solo quieren verme fracasar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6) Son gente muy orgullosa.",
          "A mi paso pusieron trampas",
          "para hacerme caer en ellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (7) Pero yo te reconozco",
          "como mi único Dios;",
          "¡por favor, escucha mis ruegos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "7 (8) Tú eres mi Dios;",
          "eres mi poderoso Salvador;",
          "tú me salvas la vida",
          "en el día de la batalla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "8 (9) Dios mío,",
          "no permitas que los malvados",
          "se salgan con la suya;",
          "no permitas que triunfen sus planes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "9 (10) ¡Haz caer sobre mis enemigos",
          "todo el mal que me desean!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "10 (11) ¡Que caigan sobre ellos",
          "carbones encendidos!",
          "¡Que caigan en pozos profundos",
          "y nunca más salgan de allí!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "11 (12) ¡Que la gente mentirosa",
          "no vuelva a vivir en la tierra!",
          "¡Que acabe la calamidad",
          "con toda la gente violenta!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "12 (13) Dios mío,",
          "de una cosa estoy seguro:",
          "¡tú defiendes y haces justicia",
          "a los pobres y necesitados!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "13 (14) Por eso la gente honrada",
          "te alaba y vive contigo."
        ],
        "rlw_lines": []
      }
    ]
  },
