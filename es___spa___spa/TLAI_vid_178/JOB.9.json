{"version":{"version_id":178,"local_abbreviation":"TLAI","local_title":"Traducción en Lenguaje Actual Interconfesional","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004.</p>","text":"Traducción en lenguaje actual ® © Sociedades Bíblicas Unidas, 2002, 2004."}},"book":{"book_usfm":"JOB","name":"Job"},"chapter":{"chapter_usfm":"JOB.9","is_chapter":true,"previous":{"usfm":"JOB.8","human":"Job 8","canonical":true,"toc":true},"current":{"usfm":"JOB.9","human":"Job 9"},"next":{"usfm":"JOB.10","human":"Job 10","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Segunda respuesta de Job"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Al oír esto, Job respondió:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["«¡Ese cuento ya lo conozco!","Yo sé bien que ante Dios","nadie puede alegar inocencia,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["ni puede tampoco discutir con él.","Dios puede hacer mil preguntas,","y nadie puede responderle."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["¿Quién puede desafiar a Dios","y esperar salir victorioso?","Su sabiduría es muy profunda,","y su poder es muy grande."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Cuando Dios se enoja,","cambia de lugar las montañas","sin que nadie se dé cuenta;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["también cambia de lugar a la tierra,","y la hace temblar hasta sus bases."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Reprende al sol, y el sol no sale;","también apaga la luz de las estrellas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Con su poder extiende el cielo","y calma las olas del mar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Dios creó todas las estrellas,","y las agrupó en constelaciones:","la Osa Mayor, la Cruz del Sur,","Orión y las Siete Cabritas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["»Dios hace cosas tan maravillosas","que es muy difícil comprenderlas,","y más aún, hablar de ellas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Si Dios pasara junto a mí,","me sería imposible verlo;","si se alejara de mí,","no me daría cuenta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Si quisiera tomar algo,","¿quién podría ordenarle no hacerlo?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Cuando Dios se enoja,","hasta el mar y sus olas","se rinden ante él."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["»Si esto es así,","¿cómo voy a poder responderle?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["A pesar de que soy inocente,","ante Dios no me puedo defender;","solo puedo suplicarle","que me tenga compasión."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Si lo llamara, y él me respondiera,","no creo que me prestaría atención."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17,18],"lines":["¡Al contrario!","¡Por la cosa más simple","aumentaría mis heridas","y no me dejaría ni respirar!","¡Me llenaría de amargura","y con una tormenta me despedazaría!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Si de comparar fuerzas se trata,","¡Dios es más poderoso!","Y si le abriera un juicio,","¿quién podría obligarlo a presentarse?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["¡Aunque no he hecho nada malo,","mi boca me condena y resulto culpable!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["»No tengo nada de qué arrepentirme,","pero eso ya no importa;","¡estoy cansado de esta vida!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["En todo caso, da lo mismo.","Por eso puedo afirmar","que Dios destruye por igual","a los buenos y a los malos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Y si alguna enfermedad provoca","que la gente muera de pronto,","Dios se burla de la angustia","de los que nada malo hicieron."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Cuando algún malvado","se apodera de un terreno,","es Dios mismo quien les tapa","los ojos a los jueces."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25,26],"lines":["»La vida se me escapa","con la rapidez del rayo.","Mis días pasan como el águila","cuando se lanza sobre su presa.","El tiempo es como un barco","que se pierde en la distancia,","y yo aquí estoy,","sin saber lo que es la felicidad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["A veces pienso en olvidarlo todo,","en cambiar de actitud y sonreír;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["pero me asusto de tanto sufrimiento,","pues sé bien que ante Dios,","no resulto inocente."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Y si él me considera culpable,","¿qué caso tiene seguir luchando?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Aunque me lave con jabón","las manos y todo el cuerpo,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Dios me arrojará al basurero,","¡y no habrá ropa que me cubra!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["»¿Cómo puedo atreverme","a citar a Dios ante un tribunal,","si soy un simple mortal?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["¿Qué juez en este mundo","podría dictar sentencia entre nosotros?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Si alguien pudiera quitarme el miedo","de sufrir el castigo divino,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["podría hablar sin temor;","pero en verdad, tengo miedo."],"rlw_lines":[]}]}}