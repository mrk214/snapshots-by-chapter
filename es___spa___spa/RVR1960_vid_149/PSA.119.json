    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Excelencias de la ley de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Alef"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bienaventurados los perfectos de camino,",
          "Los que andan en la ley de Jehová."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bienaventurados los que guardan sus testimonios,",
          "Y con todo el corazón le buscan;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pues no hacen iniquidad",
          "Los que andan en sus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tú encargaste",
          "Que sean muy guardados tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Ojalá fuesen ordenados mis caminos",
          "Para guardar tus estatutos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Entonces no sería yo avergonzado,",
          "Cuando atendiese a todos tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Te alabaré con rectitud de corazón",
          "Cuando aprendiere tus justos juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tus estatutos guardaré;",
          "No me dejes enteramente."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Bet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Con qué limpiará el joven su camino?",
          "Con guardar tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Con todo mi corazón te he buscado;",
          "No me dejes desviarme de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "En mi corazón he guardado tus dichos,",
          "Para no pecar contra ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Bendito tú, oh Jehová;",
          "Enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Con mis labios he contado",
          "Todos los juicios de tu boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Me he gozado en el camino de tus testimonios",
          "Más que de toda riqueza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "En tus mandamientos meditaré;",
          "Consideraré tus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Me regocijaré en tus estatutos;",
          "No me olvidaré de tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Guímel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Haz bien a tu siervo; que viva,",
          "Y guarde tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Abre mis ojos, y miraré",
          "Las maravillas de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Forastero soy yo en la tierra;",
          "No encubras de mí tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Quebrantada está mi alma de desear",
          "Tus juicios en todo tiempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Reprendiste a los soberbios, los malditos,",
          "Que se desvían de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Aparta de mí el oprobio y el menosprecio,",
          "Porque tus testimonios he guardado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Príncipes también se sentaron y hablaron contra mí;",
          "Mas tu siervo meditaba en tus estatutos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Pues tus testimonios son mis delicias",
          "Y mis consejeros."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Dálet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Abatida hasta el polvo está mi alma;",
          "Vivifícame según tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Te he manifestado mis caminos, y me has respondido;",
          "Enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Hazme entender el camino de tus mandamientos,",
          "Para que medite en tus maravillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Se deshace mi alma de ansiedad;",
          "Susténtame según tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Aparta de mí el camino de la mentira,",
          "Y en tu misericordia concédeme tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Escogí el camino de la verdad;",
          "He puesto tus juicios delante de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Me he apegado a tus testimonios;",
          "Oh Jehová, no me avergüences."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Por el camino de tus mandamientos correré,",
          "Cuando ensanches mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "He"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Enséñame, oh Jehová, el camino de tus estatutos,",
          "Y lo guardaré hasta el fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Dame entendimiento, y guardaré tu ley,",
          "Y la cumpliré de todo corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Guíame por la senda de tus mandamientos,",
          "Porque en ella tengo mi voluntad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Inclina mi corazón a tus testimonios,",
          "Y no a la avaricia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Aparta mis ojos, que no vean la vanidad;",
          "Avívame en tu camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Confirma tu palabra a tu siervo,",
          "Que te teme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Quita de mí el oprobio que he temido,",
          "Porque buenos son tus juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "He aquí yo he anhelado tus mandamientos;",
          "Vivifícame en tu justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Vau"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Venga a mí tu misericordia, oh Jehová;",
          "Tu salvación, conforme a tu dicho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Y daré por respuesta a mi avergonzador,",
          "Que en tu palabra he confiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "No quites de mi boca en ningún tiempo la palabra de verdad,",
          "Porque en tus juicios espero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Guardaré tu ley siempre,",
          "Para siempre y eternamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Y andaré en libertad,",
          "Porque busqué tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Hablaré de tus testimonios delante de los reyes,",
          "Y no me avergonzaré;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Y me regocijaré en tus mandamientos,",
          "Los cuales he amado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Alzaré asimismo mis manos a tus mandamientos que amé,",
          "Y meditaré en tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Zain"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Acuérdate de la palabra dada a tu siervo,",
          "En la cual me has hecho esperar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Ella es mi consuelo en mi aflicción,",
          "Porque tu dicho me ha vivificado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Los soberbios se burlaron mucho de mí,",
          "Mas no me he apartado de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Me acordé, oh Jehová, de tus juicios antiguos,",
          "Y me consolé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Horror se apoderó de mí a causa de los inicuos",
          "Que dejan tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Cánticos fueron para mí tus estatutos",
          "En la casa en donde fui extranjero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Me acordé en la noche de tu nombre, oh Jehová,",
          "Y guardé tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Estas bendiciones tuve",
          "Porque guardé tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Chet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "Mi porción es Jehová;",
          "He dicho que guardaré tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Tu presencia supliqué de todo corazón;",
          "Ten misericordia de mí según tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Consideré mis caminos,",
          "Y volví mis pies a tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Me apresuré y no me retardé",
          "En guardar tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Compañías de impíos me han rodeado,",
          "Mas no me he olvidado de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "A medianoche me levanto para alabarte",
          "Por tus justos juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Compañero soy yo de todos los que te temen",
          "Y guardan tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "De tu misericordia, oh Jehová, está llena la tierra;",
          "Enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Tet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Bien has hecho con tu siervo,",
          "Oh Jehová, conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Enséñame buen sentido y sabiduría,",
          "Porque tus mandamientos he creído."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Antes que fuera yo humillado, descarriado andaba;",
          "Mas ahora guardo tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Bueno eres tú, y bienhechor;",
          "Enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "Contra mí forjaron mentira los soberbios,",
          "Mas yo guardaré de todo corazón tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "Se engrosó el corazón de ellos como sebo,",
          "Mas yo en tu ley me he regocijado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "Bueno me es haber sido humillado,",
          "Para que aprenda tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "Mejor me es la ley de tu boca",
          "Que millares de oro y plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Yod"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "Tus manos me hicieron y me formaron;",
          "Hazme entender, y aprenderé tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "Los que te temen me verán, y se alegrarán,",
          "Porque en tu palabra he esperado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "Conozco, oh Jehová, que tus juicios son justos,",
          "Y que conforme a tu fidelidad me afligiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "Sea ahora tu misericordia para consolarme,",
          "Conforme a lo que has dicho a tu siervo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "Vengan a mí tus misericordias, para que viva,",
          "Porque tu ley es mi delicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "Sean avergonzados los soberbios, porque sin causa me han calumniado;",
          "Pero yo meditaré en tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Vuélvanse a mí los que te temen",
          "Y conocen tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "Sea mi corazón íntegro en tus estatutos,",
          "Para que no sea yo avergonzado."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Caf"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "Desfallece mi alma por tu salvación,",
          "Mas espero en tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          82
        ],
        "lines": [
          "Desfallecieron mis ojos por tu palabra,",
          "Diciendo: ¿Cuándo me consolarás?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          83
        ],
        "lines": [
          "Porque estoy como el odre al humo;",
          "Pero no he olvidado tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          84
        ],
        "lines": [
          "¿Cuántos son los días de tu siervo?",
          "¿Cuándo harás juicio contra los que me persiguen?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          85
        ],
        "lines": [
          "Los soberbios me han cavado hoyos;",
          "Mas no proceden según tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          86
        ],
        "lines": [
          "Todos tus mandamientos son verdad;",
          "Sin causa me persiguen; ayúdame."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          87
        ],
        "lines": [
          "Casi me han echado por tierra,",
          "Pero no he dejado tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          88
        ],
        "lines": [
          "Vivifícame conforme a tu misericordia,",
          "Y guardaré los testimonios de tu boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Lámed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          89
        ],
        "lines": [
          "Para siempre, oh Jehová,",
          "Permanece tu palabra en los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          90
        ],
        "lines": [
          "De generación en generación es tu fidelidad;",
          "Tú afirmaste la tierra, y subsiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          91
        ],
        "lines": [
          "Por tu ordenación subsisten todas las cosas hasta hoy,",
          "Pues todas ellas te sirven."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          92
        ],
        "lines": [
          "Si tu ley no hubiese sido mi delicia,",
          "Ya en mi aflicción hubiera perecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          93
        ],
        "lines": [
          "Nunca jamás me olvidaré de tus mandamientos,",
          "Porque con ellos me has vivificado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          94
        ],
        "lines": [
          "Tuyo soy yo, sálvame,",
          "Porque he buscado tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          95
        ],
        "lines": [
          "Los impíos me han aguardado para destruirme;",
          "Mas yo consideraré tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          96
        ],
        "lines": [
          "A toda perfección he visto fin;",
          "Amplio sobremanera es tu mandamiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Mem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          97
        ],
        "lines": [
          "¡Oh, cuánto amo yo tu ley!",
          "Todo el día es ella mi meditación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          98
        ],
        "lines": [
          "Me has hecho más sabio que mis enemigos con tus mandamientos,",
          "Porque siempre están conmigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          99
        ],
        "lines": [
          "Más que todos mis enseñadores he entendido,",
          "Porque tus testimonios son mi meditación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          100
        ],
        "lines": [
          "Más que los viejos he entendido,",
          "Porque he guardado tus mandamientos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          101
        ],
        "lines": [
          "De todo mal camino contuve mis pies,",
          "Para guardar tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          102
        ],
        "lines": [
          "No me aparté de tus juicios,",
          "Porque tú me enseñaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          103
        ],
        "lines": [
          "¡Cuán dulces son a mi paladar tus palabras!",
          "Más que la miel a mi boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          104
        ],
        "lines": [
          "De tus mandamientos he adquirido inteligencia;",
          "Por tanto, he aborrecido todo camino de mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Nun"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          105
        ],
        "lines": [
          "Lámpara es a mis pies tu palabra,",
          "Y lumbrera a mi camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          106
        ],
        "lines": [
          "Juré y ratifiqué",
          "Que guardaré tus justos juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          107
        ],
        "lines": [
          "Afligido estoy en gran manera;",
          "Vivifícame, oh Jehová, conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          108
        ],
        "lines": [
          "Te ruego, oh Jehová, que te sean agradables los sacrificios voluntarios de mi boca,",
          "Y me enseñes tus juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          109
        ],
        "lines": [
          "Mi vida está de continuo en peligro,",
          "Mas no me he olvidado de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          110
        ],
        "lines": [
          "Me pusieron lazo los impíos,",
          "Pero yo no me desvié de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          111
        ],
        "lines": [
          "Por heredad he tomado tus testimonios para siempre,",
          "Porque son el gozo de mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          112
        ],
        "lines": [
          "Mi corazón incliné a cumplir tus estatutos",
          "De continuo, hasta el fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Sámec"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          113
        ],
        "lines": [
          "Aborrezco a los hombres hipócritas;",
          "Mas amo tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          114
        ],
        "lines": [
          "Mi escondedero y mi escudo eres tú;",
          "En tu palabra he esperado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          115
        ],
        "lines": [
          "Apartaos de mí, malignos,",
          "Pues yo guardaré los mandamientos de mi Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          116
        ],
        "lines": [
          "Susténtame conforme a tu palabra, y viviré;",
          "Y no quede yo avergonzado de mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          117
        ],
        "lines": [
          "Sostenme, y seré salvo,",
          "Y me regocijaré siempre en tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          118
        ],
        "lines": [
          "Hollaste a todos los que se desvían de tus estatutos,",
          "Porque su astucia es falsedad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          119
        ],
        "lines": [
          "Como escorias hiciste consumir a todos los impíos de la tierra;",
          "Por tanto, yo he amado tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          120
        ],
        "lines": [
          "Mi carne se ha estremecido por temor de ti,",
          "Y de tus juicios tengo miedo."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          121
        ],
        "lines": [
          "Juicio y justicia he hecho;",
          "No me abandones a mis opresores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          122
        ],
        "lines": [
          "Afianza a tu siervo para bien;",
          "No permitas que los soberbios me opriman."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          123
        ],
        "lines": [
          "Mis ojos desfallecieron por tu salvación,",
          "Y por la palabra de tu justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          124
        ],
        "lines": [
          "Haz con tu siervo según tu misericordia,",
          "Y enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          125
        ],
        "lines": [
          "Tu siervo soy yo, dame entendimiento",
          "Para conocer tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          126
        ],
        "lines": [
          "Tiempo es de actuar, oh Jehová,",
          "Porque han invalidado tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          127
        ],
        "lines": [
          "Por eso he amado tus mandamientos",
          "Más que el oro, y más que oro muy puro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          128
        ],
        "lines": [
          "Por eso estimé rectos todos tus mandamientos sobre todas las cosas,",
          "Y aborrecí todo camino de mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          129
        ],
        "lines": [
          "Maravillosos son tus testimonios;",
          "Por tanto, los ha guardado mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          130
        ],
        "lines": [
          "La exposición de tus palabras alumbra;",
          "Hace entender a los simples."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          131
        ],
        "lines": [
          "Mi boca abrí y suspiré,",
          "Porque deseaba tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          132
        ],
        "lines": [
          "Mírame, y ten misericordia de mí,",
          "Como acostumbras con los que aman tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          133
        ],
        "lines": [
          "Ordena mis pasos con tu palabra,",
          "Y ninguna iniquidad se enseñoree de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          134
        ],
        "lines": [
          "Líbrame de la violencia de los hombres,",
          "Y guardaré tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          135
        ],
        "lines": [
          "Haz que tu rostro resplandezca sobre tu siervo,",
          "Y enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          136
        ],
        "lines": [
          "Ríos de agua descendieron de mis ojos,",
          "Porque no guardaban tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Tsade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          137
        ],
        "lines": [
          "Justo eres tú, oh Jehová,",
          "Y rectos tus juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          138
        ],
        "lines": [
          "Tus testimonios, que has recomendado,",
          "Son rectos y muy fieles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          139
        ],
        "lines": [
          "Mi celo me ha consumido,",
          "Porque mis enemigos se olvidaron de tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          140
        ],
        "lines": [
          "Sumamente pura es tu palabra,",
          "Y la ama tu siervo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          141
        ],
        "lines": [
          "Pequeño soy yo, y desechado,",
          "Mas no me he olvidado de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          142
        ],
        "lines": [
          "Tu justicia es justicia eterna,",
          "Y tu ley la verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          143
        ],
        "lines": [
          "Aflicción y angustia se han apoderado de mí,",
          "Mas tus mandamientos fueron mi delicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          144
        ],
        "lines": [
          "Justicia eterna son tus testimonios;",
          "Dame entendimiento, y viviré."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cof"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          145
        ],
        "lines": [
          "Clamé con todo mi corazón; respóndeme, Jehová,",
          "Y guardaré tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          146
        ],
        "lines": [
          "A ti clamé; sálvame,",
          "Y guardaré tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          147
        ],
        "lines": [
          "Me anticipé al alba, y clamé;",
          "Esperé en tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          148
        ],
        "lines": [
          "Se anticiparon mis ojos a las vigilias de la noche,",
          "Para meditar en tus mandatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          149
        ],
        "lines": [
          "Oye mi voz conforme a tu misericordia;",
          "Oh Jehová, vivifícame conforme a tu juicio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          150
        ],
        "lines": [
          "Se acercaron a la maldad los que me persiguen;",
          "Se alejaron de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          151
        ],
        "lines": [
          "Cercano estás tú, oh Jehová,",
          "Y todos tus mandamientos son verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          152
        ],
        "lines": [
          "Hace ya mucho que he entendido tus testimonios,",
          "Que para siempre los has establecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Resh"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          153
        ],
        "lines": [
          "Mira mi aflicción, y líbrame,",
          "Porque de tu ley no me he olvidado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          154
        ],
        "lines": [
          "Defiende mi causa, y redímeme;",
          "Vivifícame con tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          155
        ],
        "lines": [
          "Lejos está de los impíos la salvación,",
          "Porque no buscan tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          156
        ],
        "lines": [
          "Muchas son tus misericordias, oh Jehová;",
          "Vivifícame conforme a tus juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          157
        ],
        "lines": [
          "Muchos son mis perseguidores y mis enemigos,",
          "Mas de tus testimonios no me he apartado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          158
        ],
        "lines": [
          "Veía a los prevaricadores, y me disgustaba,",
          "Porque no guardaban tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          159
        ],
        "lines": [
          "Mira, oh Jehová, que amo tus mandamientos;",
          "Vivifícame conforme a tu misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          160
        ],
        "lines": [
          "La suma de tu palabra es verdad,",
          "Y eterno es todo juicio de tu justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Sin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          161
        ],
        "lines": [
          "Príncipes me han perseguido sin causa,",
          "Pero mi corazón tuvo temor de tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          162
        ],
        "lines": [
          "Me regocijo en tu palabra",
          "Como el que halla muchos despojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          163
        ],
        "lines": [
          "La mentira aborrezco y abomino;",
          "Tu ley amo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          164
        ],
        "lines": [
          "Siete veces al día te alabo",
          "A causa de tus justos juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          165
        ],
        "lines": [
          "Mucha paz tienen los que aman tu ley,",
          "Y no hay para ellos tropiezo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          166
        ],
        "lines": [
          "Tu salvación he esperado, oh Jehová,",
          "Y tus mandamientos he puesto por obra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          167
        ],
        "lines": [
          "Mi alma ha guardado tus testimonios,",
          "Y los he amado en gran manera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          168
        ],
        "lines": [
          "He guardado tus mandamientos y tus testimonios,",
          "Porque todos mis caminos están delante de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Tau"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          169
        ],
        "lines": [
          "Llegue mi clamor delante de ti, oh Jehová;",
          "Dame entendimiento conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          170
        ],
        "lines": [
          "Llegue mi oración delante de ti;",
          "Líbrame conforme a tu dicho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          171
        ],
        "lines": [
          "Mis labios rebosarán alabanza",
          "Cuando me enseñes tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          172
        ],
        "lines": [
          "Hablará mi lengua tus dichos,",
          "Porque todos tus mandamientos son justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          173
        ],
        "lines": [
          "Esté tu mano pronta para socorrerme,",
          "Porque tus mandamientos he escogido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          174
        ],
        "lines": [
          "He deseado tu salvación, oh Jehová,",
          "Y tu ley es mi delicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          175
        ],
        "lines": [
          "Viva mi alma y te alabe,",
          "Y tus juicios me ayuden."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          176
        ],
        "lines": [
          "Yo anduve errante como oveja extraviada; busca a tu siervo,",
          "Porque no me he olvidado de tus mandamientos."
        ],
