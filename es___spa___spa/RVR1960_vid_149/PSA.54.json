    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria pidiendo protección contra los enemigos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal; en Neginot. Masquil de David, cuando vinieron los zifeos y dijeron a Saúl: ¿No está David escondido en nuestra tierra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Dios, sálvame por tu nombre,",
          "Y con tu poder defiéndeme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Oh Dios, oye mi oración;",
          "Escucha las razones de mi boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque extraños se han levantado contra mí,",
          "Y hombres violentos buscan mi vida;",
          "No han puesto a Dios delante de sí."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He aquí, Dios es el que me ayuda;",
          "El Señor está con los que sostienen mi vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Él devolverá el mal a mis enemigos;",
          "Córtalos por tu verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Voluntariamente sacrificaré a ti;",
          "Alabaré tu nombre, oh Jehová, porque es bueno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque él me ha librado de toda angustia,",
          "Y mis ojos han visto la ruina de mis enemigos."
        ],
        "rlw_lines": []
      }
    ]
  },
