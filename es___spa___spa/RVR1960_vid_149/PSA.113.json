    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios levanta al pobre"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Aleluya."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Alabad, siervos de Jehová,",
          "Alabad el nombre de Jehová."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sea el nombre de Jehová bendito",
          "Desde ahora y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Desde el nacimiento del sol hasta donde se pone,",
          "Sea alabado el nombre de Jehová."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Excelso sobre todas las naciones es Jehová,",
          "Sobre los cielos su gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Quién como Jehová nuestro Dios,",
          "Que se sienta en las alturas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Que se humilla a mirar",
          "En el cielo y en la tierra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él levanta del polvo al pobre,",
          "Y al menesteroso alza del muladar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Para hacerlos sentar con los príncipes,",
          "Con los príncipes de su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Él hace habitar en familia a la estéril,",
          "Que se goza en ser madre de hijos.",
          "Aleluya."
        ],
        "rlw_lines": []
      }
    ]
  },
