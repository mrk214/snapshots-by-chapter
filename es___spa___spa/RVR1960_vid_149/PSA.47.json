    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, el Rey de toda la tierra"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Pueblos todos, batid las manos;",
          "Aclamad a Dios con voz de júbilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque Jehová el Altísimo es temible;",
          "Rey grande sobre toda la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Él someterá a los pueblos debajo de nosotros,",
          "Y a las naciones debajo de nuestros pies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Él nos elegirá nuestras heredades;",
          "La hermosura de Jacob, al cual amó."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Subió Dios con júbilo,",
          "Jehová con sonido de trompeta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cantad a Dios, cantad;",
          "Cantad a nuestro Rey, cantad;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque Dios es el Rey de toda la tierra;",
          "Cantad con inteligencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Reinó Dios sobre las naciones;",
          "Se sentó Dios sobre su santo trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los príncipes de los pueblos se reunieron",
          "Como pueblo del Dios de Abraham;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque de Dios son los escudos de la tierra;",
          "Él es muy exaltado."
        ],
        "rlw_lines": []
      }
    ]
  },
