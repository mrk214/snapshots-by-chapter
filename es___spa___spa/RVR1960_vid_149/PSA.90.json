    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "LIBRO IV"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La eternidad de Dios y la transitoriedad del hombre"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oración de Moisés, varón de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, tú nos has sido refugio",
          "De generación en generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Antes que naciesen los montes",
          "Y formases la tierra y el mundo,",
          "Desde el siglo y hasta el siglo, tú eres Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Vuelves al hombre hasta ser quebrantado,",
          "Y dices: Convertíos, hijos de los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque mil años delante de tus ojos",
          "Son como el día de ayer, que pasó,",
          "Y como una de las vigilias de la noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los arrebatas como con torrente de aguas; son como sueño,",
          "Como la hierba que crece en la mañana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "En la mañana florece y crece;",
          "A la tarde es cortada, y se seca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque con tu furor somos consumidos,",
          "Y con tu ira somos turbados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pusiste nuestras maldades delante de ti,",
          "Nuestros yerros a la luz de tu rostro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque todos nuestros días declinan a causa de tu ira;",
          "Acabamos nuestros años como un pensamiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los días de nuestra edad son setenta años;",
          "Y si en los más robustos son ochenta años,",
          "Con todo, su fortaleza es molestia y trabajo,",
          "Porque pronto pasan, y volamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Quién conoce el poder de tu ira,",
          "Y tu indignación según que debes ser temido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Enséñanos de tal modo a contar nuestros días,",
          "Que traigamos al corazón sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Vuélvete, oh Jehová; ¿hasta cuándo?",
          "Y aplácate para con tus siervos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "De mañana sácianos de tu misericordia,",
          "Y cantaremos y nos alegraremos todos nuestros días."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Alégranos conforme a los días que nos afligiste,",
          "Y los años en que vimos el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Aparezca en tus siervos tu obra,",
          "Y tu gloria sobre sus hijos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sea la luz de Jehová nuestro Dios sobre nosotros,",
          "Y la obra de nuestras manos confirma sobre nosotros;",
          "Sí, la obra de nuestras manos confirma."
        ],
        "rlw_lines": []
      }
    ]
  },
