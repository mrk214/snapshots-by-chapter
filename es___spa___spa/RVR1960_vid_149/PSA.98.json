    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza por la justicia de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantad a Jehová cántico nuevo,",
          "Porque ha hecho maravillas;",
          "Su diestra lo ha salvado, y su santo brazo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Jehová ha hecho notoria su salvación;",
          "A vista de las naciones ha descubierto su justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Se ha acordado de su misericordia y de su verdad para con la casa de Israel;",
          "Todos los términos de la tierra han visto la salvación de nuestro Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cantad alegres a Jehová, toda la tierra;",
          "Levantad la voz, y aplaudid, y cantad salmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Cantad salmos a Jehová con arpa;",
          "Con arpa y voz de cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Aclamad con trompetas y sonidos de bocina,",
          "Delante del rey Jehová."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Brame el mar y su plenitud,",
          "El mundo y los que en él habitan;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los ríos batan las manos,",
          "Los montes todos hagan regocijo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Delante de Jehová, porque vino a juzgar la tierra.",
          "Juzgará al mundo con justicia,",
          "Y a los pueblos con rectitud."
        ],
        "rlw_lines": []
      }
    ]
  },
