    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La bienaventuranza del que teme a Jehová"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bienaventurado todo aquel que teme a Jehová,",
          "Que anda en sus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cuando comieres el trabajo de tus manos,",
          "Bienaventurado serás, y te irá bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tu mujer será como vid que lleva fruto a los lados de tu casa;",
          "Tus hijos como plantas de olivo alrededor de tu mesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He aquí que así será bendecido el hombre",
          "Que teme a Jehová."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Bendígate Jehová desde Sion,",
          "Y veas el bien de Jerusalén todos los días de tu vida,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Y veas a los hijos de tus hijos.",
          "Paz sea sobre Israel."
        ],
        "rlw_lines": []
      }
    ]
  },
