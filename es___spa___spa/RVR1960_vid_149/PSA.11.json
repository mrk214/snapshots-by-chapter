    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El refugio del justo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En Jehová he confiado;",
          "¿Cómo decís a mi alma,",
          "Que escape al monte cual ave?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque he aquí, los malos tienden el arco,",
          "Disponen sus saetas sobre la cuerda,",
          "Para asaetear en oculto a los rectos de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Si fueren destruidos los fundamentos,",
          "¿Qué ha de hacer el justo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Jehová está en su santo templo;",
          "Jehová tiene en el cielo su trono;",
          "Sus ojos ven, sus párpados examinan a los hijos de los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Jehová prueba al justo;",
          "Pero al malo y al que ama la violencia, su alma los aborrece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sobre los malos hará llover calamidades;",
          "Fuego, azufre y viento abrasador será la porción del cáliz de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque Jehová es justo, y ama la justicia;",
          "El hombre recto mirará su rostro."
        ],
        "rlw_lines": []
      }
    ]
  },
