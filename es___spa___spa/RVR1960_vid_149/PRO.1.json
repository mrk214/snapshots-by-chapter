    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Motivo de los proverbios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Los proverbios de Salomón, hijo de David, rey de Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Para entender sabiduría y doctrina,",
          "Para conocer razones prudentes,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Para recibir el consejo de prudencia,",
          "Justicia, juicio y equidad;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Para dar sagacidad a los simples,",
          "Y a los jóvenes inteligencia y cordura."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Oirá el sabio, y aumentará el saber,",
          "Y el entendido adquirirá consejo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Para entender proverbio y declaración,",
          "Palabras de sabios, y sus dichos profundos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El principio de la sabiduría es el temor de Jehová;",
          "Los insensatos desprecian la sabiduría y la enseñanza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Amonestaciones de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oye, hijo mío, la instrucción de tu padre,",
          "Y no desprecies la dirección de tu madre;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque adorno de gracia serán a tu cabeza,",
          "Y collares a tu cuello."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Hijo mío, si los pecadores te quisieren engañar,",
          "No consientas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Si dijeren: Ven con nosotros;",
          "Pongamos asechanzas para derramar sangre,",
          "Acechemos sin motivo al inocente;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Los tragaremos vivos como el Seol,",
          "Y enteros, como los que caen en un abismo;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Hallaremos riquezas de toda clase,",
          "Llenaremos nuestras casas de despojos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Echa tu suerte entre nosotros;",
          "Tengamos todos una bolsa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Hijo mío, no andes en camino con ellos.",
          "Aparta tu pie de sus veredas,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque sus pies corren hacia el mal,",
          "Y van presurosos a derramar sangre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Porque en vano se tenderá la red",
          "Ante los ojos de toda ave;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero ellos a su propia sangre ponen asechanzas,",
          "Y a sus almas tienden lazo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Tales son las sendas de todo el que es dado a la codicia,",
          "La cual quita la vida de sus poseedores."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "La sabiduría clama en las calles,",
          "Alza su voz en las plazas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Clama en los principales lugares de reunión;",
          "En las entradas de las puertas de la ciudad dice sus razones."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¿Hasta cuándo, oh simples, amaréis la simpleza,",
          "Y los burladores desearán el burlar,",
          "Y los insensatos aborrecerán la ciencia?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Volveos a mi reprensión;",
          "He aquí yo derramaré mi espíritu sobre vosotros,",
          "Y os haré saber mis palabras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Por cuanto llamé, y no quisisteis oír,",
          "Extendí mi mano, y no hubo quien atendiese,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Sino que desechasteis todo consejo mío",
          "Y mi reprensión no quisisteis,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "También yo me reiré en vuestra calamidad,",
          "Y me burlaré cuando os viniere lo que teméis;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Cuando viniere como una destrucción lo que teméis,",
          "Y vuestra calamidad llegare como un torbellino;",
          "Cuando sobre vosotros viniere tribulación y angustia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Entonces me llamarán, y no responderé;",
          "Me buscarán de mañana, y no me hallarán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Por cuanto aborrecieron la sabiduría,",
          "Y no escogieron el temor de Jehová,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Ni quisieron mi consejo,",
          "Y menospreciaron toda reprensión mía,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Comerán del fruto de su camino,",
          "Y serán hastiados de sus propios consejos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Porque el desvío de los ignorantes los matará,",
          "Y la prosperidad de los necios los echará a perder;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Mas el que me oyere, habitará confiadamente",
          "Y vivirá tranquilo, sin temor del mal."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
