    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria ante el peligro de la lengua engañosa"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A Jehová clamé estando en angustia,",
          "Y él me respondió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Libra mi alma, oh Jehová, del labio mentiroso,",
          "Y de la lengua fraudulenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Qué te dará, o qué te aprovechará,",
          "Oh lengua engañosa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Agudas saetas de valiente,",
          "Con brasas de enebro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Ay de mí, que moro en Mesec,",
          "Y habito entre las tiendas de Cedar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mucho tiempo ha morado mi alma",
          "Con los que aborrecen la paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Yo soy pacífico;",
          "Mas ellos, así que hablo, me hacen guerra."
        ],
        "rlw_lines": []
      }
    ]
  },
