    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jehová es tu guardador"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Alzaré mis ojos a los montes;",
          "¿De dónde vendrá mi socorro?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi socorro viene de Jehová,",
          "Que hizo los cielos y la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No dará tu pie al resbaladero,",
          "Ni se dormirá el que te guarda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He aquí, no se adormecerá ni dormirá",
          "El que guarda a Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Jehová es tu guardador;",
          "Jehová es tu sombra a tu mano derecha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El sol no te fatigará de día,",
          "Ni la luna de noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Jehová te guardará de todo mal;",
          "Él guardará tu alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Jehová guardará tu salida y tu entrada",
          "Desde ahora y para siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
