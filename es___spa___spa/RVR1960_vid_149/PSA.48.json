    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hermosura y gloria de Sion"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Grande es Jehová, y digno de ser en gran manera alabado",
          "En la ciudad de nuestro Dios, en su monte santo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Hermosa provincia, el gozo de toda la tierra,",
          "Es el monte de Sion, a los lados del norte,",
          "La ciudad del gran Rey."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "En sus palacios Dios es conocido por refugio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque he aquí los reyes de la tierra se reunieron;",
          "Pasaron todos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Y viéndola ellos así, se maravillaron,",
          "Se turbaron, se apresuraron a huir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Les tomó allí temblor;",
          "Dolor como de mujer que da a luz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Con viento solano",
          "Quiebras tú las naves de Tarsis."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como lo oímos, así lo hemos visto",
          "En la ciudad de Jehová de los ejércitos, en la ciudad de nuestro Dios;",
          "La afirmará Dios para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Nos acordamos de tu misericordia, oh Dios,",
          "En medio de tu templo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Conforme a tu nombre, oh Dios,",
          "Así es tu loor hasta los fines de la tierra;",
          "De justicia está llena tu diestra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Se alegrará el monte de Sion;",
          "Se gozarán las hijas de Judá",
          "Por tus juicios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Andad alrededor de Sion, y rodeadla;",
          "Contad sus torres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Considerad atentamente su antemuro,",
          "Mirad sus palacios;",
          "Para que lo contéis a la generación venidera."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque este Dios es Dios nuestro eternamente y para siempre;",
          "Él nos guiará aun más allá de la muerte."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
