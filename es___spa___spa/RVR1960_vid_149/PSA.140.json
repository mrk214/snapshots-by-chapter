    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica de protección contra los perseguidores"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Líbrame, oh Jehová, del hombre malo;",
          "Guárdame de hombres violentos,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Los cuales maquinan males en el corazón,",
          "Cada día urden contiendas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Aguzaron su lengua como la serpiente;",
          "Veneno de áspid hay debajo de sus labios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Guárdame, oh Jehová, de manos del impío;",
          "Líbrame de hombres injuriosos,",
          "Que han pensado trastornar mis pasos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me han escondido lazo y cuerdas los soberbios;",
          "Han tendido red junto a la senda;",
          "Me han puesto lazos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He dicho a Jehová: Dios mío eres tú;",
          "Escucha, oh Jehová, la voz de mis ruegos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Jehová Señor, potente salvador mío,",
          "Tú pusiste a cubierto mi cabeza en el día de batalla."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No concedas, oh Jehová, al impío sus deseos;",
          "No saques adelante su pensamiento, para que no se ensoberbezca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "En cuanto a los que por todas partes me rodean,",
          "La maldad de sus propios labios cubrirá su cabeza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Caerán sobre ellos brasas;",
          "Serán echados en el fuego,",
          "En abismos profundos de donde no salgan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El hombre deslenguado no será firme en la tierra;",
          "El mal cazará al hombre injusto para derribarle."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Yo sé que Jehová tomará a su cargo la causa del afligido,",
          "Y el derecho de los necesitados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ciertamente los justos alabarán tu nombre;",
          "Los rectos morarán en tu presencia."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
