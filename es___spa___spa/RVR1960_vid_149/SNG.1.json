    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La esposa y las hijas de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantar de los cantares, el cual es de Salomón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Oh, si él me besara con besos de su boca!",
          "Porque mejores son tus amores que el vino."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A más del olor de tus suaves ungüentos,",
          "Tu nombre es como ungüento derramado;",
          "Por eso las doncellas te aman."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Atráeme; en pos de ti correremos.",
          "El rey me ha metido en sus cámaras;",
          "Nos gozaremos y alegraremos en ti;",
          "Nos acordaremos de tus amores más que del vino;",
          "Con razón te aman."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Morena soy, oh hijas de Jerusalén, pero codiciable",
          "Como las tiendas de Cedar,",
          "Como las cortinas de Salomón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No reparéis en que soy morena,",
          "Porque el sol me miró.",
          "Los hijos de mi madre se airaron contra mí;",
          "Me pusieron a guardar las viñas;",
          "Y mi viña, que era mía, no guardé."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Hazme saber, oh tú a quien ama mi alma,",
          "Dónde apacientas, dónde sesteas al mediodía;",
          "Pues ¿por qué había de estar yo como errante",
          "Junto a los rebaños de tus compañeros?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Si tú no lo sabes, oh hermosa entre las mujeres,",
          "Ve, sigue las huellas del rebaño,",
          "Y apacienta tus cabritas junto a las cabañas de los pastores."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La esposa y el esposo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A yegua de los carros de Faraón",
          "Te he comparado, amiga mía."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Hermosas son tus mejillas entre los pendientes,",
          "Tu cuello entre los collares."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Zarcillos de oro te haremos,",
          "Tachonados de plata."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mientras el rey estaba en su reclinatorio,",
          "Mi nardo dio su olor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mi amado es para mí un manojito de mirra,",
          "Que reposa entre mis pechos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Racimo de flores de alheña en las viñas de En-gadi",
          "Es para mí mi amado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "He aquí que tú eres hermosa, amiga mía;",
          "He aquí eres bella; tus ojos son como palomas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "He aquí que tú eres hermoso, amado mío, y dulce;",
          "Nuestro lecho es de flores."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Las vigas de nuestra casa son de cedro,",
          "Y de ciprés los artesonados."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
