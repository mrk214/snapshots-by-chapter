    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria pidiendo ser librado de los perseguidores"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal; sobre No destruyas. Mictam de David, cuando huyó de delante de Saúl a la cueva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ten misericordia de mí, oh Dios, ten misericordia de mí;",
          "Porque en ti ha confiado mi alma,",
          "Y en la sombra de tus alas me ampararé",
          "Hasta que pasen los quebrantos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Clamaré al Dios Altísimo,",
          "Al Dios que me favorece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Él enviará desde los cielos, y me salvará",
          "De la infamia del que me acosa;"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios enviará su misericordia y su verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi vida está entre leones;",
          "Estoy echado entre hijos de hombres que vomitan llamas;",
          "Sus dientes son lanzas y saetas,",
          "Y su lengua espada aguda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Exaltado seas sobre los cielos, oh Dios;",
          "Sobre toda la tierra sea tu gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Red han armado a mis pasos;",
          "Se ha abatido mi alma;",
          "Hoyo han cavado delante de mí;",
          "En medio de él han caído ellos mismos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pronto está mi corazón, oh Dios, mi corazón está dispuesto;",
          "Cantaré, y trovaré salmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Despierta, alma mía; despierta, salterio y arpa;",
          "Me levantaré de mañana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Te alabaré entre los pueblos, oh Señor;",
          "Cantaré de ti entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque grande es hasta los cielos tu misericordia,",
          "Y hasta las nubes tu verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Exaltado seas sobre los cielos, oh Dios;",
          "Sobre toda la tierra sea tu gloria."
        ],
        "rlw_lines": []
      }
    ]
