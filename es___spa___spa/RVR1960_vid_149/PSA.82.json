    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Amonestación contra los juicios injustos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios está en la reunión de los dioses;",
          "En medio de los dioses juzga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Hasta cuándo juzgaréis injustamente,",
          "Y aceptaréis las personas de los impíos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Defended al débil y al huérfano;",
          "Haced justicia al afligido y al menesteroso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Librad al afligido y al necesitado;",
          "Libradlo de mano de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "No saben, no entienden,",
          "Andan en tinieblas;",
          "Tiemblan todos los cimientos de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Yo dije: Vosotros sois dioses,",
          "Y todos vosotros hijos del Altísimo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pero como hombres moriréis,",
          "Y como cualquiera de los príncipes caeréis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Levántate, oh Dios, juzga la tierra;",
          "Porque tú heredarás todas las naciones."
        ],
        "rlw_lines": []
      }
    ]
  },
