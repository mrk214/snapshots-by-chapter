    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración de Jonás"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces oró Jonás a Jehová su Dios desde el vientre del pez,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "y dijo:",
          "Invoqué en mi angustia a Jehová, y él me oyó;",
          "Desde el seno del Seol clamé,",
          "Y mi voz oíste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Me echaste a lo profundo, en medio de los mares,",
          "Y me rodeó la corriente;",
          "Todas tus ondas y tus olas pasaron sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Entonces dije: Desechado soy de delante de tus ojos;",
          "Mas aún veré tu santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Las aguas me rodearon hasta el alma,",
          "Rodeome el abismo;",
          "El alga se enredó a mi cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Descendí a los cimientos de los montes;",
          "La tierra echó sus cerrojos sobre mí para siempre;",
          "Mas tú sacaste mi vida de la sepultura, oh Jehová Dios mío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuando mi alma desfallecía en mí, me acordé de Jehová,",
          "Y mi oración llegó hasta ti en tu santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los que siguen vanidades ilusorias,",
          "Su misericordia abandonan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mas yo con voz de alabanza te ofreceré sacrificios;",
          "Pagaré lo que prometí.",
          "La salvación es de Jehová."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Y mandó Jehová al pez, y vomitó a Jonás en tierra."
        ],
        "rlw_lines": []
      }
    ]
  },
