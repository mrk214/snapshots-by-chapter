    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración pidiendo misericordia en tiempo de prueba"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal; en Neginot, sobre Seminit. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Jehová, no me reprendas en tu enojo,",
          "Ni me castigues con tu ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ten misericordia de mí, oh Jehová, porque estoy enfermo;",
          "Sáname, oh Jehová, porque mis huesos se estremecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mi alma también está muy turbada;",
          "Y tú, Jehová, ¿hasta cuándo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Vuélvete, oh Jehová, libra mi alma;",
          "Sálvame por tu misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque en la muerte no hay memoria de ti;",
          "En el Seol, ¿quién te alabará?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Me he consumido a fuerza de gemir;",
          "Todas las noches inundo de llanto mi lecho,",
          "Riego mi cama con mis lágrimas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mis ojos están gastados de sufrir;",
          "Se han envejecido a causa de todos mis angustiadores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Apartaos de mí, todos los hacedores de iniquidad;",
          "Porque Jehová ha oído la voz de mi lloro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Jehová ha oído mi ruego;",
          "Ha recibido Jehová mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Se avergonzarán y se turbarán mucho todos mis enemigos;",
          "Se volverán y serán avergonzados de repente."
        ],
        "rlw_lines": []
      }
    ]
  },
