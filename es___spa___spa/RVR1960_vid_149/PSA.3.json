    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración matutina de confianza en Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David, cuando huía de delante de Absalón su hijo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Oh Jehová, cuánto se han multiplicado mis adversarios!",
          "Muchos son los que se levantan contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Muchos son los que dicen de mí:",
          "No hay para él salvación en Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mas tú, Jehová, eres escudo alrededor de mí;",
          "Mi gloria, y el que levanta mi cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Con mi voz clamé a Jehová,",
          "Y él me respondió desde su monte santo."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Yo me acosté y dormí,",
          "Y desperté, porque Jehová me sustentaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No temeré a diez millares de gente,",
          "Que pusieren sitio contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Levántate, Jehová; sálvame, Dios mío;",
          "Porque tú heriste a todos mis enemigos en la mejilla;",
          "Los dientes de los perversos quebrantaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "La salvación es de Jehová;",
          "Sobre tu pueblo sea tu bendición."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      }
    ]
  },
