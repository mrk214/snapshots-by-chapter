    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza por haber sido librado del enemigo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El rey se alegra en tu poder, oh Jehová;",
          "Y en tu salvación, ¡cómo se goza!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Le has concedido el deseo de su corazón,",
          "Y no le negaste la petición de sus labios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque le has salido al encuentro con bendiciones de bien;",
          "Corona de oro fino has puesto sobre su cabeza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Vida te demandó, y se la diste;",
          "Largura de días eternamente y para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Grande es su gloria en tu salvación;",
          "Honra y majestad has puesto sobre él."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque lo has bendecido para siempre;",
          "Lo llenaste de alegría con tu presencia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Por cuanto el rey confía en Jehová,",
          "Y en la misericordia del Altísimo, no será conmovido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Alcanzará tu mano a todos tus enemigos;",
          "Tu diestra alcanzará a los que te aborrecen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los pondrás como horno de fuego en el tiempo de tu ira;",
          "Jehová los deshará en su ira,",
          "Y fuego los consumirá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Su fruto destruirás de la tierra,",
          "Y su descendencia de entre los hijos de los hombres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque intentaron el mal contra ti;",
          "Fraguaron maquinaciones, mas no prevalecerán,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Pues tú los pondrás en fuga;",
          "En tus cuerdas dispondrás saetas contra sus rostros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Engrandécete, oh Jehová, en tu poder;",
          "Cantaremos y alabaremos tu poderío."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
