    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Yo soy la rosa de Sarón,",
          "el lirio de los valles."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL ESPOSO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¶Como el lirio entre los espinos,",
          "así es mi amada entre las doncellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶Como el manzano entre los árboles del bosque,",
          "así es mi amado entre los jóvenes.",
          "A su sombra placentera me he sentado,",
          "y su fruto es dulce a mi paladar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Él me ha traído a la sala del banquete,",
          "y su estandarte sobre mí es el amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sustentadme con tortas de pasas,",
          "reanimadme con manzanas,",
          "porque estoy enferma de amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Esté su izquierda bajo mi cabeza",
          "y su derecha me abrace."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL ESPOSO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Yo os conjuro, oh hijas de Jerusalén,",
          "por las gacelas o por las ciervas del campo,",
          "que no levantéis ni despertéis a mi amor,",
          "hasta que quiera."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶¡Una voz! ¡Mi amado!",
          "He aquí, él viene,",
          "saltando por los montes,",
          "brincando por los collados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mi amado es semejante a una gacela o a un cervatillo.",
          "He aquí, se detiene detrás de nuestro muro,",
          "mirando por las ventanas,",
          "atisbando por las celosías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Mi amado habló, y me dijo:",
          "«Levántate, amada mía, hermosa mía,",
          "y ven conmigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "-»Pues mira, ha pasado el invierno,",
          "ha cesado la lluvia y se ha ido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "-»Han aparecido las flores en la tierra;",
          "ha llegado el tiempo de la poda,",
          "y se oye la voz de la tórtola en nuestra tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "-»La higuera ha madurado sus higos,",
          "y las vides en flor han esparcido su fragancia.",
          "Levántate amada mía, hermosa mía,",
          "y ven conmigo»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL ESPOSO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¶Paloma mía, en las grietas de la peña,",
          "en lo secreto de la senda escarpada,",
          "déjame ver tu semblante,",
          "déjame oír tu voz;",
          "porque tu voz es dulce,",
          "y precioso tu semblante."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL CORO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¶Cazadnos las zorras,",
          "las zorras pequeñas que arruinan las viñas,",
          "pues nuestras viñas están en flor."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶Mi amado es mío, y yo soy suya;",
          "él apacienta su rebaño entre los lirios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Hasta que sople la brisa del día y huyan las sombras,",
          "vuelve, amado mío, y sé semejante a una gacela",
          "o a un cervatillo sobre los montes de Beter."
        ],
        "rlw_lines": []
      }
    ]
  },
