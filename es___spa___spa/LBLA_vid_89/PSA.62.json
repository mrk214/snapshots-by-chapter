    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 62"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, el único refugio"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; según Jedutún. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En Dios solamente espera en silencio mi alma;",
          "de Él viene mi salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Solo Él es mi roca y mi salvación,",
          "mi baluarte, nunca seré sacudido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶¿Hasta cuándo atacaréis a un hombre,",
          "vosotros todos, para derribarlo,",
          "como pared inclinada, como cerca que se tambalea?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Solamente consultan para derribarlo de su eminencia;",
          "en la falsedad se deleitan;",
          "bendicen con la boca,",
          "pero por dentro maldicen."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Alma mía, espera en silencio solamente en Dios,",
          "pues de Él viene mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Solo Él es mi roca y mi salvación,",
          "mi refugio, nunca seré sacudido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En Dios descansan mi salvación y mi gloria;",
          "la roca de mi fortaleza, mi refugio, está en Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Confiad en Él en todo tiempo, oh pueblo;",
          "derramad vuestro corazón delante de Él;",
          "Dios es nuestro refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Los hombres de baja condición solo son vanidad, y los de alto rango son mentira;",
          "en la balanza suben,",
          "todos juntos pesan menos que un soplo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No confiéis en la opresión,",
          "ni en el robo pongáis vuestra esperanza;",
          "si las riquezas aumentan, no pongáis el corazón en ellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Una vez ha hablado Dios;",
          "dos veces he oído esto:",
          "Que de Dios es el poder;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "y tuya es, oh Señor, la misericordia,",
          "pues tú pagas al hombre conforme a sus obras."
        ],
        "rlw_lines": []
      }
    ]
  },
