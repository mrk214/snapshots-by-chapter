    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 39"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Vanidad de la vida"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro, para Jedutún. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Yo dije: Guardaré mis caminos,",
          "para no pecar con mi lengua;",
          "guardaré mi boca como con mordaza,",
          "mientras el impío esté en mi presencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Enmudecí y callé;",
          "guardé silencio aun acerca de lo bueno,",
          "y se agravó mi dolor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ardía mi corazón dentro de mí;",
          "mientras meditaba, se encendió el fuego;",
          "entonces dije con mi lengua:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Señor, hazme saber mi fin,",
          "y cuál es la medida de mis días,",
          "para que yo sepa cuán efímero soy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "He aquí, tú has hecho mis días muy breves,",
          "y mi existencia es como nada delante de ti;",
          "ciertamente todo hombre, aun en la plenitud de su vigor, es solo un soplo."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sí, como una sombra anda el hombre;",
          "ciertamente en vano se afana;",
          "acumula riquezas, y no sabe quién las recogerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Y ahora, Señor, ¿qué espero?",
          "En ti está mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Líbrame de todas mis transgresiones;",
          "no me hagas la burla de los necios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mudo me he quedado, no abro la boca,",
          "porque tú eres el que ha obrado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quita de mí tu plaga;",
          "por la dureza de tu mano estoy pereciendo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Con castigos corriges al hombre por su iniquidad;",
          "como la polilla, consumes lo que es más precioso para él;",
          "ciertamente, todo hombre es solo un soplo."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶Escucha mi oración, oh Señor, y presta oído a mi clamor;",
          "no guardes silencio ante mis lágrimas;",
          "porque extranjero soy junto a ti,",
          "peregrino, como todos mis padres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Aparta de mí tu mirada, para poder alegrarme,",
          "antes de que me vaya de aquí, y ya no exista."
        ],
        "rlw_lines": []
      }
    ]
  },
