    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 96"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Invitación a la adoración"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantad al Señor un cántico nuevo;",
          "cantad al Señor, toda la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cantad al Señor, bendecid su nombre;",
          "proclamad de día en día las buenas nuevas de su salvación."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Contad su gloria entre las naciones,",
          "sus maravillas entre todos los pueblos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque grande es el Señor, y muy digno de ser alabado;",
          "temible es Él sobre todos los dioses."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque todos los dioses de los pueblos son ídolos,",
          "mas el Señor hizo los cielos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Gloria y majestad están delante de Él;",
          "poder y hermosura en su santuario."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Tributad al Señor, oh familias de los pueblos,",
          "tributad al Señor gloria y poder."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tributad al Señor la gloria debida a su nombre;",
          "traed ofrenda y entrad en sus atrios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Adorad al Señor en vestiduras santas;",
          "temblad ante su presencia, toda la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Decid entre las naciones: El Señor reina;",
          "ciertamente el mundo está bien afirmado, será inconmovible;",
          "Él juzgará a los pueblos con equidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Alégrense los cielos y regocíjese la tierra;",
          "ruja el mar y cuanto contiene;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "gócese el campo y todo lo que en él hay.",
          "Entonces todos los árboles del bosque cantarán con gozo"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "delante del Señor, porque Él viene;",
          "porque Él viene a juzgar la tierra:",
          "juzgará al mundo con justicia",
          "y a los pueblos con su fidelidad."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
