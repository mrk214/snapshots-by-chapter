    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 108"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza y súplica"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mi corazón está firme, oh Dios;",
          "cantaré, cantaré alabanzas, aun con mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Despertad, arpa y lira!",
          "¡A la aurora despertaré!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Te alabaré entre los pueblos, Señor;",
          "te cantaré alabanzas entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque grande, por encima de los cielos, es tu misericordia;",
          "y hasta el firmamento tu verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Exaltado seas sobre los cielos, oh Dios,",
          "sobre toda la tierra sea tu gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Para que sean librados tus amados,",
          "salva con tu diestra, y respóndeme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Dios ha hablado en su santuario:",
          "Me alegraré, repartiré a Siquem",
          "y mediré el valle de Sucot."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mío es Galaad, mío es Manasés,",
          "Efraín es el yelmo de mi cabeza,",
          "Judá es mi cetro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Moab es la vasija en que me lavo;",
          "sobre Edom arrojaré mi calzado;",
          "sobre Filistea lanzaré gritos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶¿Quién me conducirá a la ciudad fortificada?",
          "¿Quién me guiará hasta Edom?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿No eres tú, oh Dios, el que nos ha rechazado?",
          "¿No saldrás, oh Dios, con nuestros ejércitos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Danos ayuda contra el adversario,",
          "pues vano es el auxilio del hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "En Dios haremos proezas,",
          "y Él hollará a nuestros adversarios."
        ],
        "rlw_lines": []
      }
    ]
  },
