    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 33"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza al creador y preservador"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantad de júbilo en el Señor, oh justos;",
          "apropiada es para los rectos la alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Dad gracias al Señor con la lira;",
          "cantadle alabanzas con el arpa de diez cuerdas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cantadle cántico nuevo;",
          "tañed con arte, con voz de júbilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque la palabra del Señor es recta;",
          "y toda su obra es hecha con fidelidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Él ama la justicia y el derecho;",
          "llena está la tierra de la misericordia del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Por la palabra del Señor fueron hechos los cielos,",
          "y todo su ejército por el aliento de su boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él junta las aguas del mar como un montón;",
          "pone en almacenes los abismos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tema al Señor toda la tierra;",
          "tiemblen en su presencia todos los habitantes del mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque Él habló, y fue hecho;",
          "Él mandó, y todo se confirmó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El Señor hace nulo el consejo de las naciones;",
          "frustra los designios de los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El consejo del Señor permanece para siempre,",
          "los designios de su corazón de generación en generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Bienaventurada la nación cuyo Dios es el Señor,",
          "el pueblo que Él ha escogido como herencia para sí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¶El Señor mira desde los cielos;",
          "El ve a todos los hijos de los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Desde el lugar de su morada Él observa",
          "a todos los habitantes de la tierra;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Él, que modela el corazón de cada uno de ellos;",
          "El, que todas las obras de ellos entiende."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El rey no se salva por gran ejército;",
          "ni es librado el valiente por la mucha fuerza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Falsa esperanza de victoria es el caballo,",
          "ni con su mucha fuerza puede librar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¶He aquí, los ojos del Señor están sobre los que le temen,",
          "sobre los que esperan en su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "para librar su alma de la muerte,",
          "y conservarlos con vida en tiempos de hambre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Nuestra alma espera al Señor;",
          "Él es nuestra ayuda y nuestro escudo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "pues en Él se regocija nuestro corazón,",
          "porque en su santo nombre hemos confiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Sea sobre nosotros tu misericordia, oh Señor,",
          "según hemos esperado en ti."
        ],
        "rlw_lines": []
      }
    ]
  },
