    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 34"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El Señor, proveedor y salvador"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David cuando se fingió loco delante de Abimelec, quien lo echó, y él se fue."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bendeciré al Señor en todo tiempo;",
          "continuamente estará su alabanza en mi boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En el Señor se gloriará mi alma;",
          "lo oirán los humildes y se regocijarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Engrandeced al Señor conmigo,",
          "y exaltemos a una su nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Busqué al Señor, y Él me respondió,",
          "y me libró de todos mis temores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los que a Él miraron, fueron iluminados;",
          "sus rostros jamás serán avergonzados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Este pobre clamó, y el Señor le oyó,",
          "y lo salvó de todas sus angustias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El ángel del Señor acampa alrededor de los que le temen,",
          "y los rescata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Probad y ved que el Señor es bueno.",
          "¡Cuán bienaventurado es el hombre que en Él se refugia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Temed al Señor, vosotros sus santos,",
          "pues nada les falta a aquellos que le temen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los leoncillos pasan necesidad y tienen hambre,",
          "mas los que buscan al Señor no carecerán de bien alguno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Venid, hijos, escuchadme;",
          "os enseñaré el temor del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Quién es el hombre que desea vida",
          "y quiere muchos días para ver el bien?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Guarda tu lengua del mal,",
          "y tus labios de hablar engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Apártate del mal y haz el bien,",
          "busca la paz y síguela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los ojos del Señor están sobre los justos,",
          "y sus oídos atentos a su clamor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El rostro del Señor está contra los que hacen mal,",
          "para cortar de la tierra su memoria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Claman los justos, y el Señor los oye,",
          "y los libra de todas sus angustias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cercano está el Señor a los quebrantados de corazón,",
          "y salva a los abatidos de espíritu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¶Muchas son las aflicciones del justo,",
          "pero de todas ellas lo libra el Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Él guarda todos sus huesos;",
          "ni uno de ellos es quebrantado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "La maldad dará muerte al impío,",
          "y los que aborrecen al justo serán condenados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "El Señor redime el alma de sus siervos;",
          "y no será condenado ninguno de los que en Él se refugian."
        ],
        "rlw_lines": []
      }
    ]
  },
