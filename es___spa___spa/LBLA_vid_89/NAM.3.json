    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ruina total de Nínive"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Ay de la ciudad sanguinaria,",
          "toda llena de mentira y de pillaje,",
          "que nunca cesa en su rapiña!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Chasquido de látigos,",
          "ruido del crujir de ruedas,",
          "galopar de caballos,",
          "y saltar de carros;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "carga de caballería,",
          "flamear de espadas,",
          "fulgor de lanzas;",
          "multitud de heridos,",
          "montones de muertos,",
          "innumerables cadáveres;",
          "tropiezan en los cadáveres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todo por las muchas prostituciones de la ramera,",
          "la encantadora, la maestra de hechizos,",
          "que seduce a las naciones con sus prostituciones",
          "y a los pueblos con sus hechizos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Heme aquí contra ti —declara el Señor de los ejércitos.",
          "Levantaré tus faldas sobre tu rostro,",
          "y mostraré a las naciones tu desnudez",
          "y a los reinos tu vergüenza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Echaré sobre ti inmundicias,",
          "te haré despreciable, y haré de ti un espectáculo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Y sucederá que todo el que te vea",
          "huirá de ti, y dirá:",
          "«¡Asolada está Nínive!",
          "¿Quién llorará por ella?».",
          "¿Dónde te buscaré consoladores?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶¿Eres tú mejor que Tebas,",
          "la asentada junto al Nilo,",
          "rodeada de aguas,",
          "cuyo baluarte era el mar",
          "y las aguas su muralla?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Etiopía era su fortaleza,",
          "también Egipto, y no tenía límite.",
          "Fut y Libia estaban entre los que la ayudaban."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Sin embargo ella fue desterrada,",
          "llevada al cautiverio;",
          "también sus niños fueron estrellados",
          "en todas las bocacalles;",
          "sobre sus nobles echaron suertes,",
          "y todos sus principales fueron atados con cadenas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tú también quedarás embriagada,",
          "estarás escondida;",
          "tú también buscarás refugio del enemigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Todas tus fortalezas son higueras",
          "cargadas de brevas;",
          "si se sacuden, caen",
          "en la boca de quien las va a comer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "He aquí a tu pueblo: solo mujeres en medio de ti.",
          "A tus enemigos se abren de par en par",
          "las puertas de tu tierra;",
          "el fuego devora tus cerrojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Abastécete de agua para el asedio,",
          "refuerza tus fortalezas,",
          "métete en el lodo y pisa el barro,",
          "toma el molde de ladrillos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Allí te consumirá el fuego,",
          "te destruirá la espada,",
          "te devorará como el pulgón.",
          "Multiplícate como el pulgón,",
          "multiplícate como la langosta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Has multiplicado tus mercaderes",
          "más que las estrellas del cielo;",
          "el pulgón despoja y vuela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tus oficiales son como la langosta,",
          "tus jefes como nubes de langostas",
          "posados sobre las tapias",
          "en un día de frío;",
          "sale el sol, y se van,",
          "y no se sabe donde están."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Duermen tus pastores,",
          "oh rey de Asiria;",
          "tus nobles reposan.",
          "Tu pueblo está disperso por los montes",
          "y no hay quien lo reúna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "No hay remedio para tu quebranto,",
          "tu herida es incurable.",
          "Todos los que oigan noticias de ti",
          "batirán palmas sobre ti,",
          "porque ¿sobre quién no pasó",
          "continuamente tu maldad?"
        ],
        "rlw_lines": []
      }
    ]
  },
