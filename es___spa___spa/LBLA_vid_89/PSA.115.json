    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 115"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contraste entre los ídolos y el Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No a nosotros, Señor, no a nosotros,",
          "sino a tu nombre da gloria,",
          "por tu misericordia, por tu fidelidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Por qué han de decir las naciones:",
          "¿Dónde está ahora su Dios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Nuestro Dios está en los cielos;",
          "Él hace lo que le place."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Los ídolos de ellos son plata y oro,",
          "obra de manos de hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tienen boca, y no hablan;",
          "tienen ojos, y no ven;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "tienen oídos, y no oyen;",
          "tienen nariz, y no huelen;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "tienen manos, y no palpan;",
          "tienen pies, y no caminan;",
          "no emiten sonido alguno con su garganta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Se volverán como ellos, los que los hacen,",
          "y todos los que en ellos confían."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Oh Israel, confía en el Señor;",
          "Él es tu ayuda y tu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Oh casa de Aarón, confiad en el Señor;",
          "Él es vuestra ayuda y vuestro escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Los que teméis al Señor, confiad en el Señor;",
          "Él es vuestra ayuda y vuestro escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El Señor se ha acordado de nosotros; Él nos bendecirá;",
          "bendecirá a la casa de Israel;",
          "bendecirá a la casa de Aarón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "El bendecirá a los que temen al Señor,",
          "tanto a pequeños como a grandes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El Señor os prospere,",
          "a vosotros y a vuestros hijos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Benditos seáis del Señor,",
          "que hizo los cielos y la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶Los cielos son los cielos del Señor;",
          "pero la tierra la ha dado a los hijos de los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los muertos no alaban al Señor,",
          "ni ninguno de los que descienden al silencio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero nosotros bendeciremos al Señor",
          "desde ahora y para siempre.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
