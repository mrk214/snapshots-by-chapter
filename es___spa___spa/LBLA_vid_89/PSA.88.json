    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 88"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración pidiendo ser salvo de la muerte"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de los hijos de Coré. Para el director del coro; sobre Mahalat Leannot. Masquil de Hemán ezraíta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Señor, Dios de mi salvación,",
          "de día y de noche he clamado delante de ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Llegue mi oración a tu presencia;",
          "inclina tu oído a mi clamor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque saturada está mi alma de males,",
          "y mi vida se ha acercado al Seol."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Soy contado entre los que descienden a la fosa;",
          "he llegado a ser como hombre sin fuerza,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "abandonado entre los muertos;",
          "como los caídos a espada que yacen en el sepulcro,",
          "de quienes ya no te acuerdas,",
          "y que han sido arrancados de tu mano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Me has puesto en la fosa más profunda,",
          "en lugares tenebrosos, en las profundidades."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ha reposado sobre mí tu furor,",
          "y me has afligido con todas tus olas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Has alejado de mí mis amistades,",
          "me has hecho objeto de repugnancia para ellos;",
          "encerrado estoy y no puedo salir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Han languidecido mis ojos a causa de la aflicción;",
          "oh Señor, cada día te he invocado,",
          "he extendido mis manos hacia ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶¿Harás maravillas a los muertos?",
          "¿Se levantarán los muertos y te alabarán?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Se hablará de tu misericordia en el sepulcro,",
          "y de tu fidelidad en el Abadón?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Se darán a conocer tus maravillas en las tinieblas,",
          "y tu justicia en la tierra del olvido?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¶Mas yo, a ti pido auxilio, Señor,",
          "y mi oración llega ante ti por la mañana."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¿Por qué, Señor, rechazas mi alma?",
          "¿Por qué escondes de mí tu rostro?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "He estado afligido y a punto de morir desde mi juventud;",
          "sufro tus terrores, estoy abatido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Sobre mí ha pasado tu ardiente ira;",
          "tus terrores me han destruido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Me han rodeado como aguas todo el día;",
          "a una me han cercado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Has alejado de mí al compañero y al amigo;",
          "mis amistades son las tinieblas."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
