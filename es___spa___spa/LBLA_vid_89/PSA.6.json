    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 6"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración pidiendo misericordia en la prueba"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; con instrumentos de cuerda, sobre una lira de ocho cuerdas. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, no me reprendas en tu ira,",
          "ni me castigues en tu furor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ten piedad de mí, Señor, pues languidezco;",
          "sáname, Señor, porque mis huesos se estremecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mi alma también está muy angustiada;",
          "y tú, oh Señor, ¿hasta cuándo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Vuélvete, Señor, rescata mi alma;",
          "sálvame por tu misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque no hay en la muerte memoria de ti;",
          "en el Seol, ¿quién te dará gracias?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Cansado estoy de mis gemidos;",
          "todas las noches inundo de llanto mi lecho,",
          "con mis lágrimas riego mi cama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Se consumen de sufrir mis ojos;",
          "han envejecido a causa de todos mis adversarios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Apartaos de mí, todos los que hacéis iniquidad,",
          "porque el Señor ha oído la voz de mi llanto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El Señor ha escuchado mi súplica;",
          "el Señor recibe mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todos mis enemigos serán avergonzados y se turbarán en gran manera;",
          "se volverán, y de repente serán avergonzados."
        ],
        "rlw_lines": []
      }
    ]
  },
