    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 76"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El poder victorioso del Dios de Jacob"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; con instrumentos de cuerdas. Salmo de Asaf. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios es conocido en Judá;",
          "grande es su nombre en Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En Salem está su tabernáculo,",
          "y en Sión su morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Allí quebró las saetas encendidas del arco,",
          "el escudo, la espada y las armas de guerra."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Resplandeciente eres,",
          "más majestuoso que los montes de caza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Fueron despojados los fuertes de corazón;",
          "durmieron su sueño,",
          "y ninguno de los guerreros pudo usar sus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A tu reprensión, oh Dios de Jacob,",
          "auriga y caballo cayeron en profundo sueño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tú, solo tú, has de ser temido;",
          "¿y quién podrá estar en pie en tu presencia en el momento de tu ira?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Hiciste oír juicio desde los cielos;",
          "temió la tierra y enmudeció"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "al levantarse Dios para juzgar,",
          "para salvar a todos los humildes de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pues el furor del hombre te alabará;",
          "con un residuo de furor te ceñirás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Haced votos al Señor vuestro Dios, y cumplidlos;",
          "todos los que están alrededor de Él traigan presentes al que debe ser temido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Él cortará el espíritu de los príncipes;",
          "temido es por los reyes de la tierra."
        ],
        "rlw_lines": []
      }
    ]
  },
