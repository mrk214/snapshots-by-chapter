    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 136"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Gratitud por la misericordia del Señor para con Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dad gracias al Señor porque Él es bueno,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Dad gracias al Dios de dioses,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dad gracias al Señor de señores,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Al único que hace grandes maravillas,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Al que con sabiduría hizo los cielos,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Al que extendió la tierra sobre las aguas,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Al que hizo las grandes lumbreras,",
          "porque para siempre es su misericordia:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "el sol para que reine de día,",
          "porque para siempre es su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "la luna y las estrellas para que reinen de noche,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Al que hirió a Egipto en sus primogénitos,",
          "porque para siempre es su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "y sacó a Israel de en medio de ellos,",
          "porque para siempre es su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "con mano fuerte y brazo extendido,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Al que dividió en dos partes el mar Rojo,",
          "porque para siempre es su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "e hizo pasar a Israel por en medio de él,",
          "porque para siempre es su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "mas a Faraón y a su ejército destruyó en el mar Rojo,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Al que condujo a su pueblo por el desierto,",
          "porque para siempre es su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "al que hirió a grandes reyes,",
          "porque para siempre es su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "y mató a reyes poderosos,",
          "porque para siempre es su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "a Sehón, rey de los amorreos,",
          "porque para siempre es su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "y a Og, rey de Basán,",
          "porque para siempre es su misericordia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "y dio la tierra de ellos en heredad,",
          "porque para siempre es su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "en heredad a Israel su siervo,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¶El que se acordó de nosotros en nuestra humillación,",
          "porque para siempre es su misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "y nos rescató de nuestros adversarios,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "El que da sustento a toda carne,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Dad gracias al Dios del cielo,",
          "porque para siempre es su misericordia."
        ],
        "rlw_lines": []
      }
    ]
