    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Reprensión por la apostasía del pueblo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oíd esto, sacerdotes,",
          "y estad atentos, casa de Israel,",
          "y casa del rey, escuchad,",
          "porque para vosotros es el juicio;",
          "pues lazo habéis sido en Mizpa,",
          "y red tendida sobre el Tabor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Y los rebeldes se han ahondado en la perversión;",
          "pero yo los castigaré a todos ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Yo conozco a Efraín, e Israel no se me oculta;",
          "porque ahora te has prostituido, Efraín,",
          "se ha contaminado Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No les permiten sus obras",
          "volver a su Dios,",
          "porque hay un espíritu de prostitución dentro de ellos,",
          "y no conocen al Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Además, el orgullo de Israel testifica contra él,",
          "e Israel y Efraín tropiezan en su iniquidad;",
          "también Judá ha tropezado con ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Irán con sus rebaños y sus ganados",
          "en busca del Señor, pero no le encontrarán;",
          "se ha retirado de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Han obrado perversamente contra el Señor,",
          "porque han engendrado hijos ilegítimos.",
          "Ahora los devorará la luna nueva junto con sus heredades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Tocad la bocina en Guibeá,",
          "la trompeta en Ramá.",
          "Sonad alarma en Bet-avén:",
          "¡Alerta, Benjamín!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Efraín será una desolación en el día de la reprensión;",
          "en las tribus de Israel yo hago saber lo que es cierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los príncipes de Judá son como los que mueven los linderos;",
          "sobre ellos derramaré como agua mi furor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Efraín está oprimido, quebrantado en juicio,",
          "porque insistía en seguir mandato de hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Yo, pues, soy como polilla para Efraín,",
          "y como carcoma para la casa de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Cuando Efraín vio su enfermedad",
          "y Judá su herida,",
          "Efraín fue a Asiria",
          "y envió mensaje al rey Jareb;",
          "pero él no os podrá sanar,",
          "ni curar vuestra herida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque yo seré como león para Efraín,",
          "y como leoncillo para la casa de Judá.",
          "Yo, yo mismo, desgarraré y me iré,",
          "arrebataré y no habrá quien libre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Me iré y volveré a mi lugar",
          "hasta que reconozcan su culpa y busquen mi rostro;",
          "en su angustia me buscarán con diligencia."
        ],
        "rlw_lines": []
      }
    ]
  },
