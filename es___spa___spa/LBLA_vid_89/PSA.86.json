    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 86"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Salmo de súplica y confianza"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oración de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Inclina, oh Señor, tu oído y respóndeme,",
          "porque estoy afligido y necesitado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Guarda mi alma, pues soy piadoso;",
          "tú eres mi Dios; salva a tu siervo que en ti confía."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ten piedad de mí, oh Señor,",
          "porque a ti clamo todo el día."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alegra el alma de tu siervo,",
          "porque a ti, oh Señor, elevo mi alma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pues tú, Señor, eres bueno y perdonador,",
          "abundante en misericordia para con todos los que te invocan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Escucha, oh Señor, mi oración,",
          "y atiende a la voz de mis súplicas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En el día de la angustia te invocaré,",
          "porque tú me responderás."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No hay nadie como tú entre los dioses, oh Señor,",
          "ni hay obras como las tuyas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Todas las naciones que tú has hecho vendrán y adorarán delante de ti, Señor,",
          "y glorificarán tu nombre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque tú eres grande y haces maravillas;",
          "solo tú eres Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Enséñame, oh Señor, tu camino;",
          "andaré en tu verdad;",
          "unifica mi corazón para que tema tu nombre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Te daré gracias, Señor mi Dios, con todo mi corazón,",
          "y glorificaré tu nombre para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Porque grande es tu misericordia para conmigo,",
          "y has librado mi alma de las profundidades del Seol."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¶Oh Dios, los arrogantes se han levantado contra mí,",
          "y una banda de violentos ha buscado mi vida,",
          "y no te han tenido en cuenta."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mas tú, Señor, eres un Dios compasivo y lleno de piedad,",
          "lento para la ira y abundante en misericordia y fidelidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Vuélvete hacia mí, y tenme piedad;",
          "da tu poder a tu siervo,",
          "y salva al hijo de tu sierva."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Muéstrame una señal de bondad,",
          "para que la vean los que me aborrecen y se avergüencen,",
          "porque tú, oh Señor, me has ayudado y consolado."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
