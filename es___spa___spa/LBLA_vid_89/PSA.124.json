      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Canto de liberación"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico de ascenso gradual; de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Si el Señor no hubiera estado a nuestro favor,",
          "—diga ahora Israel—"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "si el Señor no hubiera estado a nuestro favor",
          "cuando los hombres se levantaron contra nosotros,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "vivos nos hubieran tragado entonces",
          "cuando su ira se encendió contra nosotros;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "entonces las aguas nos hubieran anegado,",
          "un torrente hubiera pasado sobre nuestra alma,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "hubieran pasado entonces sobre nuestra alma las aguas impetuosas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Bendito sea el Señor,",
          "que no nos ha entregado como presa de los dientes de ellos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nuestra alma ha escapado cual ave del lazo de los cazadores;",
          "el lazo se rompió y nosotros escapamos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Nuestro socorro está en el nombre del Señor,",
          "que hizo los cielos y la tierra."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
