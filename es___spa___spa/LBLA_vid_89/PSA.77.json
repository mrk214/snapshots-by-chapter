    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 77"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Las maravillas de Dios en el pasado consuelan en el presente"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; según Jedutún."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mi voz se eleva a Dios, y a Él clamaré;",
          "mi voz se eleva a Dios, y Él me oirá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En el día de mi angustia busqué al Señor;",
          "en la noche mi mano se extendía sin cansarse;",
          "mi alma rehusaba ser consolada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Me acuerdo de Dios, y me siento turbado;",
          "me lamento, y mi espíritu desmaya."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Has mantenido abiertos mis párpados;",
          "estoy tan turbado que no puedo hablar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "He pensado en los días pasados,",
          "en los años antiguos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "De noche me acordaré de mi canción;",
          "en mi corazón meditaré;",
          "y mi espíritu inquiere."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶¿Rechazará el Señor para siempre,",
          "y no mostrará más su favor?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¿Ha cesado para siempre su misericordia?",
          "¿Ha terminado para siempre su promesa?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Ha olvidado Dios tener piedad,",
          "o ha retirado con su ira su compasión?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Entonces dije: Este es mi dolor:",
          "que la diestra del Altísimo ha cambiado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Me acordaré de las obras del Señor;",
          "ciertamente me acordaré de tus maravillas antiguas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Meditaré en toda tu obra,",
          "y reflexionaré en tus hechos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Santo es, oh Dios, tu camino;",
          "¿qué dios hay grande como nuestro Dios?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tú eres el Dios que hace maravillas,",
          "has hecho conocer tu poder entre los pueblos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Con tu brazo has redimido a tu pueblo,",
          "a los hijos de Jacob y de José."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶Las aguas te vieron, oh Dios,",
          "te vieron las aguas y temieron,",
          "los abismos también se estremecieron."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Derramaron aguas las nubes,",
          "tronaron los nubarrones,",
          "también tus saetas centellearon por doquier."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "La voz de tu trueno estaba en el torbellino,",
          "los relámpagos iluminaron al mundo,",
          "la tierra se estremeció y tembló."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "En el mar estaba tu camino,",
          "y tus sendas en las aguas inmensas,",
          "y no se conocieron tus huellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Como rebaño guiaste a tu pueblo",
          "por mano de Moisés y de Aarón."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
