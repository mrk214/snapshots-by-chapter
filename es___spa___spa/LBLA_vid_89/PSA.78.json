    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 78"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Fidelidad de Dios hacia su pueblo infiel"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Masquil de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Escucha, pueblo mío, mi enseñanza;",
          "inclinad vuestro oído a las palabras de mi boca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En parábolas abriré mi boca;",
          "hablaré enigmas de la antigüedad,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "que hemos oído y conocido,",
          "y que nuestros padres nos han contado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No lo ocultaremos a sus hijos,",
          "sino que contaremos a la generación venidera las alabanzas del Señor,",
          "su poder y las maravillas que hizo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Porque Él estableció un testimonio en Jacob,",
          "y puso una ley en Israel,",
          "la cual ordenó a nuestros padres",
          "que enseñaran a sus hijos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "para que la generación venidera lo supiera, aun los hijos que habían de nacer;",
          "y estos se levantaran y lo contaran a sus hijos,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para que ellos pusieran su confianza en Dios,",
          "y no se olvidaran de las obras de Dios,",
          "sino que guardaran sus mandamientos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "y no fueran como sus padres,",
          "una generación porfiada y rebelde,",
          "generación que no preparó su corazón,",
          "y cuyo espíritu no fue fiel a Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Los hijos de Efraín eran arqueros bien equipados,",
          "pero volvieron las espaldas el día de la batalla."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No guardaron el pacto de Dios,",
          "y rehusaron andar en su ley;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "olvidaron sus obras,",
          "y los milagros que les había mostrado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Él hizo maravillas en presencia de sus padres,",
          "en la tierra de Egipto, en el campo de Zoán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Dividió el mar y los hizo pasar,",
          "y contuvo las aguas como en un montón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Después los guió de día con la nube,",
          "y toda la noche con un resplandor de fuego."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Partió las rocas en el desierto,",
          "y les dio agua tan abundante como las profundidades del océano;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "hizo salir corrientes de la peña,",
          "e hizo descender aguas como ríos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¶Pero aún siguieron pecando contra Él,",
          "rebelándose contra el Altísimo en el desierto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Y en sus corazones tentaron a Dios,",
          "pidiendo comida a su gusto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Hablaron contra Dios,",
          "y dijeron: ¿Podrá Dios preparar mesa en el desierto?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "He aquí, hirió la roca y brotaron aguas,",
          "y torrentes se desbordaron;",
          "¿podrá también dar pan?,",
          "¿proveerá carne para su pueblo?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¶Por tanto, al oírlo, el Señor se indignó;",
          "un fuego se encendió contra Jacob,",
          "y aumentó también la ira contra Israel,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "porque no creyeron en Dios,",
          "ni confiaron en su salvación."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Sin embargo, dio órdenes a las nubes arriba,",
          "y abrió las puertas de los cielos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "hizo llover sobre ellos maná para comer,",
          "y les dio comida del cielo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Pan de ángeles comió el hombre;",
          "Dios les mandó comida hasta saciarlos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Hizo soplar en el cielo el viento solano,",
          "y con su poder dirigió el viento del sur,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Él hizo llover sobre ellos carne como polvo,",
          "aladas aves como la arena de los mares,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "y las hizo caer en medio del campamento,",
          "alrededor de sus viviendas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Comieron y quedaron bien saciados,",
          "y les concedió su deseo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Antes de que hubieran satisfecho su deseo,",
          "mientras la comida aún estaba en su boca,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "la ira de Dios se alzó contra ellos",
          "y mató a algunos de los más robustos,",
          "y subyugó a los escogidos de Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "A pesar de todo esto, todavía pecaron",
          "y no creyeron en sus maravillas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Él, pues, hizo terminar sus días en vanidad,",
          "y sus años en terror súbito."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "¶Cuando los hería de muerte, entonces le buscaban,",
          "y se volvían y buscaban con diligencia a Dios;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "se acordaban de que Dios era su roca,",
          "y el Dios Altísimo su Redentor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Mas con su boca le engañaban,",
          "y con su lengua le mentían."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Pues su corazón no era leal para con Él,",
          "ni eran fieles a su pacto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Mas Él, siendo compasivo, perdonaba sus iniquidades y no los destruía;",
          "muchas veces contuvo su ira,",
          "y no despertó todo su furor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Se acordaba de que ellos eran carne,",
          "un soplo que pasa y no vuelve."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "¶¡Cuántas veces se rebelaron contra Él en el desierto,",
          "y le entristecieron en las soledades!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Tentaron a Dios una y otra vez,",
          "y afligieron al Santo de Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "No se acordaron de su poder,",
          "del día en que los redimió del adversario,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "cuando hizo sus señales en Egipto,",
          "y sus prodigios en el campo de Zoán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Convirtió en sangre sus ríos",
          "y sus corrientes, y no pudieron beber."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Envió entre ellos enjambres de moscas que los devoraban,",
          "y ranas que los destruían."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Entregó también sus cosechas al saltamontes,",
          "y el fruto de su trabajo a la langosta."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Con granizo destruyó sus vides,",
          "y sus sicómoros con escarcha."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Entregó también al granizo sus ganados,",
          "y sus rebaños a los rayos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Envió sobre ellos el ardor de su ira,",
          "furia, indignación y angustia,",
          "un ejército de ángeles destructores."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Preparó senda para su ira;",
          "no eximió sus almas de la muerte,",
          "sino que entregó sus vidas a la plaga,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "e hirió a todos los primogénitos en Egipto,",
          "las primicias de su virilidad en las tiendas de Cam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Mas a su pueblo lo sacó como a ovejas,",
          "como a rebaño los condujo en el desierto;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "los guió con seguridad, de modo que no temieron,",
          "pero el mar se tragó a sus enemigos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "¶Los trajo, pues, a su tierra santa,",
          "a esta tierra montañosa que su diestra había adquirido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Y expulsó a las naciones de delante de ellos;",
          "las repartió con medida por herencia,",
          "e hizo habitar en sus tiendas a las tribus de Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Empero ellos tentaron y provocaron al Dios Altísimo,",
          "y no guardaron sus testimonios,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "sino que se volvieron atrás y fueron desleales como sus padres;",
          "se desviaron como arco engañoso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Pues le provocaron con sus lugares altos,",
          "y despertaron sus celos con sus imágenes talladas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Al oírlo Dios, se indignó,",
          "y aborreció a Israel en gran manera."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Abandonó la morada en Silo,",
          "la tienda que había levantado entre los hombres,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "y entregó al cautiverio su poderío,",
          "y su gloria en manos del adversario."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "Entregó también su pueblo a la espada,",
          "y se indignó contra su heredad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "El fuego consumió a sus jóvenes,",
          "y no tuvieron canciones de bodas sus doncellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Sus sacerdotes cayeron a espada,",
          "y sus viudas no pudieron llorar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "¶Entonces despertó el Señor como de un sueño,",
          "como guerrero vencido por el vino,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "e hizo retroceder a sus adversarios,",
          "poniendo sobre ellos una afrenta perpetua."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Desechó también la tienda de José,",
          "y no escogió a la tribu de Efraín,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "sino que escogió a la tribu de Judá,",
          "al monte Sión que Él amaba."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "Y edificó su santuario como las alturas,",
          "como la tierra que ha fundado para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "Escogió también a David su siervo,",
          "lo tomó de entre los apriscos de las ovejas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "lo trajo de cuidar las ovejas con sus corderitos,",
          "para pastorear a Jacob, su pueblo,",
          "y a Israel, su heredad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "Y él los pastoreó según la integridad de su corazón,",
          "y los guió con la destreza de sus manos."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
