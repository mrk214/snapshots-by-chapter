    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 48"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hermosura y gloria de Sión"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Grande es el Señor, y muy digno de ser alabado",
          "en la ciudad de nuestro Dios, su santo monte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Hermoso en su elevación, el gozo de toda la tierra",
          "es el monte Sión, en el extremo norte,",
          "la ciudad del gran Rey."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios en sus palacios",
          "se dio a conocer como baluarte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Pues, he aquí, los reyes se reunieron;",
          "pasaron juntos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ellos la vieron y quedaron pasmados;",
          "se aterrorizaron y huyeron alarmados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Allí se apoderó de ellos un temblor;",
          "dolor como el de mujer que está de parto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Con el viento solano",
          "tú destrozas las naves de Tarsis."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como lo hemos oído, así lo hemos visto",
          "en la ciudad del Señor de los ejércitos, en la ciudad de nuestro Dios;",
          "Dios la afirmará para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶En tu misericordia, oh Dios, hemos meditado,",
          "en medio de tu templo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Oh Dios, como es tu nombre,",
          "así es tu alabanza hasta los confines de la tierra;",
          "llena de justicia está tu diestra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Alégrese el monte Sión,",
          "regocíjense las hijas de Judá,",
          "a causa de tus juicios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Andad por Sión e id alrededor de ella;",
          "contad sus torres;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "considerad atentamente sus murallas,",
          "recorred sus palacios,",
          "para que lo contéis a la generación venidera."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque este es Dios,",
          "nuestro Dios por siempre jamás;",
          "Él nos guiará hasta la muerte."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
