    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La sabiduría y la insensatez"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La sabiduría ha edificado su casa,",
          "ha labrado sus siete columnas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "ha preparado su alimento, ha mezclado su vino,",
          "ha puesto también su mesa;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "ha enviado a sus doncellas, y clama",
          "desde los lugares más altos de la ciudad:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Él que sea simple que entre aquí.",
          "Al falto de entendimiento le dice:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Venid, comed de mi pan,",
          "y bebed del vino que he mezclado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Abandonad la necedad y viviréis,",
          "y andad por el camino del entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Él que corrige al escarnecedor, atrae sobre sí deshonra,",
          "y el que reprende al impío recibe insultos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No reprendas al escarnecedor, para que no te aborrezca;",
          "reprende al sabio, y te amará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Da instrucción al sabio, y será aún más sabio,",
          "enseña al justo, y aumentará su saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El principio de la sabiduría es el temor del Señor,",
          "y el conocimiento del Santo es inteligencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pues por mí se multiplicarán tus días,",
          "y años de vida te serán añadidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si eres sabio, eres sabio para provecho tuyo,",
          "y si escarneces, tú solo lo sufrirás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¶La mujer insensata es alborotadora,",
          "es simple y no sabe nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Y se sienta a la puerta de su casa,",
          "en un asiento, en los lugares altos de la ciudad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "llamando a los que pasan,",
          "a los que van derechos por sus sendas:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Él que sea simple, que entre aquí.",
          "Y al falto de entendimiento, le dice:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Dulces son las aguas hurtadas,",
          "y el pan comido en secreto es sabroso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero él no sabe que allí están los muertos,",
          "que sus invitados están en las profundidades del Seol."
        ],
        "rlw_lines": []
      }
    ]
  },
