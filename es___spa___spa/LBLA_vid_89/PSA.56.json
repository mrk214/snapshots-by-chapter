    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 56"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración de confianza y gratitud"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; según la tonada de La paloma silenciosa de los que están lejos. Mictam de David cuando los filisteos lo prendieron en Gat."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ten piedad de mí, oh Dios, porque el hombre me ha pisoteado;",
          "me oprime combatiéndome todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mis enemigos me han pisoteado todo el día,",
          "porque muchos son los que con soberbia pelean contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El día en que temo,",
          "yo en ti confío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En Dios, cuya palabra alabo,",
          "en Dios he confiado, no temeré.",
          "¿Qué puede hacerme el hombre?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Todo el día pervierten mis palabras;",
          "todos sus pensamientos contra mí son para mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Atacan, se esconden,",
          "espían mis pasos,",
          "como esperando para quitarme la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Por causa de la iniquidad, arrójalos,",
          "en tu ira humilla a los pueblos, oh Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Tú has tomado en cuenta mi vida errante;",
          "pon mis lágrimas en tu redoma;",
          "¿acaso no están en tu libro?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Entonces mis enemigos retrocederán el día en que yo te invoque.",
          "Esto sé: que Dios está a favor mío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "En Dios, cuya palabra alabo,",
          "en el Señor, cuya palabra honro;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "en Dios he confiado, no temeré.",
          "¿Qué puede hacerme el hombre?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Están sobre mí, oh Dios, los votos que te hice;",
          "ofrendas de acción de gracias te ofreceré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pues tú has librado mi alma de la muerte,",
          "y mis pies de tropiezo,",
          "para que yo pueda andar delante de Dios",
          "en la luz de la vida."
        ],
        "rlw_lines": []
      }
    ]
  },
