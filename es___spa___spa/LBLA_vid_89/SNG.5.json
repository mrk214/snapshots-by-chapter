    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL ESPOSO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "He entrado en mi huerto, hermana mía, esposa mía;",
          "he recogido mi mirra con mi bálsamo.",
          "He comido mi panal y mi miel;",
          "he bebido mi vino y mi leche.",
          "Comed, amigos;",
          "bebed y embriagaos, oh amados."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El tormento de la separación"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¶Yo dormía, pero mi corazón velaba,",
          "¡Una voz! ¡Mi amado toca a la puerta!",
          "«Abreme, hermana mía, amada mía,",
          "paloma mía, perfecta mía,",
          "pues mi cabeza está empapada de rocío,",
          "mis cabellos empapados de la humedad de la noche»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Me he quitado la ropa,",
          "¿cómo he de vestirme de nuevo?",
          "He lavado mis pies,",
          "¿cómo los volveré a ensuciar?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi amado metió su mano por la abertura de la puerta,",
          "y se estremecieron por él mis entrañas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Yo me levanté para abrir a mi amado;",
          "y mis manos destilaron mirra,",
          "y mis dedos mirra líquida,",
          "sobre los pestillos de la cerradura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Abrí yo a mi amado,",
          "pero mi amado se había retirado, se había ido.",
          "Tras su hablar salió mi alma.",
          "Lo busqué, y no lo hallé;",
          "lo llamé, y no me respondió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Me hallaron los guardas que rondan la ciudad,",
          "me golpearon y me hirieron;",
          "me quitaron de encima mi chal los guardas de las murallas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Yo os conjuro, oh hijas de Jerusalén,",
          "si encontráis a mi amado,",
          "¿qué le habéis de decir?",
          "Que estoy enferma de amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL CORO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶¿Qué clase de amado es tu amado,",
          "oh la más hermosa de las mujeres?",
          "¿Qué clase de amado es tu amado,",
          "que así nos conjuras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Mi amado es resplandeciente y sonrosado,",
          "distinguido entre diez mil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Su cabeza es como oro, oro puro,",
          "sus cabellos, como racimos de dátiles,",
          "negros como el cuervo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sus ojos son como palomas",
          "junto a corrientes de agua,",
          "bañados en leche,",
          "colocados en su engaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sus mejillas, como eras de bálsamo,",
          "como riberas de hierbas aromáticas;",
          "sus labios son lirios",
          "que destilan mirra líquida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sus manos, barras de oro",
          "engastadas de berilo;",
          "su vientre, marfil tallado",
          "recubierto de zafiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Sus piernas, columnas de alabastro",
          "asentadas sobre basas de oro puro;",
          "su aspecto, como el Líbano,",
          "gallardo como los cedros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Su paladar, dulcísimo,",
          "y todo él, deseable.",
          "Este es mi amado y este es mi amigo,",
          "hijas de Jerusalén."
        ],
        "rlw_lines": []
      }
    ]
  },
