      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Salmo de alabanza"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "Alabad a Dios en su santuario;",
          "alabadle en su majestuoso firmamento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alabadle por sus hechos poderosos;",
          "alabadle según la excelencia de su grandeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶Alabadle con sonido de trompeta;",
          "alabadle con arpa y lira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alabadle con pandero y danza;",
          "alabadle con instrumentos de cuerda y flauta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Alabadle con címbalos sonoros;",
          "alabadle con címbalos resonantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Todo lo que respira alabe al Señor.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
