        "lines": [
          "Salmo 130"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Clamor de un pecador"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Desde lo más profundo, oh Señor, he clamado a ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Señor, oye mi voz!",
          "Estén atentos tus oídos",
          "a la voz de mis súplicas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Señor, si tú tuvieras en cuenta las iniquidades,",
          "¿quién, oh Señor, podría permanecer?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero en ti hay perdón,",
          "para que seas temido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Espero en el Señor; en Él espera mi alma,",
          "y en su palabra tengo mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mi alma espera al Señor",
          "más que los centinelas a la mañana;",
          "sí, más que los centinelas a la mañana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Oh Israel, espera en el Señor,",
          "porque en el Señor hay misericordia,",
          "y en Él hay abundante redención;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Él redimirá a Israel",
          "de todas sus iniquidades."
        ],
        "rlw_lines": []
      }
    ]
  },
