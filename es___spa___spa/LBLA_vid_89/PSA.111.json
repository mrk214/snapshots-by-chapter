    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 111"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Las obras redentoras del Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "Daré gracias al Señor con todo mi corazón,",
          "en la compañía de los rectos y en la congregación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Grandes son las obras del Señor,",
          "buscadas por todos los que se deleitan en ellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Esplendor y majestad es su obra,",
          "y su justicia permanece para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ha hecho sus maravillas para ser recordadas;",
          "clemente y compasivo es el Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ha dado alimento a los que le temen;",
          "recordará su pacto para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ha hecho conocer a su pueblo el poder de sus obras,",
          "al darle la heredad de las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Las obras de sus manos son verdad y justicia,",
          "fieles todos sus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Son afirmados para siempre jamás,",
          "ejecutados con verdad y rectitud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Él ha enviado redención a su pueblo,",
          "ha ordenado su pacto para siempre;",
          "santo y temible es su nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El principio de la sabiduría es el temor del Señor;",
          "buen entendimiento tienen todos los que practican sus mandamientos;",
          "su alabanza permanece para siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
