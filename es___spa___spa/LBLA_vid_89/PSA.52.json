    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 52"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lo vano de la maldad jactanciosa"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro. Masquil de David, cuando fue Doeg el edomita e informó a Saúl, diciéndole: David está en casa de Ahimelec."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿Por qué te jactas del mal, oh poderoso?",
          "La misericordia de Dios es continua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tu lengua maquina destrucción",
          "como afilada navaja, oh artífice de engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Amas el mal más que el bien,",
          "la mentira más que decir lo que es justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Amas toda palabra destructora,",
          "oh lengua de engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Pero Dios te destruirá para siempre;",
          "te arrebatará y te arrancará de tu tienda,",
          "y te desarraigará de la tierra de los vivientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los justos verán esto y temerán,",
          "y se reirán de él, diciendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "He aquí el hombre que no quiso hacer de Dios su refugio,",
          "sino que confió en la abundancia de sus riquezas",
          "y se hizo fuerte en sus malos deseos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Pero yo soy como olivo verde en la casa de Dios;",
          "en la misericordia de Dios confío eternamente y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Te alabaré para siempre por lo que has hecho,",
          "y esperaré en tu nombre, porque es bueno delante de tus santos."
        ],
        "rlw_lines": []
      }
    ]
  },
