    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 57"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración pidiendo ser librado de los perseguidores"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; según tonada de No destruyas. Mictam de David, en la cueva, cuando huía de Saúl."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ten piedad de mí, oh Dios, ten piedad de mí,",
          "porque en ti se refugia mi alma;",
          "en la sombra de tus alas me ampararé",
          "hasta que la destrucción pase."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Clamaré al Dios Altísimo,",
          "al Dios que todo lo hace para mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Él enviará desde los cielos y me salvará;",
          "Él reprocha al que me pisotea."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios enviará su misericordia y su verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Mi alma está entre leones;",
          "tengo que acostarme entre los que vomitan fuego;",
          "entre los hijos de los hombres, cuyos dientes son lanzas y saetas,",
          "y cuya lengua es espada afilada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Exaltado seas sobre los cielos, oh Dios;",
          "sobre toda la tierra sea tu gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Han tendido una red para mis pasos;",
          "mi alma está abatida;",
          "han cavado una fosa delante de mí,",
          "pero ellos mismos han caído en medio de ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Firme está mi corazón, oh Dios, mi corazón está firme;",
          "¡cantaré y entonaré salmos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Despierta, gloria mía!",
          "¡Despertad, arpa y lira!",
          "¡A la aurora despertaré!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Te alabaré entre los pueblos, Señor;",
          "te cantaré alabanzas entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque grande, hasta los cielos, es tu misericordia,",
          "y hasta el firmamento tu verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Exaltado seas sobre los cielos, oh Dios;",
          "sobre toda la tierra sea tu gloria."
        ],
        "rlw_lines": []
      }
    ]
