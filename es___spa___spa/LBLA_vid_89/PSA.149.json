    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 149"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabe Israel al Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "Cantad al Señor un cántico nuevo:",
          "su alabanza en la congregación de los santos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alégrese Israel en su Creador;",
          "regocíjense los hijos de Sión en su Rey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Alaben su nombre con danza;",
          "cántenle alabanza con pandero y lira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque el Señor se deleita en su pueblo;",
          "adornará de salvación a los afligidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Regocíjense de gloria los santos;",
          "canten con gozo sobre sus camas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sean los loores de Dios en su boca,",
          "y una espada de dos filos en su mano,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para ejecutar venganza en las naciones,",
          "y castigo en los pueblos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "para atar a sus reyes con cadenas,",
          "y a sus nobles con grillos de hierro;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para ejecutar en ellos el juicio decretado:",
          "esto es gloria para todos sus santos.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
