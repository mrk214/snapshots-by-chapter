        "lines": [
          "Salmo 82"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, juez supremo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios ocupa su lugar en su congregación;",
          "Él juzga en medio de los jueces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Hasta cuándo juzgaréis injustamente",
          "y favoreceréis a los impíos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Defended al débil y al huérfano;",
          "haced justicia al afligido y al menesteroso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Rescatad al débil y al necesitado;",
          "libradlos de la mano de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶No saben ni entienden;",
          "caminan en tinieblas;",
          "son sacudidos todos los cimientos de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Yo dije: Vosotros sois dioses,",
          "y todos sois hijos del Altísimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sin embargo, como hombres moriréis,",
          "y caeréis como uno de los príncipes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Levántate, oh Dios, juzga la tierra!",
          "Porque tú posees todas las naciones."
        ],
        "rlw_lines": []
      }
    ]
  },
