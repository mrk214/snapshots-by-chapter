  "book": {
    "book_usfm": "JOB",
    "name": "Job"
  },
  "chapter": {
    "chapter_usfm": "JOB.41",
    "current": {
      "usfm": "JOB.41",
      "human": "Job 41"
    },
    "previous": {
      "usfm": "JOB.40",
