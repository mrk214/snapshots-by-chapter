      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bienaventuranza del que teme a Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bienaventurado todo aquel que teme al Señor,",
          "que anda en sus caminos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cuando comas del trabajo de tus manos,",
          "dichoso serás y te irá bien."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tu mujer será como fecunda vid",
          "en el interior de tu casa;",
          "tus hijos como plantas de olivo",
          "alrededor de tu mesa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He aquí que así será bendecido el hombre",
          "que teme al Señor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶El Señor te bendiga desde Sión,",
          "veas la prosperidad de Jerusalén todos los días de tu vida,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "y veas a los hijos de tus hijos.",
          "¡Paz sea sobre Israel!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
