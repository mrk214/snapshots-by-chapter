    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El justo y el impío"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Los proverbios de Salomón.",
          "El hijo sabio alegra al padre,",
          "pero el hijo necio es tristeza para su madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tesoros mal adquiridos no aprovechan,",
          "mas la justicia libra de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El Señor no permitirá que el justo padezca hambre,",
          "pero rechazará la avidez de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pobre es el que trabaja con mano negligente,",
          "mas la mano de los diligentes enriquece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Él que recoge en el verano es hijo sabio,",
          "el que duerme durante la siega es hijo que avergüenza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Hay bendiciones sobre la cabeza del justo,",
          "pero la boca de los impíos oculta violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "La memoria del justo es bendita,",
          "pero el nombre del impío se pudrirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El sabio de corazón aceptará mandatos,",
          "mas el necio charlatán será derribado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Él que anda en integridad anda seguro,",
          "mas el que pervierte sus caminos será descubierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Él que guiña el ojo causa disgustos,",
          "y el necio charlatán será derribado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Fuente de vida es la boca del justo,",
          "pero la boca de los impíos encubre violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El odio suscita rencillas,",
          "pero el amor cubre todas las transgresiones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "En los labios del entendido se halla sabiduría,",
          "pero la vara es para las espaldas del falto de entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los sabios atesoran conocimiento,",
          "pero la boca del necio es ruina cercana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "La fortuna del rico es su fortaleza,",
          "la ruina de los pobres es su pobreza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El salario del justo es vida,",
          "la ganancia del impío, castigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Por senda de vida va el que guarda la instrucción,",
          "mas el que abandona la reprensión se extravía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Él que oculta el odio tiene labios mentirosos,",
          "y el que esparce calumnia es un necio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "En las muchas palabras, la transgresión es inevitable,",
          "mas el que refrena sus labios es prudente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "La lengua del justo es plata escogida,",
          "pero el corazón de los impíos es poca cosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Los labios del justo apacientan a muchos,",
          "pero los necios mueren por falta de entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La bendición del Señor es la que enriquece,",
          "y Él no añade tristeza con ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Como diversión es para el necio el hacer maldad,",
          "y la sabiduría lo es para el hombre de entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Lo que el impío teme vendrá sobre él,",
          "y el deseo de los justos será concedido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Cuando pasa el torbellino, ya no existe el impío,",
          "pero el justo tiene cimiento eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Como el vinagre a los dientes y el humo a los ojos,",
          "así es el perezoso para quienes lo envían."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El temor del Señor multiplica los días,",
          "mas los años de los impíos serán acortados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "La esperanza de los justos es alegría,",
          "pero la expectación de los impíos perecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Fortaleza para el íntegro es el camino del Señor,",
          "pero ruina para los que obran iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "El justo nunca será conmovido,",
          "mas los impíos no habitarán en la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "La boca del justo emite sabiduría,",
          "pero la lengua perversa será cortada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Los labios del justo dan a conocer lo agradable,",
          "pero la boca de los impíos, lo perverso."
        ],
        "rlw_lines": []
      }
    ]
  },
