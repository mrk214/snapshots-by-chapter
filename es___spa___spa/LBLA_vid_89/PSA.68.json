    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 68"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El Dios del Sinaí y del santuario"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro. Salmo de David. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Levántese Dios; sean esparcidos sus enemigos,",
          "y huyan delante de Él los que le aborrecen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como se disipa el humo, disípalos;",
          "como la cera se derrite delante del fuego,",
          "así perezcan los impíos delante de Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pero alégrense los justos, regocíjense delante de Dios;",
          "sí, que rebosen de alegría."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cantad a Dios, cantad alabanzas a su nombre;",
          "abrid paso al que cabalga por los desiertos,",
          "cuyo nombre es el Señor; regocijaos delante de Él."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Padre de los huérfanos y defensor de las viudas",
          "es Dios en su santa morada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dios prepara un hogar para los solitarios;",
          "conduce a los cautivos a prosperidad;",
          "solo los rebeldes habitan en una tierra seca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Oh Dios, cuando saliste al frente de tu pueblo,",
          "cuando marchaste por el desierto,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "tembló la tierra;",
          "también se derramaron los cielos ante la presencia de Dios;",
          "el Sinaí mismo tembló delante de Dios, el Dios de Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tú esparciste lluvia abundante, oh Dios,",
          "tú fortaleciste tu heredad cuando estaba extenuada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los de tu pueblo se establecieron en ella;",
          "en tu bondad, oh Dios, proveíste para el pobre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶El Señor da la palabra;",
          "las mujeres que anuncian las buenas nuevas son gran multitud:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Los reyes de los ejércitos huyen; sí huyen,",
          "y la que se queda en casa repartirá el botín."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Cuando os acostáis en los apriscos,",
          "sois como alas de paloma cubiertas de plata,",
          "y sus plumas de oro resplandeciente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cuando el Omnipotente dispersó allí a los reyes,",
          "nevaba en el monte Salmón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¶Monte de Dios es el monte de Basán;",
          "monte de muchos picos es el monte de Basán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¿Por qué miráis con envidia, oh montes de muchos picos,",
          "al monte que Dios ha deseado para morada suya?",
          "Ciertamente el Señor habitará allí para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los carros de Dios son miríadas, millares y millares;",
          "el Señor está entre ellos en santidad, como en el Sinaí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tú has ascendido a lo alto, has llevado en cautividad a tus cautivos;",
          "has recibido dones entre los hombres,",
          "y aun entre los rebeldes, para que el Señor Dios habite entre ellos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¶Bendito sea el Señor, que cada día lleva nuestra carga,",
          "el Dios que es nuestra salvación."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Dios es para nosotros un Dios de salvación,",
          "y a Dios el Señor pertenece el librar de la muerte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Ciertamente Dios herirá la cabeza de sus enemigos,",
          "la testa cabelluda del que anda en sus delitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Dijo el Señor: De Basán los haré volver;",
          "los haré volver de las profundidades del mar;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "para que tu pie los aplaste en sangre,",
          "y la lengua de tus perros tenga la porción de tus enemigos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¶Ellos han visto tu procesión, oh Dios,",
          "la procesión de mi Dios, mi Rey, hacia el santuario."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Los cantores iban delante, los músicos detrás,",
          "en medio de las doncellas tocando panderos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Bendecid a Dios en las congregaciones,",
          "al Señor, vosotros del linaje de Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Allí va Benjamín, el más joven, dirigiéndolos,",
          "los príncipes de Judá con su grupo,",
          "los príncipes de Zabulón, los príncipes de Neftalí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "¶El Dios tuyo ha mandado tu fuerza;",
          "muestra tu poder, oh Dios, tú que has obrado por nosotros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Por causa de tu templo en Jerusalén",
          "te traerán presentes los reyes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Reprende las fieras de las cañas,",
          "la manada de toros con los becerros de los pueblos,",
          "pisoteando las piezas de plata;",
          "Él ha dispersado a los pueblos que se deleitan en la guerra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "De Egipto saldrán mensajeros;",
          "Etiopía se apresurará a extender sus manos hacia Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "¶Cantad a Dios, oh reinos de la tierra;",
          "cantad alabanzas al Señor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Cantad al que cabalga sobre los cielos de los cielos, que son desde la antigüedad;",
          "he aquí, Él da su voz, voz poderosa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Atribuid a Dios fortaleza;",
          "su majestad es sobre Israel,",
          "y su poder está en los cielos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Imponente eres, oh Dios, desde tu santuario.",
          "El Dios mismo de Israel da fortaleza y poder al pueblo.",
          "¡Bendito sea Dios!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
