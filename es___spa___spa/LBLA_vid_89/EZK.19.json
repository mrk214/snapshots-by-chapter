{"version":{"version_id":89,"local_abbreviation":"LBLA","local_title":"La Biblia de las Américas","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"The Lockman Foundation"},"copyright":{"html":"1986, 1995, 1997 by The Lockman Foundation","text":"1986, 1995, 1997 by The Lockman Foundation"}},"book":{"book_usfm":"EZK","name":"Ezequiel"},"chapter":{"chapter_usfm":"EZK.19","is_chapter":true,"previous":{"usfm":"EZK.18","human":"Ezequiel 18","canonical":true,"toc":true},"current":{"usfm":"EZK.19","human":"Ezequiel 19"},"next":{"usfm":"EZK.20","human":"Ezequiel 20","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Elegía por los príncipes de Israel"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Y tú, eleva una elegía por los príncipes de Israel,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["y di:","«¿Qué era tu madre?","una leona entre leones.","Echada en medio de leoncillos,","crió a sus cachorros."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["-»Cuando exaltó a uno de sus cachorros,","este se hizo león,","y aprendió a desgarrar su presa;","devoró hombres."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["-»Entonces oyeron de él las naciones;","en su foso fue capturado,","y lo llevaron con garfios","a la tierra de Egipto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["-»Cuando ella vio, mientras aguardaba,","que su esperanza estaba perdida,","tomó otro de sus cachorros","y lo hizo un leoncillo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["-»Y él andaba entre los leones;","hecho ya un leoncillo,","y aprendió a desgarrar su presa;","devoró hombres;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["destruyó sus torres fortificadas","y asoló sus ciudades;","la tierra y cuanto había en ella estaban aterrados","por el estruendo de sus rugidos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["-»Entonces se pusieron contra él los pueblos","de las provincias de alrededor,","y tendieron sobre él su red;","en su foso fue capturado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["-»Lo pusieron en una jaula con garfios","y lo llevaron al rey de Babilonia;","lo llevaron enjaulado","para que no se oyera más su voz","en los montes de Israel."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["-»Tu madre era como una vid en tu viña,","plantada junto a las aguas;","estaba llena de frutos y ramas","por la abundancia de aguas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["-»Tenía ramas fuertes","propias para cetros de gobernantes,","y su estatura se elevó","hasta en medio de las nubes,","y fue vista a causa de su altura","y por sus muchos sarmientos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["-»Pero fue arrancada con furor,","derribada a tierra,","y el viento solano secó su fruto;","su rama fuerte fue quebrada","y se secó;","el fuego la consumió."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["-»Y ahora está plantada en el desierto,","en una tierra árida y reseca."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["-»Y ha salido fuego de su rama,","ha consumido sus pámpanos y su fruto,","y no queda en ella rama fuerte,","para cetro de gobernante».","Esta es una elegía, y de elegía servirá."],"rlw_lines":[]}]}}