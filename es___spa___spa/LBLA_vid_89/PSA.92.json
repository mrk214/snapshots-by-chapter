    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 92"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza por la bondad del Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo. Cántico para el día de reposo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bueno es dar gracias al Señor,",
          "y cantar alabanzas a tu nombre, oh Altísimo;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "anunciar por la mañana tu bondad,",
          "y tu fidelidad por las noches,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "con el decacordio y con el arpa,",
          "con la música sonora de la lira."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque tú, oh Señor, me has alegrado con tus obras,",
          "cantaré con gozo ante las obras de tus manos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶¡Qué grandes son tus obras, oh Señor,",
          "cuán profundos tus pensamientos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El hombre torpe no tiene conocimiento,",
          "y el necio no entiende esto:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "que cuando los impíos brotaron como la hierba,",
          "y florecieron todos los que hacían iniquidad,",
          "solo fue para ser destruidos para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas tú, oh Señor, excelso eres eternamente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque he aquí, tus enemigos, Señor,",
          "porque he aquí, tus enemigos perecerán;",
          "serán esparcidos todos los que hacen iniquidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Pero tú has exaltado mi poder como el del búfalo;",
          "he sido ungido con aceite fresco."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mis ojos satisfechos han mirado a los que me acechaban,",
          "y oyen mis oídos de los malhechores que se levantan contra mí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El justo florecerá como la palma,",
          "crecerá como cedro en el Líbano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Plantados en la casa del Señor,",
          "florecerán en los atrios de nuestro Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Aun en la vejez darán fruto;",
          "estarán vigorosos y muy verdes,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "para anunciar cuán recto es el Señor,",
          "mi roca, y que no hay injusticia en Él."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
