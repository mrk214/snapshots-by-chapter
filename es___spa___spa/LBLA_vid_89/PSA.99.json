    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 99"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabad al Señor por su fidelidad para con Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El Señor reina, estremézcanse los pueblos;",
          "sentado está sobre los querubines, tiemble la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El Señor es grande en Sión,",
          "y exaltado sobre todos los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Alaben tu nombre grande y temible;",
          "Él es santo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El poder del Rey ama la justicia;",
          "tú has establecido la equidad;",
          "has hecho juicio y justicia en Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Exaltad al Señor nuestro Dios,",
          "y postraos ante el estrado de sus pies;",
          "Él es santo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Moisés y Aarón estaban entre sus sacerdotes,",
          "y Samuel entre los que invocaron su nombre;",
          "ellos clamaron al Señor, y Él les respondió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Les habló en la columna de nube;",
          "guardaron sus testimonios,",
          "y el estatuto que Él les dio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oh Señor, Dios nuestro, tú les respondiste;",
          "fuiste para ellos un Dios perdonador,",
          "mas también vengador de sus malas obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Exaltad al Señor nuestro Dios,",
          "y postraos ante su santo monte,",
          "porque santo es el Señor nuestro Dios."
        ],
        "rlw_lines": []
      }
    ]
  },
