    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 30"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Acción de gracias por haber sido librado de la muerte"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo. Cántico para la dedicación de la Casa. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Te ensalzaré, oh Señor, porque me has elevado,",
          "y no has permitido que mis enemigos se rían de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Oh Señor, Dios mío,",
          "a ti pedí auxilio y me sanaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Oh Señor, has sacado mi alma del Seol;",
          "me has guardado con vida, para que no descienda al sepulcro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cantad alabanzas al Señor, vosotros sus santos,",
          "y alabad su santo nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque su ira es solo por un momento,",
          "pero su favor es por toda una vida;",
          "el llanto puede durar toda la noche,",
          "pero a la mañana vendrá el grito de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Y en mi prosperidad yo dije:",
          "Jamás seré conmovido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Oh Señor, con tu favor has hecho que mi monte permanezca fuerte;",
          "tú escondiste tu rostro, fui conturbado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A ti, oh Señor, clamé,",
          "y al Señor dirigí mi súplica:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Qué provecho hay en mi sangre si desciendo al sepulcro?",
          "¿Acaso te alabará el polvo? ¿Anunciará tu fidelidad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Escucha, oh Señor, y ten piedad de mí;",
          "oh Señor, sé tú mi socorro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tú has cambiado mi lamento en danza;",
          "has desatado mi cilicio y me has ceñido de alegría;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "para que mi alma te cante alabanzas y no esté callada.",
          "Oh Señor, Dios mío, te alabaré por siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
