    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 75"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios humilla al orgulloso y exalta al justo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; según tonada de No destruyas. Salmo de Asaf. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Te damos gracias, oh Dios, te damos gracias,",
          "pues cercano está tu nombre;",
          "los hombres declaran tus maravillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cuando yo escoja el tiempo oportuno,",
          "seré yo quien juzgará con equidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tiemblan la tierra y todos sus moradores,",
          "mas yo sostengo sus columnas."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dije a los orgullosos: No os jactéis;",
          "y a los impíos: No alcéis la frente;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "no levantéis en alto vuestra frente;",
          "no habléis con orgullo insolente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Porque ni del oriente ni del occidente,",
          "ni del desierto viene el enaltecimiento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "sino que Dios es el juez;",
          "a uno humilla y a otro ensalza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Porque hay un cáliz en la mano del Señor, y el vino fermenta,",
          "lleno de mixtura, y de este Él sirve;",
          "ciertamente lo sorberán hasta las heces y lo beberán todos los impíos de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Pero yo lo anunciaré para siempre;",
          "cantaré alabanzas al Dios de Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quebraré todo el poderío de los impíos,",
          "pero el poderío del justo será ensalzado."
        ],
        "rlw_lines": []
      }
    ]
  },
