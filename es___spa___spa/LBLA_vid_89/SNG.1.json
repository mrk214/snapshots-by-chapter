    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La esposa habla a las hijas de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El cantar de los cantares de Salomón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¶¡Que me bese con los besos de su boca!",
          "Porque mejores son tus amores que el vino."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tus ungüentos tienen olor agradable,",
          "tu nombre es como ungüento purificado;",
          "por eso te aman las doncellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Llévame en pos de ti y corramos juntos.",
          "El rey me ha conducido a sus cámaras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL CORO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Nos regocijaremos y nos alegraremos en ti,",
          "exaltaremos tu amor más que el vino.",
          "Con razón te aman."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Soy morena pero preciosa,",
          "oh hijas de Jerusalén,",
          "como las tiendas de Cedar,",
          "como las cortinas de Salomón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No os fijéis en que soy morena,",
          "porque el sol me ha quemado.",
          "Los hijos de mi madre se enojaron conmigo;",
          "me pusieron a guardar las viñas,",
          "y mi propia viña no guardé."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dime, amado de mi alma:",
          "¿Dónde apacientas tu rebaño?",
          "¿Dónde lo haces descansar al mediodía?",
          "¿Por qué he de ser yo como una que se cubre con velo",
          "junto a los rebaños de tus compañeros?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL CORO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Si tú no lo sabes,",
          "¡oh la más hermosa de las mujeres!,",
          "sal tras las huellas del rebaño,",
          "y apacienta tus cabritas",
          "junto a las cabañas de los pastores."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Diálogo entre los esposos"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL ESPOSO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶A mi yegua, entre los carros de Faraón,",
          "yo te comparo, amada mía."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Hermosas son tus mejillas entre los adornos,",
          "tu cuello entre los collares."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL CORO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Adornos de oro haremos para ti,",
          "con cuentas de plata."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶Mientras el rey estaba a la mesa,",
          "mi perfume esparció su fragancia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Bolsita de mirra es mi amado para mí,",
          "que reposa toda la noche entre mis pechos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ramillete de flores de alheña es mi amado para mí",
          "en las viñas de En-gadi."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "EL ESPOSO:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¶Cuán hermosa eres, amada mía,",
          "cuán hermosa eres.",
          "Tus ojos son como palomas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "LA ESPOSA:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¶Cuán hermoso eres, amado mío,",
          "y tan placentero.",
          "Ciertamente nuestro lecho es de exuberante verdor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Las vigas de nuestras casas son cedros,",
          "nuestros artesonados, cipreses."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
