    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 146"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El Señor, verdadero ayudador"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "Oh alma mía, alaba al Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alabaré al Señor mientras yo viva;",
          "cantaré alabanzas a mi Dios mientras yo exista."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No confiéis en príncipes,",
          "ni en hijo de hombre en quien no hay salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Su espíritu exhala, él vuelve a la tierra;",
          "en ese mismo día perecen sus pensamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Bienaventurado aquel cuya ayuda es el Dios de Jacob,",
          "cuya esperanza está en el Señor su Dios,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "que hizo los cielos y la tierra,",
          "el mar y todo lo que en ellos hay;",
          "que guarda la verdad para siempre;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "que hace justicia a los oprimidos,",
          "y da pan a los hambrientos.",
          "El Señor pone en libertad a los cautivos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶El Señor abre los ojos a los ciegos,",
          "el Señor levanta a los caídos,",
          "el Señor ama a los justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El Señor protege a los extranjeros,",
          "sostiene al huérfano y a la viuda,",
          "pero trastorna el camino de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El Señor reinará para siempre,",
          "tu Dios, oh Sión, por todas las generaciones.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
