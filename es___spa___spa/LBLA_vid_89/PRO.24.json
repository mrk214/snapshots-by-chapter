    "name": "Proverbios"
  },
  "chapter": {
    "chapter_usfm": "PRO.24",
    "current": {
      "usfm": "PRO.24",
      "human": "Proverbios 24"
    },
    "previous": {
      "usfm": "PRO.23",
      "human": "Proverbios 23"
    },
    "next": {
      "usfm": "PRO.25",
      "human": "Proverbios 25"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No tengas envidia de los malvados,",
          "ni desees estar con ellos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "porque su corazón trama violencia,",
          "y sus labios hablan de hacer mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶Con sabiduría se edifica una casa,",
          "y con prudencia se afianza;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "con conocimiento se llenan las cámaras",
          "de todo bien preciado y deseable."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶El hombre sabio es fuerte,",
          "y el hombre de conocimiento aumenta su poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque con dirección sabia harás la guerra,",
          "y en la abundancia de consejeros está la victoria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Muy alta está la sabiduría para el necio,",
          "en la puerta no abre su boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Al que planea hacer el mal,",
          "lo llamarán intrigante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El tramar necedad es pecado,",
          "y el escarnecedor es abominación a los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Si eres débil en día de angustia,",
          "tu fuerza es limitada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Libra a los que son llevados a la muerte,",
          "y retén a los que van con pasos vacilantes a la matanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si dices: Mira, no sabíamos esto.",
          "¿No lo tiene en cuenta el que sondea los corazones?",
          "¿No lo sabe el que guarda tu alma?",
          "¿No dará a cada hombre según su obra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¶Come miel, hijo mío, porque es buena;",
          "sí, la miel del panal es dulce a tu paladar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sabe que así es la sabiduría para tu alma;",
          "si la hallas, entonces habrá un futuro,",
          "y tu esperanza no será cortada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¶No aceches, oh impío, la morada del justo,",
          "no destruyas su lugar de descanso;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "porque el justo cae siete veces; y vuelve a levantarse,",
          "pero los impíos caerán en la desgracia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¶No te regocijes cuando caiga tu enemigo,",
          "y no se alegre tu corazón cuando tropiece;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "no sea que el Señor lo vea y le desagrade,",
          "y aparte de él su ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¶No te impacientes a causa de los malhechores,",
          "ni tengas envidia de los impíos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "porque no habrá futuro para el malo.",
          "La lámpara de los impíos será apagada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¶Hijo mío, teme al Señor y al rey,",
          "no te asocies con los que son inestables;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "porque de repente se levantará su desgracia,",
          "y la destrucción que vendrá de ambos, ¿quién la sabe?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¶También estos son dichos de los sabios:",
          "Hacer acepción de personas en el juicio no es bueno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Al que dice al impío: Justo eres,",
          "lo maldecirán los pueblos, lo aborrecerán las naciones;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "mas los que lo reprenden tendrán felicidad,",
          "y sobre ellos vendrá abundante bendición."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Besa los labios",
          "el que da una respuesta correcta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "¶Ordena tus labores de fuera,",
          "y tenlas listas para ti en el campo;",
          "y después edifica tu casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "¶No seas, sin causa, testigo contra tu prójimo,",
          "y no engañes con tus labios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "No digas: Como él me ha hecho, así le haré;",
          "pagaré al hombre según su obra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "¶He pasado junto al campo del perezoso,",
          "y junto a la viña del hombre falto de entendimiento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "y he aquí, estaba todo lleno de cardos,",
          "su superficie cubierta de ortigas,",
          "y su cerca de piedras, derribada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Cuando lo vi, reflexioné sobre ello;",
          "miré, y recibí instrucción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Un poco de dormir, un poco de dormitar,",
          "un poco de cruzar las manos para descansar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "y llegará tu pobreza como ladrón,",
          "y tu necesidad como hombre armado."
        ],
        "rlw_lines": []
      }
    ]
  },
