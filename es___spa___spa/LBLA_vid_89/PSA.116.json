    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 116"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Acción de gracias personal"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Amo al Señor, porque oye",
          "mi voz y mis súplicas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque a mí ha inclinado su oído;",
          "por tanto le invocaré mientras yo viva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Los lazos de la muerte me rodearon,",
          "y los terrores del Seol vinieron sobre mí;",
          "angustia y tristeza encontré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Invoqué entonces el nombre del Señor, diciendo:",
          "Te ruego, oh Señor: salva mi vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Clemente y justo es el Señor;",
          "sí, compasivo es nuestro Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El Señor guarda a los sencillos;",
          "estaba yo postrado y me salvó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Vuelve, alma mía, a tu reposo,",
          "porque el Señor te ha colmado de bienes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pues tú has rescatado mi alma de la muerte,",
          "mis ojos de lágrimas,",
          "mis pies de tropezar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Andaré delante del Señor",
          "en la tierra de los vivientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Yo creía, aun cuando decía:",
          "Estoy muy afligido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dije alarmado:",
          "Todo hombre es mentiroso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶¿Qué daré al Señor",
          "por todos sus beneficios para conmigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Alzaré la copa de la salvación,",
          "e invocaré el nombre del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cumpliré mis votos al Señor,",
          "sí, en presencia de todo su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Estimada a los ojos del Señor",
          "es la muerte de sus santos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Ah, Señor! Ciertamente yo soy tu siervo,",
          "siervo tuyo soy, hijo de tu sierva;",
          "tú desataste mis ataduras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Te ofreceré sacrificio de acción de gracias,",
          "e invocaré el nombre del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Al Señor cumpliré mis votos,",
          "sí, en presencia de todo su pueblo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "en los atrios de la casa del Señor,",
          "en medio de ti, oh Jerusalén.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
