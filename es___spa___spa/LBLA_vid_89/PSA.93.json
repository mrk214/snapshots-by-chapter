      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La majestad del Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El Señor reina, vestido está de majestad;",
          "el Señor se ha vestido y ceñido de poder;",
          "ciertamente el mundo está bien afirmado, será inconmovible."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Desde la antigüedad está establecido tu trono;",
          "tú eres desde la eternidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¶Los torrentes han alzado, oh Señor,",
          "los torrentes han alzado su voz;",
          "los torrentes alzan sus batientes olas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Más que el fragor de muchas aguas,",
          "más que las poderosas olas del mar,",
          "es poderoso el Señor en las alturas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tus testimonios son muy fidedignos;",
          "la santidad conviene a tu casa,",
          "eternamente, oh Señor."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
