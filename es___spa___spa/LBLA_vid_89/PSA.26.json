        "lines": [
          "Salmo 26"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración del íntegro"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hazme justicia, oh Señor, porque yo en mi integridad he andado,",
          "y en el Señor he confiado sin titubear."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Examíname, oh Señor, y pruébame;",
          "escudriña mi mente y mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque delante de mis ojos está tu misericordia,",
          "y en tu verdad he andado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Con los falsos no me he sentado,",
          "ni con los hipócritas iré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aborrezco la reunión de los malhechores,",
          "y no me sentaré con los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Lavaré en inocencia mis manos,",
          "y andaré en torno a tu altar, oh Señor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "proclamando con voz de acción de gracias",
          "y contando todas tus maravillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Oh Señor, yo amo la habitación de tu casa,",
          "y el lugar donde habita tu gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No juntes mi alma con pecadores,",
          "ni mi vida con hombres sanguinarios,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "en cuyas manos hay ardides inicuos,",
          "y cuya diestra está llena de sobornos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mas yo en mi integridad andaré;",
          "redímeme, y ten piedad de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sobre tierra firme está mi pie;",
          "en las congregaciones bendeciré al Señor."
        ],
        "rlw_lines": []
      }
    ]
  },
