    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 2"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El reino del Ungido del Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿Por qué se sublevan las naciones,",
          "y los pueblos traman cosas vanas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Se levantan los reyes de la tierra,",
          "y los gobernantes traman unidos",
          "contra el Señor y contra su Ungido, diciendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Rompamos sus cadenas",
          "y echemos de nosotros sus cuerdas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¶Él que se sienta como Rey en los cielos se ríe,",
          "el Señor se burla de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Luego les hablará en su ira,",
          "y en su furor los aterrará, diciendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pero yo mismo he consagrado a mi Rey",
          "sobre Sión, mi santo monte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶Ciertamente anunciaré el decreto del Señor",
          "que me dijo: «Mi Hijo eres tú,",
          "yo te he engendrado hoy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "-»Pídeme, y te daré las naciones como herencia tuya,",
          "y como posesión tuya los confines de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "-»Tú los quebrantarás con vara de hierro;",
          "los desmenuzarás como vaso de alfarero»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Ahora pues, oh reyes, mostrad discernimiento;",
          "recibid amonestación, oh jueces de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Adorad al Señor con reverencia,",
          "y alegraos con temblor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Honrad al Hijo para que no se enoje y perezcáis en el camino,",
          "pues puede inflamarse de repente su ira.",
          "¡Cuán bienaventurados son todos los que en Él se refugian!"
        ],
        "rlw_lines": []
      }
    ]
  },
