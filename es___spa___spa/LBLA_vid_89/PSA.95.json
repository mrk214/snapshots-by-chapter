    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 95"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza al Señor y advertencia contra la incredulidad"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Venid, cantemos con gozo al Señor,",
          "aclamemos con júbilo a la roca de nuestra salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Vengamos ante su presencia con acción de gracias;",
          "aclamémosle con salmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque Dios grande es el Señor,",
          "y Rey grande sobre todos los dioses,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "en cuya mano están las profundidades de la tierra;",
          "suyas son también las cumbres de los montes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Suyo es el mar, pues Él lo hizo,",
          "y sus manos formaron la tierra firme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Venid, adoremos y postrémonos;",
          "doblemos la rodilla ante el Señor nuestro Hacedor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque Él es nuestro Dios,",
          "y nosotros el pueblo de su prado y las ovejas de su mano.",
          "Si oís hoy su voz,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "no endurezcáis vuestro corazón como en Meriba,",
          "como en el día de Masah en el desierto,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "cuando vuestros padres me tentaron,",
          "me probaron, aunque habían visto mi obra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por cuarenta años me repugnó aquella generación,",
          "y dije: Es un pueblo que se desvía en su corazón",
          "y no conocen mis caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por tanto, juré en mi ira:",
          "Ciertamente no entrarán en mi reposo."
        ],
        "rlw_lines": []
      }
    ]
  },
