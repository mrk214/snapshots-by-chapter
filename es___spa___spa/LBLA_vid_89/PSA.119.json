        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          169
        ],
        "lines": [
          "¶Llegue mi clamor ante ti, Señor;",
          "conforme a tu palabra dame entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          170
        ],
        "lines": [
          "Llegue mi súplica delante de ti;",
          "líbrame conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          171
        ],
        "lines": [
          "Profieran mis labios alabanzas,",
          "pues tú me enseñas tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          172
        ],
        "lines": [
          "Que cante mi lengua de tu palabra,",
          "porque todos tus mandamientos son justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          173
        ],
        "lines": [
          "Pronta esté tu mano a socorrerme,",
          "porque tus preceptos he escogido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          174
        ],
        "lines": [
          "Anhelo tu salvación, Señor,",
          "y tu ley es mi deleite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          175
        ],
        "lines": [
          "Viva mi alma para alabarte,",
          "y que tus ordenanzas me ayuden."
