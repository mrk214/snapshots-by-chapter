    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 119"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Meditaciones sobre la palabra de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alef."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Cuán bienaventurados son los de camino perfecto,",
          "los que andan en la ley del Señor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Cuán bienaventurados son los que guardan sus testimonios,",
          "y con todo el corazón le buscan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No cometen iniquidad,",
          "sino que andan en sus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tú has ordenado tus preceptos,",
          "para que los guardemos con diligencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Ojalá mis caminos sean afirmados",
          "para guardar tus estatutos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Entonces no seré avergonzado,",
          "al considerar todos tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Con rectitud de corazón te daré gracias,",
          "al aprender tus justos juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tus estatutos guardaré;",
          "no me dejes en completo desamparo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bet."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶¿Cómo puede el joven guardar puro su camino?",
          "Guardando tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Con todo mi corazón te he buscado;",
          "no dejes que me desvíe de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "En mi corazón he atesorado tu palabra,",
          "para no pecar contra ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Bendito tú, oh Señor;",
          "enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "He contado con mis labios",
          "de todas las ordenanzas de tu boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Me he gozado en el camino de tus testimonios,",
          "más que en todas las riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Meditaré en tus preceptos,",
          "y consideraré tus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Me deleitaré en tus estatutos,",
          "y no olvidaré tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Guímel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¶Favorece a tu siervo,",
          "para que viva y guarde tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Abre mis ojos, para que vea",
          "las maravillas de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Peregrino soy en la tierra,",
          "no escondas de mí tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Quebrantada está mi alma anhelando",
          "tus ordenanzas en todo tiempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Tú reprendes a los soberbios, los malditos,",
          "que se desvían de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Quita de mí el oprobio y el desprecio,",
          "porque yo guardo tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Aunque los príncipes se sienten y hablen contra mí,",
          "tu siervo medita en tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "También tus testimonios son mi deleite;",
          "ellos son mis consejeros."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dálet."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "¶Postrada está mi alma en el polvo;",
          "vivifícame conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "De mis caminos te conté, y tú me has respondido;",
          "enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Hazme entender el camino de tus preceptos,",
          "y meditaré en tus maravillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "De tristeza llora mi alma;",
          "fortaléceme conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Quita de mí el camino de la mentira,",
          "y en tu bondad concédeme tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "He escogido el camino de la verdad;",
          "he puesto tus ordenanzas delante de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Me apego a tus testimonios;",
          "Señor, no me avergüences."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Por el camino de tus mandamientos correré,",
          "porque tú ensancharás mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "He."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "¶Enséñame, oh Señor, el camino de tus estatutos,",
          "y lo guardaré hasta el fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Dame entendimiento para que guarde tu ley",
          "y la cumpla de todo corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Hazme andar por la senda de tus mandamientos,",
          "porque en ella me deleito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Inclina mi corazón a tus testimonios",
          "y no a la ganancia deshonesta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Aparta mis ojos de mirar la vanidad,",
          "y vivifícame en tus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Confirma a tu siervo tu palabra,",
          "que inspira reverencia por ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Quita de mí el oprobio que me causa temor,",
          "porque tus juicios son buenos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "He aquí, anhelo tus preceptos;",
          "vivifícame por tu justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Vav."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "¶Venga también a mí tu misericordia, oh Señor,",
          "tu salvación, conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Y tendré respuesta para el que me afrenta,",
          "pues confío en tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "No quites jamás de mi boca la palabra de verdad,",
          "porque yo espero en tus ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Y guardaré continuamente tu ley,",
          "para siempre y eternamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Y andaré en libertad,",
          "porque busco tus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Hablaré también de tus testimonios delante de reyes,",
          "y no me avergonzaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Y me deleitaré en tus mandamientos,",
          "los cuales amo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Levantaré mis manos a tus mandamientos,",
          "los cuales amo,",
          "y meditaré en tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Zain."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "¶Acuérdate de la palabra dada a tu siervo,",
          "en la cual me has hecho esperar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Este es mi consuelo en la aflicción:",
          "que tu palabra me ha vivificado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Los soberbios me insultaron en gran manera,",
          "sin embargo, no me he apartado de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Me acuerdo de tus ordenanzas antiguas, oh Señor,",
          "y me consuelo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Profunda indignación se ha apoderado de mí por causa de los impíos",
          "que abandonan tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Cánticos para mí son tus estatutos",
          "en la casa de mi peregrinación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Por la noche me acuerdo de tu nombre, oh Señor,",
          "y guardo tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Esto se ha hecho parte de mí:",
          "guardar tus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jet."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "¶El Señor es mi porción;",
          "he prometido guardar tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Supliqué tu favor con todo mi corazón;",
          "ten piedad de mí conforme a tu promesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Consideré mis caminos,",
          "y volví mis pasos a tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Me apresuré y no me tardé",
          "en guardar tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Los lazos de los impíos me han rodeado,",
          "mas no me he olvidado de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "A medianoche me levantaré para darte gracias",
          "por tus justas ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Compañero soy de todos los que te temen,",
          "y de los que guardan tus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "La tierra, oh Señor, está llena de tu misericordia;",
          "enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tet."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "¶Bien has obrado con tu siervo,",
          "oh Señor, conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Enséñame buen juicio y conocimiento,",
          "pues creo en tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Antes que fuera afligido, yo me descarrié,",
          "mas ahora guardo tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Bueno eres tú, y bienhechor;",
          "enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "Los soberbios han forjado mentira contra mí,",
          "pero de todo corazón guardaré tus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "Su corazón está cubierto de grasa,",
          "pero yo me deleito en tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "Bueno es para mí ser afligido,",
          "para que aprenda tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "Mejor es para mí la ley de tu boca",
          "que millares de piezas de oro y de plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Yod."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "¶Tus manos me hicieron y me formaron;",
          "dame entendimiento para que aprenda tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "Que los que te temen, me vean y se alegren,",
          "porque espero en tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "Yo sé, Señor, que tus juicios son justos,",
          "y que en tu fidelidad me has afligido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "Sea ahora tu misericordia para consuelo mío,",
          "conforme a tu promesa dada a tu siervo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "Venga a mí tu compasión, para que viva,",
          "porque tu ley es mi deleite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "Sean avergonzados los soberbios, porque me agravian con mentira;",
          "pero yo en tus preceptos meditaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Vuélvanse a mí los que te temen",
          "y conocen tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "Sea íntegro mi corazón en tus estatutos,",
          "para que no sea yo avergonzado."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Caf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "¶Mi alma desfallece por tu salvación;",
          "en tu palabra espero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          82
        ],
        "lines": [
          "Mis ojos desfallecen esperando tu palabra,",
          "mientras digo: ¿Cuándo me consolarás?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          83
        ],
        "lines": [
          "Aunque he llegado a ser como odre al humo,",
          "no me olvido de tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          84
        ],
        "lines": [
          "¿Cuántos son los días de tu siervo?",
          "¿Cuándo harás juicio contra mis perseguidores?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          85
        ],
        "lines": [
          "Fosas me han cavado los soberbios,",
          "los que no están de acuerdo con tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          86
        ],
        "lines": [
          "Todos tus mandamientos son fieles;",
          "con mentira me han perseguido; ¡ayúdame!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          87
        ],
        "lines": [
          "Casi me destruyen en la tierra,",
          "mas yo no abandoné tus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          88
        ],
        "lines": [
          "Vivifícame conforme a tu misericordia,",
          "para que guarde el testimonio de tu boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lámed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          89
        ],
        "lines": [
          "¶Para siempre, oh Señor,",
          "tu palabra está firme en los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          90
        ],
        "lines": [
          "Tu fidelidad permanece por todas las generaciones;",
          "tú estableciste la tierra, y ella permanece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          91
        ],
        "lines": [
          "Por tus ordenanzas permanecen hasta hoy,",
          "pues todas las cosas te sirven."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          92
        ],
        "lines": [
          "Si tu ley no hubiera sido mi deleite,",
          "entonces habría perecido en mi aflicción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          93
        ],
        "lines": [
          "Jamás me olvidaré de tus preceptos,",
          "porque por ellos me has vivificado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          94
        ],
        "lines": [
          "Tuyo soy, Señor, sálvame,",
          "pues tus preceptos he buscado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          95
        ],
        "lines": [
          "Los impíos me esperan para destruirme;",
          "tus testimonios consideraré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          96
        ],
        "lines": [
          "He visto un límite a toda perfección;",
          "tu mandamiento es sumamente amplio."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Mem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          97
        ],
        "lines": [
          "¶¡Cuánto amo tu ley!",
          "Todo el día es ella mi meditación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          98
        ],
        "lines": [
          "Tus mandamientos me hacen más sabio que mis enemigos,",
          "porque son míos para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          99
        ],
        "lines": [
          "Tengo más discernimiento que todos mis maestros,",
          "porque tus testimonios son mi meditación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          100
        ],
        "lines": [
          "Entiendo más que los ancianos,",
          "porque tus preceptos he guardado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          101
        ],
        "lines": [
          "De todo mal camino he refrenado mis pies,",
          "para guardar tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          102
        ],
        "lines": [
          "No me he desviado de tus ordenanzas,",
          "porque tú me has enseñado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          103
        ],
        "lines": [
          "¡Cuán dulces son a mi paladar tus palabras!,",
          "más que la miel a mi boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          104
        ],
        "lines": [
          "De tus preceptos recibo entendimiento,",
          "por tanto aborrezco todo camino de mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Nun."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          105
        ],
        "lines": [
          "¶Lámpara es a mis pies tu palabra,",
          "y luz para mi camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          106
        ],
        "lines": [
          "He jurado, y lo confirmaré,",
          "que guardaré tus justas ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          107
        ],
        "lines": [
          "Estoy profundamente afligido;",
          "Señor, vivifícame conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          108
        ],
        "lines": [
          "Te ruego aceptes las ofrendas voluntarias de mi boca, oh Señor,",
          "y enséñame tus ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          109
        ],
        "lines": [
          "En peligro continuo está mi vida,",
          "con todo, no me olvido de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          110
        ],
        "lines": [
          "Los impíos me han tendido lazo,",
          "pero no me he desviado de tus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          111
        ],
        "lines": [
          "Tus testimonios he tomado como herencia para siempre,",
          "porque son el gozo de mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          112
        ],
        "lines": [
          "He inclinado mi corazón para cumplir tus estatutos",
          "por siempre, y hasta el fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sámec."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          113
        ],
        "lines": [
          "¶Aborrezco a los hipócritas,",
          "empero amo tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          114
        ],
        "lines": [
          "Tú eres mi escondedero y mi escudo;",
          "en tu palabra espero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          115
        ],
        "lines": [
          "Apartaos de mí, malhechores,",
          "para que guarde yo los mandamientos de mi Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          116
        ],
        "lines": [
          "Sostenme conforme a tu promesa, para que viva,",
          "y no dejes que me avergüence de mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          117
        ],
        "lines": [
          "Sostenme, para estar seguro,",
          "y que continuamente preste atención a tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          118
        ],
        "lines": [
          "Has rechazado a todos los que se desvían de tus estatutos,",
          "porque su engaño es en vano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          119
        ],
        "lines": [
          "Como escoria has quitado de la tierra a todos los impíos,",
          "por tanto amo tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          120
        ],
        "lines": [
          "Mi carne se estremece por temor a ti,",
          "y de tus juicios tengo miedo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ayin."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          121
        ],
        "lines": [
          "¶He practicado el juicio y la justicia;",
          "no me abandones a mis opresores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          122
        ],
        "lines": [
          "Sé fiador de tu siervo para bien;",
          "que no me opriman los soberbios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          123
        ],
        "lines": [
          "Desfallecen mis ojos por tu salvación,",
          "y por la promesa de tu justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          124
        ],
        "lines": [
          "Haz con tu siervo según tu misericordia,",
          "y enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          125
        ],
        "lines": [
          "Yo soy tu siervo, dame entendimiento",
          "para que conozca tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          126
        ],
        "lines": [
          "Es tiempo de que actúe el Señor,",
          "porque han quebrantado tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          127
        ],
        "lines": [
          "Por tanto, amo tus mandamientos",
          "más que el oro, sí, más que el oro fino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          128
        ],
        "lines": [
          "Por tanto, estimo rectos todos tus preceptos acerca de todas las cosas,",
          "y aborrezco todo camino de mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          129
        ],
        "lines": [
          "¶Maravillosos son tus testimonios,",
          "por lo que los guarda mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          130
        ],
        "lines": [
          "La exposición de tus palabras imparte luz;",
          "da entendimiento a los sencillos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          131
        ],
        "lines": [
          "Abrí mi boca y suspiré,",
          "porque anhelaba tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          132
        ],
        "lines": [
          "Vuélvete a mí y tenme piedad,",
          "como acostumbras con los que aman tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          133
        ],
        "lines": [
          "Afirma mis pasos en tu palabra,",
          "y que ninguna iniquidad me domine."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          134
        ],
        "lines": [
          "Rescátame de la opresión del hombre,",
          "para que yo guarde tus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          135
        ],
        "lines": [
          "Haz resplandecer tu rostro sobre tu siervo,",
          "y enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          136
        ],
        "lines": [
          "Ríos de lágrimas vierten mis ojos,",
          "porque ellos no guardan tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tsade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          137
        ],
        "lines": [
          "¶Justo eres tú, Señor,",
          "y rectos tus juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          138
        ],
        "lines": [
          "Has ordenado tus testimonios con justicia,",
          "y con suma fidelidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          139
        ],
        "lines": [
          "Mi celo me ha consumido,",
          "porque mis adversarios han olvidado tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          140
        ],
        "lines": [
          "Es muy pura tu palabra,",
          "y tu siervo la ama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          141
        ],
        "lines": [
          "Pequeño soy, y despreciado,",
          "mas no me olvido de tus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          142
        ],
        "lines": [
          "Tu justicia es justicia eterna,",
          "y tu ley verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          143
        ],
        "lines": [
          "Angustia y aflicción han venido sobre mí,",
          "mas tus mandamientos son mi deleite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          144
        ],
        "lines": [
          "Tus testimonios son justos para siempre;",
          "dame entendimiento para que yo viva."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cof."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          145
        ],
        "lines": [
          "¶He clamado con todo mi corazón; ¡respóndeme, Señor!",
          "Guardaré tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          146
        ],
        "lines": [
          "A ti clamé; sálvame,",
          "y guardaré tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          147
        ],
        "lines": [
          "Me anticipo al alba y clamo;",
          "en tus palabras espero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          148
        ],
        "lines": [
          "Mis ojos se anticipan a las vigilias de la noche,",
          "para meditar en tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          149
        ],
        "lines": [
          "Oye mi voz conforme a tu misericordia;",
          "vivifícame, oh Señor, conforme a tus ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          150
        ],
        "lines": [
          "Se me acercan los que siguen la maldad;",
          "lejos están de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          151
        ],
        "lines": [
          "Tú estás cerca, Señor,",
          "y todos tus mandamientos son verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          152
        ],
        "lines": [
          "Desde hace tiempo he sabido de tus testimonios,",
          "que para siempre los has fundado."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resh."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          153
        ],
        "lines": [
          "¶Mira mi aflicción y líbrame,",
          "porque no me olvido de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          154
        ],
        "lines": [
          "Defiende mi causa y redímeme;",
          "vivifícame conforme a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          155
        ],
        "lines": [
          "Lejos está de los impíos la salvación,",
          "porque no buscan tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          156
        ],
        "lines": [
          "Muchas son, oh Señor, tus misericordias;",
          "vivifícame conforme a tus ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          157
        ],
        "lines": [
          "Muchos son mis perseguidores y mis adversarios,",
          "pero yo no me aparto de tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          158
        ],
        "lines": [
          "Veo a los pérfidos y me repugnan,",
          "porque no guardan tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          159
        ],
        "lines": [
          "Mira cuánto amo tus preceptos;",
          "vivifícame, Señor, conforme a tu misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          160
        ],
        "lines": [
          "La suma de tu palabra es verdad,",
          "y cada una de tus justas ordenanzas es eterna."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sin."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          161
        ],
        "lines": [
          "¶Príncipes me persiguen sin causa,",
          "pero mi corazón teme tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          162
        ],
        "lines": [
          "Me regocijo en tu palabra,",
          "como quien halla un gran botín."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          163
        ],
        "lines": [
          "Aborrezco y desprecio la mentira,",
          "pero amo tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          164
        ],
        "lines": [
          "Siete veces al día te alabo,",
          "a causa de tus justas ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          165
        ],
        "lines": [
          "Mucha paz tienen los que aman tu ley,",
          "y nada los hace tropezar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          166
        ],
        "lines": [
          "Espero tu salvación, Señor,",
          "y cumplo tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          167
        ],
        "lines": [
          "Mi alma guarda tus testimonios,",
          "y en gran manera los amo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          168
        ],
        "lines": [
          "Guardo tus preceptos y tus testimonios,",
          "porque todos mis caminos están delante de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
