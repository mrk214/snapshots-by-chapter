    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 139"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Omnipresencia y omnisciencia del Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Señor, tú me has escudriñado y conocido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tú conoces mi sentarme y mi levantarme;",
          "desde lejos comprendes mis pensamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tú escudriñas mi senda y mi descanso,",
          "y conoces bien todos mis caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Aun antes de que haya palabra en mi boca,",
          "he aquí, oh Señor, tú ya la sabes toda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Por detrás y por delante me has cercado,",
          "y tu mano pusiste sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tal conocimiento es demasiado maravilloso para mí;",
          "es muy elevado, no lo puedo alcanzar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¶¿Adónde me iré de tu Espíritu,",
          "o adónde huiré de tu presencia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Si subo a los cielos, he aquí, allí estás tú;",
          "si en el Seol preparo mi lecho, allí estás tú."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Si tomo las alas del alba,",
          "y si habito en lo más remoto del mar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "aun allí me guiará tu mano,",
          "y me asirá tu diestra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Si digo: Ciertamente las tinieblas me envolverán,",
          "y la luz en torno mío será noche;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "ni aun las tinieblas son oscuras para ti,",
          "y la noche brilla como el día.",
          "Las tinieblas y la luz son iguales para ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¶Porque tú formaste mis entrañas;",
          "me hiciste en el seno de mi madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Te alabaré, porque asombrosa y maravillosamente he sido hecho;",
          "maravillosas son tus obras,",
          "y mi alma lo sabe muy bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "No estaba oculto de ti mi cuerpo,",
          "cuando en secreto fui formado,",
          "y entretejido en las profundidades de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tus ojos vieron mi embrión,",
          "y en tu libro se escribieron todos",
          "los días que me fueron dados,",
          "cuando no existía ni uno solo de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¶¡Cuán preciosos también son para mí, oh Dios, tus pensamientos!",
          "¡Cuán inmensa es la suma de ellos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si los contara, serían más que la arena;",
          "al despertar aún estoy contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Oh Dios, si tú hicieras morir al impío!",
          "Por tanto, apartaos de mí, hombres sanguinarios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Porque hablan contra ti perversamente,",
          "y tus enemigos toman tu nombre en vano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¿No odio a los que te aborrecen, Señor?",
          "¿Y no me repugnan los que se levantan contra ti?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Los aborrezco con el más profundo odio;",
          "se han convertido en mis enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¶Escudríñame, oh Dios, y conoce mi corazón;",
          "pruébame y conoce mis inquietudes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Y ve si hay en mí camino malo,",
          "y guíame en el camino eterno."
        ],
        "rlw_lines": []
      }
    ]
  },
