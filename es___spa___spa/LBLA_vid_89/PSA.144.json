    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 144"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración pidiendo rescate y prosperidad"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bendito sea el Señor, mi roca,",
          "que adiestra mis manos para la guerra,",
          "y mis dedos para la batalla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Misericordia mía y fortaleza mía,",
          "mi baluarte y mi libertador,",
          "escudo mío en quien me he refugiado,",
          "el que sujeta a mi pueblo debajo de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Oh Señor, ¿qué es el hombre para que tú lo tengas en cuenta,",
          "o el hijo del hombre para que pienses en él?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El hombre es semejante a un soplo;",
          "sus días son como una sombra que pasa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¶Oh Señor, inclina tus cielos y desciende;",
          "toca los montes para que humeen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Despide relámpagos y dispérsalos;",
          "lanza tus flechas y confúndelos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Extiende tu mano desde lo alto;",
          "rescátame y líbrame de las muchas aguas,",
          "de la mano de extranjeros"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "cuya boca habla falsedad",
          "y cuya diestra es diestra de mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¶Oh Dios, un cántico nuevo te cantaré;",
          "con arpa de diez cuerdas cantaré alabanzas a ti,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "el que da la victoria a los reyes,",
          "el que rescata a David su siervo de espada maligna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Rescátame y líbrame de la mano de extranjeros,",
          "cuya boca habla falsedad,",
          "y cuya diestra es diestra de mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¶Sean nuestros hijos en su juventud como plantíos florecientes,",
          "y nuestras hijas como columnas de esquinas labradas como las de un palacio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Estén llenos nuestros graneros, suministrando toda clase de sustento,",
          "y nuestros rebaños produzcan miles y diez miles en nuestros campos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Esté cargado nuestro ganado,",
          "sin fracasos y sin pérdida,",
          "y no haya gritos en nuestras calles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Bienaventurado el pueblo a quien así le sucede;",
          "bienaventurado el pueblo cuyo Dios es el Señor."
        ],
        "rlw_lines": []
      }
    ]
  },
