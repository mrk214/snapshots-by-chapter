    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Palabras del rey Lemuel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palabras del rey Lemuel, oráculo que le enseñó su madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¶¿Qué, hijo mío?",
          "¿Qué, hijo de mis entrañas?",
          "¿Qué, hijo de mis votos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No des tu vigor a las mujeres,",
          "ni tus caminos a lo que destruye a los reyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No es para los reyes, oh Lemuel,",
          "no es para los reyes beber vino,",
          "ni para los gobernantes desear bebida fuerte;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "no sea que beban y olviden lo que se ha decretado,",
          "y perviertan los derechos de todos los afligidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dad bebida fuerte al que está pereciendo,",
          "y vino a los amargados de alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que beba y se olvide de su pobreza,",
          "y no recuerde más su aflicción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Abre tu boca por los mudos,",
          "por los derechos de todos los desdichados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Abre tu boca, juzga con justicia,",
          "y defiende los derechos del afligido y del necesitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Elogio de la mujer hacendosa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¶Mujer hacendosa, ¿quién la hallará?",
          "Su valor supera en mucho al de las joyas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "En ella confía el corazón de su marido,",
          "y no carecerá de ganancias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ella le trae bien y no mal",
          "todos los días de su vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Busca lana y lino,",
          "y con agrado trabaja con sus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Es como las naves de mercader,",
          "trae su alimento de lejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "También se levanta cuando aún es de noche,",
          "y da alimento a los de su casa,",
          "y tarea a sus doncellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Evalúa un campo y lo compra;",
          "con sus ganancias planta una viña."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ella se ciñe de fuerza,",
          "y fortalece sus brazos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Nota que su ganancia es buena,",
          "no se apaga de noche su lámpara."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Extiende sus manos a la rueca,",
          "y sus manos toman el huso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Extiende su mano al pobre,",
          "y alarga sus manos al necesitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No tiene temor de la nieve por los de su casa,",
          "porque todos los de su casa llevan ropa escarlata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Se hace mantos para sí;",
          "su ropa es de lino fino y de púrpura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Su marido es conocido en las puertas,",
          "cuando se sienta con los ancianos de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Hace telas de lino y las vende,",
          "y provee cinturones a los mercaderes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Fuerza y dignidad son su vestidura,",
          "y sonríe al futuro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Abre su boca con sabiduría,",
          "y hay enseñanza de bondad en su lengua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Ella vigila la marcha de su casa,",
          "y no come el pan de la ociosidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Sus hijos se levantan y la llaman bienaventurada,",
          "también su marido, y la alaba diciendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Muchas mujeres han obrado con nobleza,",
          "pero tú las superas a todas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Engañosa es la gracia y vana la belleza,",
          "pero la mujer que teme al Señor, esa será alabada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Dadle el fruto de sus manos,",
          "y que sus obras la alaben en las puertas."
        ],
        "rlw_lines": []
      }
    ]
  },
