    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Condenación de Israel y Judá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palabra del Señor que vino a Miqueas de Moréset en los días de Jotam, Acaz y Ezequías, reyes de Judá; lo que vio acerca de Samaria y Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Oíd, pueblos todos,",
          "escucha, tierra y cuanto hay en ti;",
          "sea el Señor Dios testigo contra vosotros,",
          "el Señor desde su santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque he aquí, el Señor sale de su lugar,",
          "y descenderá y hollará las alturas de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Debajo de Él los montes se derretirán,",
          "y los valles se hendirán,",
          "como la cera ante el fuego,",
          "como las aguas derramadas por una pendiente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Todo esto por la rebelión de Jacob",
          "y por los pecados de la casa de Israel.",
          "¿Cuál es la rebelión de Jacob?",
          "¿No es Samaria?",
          "¿Cuál es el lugar alto de Judá?",
          "¿No es Jerusalén?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Haré, pues, de Samaria un montón de ruinas en el campo,",
          "lugares para plantar viñas;",
          "derramaré sus piedras por el valle,",
          "y pondré al descubierto sus cimientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todos sus ídolos serán destrozados,",
          "y todas sus ganancias serán quemadas por el fuego,",
          "y asolaré todas sus imágenes,",
          "porque las juntó de ganancias de ramera,",
          "y a ganancias de ramera volverán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¶Por eso me lamentaré y gemiré,",
          "andaré descalzo y desnudo,",
          "daré aullidos como los chacales",
          "y lamentos como los avestruces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque es incurable su herida,",
          "pues ha llegado hasta Judá;",
          "se ha acercado hasta la puerta de mi pueblo,",
          "hasta Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "En Gat no lo anunciéis,",
          "tampoco lloréis.",
          "En Bet-le-afrá revuélcate en el polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Vete al cautiverio, habitante de Safir, en vergonzosa desnudez.",
          "La que habita en Zaanán no escapa.",
          "La lamentación de Bet-esel es",
          "que Él quitará de vosotros su apoyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque se debilita esperando el bien",
          "la que habita en Marot,",
          "pues la calamidad ha descendido del Señor",
          "hasta la puerta de Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Unce al carro los corceles,",
          "habitante de Laquis",
          "(ella fue principio de pecado",
          "para la hija de Sión);",
          "porque en ti fueron halladas",
          "las rebeliones de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Por tanto, darás presentes de despedida",
          "a Moréset-gat;",
          "las casas de Aczib serán un engaño",
          "para los reyes de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Además, traeré contra ti",
          "al que toma posesión,",
          "oh habitante de Maresa.",
          "Hasta Adulam se irá la gloria de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Arráncate los cabellos y ráete",
          "por los hijos de tus delicias;",
          "ensancha tu calva como la del buitre,",
          "porque irán al cautiverio lejos de ti."
        ],
        "rlw_lines": []
      }
    ]
  },
