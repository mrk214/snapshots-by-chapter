    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Salmo 81"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bondad de Dios y desobediencia de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro; sobre Gitit. Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantad con gozo a Dios, fortaleza nuestra;",
          "aclamad con júbilo al Dios de Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Entonad canto de alabanza, y tocad el pandero,",
          "la melodiosa lira con el arpa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tocad la trompeta en la luna nueva,",
          "en la luna llena, en el día de nuestra fiesta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque es estatuto para Israel,",
          "ordenanza del Dios de Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Él lo estableció por testimonio en José,",
          "cuando salió sobre la tierra de Egipto.",
          "Un lenguaje que yo no conocía, oí:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¶Yo libré su hombro de la carga,",
          "sus manos se libraron de las canastas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En la angustia llamaste, y yo te rescaté;",
          "te respondí en el escondite del trueno;",
          "en las aguas de Meriba te probé."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oye, pueblo mío, y te amonestaré.",
          "¡Oh Israel, si tú me oyeras!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No haya en ti dios ajeno,",
          "ni adores a dios extranjero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Yo, el Señor, soy tu Dios,",
          "que te saqué de la tierra de Egipto;",
          "abre bien tu boca y la llenaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¶Pero mi pueblo no escuchó mi voz;",
          "Israel no me obedeció."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por eso los entregué a la dureza de su corazón,",
          "para que anduvieran en sus propias intrigas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Oh, si mi pueblo me oyera,",
          "si Israel anduviera en mis caminos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "En un momento yo subyugaría a sus enemigos",
          "y volvería mi mano contra sus adversarios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los que aborrecen al Señor le fingirían obediencia,",
          "y el tiempo de su castigo sería para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pero yo te alimentaría con lo mejor del trigo,",
          "y con miel de la peña te saciaría."
        ],
        "rlw_lines": []
      }
    ]
  },
