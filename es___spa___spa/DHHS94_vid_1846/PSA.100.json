        "lines": [
          "El Señor nos hizo y somos suyos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1a (1a) Salmo para la acción de gracias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) ¡Canten al Señor con alegría,",
          "habitantes de toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Con alegría adoren al Señor;",
          "¡con gritos de alegría vengan a su presencia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Reconozcan que el Señor es Dios;",
          "él nos hizo y somos suyos;",
          "¡somos pueblo suyo y ovejas de su prado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Vengan a las puertas y a los atrios de su templo",
          "con himnos de alabanza y gratitud.",
          "¡Denle gracias, bendigan su nombre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque el Señor es bueno;",
          "su amor es eterno",
          "y su fidelidad no tiene fin."
        ],
        "rlw_lines": []
      }
    ]
