    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tus obras son maravillosas"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1a (1a) Del maestro de coro. Salmo, cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Canten a Dios con alegría,",
          "habitantes de toda la tierra;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "canten himnos a su glorioso nombre;",
          "cántenle gloriosas alabanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Díganle a Dios:",
          "«Tus obras son maravillosas.",
          "Por tu gran poder",
          "tus enemigos caen aterrados ante ti;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "todo el mundo te adora",
          "y canta himnos a tu nombre.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Vengan a ver las obras de Dios,",
          "las maravillas que ha hecho por los hombres:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "convirtió el mar en tierra seca,",
          "y nuestros antepasados cruzaron el río a pie;",
          "¡alegrémonos en Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Con su poder, gobierna para siempre;",
          "vigila su mirada a las naciones,",
          "para que los rebeldes",
          "no se levanten contra él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Naciones, bendigan a nuestro Dios!,",
          "¡hagan resonar himnos de alabanza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque nos ha mantenido con vida;",
          "no nos ha dejado caer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios nuestro, tú nos has puesto a prueba,",
          "¡nos has purificado como a la plata!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Nos has hecho caer en la red;",
          "nos cargaste con un gran peso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Dejaste que un cualquiera nos pisoteara;",
          "hemos pasado a través de agua y fuego,",
          "pero al fin nos has dado respiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Entraré en tu templo y te ofreceré holocaustos;",
          "así cumpliré mis promesas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "las promesas que te hice",
          "cuando me hallaba en peligro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Te presentaré holocaustos de animales engordados;",
          "te ofreceré toros y machos cabríos,",
          "y sacrificios de carneros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Vengan todos ustedes,",
          "los que tienen temor de Dios!",
          "¡Escuchen, que voy a contarles",
          "lo que ha hecho por mí!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Con mis labios y mi lengua",
          "lo llamé y lo alabé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si yo tuviera malos pensamientos,",
          "el Señor no me habría escuchado;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡pero él me escuchó y atendió mis oraciones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Bendito sea Dios,",
          "que no rechazó mi oración",
          "ni me negó su amor!"
        ],
        "rlw_lines": []
      }
    ]
  },
