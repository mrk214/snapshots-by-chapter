    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración por Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Sálvanos, Dios del universo,",
          "y haz que todas las naciones te teman;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "amenaza al pueblo extranjero",
          "para que experimente tu fuerza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tú nos castigaste para mostrarles a ellos tu santidad;",
          "castígalos también a ellos y muéstranos así tu gloria,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "para que reconozcan, como reconocemos nosotros,",
          "que no hay Dios fuera de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Renueva tus prodigios, repite tus maravillas,",
          "muestra tu gloria y el poder de tu brazo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Haz que se encienda tu ira, y descarga tu enojo,",
          "y humilla y dispersa a nuestros enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Haz que llegue pronto el momento señalado,",
          "pues nadie puede pedirte cuentas de lo que haces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Destroza al jefe de los enemigos,",
          "que dice: «No hay nadie igual a mí.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Reúne a todas las tribus de Jacob,",
          "para que se establezcan en su tierra como antiguamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ten piedad del pueblo que lleva tu nombre,",
          "de Israel, a quien escogiste como a un primer hijo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ten piedad de tu santa ciudad,",
          "de Jerusalén, el lugar donde tú vives."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Llena a Sión de tu majestad,",
          "llena tu templo con tu gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Son las primeras cosas que creaste; muéstrate a favor de ellas",
          "y haz que se cumplan las profecías dichas en tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Da el premio a los que esperan en ti,",
          "demuestra que tus profetas dijeron la verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Escucha las oraciones de tus siervos,",
          "según el amor que tienes a tu pueblo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "y que se sepa en todos los rincones de la tierra",
          "que tú eres Dios del universo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hay que escoger lo mejor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "La garganta puede pasar cualquier alimento,",
          "pero hay unos alimentos más sabrosos que otros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El paladar distingue los sabores,",
          "y la inteligencia distingue las mentiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Una mente malvada causa sufrimientos,",
          "pero el hombre fuerte se los devuelve."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "La mujer acepta a cualquiera como esposo,",
          "pero hay mujeres más bonitas que otras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ver una mujer bella es un placer,",
          "no hay nada más agradable;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "y si además es afable en su conversación,",
          "su marido no tiene igual entre los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "El que obtiene esposa comienza a hacer fortuna,",
          "y tiene ayuda, protección y apoyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Un viñedo sin cerca es saqueado,",
          "y un hombre sin esposa anda de un lugar a otro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¿Quién confía en una banda de gente armada",
          "que va de ciudad en ciudad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Así es el hombre que no tiene nido,",
          "que descansa donde la noche lo sorprende."
        ],
        "rlw_lines": []
      }
    ]
  },
