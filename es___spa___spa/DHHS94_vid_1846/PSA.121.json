    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El Señor es tu protector"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1a (1a) Cántico de las subidas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Al contemplar las montañas me pregunto:",
          "«¿De dónde vendrá mi ayuda?»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi ayuda vendrá del Señor,",
          "creador del cielo y de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Nunca permitirá que resbales!",
          "¡Nunca se dormirá el que te cuida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No, él nunca duerme;",
          "nunca duerme el que cuida de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El Señor es quien te cuida;",
          "el Señor es quien te protege,",
          "quien está junto a ti para ayudarte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El sol no te hará daño de día,",
          "ni la luna de noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El Señor te protege de todo peligro;",
          "él protege tu vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El Señor te protege en todos tus caminos,",
          "ahora y siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
