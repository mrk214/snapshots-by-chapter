    "name": "Job"
  },
  "chapter": {
    "usfm": "JOB.19",
    "human": "Job 19",
    "previous": {
      "usfm": "JOB.18",
      "human": "Job 18"
    },
    "next": {
      "usfm": "JOB.20",
