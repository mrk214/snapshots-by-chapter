    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Las bendiciones del Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1a (1a) Cántico de las subidas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (1b) Feliz tú, que honras al Señor",
          "y le eres obediente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Comerás del fruto de tu trabajo,",
          "serás feliz y te irá bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "En la intimidad de tu hogar,",
          "tu mujer será como una vid cargada de uvas;",
          "tus hijos, alrededor de tu mesa,",
          "serán como retoños de olivo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Así bendecirá el Señor al hombre que lo honra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Que el Señor te bendiga desde el monte Sión!",
          "¡Que veas el bienestar de Jerusalén",
          "todos los días de tu vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Que llegues a ver a tus nietos!",
          "¡Que haya paz en Israel!"
        ],
        "rlw_lines": []
      }
    ]
  },
