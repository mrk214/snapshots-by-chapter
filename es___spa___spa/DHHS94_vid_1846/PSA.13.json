        "lines": [
          "Oración pidiendo ayuda"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1 (1) Del maestro de coro. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "1 (2) Señor,",
          "¿hasta cuándo me olvidarás?",
          "¿Me olvidarás para siempre?",
          "¿Hasta cuándo te esconderás de mí?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "2 (3) ¿Hasta cuándo mi alma y mi corazón",
          "habrán de sufrir y estar tristes todo el día?",
          "¿Hasta cuándo habré de estar sometido al enemigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "3 (4) Señor, Dios mío,",
          "¡mírame, respóndeme, llena mis ojos de luz!",
          "¡Que no caiga yo en el sueño de la muerte!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "4 (5) ¡Que no diga mi enemigo: «Lo he vencido»!",
          "¡Que no se alegre si yo fracaso!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "5 (6a) Yo confío en tu amor;",
          "mi corazón se alegra porque tú me salvas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "6 (6b) ¡Cantaré al Señor por el bien que me ha hecho!"
        ],
        "rlw_lines": []
      }
    ]
