{"version":{"version_id":1846,"local_abbreviation":"DHHS94","local_title":"Dios habla Hoy Estándar","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Bible text: LA BIBLIA DIOS HABLA HOY, Tercera edición © Sociedades Bíblicas Unidas 1966, 1970, 1979, 1983, 1994, 1996</p> <p>Todos los derechos reservados. www.unitedbiblesocieties.org/</p>","text":"Bible text: LA BIBLIA DIOS HABLA HOY, Tercera edición © Sociedades Bíblicas Unidas 1966, 1970, 1979, 1983, 1994, 1996 Todos los derechos reservados. www.unitedbiblesocieties.org/"}},"book":{"book_usfm":"SNG","name":"Cantares"},"chapter":{"chapter_usfm":"SNG.5","is_chapter":true,"previous":{"usfm":"SNG.4","human":"Cantares 4","canonical":true,"toc":true},"current":{"usfm":"SNG.5","human":"Cantares 5"},"next":{"usfm":"SNG.6","human":"Cantares 6","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Él"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Ya he entrado en mi jardín,","hermanita, novia mía.","Ya he tomado mi mirra y mis perfumes,","ya he probado la miel de mi panal,","ya he bebido mi vino y mi leche."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Coro"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Queridos amigos,","coman y beban,","¡beban todo lo que quieran!"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Cuarto canto"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Ella"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Yo dormía, pero no mi corazón.","Y oí que mi amado llamaba a la puerta:","«¡Ábreme, amor mío;","hermanita,","palomita virginal!","¡Mi cabeza está empapada de rocío!","¡El rocío nocturno me corre por el cabello!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["«Ya me he quitado la ropa;","¡tendría que volver a vestirme!","Ya me he lavado los pies;","¡se me volverían a llenar de polvo!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Mi amado metió la mano","por el agujero de la puerta.","¡Eso me conmovió profundamente!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5,6],"lines":["Entonces me levanté","para abrirle a mi amado.","De mis manos y mis dedos","cayeron gotitas de mirra","sobre el pasador de la puerta.","¡Al oírlo hablar","sentí que me moría!","Abrí la puerta a mi amado,","pero él ya no estaba allí.","Lo busqué y no lo encontré,","lo llamé y no me respondió."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Me encontraron los guardias","que hacen la ronda de la ciudad;","me golpearon, me hirieron;","¡los que cuidan la entrada de la ciudad","me arrancaron el velo con violencia!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Mujeres de Jerusalén,","si encuentran a mi amado,","prométanme decirle","que me estoy muriendo de amor."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Coro"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["¿Qué de especial tiene tu amado,","hermosa entre las hermosas?","¿Qué de especial tiene tu amado","que nos pides hacerte tal promesa?"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Ella"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Mi amado es trigueño claro,","inconfundible entre miles de hombres."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Su cabeza es oro puro;","su cabello es ondulado","y negro como un cuervo;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["sus ojos son dos palomas bañadas en leche,","posadas junto a un estanque;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["sus mejillas son amplios jardines","de fragantes flores.","Sus labios son rosas","por las que ruedan gotitas de mirra;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["sus manos son abrazaderas de oro cubiertas de topacios;","su cuerpo es pulido marfil","con incrustaciones de zafiros;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["sus piernas son columnas de mármol","afirmadas sobre bases de oro puro;","su aspecto es distinguido","como los cedros del Líbano;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["su paladar es dulcísimo.","¡Todo él es un encanto!","Así es mi amado,","así es el amor mío,","mujeres de Jerusalén."],"rlw_lines":[]}]}}