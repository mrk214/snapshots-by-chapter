    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración por victoria y prosperidad"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bendito sea el SEÑOR, mi roca,",
          "quien adiestra mis manos para la batalla",
          "y mis dedos para la guerra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Misericordia mía y castillo mío;",
          "mi refugio y mi libertador;",
          "mi escudo en quien he confiado;",
          "el que sujeta los pueblos debajo de mí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Oh SEÑOR, ¿qué es el hombre para que pienses en él?",
          "¿Qué es el hijo del hombre para que lo estimes?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El hombre es semejante a un soplo;",
          "sus días son como la sombra que pasa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Oh SEÑOR, inclina tus cielos y desciende;",
          "toca las montañas y humeen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Despide relámpagos y dispérsalos;",
          "envía flechas y túrbalos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Extiende tu mano desde lo alto,",
          "rescátame y líbrame de las aguas caudalosas,",
          "de la mano de los hombres extranjeros"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "cuya boca habla vanidad",
          "y cuya derecha es mano de mentira."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Oh Dios, a ti cantaré un cántico nuevo;",
          "te cantaré con arpa de diez cuerdas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tú eres el que da victoria a los reyes,",
          "el que rescata a su siervo David",
          "de la maligna espada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Rescátame y líbrame",
          "de la mano de los hombres extranjeros",
          "cuya boca habla vanidad",
          "y cuya derecha es mano de mentira."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Nuestros hijos sean como plantas crecidas en su juventud, y nuestras hijas como columnas labradas de las esquinas de un palacio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Nuestros graneros estén llenos,",
          "proveyendo toda clase de grano;",
          "nuestros rebaños se multipliquen en nuestros campos",
          "por millares y decenas de millares,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "y nuestras vacas estén cargadas de crías.",
          "¡Que no haya muerte ni aborto",
          "ni gemido en nuestras plazas!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Bienaventurado el pueblo al cual así le sucede.",
          "¡Bienaventurado el pueblo cuyo Dios es el SEÑOR!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
