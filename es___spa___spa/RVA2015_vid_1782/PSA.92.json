    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La dulzura de la alabanza"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo. Cántico para el día sábado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bueno es alabar al SEÑOR,",
          "cantar salmos a tu nombre, oh Altísimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bueno es anunciar por la mañana tu misericordia",
          "y tu verdad en las noches"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "con el arpa de diez cuerdas y la lira,",
          "con el tono suave del arpa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ciertamente me has alegrado, oh SEÑOR, con tus hechos;",
          "grito de gozo por las obras de tus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Cuán grandes son tus obras, oh SEÑOR!",
          "Muy profundos son tus pensamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El hombre necio no sabe,",
          "y el insensato no entiende esto:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "que los impíos brotan como la hierba,",
          "y que todos los que hacen iniquidad",
          "florecen para ser destruidos para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pero tú, oh SEÑOR,",
          "para siempre eres el Altísimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque he aquí tus enemigos, oh SEÑOR;",
          "porque he aquí, tus enemigos perecerán.",
          "Serán dispersados todos los que hacen iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pero tú enaltecerás mi poder como el de un toro salvaje,",
          "y sobre mí verterás aceite fresco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mis ojos mirarán sobre mis enemigos;",
          "mis oídos oirán de los malhechores",
          "que se levantaron contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El justo florecerá como",
          "la palmera;",
          "crecerá alto como el cedro en el Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Plantados estarán en la casa",
          "del SEÑOR;",
          "florecerán en los atrios de nuestro Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Aun en la vejez fructificarán.",
          "Estarán llenos de savia y frondosos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "para anunciar que el SEÑOR, mi roca, es recto",
          "y que en él no hay injusticia."
        ],
        "rlw_lines": []
      }
    ]
  },
