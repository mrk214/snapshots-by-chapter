    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Las obras y la palabra de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Los cielos cuentan la gloria de Dios,",
          "y el firmamento anuncia la obra de sus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Un día comunica su mensaje al otro día,",
          "y una noche a la otra declara sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No es un lenguaje de palabras",
          "ni se escucha su voz;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "pero por toda la tierra salió su voz",
          "y hasta el extremo del mundo sus palabras.",
          "En ellos puso un tabernáculo para el sol;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "y este, como un novio que sale de su dosel,",
          "se alegra como un valiente que emprende la carrera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "En un extremo del cielo está su salida,",
          "y en el otro está su punto de retorno.",
          "¡Nada hay que se esconda de su calor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "La ley del SEÑOR es perfecta;",
          "restaura el alma.",
          "El testimonio del SEÑOR es fiel;",
          "hace sabio al ingenuo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los preceptos del SEÑOR son rectos;",
          "alegran el corazón.",
          "El mandamiento del SEÑOR es puro;",
          "alumbra los ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El temor del SEÑOR es limpio;",
          "permanece para siempre.",
          "Los juicios del SEÑOR son verdad;",
          "son todos justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Son más deseables que el oro;",
          "más que mucho oro fino.",
          "Son más dulces que la miel que destila del panal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Además, con ellos es amonestado tu siervo;",
          "en guardarlos hay grande galardón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Quién entenderá los errores?",
          "¡Líbrame de los que me son ocultos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Asimismo, guarda a tu siervo de los arrogantes;",
          "que ellos no se enseñoreen de mí.",
          "Entonces seré íntegro y limpio de gran rebelión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sean gratos los dichos de mi boca",
          "y la meditación de mi corazón",
          "delante de ti, oh SEÑOR,",
          "Roca mía y Redentor mío."
        ],
        "rlw_lines": []
      }
    ]
  },
