    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Recuerdos de la salida de Egipto"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cuando Israel salió de Egipto,",
          "la casa de Jacob de un pueblo extranjero,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Judá fue su santuario",
          "e Israel su señorío."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El mar lo vio y huyó;",
          "el Jordán se volvió atrás."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Los montes brincaron como carneros",
          "y las colinas como corderitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Qué tuviste, oh mar, para que huyeras?",
          "¿Y tú, oh Jordán, para que te volvieras atrás?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Oh montes, ¿por qué brincaron como carneros;",
          "y ustedes, oh colinas, como corderitos?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ante la presencia del SEÑOR tiembla la tierra;",
          "ante la presencia del Dios de Jacob"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "quien convirtió la peña en estanque de aguas",
          "y el pedernal en manantial de aguas."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
