    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR, refugio del justo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En el SEÑOR me he refugiado.",
          "¿Por qué, pues, dicen a mi alma:",
          "“Escapa cual pájaro al monte”?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pues he aquí, los impíos han",
          "preparado su arco, y han",
          "colocado las flechas en la cuerda",
          "para atravesar en oculto a los",
          "rectos de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Si son destruidos los fundamentos,",
          "¿qué podrá hacer el justo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El SEÑOR está en su santo templo;",
          "el SEÑOR tiene su trono en los cielos.",
          "Sus ojos ven;",
          "sus párpados examinan a los hijos del hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El SEÑOR prueba al justo,",
          "pero su alma aborrece al impío",
          "y al que ama la violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sobre los impíos hará llover brasas;",
          "fuego, azufre y vientos huracanados",
          "serán la porción de la copa de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque el SEÑOR es justo y ama la justicia;",
          "los rectos contemplarán su rostro."
        ],
        "rlw_lines": []
      }
    ]
  },
