    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza al Rey y Juez del universo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Canten al SEÑOR un cántico nuevo!",
          "¡Canten al SEÑOR, toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Canten al SEÑOR; bendigan su nombre.",
          "Anuncien de día en día su salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cuenten entre las naciones su gloria,",
          "entre todos los pueblos sus maravillas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "porque grande es el SEÑOR",
          "y digno de suprema alabanza.",
          "Él es temible sobre todos los dioses;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "porque todos los dioses de los pueblos son ídolos",
          "pero el SEÑOR hizo los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Gloria y esplendor hay delante de él;",
          "poder y hermosura hay en su santuario."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Den al SEÑOR, oh familias de pueblos,",
          "den al SEÑOR la gloria y el poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Den al SEÑOR la gloria debida a su nombre;",
          "traigan ofrendas y vengan a sus atrios;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "adoren al SEÑOR en la hermosura de la santidad;",
          "tiemble ante su presencia toda la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Digan entre las naciones:",
          "“¡El SEÑOR reina!",
          "Ciertamente ha afirmado el mundo",
          "y no será movido.",
          "Juzgará a los pueblos con rectitud”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Alégrense los cielos, y gócese la tierra!",
          "¡Ruja el mar y su plenitud!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡Regocíjese el campo",
          "y todo lo que hay en él!",
          "Entonces cantarán con júbilo",
          "todos los árboles del bosque"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "delante del SEÑOR, pues él viene.",
          "Porque él viene para juzgar la tierra.",
          "Juzgará al mundo con justicia",
          "y a los pueblos con su verdad."
        ],
        "rlw_lines": []
      }
    ]
  },
