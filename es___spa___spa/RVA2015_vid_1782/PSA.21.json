    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR da vida y liberación"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Oh SEÑOR, el rey se alegra en tu poder!",
          "¡Cuánto se goza en tu salvación!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Le has concedido el deseo de su corazón",
          "y no le has negado la petición de sus labios.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Le has salido al encuentro con las mejores bendiciones;",
          "corona de oro fino has puesto sobre su cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Te pidió vida, y se la concediste;",
          "vida extensa, eternamente y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Gloria grande halla en tu liberación;",
          "honra y esplendor has puesto sobre él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque le has dado bendiciones para siempre",
          "y le has colmado con la alegría de tu rostro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Por eso el rey confía en el SEÑOR;",
          "por la misericordia del Altísimo no será removido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tu mano alcanzará a todos tus enemigos;",
          "tu diestra alcanzará a los que te aborrecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los pondrás como horno de fuego",
          "en el tiempo en que te presentes.",
          "El SEÑOR los destruirá en su furor,",
          "y el fuego los consumirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Destruirás el fruto de ellos en la tierra;",
          "sus descendientes de entre los hijos del hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque se volvieron contra ti para hacerte daño;",
          "idearon maquinaciones pero no prevalecerán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "En la cuerda de tu arco alistarás las flechas contra la cara de ellos;",
          "ciertamente les harás volver la espalda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Enaltécete, oh SEÑOR, con tu poder!",
          "Cantaremos y alabaremos tu poderío."
        ],
        "rlw_lines": []
      }
    ]
  },
