    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Canción festiva"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Guitit. Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Canten con gozo a Dios, fortaleza nuestra!",
          "Aclamen con júbilo al Dios de Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Entonen himnos y toquen el tamboril,",
          "la suave lira y el arpa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Toquen la corneta en luna nueva;",
          "en luna llena por nuestra solemnidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque estatuto es de Israel,",
          "ordenanza del Dios de Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "En José lo instituyó por testimonio",
          "cuando salió contra la tierra de Egipto.",
          "Escuché un idioma que no conocía:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Aparté su hombro de debajo de la carga;",
          "sus manos fueron apartadas del peso de los cestos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Clamaste en la calamidad, y yo te libré.",
          "Te respondí en lo oculto del trueno.",
          "Te probé junto a las aguas de Meriba. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Escucha, oh pueblo mío,",
          "y testificaré contra ti.",
          "¡Oh Israel, si me oyeras…!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No haya dios extraño en medio de ti",
          "ni te postres ante dios extranjero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Yo soy el SEÑOR tu Dios,",
          "que te hice venir de la tierra de Egipto.",
          "Abre bien tu boca, y la llenaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Pero mi pueblo no escuchó mi voz;",
          "Israel no me quiso a mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por eso los entregué a la dureza de su corazón,",
          "y caminaron según sus propios consejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Oh, si mi pueblo me hubiera escuchado;",
          "si Israel hubiera andado en mis caminos…!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "En un instante habría yo sometido a sus enemigos",
          "y habría vuelto mi mano contra sus adversarios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los que aborrecen al SEÑOR se le habrían sometido,",
          "y su castigo habría sido eterno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los habría sustentado con la suculencia del trigo;",
          "con miel de la roca te habría saciado”."
        ],
        "rlw_lines": []
      }
    ]
  },
