    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Recuerdos del éxodo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Para Jedutún. Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mi voz elevo a Dios y clamo;",
          "mi voz elevo a Dios y él me escucha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Al Señor busco en el día de mi angustia.",
          "Sin cesar extiendo a él mis manos en la noche;",
          "mi alma rehúsa el consuelo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Me acuerdo de Dios y gimo;",
          "medito y mi espíritu desfallece.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tú retienes los párpados de mis ojos;",
          "estoy turbado y no puedo hablar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Considero los días de antaño,",
          "los años antiguos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Recuerdo mi canto en la noche.",
          "Medito en mi corazón",
          "y mi espíritu investiga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¿Acaso nos desechará el Señor para siempre?",
          "¿Ya no volverá a ser propicio?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¿Se ha agotado para siempre su misericordia?",
          "¿Se han acabado sus promesas por generación y generación?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Se ha olvidado de ser clemente?",
          "¿En su ira ha cerrado su compasión? Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Y pienso: Mi tristeza es que haya cambio",
          "en la diestra del Altísimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Me acuerdo de las obras del SEÑOR;",
          "sí, me acuerdo de tus maravillas del pasado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Medito en todos tus hechos,",
          "y reflexiono en tus actos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Oh Dios, santo es tu camino.",
          "¿Qué Dios es grande como nuestro Dios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tú eres un Dios que hace maravillas;",
          "has hecho conocer tu poder entre los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Con tu brazo has redimido a tu pueblo,",
          "a los hijos de Jacob y de José.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Las aguas te vieron, oh Dios;",
          "las aguas te vieron y temblaron.",
          "Se estremecieron los abismos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los nubarrones vertieron sus aguas,",
          "tronaron las nubes,",
          "también se desplazaron tus rayos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El tronar de tu voz estaba en el torbellino;",
          "los relámpagos alumbraron al mundo;",
          "la tierra se estremeció y tembló."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Tu camino estaba en el mar,",
          "y tu sendero en las caudalosas aguas.",
          "Pero tus huellas nadie las pudo conocer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Como a un rebaño has conducido a tu pueblo",
          "por medio de Moisés y de Aarón."
        ],
        "rlw_lines": []
      }
    ]
  },
