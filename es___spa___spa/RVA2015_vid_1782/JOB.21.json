    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Job responde a Zofar"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces respondió Job y dijo:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "—Escuchen atentamente mis palabras;",
          "sea esto su consolación."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sopórtenme, y yo hablaré;",
          "y después de que yo haya hablado, búrlense."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "»¿Acaso me quejo ante algún hombre? ¿Por qué no se ha de impacientar",
          "mi espíritu?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Vuelvan la cara hacia mí y horrorícense; pongan la mano sobre la boca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Aun cuando recuerdo, me espanto;",
          "y el estremecimiento se apodera",
          "de mi carne."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»¿Por qué viven los impíos",
          "y se envejecen,",
          "y además crecen en riquezas?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sus descendientes se establecen delante de ellos;",
          "sus vástagos permanecen ante sus ojos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Sus casas están libres de temor,",
          "y sobre ellos no está el azote de Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Su toro fecunda sin fallar;",
          "sus vacas paren y no pierden crías."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Sus pequeños salen como si",
          "fueran manada;",
          "sus niños van danzando."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Cantan al son del tamboril y del arpa;",
          "se regocijan al son de la flauta."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pasan sus días en la prosperidad,",
          "y con tranquilidad descienden al Seol."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Luego dicen a Dios:",
          "“¡Apártate de nosotros!",
          "No queremos el conocimiento de tus caminos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¿Quién es el Todopoderoso para que le sirvamos?",
          "¿De qué nos aprovechará que oremos ante él?”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "He aquí que la prosperidad de ellos",
          "no está en sus propias manos. ¡Lejos esté de mí el consejo de",
          "los impíos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "»¿Cuántas veces es apagada la lámpara de los impíos,",
          "o viene sobre ellos la calamidad,",
          "o Dios en su ira les reparte destrucción?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Son como la paja ante el viento,",
          "o como el tamo que arrebata el huracán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "»¿Acumulará Dios castigo para sus hijos?",
          "¡Séale dada a él retribución para que aprenda!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Que sus propios ojos vean su ruina,",
          "y beba de la ira del Todopoderoso!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Porque, ¿qué deleite tendrá él en su",
          "familia después de morir,",
          "cuando el número de sus meses ha llegado a su fin?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¿Acaso se le enseñará sabiduría a Dios, siendo que él es quien juzga",
          "aun a los que están en lo alto?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "»Uno muere en pleno vigor,",
          "estando del todo confiado y tranquilo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "con sus lomos llenos de gordura",
          "y sus huesos repletos de tuétano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Y otro muere con el alma amargada sin haber comido jamás con gusto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Pero ambos yacen en el polvo,",
          "y los gusanos los cubren."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "»He aquí, yo conozco los pensamientos de ustedes",
          "y las intrigas que hacen contra mí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Porque dicen: “¿Dónde está la casa del noble?",
          "¿Dónde está la morada que cobijaba",
          "a los impíos?”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¿No han preguntado a los que pasan por el camino?",
          "¿No han reconocido sus indicaciones"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "de que el malo es preservado en el día de la calamidad",
          "y que será conducido en el día de la ira?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "¿Quién le denuncia su camino ante",
          "su misma cara?",
          "¿Quién le da su merecido por lo que",
          "ha hecho?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Pero él será conducido al sepulcro,",
          "y sobre su túmulo se hará vigilancia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Los terrones del valle le serán dulces; detrás de él será arrastrado todo hombre, y delante de él los habrá innumerables."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "¿Cómo, pues, me consuelan con palabras huecas?",
          "De las respuestas de ustedes solo queda el engaño."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
