    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza al Salvador universal"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Con Neguinot. Salmo y cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios tenga misericordia de nosotros y nos bendiga.",
          "Haga resplandecer su rostro sobre nosotros; Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "para que sea reconocido en la tierra tu camino",
          "y en todas las naciones",
          "tu salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Los pueblos te alaben, oh Dios!",
          "¡Todos los pueblos te alaben!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alégrense y gócense las naciones",
          "porque tú juzgarás a los pueblos con equidad",
          "y guiarás a las naciones de",
          "la tierra. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Los pueblos te alaben, oh Dios!",
          "¡Todos los pueblos te alaben!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "La tierra dará su fruto;",
          "nos bendecirá Dios, el Dios nuestro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios nos bendiga,",
          "y témanlo todos los confines de la tierra."
        ],
        "rlw_lines": []
      }
    ]
