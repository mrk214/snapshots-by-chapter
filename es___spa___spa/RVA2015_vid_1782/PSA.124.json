    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Gratitud por las pruebas superadas"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1 Canto de ascenso gradual. De David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Si el SEÑOR no hubiera estado por nosotros”,",
          "dígalo, por favor, Israel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“si el SEÑOR no hubiera estado por nosotros",
          "cuando se levantaron contra nosotros los hombres,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "entonces nos habrían tragado vivos",
          "cuando se encendió su furor contra nosotros;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "entonces las aguas nos habrían inundado;",
          "el torrente habría pasado sobre nosotros;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "entonces las aguas tumultuosas",
          "habrían pasado sobre nosotros”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Bendito sea el SEÑOR,",
          "que no nos entregó como presa a los dientes de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nuestra alma escapó como un pájaro",
          "de la trampa de los cazadores.",
          "Se rompió la trampa, y nosotros escapamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Nuestro socorro está en el nombre del SEÑOR,",
          "que hizo los cielos y la tierra."
        ],
        "rlw_lines": []
      }
    ]
  },
