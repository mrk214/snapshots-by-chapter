    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria en medio de la aflicción"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de los hijos de Coré. Al músico principal. Sobre Majalat. Para ser cantado. Masquil de Hemán el ezrajita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, Dios de mi salvación,",
          "día y noche clamo delante de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Llegue mi oración a tu presencia;",
          "inclina tu oído a mi clamor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "porque mi alma está harta de males",
          "y mi vida se ha acercado al Seol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Soy contado con los que descienden a la fosa;",
          "soy como un hombre sin fuerzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Estoy libre entre los muertos,",
          "como los cadáveres que yacen en la tumba,",
          "de quienes ya no te acuerdas,",
          "y que han sido arrebatados de tu mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Me has puesto en la honda fosa,",
          "en lugares tenebrosos, en lugares profundos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sobre mí reposa tu ira;",
          "me has afligido con todas tus olas.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Has alejado de mí a mis conocidos;",
          "me has puesto como abominación para ellos.",
          "Estoy encerrado; no puedo salir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mis ojos se enfermaron a causa de mi aflicción.",
          "Cada día te he invocado, oh SEÑOR;",
          "a ti he extendido mis manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Acaso harás milagros para los muertos?",
          "¿Se levantarán los muertos para alabarte? Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Se contará en el sepulcro acerca de tu misericordia,",
          "o de tu verdad en el Abadón?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Será conocida en las tinieblas tu maravilla,",
          "y tu justicia en la tierra del olvido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pero a ti he invocado, oh SEÑOR;",
          "de mañana sale a tu encuentro mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¿Por qué desechas mi alma, oh SEÑOR?",
          "¿Por qué escondes de mí tu rostro?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Yo estoy pobre y abatido;",
          "desde mi infancia he cargado tus terrores.",
          "¡Ya no puedo más!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Sobre mí ha pasado tu ira;",
          "tus terrores me han destruido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "De continuo me han rodeado como inundación",
          "y, al mismo tiempo, me han cercado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Has alejado de mí a mis amigos y compañeros;",
          "solo las tinieblas son mi compañía."
        ],
        "rlw_lines": []
      }
    ]
  },
