    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Canción para las bodas del rey"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Sosanima. Para los hijos de Coré. Masquilb. Canción de amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mi corazón rebosa de palabras buenas; dedico al rey mi canto.",
          "Mi lengua es como pluma de un veloz escriba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tú eres el más hermoso de los hijos del hombre;",
          "la gracia se ha derramado en tus labios.",
          "Por eso Dios te ha bendecido para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ciñe tu espada sobre tu muslo, oh valiente, en tu gloria y majestad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En tu majestad cabalga y triunfa por causa de la verdad, de la humildad y de la justicia.",
          "Tu mano derecha te mostrará cosas asombrosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pueblos caerán debajo de ti;",
          "tus flechas agudas penetrarán en el corazón de los enemigos del rey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tu trono, oh Dios, es eterno y para siempre;",
          "cetro de justicia es el cetro de tu reino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Has amado la justicia y aborrecido la injusticia;",
          "por eso te ha ungido Dios, el Dios tuyo,",
          "con aceite de gozo, más que a tus compañeros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mirra, áloe y casia exhalan todas tus vestiduras;",
          "en palacios de marfil te han recreado los instrumentos de cuerda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Hijas de reyes hay en tu corte de honor;",
          "la reina está de pie a tu derecha con oro de Ofir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Oye, hija, y mira; inclina tu oído:",
          "Olvida tu pueblo y la casa de tu padre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El rey desea tu hermosura;",
          "inclínate hacia él porque él es tu señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Las hijas de Tiro vienen con presentes,",
          "y los ricos del pueblo imploran tu favor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Toda gloriosa está la hija del rey;",
          "de perlas engastadas en oro es su vestido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Con vestido bordado será llevada ante el rey.",
          "Vírgenes irán detrás de ella;",
          "sus compañeras serán traídas a ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Serán traídas con alegría y con gozo,",
          "y entrarán en el palacio del rey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "En lugar de tus padres estarán tus hijos",
          "a quienes harás príncipes en toda la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Haré perpetua la memoria de tu nombre",
          "en todas las generaciones,",
          "por lo cual te alabarán los pueblos",
          "eternamente y para siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
