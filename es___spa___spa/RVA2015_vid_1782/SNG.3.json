    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "De noche, sobre mi cama",
          "buscaba al que ama mi alma.",
          "Lo busqué, pero no lo hallé."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pensé: “Me levantaré e iré por la ciudad,",
          "por las calles y las plazas,",
          "buscando al que ama mi alma”.",
          "Lo busqué, pero no lo hallé."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Me encontré con los guardias que rondan la ciudad y les pregunté:",
          "“¿Han visto al que ama mi alma?”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tan pronto como pasé de allí,",
          "hallé al que ama mi alma.",
          "Me prendí de él y no lo solté",
          "hasta que lo traje a la casa de mi madre,",
          "a la habitación de la que me concibió."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Júrenme, oh hijas de Jerusalén,",
          "por las ciervas",
          "y por las gacelas del campo,",
          "que no despertarán",
          "ni provocarán el amor",
          "hasta que quiera!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El cortejo nupcial"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿Quién es aquella",
          "que viene del desierto",
          "como columna de humo,",
          "perfumada con mirra, incienso",
          "y todo polvo de mercader?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Miren! Es la litera de Salomón.",
          "Sesenta valientes la rodean,",
          "de los más fuertes de Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Todos ellos ciñen espadas",
          "y son diestros en la guerra.",
          "Cada uno lleva espada al cinto",
          "por causa de los temores de la noche."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El rey Salomón se hizo una carroza",
          "de madera del Líbano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Sus columnas eran de plata,",
          "su respaldo de oro,",
          "su asiento de púrpura;",
          "y su interior fue decorado con amor",
          "por las hijas de Jerusalén."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Salgan, oh hijas de Sion,",
          "y vean al rey Salomón con la diadema con que lo ciñó su madre",
          "en el día de sus bodas,",
          "el día en que se regocijó su corazón."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
