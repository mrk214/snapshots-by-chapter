    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR: el buen pastor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El SEÑOR es mi pastor;",
          "nada me faltará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En prados de tiernos pastos",
          "me hace descansar.",
          "Junto a aguas tranquilas me conduce."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Confortará mi alma",
          "y me guiará por sendas de justicia",
          "por amor de su nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Aunque ande en valle de sombra de muerte",
          "no temeré mal alguno,",
          "porque tú estarás conmigo.",
          "Tu vara y tu cayado me infundirán aliento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Preparas mesa delante de mí",
          "en presencia de mis adversarios.",
          "Unges mi cabeza con aceite;",
          "mi copa está rebosando."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ciertamente el bien y la misericordia",
          "me seguirán todos los días de mi vida,",
          "y en la casa del SEÑOR",
          "moraré por días sin fin."
        ],
        "rlw_lines": []
      }
    ]
  },
