    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración por la paz y la justicia"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Para los hijos de Coré. Salmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, has sido propicio a tu tierra,",
          "has restaurado a Jacob de la cautividad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Has perdonado la iniquidad de tu pueblo;",
          "has cubierto todos sus pecados. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Has dejado todo tu enojo;",
          "has desistido del ardor de tu ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Restáuranos, oh Dios de nuestra salvación;",
          "haz cesar tu ira contra nosotros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Estarás airado con nosotros para siempre?",
          "¿Extenderás tu ira de generación en generación?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿No volverás a darnos vida",
          "de modo que tu pueblo se alegre en ti?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Muéstranos, oh SEÑOR, tu misericordia",
          "y concédenos tu salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Escucharé lo que hable el SEÑOR Dios;",
          "pues él hablará paz a su pueblo y a sus fieles",
          "para que no se vuelvan a la locura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ciertamente cercana está su salvación",
          "para los que le temen,",
          "para que habite la gloria en nuestra tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "La misericordia y la verdad se encontraron;",
          "la justicia y la paz se besaron."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "La verdad brotará de la tierra,",
          "y la justicia mirará desde los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Asimismo, el SEÑOR dará el bien,",
          "y nuestra tierra dará su fruto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La justicia irá delante de él",
          "y hará de sus pasos un camino."
        ],
        "rlw_lines": []
      }
    ]
  },
