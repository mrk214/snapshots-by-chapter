    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Otros proverbios de Salomón"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "También estos son proverbios de Salomón, los cuales copiaron los hombres de Ezequías, rey de Judá:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Es gloria de Dios ocultar una cosa,",
          "y es gloria del rey escudriñarla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "La altura de los cielos,",
          "la profundidad de la tierra",
          "y el corazón de los reyes",
          "son inescrutables."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Quita las escorias de la plata,",
          "y saldrá un objeto para el fundidor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quita al impío de la presencia del rey,",
          "y su trono se afirmará con justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No te vanaglories delante del rey",
          "ni te entremetas en el lugar de los grandes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "porque mejor es que se te diga: “Sube acá”,",
          "antes que seas humillado delante del noble.",
          "Cuando tus ojos hayan visto algo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "no entres apresuradamente en pleito. Porque, ¿qué más harás al final cuando tu prójimo te haya",
          "avergonzado?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Discute tu causa con tu prójimo",
          "y no des a conocer el secreto de otro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No sea que te deshonre el que te oye,",
          "y tu infamia no pueda ser reparada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Manzana de oro con adornos de plata",
          "es la palabra dicha oportunamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Como zarcillo de oro y joya de oro fino es el que reprende al sabio que tiene oído dócil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Como el frescor de la nieve en tiempo de siega",
          "es el mensajero fiel a los que lo envían, pues da refrigerio al alma de su señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Como nubes y vientos sin lluvia, así es el hombre que se jacta de un",
          "regalo que al fin no da."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Con larga paciencia se persuade al jefe,",
          "y la lengua blanda quebranta los huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¿Hallaste miel? Come solo lo suficiente, no sea que te hartes de ella",
          "y la vomites."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Detén tu pie de la casa de tu vecino,",
          "no sea que se harte de ti y te aborrezca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Mazo, espada y flecha dentada",
          "es el hombre que da falso testimonio contra su prójimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Diente quebrado y pie que resbala",
          "es la confianza en el traicionero,",
          "en el día de angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El que canta canciones al corazón afligido",
          "es como el que quita la ropa en tiempo de frío",
          "o el que echa vinagre sobre el jabón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Si tu enemigo tiene hambre",
          "dale de comer pan;",
          "y si tiene sed",
          "dale de beber agua;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "pues así carbones encendidos tú amontonas sobre su cabeza,",
          "y el SEÑOR te recompensará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El viento del norte trae la lluvia;",
          "y la lengua detractora el rostro airado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Mejor es vivir en un rincón de la azotea que compartir una casa con una mujer rencillosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Como el agua fría al alma sedienta, así son las buenas nuevas de",
          "lejanas tierras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Como manantial turbio y fuente corrompida",
          "es el justo que vacila ante el impío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Comer mucha miel no es bueno",
          "ni es gloria buscar la propia gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Como una ciudad cuya muralla ha sido derribada,",
          "es el hombre cuyo espíritu",
          "no tiene freno."
        ],
        "rlw_lines": []
      }
    ]
  },
