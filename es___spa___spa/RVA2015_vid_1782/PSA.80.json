    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica por la restauración"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Sosanim. Testimonio. Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Oh Pastor de Israel, escucha,",
          "tú que conduces a José como a un rebaño!",
          "¡Tú, que estás entre los querubines,",
          "resplandece"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "delante de Efraín, de Benjamín y de Manasés!",
          "Despierta tu poderío y ven para salvarnos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Oh Dios, ¡restáuranos!",
          "Haz resplandecer tu rostro,",
          "y seremos salvos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "SEÑOR Dios de los Ejércitos,",
          "¿hasta cuándo has de mostrar tu indignación",
          "contra la oración de tu pueblo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Nos has dado a comer pan de lágrimas.",
          "Nos has dado a beber lágrimas en abundancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Nos has puesto por escarnio a nuestros vecinos;",
          "nuestros enemigos se mofan de nosotros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Oh Dios de los Ejércitos, ¡restáuranos!",
          "Haz resplandecer tu rostro,",
          "y seremos salvos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Trajiste una vid de Egipto;",
          "echaste a las naciones y la plantaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Limpiaste el lugar delante de ella.",
          "Hiciste que echara raíz, y llenó la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los montes fueron cubiertos por su sombra,",
          "y sus ramas llegaron a ser como cedros de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Extendió sus ramas hasta el mar,",
          "y hasta el Río sus renuevos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Por qué has roto sus cercas",
          "de modo que la vendimien todos los que pasan por el camino?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "El jabalí salvaje la devasta;",
          "las criaturas del campo se alimentan de ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Oh Dios de los Ejércitos, vuelve, por favor;",
          "mira desde el cielo, considera y visita esta viña,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "la cepa que plantó tu diestra;",
          "el hijo que fortaleciste para ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Está quemada con fuego;",
          "la han cortado.",
          "Perecen por la reprensión de tu rostro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sea tu mano sobre el hombre de tu diestra,",
          "sobre el hijo del hombre que fortaleciste para ti mismo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Así no nos apartaremos de ti;",
          "nos darás vida e invocaremos tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Oh SEÑOR Dios de los Ejércitos,",
          "¡restáuranos!",
          "Haz resplandecer tu rostro",
          "y seremos salvos."
        ],
        "rlw_lines": []
      }
    ]
  },
