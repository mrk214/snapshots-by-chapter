    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica por la protección divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Líbrame, oh SEÑOR, del hombre malo;",
          "guárdame del hombre violento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ellos maquinan males en su corazón,",
          "y cada día entablan contiendas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Agudizan su lengua como una serpiente;",
          "veneno de víbora hay debajo de sus labios. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Guárdame, oh SEÑOR, de manos del impío;",
          "protégeme del hombre violento,",
          "quienes han planeado trastornar mis pasos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los arrogantes me han escondido trampa y cuerdas;",
          "han tendido red junto a la senda",
          "y me han puesto lazos. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dije al SEÑOR: “¡Tú eres mi Dios!”.",
          "Escucha, oh SEÑOR, la voz de mis ruegos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Oh Dios, oh SEÑOR, fortaleza de mi salvación,",
          "tú cubres mi cabeza en el día de la batalla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oh SEÑOR, no concedas al impío sus deseos;",
          "ni saques adelante sus planes,",
          "no sea que se enorgullezca. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "En cuanto a los que me rodean,",
          "la maldad de sus propios labios les cubrirá su cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Sobre ellos caerán brasas ardientes.",
          "Dios les hará caer en el fuego,",
          "en profundos hoyos de donde no podrán salir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El hombre suelto de lengua no será firme en la tierra;",
          "al hombre violento el mal le perseguirá a empujones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Yo sé que el SEÑOR amparará la causa del pobre",
          "y el derecho de los necesitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ciertamente los justos darán gracias a tu nombre;",
          "los rectos morarán en tu presencia."
        ],
        "rlw_lines": []
      }
    ]
  },
