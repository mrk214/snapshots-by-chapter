    },
    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—6—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cuando te sientes a comer con",
          "un gobernante,",
          "considera bien lo que está delante de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pon cuchillo a tu garganta,",
          "si tienes gran apetito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No codicies sus manjares delicados, porque es pan de engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—7—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No te afanes por hacerte rico;",
          "sé prudente y desiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Has de hacer volar tus ojos",
          "tras las riquezas, siendo estas nada? Porque ciertamente se harán alas como de águilas y volarán al cielo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—8—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No comas pan con el de malas",
          "intenciones",
          "ni codicies sus manjares delicados;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "porque cual es su pensamiento en su mente, tal es él:",
          "“Come y bebe”, te dirá;",
          "pero su corazón no está contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Vomitarás tu parte que comiste",
          "y echarás a perder tus suaves palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—9—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No hables a oídos del necio,",
          "porque despreciará la prudencia de tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—10—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No cambies de lugar el lindero antiguo",
          "ni entres en los campos",
          "de los huérfanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque su Redentor es fuerte;",
          "él defenderá contra ti la causa de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—11—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Aplica tu corazón a la enseñanza",
          "y tus oídos a las palabras del conocimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—12—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "No rehúses corregir al muchacho;",
          "si lo castigas con vara no morirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tú lo castigarás con vara",
          "y librarás su alma del Seol."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—13—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Hijo mío, si tu corazón es sabio también a mí se me alegrará el corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mis entrañas se regocijarán,",
          "cuando tus labios hablen cosas rectas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—14—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No tenga tu corazón envidia",
          "de los pecadores.",
          "Más bien, en todo tiempo permanece tú en el temor del SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Porque ciertamente hay un porvenir,",
          "y tu esperanza no será frustrada."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—15—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Escucha tú, hijo mío, y sé sabio; endereza tu corazón en el camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No estés con los bebedores de vino",
          "ni con los comilones de carne."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Porque el bebedor y el comilón empobrecerán,",
          "y el dormitar hará vestir harapos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—16—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Escucha a tu padre que te engendró;",
          "y cuando tu madre envejezca",
          "no la menosprecies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Adquiere la verdad y no la vendas; adquiere sabiduría, disciplina",
          "e inteligencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Mucho se alegrará el padre del justo;",
          "el que engendró un hijo sabio se gozará con él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Alégrense tu padre y tu madre",
          "y gócese la que te dio a luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—17—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Dame, hijo mío, tu corazón,",
          "y observen tus ojos mis caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Porque fosa profunda es la prostituta; pozo angosto es la mujer extraña."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "También ella acecha como asaltante,",
          "y multiplica entre los hombres a los traicioneros."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—18—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¿Para quién será el ay?",
          "¿Para quién será el dolor?",
          "¿Para quién serán las rencillas? ¿Para quién los quejidos?",
          "¿Para quién las heridas gratuitas?",
          "¿Para quién lo enrojecido de los ojos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Para los que se detienen mucho sobre el vino;",
          "para los que se lo pasan probando el vino mezclado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "No mires el vino cuando rojea, cuando resplandece su color en la copa, cuando entra suavemente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Al fin muerde como serpiente",
          "y envenena como víbora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Tus ojos mirarán cosas extrañas",
          "y tu corazón hablará perversidades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Serás como el que yace en medio del mar",
          "o como el que yace en la punta",
          "de un mástil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Dirás: “Me golpearon, pero no me dolió;",
          "me azotaron, pero no lo sentí. Cuando me despierte, lo volveré",
          "a buscar”."
        ],
        "rlw_lines": []
      }
    ]
  },
