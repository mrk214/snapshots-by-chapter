    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Protección contra la lengua engañosa"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1 Canto de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Al SEÑOR llamé estando en mi angustia",
          "y él me respondió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Libra mi alma, oh SEÑOR,",
          "de los labios mentirosos",
          "y de la lengua fraudulenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Qué se te dará, o qué te aprovechará,",
          "oh lengua engañosa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Afiladas flechas de guerrero",
          "con brasas de retama!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Ay de mí, que soy peregrino en Mesec,",
          "y habito en las tiendas de Quedar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mucho tiempo ha habitado sola mi alma",
          "con los que aborrecen la paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Yo soy pacífico; pero cuando hablo",
          "ellos me hacen la guerra."
        ],
        "rlw_lines": []
      }
    ]
  },
