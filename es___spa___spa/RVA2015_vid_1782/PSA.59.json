    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, baluarte del justo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre “No destruyas”. Mictam de David, compuesto cuando Saúl mandó que acecharan la casa para matarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Líbrame de mis enemigos, oh Dios mío;",
          "ponme a salvo de los que se levantan contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Líbrame de los que hacen iniquidad;",
          "sálvame de los hombres sanguinarios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque he aquí, acechan mi vida;",
          "los prepotentes me atacan,",
          "no por transgresión o por pecado mío, oh SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sin que yo sea culpable",
          "corren y se preparan.",
          "Despierta para venir a mi encuentro y mira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tú, oh SEÑOR Dios de los Ejércitos, Dios de Israel,",
          "despierta para castigar a todas las naciones.",
          "No tengas misericordia de ningún inicuo traidor.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Vuelven al anochecer,",
          "aúllan como perros",
          "y rodean la ciudad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "He aquí, profieren con su boca;",
          "espadas hay en sus labios.",
          "Porque dicen: “¿Quién oye?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pero tú, oh SEÑOR, te reirás de ellos;",
          "te burlarás de todas las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Fortaleza mía, en ti esperaré;",
          "porque Dios es mi alto refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mi Dios misericordioso me saldrá al encuentro.",
          "Dios me hará ver mi deseo cumplido en mis enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "No los mates, para que mi pueblo no se olvide.",
          "Hazles andar errantes, por tu poder.",
          "Abátelos, oh SEÑOR, escudo nuestro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por el pecado de su boca,",
          "por la palabra de sus labios sean presos;",
          "por su soberbia, por la maldición",
          "y por la mentira que profieren."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Acábalos con furor;",
          "acábalos de modo que dejen de existir.",
          "Que se sepa que Dios domina en Jacob",
          "hasta los confines de la tierra.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡Que vuelvan al anochecer y aúllen como perros! ¡Que rodeen la ciudad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ellos andan errantes para hallar qué comer;",
          "y, al no saciarse, se quejan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pero yo cantaré a tu poder",
          "y alabaré de mañana tu misericordia;",
          "porque fuiste para mí un alto refugio",
          "y un amparo en el día de mi angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Fortaleza mía, a ti cantaré salmos;",
          "porque Dios es mi alto refugio,",
          "el Dios que tiene misericordia de mí."
        ],
        "rlw_lines": []
      }
    ]
  },
