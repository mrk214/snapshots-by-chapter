    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primera intervención de Bildad"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces intervino Bildad el sujita y dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "—¿Hasta cuándo hablarás tales cosas, y las palabras de tu boca serán viento impetuoso?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Acaso pervertirá Dios el derecho? ¿El Todopoderoso pervertirá la justicia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Si tus hijos pecaron contra él,",
          "él los entregó en mano de su transgresión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Si con diligencia buscaras a Dios",
          "e imploraras la gracia del Todopoderoso,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "si fueras limpio y recto,",
          "ciertamente ahora él velaría por ti",
          "y te restauraría la morada que",
          "en justicia mereces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Aunque tu comienzo haya sido",
          "insignificante,",
          "tu porvenir se engrandecerá en gran manera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»Pues indaga, por favor, en las generaciones del pasado;",
          "investiga lo que sus padres han descubierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pues nosotros somos tan solo de ayer y nada sabemos;",
          "nuestros días sobre la tierra",
          "son una sombra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿No te enseñarán ellos y te hablarán,",
          "y de su corazón sacarán palabras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "»¿Crece el papiro donde no hay pantano? ¿Crece el junco sin agua?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Y estando aún en su tallo sin ser cortado, se seca antes que toda hierba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Así son las sendas de todos",
          "los que se olvidan de Dios,",
          "y la esperanza del impío perecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El objeto de su confianza es como tul de verano,",
          "y aquello en que confía es como tela de araña:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Si se apoya sobre su tela no le sostendrá; si se agarra de ella no le resistirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "»Así es el impío: Lleno de savia delante del sol,",
          "sus retoños sobresalen del huerto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sus raíces se entretejen",
          "sobre un montón de piedras,",
          "y vive entre los pedregales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si lo arrancan de su lugar",
          "este le niega diciendo:",
          "“¡Nunca te he visto!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "»He aquí, así es el gozo de su camino,",
          "y otros brotarán del polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "He aquí, Dios no rechaza al íntegro",
          "ni sostiene la mano de los malhechores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Aún llenará tu boca de risa,",
          "y tus labios con grito de júbilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Los que te aborrecen se vestirán de vergüenza,",
          "y la morada de los impíos desaparecerá."
        ],
        "rlw_lines": []
      }
    ]
  },
