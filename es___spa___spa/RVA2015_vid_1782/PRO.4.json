    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Consejos de un padre"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oigan, hijos, la enseñanza de un padre; estén atentos para adquirir entendimiento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "No abandonen mi instrucción, porque yo les doy buena enseñanza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pues yo también fui hijo de mi padre, tierno y singular delante de mi madre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Y él me enseñaba y me decía: “Retenga tu corazón mis palabras; guarda mis mandamientos y vivirás”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Adquiere sabiduría!",
          "¡Adquiere entendimiento!",
          "No te olvides ni te apartes de los dichos de mi boca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No la abandones y ella te guardará; ámala y te preservará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Sabiduría ante todo!",
          "¡Adquiere sabiduría!",
          "Y antes que toda posesión,",
          "adquiere entendimiento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Apréciala y ella te levantará;",
          "y cuando la hayas abrazado, te honrará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Diadema de gracia dará a tu cabeza; corona de hermosura te otorgará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Escucha, hijo mío, y recibe mis dichos",
          "y se te multiplicarán años de vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "En el camino de la sabiduría te he instruido",
          "y por sendas de rectitud te he hecho andar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Cuando camines, tus pasos no hallarán impedimento;",
          "y si corres, no tropezarás."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Aférrate a la disciplina y no la sueltes; consérvala, porque ella es tu vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "No entres en el sendero de los impíos",
          "ni pongas tu pie en el camino de los malos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Evítalo; no pases por él.",
          "Apártate de él; pasa de largo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque ellos no duermen si no han hecho mal;",
          "pierden el sueño si no han hecho caer a alguno."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pues comen pan de impiedad",
          "y beben vino de violencia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero la senda de los justos es como",
          "la luz de la aurora",
          "que va en aumento hasta que es pleno día."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El camino de los impíos es como la oscuridad;",
          "no saben en qué tropiezan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Hijo mío, pon atención a mis palabras;",
          "inclina tu oído a mis dichos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No se aparten de tus ojos;",
          "guárdalos en medio de tu corazón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Porque ellos son vida a los que los hallan",
          "y medicina para todo su cuerpo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Sobre toda cosa guardada,",
          "guarda tu corazón;",
          "porque de él emana la vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Aparta de ti la perversidad de la boca",
          "y aleja de ti la falsedad de los labios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Miren tus ojos lo que es recto",
          "y diríjase tu vista a lo que está frente a ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Considera la senda de tus pies",
          "y todos tus caminos sean correctos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "No te apartes ni a la izquierda",
          "ni a la derecha;",
          "aparta tu pie del mal."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
