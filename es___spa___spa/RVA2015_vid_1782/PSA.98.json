    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Celebración de las victorias de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1 Salmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Canten al SEÑOR un cántico nuevo",
          "porque ha hecho maravillas!",
          "Victoria le ha dado su diestra y su santo brazo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El SEÑOR ha dado a conocer su victoria;",
          "ante los ojos de las naciones ha manifestado su justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Se ha acordado de su misericordia",
          "y de su fidelidad para con la casa de Israel.",
          "Todos los confines de la tierra",
          "han visto la victoria de nuestro Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Canten alegres al SEÑOR, toda la tierra!",
          "Prorrumpan, estallen de gozo y canten salmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Canten salmos al SEÑOR con la lira;",
          "con lira y melodía de himnos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Aclamen con trompetas y sonido de corneta",
          "delante del Rey, el SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ruja el mar y su plenitud,",
          "el mundo y los que lo habitan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Aplaudan los ríos;",
          "regocíjense todos los montes"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "delante del SEÑOR",
          "porque viene para juzgar la tierra.",
          "Juzgará al mundo con justicia",
          "y a los pueblos con rectitud."
        ],
        "rlw_lines": []
      }
    ]
  },
