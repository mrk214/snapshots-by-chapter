    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confianza en Dios y en su palabra"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre “La paloma silenciosa de la lejanía”. Mictam de David compuesto cuando los filisteos lo apresaron en Gat."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ten misericordia de mí, oh Dios,",
          "porque me acosa el hombre;",
          "me oprime combatiéndome todo el día."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Todo el día me pisotean mis enemigos,",
          "porque muchos son los que me combaten con altanería."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El día en que tengo temor",
          "yo en ti confío."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En Dios, cuya palabra alabo, en Dios he confiado.",
          "¡No temeré lo que me pueda hacer ningún mortal!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Todo el día pervierten mis palabras;",
          "contra mí son todos sus pensamientos, para mal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ellos conspiran; se ocultan.",
          "Observan atentamente mis pasos en acecho de mi vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¿Escaparán ellos por su iniquidad?",
          "¡Oh Dios, derriba los pueblos con tu furor!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mis andanzas tú has contado;",
          "pon mis lágrimas ante ti.",
          "¿Acaso no están escritas en tu libro?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El día que yo clame a ti,",
          "mis enemigos retrocederán.",
          "Esto sé: que Dios está a mi lado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "En Dios cuya palabra alabo,",
          "en el SEÑOR cuya palabra alabo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "en Dios he confiado.",
          "No temeré lo que me pueda hacer el hombre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sobre mí, oh Dios, están tus votos;",
          "te pagaré sacrificios de acción de gracias."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Porque has librado mi vida de la muerte y mis pies de la caída",
          "para que ande delante de Dios en la luz de la vida."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
