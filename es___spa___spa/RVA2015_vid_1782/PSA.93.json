    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El reinado eterno del SEÑOR"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡El SEÑOR reina!",
          "Se ha vestido de magnificencia.",
          "El SEÑOR se ha vestido de poder y se ha ceñido.",
          "También afirmó el mundo, y no se moverá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Firme es tu trono desde la antigüedad;",
          "tú eres desde la eternidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Alzaron los ríos, oh SEÑOR,",
          "alzaron los ríos su sonido;",
          "alzaron los ríos su estruendo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El SEÑOR en las alturas es más poderoso",
          "que el estruendo de muchas aguas,",
          "más que las recias olas del mar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tus testimonios son muy firmes.",
          "La santidad adorna tu casa, oh SEÑOR,",
          "a través de los años."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
