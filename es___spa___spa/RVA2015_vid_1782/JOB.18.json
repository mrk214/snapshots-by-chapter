    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segunda intervención de Bildad"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces intervino Bildad el sujita",
          "y dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "—¿Cuándo pondrán fin a las palabras? Reflexionen primero, y después hablaremos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Por qué somos tenidos por animales",
          "y por impuros ante sus ojos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Oh, el que despedaza su alma",
          "con su furor!",
          "¿Será abandonada la tierra por tu causa? ¿Será removida la peña de su lugar?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Ciertamente se extingue la luz de los impíos",
          "y no resplandece la lumbre de su fuego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "La luz se oscurece en su morada",
          "y se apaga la lámpara que está sobre él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Los pasos de su vigor son estrechados;",
          "su propio plan lo hace caer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Porque por sus propios pies es echado en la red",
          "y deambula en la maraña."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Una trampa lo atrapa por el talón;",
          "el enredo se apodera de él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Para él está escondida una cuerda en el suelo;",
          "para él hay un lazo en el sendero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por todas partes lo sobrecogen",
          "los terrores",
          "y lo persiguen pisando sus talones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "En su riqueza está hambriento",
          "y a su lado está lista la desgracia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Carcome parte de su piel;",
          "el primogénito de la muerte",
          "devora sus miembros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Es arrancado de su morada,",
          "objeto de su confianza,",
          "y es conducido ante el rey",
          "de los espantos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El fuego habita en su tienda;",
          "el azufre es esparcido sobre su morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por abajo se secan sus raíces,",
          "y por arriba se marchitan sus ramas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Su memoria perece en la tierra",
          "y no tiene nombre en las calles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Lo empujan de la luz a las tinieblas;",
          "lo echan fuera del mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "No tendrá prole ni descendiente",
          "en su pueblo",
          "ni sobreviviente en sus moradas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Los que vengan del oeste",
          "se horrorizarán de su día,",
          "y los que vengan del este",
          "serán sobrecogidos por el espanto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Tales son las moradas del impío,",
          "y tal será el lugar del que no",
          "conoce a Dios."
        ],
        "rlw_lines": []
      }
    ]
  },
