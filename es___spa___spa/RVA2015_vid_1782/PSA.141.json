    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración ante la seducción del mal"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, a ti clamo;",
          "acude pronto a mí.",
          "Escucha mi voz cuando te invoco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sea constante mi oración delante de ti, como el incienso;",
          "mis manos alzadas, como el sacrificio del atardecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pon, oh SEÑOR, guardia a mi boca;",
          "guarda la puerta de mis labios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No dejes que mi corazón se incline a cosa mala",
          "para hacer obras perversas",
          "con los hombres que obran iniquidad.",
          "No coma yo de sus manjares."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que el justo me castigue y me reprenda será un favor.",
          "Pero que el aceite del impío no embellezca mi cabeza,",
          "pues mi oración será continuamente contra sus maldades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sean derribados sus jueces en lugares peñascosos,",
          "y oigan mis palabras, que son agradables."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Como cuando se ara y se rompe la tierra,",
          "así son esparcidos nuestros huesos en la boca del Seol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por eso, oh SEÑOR Dios, hacia ti miran mis ojos.",
          "En ti me refugio; no expongas mi vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Guárdame de los lazos que me han tendido,",
          "y de las trampas de los que obran iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Caigan juntos los impíos en sus propias redes",
          "mientras yo paso a salvo."
        ],
        "rlw_lines": []
      }
    ]
  },
