    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La gloria de la ciudad del Gran Rey"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Grande es el SEÑOR",
          "y digno de suprema alabanza,",
          "en la ciudad de nuestro Dios,",
          "en el monte de su santuario!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Qué hermosa altura!",
          "El gozo de toda la tierra es el monte Sion por el lado norte,",
          "la ciudad del Gran Rey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios es conocido por refugio",
          "en sus palacios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque, he aquí, los reyes se han aliado;",
          "han avanzado juntos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero viéndola así, se quedaron atónitos;",
          "se turbaron y se dieron prisa a huir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Allí se apoderó de ellos el estremecimiento;",
          "tuvieron dolor como de mujer que da a luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Con el viento del oriente",
          "rompes las naves de Tarsis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como lo oímos, así lo hemos visto",
          "en la ciudad del SEÑOR de los Ejércitos,",
          "la ciudad de nuestro Dios:",
          "Dios la afirmará para siempre. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Oh Dios, hemos pensado en tu misericordia",
          "en medio de tu templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Conforme a tu nombre, oh Dios,",
          "así es tu alabanza hasta los confines de la tierra.",
          "Tu diestra está llena de justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Se alegrará el monte Sion; las hijas de Judá se regocijarán",
          "a causa de tus juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Vayan alrededor de Sion y rodéenla;",
          "cuenten sus torres;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "observen detenidamente su muro exterior;",
          "examinen sus palacios, para que lo cuenten a la generación venidera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque Dios es nuestro Dios eternamente y para siempre;",
          "por siempre nos guiará."
        ],
        "rlw_lines": []
      }
    ]
  },
