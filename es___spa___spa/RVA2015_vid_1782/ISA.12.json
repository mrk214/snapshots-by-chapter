    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Agradecimiento por la liberación divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En aquel día dirás:",
          "“¡Te doy gracias, oh SEÑOR!",
          "Aunque te enojaste contra mí,",
          "tu ira se apartó, y me has consolado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡He aquí, Dios es mi salvación!",
          "Confiaré y no temeré,",
          "porque el SEÑOR es mi fortaleza y mi canción;",
          "él es mi salvación”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Con regocijo sacarán agua",
          "de los manantiales de la salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En aquel día dirán:",
          "“¡Den gracias al SEÑOR!",
          "¡Invoquen su nombre!",
          "Den a conocer entre los pueblos sus hazañas;",
          "recuerden que grande es su nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Canten salmos al SEÑOR,",
          "porque ha hecho cosas magníficas!.",
          "Sea esto conocido en toda la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Grita y canta, oh habitante de Sion,",
          "pues el Santo de Israel",
          "es grande en medio de ti”."
        ],
        "rlw_lines": []
      }
    ]
  },
