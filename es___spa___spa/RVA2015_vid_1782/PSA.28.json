    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR escucha la oración"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A ti clamaré, oh SEÑOR;",
          "Roca mía, no te hagas el sordo para conmigo.",
          "No suceda que, por quedarte en silencio ante mí,",
          "yo llegue a ser semejante a los que descienden a la fosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Escucha la voz de mis ruegos cuando clamo a ti,",
          "cuando alzo mis manos hacia tu lugar santísimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No me arrastres junto con los impíos,",
          "con los que hacen iniquidad,",
          "los cuales hablan de paz a su prójimo",
          "pero la maldad está en su corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dales conforme a sus hechos",
          "y conforme a la maldad de sus actos.",
          "Dales conforme a la obra de sus manos.",
          "¡Dales su recompensa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque no atendieron a los hechos del SEÑOR",
          "ni a la obra de sus manos,",
          "él los derribará y no los volverá a edificar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Bendito sea el SEÑOR,",
          "que oyó la voz de mis ruegos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El SEÑOR es mi fuerza y mi escudo;",
          "en él esperó mi corazón.",
          "Fui ayudado, y se gozó mi corazón;",
          "con mi canción le alabaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El SEÑOR es la fuerza de su pueblo,",
          "la fortaleza de salvación para su ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Salva a tu pueblo y bendice a tu heredad;",
          "pastoréalos y enaltécelos para siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
