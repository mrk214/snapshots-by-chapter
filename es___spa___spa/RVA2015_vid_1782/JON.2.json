    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jonás ora desde el vientre del pez"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Y desde el vientre del pez oró Jonás al SEÑOR su Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Y dijo:",
          "“Desde mi angustia invoqué al SEÑOR",
          "y él me respondió.",
          "Clamé desde el vientre del Seol",
          "y tú escuchaste mi voz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Me arrojaste a lo profundo,",
          "en el corazón de los mares",
          "y me rodeó la corriente:",
          "Todas tus ondas y tus olas",
          "han pasado sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Yo dije: Expulsado soy",
          "de delante de tus ojos;",
          "pero aún he de ver tu santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Las aguas me han envuelto",
          "hasta la garganta;",
          "me rodeó el abismo.",
          "Las algas se enredaron en mi cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Descendí a la base de las montañas.",
          "La tierra echó sus cerrojos",
          "tras de mí para siempre.",
          "Pero tú hiciste subir mi vida",
          "de la fosa, ¡oh SEÑOR Dios mío!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuando mi alma desfallecía dentro de mí",
          "me acordé del SEÑOR;",
          "y mi oración llegó hasta ti,",
          "a tu santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los que veneran las vanidades ilusorias",
          "abandonan su lealtad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pero yo te ofreceré sacrificio",
          "con voz de alabanza.",
          "Lo que prometí haciendo votos lo cumpliré.",
          "¡La salvación pertenece al SEÑOR!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Entonces el SEÑOR habló al pez y este vomitó a Jonás en tierra."
        ],
        "rlw_lines": []
      }
    ]
  },
