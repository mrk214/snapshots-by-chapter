    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR, Rey de toda la tierra"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Pueblos todos, aplaudan!",
          "¡Aclamen a Dios con voz de júbilo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque el SEÑOR, el Altísimo, es temible,",
          "gran Rey sobre toda la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Él someterá los pueblos a nosotros,",
          "las naciones debajo de nuestros pies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque él ha elegido nuestra heredad;",
          "el orgullo de Jacob, al cual amó.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Subió Dios en medio de aclamación;",
          "el SEÑOR, con sonido de corneta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Canten a Dios, canten!",
          "¡Canten a nuestro Rey, canten!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque Dios es el Rey de toda la tierra,",
          "canten con entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Dios reina sobre las naciones!",
          "¡Dios se ha sentado sobre su santo trono!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Se han reunido los gobernantes de los pueblos",
          "con el pueblo del Dios de Abraham,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "porque de Dios son las defensas de la tierra.",
          "¡Él es muy enaltecido!"
        ],
        "rlw_lines": []
      }
    ]
  },
