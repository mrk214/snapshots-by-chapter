    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza al Dios providente"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "Ciertamente es bueno cantar salmos a nuestro Dios;",
          "ciertamente es agradable y bella la alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El SEÑOR edifica a Jerusalén",
          "y reúne a los dispersados de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sana a los quebrantados de corazón",
          "y venda sus heridas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cuenta el número de las estrellas;",
          "a todas ellas llama por su nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Grande es el Señor nuestro,",
          "y de mucho poder;",
          "su entendimiento es infinito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El SEÑOR ayuda a los humildes",
          "pero a los impíos humilla hasta el suelo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Canten al SEÑOR con acción de gracias;",
          "canten con arpa a nuestro Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Él es el que cubre los cielos de nubes,",
          "el que prepara la lluvia para la tierra,",
          "el que hace que las colinas produzcan hierba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Da al ganado su alimento;",
          "y a las crías de los cuervos cuando gritan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No se deleita en la fuerza del caballo",
          "ni se complace en los músculos del hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El SEÑOR se complace en los que le temen",
          "y en los que esperan en su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡Celebra al SEÑOR, oh Jerusalén!",
          "¡Alaba a tu Dios, oh Sion!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Porque ha fortalecido el cerrojo de tus puertas,",
          "y ha bendecido a tus hijos dentro de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ha traído paz a tu territorio,",
          "y te ha saciado con abundancia de trigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Envía su mensaje a la tierra;",
          "velozmente corre su palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pone la nieve como lana,",
          "y derrama la escarcha como ceniza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Echa su hielo como migas de pan.",
          "¿Quién se mantendrá ante su frío?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Envía su palabra y los derrite;",
          "hace que sople su viento y corren las aguas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ha manifestado sus palabras a Jacob,",
          "sus leyes y sus decretos a Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No ha hecho esto con otras naciones,",
          "y no han conocido sus juicios.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
