    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración para la hora de levantarse"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David compuesto cuando huía de su hijo Absalón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Oh SEÑOR, cuánto se han multiplicado mis enemigos!",
          "Muchos son los que se levantan contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Muchos dicen acerca de mí:",
          "“¡Dios no lo librará!”. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pero tú, oh SEÑOR,",
          "eres escudo alrededor de mí;",
          "eres mi gloria y el que levanta mi cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Con mi voz clamé al SEÑOR,",
          "y él me respondió desde su santo monte. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Yo me acosté y dormí.",
          "Desperté, porque el SEÑOR me sostuvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No temeré a las decenas de millares del pueblo que han puesto sitio contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Levántate, oh SEÑOR!",
          "¡Sálvame, Dios mío!",
          "Porque a todos mis enemigos",
          "has golpeado en la mejilla,",
          "y has quebrantado los dientes de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Del SEÑOR viene la salvación.",
          "¡Sobre tu pueblo sea tu bendición! Selah"
        ],
        "rlw_lines": []
      }
    ]
  },
