    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza a Dios por sus hechos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Cántico y salmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aclamen a Dios con alegría",
          "habitantes de toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Canten a la gloria de su nombre;",
          "denle la gloria en la alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Digan a Dios:",
          "“¡Cuán admirables son tus obras!",
          "Por tu gran poder se someterán a ti tus enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Toda la tierra te adorará y cantará a ti!",
          "¡Cantarán a tu nombre!”.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Vengan y vean los actos de Dios,",
          "admirable en sus hechos",
          "para con los hijos del hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Él convirtió el mar en tierra seca,",
          "y por el río pasaron a pie.",
          "¡Regocijémonos en él!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Se enseñorea con su poder para siempre;",
          "sus ojos observan a las naciones",
          "para que los rebeldes no se enaltezcan contra él. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Bendigan, oh pueblos, a nuestro Dios!",
          "Hagan que se escuche la voz de su alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Él es quien preservó la vida",
          "a nuestra alma",
          "y no permitió que resbalasen nuestros pies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tú nos has probado, oh Dios;",
          "nos has purificado como se prueba la plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Nos metiste en la red",
          "y pusiste apretura sobre nuestros lomos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Hiciste que los hombres cabalgaran encima de nuestra cabeza.",
          "Pasamos por el fuego y por el agua",
          "pero luego nos sacaste a abundancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Entraré en tu templo con holocaustos;",
          "te pagaré mis votos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "que pronunciaron mis labios",
          "y que mi boca prometió cuando yo estaba angustiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Te ofreceré holocaustos de animales engordados,",
          "con incienso de carneros.",
          "Sacrificaré toros y machos cabríos.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Vengan; oigan, todos los que temen a Dios,",
          "y contaré lo que ha hecho por mi vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A él invoqué con mi boca",
          "y con mi lengua lo ensalcé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si en mi corazón yo hubiera consentido la iniquidad",
          "el Señor no me habría escuchado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Pero de veras Dios me ha escuchado!",
          "Él atendió a la voz de mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Bendito sea Dios,",
          "que no echó de sí mi oración",
          "ni de mí su misericordia!"
        ],
        "rlw_lines": []
      }
    ]
  },
