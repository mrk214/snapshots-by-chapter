    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esperanza en la redención divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canto de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "De lo profundo de mi ser clamo a ti, oh SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Señor, escucha mi voz;",
          "estén atentos tus oídos a la voz de mi súplica."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Oh SEÑOR, si tienes presente los pecados,",
          "¿quién podrá, oh Señor, mantenerse en pie?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero en ti hay perdón",
          "para que seas reverenciado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Yo espero en el SEÑOR; mi alma espera.",
          "En su palabra he puesto mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mi alma espera al SEÑOR",
          "más que los centinelas a la mañana;",
          "sí, más que los centinelas a la mañana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Oh Israel, pon tu esperanza en el SEÑOR,",
          "porque en el SEÑOR hay misericordia",
          "y en él hay abundante redención."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Él redimirá a Israel",
          "de todos sus pecados."
        ],
        "rlw_lines": []
      }
    ]
  },
