    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cántico de liberación"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "David dirigió al SEÑOR las palabras de este cántico, el día que el SEÑOR lo libró de mano de todos sus enemigos, y de mano de Saúl. Él dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“El SEÑOR es mi roca,",
          "mi fortaleza y mi libertador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios es mi peña; en él me refugiaré.",
          "Él es mi escudo, el poder",
          "de mi liberación,",
          "mi baluarte, mi refugio y mi salvador. Tú me salvas de la violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Invocaré al SEÑOR, quien es digno de ser alabado,",
          "y seré librado de mis enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ciertamente me rodearon las olas",
          "de la muerte,",
          "y los torrentes de la perversidad me atemorizaron."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Me rodearon las ligaduras del Seol;",
          "me confrontaron los lazos de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“En mi angustia invoqué al SEÑOR;",
          "invoqué a mi Dios.",
          "Él oyó mi voz desde su templo,",
          "y mi clamor llegó a sus oídos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“La tierra se estremeció y tembló;",
          "se conmovieron los cimientos",
          "de los cielos.",
          "Se estremecieron, porque él se airó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Humo subió de su nariz;",
          "de su boca salió fuego consumidor,",
          "y carbones encendidos saltaban de él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Inclinó los cielos y descendió;",
          "una densa oscuridad había debajo",
          "de sus pies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Cabalgó sobre un querubín y voló;",
          "se remontó sobre las alas del viento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Puso tinieblas alrededor de sí como su morada,",
          "oscuridad de aguas y densas nubes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Por el resplandor de su presencia",
          "se encendieron carbones de fuego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“El SEÑOR tronó desde los cielos;",
          "el Altísimo dio su voz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Envió flechas y los dispersó;",
          "arrojó relámpagos y los desconcertó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "A la reprensión del SEÑOR,",
          "por el soplo del aliento de su nariz,",
          "se hicieron visibles los lechos del mar,",
          "y se descubrieron los cimientos del mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Envió desde lo alto y me tomó;",
          "me sacó de las aguas caudalosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Me libró de mi poderoso enemigo",
          "y de los que me aborrecían,",
          "pues eran más fuertes que yo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Se enfrentaron a mí el día",
          "de mi desgracia,",
          "pero el SEÑOR fue mi apoyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Él me sacó a un lugar espacioso;",
          "me libró, porque se agradó de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "“El SEÑOR me ha pagado conforme",
          "a mi justicia;",
          "conforme a la limpieza de mis manos me ha recompensado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Porque he guardado los caminos del SEÑOR,",
          "y no me he apartado impíamente",
          "de mi Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Porque delante de mí han estado todos sus juicios,",
          "y no he apartado de mí sus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Fui íntegro para con él,",
          "y me guardé de mi maldad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Por tanto, el SEÑOR me ha",
          "recompensado conforme a mi justicia, conforme a mi limpieza ante sus ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "“Con el misericordioso",
          "te muestras misericordioso,",
          "e íntegro con el hombre íntegro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Con el limpio te muestras limpio,",
          "y eres sagaz con el perverso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Salvas al pueblo humilde;",
          "pero tus ojos humillan a los altivos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Ciertamente tú eres mi lámpara,",
          "oh SEÑOR;",
          "el SEÑOR ilumina mis tinieblas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Contigo desbarataré ejércitos;",
          "con mi Dios saltaré murallas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "“Perfecto es el camino de Dios;",
          "probada es la palabra del SEÑOR.",
          "Él es escudo a todos los que en él",
          "se refugian."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Porque, ¿quién es Dios fuera del SEÑOR?",
          "¿Quién es Roca fuera de nuestro Dios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Dios es el que me ciñe de vigor,",
          "y hace perfecto mi camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Hace que mis pies sean ágiles como los del venado,",
          "y me mantiene firme sobre mis alturas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Adiestra mis manos para la batalla;",
          "así mis brazos pueden tensar el arco",
          "de bronce."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "“Me has dado el escudo de tu salvación; tu condescendencia me ha engrandecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Tú has ensanchado mis pasos debajo de mí,",
          "para que no tiemblen mis tobillos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Perseguí a mis enemigos y los destruí;",
          "no volví sino hasta acabarlos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Los consumí;",
          "los golpeé, y no pudieron levantarse; cayeron debajo de mis pies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Me ceñiste de poder para la batalla;",
          "doblegaste a mis enemigos debajo de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Hiciste que mis enemigos me dieran las espaldas,",
          "y destruí a los que me aborrecían."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Clamaron, pero no hubo quien los salvara.",
          "Clamaron al SEÑOR, pero él",
          "no les respondió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Los desmenucé como polvo de la tierra; los deshice como lodo de la calle",
          "y los aplasté."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "“Tú me libraste de las contiendas",
          "de mi pueblo,",
          "y me guardaste como jefe",
          "de las naciones.",
          "Aun los pueblos que yo no conocía me sirvieron."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Los hijos de los extranjeros",
          "me adulaban;",
          "apenas oían de mí, me rendían obediencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Los hijos de los extranjeros",
          "se desvanecían",
          "y salían temblando de sus escondrijos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "“¡Viva el SEÑOR! ¡Bendita sea mi Roca! Sea ensalzado Dios, la roca",
          "de mi salvación,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "el Dios que ejecuta mi venganza;",
          "somete a los pueblos debajo de mí"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "y me aparta de mis enemigos.",
          "Tú me has enaltecido sobre mis adversarios,",
          "y me has librado del hombre violento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Por eso te confesaré entre las naciones, oh SEÑOR,",
          "y cantaré salmos a tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "“Él engrandece las victorias de su rey",
          "y muestra misericordia a su ungido:",
          "a David y a sus descendientes, para siempre”."
        ],
        "rlw_lines": []
      }
    ]
  },
