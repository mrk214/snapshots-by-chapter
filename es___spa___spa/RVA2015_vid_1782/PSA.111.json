    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bondad y fidelidad divinas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "Daré gracias al SEÑOR con todo mi corazón",
          "en la reunión y en la congregación de los rectos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Grandes son las obras del SEÑOR,",
          "buscadas por todos los que se complacen en ellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Gloria y hermosura es su obra,",
          "y su justicia permanece para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Hizo memorables sus maravillas;",
          "clemente y misericordioso es el SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Da alimento a los que le temen;",
          "para siempre se acordará de su pacto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El poder de sus obras manifestó a su pueblo",
          "al darle la heredad de las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Las obras de sus manos son verdad y justicia;",
          "fieles son todas sus ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Son afirmadas eternamente y para siempre,",
          "hechas con verdad y rectitud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ha enviado redención a su pueblo;",
          "para siempre ha ordenado su pacto.",
          "Santo y temible es su nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El principio de la sabiduría es el temor del SEÑOR.",
          "Buen entendimiento tienen todos los que ponen esto por obra.",
          "Su loor permanece para siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
