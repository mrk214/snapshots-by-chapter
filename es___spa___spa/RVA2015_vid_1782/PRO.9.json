    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El llamado de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La sabiduría edifica su casa, labra sus siete columnas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "mata sus animales, mezcla su vino",
          "y pone su mesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Envía a sus criadas",
          "y llama desde lo más alto de la ciudad:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“¡Si alguno es ingenuo, que venga acá!”.",
          "Y a los faltos de entendimiento dice:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Vengan, coman mi pan",
          "y beban mi vino que yo he mezclado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dejen la ingenuidad y vivan; pongan sus pies en el camino",
          "de la inteligencia”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El que corrige al burlador se acarrea vergüenza,",
          "y el que reprende al impío se acarrea afrenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No reprendas al burlador porque",
          "te aborrecerá;",
          "corrige al sabio y te amará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Da al sabio, y será más sabio;",
          "enseña al justo y aumentará su saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El principio de la sabiduría es el temor del SEÑOR,",
          "y el conocimiento del Santísimo es la inteligencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque por mí se aumentarán tus días,",
          "y años de vida te serán añadidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si eres sabio, para ti lo serás; pero si eres burlador, sufrirás tú solo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El llamado de la necedad"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La mujer necia es alborotadora;",
          "es libertina y no conoce la vergüenza ."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ella se sienta en una silla a la puerta de su casa,",
          "en lo alto de la ciudad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "para llamar a los que pasan por",
          "el camino,",
          "a los que van directo por sus sendas:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "“¡Si alguno es ingenuo, que venga acá!”.",
          "Y a los faltos de entendimiento dice:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Las aguas hurtadas son dulces",
          "y el pan comido en oculto es delicioso”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "No saben ellos que allí están los muertos, que sus invitados están en lo profundo del Seol."
        ],
        "rlw_lines": []
      }
    ]
  },
