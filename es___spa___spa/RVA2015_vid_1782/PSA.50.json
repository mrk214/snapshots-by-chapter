    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, el Juez de buenos y malos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El SEÑOR, el Dios de dioses, ha hablado;",
          "ha convocado a la tierra desde donde sale el sol hasta donde se pone."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Desde Sion, perfección de la hermosura,",
          "Dios ha resplandecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Nuestro Dios viene y no callará.",
          "Fuego consumidor le precede,",
          "y alrededor de él hay gran tormenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Convoca a los cielos en lo alto",
          "y a la tierra para juzgar a su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Reúnanme a mis fieles,",
          "los que han hecho conmigo pacto mediante sacrificio”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los cielos proclamarán su justicia",
          "porque Dios es el Juez. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Escucha, oh pueblo mío, y hablaré;",
          "testificaré contra ti, oh Israel. Yo soy Dios, el Dios tuyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No te reprocharé con respecto a tus sacrificios",
          "ni a tus holocaustos, que siempre están delante de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No tomaré toros de tu casa",
          "ni machos cabríos de tus rediles"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "porque míos son todos los animales del bosque,",
          "los millares del ganado en mis montes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Conozco todas las aves de las alturas,",
          "y las criaturas del campo son mías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si yo tuviera hambre, no te lo diría a ti",
          "porque mío es el mundo y su plenitud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿He de comer la carne de los toros?",
          "¿He de beber la sangre de los machos cabríos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡Ofrece a Dios sacrificio de acción de gracias!",
          "¡Paga tus votos al Altísimo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Invócame en el día de la angustia;",
          "yo te libraré, y tú me glorificarás”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pero al impío Dios le dijo:",
          "“¿Por qué tienes tú que recitar mis leyes",
          "y mencionar mi pacto con tu boca?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tú detestas la instrucción",
          "y echas a tus espaldas mis palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si ves a un ladrón, te complaces con él,",
          "y tu parte está con los adúlteros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Con maldad das rienda suelta a tu boca,",
          "y tu lengua urde engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Tomas asiento y hablas contra tu hermano;",
          "contra el hijo de tu madre arrojas infamia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Estas cosas has hecho, y yo he callado.",
          "Ciertamente pensabas que yo sería como tú,",
          "pero yo te reprenderé y las pondré ante tus ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“Entiendan pues esto los que se olvidan de Dios;",
          "no sea que yo los arrebate sin que nadie los libre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El que ofrece sacrificio de acción de gracias me glorificará,",
          "y al que ordena su camino le mostraré la salvación de Dios”."
        ],
        "rlw_lines": []
      }
    ]
  },
