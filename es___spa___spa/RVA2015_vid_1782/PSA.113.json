    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios levanta a los pobres"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "¡Alaben, oh siervos del SEÑOR,",
          "alaben el nombre del SEÑOR!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sea bendito el nombre del SEÑOR",
          "desde ahora y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Desde el nacimiento del sol y hasta donde se pone",
          "sea alabado el nombre del SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alto sobre todas las naciones es el SEÑOR;",
          "sobre los cielos es su gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Quién como el SEÑOR nuestro Dios,",
          "el que mora en lo alto"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "y se humilla para mirar en el cielo y en la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Levanta del polvo al pobre,",
          "y al necesitado enaltece desde la basura"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "para hacerle sentar con los nobles,",
          "con los nobles de su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Él hace habitar en familia a la estéril,",
          "feliz de ser madre de hijos.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
