    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»Mi espíritu está atribulado; mis días se extinguen.",
          "El sepulcro está preparado para mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "No hay conmigo sino burladores,",
          "y mis ojos contemplan su hostilidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Por favor, deposita contigo una fianza para mí.",
          "¿Quién me estrechará la mano?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque has cerrado su corazón al entendimiento;",
          "por tanto, no los enaltecerás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los que por recompensa denuncian",
          "a sus amigos,",
          "aun los ojos de sus hijos desfallecerán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "»Él me ha expuesto como refrán a los pueblos;",
          "ante ellos soy uno a quien escupen en la cara."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mis ojos se han debilitado por la angustia;",
          "todos mis miembros son como una sombra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los rectos se asombrarán de esto,",
          "y el inocente se levantará contra",
          "el impío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pero el justo se aferrará a su camino,",
          "y el limpio de manos aumentará sus fuerzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No obstante, vuelvan todos ustedes; vengan, por favor.",
          "Pero entre ustedes no hallaré ningún sabio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "»Han pasado mis días;",
          "se han deshecho mis planes.",
          "¡Aun los deseos de mi corazón!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ellos convierten la noche en día: “La luz está cerca de las tinieblas”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Aunque espere, el Seol será mi casa; tenderé mi cama en las tinieblas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "A la fosa digo: “Tú eres mi padre”,",
          "y a los gusanos: “Mi madre y mi hermana”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¿Dónde está, entonces, mi esperanza?",
          "Y mi bien, ¿quién lo verá?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Descenderán al poder del Seol, pues juntos bajaremos hasta el polvo."
        ],
        "rlw_lines": []
      }
    ]
  },
