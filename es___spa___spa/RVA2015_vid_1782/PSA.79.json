    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lamento por la ruina de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Dios, los gentiles han venido a tu heredad.",
          "Han contaminado tu santo templo,",
          "y a Jerusalén han reducido a montones de escombros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Han dado los cuerpos de tus siervos",
          "como comida a las aves de los cielos;",
          "han dado la carne de tus fieles",
          "a los animales de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Derramaron como agua su sangre",
          "en los alrededores de Jerusalén;",
          "no hubo quien los enterrase."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Somos una afrenta para nuestros vecinos,",
          "burla y ridículo ante los que están a nuestro alrededor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Hasta cuándo, oh SEÑOR?",
          "¿Has de estar airado para siempre?",
          "¿Arderá como fuego tu celo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Derrama tu ira sobre las naciones que no te conocen",
          "y sobre los reinos que no invocan tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque han devorado a Jacob,",
          "y han desolado su morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No recuerdes contra nosotros",
          "los pecados de nuestros antepasados.",
          "Salgan pronto a encontrarnos tus misericordias",
          "porque estamos muy abatidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ayúdanos, oh Dios, salvación nuestra,",
          "por causa de la gloria de tu nombre.",
          "Líbranos y expía nuestros pecados",
          "por amor de tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Por qué han de decir los gentiles:",
          "“¿Dónde está su Dios?”.",
          "Sea dada a conocer a las naciones y ante nuestros ojos",
          "la venganza de la sangre de tus siervos",
          "que ha sido derramada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Llegue a tu presencia el gemido de los presos.",
          "Conforme a la grandeza de tu brazo",
          "preserva a los sentenciados a muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Devuelve a nuestros vecinos siete veces en su cara",
          "la infamia con que te han deshonrado, oh SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Entonces nosotros,",
          "pueblo tuyo y ovejas de tu prado,",
          "te confesaremos para siempre;",
          "por generación y generación contaremos de tus alabanzas."
        ],
        "rlw_lines": []
      }
    ]
  },
