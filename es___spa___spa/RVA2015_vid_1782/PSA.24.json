    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR: el Rey de gloria"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Del SEÑOR es la tierra y todo lo que hay en ella;",
          "el mundo y los que lo habitan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque él la fundó sobre los mares",
          "y la afirmó sobre los ríos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Quién subirá al monte del SEÑOR?",
          "¿Quién permanecerá en su lugar santo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El limpio de manos y puro de corazón",
          "que no ha elevado su alma a la vanidad",
          "ni ha jurado con engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Él recibirá la bendición del SEÑOR",
          "y la justicia del Dios de su salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tal es la generación de los que le buscan,",
          "de los que buscan tu rostro,",
          "oh Dios de Jacob. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Levanten, oh puertas, su cabeza!",
          "Levántense, oh puertas eternas,",
          "y entrará el Rey de gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¿Quién es este Rey de gloria?",
          "¡El SEÑOR, el fuerte y poderoso!",
          "¡El SEÑOR, el poderoso en la batalla!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Levanten, oh puertas, su cabeza!",
          "Levántense, oh puertas eternas,",
          "y entrará el Rey de gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Quién es este Rey de gloria?",
          "¡El SEÑOR de los Ejércitos!",
          "¡Él es el Rey de gloria! Selah"
        ],
        "rlw_lines": []
      }
    ]
  },
