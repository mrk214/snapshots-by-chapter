    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El reinado del rey ideal"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A Salomón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Dios, da tus juicios al rey,",
          "y tu justicia al hijo del rey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Él juzgará a tu pueblo con justicia",
          "y a tus pobres con rectitud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Los montes producirán paz para el pueblo;",
          "y las colinas, justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Juzgará a los pobres del pueblo;",
          "salvará a los hijos del necesitado",
          "y quebrantará al opresor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Durará con el sol y la luna,",
          "generación tras generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Descenderá como lluvia sobre la hierba cortada,",
          "como los aguaceros que humedecen la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En sus días florecerá el justo;",
          "habrá abundancia de paz",
          "hasta que no haya más luna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dominará de mar a mar",
          "y desde el Río hasta los confines de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Delante de él se postrarán los habitantes del desierto,",
          "y sus enemigos lamerán el polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los reyes de Tarsis y de las costas del mar le traerán presentes;",
          "los reyes de Saba y de Seba le presentarán tributo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ante él se arrodillarán todos los reyes",
          "y le servirán todas las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Librará al necesitado que suplica",
          "y al pobre que no tiene quien le socorra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tendrá piedad del pobre y del necesitado,",
          "y salvará la vida de los necesitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "De la opresión y de la violencia les redimirá la vida;",
          "la sangre de ellos será preciosa a sus ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Vivirá, y se le dará el oro de Saba.",
          "Se orará por él continuamente;",
          "todo el día se le bendecirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Haya abundancia de grano en la tierra;",
          "sea copioso en las cumbres de los montes.",
          "Su fruto brotará como el Líbano,",
          "y surgirá como la hierba de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Para siempre será su nombre;",
          "será perpetuado mientras dure el sol.",
          "En él serán benditas todas las naciones",
          "y lo llamarán bienaventurado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¡Bendito sea el SEÑOR Dios, Dios de Israel!",
          "Solo él hace maravillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Bendito sea para siempre su nombre glorioso!",
          "Toda la tierra sea llena de su gloria.",
          "Amén y amén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Aquí terminan las oraciones de David hijo de Isaí."
        ],
        "rlw_lines": []
      }
    ]
  },
