    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR, Dios de justicia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, Dios de las venganzas;",
          "oh Dios de las venganzas, ¡manifiéstate!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Exáltate, oh Juez de la tierra!",
          "Da su recompensa a los soberbios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Hasta cuándo los impíos,",
          "hasta cuándo, oh SEÑOR,",
          "se regocijarán los impíos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Vocean, hablan insolencias",
          "y se confabulan los que hacen iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A tu pueblo, oh SEÑOR, quebrantan;",
          "a tu heredad afligen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A la viuda y al forastero matan;",
          "a los huérfanos asesinan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Han dicho: “No lo verá el SEÑOR,",
          "ni entenderá el Dios de Jacob”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Entiendan, torpes del pueblo;",
          "ustedes, necios, ¿cuándo serán entendidos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El que puso el oído, ¿no oirá?",
          "El que formó el ojo, ¿no verá?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El que disciplina a las naciones, ¿no reprenderá?",
          "¿No sabrá el que enseña al hombre el saber?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El SEÑOR conoce los pensamientos de los hombres, que son vanidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Bienaventurado el hombre",
          "a quien tú, oh SEÑOR, disciplinas",
          "y lo instruyes sobre la base de tu ley"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "para darle tranquilidad en los días de la desgracia;",
          "en tanto que para los impíos se cava una fosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque el SEÑOR no abandonará a su pueblo",
          "ni desamparará a su heredad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Más bien, el derecho volverá a la justicia,",
          "y en pos de ella irán todos los rectos de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¿Quién se levantará por mí contra los malhechores?",
          "¿Quién estará por mí contra los que hacen iniquidad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Si el SEÑOR no me ayudara",
          "pronto mi alma moraría en el silencio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cuando yo decía: “Mi pie resbala”,",
          "tu misericordia, oh SEÑOR, me sustentaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "En la multitud de mis pensamientos dentro de mí",
          "tus consolaciones alegraban mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Se aliará contigo el trono de maldad,",
          "el que por decreto instituye el abuso?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Conspiran contra la vida del justo",
          "y condenan la sangre inocente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Pero el SEÑOR ha sido mi refugio;",
          "mi Dios ha sido la roca de mi confianza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Él hará volver sobre ellos",
          "su iniquidad,",
          "y los destruirá a causa de su maldad.",
          "El SEÑOR, nuestro Dios, los destruirá."
        ],
        "rlw_lines": []
      }
    ]
  },
