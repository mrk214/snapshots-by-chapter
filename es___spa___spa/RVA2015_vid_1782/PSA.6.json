    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración en tiempo de prueba"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Con Neguinot. Sobre Seminit. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, no me reprendas en tu furor",
          "ni me castigues en tu ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ten misericordia de mí, oh SEÑOR, porque desfallezco.",
          "Sáname, oh SEÑOR, porque mis huesos están abatidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "También mi alma está muy turbada;",
          "y tú, oh SEÑOR, ¿hasta cuándo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Vuelve, oh SEÑOR; libra mi alma.",
          "Sálvame por tu misericordia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "porque en la muerte no hay memoria de ti;",
          "¿quién te alabará en el Seol?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Me he agotado de tanto gemir.",
          "Toda la noche inundo mi cama",
          "y con mis lágrimas empapo mi lecho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mis ojos están debilitados por el pesar;",
          "se han envejecido a causa de todos mis adversarios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Apártense de mí todos los que obran iniquidad,",
          "porque el SEÑOR ha oído la voz de mi llanto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡El SEÑOR ha escuchado mi ruego!",
          "¡El SEÑOR ha aceptado mi oración!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todos mis enemigos se avergonzarán y se aterrarán.",
          "Retrocederán y, de repente, serán avergonzados."
        ],
        "rlw_lines": []
      }
    ]
  },
