    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El hombre piadoso"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, ¿quién habitará en tu tabernáculo?",
          "¿Quién residirá en tu santo monte?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El que anda en integridad y hace justicia,",
          "el que habla verdad en su corazón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "el que no calumnia con su lengua",
          "ni hace mal a su prójimo",
          "ni hace agravio a su vecino;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "aquel ante cuyos ojos es menospreciado el vil",
          "pero que honra a los que temen al SEÑOR;",
          "aquel que, a pesar de haber jurado en perjuicio suyo, no por eso cambia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "aquel que no presta su dinero con usura",
          "ni contra el inocente acepta soborno.",
          "¡El que hace estas cosas no será movido jamás!"
        ],
        "rlw_lines": []
      }
    ]
  },
