    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Yo soy la rosa de Sarón y el lirio de los valles."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como un lirio entre los cardos",
          "es mi amada entre las jóvenes."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Como un manzano entre los árboles del bosque",
          "es mi amado entre los jóvenes.",
          "Me agrada sentarme bajo su sombra;",
          "su fruto es dulce a mi paladar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Él me lleva a la sala del banquete,",
          "y su bandera sobre mí es el amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Oh, agasájenme con pasas,",
          "refrésquenme con manzanas,",
          "porque estoy enferma de amor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Su brazo izquierdo está debajo de mi cabeza",
          "y su derecho me abraza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Júrenme, oh hijas de Jerusalén,",
          "por las ciervas",
          "y por las gacelas del campo,",
          "que no despertarán",
          "ni provocarán el amor",
          "hasta que quiera!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡La voz de mi amado!",
          "Él viene saltando sobre los montes,",
          "brincando sobre las colinas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mi amado es como un venado o un cervatillo.",
          "¡Miren! Está detrás de nuestra cerca",
          "mirando por las ventanas, atisbando por las celosías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mi amado habló y me dijo:",
          "“¡Levántate, oh amada mía!",
          "¡Oh hermosa mía, sal!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ya ha pasado el invierno,",
          "la estación de la lluvia se ha ido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Han brotado las flores en la tierra.",
          "El tiempo de la canción ha llegado,",
          "y de nuevo se escucha la tórtola en nuestra tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La higuera ha echado higos",
          "y despiden fragancia las vides en flor.",
          "¡Levántate, oh amada mía!",
          "¡Oh hermosa mía, ven!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Palomita mía que te escondes",
          "en las hendijas de la peña",
          "y en los sitios secretos de las terrazas:",
          "Déjame ver tu figura;",
          "hazme oír tu voz.",
          "Porque dulce es tu voz",
          "y preciosa tu figura."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Atrápennos las zorras,",
          "las zorras pequeñas",
          "que echan a perder las viñas,",
          "pues nuestras viñas están en flor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Mi amado es mío, y yo soy suya!",
          "Él apacienta entre los lirios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "hasta que raye el alba",
          "y huyan las sombras.",
          "¡Vuelve, oh amado mío!",
          "Sé semejante al venado o al cervatillo",
          "sobre los montes de las especias."
        ],
        "rlw_lines": []
      }
    ]
  },
