    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración para comenzar el día"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Para Nejilot. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Escucha, oh SEÑOR, mis palabras;",
          "considera mi suspiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Atiende a la voz de mi clamor,",
          "Rey mío y Dios mío, porque a ti oraré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Oh SEÑOR, de mañana oirás mi voz;",
          "de mañana me presentaré ante ti y esperaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque tú no eres un Dios que se complace en la perversidad;",
          "la maldad no habitará junto a ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los arrogantes no se presentarán ante tus ojos;",
          "aborreces a los que obran iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Destruirás a los que hablan mentira;",
          "al hombre sanguinario y engañador abomina el SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pero yo, por la abundancia de tu gracia, entraré en tu casa",
          "y en tu temor me postraré hacia tu santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Guíame, oh SEÑOR, en tu justicia a causa de mis enemigos.",
          "Endereza tu camino delante de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque no hay sinceridad en su boca;",
          "sus entrañas están llenas de destrucción.",
          "Su garganta es un sepulcro abierto,",
          "y con su lengua hablan lisonjas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Decláralos culpables, oh Dios;",
          "caigan por sus propios consejos.",
          "Échalos por la multitud de sus rebeliones,",
          "porque se rebelaron contra ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Se alegrarán todos los que confían en ti;",
          "para siempre gritarán de júbilo,",
          "pues tú los proteges.",
          "Los que aman tu nombre se regocijarán en ti,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "porque tú, oh SEÑOR, bendecirás al justo;",
          "como un escudo lo rodearás con tu favor."
        ],
        "rlw_lines": []
      }
    ]
  },
