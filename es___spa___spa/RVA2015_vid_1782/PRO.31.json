    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Palabras de Lemuel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palabras de Lemuel, rey de Masá, que le enseñara su madre:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Oh, hijo mío!",
          "¡Oh, hijo de mi vientre!",
          "¡Oh, hijo de mis votos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No des a las mujeres tu fuerza",
          "ni tus caminos a las que destruyen",
          "a los reyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No es cosa de reyes, oh Lemuel,",
          "no es cosa de reyes beber vino",
          "ni de los magistrados el licor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "No sea que bebiendo olviden lo que",
          "se ha decretado",
          "y perviertan el derecho de todos los afligidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Den licor al que va a perecer,",
          "y vino a los de ánimo amargado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Beban y olvídense de su necesidad,",
          "y no se acuerden más de su miseria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Abre tu boca por el mudo",
          "en el juicio de todos los desafortunados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Abre tu boca, juzga con justicia",
          "y defiende al pobre y al necesitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Elogio de la mujer virtuosa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mujer virtuosa, ¿quién la hallará? Porque su valor sobrepasa a las perlas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Confía en ella el corazón de su marido, y no carecerá de ganancias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Le recompensará con bien y no con mal",
          "todos los días de su vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Busca lana y lino",
          "y con gusto teje con sus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Es como un barco mercante",
          "que trae su pan de lejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Se levanta siendo aún de noche,",
          "y da de comer a su familia",
          "y su diaria ración a sus criadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Evalúa un campo y lo compra,",
          "y con sus propias manos planta una viña."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ciñe su cintura con firmeza",
          "y esfuerza sus brazos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Comprueba que le va bien en",
          "el negocio,",
          "y no se apaga su lámpara en la noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Su mano aplica a la rueca,",
          "y sus dedos toman el huso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Sus manos extiende al pobre",
          "y tiende sus manos al necesitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No teme por su familia a causa",
          "de la nieve",
          "porque toda su familia está vestida",
          "de ropa doble ."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Tapices hace para sí,",
          "y se viste de lino fino y púrpura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Es conocido su marido en las puertas de la ciudad,",
          "cuando se sienta con los ancianos del país."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Telas hace y las vende;",
          "entrega cintas al mercader."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Fuerza y honor son su vestidura,",
          "y se ríe de lo porvenir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Su boca abre con sabiduría,",
          "y la ley de la misericordia está",
          "en su lengua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Considera la marcha de su casa",
          "y no come pan de ociosidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Se levantan sus hijos",
          "y le llaman: “Bienaventurada”.",
          "Y su marido también la alaba:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "“Muchas mujeres han hecho el bien, pero tú sobrepasas a todas”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Engañosa es la gracia y vana es",
          "la hermosura;",
          "la mujer que teme al SEÑOR, ella será alabada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "¡Denle del fruto de sus manos,",
          "y en las puertas de la ciudad alábenla sus hechos!"
        ],
        "rlw_lines": []
      }
    ]
  },
