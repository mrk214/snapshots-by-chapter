    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR, protector de su pueblo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. De los hijos de Coré. Sobre Alamot. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios es nuestro amparo y fortaleza,",
          "nuestro pronto auxilio en las tribulaciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Por eso no temeremos aunque la tierra tiemble,",
          "aunque los montes se derrumben en el corazón del mar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "aunque sus aguas rujan y echen espuma,",
          "y se estremezcan los montes por su braveza. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Hay un río cuyas corrientes alegran la ciudad de Dios;",
          "el santuario, morada del Altísimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios está en medio de ella;",
          "no será movida.",
          "Dios la ayudará al clarear la mañana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Las naciones se conmocionan,",
          "se tambalean los reinos.",
          "Él emite su voz, y se derrite la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El SEÑOR de los Ejércitos está con nosotros;",
          "nuestro refugio es el Dios de Jacob. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Vengan y vean los hechos del SEÑOR,",
          "quien ha causado desolaciones en la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Hasta los confines de la tierra hace cesar las guerras;",
          "quiebra el arco, rompe la lanza",
          "y quema los carros en el fuego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Estén quietos y reconozcan que yo soy Dios.",
          "Exaltado he de ser entre las naciones;",
          "exaltado seré en la tierra”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El SEÑOR de los Ejércitos está con nosotros;",
          "nuestro refugio es el Dios de Jacob. Selah"
        ],
        "rlw_lines": []
      }
    ]
  },
