    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Creación y providencia de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Bendice, alma mía, al SEÑOR!",
          "SEÑOR, Dios mío, qué ¡grande eres!",
          "Te has vestido de gloria y de esplendor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tú eres el que se cubre de luz como de vestidura,",
          "que extiende los cielos como una tienda,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "que construye sus altas moradas sobre las aguas,",
          "que hace de las nubes su carroza,",
          "que anda sobre las alas del viento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "que hace a los vientos sus mensajeros",
          "y a las llamas de fuego sus servidores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Él fundó la tierra sobre sus cimientos;",
          "no será jamás removida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Con el océano, como con vestido,",
          "la cubriste;",
          "sobre las montañas estaban las aguas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A tu reprensión huyeron;",
          "se apresuraron al sonido de tu trueno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Subieron las montañas;",
          "descendieron los valles",
          "al lugar que tú estableciste para ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Les pusiste un límite,",
          "el cual no traspasarán",
          "ni volverán a cubrir la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tú eres el que vierte los manantiales en los arroyos;",
          "corren entre las colinas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dan de beber a todos los animales del campo;",
          "los asnos monteses mitigan su sed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Junto a ellos habitan las aves del cielo",
          "y trinan entre las ramas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tú das de beber a las montañas desde tus altas moradas;",
          "del fruto de tus obras se sacia la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Haces producir el pasto para los animales",
          "y la vegetación para el servicio del hombre",
          "a fin de sacar de la tierra el alimento:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "el vino que alegra el corazón del hombre,",
          "el aceite que hace lucir su rostro,",
          "y el pan que sustenta el corazón del hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Se llenan de savia los árboles del SEÑOR;",
          "los cedros del Líbano que él plantó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Allí anidan las aves;",
          "en sus copas hace su nido la cigüeña."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Los montes altos son para las cabras monteses;",
          "las peñas, para las madrigueras de los conejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Tú eres el que hizo la luna para las estaciones;",
          "el sol conoce su ocaso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Pones las tinieblas, y es de noche;",
          "en ella corretean todos los animales silvestres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Los leones rugen por la presa",
          "y reclaman a Dios su comida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Sale el sol; se recogen",
          "y se echan en sus cuevas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Sale el hombre a su labor",
          "y a su labranza hasta el anochecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¡Cuán numerosas son tus obras, oh SEÑOR!",
          "A todas las hiciste con sabiduría;",
          "la tierra está llena de tus criaturas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Este es el mar grande y ancho,",
          "en el cual hay peces sin número,",
          "animales grandes y pequeños."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Sobre él van los navíos;",
          "allí está el Leviatán",
          "que hiciste para que jugase en él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Todos ellos esperan en ti",
          "para que les des su comida a su tiempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Tú les das, y ellos recogen;",
          "abres tu mano, y se sacian del bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Escondes tu rostro, y se desvanecen;",
          "les quitas el aliento, y dejan de ser.",
          "Así vuelven a ser polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Envías tu hálito, y son creados;",
          "y renuevas la superficie de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "¡Sea la gloria del SEÑOR para siempre!",
          "Alégrese el SEÑOR en sus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Él mira la tierra, y ella tiembla;",
          "toca las montañas, y humean."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Cantaré al SEÑOR en mi vida;",
          "a mi Dios cantaré salmos mientras viva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Que mi meditación le sea grata",
          "y que yo me alegre en el SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Sean exterminados de la tierra los pecadores,",
          "y los impíos dejen de ser.",
          "¡Bendice, oh alma mía, al SEÑOR!",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
