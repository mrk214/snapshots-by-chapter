    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica contra los opresores de Sion"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canto de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Mucho me han angustiado desde mi juventud”;",
          "dígalo, por favor, Israel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“mucho me han angustiado desde mi juventud",
          "pero no han prevalecido contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Los aradores araron sobre mis espaldas;",
          "hicieron largos sus surcos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero el SEÑOR es justo;",
          "cortó las cuerdas de los impíos”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sean avergonzados y vueltos atrás",
          "todos los que aborrecen a Sion."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sean como la hierba sobre los techos,",
          "que se seca antes que crezca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "De ella no llena su mano el segador,",
          "ni su regazo el que hace gavillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tampoco dicen los que pasan:",
          "“La bendición del SEÑOR sea sobre ustedes;",
          "los bendecimos en el nombre del SEÑOR”."
        ],
        "rlw_lines": []
      }
    ]
  },
