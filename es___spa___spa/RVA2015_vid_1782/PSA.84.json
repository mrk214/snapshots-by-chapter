    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Anhelo por la casa de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Guitit. Para los hijos de Coré. Salmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Cuán amables son tus moradas,",
          "oh SEÑOR de los Ejércitos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi alma anhela y aun desea",
          "ardientemente los atrios del SEÑOR.",
          "Mi corazón y mi carne cantan con gozo al Dios vivo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Hasta el pajarito halla una casa",
          "y la golondrina un nido para sí",
          "donde poner sus polluelos cerca de tus altares,",
          "oh SEÑOR de los Ejércitos,",
          "¡Rey mío y Dios mío!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Bienaventurados los que habitan en tu casa!",
          "Continuamente te alabarán.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Bienaventurado el hombre que tiene en ti sus fuerzas",
          "y en cuyo corazón están tus caminos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cuando pasan por el valle de lágrimas",
          "lo convierten en manantial.",
          "También la lluvia temprana lo cubre de bendición."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Irán de poder en poder",
          "y verán a Dios en Sion."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oh SEÑOR Dios de los Ejércitos,",
          "oye mi oración.",
          "Escucha, oh Dios de Jacob.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mira, oh Dios, escudo nuestro;",
          "pon tu vista en el rostro de tu ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque mejor es un día en tus atrios que",
          "mil fuera de ellos.",
          "Prefiero estar en el umbral de la casa de mi Dios",
          "que habitar en moradas de impiedad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque sol y escudo es el SEÑOR Dios;",
          "gracia y gloria dará el SEÑOR.",
          "No privará del bien",
          "a los que andan en integridad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Oh SEÑOR de los Ejércitos,",
          "¡bienaventurado el hombre que confía en ti!"
        ],
        "rlw_lines": []
      }
    ]
  },
