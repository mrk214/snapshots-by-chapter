    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR, protector de los pobres"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Seminit. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Salva, oh SEÑOR,",
          "porque se han acabado los piadosos.",
          "Han desaparecido los fieles de entre los hijos del hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cada uno habla falsedad con su prójimo, con labios lisonjeros;",
          "hablan con doblez de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El SEÑOR destruirá todos los labios lisonjeros,",
          "la lengua que habla grandezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dijeron: “Por nuestra lengua prevaleceremos.",
          "Si nuestros labios están a nuestro favor,",
          "¿quién más se hará nuestro señor?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dice el SEÑOR: “Por la opresión de los pobres,",
          "por el gemido de los necesitados",
          "me levantaré ahora.",
          "Los pondré a salvo del que se ensaña contra ellos”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Las palabras del SEÑOR son palabras puras",
          "como plata purificada en horno de tierra, siete veces refinada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tú, oh SEÑOR, los guardarás.",
          "Guárdalos para siempre de esta generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los impíos andan alrededor,",
          "pero tú desprecias a los hijos del hombre."
        ],
        "rlw_lines": []
      }
    ]
  },
