    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración pidiendo vindicación"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Sigayón de David, que cantó al SEÑOR con respecto a las palabras de Cus el benjamita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, Dios mío, en ti me he refugiado.",
          "Sálvame de todos los que me persiguen y líbrame."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "No sea que arrebaten mi alma",
          "como el león que despedaza,",
          "sin que haya quien libre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Oh SEÑOR, Dios mío,",
          "si yo he hecho esto,",
          "si hay en mis manos iniquidad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "si recompensé mal al que estaba en paz conmigo,",
          "si despojé sin razón a mi adversario,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "entonces persiga el enemigo a mi alma,",
          "y que la alcance;",
          "pise en tierra mi vida,",
          "y mi honor eche por tierra. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Levántate, oh SEÑOR, con tu furor!",
          "Álzate contra la ira de mis angustiadores,",
          "y despierta, Dios mío, el juicio que has ordenado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Entonces te rodeará la congregación de los pueblos,",
          "y hacia ella vuélvete en lo alto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El SEÑOR juzgará a los pueblos;",
          "júzgame, oh SEÑOR, de acuerdo",
          "con mi justicia y mi integridad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Acábese ya la maldad de los impíos,",
          "y establece al justo;",
          "pues el Dios justo pone a prueba",
          "los corazones y las conciencias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mi escudo está en Dios,",
          "quien salva a los de recto corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios es el que juzga al justo;",
          "es un Dios que emite sentencia cada día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si el impío no se arrepiente",
          "afilará su espada;",
          "ha dispuesto su arco y lo ha preparado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "También ha alistado para sí",
          "armas de muerte",
          "y ha hecho incendiarias sus flechas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "He aquí que gesta maldad,",
          "concibe afanes y da a luz mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Cava un pozo y lo ahonda;",
          "pero en la fosa que hace caerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Su afán se volverá contra su propia cabeza;",
          "y la violencia que ha practicado recaerá sobre su coronilla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pero yo alabaré al SEÑOR por su justicia,",
          "y cantaré al nombre del SEÑOR el Altísimo."
        ],
        "rlw_lines": []
      }
    ]
  },
