    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contraste entre el SEÑOR y los ídolos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No a nosotros, oh SEÑOR, no a nosotros,",
          "sino a tu nombre da gloria",
          "por tu misericordia y tu verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Por qué han de decir las naciones:",
          "“¿Dónde está su Dios?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Nuestro Dios está en los cielos!",
          "¡Ha hecho todo lo que ha querido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Los ídolos de ellos son de plata y oro,",
          "obra de manos de hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tienen boca pero no hablan;",
          "tienen ojos pero no ven;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "tienen orejas pero no oyen;",
          "tienen nariz pero no huelen;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "tienen manos pero no palpan;",
          "tienen pies pero no andan;",
          "no emiten sonido con su garganta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como ellos, son los que los hacen",
          "y todos los que en ellos confían."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Oh Israel, confía en el SEÑOR!",
          "Él es su ayuda y su escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Oh casa de Aarón, confía en el SEÑOR!",
          "Él es su ayuda y su escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Los que temen al SEÑOR, confíen en el SEÑOR!",
          "Él es su ayuda y su escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El SEÑOR se acuerda de nosotros;",
          "él nos bendecirá.",
          "Bendecirá a la casa de Israel,",
          "bendecirá a la casa de Aarón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Bendecirá a los que temen al SEÑOR,",
          "a pequeños y a grandes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El SEÑOR aumentará bendición sobre ustedes;",
          "sobre ustedes y sobre los hijos de ustedes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Benditos sean del SEÑOR",
          "quien hizo los cielos y la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los cielos de los cielos son del SEÑOR;",
          "pero él ha dado la tierra a los hijos del hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No alaban al SEÑOR los muertos",
          "ni cuantos descienden al silencio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero nosotros bendeciremos al SEÑOR",
          "desde ahora y para siempre.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
