    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Experiencia de la dicha del perdón"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David. Masquil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bienaventurado aquel",
          "cuya transgresión ha sido perdonada",
          "y ha sido cubierto su pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bienaventurado el hombre a quien el SEÑOR no atribuye iniquidad,",
          "y en cuyo espíritu no hay engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mientras callé se envejecieron mis huesos en mi gemir todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque de día y de noche se agravó sobre mí tu mano;",
          "mi vigor se convirtió en sequedades de verano. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mi pecado te declaré",
          "y no encubrí mi iniquidad.",
          "Dije: “Confesaré mis rebeliones al SEÑOR”.",
          "Y tú perdonaste la maldad de mi pecado. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por eso orará a ti todo fiel",
          "en el tiempo en que puedas ser hallado.",
          "Ciertamente en la inundación las caudalosas aguas no llegarán a él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tú eres mi refugio;",
          "me guardarás de la angustia",
          "y con cánticos de liberación me rodearás. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Te haré entender y te enseñaré",
          "el camino en que debes andar.",
          "Sobre ti fijaré mis ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No sean sin entendimiento",
          "como el caballo o como el mulo,",
          "cuya boca ha de ser frenada con rienda y freno;",
          "de otro modo, no se acercan a ti”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Muchos dolores tendrá el impío;",
          "pero la misericordia cercará al que espera en el SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Oh justos, alégrense en el SEÑOR y gócense;",
          "canten con júbilo todos los rectos de corazón."
        ],
        "rlw_lines": []
      }
    ]
  },
