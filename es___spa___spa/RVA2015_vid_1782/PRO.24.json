    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—19—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No tengas envidia de los hombres malos",
          "ni desees estar con ellos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "porque su corazón trama violencia,",
          "y sus labios hablan iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—20—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Con sabiduría se edifica la casa",
          "y con prudencia se afirma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Con conocimiento se llenan los cuartos de todo bien preciado y agradable."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—21—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Más vale el sabio que el fuerte ;",
          "y el hombre de conocimiento",
          "que el de vigor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque con estrategia harás la guerra,",
          "y en los muchos consejeros",
          "está la victoria."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—22—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Muy alta está la sabiduría para el insensato;",
          "en la puerta de la ciudad no abrirá",
          "su boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—23—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Al que planea hacer el mal",
          "lo llamarán hombre de malas",
          "intenciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "La intención del insensato es pecado,",
          "y el burlador es abominación a los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—24—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Si desmayas en el día de la dificultad, también tu fuerza se reducirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—25—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Libra a los que son llevados a la muerte; no dejes de librar a los que van tambaleando a la matanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si dices: “En verdad no lo supimos”, ¿no lo entenderá el que examina los corazones?",
          "El que vigila tu alma él lo sabrá",
          "y recompensará al hombre según sus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—26—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Come, hijo mío, de la miel, porque",
          "es buena;",
          "y del panal que es dulce a tu paladar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Así será el conocimiento de la sabiduría para tu alma.",
          "Si la hallas, habrá un porvenir,",
          "y tu esperanza no será frustrada."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—27—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Oh impío, no aceches la morada del justo ni destruyas su lugar de reposo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "porque siete veces cae el justo y se vuelve a levantar,",
          "pero los impíos tropezarán en el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—28—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No te alegres cuando caiga tu enemigo; y cuando tropiece no se regocije",
          "tu corazón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "no sea que lo vea el SEÑOR",
          "y le desagrade,",
          "y aparte de él su enojo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—29—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "No te enfurezcas a causa",
          "de los malhechores",
          "ni tengas envidia de los impíos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "porque no habrá un buen porvenir para el malo,",
          "y la lámpara de los impíos",
          "será apagada."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "—30—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Hijo mío, teme al SEÑOR y al rey,",
          "y no te asocies con los inestables."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Porque su calamidad surgirá",
          "de repente,",
          "y el castigo que procede de ambos, ¡quién lo puede saber!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Otros dichos de los sabios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "También los siguientes dichos pertenecen a los sabios:",
          "No es bueno hacer distinción de personas en el juicio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Al que dice al impío: “Eres justo”, los pueblos lo maldecirán;",
          "las naciones lo detestarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Pero los que lo reprenden",
          "serán apreciados,",
          "y sobre ellos vendrá la bendición del bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Besados serán los labios",
          "del que responde palabras correctas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Ordena tus labores afuera;",
          "ocúpate en ellas en el campo.",
          "Y después edifícate una casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "No testifiques sin causa contra",
          "tu prójimo",
          "ni le engañes con tus labios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "No digas: “Como me hizo, así le haré a él;",
          "recompensaré al hombre según",
          "su acción”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Pasé junto al campo de un hombre perezoso",
          "y junto a la viña de un hombre falto",
          "de entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Y he aquí que por todos lados habían crecido ortigas;",
          "los cardos habían cubierto el área,",
          "y su cerco de piedra estaba destruido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Yo observé esto y lo medité",
          "en mi corazón;",
          "lo vi y saqué esta enseñanza:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Un poco de dormir, un poco",
          "de dormitar",
          "y un poco de cruzar las manos para reposar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Así vendrá tu pobreza como",
          "un vagabundo,",
          "y tu escasez como un hombre armado."
        ],
        "rlw_lines": []
      }
    ]
  },
