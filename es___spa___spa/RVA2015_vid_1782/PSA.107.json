    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Libro V: Salmos 107—150"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Salmo de gratitud por la liberación"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Alaben al SEÑOR, porque es bueno;",
          "porque para siempre es su misericordia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Díganlo los redimidos del SEÑOR,",
          "los que ha redimido del poder del enemigo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "y los que ha congregado de las tierras",
          "del oriente y del occidente,",
          "del norte y del sur."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Perdidos anduvieron por el desierto, en el sequedal;",
          "no hallaron camino hacia una ciudad habitada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Estaban hambrientos y sedientos;",
          "sus almas desfallecían en ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pero cuando en su angustia clamaron al SEÑOR,",
          "él los libró de sus aflicciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Los dirigió por camino derecho",
          "para que fuesen a una ciudad en que habitar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Den gracias al SEÑOR por su misericordia",
          "y por sus maravillas para con los hijos del hombre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque él sacia al alma sedienta",
          "y llena de bien al alma hambrienta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Habitaban en tinieblas y en densa oscuridad,",
          "aprisionados en la miseria y en cadenas de hierro,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "porque fueron rebeldes a las palabras del SEÑOR",
          "y aborrecieron el consejo del Altísimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por eso sometió el corazón de ellos con dura labor;",
          "cayeron, y no hubo quien les ayudase."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pero cuando en su angustia clamaron al SEÑOR,",
          "él los libró de sus aflicciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los sacó de las tinieblas, de la densa oscuridad,",
          "y rompió sus cadenas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Den gracias al SEÑOR por su misericordia",
          "y por sus maravillas para con los hijos del hombre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque rompió las puertas de bronce",
          "y desmenuzó los cerrojos de hierro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Fueron afligidos los insensatos",
          "a causa de su camino rebelde",
          "y a causa de sus maldades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Su alma abominó toda comida,",
          "y llegaron hasta las puertas de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pero cuando en su angustia clamaron al SEÑOR,",
          "él los libró de sus aflicciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Envió su palabra y los sanó;",
          "los libró de su ruina."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Den gracias al SEÑOR por su misericordia",
          "y por sus maravillas para con los hijos del hombre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ofrezcan sacrificios de acción de gracias",
          "y proclamen sus obras con júbilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Los que descienden al mar en los barcos",
          "y hacen negocios en los océanos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "ellos han visto las obras del SEÑOR",
          "y sus maravillas en lo profundo del mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Él habló y desató el viento de la tempestad,",
          "e hizo que se elevaran sus olas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Subieron los cielos, descendieron los abismos;",
          "su alma se derretía con el daño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Se tambalearon y temblaron como un borracho,",
          "y toda su sabiduría se echó a perder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Pero cuando en su angustia clamaron al SEÑOR,",
          "él los libró de sus aflicciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Él trae calma a la tempestad,",
          "y se apaciguan sus olas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Entonces se alegran porque ellas se aquietan,",
          "y él los guía al puerto que desean."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "¡Den gracias al SEÑOR por su misericordia",
          "y por sus maravillas para con los hijos del hombre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Exáltenlo en la congregación del pueblo",
          "y alábenlo en la reunión de los ancianos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Él convierte los ríos en desierto",
          "y las fuentes de aguas en tierra sedienta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Convierte las tierras fértiles en salobres",
          "por la maldad de los que las habitan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Convierte el desierto en estanques de agua",
          "y la tierra seca en manantiales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Allí establece a los hambrientos",
          "y fundan una ciudad en que habitar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Siembran campos, plantan viñas",
          "y logran abundante fruto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Los bendice, y se multiplican en gran manera;",
          "y no deja que disminuya su ganado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Cuando son reducidos en número y menoscabados",
          "a causa de la opresión, de la calamidad y de la congoja,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "derrama menosprecio sobre los príncipes,",
          "y les hace andar errantes, vagabundos, sin camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Y levanta de la miseria al necesitado",
          "y hace multiplicar las familias como rebaños de ovejas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Véanlo los rectos y alégrense;",
          "pero toda maldad cierre la boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Quien sea sabio y guarde estas cosas",
          "entenderá los hechos misericordiosos del SEÑOR."
        ],
        "rlw_lines": []
      }
    ]
  },
