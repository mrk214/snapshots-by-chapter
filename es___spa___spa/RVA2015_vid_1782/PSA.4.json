s":[7],"lines":["Tú has dado tal alegría a mi corazón","que sobrepasa a la alegría que ellos tienen con motivo de su siega y de su vendimia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["En paz me acostaré y dormiré;","porque solo tú, oh SEÑOR,","me haces vivir seguro."],"rlw_lines":[]}]}}