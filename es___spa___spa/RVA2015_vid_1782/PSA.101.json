    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Votos de un gobernante"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "De la misericordia y el derecho cantaré;",
          "a ti cantaré salmos, oh SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Daré atención al camino de la integridad.",
          "¿Cuándo vendrás a mí?",
          "En integridad de corazón andaré en medio de mi casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No pondré delante de mis ojos cosa indigna;",
          "aborrezco la obra de los que se desvían.",
          "Ella no se me pegará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El corazón perverso será apartado de mí;",
          "no reconoceré al malo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Al que solapadamente difama a su prójimo,",
          "a ese yo lo silenciaré;",
          "no soportaré al de ojos altaneros y de corazón arrogante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mis ojos pondré en los fieles de la tierra",
          "para que habiten conmigo.",
          "El que anda en camino de integridad,",
          "ese me servirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "No habitará dentro de mi casa el que hace fraude;",
          "el que habla mentira no se afirmará delante de mis ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por las mañanas cortaré de la tierra a todos los impíos",
          "para extirpar de la ciudad del SEÑOR a todos los que obran iniquidad."
        ],
        "rlw_lines": []
      }
    ]
  },
