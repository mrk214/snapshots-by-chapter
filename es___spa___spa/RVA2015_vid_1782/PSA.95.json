    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Llamado a la adoración"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Vengan, cantemos con gozo al SEÑOR!",
          "Aclamemos con júbilo a la roca de nuestra salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Acerquémonos ante su presencia con acción de gracias;",
          "aclamémosle con salmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque el SEÑOR es Dios grande,",
          "Rey grande sobre todos los dioses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En su mano están las profundidades de la tierra;",
          "suyas son las alturas de los montes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Suyo es el mar, pues él lo hizo;",
          "y sus manos formaron la tierra seca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Vengan, adoremos y postrémonos!",
          "Arrodillémonos delante del SEÑOR, nuestro Hacedor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque él es nuestro Dios;",
          "nosotros somos el pueblo de su prado",
          "y las ovejas de su mano.",
          "Si oyen hoy su voz"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“no endurezcan sus corazones como en Meriba;",
          "como el día de Masá, en el desierto,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "donde sus padres me pusieron a prueba;",
          "me probaron y vieron mis obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cuarenta años estuve disgustado con aquella generación",
          "y dije: ‘Este pueblo se desvía en su corazón",
          "y no ha conocido mis caminos’."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por eso juré en mi ira:",
          "‘¡Jamás entrarán en mi reposo!’”."
        ],
        "rlw_lines": []
      }
    ]
  },
