    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Libro IV: Salmos 90—106"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El Dios eterno y el hombre fugaz"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oración de Moisés, hombre de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, tú has sido nuestro refugio",
          "de generación en generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Antes que nacieran los montes",
          "y formaras la tierra y el mundo,",
          "desde la eternidad hasta la eternidad,",
          "tú eres Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Haces que el hombre vuelva al polvo.",
          "Dices: “¡Retornen, oh hijos del hombre!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pues mil años delante de tus ojos",
          "son como el día de ayer, que pasó.",
          "Son como una de las vigilias de la noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los arrasas; son como un sueño:",
          "En la mañana son como la hierba que crece;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "en la mañana brota y crece,",
          "y al atardecer se marchita y se seca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque con tu furor somos consumidos",
          "y con tu ira somos turbados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Has puesto nuestras maldades delante de ti;",
          "nuestros secretos están ante la luz de tu rostro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pues todos nuestros días pasan a causa de tu ira;",
          "acabamos nuestros años como un suspiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los días de nuestra vida son setenta años;",
          "y en los más robustos, ochenta años.",
          "La mayor parte de ellos es duro trabajo y vanidad;",
          "pronto pasan, y volamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Quién conoce el poder de tu ira y de tu indignación,",
          "como debes ser temido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Enséñanos a contar nuestros días",
          "de tal manera que traigamos al corazón sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Vuelve, oh SEÑOR!",
          "¿Hasta cuándo?",
          "Ten compasión de tus siervos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Por la mañana sácianos de tu misericordia,",
          "y cantaremos y nos alegraremos todos nuestros días."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Alégranos conforme a los días de nuestra aflicción",
          "y a los años en que hemos visto el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Sea manifestada tu obra",
          "a tus siervos",
          "y tu esplendor sobre sus hijos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sea sobre nosotros la gracia del SEÑOR nuestro Dios.",
          "La obra de nuestras manos confirma entre nosotros;",
          "sí, confirma la obra de nuestras manos."
        ],
        "rlw_lines": []
      }
    ]
  },
