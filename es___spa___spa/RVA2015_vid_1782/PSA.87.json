    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Canto a Jerusalén, ciudad de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "A los hijos de Coré. Salmo. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Su cimiento está sobre montes de santidad;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "el SEÑOR ama las puertas de Sion",
          "más que a todas las moradas de Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Cosas gloriosas se cuentan de ti,",
          "oh ciudad de Dios! Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Yo inscribiré a Rahab",
          "y a Babilonia entre los que me conocen.",
          "He aquí Filistea, Tiro y Etiopía.",
          "Se dirá: “Este nació allí”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "De Sion se dirá:",
          "“Este y aquel han nacido en ella”.",
          "El mismo Altísimo le dará estabilidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El SEÑOR dirá, al inscribir a los pueblos: Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Y tanto los que cantan como los que danzan dirán:",
          "“¡Todas mis fuentes están en ti!”."
        ],
        "rlw_lines": []
      }
    ]
  },
