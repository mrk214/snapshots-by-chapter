    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La liberación divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mi corazón está firme, oh Dios;",
          "cantaré y entonaré salmos aun con mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Despierten, oh arpa y lira!",
          "Despertaré al alba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Te alabaré entre los pueblos, oh SEÑOR;",
          "a ti cantaré salmos entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque grande, más que los cielos, es tu misericordia;",
          "y hasta las nubes, tu verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Seas exaltado sobre los cielos, oh Dios;",
          "y sobre toda la tierra, tu gloria!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Salva con tu diestra y respóndenos",
          "de modo que sean librados tus amados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios ha hablado en su santuario:",
          "“¡Cómo me regocijo!",
          "Repartiré a Siquem",
          "y mediré el valle de Sucot."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mío es Galaad y mío es Manasés.",
          "Efraín es la fortaleza de mi cabeza;",
          "Judá es mi cetro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Moab es la vasija en que me lavo;",
          "sobre Edom echaré mis sandalias,",
          "y sobre Filistea lanzaré mi grito de victoria”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Quién me guiará a la ciudad fortificada?",
          "¿Quién me conducirá hasta Edom?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿No serás tú, oh Dios, que nos habías desechado,",
          "y que ya no sales, oh Dios, con nuestros ejércitos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Danos socorro ante el enemigo",
          "pues vana es la liberación que da el hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Con Dios haremos proezas,",
          "y él aplastará a nuestros enemigos."
        ],
        "rlw_lines": []
      }
    ]
  },
