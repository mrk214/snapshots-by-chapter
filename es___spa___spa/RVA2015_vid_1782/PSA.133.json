    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La dulce armonía fraternal"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canto de ascenso gradual . De David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡He aquí, cuán bueno y cuán agradable",
          "es que los hermanos habiten juntos en armonía!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Es como el buen aceite sobre la cabeza,",
          "el cual desciende sobre la barba, la barba de Aarón,",
          "y baja hasta el borde de sus vestiduras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Es como el rocío del Hermón",
          "que desciende sobre los montes de Sion;",
          "porque allá enviará el SEÑOR",
          "bendición y vida eterna."
        ],
        "rlw_lines": []
      }
    ]
  },
