    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Job responde a Bildad"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces respondió Job y dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "—¿Hasta cuándo angustiarán mi alma",
          "y me triturarán con palabras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ya me han injuriado diez veces. ¿No se avergüenzan de haberme atacado?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Si en verdad he errado",
          "conmigo permanecerá mi error."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero si en realidad ustedes se jactan contra mí",
          "y contra mí usan mi oprobio",
          "como argumento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "sepan, pues, que Dios me ha agraviado",
          "y me ha envuelto en su red."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»He aquí, aunque grito:",
          "“¡Violencia!”, no soy oído;",
          "doy voces, y no hay justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Él ha cercado mi camino",
          "para que yo no pase;",
          "sobre mis senderos ha puesto tinieblas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Me ha desvestido de mi gloria",
          "y ha quitado la corona de mi cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por todos lados me despedaza,",
          "y me marcho;",
          "ha arrancado mi esperanza como",
          "a un árbol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Hace que su furor se inflame contra mí",
          "y me considera como a uno de sus adversarios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A una vienen sus tropas;",
          "allanan su camino contra mí",
          "y ponen sitio alrededor de mi morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Hizo que mis hermanos se alejaran",
          "de mí;",
          "mis amigos se apartaron por completo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Mis parientes me han fallado; mis conocidos me han olvidado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los que habitan en mi casa y mis criadas me consideran un extraño;",
          "he llegado a ser un extranjero ante sus ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Llamo a mi siervo, y no responde; con mi propia boca le tengo que rogar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Mi aliento ha venido a ser repulsivo",
          "a mi mujer,",
          "y apesto aun ante mis propios hijos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Aun los niños me desprecian;",
          "si me levanto hablan contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Todos mis amigos íntimos",
          "me abominan;",
          "aquellos a quienes amo se han vuelto contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Mis huesos se pegan a mi piel",
          "y a mi carne;",
          "he escapado apenas con la piel de mis dientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»¡Compadézcanse ustedes de mí! ¡Compadézcanse de mí,",
          "oh amigos míos!",
          "Porque la mano de Dios me ha tocado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¿Por qué me persiguen como lo hace Dios?",
          "¿No se satisfacen con mi carne?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "»¡Oh, que mis palabras fuesen escritas! ¡Oh, que fuesen grabadas en un libro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¡Que con cincel de hierro y de plomo fuesen cinceladas en la roca",
          "para siempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Pero yo sé que mi Redentor vive",
          "y que al final se levantará sobre el polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Y después que hayan deshecho esta",
          "mi piel,",
          "¡en mi carne he de ver a Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "a quien yo mismo he de ver!",
          "Lo verán mis ojos, y no los de otro.",
          "»Mi corazón se consume dentro de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Si dicen: “¿Cómo lo acosaremos?”,",
          "y “La raíz del asunto se halla en él”,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "teman por ustedes ante la espada. Porque la espada representa la ira contra las iniquidades,",
          "para que sepan que hay un juicio."
        ],
        "rlw_lines": []
      }
    ]
  },
