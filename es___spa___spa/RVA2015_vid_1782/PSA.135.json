    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Los grandes hechos de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya! . ¡Alaben el nombre del SEÑOR!",
          "Alábenle, oh siervos del SEÑOR,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "ustedes que están en la casa del SEÑOR,",
          "en los atrios de la casa de nuestro Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Alaben al SEÑOR porque el SEÑOR es bueno;",
          "canten salmos a su nombre porque es agradable."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque el SEÑOR ha escogido a Jacob para sí,",
          "a Israel como su especial tesoro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque yo sé que grande es el SEÑOR;",
          "nuestro Señor es más que todos los dioses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El SEÑOR ha hecho todo lo que ha querido",
          "en los cielos y en la tierra,",
          "en los mares y en todos los océanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él hace subir la neblina desde los extremos de la tierra.",
          "Hace los relámpagos para la lluvia",
          "y saca el viento de sus depósitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Él es quien hirió a los primogénitos de Egipto,",
          "tanto del hombre como del animal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Él envió señales y prodigios en medio de ti, oh Egipto;",
          "sobre el faraón y sobre todos sus servidores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Él derrotó a muchas naciones",
          "y dio muerte a reyes poderosos:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "a Sejón, rey de los amorreos,",
          "a Og, rey de Basán,",
          "y a todos los reinos de Canaán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Él dio la tierra de ellos en heredad,",
          "en heredad a Israel su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Oh SEÑOR, eterno es tu nombre;",
          "tu memoria, oh SEÑOR, de generación en generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ciertamente el SEÑOR juzgará a su pueblo",
          "y tendrá misericordia de sus siervos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los ídolos de las naciones son de plata y oro,",
          "obra de manos de hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tienen boca pero no hablan;",
          "tienen ojos pero no ven;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "tienen orejas pero no oyen;",
          "tampoco hay aliento en su boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Como ellos, son los que los hacen",
          "y todos los que en ellos confían."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Oh casa de Israel, bendigan al SEÑOR!",
          "¡Oh casa de Aarón, bendigan al SEÑOR!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Oh casa de Leví, bendigan al SEÑOR!",
          "¡Los que temen al SEÑOR, bendigan al SEÑOR!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Bendito sea el SEÑOR desde Sion!",
          "¡Él mora en Jerusalén! ¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
