    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Apelación a la justicia divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Dios de mi alabanza,",
          "no guardes silencio,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "pues la boca del impío y la del engañador",
          "se han abierto contra mí;",
          "han hablado contra mí con lengua engañosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Con palabras de odio me han rodeado;",
          "sin causa han luchado contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En pago de mi amor me han acusado,",
          "aunque yo oraba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me han devuelto mal por bien, y odio por amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Levanta contra él a un impío,",
          "y un acusador esté a su mano derecha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuando sea juzgado, que resulte culpable,",
          "y que su oración sea tenida por pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sean pocos sus días,",
          "y tome otro su oficio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Queden huérfanos sus hijos,",
          "y su mujer quede viuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Anden sus hijos vagabundos y mendigando;",
          "procuren su pan lejos de sus casas arruinadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Que el acreedor se apodere de todo lo que tiene,",
          "y extraños saqueen el fruto de su trabajo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "No tenga quien le haga misericordia",
          "ni haya quien se compadezca de sus huérfanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Su posteridad sea destruida;",
          "en la segunda generación sea borrado su nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sea recordada ante el SEÑOR la maldad de sus padres;",
          "no sea borrado el pecado de su madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Estén siempre delante del SEÑOR,",
          "y elimine él de la tierra la memoria de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque no se acordó de mostrar misericordia,",
          "y persiguió al hombre pobre, necesitado",
          "y quebrantado de corazón hasta matarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Amó la maldición; ¡que esta le venga!",
          "No quiso la bendición; ¡que se aleje de él!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Vístase de maldición como de su manto,",
          "y entre ella como agua en sus entrañas",
          "y como aceite en sus huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Séale como vestido que lo cubra,",
          "y como cinturón que siempre lo ciña."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Este sea el pago de parte del SEÑOR",
          "para con los que me acusan,",
          "para los que hablan mal contra mi vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Pero tú, oh SEÑOR Dios,",
          "favoréceme por amor de tu nombre;",
          "líbrame, porque buena es tu misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Yo soy pobre y necesitado,",
          "y mi corazón está herido dentro de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Voy como la sombra cuando se extiende;",
          "soy sacudido como la langosta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Mis rodillas están debilitadas a causa del ayuno,",
          "y mi carne está desfallecida por falta de alimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Fui para ellos objeto de oprobio;",
          "me miraban y movían la cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Ayúdame, oh SEÑOR, Dios mío;",
          "sálvame conforme a tu misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Entiendan que esta es tu mano",
          "y que tú, oh SEÑOR, has hecho esto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Que maldigan ellos, pero bendice tú;",
          "que se levanten pero sean avergonzados.",
          "Y que tu siervo se regocije."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Sean vestidos de ignominia los que me calumnian,",
          "y vístanse con su vergüenza como de manto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Agradeceré al SEÑOR en gran manera con mi boca;",
          "en medio de muchos le alabaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Porque él se pondrá a la derecha del necesitado",
          "para salvar su vida de los que le juzgan."
        ],
        "rlw_lines": []
      }
    ]
  },
