    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El retorno a Sion"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canto de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cuando el SEÑOR restauró de la cautividad a Sion",
          "nos parecía que soñábamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Entonces nuestra boca se llenó de risa;",
          "y nuestra lengua, de cantos de alegría.",
          "Entonces decían entre las naciones:",
          "“Grandes cosas ha hecho el SEÑOR con estos”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Grandes cosas ha hecho el SEÑOR con nosotros!",
          "Estamos alegres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Restáuranos, oh SEÑOR, de la cautividad",
          "como los arroyos en el Néguev."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los que siembran con lágrimas,",
          "con regocijo segarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El que va llorando,",
          "llevando la bolsa de semilla,",
          "volverá con regocijo",
          "trayendo sus gavillas."
        ],
        "rlw_lines": []
      }
    ]
  },
