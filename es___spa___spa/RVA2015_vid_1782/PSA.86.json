    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración por la misericordia divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oración de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Inclina, oh SEÑOR, tu oído y escúchame",
          "porque soy pobre y necesitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Guarda mi alma porque soy piadoso;",
          "salva tú, oh Dios mío,",
          "a tu siervo que en ti confía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ten misericordia de mí, oh SEÑOR,",
          "porque a ti clamo todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alegra el alma de tu siervo, porque a ti,",
          "oh Señor, levanto mi alma"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "porque tú, oh Señor, eres bueno y perdonador,",
          "grande en misericordia para con los que te invocan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Escucha, oh SEÑOR, mi oración;",
          "atiende a la voz de mis súplicas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En el día de mi angustia te llamaré",
          "porque tú me respondes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oh Señor, ninguno hay como tú entre los dioses,",
          "ni hay nada que iguale tus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Vendrán todas las naciones que hiciste y",
          "adorarán, oh Señor, delante de ti.",
          "Glorificarán tu nombre"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "porque tú eres grande y hacedor de maravillas.",
          "¡Solo tú eres Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Enséñame, oh SEÑOR, tu camino,",
          "y yo caminaré en tu verdad.",
          "Concentra mi corazón para que tema tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Te alabaré, oh SEÑOR, Dios mío,",
          "con todo mi corazón;",
          "glorificaré tu nombre para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Porque tu misericordia es grande para conmigo;",
          "tú has librado mi alma de las profundidades del Seol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Oh Dios, los arrogantes se han levantado contra mí,",
          "y una congregación de violentos busca mi vida",
          "y a ti no te toman en cuenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero tú, oh Señor, Dios compasivo y clemente,",
          "lento para la ira y grande en misericordia y verdad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "mírame y ten misericordia de mí.",
          "Da tú fuerzas a tu siervo;",
          "guarda al hijo de tu sierva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Haz conmigo señal para bien;",
          "véanla los que me aborrecen y sean avergonzados",
          "porque tú, oh SEÑOR, me ayudaste y me consolaste."
        ],
        "rlw_lines": []
      }
    ]
  },
