      "human": "Proverbios 17"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Del hombre son los planes del corazón,",
          "pero del SEÑOR es la respuesta",
          "de la lengua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Todo camino del hombre es limpio",
          "en su propia opinión,",
          "pero el SEÑOR es el que examina los espíritus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Encomienda al SEÑOR tus obras,",
          "y tus pensamientos serán afirmados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todo lo ha hecho el SEÑOR para su propio propósito;",
          "y aun al impío para el día malo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Abominación es al SEÑOR todo altivo de corazón;",
          "de ninguna manera quedará impune."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Con misericordia y verdad se expía la falta y con el temor del SEÑOR",
          "uno se aparta del mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuando los caminos del hombre le agradan al SEÑOR,",
          "aun a sus enemigos reconciliará con él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Es mejor lo poco con justicia que gran abundancia sin derecho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El corazón del hombre traza su camino, pero el SEÑOR dirige sus pasos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Hay oráculo en los labios del rey;",
          "en el juicio no yerra su boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "La balanza y los platillos justos son del SEÑOR;",
          "obra suya son todas las pesas",
          "de la bolsa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Es abominación a los reyes",
          "hacer impiedad",
          "porque con justicia se afirma el trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Los reyes favorecen a los labios justos",
          "y aman al que habla lo recto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "La ira del rey es como mensajero",
          "de muerte,",
          "pero el hombre sabio la apaciguará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "En la alegría del rostro del rey",
          "está la vida;",
          "su favor es como nube de lluvia tardía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Es mejor adquirir sabiduría",
          "que oro fino,",
          "y adquirir inteligencia vale más",
          "que la plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "La vía de los rectos es apartarse del mal,",
          "y el que guarda su camino",
          "guarda su vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Antes de la quiebra está el orgullo;",
          "y antes de la caída la altivez de espíritu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Mejor es humillar el espíritu",
          "con los humildes",
          "que repartir botín con los soberbios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El que está atento a la palabra hallará el bien,",
          "y el que confía en el SEÑOR es bienaventurado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "El sabio de corazón",
          "será llamado entendido,",
          "y la dulzura de labios aumenta el saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Fuente de vida es el entendimiento",
          "al que lo posee,",
          "pero el castigo de los insensatos",
          "es la misma insensatez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El corazón del sabio hace prudente",
          "su boca,",
          "y con sus labios aumenta el saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Panal de miel son los dichos",
          "agradables;",
          "son dulces al alma y saludables",
          "al cuerpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Hay un camino que al hombre le parece derecho,",
          "pero que al final es camino de muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "El apetito del trabajador es lo que le obliga a trabajar,",
          "porque su boca lo apremia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El hombre indigno trama el mal,",
          "y en sus labios hay como",
          "fuego abrasador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "El hombre perverso provoca",
          "la contienda,",
          "y el chismoso aparta",
          "los mejores amigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "El hombre violento persuade",
          "a su amigo",
          "y le hace andar por camino",
          "no bueno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "El que entrecierra sus ojos",
          "para planear perversidades,",
          "el que aprieta sus labios, consuma el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Corona de honra son las canas;",
          "en el camino de la justicia se encuentra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Es mejor el que tarda en airarse",
          "que el fuerte;",
          "y el que domina su espíritu",
          "que el que conquista una ciudad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Las suertes se echan en el regazo, pero al SEÑOR pertenece",
          "toda su decisión."
        ],
        "rlw_lines": []
      }
    ]
  },
