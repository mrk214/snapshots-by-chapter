    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica contra las naciones hostiles"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Dios, no guardes silencio.",
          "No calles, oh Dios,",
          "ni permanezcas inmóvil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque he aquí que rugen tus enemigos,",
          "y los que te aborrecen han levantado la cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Contra tu pueblo han consultado astutamente;",
          "han entrado en consejo contra tus protegidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Han dicho: “Vengan y destruyámoslos",
          "de modo que dejen de ser una nación",
          "y no haya más memoria del nombre de Israel”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Han conspirado juntos, de común acuerdo;",
          "han hecho pacto contra ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Las tiendas de Edom, los ismaelitas,",
          "Moab, los hagrienos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Biblos, Amón, Amalec,",
          "los filisteos con los habitantes de Tiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "También los asirios se han juntado con ellos",
          "y sirven de brazo a los hijos de Lot. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Hazlos como a Madián;",
          "como a Sísara y a Jabín",
          "en el arroyo de Quisón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Perecieron en Endor",
          "y fueron hechos abono para el suelo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pon a sus nobles como a Oreb y a Zeeb;",
          "a todos sus príncipes, como a Zébaj y a Zalmuna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque han dicho:",
          "“Heredemos nosotros los prados de Dios”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Oh Dios mío, hazlos como remolino de hojas,",
          "como paja ante el viento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "como fuego que quema el bosque,",
          "como llama que abrasa las montañas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Persíguelos con tu tempestad;",
          "aterrorízalos con tu huracán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Llena su cara de vergüenza;",
          "y que busquen tu nombre, oh SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sean confundidos y turbados para siempre;",
          "sean afrentados y perezcan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Conozcan que tu nombre es SEÑOR.",
          "¡Tú solo eres Altísimo sobre toda la tierra!"
        ],
        "rlw_lines": []
      }
    ]
  },
