    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Anhelo de la protección de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Con Neguinot. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Escucha, oh Dios, mi clamor;",
          "atiende a mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Desde el extremo de la tierra",
          "clamaré a ti cuando mi corazón desmaye.",
          "Llévame a la roca que es más alta que yo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "porque tú me has sido refugio",
          "y torre fortificada delante del enemigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Que yo habite en tu tabernáculo para siempre",
          "y me refugie al amparo de tus alas. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pues tú, oh Dios, has oído mis votos;",
          "has dado heredad a los que temen tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Días sobre días añadirás al rey;",
          "sus años serán como generación tras generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Estará para siempre delante de Dios;",
          "designa la misericordia y la verdad para que lo guarden."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Entonces cantaré salmos a tu nombre para siempre,",
          "para pagar mis votos día tras día."
        ],
        "rlw_lines": []
      }
    ]
  },
