    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración de arrepentimiento"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David, cuando el profeta Natán fue a él después de que David tuvo relaciones con Betsabé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ten piedad de mí, oh Dios,",
          "conforme a tu misericordia.",
          "Por tu abundante compasión",
          "borra mis rebeliones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Lávame más y más de mi maldad,",
          "y límpiame de mi pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque yo reconozco mis rebeliones,",
          "y mi pecado está siempre delante de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Contra ti, contra ti solo he pecado",
          "y he hecho lo malo ante tus ojos.",
          "Seas tú reconocido justo en tu palabra",
          "y tenido por puro en tu juicio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "He aquí, en maldad he nacido,",
          "y en pecado me concibió mi madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He aquí, tú quieres la verdad en lo íntimo,",
          "y en lo secreto me has hecho comprender sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quita mi pecado con hisopo, y seré limpio;",
          "lávame, y seré más blanco que la nieve."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Hazme oír gozo y alegría,",
          "y se regocijarán estos huesos que has quebrantado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Esconde tu rostro de mis pecados",
          "y borra todas mis maldades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Crea en mí, oh Dios, un corazón puro",
          "y renueva un espíritu firme dentro de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "No me eches de tu presencia",
          "ni quites de mí tu Santo Espíritu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Devuélveme el gozo de tu salvación,",
          "y un espíritu generoso me sustente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Entonces enseñaré a los transgresores tus caminos,",
          "y los pecadores se convertirán a ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Líbrame de homicidios, oh Dios, Dios de mi salvación,",
          "y con regocijo cantará mi lengua tu justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Señor, abre mis labios,",
          "y proclamará mi boca tu alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque no quieres sacrificio;",
          "y si doy holocausto, no lo aceptas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los sacrificios de Dios son el espíritu quebrantado.",
          "Al corazón contrito y humillado",
          "no desprecias tú, oh Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Haz bien a Sion con tu benevolencia;",
          "edifica los muros de Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Entonces te agradarán los sacrificios de justicia,",
          "el holocausto o la ofrenda del todo quemada.",
          "Entonces se ofrecerán becerros sobre tu altar."
        ],
        "rlw_lines": []
      }
    ]
  },
