    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración por liberación y dirección"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, escucha mi oración;",
          "atiende mis ruegos.",
          "Respóndeme por tu fidelidad,",
          "por tu justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "No entres en juicio con tu siervo",
          "porque no se justificará delante de ti ningún viviente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque el enemigo ha perseguido mi alma;",
          "ha postrado en tierra mi vida,",
          "me ha hecho habitar en lugares tenebrosos",
          "como los muertos de antaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi espíritu desmaya dentro de mí;",
          "mi corazón queda asombrado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me acuerdo de los días de antaño,",
          "medito en todos tus hechos",
          "y reflexiono en las obras de tus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Extiendo mis manos hacia ti;",
          "mi alma te anhela como la tierra sedienta. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Respóndeme pronto, oh SEÑOR,",
          "porque mi espíritu desfallece.",
          "No escondas de mí tu rostro",
          "para que no sea yo como los que descienden a la fosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Hazme oír por la mañana tu misericordia",
          "porque en ti confío.",
          "Hazme conocer el camino en que he de andar",
          "porque hacia ti levanto",
          "mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Líbrame de mis enemigos,",
          "oh SEÑOR,",
          "porque en ti me refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Enséñame a hacer tu voluntad",
          "porque tú eres mi Dios;",
          "tu buen Espíritu me guíe a tierra de rectitud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Vivifícame, oh SEÑOR, por amor de tu nombre;",
          "por tu justicia saca mi alma de la angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por tu misericordia silencia",
          "a mis enemigos;",
          "destruye a todos los adversarios",
          "de mi alma",
          "porque yo soy tu siervo."
        ],
        "rlw_lines": []
      }
    ]
  },
