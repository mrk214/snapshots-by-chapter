    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Libro II: Salmos 42—72"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Anhelo por la presencia de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Masquil de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Como ansía el venado las corrientes de las aguas,",
          "así te ansía a ti, oh Dios, el alma mía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi alma tiene sed de Dios, del Dios vivo.",
          "¿Cuándo iré para presentarme delante de Dios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mis lágrimas han sido mi alimento día y noche",
          "mientras me dicen todos los días:",
          "“¿Dónde está tu Dios?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Recuerdo estas cosas y derramo mi alma dentro de mí:",
          "cuando pasaba con la muchedumbre, guiándolos hasta la casa de Dios,",
          "con voz de alegría y de acción de gracias de la multitud en fiesta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Por qué te abates, oh alma mía,",
          "y te turbas dentro de mí?",
          "Espera a Dios, porque aún le he de alabar.",
          "¡Él es la salvación de mi ser,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "y mi Dios!",
          "Mi alma está abatida dentro de mí.",
          "Por esto me acordaré de ti",
          "en la tierra del Jordán y del Hermón, en el monte de Mizar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Un abismo llama a otro por la voz de tus cascadas;",
          "todas tus ondas y tus olas han pasado sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "De día mandará el SEÑOR su misericordia;",
          "y de noche su canción estará conmigo,",
          "la oración al Dios de mi vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Diré a Dios: “Roca mía,",
          "¿por qué te has olvidado de mí?",
          "¿Por qué he de andar enlutado",
          "por la opresión del enemigo?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mientras mis huesos se quebrantan,",
          "mis enemigos me afrentan diciéndome cada día:",
          "“¿Dónde está tu Dios?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Por qué te abates, oh alma mía,",
          "y por qué te turbas dentro de mí?",
          "Espera a Dios, porque aún le he de alabar.",
          "¡Él es la salvación de mi ser, y mi Dios!"
        ],
        "rlw_lines": []
      }
    ]
  },
