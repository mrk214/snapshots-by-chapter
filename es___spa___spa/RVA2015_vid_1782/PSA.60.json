    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica en medio de la derrota"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre “La Rosa del Testimonio”. Mictam de David, para ser enseñado. Compuesto cuando provocó la confrontación con Siria mesopotámica y Siria de Soba, y Joab volvió y derrotó a doce mil de Edom en el valle de la Sal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Dios, tú nos has desechado;",
          "has roto nuestras defensas.",
          "Te has airado. ¡Vuelve a nosotros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Hiciste temblar la tierra; la has agrietado.",
          "Restaura sus fallas porque se desmorona."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Has hecho ver duras cosas a tu pueblo;",
          "nos has hecho beber vino de aturdimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Has dado bandera a los que te temen",
          "para que alcancen seguridad ante el arco. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Salva con tu diestra y respóndenos,",
          "de modo que sean librados tus amados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dios ha hablado en su santuario:",
          "“¡Cómo me regocijo!",
          "Repartiré Siquem",
          "y mediré el valle de Sucot."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mío es Galaad y mío es Manasés.",
          "Efraín es la fortaleza de mi cabeza;",
          "Judá es mi cetro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Moab es la vasija en que me lavo;",
          "sobre Edom echaré mis sandalias,",
          "y sobre Filistea lanzaré mi grito de victoria”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Quién me guiará a la ciudad fortificada?",
          "¿Quién me conducirá hasta Edom?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿No serás tú, oh Dios, que nos habías desechado",
          "y que ya no sales, oh Dios, con nuestros ejércitos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Danos socorro ante el enemigo",
          "pues vana es la liberación que da el hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Con Dios haremos proezas,",
          "y él aplastará a nuestros enemigos."
        ],
        "rlw_lines": []
      }
    ]
  },
