    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Manifestación del Dios temible"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Con Neguinot. Salmo de Asaf. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios es conocido en Judá;",
          "grande es su nombre en Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En Salem está su enramada",
          "y en Sion su habitación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Allí quebró las ráfagas del arco,",
          "el escudo, la espada y el arma de guerra. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Esplendoroso eres tú,",
          "majestuoso más que las montañas eternas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los hombres de gran valentía",
          "fueron despojados y duermen su sueño;",
          "ninguno de los hombres de guerra pudo usar sus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A tu reprensión, oh Dios de Jacob,",
          "fueron paralizados el carro y el caballo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Temible eres tú;",
          "¿quién podrá permanecer en tu presencia cuando se desate tu ira?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Desde los cielos hiciste oír el juicio.",
          "La tierra tuvo temor y calló"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "cuando te levantaste, oh Dios, para juzgar;",
          "cuando te levantaste para librar a todos los mansos de la tierra.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ciertamente la ira del hombre te traerá reconocimiento,",
          "y te ceñirás con los sobrevivientes de las iras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Hagan votos y páguenlos al SEÑOR, su Dios;",
          "todos los que están alrededor traerán obsequios al Temible."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Él humillará el espíritu de los príncipes;",
          "¡temible es a los reyes de la tierra!"
        ],
        "rlw_lines": []
      }
    ]
  },
