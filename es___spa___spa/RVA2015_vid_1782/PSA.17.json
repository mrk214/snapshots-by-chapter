    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La oración de un hombre justo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oración de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Escucha, oh SEÑOR, una causa justa; atiende a mi clamor.",
          "Presta oído a mi oración que es de labios sin engaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Proceda de tu presencia mi vindicación;",
          "vean tus ojos la rectitud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tú has examinado mi corazón;",
          "me has visitado de noche.",
          "Me has probado y nada infame has hallado",
          "porque me he propuesto que mi boca no se exceda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En cuanto a las obras de los hombres,",
          "por la palabra de tus labios me he guardado de las sendas de los violentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mis pasos se han mantenido en tus caminos",
          "para que mis pies no resbalen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Yo te invoco, porque tú oirás, oh Dios.",
          "Inclina a mí tu oído; escucha mi palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Muestra tus maravillosos actos de misericordia,",
          "tú que, a los que confían, libras con tu diestra de los que se levantan contra ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Guárdame como a la niña de tu ojo;",
          "escóndeme bajo la sombra de tus alas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "de la vista de los impíos que me oprimen,",
          "y de mis enemigos mortales que me rodean."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ellos están protegidos con su propio sebo;",
          "con su boca hablan con soberbia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Han rodeado nuestros pasos;",
          "sobre nosotros ponen sus ojos para echarnos por tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Se parecen al león que anhela la presa,",
          "o al cachorro de león que se agacha en secreto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Levántate, oh SEÑOR!",
          "¡Hazle frente! ¡Somételo!",
          "Con tu espada libra mi alma de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Oh SEÑOR, líbrame con tu mano de los hombres,",
          "de los hombres de este mundo",
          "cuya parte está en esta vida;",
          "cuyos vientres llenas con tus tesoros,",
          "cuyos hijos se sacian",
          "y aun dejan para sus pequeños."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "En cuanto a mí,",
          "en justicia veré tu rostro;",
          "quedaré satisfecho cuando despierte a tu semejanza."
        ],
        "rlw_lines": []
      }
    ]
  },
