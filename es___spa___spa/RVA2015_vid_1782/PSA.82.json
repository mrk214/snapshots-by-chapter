    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Reprensión a los jueces injustos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios está de pie en la asamblea divina;",
          "en medio de los dioses ejerce el juicio:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“¿Hasta cuándo juzgarán injustamente",
          "y entre los impíos harán distinción de personas? Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Rescaten al necesitado y al huérfano;",
          "hagan justicia al pobre y al indigente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Libren al necesitado y al menesteroso;",
          "líbrenlo de la mano de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Ellos no saben ni entienden; andan en tinieblas.",
          "¡Todos los cimientos de la tierra son conmovidos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Yo les dije: ‘Ustedes son dioses;",
          "todos ustedes son hijos del Altísimo’."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sin embargo, como un hombre morirán",
          "y caerán como cualquiera de los gobernantes”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Levántate, oh Dios; juzga la tierra",
          "porque tú poseerás todas las naciones!"
        ],
        "rlw_lines": []
      }
    ]
  },
