    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios en la historia de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Den gracias al SEÑOR! ¡Invoquen su nombre!",
          "Den a conocer entre los pueblos sus hazañas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cántenle, cántenle salmos;",
          "hablen de todas sus maravillas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Gloríense en su santo nombre;",
          "alégrese el corazón de los que buscan al SEÑOR."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Busquen al SEÑOR y su poder;",
          "busquen continuamente su rostro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Acuérdense de las maravillas que ha hecho,",
          "de sus prodigios y de los juicios de su boca,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "oh ustedes, descendientes de Abraham, su siervo;",
          "hijos de Jacob, sus escogidos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él es el SEÑOR, nuestro Dios;",
          "en toda la tierra están sus juicios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Se acordó para siempre de su pacto",
          "—de la palabra que mandó para mil generaciones—,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "el cual hizo con Abraham;",
          "y de su juramento a Isaac."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Lo confirmó a Jacob por estatuto,",
          "como pacto sempiterno a Israel,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "diciendo: “A ti daré la tierra de Canaán",
          "como la porción que poseerán”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Cuando eran pocos en número,",
          "muy pocos y forasteros en ella;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "cuando andaban de nación en nación",
          "y de un reino a otro pueblo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "no permitió que nadie los oprimiese;",
          "más bien, por causa de ellos castigó a reyes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Dijo: “¡No toquen a mis ungidos,",
          "ni hagan mal a mis profetas!”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Cuando trajo hambre sobre la tierra",
          "y cortó todo el sustento de pan,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "ya había enviado delante de ellos a un hombre,",
          "a José, que fue vendido como esclavo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Afligieron con grilletes sus pies,",
          "y a su cuello pusieron cadena de hierro"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "hasta que se cumplió su palabra,",
          "y el dicho del SEÑOR lo aprobó."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Entonces el rey mandó que lo soltaran;",
          "el soberano de los pueblos lo desató."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Lo puso como señor de su casa",
          "y como gobernador de toda su posesión"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "para que disciplinara a su gusto a los grandes",
          "y a sus ancianos enseñara sabiduría."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Después entró Israel en Egipto,",
          "y Jacob fue extranjero en la tierra de Cam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Dios hizo que su pueblo fuera muy fecundo,",
          "y lo hizo más fuerte que sus enemigos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Cambió el corazón de estos",
          "para que aborreciesen a su pueblo,",
          "para que contra sus siervos actuaran con engaño."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Envió a su siervo Moisés,",
          "y a Aarón, al cual escogió."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Puso en ellos las palabras de sus señales",
          "y sus prodigios en la tierra de Cam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Envió tinieblas y trajo oscuridad",
          "pero no guardaron sus palabras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Convirtió sus aguas en sangre",
          "y mató sus peces."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Su tierra produjo ranas",
          "hasta en las habitaciones de sus reyes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Habló, y llegaron enjambres de moscas",
          "y piojos en todo su territorio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Convirtió sus lluvias en granizo",
          "y en llamas de fuego, en su tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Dañó sus viñas y sus higueras",
          "y quebró los árboles de su territorio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Habló, y vinieron langostas",
          "y pulgón sin número."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Comieron toda la hierba de su país",
          "y devoraron el pasto de su tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Golpeó, además, a todos los primogénitos de su país,",
          "las primicias de todo su vigor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Los sacó con plata y oro;",
          "no hubo entre sus tribus enfermo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Egipto se alegró de que salieran",
          "porque su terror había caído sobre ellos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Extendió una nube por cortina;",
          "y fuego para alumbrar de noche."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Pidieron, e hizo venir codornices",
          "y los sació con pan del cielo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Abrió la peña y fluyeron aguas;",
          "corrieron por los sequedales como río."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Porque se acordó de su santa promesa",
          "dada a su siervo Abraham."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Así sacó a su pueblo con gozo;",
          "con júbilo sacó a sus escogidos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Les dio las tierras de las naciones,",
          "y heredaron el fruto de las labores de ellas"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "para que guardaran sus estatutos",
          "y observaran sus leyes.",
          "¡Aleluya!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
