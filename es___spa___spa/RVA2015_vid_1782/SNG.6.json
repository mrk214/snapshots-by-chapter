{"version":{"version_id":1782,"local_abbreviation":"RVA2015","local_title":"Reina Valera Actualizada","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"Editorial Mundo Hispano"},"copyright":{"html":"<p>Copyright © 2015 by Editorial Mundo Hispano</p>","text":"Copyright © 2015 by Editorial Mundo Hispano"}},"book":{"book_usfm":"SNG","name":"Cantares"},"chapter":{"chapter_usfm":"SNG.6","is_chapter":true,"previous":{"usfm":"SNG.5","human":"Cantares 5","canonical":true,"toc":true},"current":{"usfm":"SNG.6","human":"Cantares 6"},"next":{"usfm":"SNG.7","human":"Cantares 7","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["El cortejo nupcial"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Adónde se ha ido tu amado,","oh la más hermosa de todas las mujeres?","Dinos en qué dirección se fue,","y lo buscaremos contigo."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["La amada"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Mi amado descendió a su huerto,","al almácigo de las especias,","para apacentar en los jardines","y para recoger los lirios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["¡Yo soy de mi amado","y mi amado es mío!","Él apacienta entre los lirios."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El amado"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["¡Qué bella eres, oh amada mía!","Eres como Tirsa,","atractiva como Jerusalén","e imponente como ejércitos abanderados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Aparta de mí tus ojos,","porque ellos me doblegan.","Tu cabello es como manada de cabras que se deslizan por las laderas de Galaad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Tus dientes son como rebaños de ovejas que suben del lavadero: que todas tienen mellizos, y ninguna hay sin cría."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Tus mejillas parecen mitades de granada, a través de tu velo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Hay sesenta reinas, ochenta concubinas","y un sinnúmero de jóvenes mujeres."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["¡Pero una sola es mi paloma, mi perfecta!","Ella es la única hija de su madre,","quien la considera predilecta.","La ven las mujeres y la llaman:","“Bienaventurada”.","Las reinas y las concubinas la alaban diciendo:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["“¿Quién es aquella que raya como el alba y es bella como la luna,","radiante como el sol e imponente como ejércitos abanderados?”."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Al huerto de los nogales descendí,","para ver los retoños del valle,","para ver si las vides ya han florecido;","si han brotado los granados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Y antes que me diera cuenta,","mi alma me puso sobre los carros de mi generoso pueblo."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["El cortejo nupcial"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["¡Vuelve, vuelve, oh Sulamita!","¡Vuelve, vuelve; queremos mirarte!"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["La amada"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["¿Qué han de observar en la Sulamita,","cuando danza en medio de los dos campamentos?"],"rlw_lines":[]}]}}