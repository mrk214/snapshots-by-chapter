    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza de un alma agradecida"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "De David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bendice, oh alma mía, al SEÑOR.",
          "Bendiga todo mi ser su santo nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bendice, oh alma mía, al SEÑOR",
          "y no olvides ninguno de sus beneficios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Él es quien perdona todas tus iniquidades,",
          "el que sana todas tus dolencias,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "el que rescata del hoyo tu vida,",
          "el que te corona de favores y de misericordia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "el que sacia con bien tus anhelos",
          "de modo que te rejuvenezcas como el águila."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El SEÑOR es quien hace justicia y derecho",
          "a todos los que padecen violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sus caminos dio a conocer a Moisés;",
          "y a los hijos de Israel, sus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Compasivo y clemente es el SEÑOR,",
          "lento para la ira y grande en misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No contenderá para siempre ni",
          "para siempre guardará el enojo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No ha hecho con nosotros conforme a nuestras iniquidades",
          "ni nos ha pagado conforme a nuestros pecados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pues como la altura de los cielos sobre la tierra,",
          "así ha engrandecido su misericordia sobre los que le temen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Tan lejos como está el oriente del occidente",
          "así hizo alejar de nosotros nuestras rebeliones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Como el padre se compadece de los hijos,",
          "así se compadece el SEÑOR de los que le temen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque él conoce nuestra condición;",
          "se acuerda de que somos polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El hombre, como la hierba son sus días:",
          "Florece como la flor del campo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "que, cuando pasa el viento, perece",
          "y su lugar no la vuelve a conocer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pero la misericordia del SEÑOR es desde la eternidad y hasta la eternidad sobre los que le temen;",
          "y su justicia sobre los hijos de sus hijos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "sobre los que guardan su pacto",
          "y se acuerdan de sus mandamientos para ponerlos por obra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El SEÑOR estableció en los cielos su trono,",
          "y su reino domina sobre todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Bendigan al SEÑOR, ustedes sus poderosos ángeles",
          "que ejecutan su palabra obedeciendo la voz de ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Bendigan al SEÑOR, ustedes todos sus ejércitos;",
          "servidores suyos que hacen su voluntad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Bendigan al SEÑOR, ustedes todas sus obras",
          "en todos los lugares de su señorío.",
          "¡Bendice, alma mía, al SEÑOR!"
        ],
        "rlw_lines": []
      }
    ]
  },
