    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Viviendo bajo la protección divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El que habita al abrigo del Altísimo",
          "morará bajo la sombra del Todopoderoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Diré yo al SEÑOR:",
          "“¡Refugio mío y castillo mío,",
          "mi Dios en quien confío!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque él te librará",
          "de la trampa del cazador",
          "y de la peste destructora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Con sus plumas te cubrirá,",
          "y debajo de sus alas te refugiarás;",
          "escudo y defensa es su verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "No tendrás temor de espanto nocturno",
          "ni de flecha que vuele de día"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "ni de peste que ande en la oscuridad",
          "ni de plaga que en pleno día destruya."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Caerán a tu lado mil",
          "y diez mil a tu mano derecha",
          "pero a ti no llegará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ciertamente con tus ojos mirarás",
          "y verás la recompensa de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque al SEÑOR, que es mi refugio,",
          "al Altísimo, has puesto como tu morada,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "no te sobrevendrá mal",
          "ni la plaga se acercará a tu tienda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pues a sus ángeles dará órdenes acerca de ti",
          "para que te guarden en todos tus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "En sus manos te llevarán",
          "de modo que tu pie no tropiece en piedra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sobre el león y la cobra pisarás;",
          "hollarás al leoncillo y a la serpiente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Porque en mí ha puesto su amor,",
          "yo lo libraré;",
          "lo pondré en alto,",
          "por cuanto ha conocido mi nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Él me invocará, y yo le responderé;",
          "con él estaré en la angustia.",
          "Lo libraré y lo glorificaré;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "lo saciaré de larga vida",
          "y le mostraré mi salvación”."
        ],
        "rlw_lines": []
      }
    ]
  },
