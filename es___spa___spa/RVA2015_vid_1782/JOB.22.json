    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tercera intervención de Elifaz"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces intervino Elifaz el temanita y dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "—¿Puede el hombre fuerte traer provecho a Dios?",
          "¿Puede el hombre inteligente serle",
          "de provecho?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Le deleita al Todopoderoso el que",
          "tú seas justo?",
          "¿Gana algo con que tú hagas perfectos tus caminos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Es por tu piedad que él te reprende",
          "o acude contigo a juicio?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Acaso no será grande tu maldad",
          "y sin fin tus iniquidades?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sin razón tomabas prenda",
          "de tus hermanos",
          "y despojabas de sus ropas",
          "a los desnudos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "No dabas de beber agua al cansado,",
          "y al hambriento le privabas de pan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como un hombre poderoso a quien",
          "le pertenece la tierra",
          "y un enaltecido que habita en ella,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "despedías a las viudas con las manos vacías",
          "y quebrantabas los brazos",
          "de los huérfanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por eso hay trampas alrededor de ti,",
          "y te turba el terror repentino"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "o las tinieblas, de modo que no veas",
          "y te cubra abundancia de aguas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»¿Acaso no está Dios en lo alto de los cielos?",
          "¡Observa la totalidad de las estrellas! ¡Cuán altas están!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sin embargo, tú dices: “¿Qué sabe Dios? ¿Podrá juzgar a través de la",
          "densa oscuridad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Las nubes le son un velo, y no puede ver mientras se pasea por la bóveda del cielo”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "»¿Persistirás tú en el viejo camino que han transitado los hombres inicuos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "los cuales fueron arrebatados antes",
          "de tiempo,",
          "y cuyos fundamentos fueron arrasados por un río?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ellos le decían a Dios:",
          "“Apártate de nosotros”.",
          "Y: “¿Qué puede hacernos",
          "el Todopoderoso?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Aunque él haya llenado sus casas",
          "de bienes,",
          "¡lejos esté de mí el consejo de los impíos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Los justos lo verán y se gozarán;",
          "el inocente se burlará de ellos diciendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "“De veras han sido destruidos nuestros adversarios,",
          "y el fuego ha devorado lo que quedó",
          "de ellos”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»Trata, pues, de llevarte bien con Dios; reconcíliate, y por ello te vendrá prosperidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Toma, pues, de su boca la instrucción",
          "y pon sus dichos en tu corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Si te vuelves al Todopoderoso serás edificado.",
          "Si alejas de tu morada la maldad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "y pones sobre el polvo el oro,",
          "el oro de Ofir,",
          "como si fuera piedras del arroyo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "y si el Todopoderoso es tu oro",
          "y tu plata más escogida,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "entonces te deleitarás en el Todopoderoso",
          "y podrás alzar tu cara hacia Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Orarás a él, y él te escuchará;",
          "y podrás pagar tus votos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Decidirás algo, y se te realizará;",
          "la luz resplandecerá sobre tus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Cuando sean abatidos, tú dirás: “Sean enaltecidos”.",
          "Y Dios salvará al de humilde mirada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Librará al inocente;",
          "escapará por causa de la limpieza de tus manos."
        ],
        "rlw_lines": []
      }
    ]
  },
