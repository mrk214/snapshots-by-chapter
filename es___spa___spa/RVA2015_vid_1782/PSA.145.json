    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza al SEÑOR el Rey"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de alabanza. De David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Te exaltaré, mi Dios, el Rey,",
          "y bendeciré tu nombre",
          "eternamente y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cada día te bendeciré",
          "y alabaré tu nombre",
          "eternamente y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Grande es el SEÑOR",
          "y digno de suprema alabanza.",
          "Su grandeza es inescrutable."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Una generación celebrará tus obras ante otra generación,",
          "y anunciará tus poderosos hechos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Hablarán del esplendor de tu gloriosa majestad,",
          "y meditaré en tus maravillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Hablarán de la fuerza de tus portentos,",
          "y contaré tu grandeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Manifestarán el recuerdo de tu inmensa bondad",
          "y cantarán tu justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Clemente y compasivo es el SEÑOR,",
          "lento para la ira y grande en misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Bueno es el SEÑOR para con todos,",
          "y su misericordia está en todas sus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todas tus obras, oh SEÑOR, te alabarán;",
          "y tus fieles te bendecirán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Hablarán de la gloria",
          "de tu reino y de tu poder,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "para anunciar tus proezas a los hijos del hombre",
          "y la gloria del majestuoso esplendor de tu reino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tu reino es reino de todos los siglos,",
          "y tu dominio es de generación en generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El SEÑOR sostiene a todos los que caen",
          "y levanta a todos los que han sido doblegados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los ojos de todos tienen su esperanza puesta en ti",
          "y tú les das su comida a su debido tiempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Abres tu mano y satisfaces",
          "el deseo de todo ser viviente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Justo es el SEÑOR en todos sus caminos",
          "y bondadoso en todas sus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cercano está el SEÑOR a todos los que le invocan,",
          "a todos los que le invocan de verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Cumplirá el deseo de los que le temen.",
          "Asimismo, oirá el clamor de ellos y los salvará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El SEÑOR guarda a todos los que le aman",
          "pero destruirá a todos los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Mi boca expresará la alabanza del SEÑOR:",
          "¡Bendiga todo mortal su santo nombre,",
          "eternamente y para siempre!"
        ],
        "rlw_lines": []
      }
    ]
  },
