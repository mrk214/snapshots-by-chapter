    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confesión de los fracasos de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "¡Alaben al SEÑOR, porque es bueno;",
          "porque para siempre es su misericordia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Quién declarará las proezas del SEÑOR?",
          "¿Quién hará oír todas sus alabanzas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Bienaventurados los que guardan el derecho,",
          "los que en todo tiempo hacen justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Acuérdate de mí, oh SEÑOR,",
          "según tu benevolencia para con tu pueblo.",
          "Visítame con tu salvación"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "para que vea el bien de tus escogidos,",
          "para que me alegre con la alegría de tu pueblo,",
          "para que me gloríe con tu heredad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Hemos pecado como nuestros padres;",
          "hemos hecho iniquidad;",
          "hemos actuado impíamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nuestros padres en Egipto",
          "no entendieron tus maravillas;",
          "no se acordaron de tus innumerables hechos de misericordia",
          "sino que se rebelaron junto al mar, el mar Rojo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sin embargo, los libró por amor de su nombre",
          "para dar a conocer su poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Reprendió al mar Rojo y lo secó;",
          "los hizo ir por los abismos como por un desierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los libró del enemigo;",
          "los rescató de mano del adversario."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Las aguas cubrieron a sus enemigos;",
          "no quedó uno solo de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Entonces creyeron en sus palabras",
          "y cantaron su alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pero pronto se olvidaron de sus obras",
          "y no esperaron su consejo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ardieron de apetito en el desierto",
          "y probaron a Dios en la soledad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Él les dio lo que pidieron",
          "pero envió a sus almas debilidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Después tuvieron celos de Moisés en el campamento,",
          "y de Aarón, el consagrado del SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "La tierra se abrió y tragó a Datán,",
          "y cubrió al grupo de Abiram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El fuego se encendió contra su grupo;",
          "la llama devoró a los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "En Horeb hicieron un becerro",
          "y se postraron ante una imagen de fundición."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Así cambiaron su gloria",
          "por la de un toro que come hierba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Olvidaron al Dios de su salvación",
          "que había hecho grandezas en Egipto,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "maravillas en la tierra de Cam,",
          "cosas formidables junto al mar Rojo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Él dijo que los hubiera destruido de no haberse interpuesto Moisés, su escogido, ante él en la brecha,",
          "a fin de aplacar su ira, para que no los destruyera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Sin embargo, aborrecieron la tierra deseable",
          "y no creyeron en su palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Más bien, murmuraron en sus tiendas",
          "y no escucharon la voz del SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Por tanto, alzó su mano contra ellos",
          "para postrarlos en la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "para dispersar a sus descendientes entre las naciones",
          "y esparcirlos por las tierras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Cuando se adhirieron al Baal de Peor,",
          "comieron de los sacrificios de los muertos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Provocaron a Dios con sus obras,",
          "y se desató entre ellos la mortandad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Entonces se levantó Fineas y ejecutó juicio,",
          "y se detuvo la mortandad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Aquello le fue contado por justicia",
          "de generación en generación y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "También le indignaron en las aguas de Meriba",
          "y por causa de ellos le fue mal a Moisés;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "porque hicieron que su espíritu se amargara",
          "y él habló precipitadamente con sus labios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Tampoco destruyeron a los pueblos,",
          "como el SEÑOR les había dicho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Más bien, se mezclaron con gentiles",
          "y aprendieron sus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Sirvieron a sus ídolos,",
          "los cuales llegaron a ser una trampa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Sacrificaron sus hijos y sus hijas a los demonios;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "derramaron la sangre inocente,",
          "la sangre de sus hijos y de sus hijas",
          "que sacrificaron a los ídolos de Canaán.",
          "La tierra fue profanada con los hechos de sangre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Así se contaminaron con sus obras",
          "y se prostituyeron con sus hechos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Por tanto, la ira del SEÑOR",
          "se encendió contra su pueblo,",
          "y abominó su heredad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Los entregó en poder de las naciones,",
          "y los que los aborrecían se enseñorearon de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Sus enemigos los oprimieron,",
          "y fueron quebrantados debajo de su mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Muchas veces los libró,",
          "pero ellos se rebelaron contra su consejo",
          "y fueron humillados a causa de su iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Con todo, él los vio cuando estaban en angustia",
          "y oyó su clamor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Se acordó de su pacto con ellos",
          "y se compadeció conforme a su gran compasión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Asimismo, hizo que tuviesen misericordia de ellos",
          "todos los que los tenían cautivos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "¡Sálvanos, oh SEÑOR, Dios nuestro!",
          "Reúnenos de entre las naciones",
          "para que confesemos tu santo nombre,",
          "para que nos gloriemos en tus alabanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "¡Bendito sea el SEÑOR Dios de Israel",
          "desde la eternidad hasta la eternidad!",
          "Y diga todo el pueblo: “¡Amén!”.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
