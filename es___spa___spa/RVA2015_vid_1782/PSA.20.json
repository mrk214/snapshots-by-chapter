    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Anhelo de liberación y victoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El SEÑOR te responda en el día de angustia;",
          "el nombre del Dios de Jacob te defienda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Él te envíe ayuda desde su santuario",
          "y te sostenga desde Sion."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tenga él memoria de tus ofrendas",
          "y acepte tu holocausto. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Él te dé conforme a tu corazón",
          "y cumpla todos tus planes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Nosotros nos alegraremos por tu salvación,",
          "y en el nombre de nuestro Dios alzaremos bandera.",
          "Cumpla el SEÑOR todos tus anhelos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ahora reconozco que el SEÑOR da la victoria a su ungido;",
          "le responderá desde su santo cielo con la fuerza liberadora de su diestra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Estos confían en carros,",
          "y aquellos en caballos;",
          "pero nosotros confiamos",
          "en el nombre del SEÑOR nuestro Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ellos se doblegan y caen,",
          "pero nosotros nos levantamos y estamos firmes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Salva, oh SEÑOR!",
          "¡Que el Rey nos oiga el día en que le invoquemos!"
        ],
        "rlw_lines": []
      }
    ]
  },
