    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Todo depende de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canto de ascenso gradual. De Salomón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Si el SEÑOR no edifica la casa",
          "en vano trabajan los que la edifican.",
          "Si el SEÑOR no guarda la ciudad",
          "en vano vigila el guardia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En vano se levantan de madrugada",
          "y van tarde a reposar",
          "comiendo el pan con dolor;",
          "porque a su amado dará Dios el sueño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "He aquí, heredad del SEÑOR son los hijos;",
          "recompensa es el fruto del vientre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Como flechas en la mano del valiente,",
          "así son los hijos que se tienen en la juventud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Bienaventurado el hombre",
          "que llena de ellos su aljaba.",
          "No se avergonzarán aunque hablen con los enemigos en el tribunal."
        ],
        "rlw_lines": []
      }
    ]
  },
