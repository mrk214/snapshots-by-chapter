    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza a Dios por su providencia"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo. Cántico de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En Sion, oh Dios, te corresponde la alabanza;",
          "a ti serán pagados los votos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tú oyes la oración;",
          "a ti acudirá todo ser."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Las palabras de iniquidad prevalecen contra mí",
          "pero tú perdonarás nuestras rebeliones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Bienaventurado el hombre que tú escoges y haces que se acerque a ti",
          "para que habite en tus atrios.",
          "Seremos saciados del bien de tu casa,",
          "de tu santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Con hechos tremendos nos responderás en justicia,",
          "oh Dios de nuestra salvación,",
          "esperanza de todos los confines de la tierra",
          "y de todos los mares más distantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tú eres el que afirmas las montañas",
          "con poder, ceñido de poderío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tú eres el que sosiegas el estruendo de los mares,",
          "el estruendo de las olas",
          "y el tumulto de los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por eso los habitantes de los confines de la tierra tienen temor de tus maravillas.",
          "Tú haces cantar de júbilo a las salidas de la mañana y de la noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Visitas la tierra y la riegas;",
          "en gran manera la enriqueces.",
          "El río de Dios está lleno de aguas.",
          "Produces los trigales",
          "porque así lo has preparado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Haces que se empapen sus surcos",
          "y allanas sus crestas.",
          "Disuelves los terrones con aguaceros",
          "y bendices sus brotes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Coronas el año con tus bondades",
          "y tus recorridos fluyen abundancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Los pastizales del desierto fluyen abundancia",
          "y las colinas se ciñen de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Los prados se visten de rebaños",
          "y los valles se cubren de grano.",
          "Gritan de júbilo y cantan."
        ],
        "rlw_lines": []
      }
    ]
  },
