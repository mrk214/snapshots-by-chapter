    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Petición de ayuda en la desesperación"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿Hasta cuándo, oh SEÑOR?",
          "¿Me olvidarás para siempre?",
          "¿Hasta cuándo esconderás tu rostro de mí?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Hasta cuándo tendré conflicto en mi alma",
          "y todo el día angustia en mi corazón?",
          "¿Hasta cuándo será enaltecido mi enemigo sobre mí?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Mira; respóndeme, oh SEÑOR, Dios mío!",
          "Alumbra mis ojos para que no duerma de muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No sea que mi enemigo diga: “¡Lo vencí!”.",
          "Mis enemigos se alegrarán si yo resbalo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero yo confío en tu misericordia;",
          "mi corazón se alegra en tu salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cantaré al SEÑOR",
          "porque me ha colmado de bien."
        ],
        "rlw_lines": []
      }
    ]
  },
