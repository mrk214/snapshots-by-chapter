    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La voz del SEÑOR en la tormenta"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Den al SEÑOR, oh hijos de los fuertes;",
          "den al SEÑOR la gloria y el poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Den al SEÑOR la gloria debida a su nombre.",
          "Adoren al SEÑOR en la hermosura de la santidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Voz del SEÑOR sobre las aguas:",
          "¡Truena el Dios de gloria!",
          "¡Es SEÑOR sobre las caudalosas aguas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Voz del SEÑOR con poder;",
          "voz del SEÑOR con gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Voz del SEÑOR que quiebra los cedros;",
          "el SEÑOR despedaza los cedros del Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los hace saltar como terneros;",
          "al Líbano y al Sirión hizo saltar",
          "como crías de toros salvajes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Voz del SEÑOR que aviva las llamas de fuego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Voz del SEÑOR que estremece al desierto.",
          "El SEÑOR estremece al desierto de Cades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "La voz del SEÑOR estremece las encinas",
          "y desnuda los bosques.",
          "Y en su templo todos los suyos proclaman su gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El SEÑOR se sentó ante el diluvio;",
          "el SEÑOR se sentó como rey para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El SEÑOR dará fortaleza a su pueblo;",
          "el SEÑOR bendecirá a su pueblo con paz."
        ],
        "rlw_lines": []
      }
    ]
  },
