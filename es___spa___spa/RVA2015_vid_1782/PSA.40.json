    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Testimonio de la salvación divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Pacientemente esperé al SEÑOR,",
          "y él se inclinó a mí y oyó mi clamor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Me hizo subir del pozo de la desesperación,",
          "del lodo cenagoso.",
          "Puso mis pies sobre una roca",
          "y afirmó mis pasos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Puso en mi boca un cántico nuevo,",
          "una alabanza a nuestro Dios.",
          "Muchos verán esto y temerán,",
          "y confiarán en el SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Bienaventurado el hombre que pone su confianza en el SEÑOR",
          "y no vuelve la mirada a los soberbios",
          "ni a los que se enredan con la falsedad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Oh SEÑOR, Dios mío,",
          "tú has multiplicado tus maravillas",
          "y tus pensamientos para con nosotros.",
          "No hay nadie comparable a ti.",
          "Si intentara referirme y hablar de ellos,",
          "serían demasiados como para ser contados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El sacrificio y la ofrenda no te agradan;",
          "tú has abierto mis oídos.",
          "Holocaustos y sacrificios por el pecado no has pedido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Entonces dije: “He aquí, yo vengo.",
          "En el rollo de pergamino está escrito acerca de mí:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "‘El hacer tu voluntad, oh Dios mío, me ha agradado;",
          "y tu ley está en medio de mi corazón’”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "He anunciado justicia en la gran congregación;",
          "he aquí, no he detenido mis labios.",
          "Oh SEÑOR, tú lo sabes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No he encubierto tu justicia dentro de mi corazón;",
          "he proclamado tu fidelidad y tu salvación.",
          "No he ocultado tu misericordia",
          "ni tu verdad en la gran congregación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tú, oh SEÑOR, no detengas de mí tu compasión;",
          "que tu misericordia y tu verdad me guarden siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque me han rodeado males incontables;",
          "me han alcanzado mis iniquidades,",
          "y no puedo levantar la vista.",
          "Son más numerosos que los cabellos de mi cabeza,",
          "y mi corazón me ha fallado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Ten a bien, oh SEÑOR, librarme!",
          "¡Oh SEÑOR, apresúrate a socorrerme!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sean avergonzados y humillados a una",
          "los que buscan mi vida para cortarla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Vuelvan atrás y sean confundidos los que desean mi mal.",
          "Sean desolados a causa de su vergüenza los que dicen: “¡Ajá, ajá!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Gócense y alégrense en ti todos los que te buscan.",
          "Digan siempre los que aman tu salvación:",
          "“¡El SEÑOR sea engrandecido!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Aunque yo sea pobre y necesitado",
          "el SEÑOR pensará en mí.",
          "Tú eres mi ayuda y mi libertador;",
          "¡Oh Dios mío, no te tardes!"
        ],
        "rlw_lines": []
      }
    ]
  },
