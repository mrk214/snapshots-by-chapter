    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El ungido asume el trono"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿Por qué se amotinan las naciones",
          "y los pueblos traman cosas vanas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Se presentan los reyes de la tierra,",
          "y los gobernantes consultan unidos contra el SEÑOR y su ungido, diciendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“¡Rompamos sus ataduras!",
          "¡Echemos de nosotros sus cuerdas!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El que habita en los cielos se reirá;",
          "el Señor se burlará de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Entonces les hablará en su ira",
          "y los turbará en su furor:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“¡Yo he instalado a mi rey",
          "en Sion, mi monte santo!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Yo declararé el decreto:",
          "el SEÑOR me ha dicho:",
          "“Tú eres mi hijo; yo te engendré hoy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pídeme, y te daré por heredad las naciones,",
          "y por posesión tuya los confines de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tú los quebrantarás con vara de hierro;",
          "como a vasija de alfarero los desmenuzarás”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Y ahora, oh reyes, sean sabios;",
          "acepten la corrección, oh gobernantes de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Sirvan al SEÑOR con temor",
          "y alégrense con temblor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Besen al hijo, no sea que se enoje",
          "y pierdan el camino;",
          "pues se enciende de pronto su ira.",
          "¡Bienaventurados todos los que en él se refugian!"
        ],
        "rlw_lines": []
      }
    ]
  },
