    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración para ser librado del opresor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre “No destruyas”. Mictam de David compuesto cuando huyó de Saúl a la cueva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ten misericordia de mí, oh Dios;",
          "ten misericordia de mí",
          "porque en ti ha confiado mi alma.",
          "En la sombra de tus alas me ampararé",
          "hasta que pasen las calamidades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Clamaré al Dios Altísimo,",
          "al Dios que me favorece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Él enviará desde los cielos",
          "y me librará de la infamia del que me oprime. Selah",
          "¡Dios enviará su misericordia y su verdad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi vida está entre leones;",
          "estoy tendido entre hombres que devoran.",
          "Sus dientes son lanzas y flechas,",
          "y su lengua es como espada afilada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Seas exaltado sobre los cielos, oh Dios;",
          "y sobre toda la tierra, tu gloria!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Una red han tendido ante mis pasos",
          "para doblegar mi alma.",
          "Una fosa han cavado delante de mí,",
          "y en medio de ella han caído ellos mismos. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mi corazón está firme, oh Dios;",
          "está firme mi corazón.",
          "Cantaré y entonaré salmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Despierta, oh alma mía!",
          "¡Despierten, oh arpa y lira!",
          "Despertaré al alba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Te alabaré entre los pueblos, oh Señor;",
          "a ti cantaré salmos entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque grande, hasta los cielos, es tu misericordia;",
          "y hasta las nubes, tu verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Seas exaltado sobre los cielos, oh Dios;",
          "y sobre toda la tierra, tu gloria!"
        ],
        "rlw_lines": []
      }
    ]
  },
