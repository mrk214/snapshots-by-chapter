    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lamento por la ruina del templo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Masquil de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿Por qué, oh Dios, nos has desechado para siempre?",
          "¿Por qué humea tu furor",
          "contra las ovejas de tu prado?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Acuérdate de tu congregación",
          "que adquiriste en tiempos antiguos",
          "y redimiste para que sea la tribu de tu heredad:",
          "este monte Sion en el cual has habitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dirige tus pasos hacia las ruinas perpetuas;",
          "todo lo ha destruido el enemigo en el santuario."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tus adversarios han rugido en medio de tu santuario",
          "y han puesto sus estandartes por señal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Fueron semejantes a los que levantan el hacha contra el tupido bosque."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ahora, con hachas y barras",
          "han destruido todas tus entalladuras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Han prendido fuego a tu santuario;",
          "han profanado el tabernáculo de tu nombre, echándolo a tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dijeron en su corazón:",
          "“¡Destruyámoslos de una vez!”.",
          "Han quemado todos los lugares de culto a Dios en el país."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ya no distinguimos nuestras señales;",
          "ya no hay profeta,",
          "ni con nosotros hay quien sepa hasta cuándo…"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Hasta cuándo, oh Dios, nos ha de afrentar el adversario?",
          "¿Ha de ultrajar el enemigo tu nombre perpetuamente?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Por qué retraes tu mano",
          "y retienes tu diestra en tu seno?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sin embargo, Dios es mi Rey desde los tiempos antiguos.",
          "Él es quien obra salvación en medio de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tú con tu poder dividiste el mar;",
          "rompiste sobre las aguas la cabeza de los monstruos acuáticos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tú machacaste las cabezas del Leviatán,",
          "y lo diste por comida a los moradores del desierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Tú abriste el manantial y el arroyo;",
          "tú secaste los ríos inagotables."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tuyo es el día,",
          "tuya es también la noche;",
          "tú estableciste la luna y el sol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tú fijaste todas las fronteras de la tierra.",
          "El verano y el invierno, tú los formaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Acuérdate de que el enemigo ha injuriado al SEÑOR;",
          "un pueblo vil ha blasfemado tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "No entregues a las fieras la vida de tu tórtola;",
          "no olvides para siempre la congregación de tus pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Mira el pacto;",
          "porque los tenebrosos lugares de la tierra",
          "están llenos de moradas de violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No vuelva avergonzado el oprimido;",
          "alaben tu nombre el pobre y el necesitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Levántate, oh Dios; defiende tu causa.",
          "Acuérdate de cómo te injuria el vil todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "No olvides el vocerío de tus enemigos;",
          "constantemente sube el tumulto",
          "de los que se levantan contra ti."
        ],
        "rlw_lines": []
      }
    ]
  },
