    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza al Dios de justicia"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Mut-laben. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Te alabaré, oh SEÑOR, con todo mi corazón;",
          "contaré todas tus maravillas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Me alegraré y me regocijaré en ti;",
          "cantaré a tu nombre, oh Altísimo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cuando mis enemigos volvieron atrás,",
          "cayeron y perecieron ante ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque has defendido mi juicio y mi causa;",
          "te has sentado en el trono del Juez de justicia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Reprendiste a las naciones;",
          "destruiste a los impíos;",
          "el nombre de ellos has borrado para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El enemigo ha sucumbido para siempre;",
          "sus ciudades has destruido;",
          "con ellas pereció su recuerdo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pero el SEÑOR permanecerá para siempre;",
          "ha dispuesto su trono para juicio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Él juzgará al mundo con justicia;",
          "hará juicio a los pueblos con rectitud."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El SEÑOR será un alto refugio para el oprimido,",
          "un refugio en los tiempos de angustia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "En ti confiarán los que conocen tu nombre",
          "pues tú, oh SEÑOR, no abandonaste a los que te buscaron."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Canten al SEÑOR, que habita en Sion;",
          "cuenten en los pueblos sus hechos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque el Vengador de la sangre se acordó de ellos;",
          "no se olvidó del clamor de los pobres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ten compasión de mí, oh SEÑOR.",
          "Mira la aflicción que me han causado los que me aborrecen;",
          "tú, que me levantas de las puertas de la muerte,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "para que cuente todas tus alabanzas",
          "en las puertas de la hija de Sion",
          "y me goce en tu salvación."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Las naciones se hundieron en la fosa que hicieron;",
          "en la red que escondieron fue atrapado su pie."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El SEÑOR se dio a conocer por el juicio que hizo;",
          "los impíos fueron atrapados en la obra de sus propias manos.",
          "Higayón, Selah"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los impíos serán trasladados al Seol,",
          "todas las naciones que se olvidan de Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Porque el necesitado no será olvidado para siempre",
          "ni la esperanza de los pobres perecerá eternamente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Levántate, oh SEÑOR!",
          "¡Que no prevalezca el hombre!",
          "Sean juzgadas las naciones delante de ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Infúndeles pánico, oh SEÑOR.",
          "Que sepan las naciones que no son más que hombres.",
          "Selah"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
