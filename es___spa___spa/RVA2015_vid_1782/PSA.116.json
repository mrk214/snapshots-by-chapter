    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Gratitud al ser librado de la muerte"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Amo al SEÑOR,",
          "pues ha escuchado mi voz y mis súplicas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "porque ha inclinado a mí su oído.",
          "Por tanto, le invocaré todos mis días."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Me rodearon las ataduras de la muerte;",
          "me encontraron las angustias del Seol.",
          "En angustia y en dolor me encontraba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Entonces invoqué el nombre del SEÑOR",
          "diciendo: “¡Libra, oh SEÑOR, mi vida!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Clemente y justo es el SEÑOR;",
          "sí, misericordioso es nuestro Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El SEÑOR guarda a los ingenuos;",
          "estaba yo postrado, y él me salvó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Vuelve, oh alma mía, a tu reposo",
          "porque el SEÑOR te ha favorecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Porque tú has librado",
          "mi vida de la muerte,",
          "mis ojos de las lágrimas",
          "y mis pies de la caída."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Andaré delante del SEÑOR",
          "en la tierra de los vivientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Creí; por tanto, hablé",
          "estando afligido en gran manera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Y dije en mi apresuramiento:",
          "“Todo hombre es mentiroso”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Qué daré al SEÑOR",
          "por todas sus bendiciones para conmigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Alzaré la copa de la salvación",
          "e invocaré el nombre del SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cumpliré mis votos al SEÑOR",
          "delante de todo su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Estimada es en los ojos del SEÑOR",
          "la muerte de sus fieles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Escúchame, oh SEÑOR, porque yo soy tu siervo;",
          "soy tu siervo, hijo de tu sierva.",
          "Tú rompiste mis cadenas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Te ofreceré sacrificio de acción de gracias",
          "e invocaré el nombre del SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cumpliré mis votos al SEÑOR",
          "delante de todo su pueblo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "en los atrios de la casa del SEÑOR,",
          "en medio de ti, oh Jerusalén.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
