    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El hombre necio y corrupto"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dijo el necio en su corazón:",
          "“No hay Dios”.",
          "Se han corrompido;",
          "han hecho cosas abominables.",
          "No hay quien haga el bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El SEÑOR miró desde los cielos",
          "sobre los hijos del hombre",
          "para ver si había algún sensato que buscara a Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pero todos se habían desviado;",
          "a una se habían corrompido.",
          "No había quien hiciera el bien;",
          "no había ni siquiera uno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Acaso todos los que obran iniquidad no saben que comen a mi pueblo como si fuera pan,",
          "y que al SEÑOR no invocan?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Allí temblarán de espanto",
          "porque Dios está con la generación de los justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Del consejo del pobre se han mofado",
          "pero el SEÑOR es su refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Quién hiciera que de Sion viniese",
          "la salvación de Israel!",
          "Cuando el SEÑOR restaure de la cautividad a su pueblo",
          "se gozará Jacob; se alegrará Israel."
        ],
        "rlw_lines": []
      }
    ]
  },
