    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración pidiendo liberación"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David. Para conmemorar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Ten a bien, oh Dios, librarme!",
          "¡Oh SEÑOR, apresúrate a socorrerme!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sean avergonzados y humillados los que buscan mi vida.",
          "Vuelvan atrás y sean confundidos los que desean mi mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Vuelvan a causa de su vergüenza",
          "los que dicen: “¡Ajá, ajá!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Gócense y alégrense en ti todos los que te buscan.",
          "Digan siempre los que aman tu salvación:",
          "“¡Dios sea engrandecido!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aunque yo sea pobre y necesitado,",
          "¡apresúrate y ven a mí, oh Dios!",
          "Tú eres mi ayuda y mi libertador.",
          "¡Oh SEÑOR, no te tardes!"
        ],
        "rlw_lines": []
      }
    ]
  },
