    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Nostalgia por Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Junto a los ríos de Babilonia nos sentábamos y llorábamos",
          "acordándonos de Sion."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sobre los sauces en medio de ella",
          "colgábamos nuestras liras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Los que allá nos habían llevado cautivos nos pedían cantares;",
          "los que nos habían hecho llorar nos pedían alegría, diciendo:",
          "“Cántennos algunos de los cánticos de Sion”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Cómo cantaremos las canciones del SEÑOR en tierra de extraños?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Si me olvido de ti, oh Jerusalén,",
          "que mi mano derecha olvide su destreza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mi lengua se pegue a mi paladar",
          "si no me acuerdo de ti,",
          "si no ensalzo a Jerusalén",
          "como principal motivo de mi alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Acuérdate, oh SEÑOR,",
          "de los hijos de Edom",
          "que en el día de Jerusalén decían:",
          "“¡Arrásenla!",
          "¡Arrásenla hasta los cimientos!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oh hija de Babilonia,",
          "la despojadora:",
          "¡Bienaventurado el que te dé la paga",
          "por lo que tú nos hiciste!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Bienaventurado el que tome a tus pequeños",
          "y los estrelle contra la roca!"
        ],
        "rlw_lines": []
      }
    ]
  },
