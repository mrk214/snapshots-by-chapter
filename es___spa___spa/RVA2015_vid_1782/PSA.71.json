    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración de un anciano en peligro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Socórreme y líbrame en tu justicia.",
          "Inclina a mí tu oído y sálvame."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sé tú mi roca fuerte",
          "a donde recurra yo continuamente.",
          "Has mandado que yo sea librado",
          "porque tú eres mi roca y mi fortaleza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Oh Dios mío,",
          "líbrame de la mano de los impíos,",
          "de la mano de los perversos y opresores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque tú, oh SEÑOR Dios, eres mi esperanza,",
          "mi seguridad desde mi juventud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por ti he sido sustentado desde el vientre;",
          "tú eres quien me sacó del seno de mi madre.",
          "Siempre será tuya mi alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Para muchos he sido objeto de asombro",
          "pero tú eres mi fuerte refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Esté llena mi boca de tu alabanza,",
          "de tu gloria todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No me deseches en el tiempo de la vejez;",
          "no me desampares cuando mi fuerza se acabe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque mis enemigos han hablado contra mí,",
          "y los que acechan mi vida consultan unidos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "diciendo: “Dios lo ha abandonado.",
          "Persíganlo y captúrenlo,",
          "porque no hay quien lo libre”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Oh Dios, no te alejes de mí;",
          "Dios mío, apresúrate a socorrerme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sean avergonzados y desfallezcan los adversarios de mi alma.",
          "Sean cubiertos de vergüenza y de confusión los que buscan mi mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pero yo siempre esperaré;",
          "te alabaré más y más."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mi boca proclamará tu justicia",
          "y tu salvación todo el día,",
          "aunque no sepa enumerarlas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Celebraré los poderosos hechos del SEÑOR Dios;",
          "haré memoria de tu justicia, que es solo tuya."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Oh Dios, tú me has enseñado desde mi juventud;",
          "hasta ahora he manifestado tus maravillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Aun en la vejez y en las canas",
          "no me desampares, oh Dios,",
          "hasta que proclame a la posteridad",
          "las proezas de tu brazo,",
          "tu poderío a todos los que han de venir,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "y tu justicia, oh Dios, hasta lo sumo.",
          "Porque has hecho grandes cosas.",
          "¡Oh Dios, quién como tú!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Tú, que me has hecho ver",
          "muchas angustias y males,",
          "volverás a darme vida",
          "y de nuevo me levantarás",
          "desde los abismos de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Aumentarás mi grandeza",
          "y me volverás a consolar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Asimismo, oh Dios mío,",
          "te alabaré con la lira.",
          "Tu verdad cantaré con el arpa,",
          "oh Santo de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Mis labios se alegrarán",
          "cuando yo te cante salmos;",
          "aun mi alma, a la cual has redimido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "También mi lengua hablará de tu justicia todo el día",
          "porque fueron avergonzados y confundidos los que procuraban mi mal."
        ],
        "rlw_lines": []
      }
    ]
  },
