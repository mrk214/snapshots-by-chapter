    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primera intervención de Elifaz"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces intervino Elifaz el temanita y dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "—Si alguien intentara hablarte,",
          "¿te impacientarías?",
          "Pero, ¿quién podrá reprimir las palabras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "He aquí, tú instruías a muchos",
          "y afirmabas las manos debilitadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tus palabras levantaban",
          "al que tropezaba,",
          "y fortalecías las rodillas endebles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero ahora te sucede a ti",
          "y te impacientas;",
          "ha llegado a ti, y te turbas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿Acaso tu confianza no es tu devoción;",
          "y la integridad de tus caminos,",
          "tu esperanza?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Recuerda, por favor,",
          "¿quién ha perecido por ser inocente? ¿Dónde han sido destruidos los rectos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como he visto, los que aran iniquidad",
          "y siembran sufrimiento cosechan",
          "lo mismo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Perecen por el aliento de Dios,",
          "y por el soplo de su ira son consumidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El rugido del león, el gruñido del cachorro,",
          "y los dientes de los leoncillos son quebrantados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El león perece por falta de presa,",
          "y los hijos de la leona se dispersan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Un mensaje me ha sido traído",
          "en secreto,",
          "y mi oído ha percibido un susurro de ello:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "En medio de los inquietantes pensamientos de las visiones nocturnas,",
          "cuando el sueño profundo cae sobre los hombres,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "me sobrevinieron espanto",
          "y estremecimiento",
          "que aterraron todos mis huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Entonces un fantasma pasó frente a mí,",
          "e hizo que se erizara el vello",
          "de mi cuerpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Se detuvo, pero yo no reconocí su semblante.",
          "Ante mis ojos había una imagen,",
          "y oí una voz apacible:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“¿Será el hombre más justo que Dios? ¿Será el varón más puro que su Hacedor?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si Dios no se fía ni de sus siervos",
          "y aun en sus ángeles halla errores,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡cuánto más los que habitan",
          "en casas de barro,",
          "cuyos fundamentos están en el polvo, serán aplastados más pronto",
          "que la polilla!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "De la mañana a la tarde son triturados; sin que nadie los considere,",
          "se pierden para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¿Acaso no serán arrancadas",
          "las cuerdas de sus tiendas?",
          "En ellas mueren, pero sin sabiduría”."
        ],
        "rlw_lines": []
      }
    ]
  },
