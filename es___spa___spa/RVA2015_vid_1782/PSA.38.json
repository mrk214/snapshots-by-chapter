    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria en el sufrimiento"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David. Para conmemorar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, no me reprendas en tu furor",
          "ni me castigues en tu ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque tus flechas han penetrado en mí,",
          "y sobre mí ha descendido tu mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No hay parte sana en mi cuerpo a causa de tu ira;",
          "no hay paz en mis huesos a causa de mi pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque mis iniquidades han sobrepasado mi cabeza;",
          "como carga pesada me agobian."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Hieden y supuran mis heridas",
          "a causa de mi locura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Estoy encorvado y abatido en gran manera;",
          "ando enlutado todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque mis espaldas están inflamadas,",
          "y no hay parte sana en mi cuerpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Estoy debilitado y totalmente molido;",
          "gimo a causa de la conmoción de mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Oh Señor, delante de ti están todos mis deseos,",
          "y mi gemido no te es oculto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mi corazón palpita fuertemente,",
          "y mi vigor me ha abandonado.",
          "Aun la luz de mis ojos ya no está conmigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mis amigos y compañeros se han apartado de mi plaga;",
          "mis parientes se han mantenido alejados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Los que buscaban mi vida armaron trampas,",
          "y los que procuraban mi mal profirieron amenazas.",
          "Maquinaban fraudes todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pero yo, como si fuera sordo, no escuchaba,",
          "y era como un mudo que no abre la boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Actué como un hombre que no oye,",
          "y en cuya boca no hay amonestación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pues en ti, oh SEÑOR, he esperado;",
          "tú responderás, oh SEÑOR, Dios mío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque dije:",
          "“No sea que se alegren de mí",
          "y, cuando resbale mi pie, se enaltezcan sobre mí”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Porque yo estoy a punto de caer,",
          "y mi dolor está delante de mí continuamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Por eso confesaré mi iniquidad;",
          "me acongojaré por mi pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Porque mis enemigos están vivos y fuertes;",
          "se han aumentado los que me aborrecen sin motivo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Los que pagan mal por bien me son hostiles",
          "por seguir yo lo bueno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No me desampares, oh SEÑOR.",
          "Dios mío, no te alejes de mí;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "apresúrate a socorrerme,",
          "oh Señor, salvación mía."
        ],
        "rlw_lines": []
      }
    ]
  },
