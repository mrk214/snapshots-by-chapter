    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Quinta lamentación"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Acuérdate, oh SEÑOR, de lo que nos ha sucedido.",
          "Mira y ve nuestro oprobio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nuestra heredad ha pasado a los extraños,",
          "nuestras casas a los extranjeros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Estamos huérfanos; no tenemos padre;",
          "nuestras madres han quedado viudas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Nuestra agua bebemos por dinero;",
          "nuestra leña nos viene por precio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sobre nuestros cuellos están los que nos persiguen.",
          "Nos fatigamos y para nosotros no hay reposo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Hacia Egipto extendimos las manos;",
          "y hacia Asiria, para saciarnos de pan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nuestros padres pecaron y ya no están;",
          "nosotros cargamos con su castigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Aun los esclavos se han enseñoreado de nosotros;",
          "no hubo quien nos librara de su mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Con riesgo de nuestras vidas traemos nuestro pan,",
          "ante la espada del desierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Nuestra piel se ha ennegrecido como un horno,",
          "a causa de los ardores del hambre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A las mujeres violaron en Sion,",
          "y a las vírgenes en las ciudades de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Los príncipes fueron colgados de sus manos;",
          "no fue respetada la persona de los ancianos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Los jóvenes cargaron piedras de molino;",
          "los muchachos desfallecieron bajo la carga de la leña."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los ancianos han dejado de acudir a las puertas de la ciudad;",
          "los jóvenes han dejado sus canciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ha cesado el regocijo de nuestro corazón;",
          "nuestra danza se ha convertido en duelo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Cayó la corona de nuestra cabeza.",
          "¡Ay de nosotros, porque hemos pecado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Por esto está enfermo nuestro corazón;",
          "por esto se han ensombrecido nuestros ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Por el monte Sion, que ha quedado desolado,",
          "se pasean las zorras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pero tú, oh SEÑOR, reinarás para siempre;",
          "tu trono es de generación en generación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Por qué te olvidarás de nosotros para siempre",
          "y nos dejarás a lo largo de los días?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Haz que volvamos a ti, oh SEÑOR, y volveremos.",
          "Renueva nuestros días como en los tiempos pasados,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "aunque nos hayas desechado",
          "y te hayas airado en gran manera contra nosotros."
        ],
        "rlw_lines": []
      }
    ]
  },
