    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sion, la morada elegida"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canto de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Acuérdate, oh SEÑOR,",
          "de David y de toda su aflicción"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "de cómo juró al SEÑOR",
          "y prometió al Fuerte de Jacob, diciendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“No entraré en mi morada",
          "ni subiré a mi cama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No daré sueño a mis ojos",
          "ni a mis párpados sopor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "hasta que halle un lugar para el SEÑOR,",
          "una morada para el Fuerte de Jacob”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "He aquí, en Efrata oímos de ella,",
          "y la encontramos en los campos de Yaar:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Entremos en su tabernáculo;",
          "postrémonos ante el estrado de sus pies”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Levántate, oh SEÑOR;",
          "ven al lugar de tu reposo;",
          "tú y el arca de tu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tus sacerdotes sean revestidos de justicia,",
          "y tus fieles canten de júbilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por causa de tu siervo David,",
          "no rechaces el rostro de tu ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Con verdad juró el SEÑOR a David,",
          "y no se apartará de ello:",
          "“Del fruto de tu cuerpo",
          "pondré sobre tu trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si tus hijos guardan mi pacto",
          "y este testimonio que yo les enseño,",
          "sus hijos también se sentarán",
          "en tu trono para siempre”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Porque el SEÑOR ha elegido a Sion",
          "y la ha deseado como morada suya:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Este es mi lugar de reposo para siempre.",
          "Aquí habitaré porque lo he deseado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Lo bendeciré con abundante provisión;",
          "a sus necesitados saciaré de pan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Asimismo, vestiré de salvación a sus sacerdotes,",
          "y sus fieles darán voces de júbilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Allí haré surgir el poderío de David;",
          "he preparado una lámpara para mi ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "A sus enemigos vestiré de vergüenza",
          "pero sobre él resplandecerá su corona”."
        ],
        "rlw_lines": []
      }
    ]
  },
