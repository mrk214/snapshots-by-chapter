    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Job continuó su discurso y dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "—¡Quién me concediese ser",
          "como en los meses pasados,",
          "como en los días cuando",
          "Dios me guardaba!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Entonces él hacía resplandecer",
          "su lámpara sobre mi cabeza,",
          "y a su luz yo caminaba en la oscuridad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Así fue en los días de mi vigor. cuando la amistad íntima de Dios estaba sobre mi morada;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "cuando el Todopoderoso aún estaba conmigo,",
          "y mis hijos estaban alrededor de mí;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "cuando mis pasos se bañaban en leche,",
          "y la roca me vertía corrientes de aceite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Entonces yo iba al tribunal de la ciudad y alistaba mi asiento en la plaza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los jóvenes me veían",
          "y se hacían a un lado;",
          "los ancianos se levantaban",
          "y permanecían de pie."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los magistrados detenían sus palabras",
          "y ponían la mano sobre su boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "La voz de los nobles se apagaba",
          "y su lengua se pegaba a su paladar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Cuando los oídos me oían,",
          "me llamaban: “¡Dichoso!”.",
          "Cuando los ojos me veían,",
          "daban testimonio en mi favor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque yo libraba al pobre que clamaba y al huérfano que no tenía",
          "quien le ayudara."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La bendición del moribundo caía sobre mí,",
          "y yo daba alegría al corazón de la viuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Yo me vestía de rectitud,",
          "y ella me vestía a mí;",
          "como manto y turbante era mi justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "»Yo era ojos para el ciego",
          "y pies para el cojo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Era un padre para los necesitados,",
          "e investigaba la causa que no conocía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Yo rompía las quijadas del inicuo,",
          "y de sus dientes arrancaba la presa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "»Yo me decía: “En mi nido expiraré,",
          "y multiplicaré mis días como la arena”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Mi raíz alcanzaba hasta las aguas,",
          "y de noche el rocío se posaba en mis ramas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Mi honra se mantenía nueva en mí,",
          "y mi arco se renovaba en mi mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»Ellos me escuchaban y esperaban; ante mi consejo guardaban silencio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Después de mi palabra no volvían",
          "a hablar,",
          "y mi discurso destilaba sobre ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Me esperaban como a la lluvia,",
          "y abrían su boca como a la lluvia tardía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Cuando me reía con ellos, ¡no lo creían! No dejaban decaer la luz de mi rostro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Yo escogía el camino para ellos",
          "y me sentaba como su jefe.",
          "Yo vivía como un rey",
          "que está en medio de sus tropas, como el que consuela a los que están de duelo."
        ],
        "rlw_lines": []
      }
    ]
  },
