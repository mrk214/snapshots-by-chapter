    "name": "1 Crónicas"
  },
  "chapter": {
    "chapter_usfm": "1CH.2",
    "current": {
      "usfm": "1CH.2",
      "human": "1 Crónicas 2"
    },
    "previous": {
      "usfm": "1CH.1",
