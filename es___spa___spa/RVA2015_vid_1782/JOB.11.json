{"version":{"version_id":1782,"local_abbreviation":"RVA2015","local_title":"Reina Valera Actualizada","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"Editorial Mundo Hispano"},"copyright":{"html":"<p>Copyright © 2015 by Editorial Mundo Hispano</p>","text":"Copyright © 2015 by Editorial Mundo Hispano"}},"book":{"book_usfm":"JOB","name":"Job"},"chapter":{"chapter_usfm":"JOB.11","is_chapter":true,"previous":{"usfm":"JOB.10","human":"Job 10","canonical":true,"toc":true},"current":{"usfm":"JOB.11","human":"Job 11"},"next":{"usfm":"JOB.12","human":"Job 12","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Primera intervención de Zofar"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Entonces intervino Zofar el namatita y dijo:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["—¿No ha de tener respuesta","tal abundancia de palabras?","¿Habrá de salir justificado el charlatán?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["¿Harán callar a los hombres","tus jactancias?","¿Harás escarnio sin que haya quien","te afrente?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Tú dices: “Mi doctrina es pura,","y yo soy limpio ante tus ojos”."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Pero, ¡quién diera que Dios hablara","y abriera sus labios para contigo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Él te revelaría los secretos","de la sabiduría,","porque la sagacidad es de doble valor. Así conocerías que Dios, en tu favor,","ha pasado por alto parte de tu iniquidad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["»¿Alcanzarás tú las cosas profundas","de Dios?","¿Alcanzarás el propósito del Todopoderoso?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Es más alto que los cielos;","¿qué puedes hacer?","Es más profundo que el Seol; ¿qué puedes saber?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Su dimensión es más extensa","que la tierra","y más ancha que el mar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["»Si Dios pasa y aprisiona, o si congrega, ¿quién le puede detener?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Ya que él conoce a los hombres vanos, ¿no examinará la iniquidad cuando la vea?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["El hombre de cabeza hueca se hará","inteligente","cuando un borriquillo de asno montés nazca humano."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["»Si predispones tu corazón","y extiendes a él tus manos"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["(si hay injusticia en tus manos, aléjala de ti,","y no cobijes la maldad en tu morada),"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["entonces levantarás tu cara libre de mancha,","estarás sólidamente fundado","y no temerás."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Pues así te olvidarás de tu sufrimiento como aguas que ya pasaron","lo recordarás."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Tu existencia será más resplandeciente que el mediodía;","aun la oscuridad te será como","la alborada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Estarás confiado, porque hay esperanza; explorarás alrededor y te acostarás","seguro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Te recostarás y no habrá quien","te espante;","muchos implorarán tu favor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Pero los ojos de los malos serán consumidos;","no habrá para ellos escapatoria,","y su esperanza es dar el último suspiro."],"rlw_lines":[]}]}}