    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria en medio de la aflicción"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A ti, oh SEÑOR,",
          "levantaré mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Dios mío, en ti confío!",
          "No sea yo avergonzado.",
          "No triunfen sobre mí mis enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ciertamente ninguno de los que confían en ti será avergonzado.",
          "Serán avergonzados los que se rebelan sin causa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Muéstrame, oh SEÑOR, tus caminos;",
          "enséñame tus sendas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Encamíname en tu verdad y enséñame",
          "porque tú eres el Dios de mi salvación.",
          "En ti he esperado todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Acuérdate, oh SEÑOR,",
          "de tu compasión y de tu misericordia que son perpetuas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "No te acuerdes de los pecados de mi juventud ni de mis rebeliones.",
          "Conforme a tu misericordia",
          "acuérdate de mí, por tu bondad, oh SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Bueno y recto es el SEÑOR;",
          "por eso él enseñará a los pecadores el camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Encaminará a los humildes en la justicia",
          "y enseñará a los humildes su camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todas las sendas del SEÑOR son misericordia y verdad",
          "para con los que guardan su pacto y sus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por amor de tu nombre, oh SEÑOR,",
          "perdona también mi iniquidad",
          "porque es grande."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Qué hombre es el que teme al SEÑOR?",
          "Él le enseñará el camino que ha de escoger."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Su alma reposará en bienestar,",
          "y sus descendientes heredarán la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El secreto del SEÑOR es para los que le temen;",
          "a ellos hará conocer su pacto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mis ojos están siempre puestos en el SEÑOR",
          "porque él sacará mis pies de la red."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mírame y ten misericordia de mí",
          "porque estoy solitario y afligido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Las angustias de mi corazón se han aumentado;",
          "sácame de mis congojas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Mira mi aflicción y mis afanes;",
          "perdona todos mis pecados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Mira cómo se han multiplicado mis enemigos,",
          "y con odio violento me aborrecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Guarda mi alma y líbrame;",
          "no sea yo avergonzado",
          "porque en ti me he refugiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "La integridad y la rectitud me guarden",
          "porque en ti he esperado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Redime, oh Dios, a Israel",
          "de todas sus angustias."
        ],
        "rlw_lines": []
      }
    ]
  },
