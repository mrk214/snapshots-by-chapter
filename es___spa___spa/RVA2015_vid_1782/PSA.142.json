    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración de un hombre afligido"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Masquil de David. Su oración cuando estaba en la cueva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Con mi voz clamo al SEÑOR;",
          "con mi voz pido al SEÑOR misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Delante de él derramo mi lamento;",
          "delante de él expreso mi angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cuando mi espíritu está desmayado dentro de mí",
          "tú conoces mi senda.",
          "En el camino en que",
          "he de andar",
          "han escondido una trampa para mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Miro a la derecha y observo,",
          "y no hay quien me reconozca.",
          "No tengo refugio;",
          "no hay quien se preocupe por mi vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A ti clamo, oh SEÑOR.",
          "Digo: “Tú eres mi refugio",
          "y mi porción en la tierra de los vivientes”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Escucha mi clamor porque estoy muy afligido;",
          "líbrame de los que me persiguen",
          "porque son más fuertes que yo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Saca mi alma de la prisión",
          "para que alabe tu nombre.",
          "Los justos me rodearán",
          "porque me colmarás de bien."
        ],
        "rlw_lines": []
      }
    ]
  },
