    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, el único refugio"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. A Jedutún. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Solo en Dios reposa mi alma;",
          "de él proviene mi salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Solo él es mi roca y mi salvación;",
          "él es mi refugio;",
          "no seré grandemente movido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Hasta cuándo se ensañarán contra un hombre?",
          "¿Lo destrozarán todos ustedes como a una pared inclinada o una cerca derribada?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Solamente consultan cómo derribarlo de su eminencia.",
          "Se complacen con la mentira.",
          "Con su boca bendicen",
          "pero en su interior maldicen.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Oh alma mía, reposa solo en Dios",
          "porque de él es mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Solo él es mi roca y mi salvación;",
          "es mi alto refugio; no seré movido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios es mi salvación y mi gloria;",
          "en Dios está la roca de mi fortaleza y mi refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Oh pueblos, esperen en él en todo tiempo;",
          "derramen delante de él su corazón",
          "porque Dios es nuestro refugio.",
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por cierto, vanidad son los hombres comunes;",
          "mentira son los hombres notables.",
          "Si se los pesa a todos juntos en balanza",
          "serán menos que un soplo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No confíen en la opresión",
          "ni se envanezcan con la rapiña.",
          "Aunque se incremente la riqueza",
          "no pongan en ella el corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Una vez habló Dios;",
          "dos veces he oído esto:",
          "que en Dios hay fortaleza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "También en ti, oh Señor, hay misericordia;",
          "pues tú pagas a cada uno según su obra."
        ],
        "rlw_lines": []
      }
    ]
  },
