    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El SEÑOR guarda a su pueblo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1 Canto de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Alzaré mis ojos a los montes;",
          "¿de dónde vendrá mi socorro?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi socorro viene del SEÑOR, que hizo los cielos y la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No permitirá que resbale tu pie",
          "ni se adormecerá el que te guarda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "He aquí, no se adormecerá ni se dormirá",
          "el que guarda a Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El SEÑOR es tu protector;",
          "el SEÑOR es tu sombra a tu mano derecha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El sol no te herirá de día",
          "ni la luna de noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El SEÑOR te guardará de todo mal;",
          "él guardará tu vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El SEÑOR guardará tu salida y tu entrada",
          "desde ahora y para siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
