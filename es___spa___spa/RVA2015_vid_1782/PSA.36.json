    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Maldad del impío y bondad del SEÑOR"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David, siervo de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La transgresión habla al impío dentro de su corazón;",
          "no hay temor de Dios delante de sus ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Por eso se lisonjea en sus propios ojos",
          "hasta que su iniquidad sea aborrecimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Las palabras de su boca son maldad y engaño;",
          "ha dejado de ser sensato y de hacer el bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sobre su cama piensa iniquidad;",
          "está en un camino que no es bueno",
          "y no desprecia el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Oh SEÑOR, hasta los cielos alcanza tu misericordia;",
          "y hasta las nubes, tu fidelidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tu justicia es como las montañas de Dios;",
          "y tus juicios, como el gran océano.",
          "Oh SEÑOR, que conservas al hombre y al animal,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡cuán preciosa es, oh Dios, tu bondad!",
          "Por eso los hijos del hombre",
          "se refugian bajo la sombra de tus alas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Se sacian de la abundancia de tu casa;",
          "les das a beber del torrente de tus delicias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ciertamente contigo está el manantial de la vida;",
          "en tu luz veremos la luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Extiende tu bondad a los que te conocen,",
          "y tu justicia a los rectos de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Que no venga contra mí el pie de la soberbia",
          "ni me desplace la mano de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Entonces caerán los que obran iniquidad;",
          "serán derribados y no podrán levantarse."
        ],
        "rlw_lines": []
      }
    ]
  },
