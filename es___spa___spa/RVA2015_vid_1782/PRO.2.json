    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resultados de aceptar la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hijo mío, si aceptas mis palabras",
          "y atesoras mis mandamientos dentro de ti,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "si prestas oído a la sabiduría",
          "e inclinas tu corazón al entendimiento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "si invocas a la inteligencia",
          "y al entendimiento llamas a gritos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "si como a la plata la buscas",
          "y la rebuscas como a tesoros escondidos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "entonces entenderás el temor del SEÑOR",
          "y hallarás el conocimiento de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque el SEÑOR da la sabiduría,",
          "y de su boca provienen el conocimiento y el entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Él atesora eficiente sabiduría para los rectos;",
          "es el escudo de los que caminan en",
          "integridad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Preserva las sendas del juicio",
          "y guarda el camino de sus piadosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Entonces entenderás la justicia, el derecho y la equidad: todo buen camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cuando la sabiduría entre en",
          "tu corazón",
          "y el conocimiento sea agradable",
          "a tu alma,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "te guardará la sana iniciativa",
          "y te preservará el entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Te librará del mal camino,",
          "de los hombres que hablan",
          "perversidades,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "que abandonan las sendas derechas para andar en caminos tenebrosos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "que se alegran haciendo el mal",
          "y que se gozan en las perversidades del mal,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "cuyos senderos son torcidos",
          "y perversos sus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Te librará de la mujer ajena,",
          "de la extraña que halaga con sus palabras,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "que abandona al compañero",
          "de su juventud",
          "y se olvida del pacto de su Dios ."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ciertamente su casa se hunde hacia",
          "la muerte",
          "y sus sendas hacia los muertos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Todos los que con ella tengan",
          "relaciones no volverán",
          "ni lograrán alcanzar los senderos",
          "de la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Hará que andes por el camino de los buenos",
          "y guardes las sendas de los justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Porque los rectos habitarán la tierra",
          "y los íntegros permanecerán en ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Pero los impíos serán exterminados",
          "de la tierra",
          "y los traicioneros serán desarraigados de ella."
        ],
        "rlw_lines": []
      }
    ]
  },
