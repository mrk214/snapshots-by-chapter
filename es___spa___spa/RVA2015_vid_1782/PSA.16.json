    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Expresión de fidelidad y confianza"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Mictam de David"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Guárdame, oh Dios, porque en ti me he refugiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Oh alma mía, dijiste al SEÑOR:",
          "“¡Tú eres el Señor!",
          "Para mí no hay bien aparte de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Para con los santos que están en la tierra",
          "y para con los íntegros",
          "es toda mi complacencia”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Se multiplicarán los dolores",
          "de quienes se apresuran tras otro dios.",
          "Yo no ofreceré sus sacrificios de sangre",
          "ni con mis labios mencionaré sus nombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Oh SEÑOR, porción de mi herencia, y mi copa,",
          "¡tú sustentas mi destino!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los linderos me han tocado en lugar placentero;",
          "es hermosa la heredad que me ha tocado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Bendeciré al SEÑOR, que me aconseja;",
          "aun en las noches me corrige mi conciencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Al SEÑOR he puesto siempre delante de mí;",
          "porque está a mi mano derecha",
          "no seré movido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por tanto, se alegró mi corazón",
          "y se gozó mi lengua.",
          "También mi cuerpo descansará en seguridad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pues no dejarás mi alma en el Seol",
          "ni permitirás que tu santo vea corrupción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Me mostrarás la senda de la vida.",
          "En tu presencia hay plenitud de gozo,",
          "delicias en tu diestra para siempre."
        ],
        "rlw_lines": []
      }
    ]
  },
