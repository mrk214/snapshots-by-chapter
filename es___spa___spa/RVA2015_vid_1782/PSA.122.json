    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración por la paz de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "1 Canto de ascenso graduala. De David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Yo me alegré con los que me decían:",
          "“¡Vayamos a la casa del SEÑOR!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ya se posan nuestros pies",
          "ante tus puertas, oh Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Oh Jerusalén, que ha sido edificada",
          "como una ciudad toda compacta!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Allá suben las tribus,",
          "las tribus del SEÑOR,",
          "las congregaciones de Israel,",
          "para alabar el nombre del SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque allá están los tronos para el juicio,",
          "los tronos de la casa de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pidan por la paz de Jerusalén:",
          "“Vivan tranquilos los que te aman."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Haya paz dentro de tus murallas",
          "y tranquilidad en tus palacios”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por causa de mis hermanos y de mis amigos,",
          "diré yo: “Haya paz en ti”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por causa de la casa del SEÑOR nuestro Dios,",
          "imploraré por tu bien."
        ],
        "rlw_lines": []
      }
    ]
  },
