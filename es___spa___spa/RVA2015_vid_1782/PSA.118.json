    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La misericordia eterna del SEÑOR"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Alaben al SEÑOR porque es bueno;",
          "porque para siempre es su misericordia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Diga, por favor, Israel:",
          "“¡Para siempre es su misericordia!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Diga, por favor, la casa de Aarón:",
          "“¡Para siempre es su misericordia!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Digan, por favor, los que temen al SEÑOR:",
          "“¡Para siempre es su misericordia!”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Al SEÑOR invoqué desde la angustia,",
          "y el SEÑOR me respondió poniéndome en lugar espacioso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El SEÑOR está conmigo;",
          "no temeré lo que me pueda hacer el hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El SEÑOR está conmigo, con los que me ayudan.",
          "Por tanto, yo veré mi deseo en los que me aborrecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mejor es refugiarse en el SEÑOR",
          "que confiar en el hombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mejor es refugiarse en el SEÑOR",
          "que confiar en los poderosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todas las naciones me rodearon;",
          "en el nombre del SEÑOR yo las destruiré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Me rodearon y me asediaron;",
          "en el nombre del SEÑOR yo las destruiré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Me rodearon como abejas,",
          "ardieron como fuego de espinos;",
          "en el nombre del SEÑOR yo las destruiré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Fui empujado con violencia para que cayese;",
          "pero el SEÑOR me socorrió."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El SEÑOR es mi fortaleza y mi canción;",
          "él es mi salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Voz de júbilo y de salvación",
          "hay en las moradas de los justos!",
          "¡La diestra del SEÑOR hace proezas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡La diestra del SEÑOR está levantada, en alto!",
          "¡La diestra del SEÑOR hace proezas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No moriré, sino que viviré",
          "y contaré las obras del SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Duramente me castigó el SEÑOR",
          "pero no me entregó a la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Ábranme las puertas de la justicia!",
          "Entraré por ellas y daré gracias al SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Esta es la puerta del SEÑOR;",
          "por ella entrarán los justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Te daré gracias",
          "porque me has respondido",
          "y has sido mi salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La piedra que desecharon los edificadores",
          "ha venido a ser la principal del ángulo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "De parte del SEÑOR es esto;",
          "es una maravilla a nuestros ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Este es el día que hizo el SEÑOR;",
          "nos gozaremos y nos alegraremos en él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "¡Oh SEÑOR, sálvanos, por favor!",
          "¡Oh SEÑOR, haznos prosperar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡Bendito el que viene en el nombre del SEÑOR!",
          "Desde la casa del SEÑOR los bendecimos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El SEÑOR es Dios",
          "y nos ha resplandecido.",
          "Aten ramas festivas junto a los cuernos del altar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Mi Dios eres tú; a ti te daré gracias.",
          "Oh Dios mío, a ti te ensalzaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¡Alaben al SEÑOR, porque es bueno;",
          "porque para siempre es su misericordia!"
        ],
        "rlw_lines": []
      }
    ]
  },
