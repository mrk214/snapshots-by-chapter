    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanzas al Rey libertador"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "¡Alaba, oh alma mía, al SEÑOR!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alabaré al SEÑOR en mi vida;",
          "a mi Dios cantaré salmos mientras viva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No confíen en príncipes ni en hijo de hombre",
          "porque no hay en él liberación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Su espíritu ha de salir",
          "y él volverá al polvo.",
          "En aquel día perecerán sus pensamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Bienaventurado aquel cuya ayuda es el Dios de Jacob,",
          "cuya esperanza está puesta en el SEÑOR su Dios;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "quien hizo los cielos, la tierra, el mar",
          "y todo lo que en ellos hay;",
          "quien guarda la verdad para siempre;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "quien hace justicia a los oprimidos",
          "y da pan a los hambrientos.",
          "El SEÑOR suelta a los prisioneros;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "el SEÑOR abre los ojos a los ciegos;",
          "el SEÑOR levanta a los que han sido doblegados;",
          "el SEÑOR ama a los justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El SEÑOR guarda a los forasteros;",
          "sostiene al huérfano y a la viuda",
          "pero trastorna el camino de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El SEÑOR reinará para siempre;",
          "tu Dios, oh Sion, de generación en generación.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
