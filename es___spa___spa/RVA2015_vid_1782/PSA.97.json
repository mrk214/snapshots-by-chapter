    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Manifestación del Rey de gloria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡El SEÑOR reina!",
          "¡Regocíjese la tierra!",
          "¡Alégrense las muchas costas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nube y oscuridad hay alrededor de él;",
          "la justicia y el derecho son el fundamento de su trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El fuego avanza delante de él",
          "y abrasa a sus enemigos en derredor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sus relámpagos alumbran el mundo;",
          "la tierra mira y se estremece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Delante del Señor los montes se derriten como cera,",
          "delante del SEÑOR de toda la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los cielos anuncian su justicia,",
          "y todos los pueblos ven su gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Avergüéncense todos los que sirven a imágenes de talla,",
          "los que se glorían en los ídolos.",
          "¡Todos los dioses póstrense ante él!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sion escuchó y se alegró;",
          "las hijas de Judá se regocijarán",
          "a causa de tus juicios, oh SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque tú, oh SEÑOR,",
          "eres supremo sobre toda la tierra;",
          "eres muy enaltecido sobre todos los dioses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los que aman al SEÑOR",
          "aborrezcan el mal.",
          "Él guarda la vida de sus fieles;",
          "los libra de manos de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "La luz está sembrada para el justo,",
          "la alegría para los rectos de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Alégrense, oh justos, en el SEÑOR;",
          "celebren la memoria de su santidad."
        ],
        "rlw_lines": []
      }
    ]
  },
