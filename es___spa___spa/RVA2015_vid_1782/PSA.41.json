    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración desde el lecho de dolor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Bienaventurado el que se preocupa del pobre!",
          "En el día malo lo librará el SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El SEÑOR lo guardará y le dará vida",
          "para que sea feliz en la tierra.",
          "No lo entregará a la voluntad de sus enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El SEÑOR lo sustentará en el lecho de dolor.",
          "En su enfermedad, tú transformarás su postración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Yo dije: “Oh SEÑOR,",
          "ten misericordia de mí;",
          "sana mi alma",
          "porque contra ti he pecado”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mis enemigos hablan mal de mí y preguntan:",
          "“¿Cuándo se morirá y perecerá su nombre?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Si alguien viene a verme, habla mentira.",
          "Su corazón acumula iniquidad para sí,",
          "y saliendo afuera, lo divulga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Reunidos murmuran contra mí todos los que me aborrecen;",
          "contra mí traman el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Algo abominable se ha derramado sobre él.",
          "El que cayó en la cama",
          "no se volverá a levantar”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Aun mi amigo íntimo,",
          "en quien yo confiaba y quien comía de mi pan,",
          "ha levantado contra mí el talón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pero tú, oh SEÑOR,",
          "ten misericordia de mí;",
          "haz que me levante,",
          "y les daré su merecido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "En esto conoceré que de mí te has agradado:",
          "en que mi enemigo no cante victoria sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "En cuanto a mí, en mi integridad me has sustentado,",
          "y me haces estar delante de ti para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Bendito sea el SEÑOR Dios de Israel,",
          "desde la eternidad hasta la eternidad!",
          "Amén y amén."
        ],
        "rlw_lines": []
      }
    ]
  },
