    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La brevedad de la vida"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. A Jedutún. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Yo dije: “Cuidaré mis caminos",
          "para no pecar con mi lengua.",
          "Guardaré mi boca con freno",
          "en tanto que el impío esté frente a mí”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Enmudecí, quedé en silencio;",
          "me callé aun respecto de lo bueno,",
          "pero mi dolor se agravó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mi corazón se enardeció dentro de mí;",
          "fuego se encendió en mi suspirar,",
          "y así hablé con mi lengua:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Hazme saber, oh SEÑOR, mi final,",
          "y cuál sea la medida de mis días.",
          "Sepa yo cuán pasajero soy."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "He aquí, has hecho que mis días sean breves;",
          "mi existencia es como nada delante de ti.",
          "De veras, solo vanidad es todo hombre en su gloria. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "En la oscuridad deambula el hombre;",
          "de veras, en vano se inquieta por acumular,",
          "y no sabe quién lo recogerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ahora, oh Señor, ¿qué esperaré?",
          "Mi esperanza está en ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Líbrame de todas mis rebeliones;",
          "no me pongas por burla del insensato."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Enmudecí; no abrí mi boca",
          "porque tú eres quien lo hizo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Aparta de mí tu plaga;",
          "por el movimiento de tu mano soy consumido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Con castigos por el pecado corriges al hombre",
          "y deshaces como polilla su hermosura.",
          "Ciertamente vanidad es todo hombre. Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Escucha mi oración, oh SEÑOR;",
          "oye mi clamor y no calles ante mis lágrimas.",
          "Porque forastero soy para ti,",
          "un advenedizo, como todos mis padres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Aparta de mí tu mirada, de modo que me alegre",
          "antes que me vaya y deje de ser."
        ],
        "rlw_lines": []
      }
    ]
  },
