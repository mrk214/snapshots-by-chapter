    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "He venido a mi huerto,",
          "oh hermana y novia mía.",
          "He recogido mi mirra y mi perfume. He comido mi panal y mi miel;",
          "he bebido mi vino y mi leche.",
          "¡Coman, oh amigos!",
          "¡Beban, oh amados!",
          "¡Beban en abundancia!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Yo dormía, pero mi corazón estaba despierto,",
          "y oí a mi amado que tocaba a la puerta y llamaba:",
          "“Ábreme, hermana mía, amada mía,",
          "paloma mía, perfecta mía;",
          "porque mi cabeza está llena de rocío",
          "y mis cabellos están mojados",
          "con las gotas de la noche”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ya me había desvestido;",
          "¿cómo me iba a volver a vestir?",
          "Había lavado mis pies;",
          "¿cómo iba a volverlos a ensuciar?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi amado metió su mano",
          "por el agujero de la puerta,",
          "y mi corazón se conmovió a causa de él."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Entonces me levanté",
          "para abrir a mi amado,",
          "y mis manos gotearon perfume de mirra.",
          "Mis dedos gotearon mirra",
          "sobre la manecilla del cerrojo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Abrí a mi amado,",
          "pero mi amado se había ido;",
          "había desaparecido.",
          "Se me salía el alma",
          "cuando él hablaba.",
          "Lo busqué, pero no lo hallé;",
          "lo llamé, pero no me respondió."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Me encontraron los guardias",
          "que rondan la ciudad;",
          "me golpearon y me hirieron.",
          "Me despojaron de mi manto",
          "los guardias de las murallas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Júrenme, oh hijas de Jerusalén,",
          "que si hallan a mi amado",
          "le dirán que estoy enferma de amor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El cortejo nupcial"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Qué tiene tu amado",
          "que no tenga cualquier otro amado,",
          "oh la más hermosa",
          "de todas las mujeres?",
          "¿Qué tiene tu amado",
          "más que cualquier otro amado",
          "para que nos hagas jurar así?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mi amado es blanco y sonrosado;",
          "sobresale entre diez mil."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Su cabeza es oro fino.",
          "Sus cabellos son ondulados, negros como el cuervo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sus ojos son como palomas",
          "junto a los arroyos de aguas,",
          "bañados en leche y sentados",
          "sobre engastes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sus mejillas son como almácigos",
          "de especias aromáticas que",
          "exhalan perfumes.",
          "Sus labios son como lirios que despiden penetrante aroma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sus manos son como barras de oro engastadas con crisólitos.",
          "Su vientre es como una plancha de marfil,",
          "recubierta con zafiros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Sus piernas son como columnas de mármol cimentadas sobre bases de oro.",
          "Su figura es como el Líbano, escogido como los cedros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Su paladar es dulcísimo;",
          "¡todo él es deseable!",
          "Así es mi amado y así es mi amigo,",
          "oh hijas de Jerusalén."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
