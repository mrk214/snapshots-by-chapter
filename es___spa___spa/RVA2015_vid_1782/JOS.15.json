  },
  "book": {
    "book_usfm": "JOS",
    "name": "Josué"
  },
  "chapter": {
    "chapter_usfm": "JOS.15",
    "current": {
      "usfm": "JOS.15",
      "human": "Josué 15"
    },
    "previous": {
      "usfm": "JOS.14",
