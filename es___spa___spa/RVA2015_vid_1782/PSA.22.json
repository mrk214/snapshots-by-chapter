    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Testimonio de sufrimiento y victoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Ayélet ha-sájar. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Dios mío, Dios mío!",
          "¿Por qué me has desamparado?",
          "¿Por qué estás tan lejos de mi salvación",
          "y de las palabras de mi clamor?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Dios mío, clamo de día y no respondes;",
          "clamo de noche y no hay sosiego para mí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pero tú eres santo.",
          "¡Tú, que habitas entre las alabanzas de Israel!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Nuestros padres esperaron en ti:",
          "Esperaron, y tú los libraste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Clamaron a ti, y fueron librados;",
          "confiaron en ti, y no fueron defraudados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pero yo soy un gusano y no un hombre,",
          "objeto de la afrenta de los hombres y despreciado del pueblo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todos los que me ven se burlan de mí.",
          "Estiran los labios y mueven la cabeza diciendo:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“En el SEÑOR confió; que él lo rescate.",
          "Que lo libre, ya que de él se agradó”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pero tú eres el que me sacó del vientre;",
          "me has hecho estar confiado desde que estaba a los pechos de mi madre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Sobre ti fui echado desde la matriz;",
          "desde el vientre de mi madre",
          "tú eres mi Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "No te alejes de mí,",
          "porque la angustia está cerca",
          "y no hay quien ayude."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Muchos toros me han rodeado;",
          "fuertes toros de Basán me han cercado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Contra mí abrieron su boca,",
          "como león voraz y rugiente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Soy derramado como el agua;",
          "todos mis huesos se han desarticulado.",
          "Mi corazón está como cera",
          "y se ha derretido en medio de mis entrañas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mi vigor se ha secado como un tiesto,",
          "y mi lengua se ha pegado a mi paladar.",
          "Me has puesto en el polvo de la muerte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los perros me han rodeado;",
          "me ha cercado una pandilla de malhechores,",
          "y horadaron mis manos y mis pies."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Puedo contar todos mis huesos;",
          "ellos me miran y me observan."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Reparten entre sí mis vestidos,",
          "y sobre mi ropa echan suertes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pero tú, oh SEÑOR, no te alejes.",
          "Fortaleza mía, apresúrate para ayudarme."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Libra mi alma de la espada;",
          "libra mi única vida de las garras de los perros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Sálvame de la boca del león",
          "y de los cuernos de los toros salvajes.",
          "¡Me has respondido!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Anunciaré tu nombre a mis hermanos;",
          "en medio de la congregación te alabaré."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Los que temen al SEÑOR, alábenle;",
          "glorifíquenle todos los descendientes de Jacob.",
          "Teman ustedes, todos los descendientes de Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Porque no despreció ni desdeñó la aflicción del afligido",
          "ni de él escondió el rostro.",
          "Más bien, le oyó cuando clamó a él."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Tuya es mi alabanza en la gran congregación.",
          "Mis votos pagaré delante de los que le temen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Los pobres comerán y serán saciados.",
          "Alabarán al SEÑOR los que le buscan.",
          "¡Que viva su corazón para siempre!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Ellos se acordarán y volverán al SEÑOR",
          "de todos los confines de la tierra.",
          "Delante de ti se postrarán",
          "todas las familias de las naciones."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Porque del SEÑOR es el reino,",
          "y él se enseñoreará de las naciones."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Ciertamente ante él se postrarán todos los ricos de la tierra.",
          "Se doblegarán ante él todos los que descienden al polvo,",
          "los que no pueden conservar la vida a su propia alma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "La posteridad le servirá;",
          "esto le será referido al SEÑOR por generaciones."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Vendrán y anunciarán su justicia",
          "a un pueblo que ha de nacer:",
          "“¡Él hizo esto!”."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
