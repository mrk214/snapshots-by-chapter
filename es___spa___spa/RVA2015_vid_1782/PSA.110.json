    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El sacerdocio del Mesías"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El SEÑOR dijo a mi señor:",
          "“Siéntate a mi diestra",
          "hasta que ponga a tus enemigos",
          "como estrado de tus pies”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El SEÑOR enviará desde Sion el cetro de tu poder;",
          "domina en medio de tus enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "En el día de tu poder",
          "tu pueblo se te ofrecerá voluntariamente",
          "en la hermosura de la santidad.",
          "Desde el nacimiento de la aurora",
          "tú tienes el rocío de la juventud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El SEÑOR juró y no",
          "se retractará:",
          "“Tú eres sacerdote para siempre,",
          "según el orden de Melquisedec”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El Señor está a tu mano derecha;",
          "aplastará a los reyes en el día de su ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Juzgará entre las naciones;",
          "las llenará de cadáveres.",
          "Aplastará a los jefes sobre la extensa tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Beberá del arroyo en el camino,",
          "por lo cual levantará su cabeza."
        ],
        "rlw_lines": []
      }
    ]
  },
