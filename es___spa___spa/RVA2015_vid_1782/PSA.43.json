    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Anhelo por la casa de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Júzgame, oh Dios, y defiende mi causa.",
          "Líbrame de una nación impía,",
          "del hombre de engaño e iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Siendo tú el Dios de mi fortaleza,",
          "¿por qué me has desechado?",
          "¿Por qué he de andar enlutado por",
          "la opresión del enemigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Envía tu luz y tu verdad; estas me guiarán.",
          "Ellas me conducirán a tu monte santo y a tus moradas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Llegaré hasta el altar de Dios;",
          "a Dios, mi alegría y mi gozo.",
          "Te alabaré con arpa, oh Dios, Dios mío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Por qué te abates, oh alma mía,",
          "y por qué te turbas dentro de mí?",
          "Espera a Dios, porque aún le he de alabar.",
          "¡Él es la salvación de mi ser, y mi Dios!"
        ],
        "rlw_lines": []
      }
    ]
  },
