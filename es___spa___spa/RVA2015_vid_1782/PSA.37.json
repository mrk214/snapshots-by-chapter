    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dos conductas y dos destinos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No te impacientes a causa de los malhechores",
          "ni tengas envidia de los que hacen iniquidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque, como la hierba, pronto se secan,",
          "y se marchitan como el pasto verde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Confía en el SEÑOR y haz el bien.",
          "Habita en la tierra",
          "y apaciéntate de la fidelidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Deléitate en el SEÑOR",
          "y él te concederá los anhelos de tu corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Encomienda al SEÑOR tu camino;",
          "confía en él, y él hará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Él exhibirá tu justicia como la luz,",
          "y tu derecho como el mediodía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Calla delante del SEÑOR",
          "y espera en él.",
          "No te alteres con motivo de los que prosperan en su camino,",
          "por el hombre que hace maldades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Deja la ira y abandona el enojo;",
          "de ninguna manera te apasiones por hacer lo malo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque los malhechores serán destruidos,",
          "pero los que esperan en el SEÑOR heredarán la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dentro de poco no quedará el impío.",
          "Contemplarás su lugar, y no aparecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pero los mansos heredarán la tierra",
          "y se deleitarán por la abundancia de paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El impío maquina contra el justo",
          "y cruje sus dientes contra él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "El Señor se reirá de él",
          "porque ve que viene su día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los impíos desenvainan la espada y tensan el arco",
          "para derribar al pobre y al necesitado,",
          "para matar a los de recto proceder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero la espada de ellos entrará en su propio corazón,",
          "y su arco será roto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mejor es lo poco del justo",
          "que las riquezas de muchos impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Porque los brazos de los impíos serán quebrados;",
          "pero es el SEÑOR quien sostiene al justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El SEÑOR conoce los días de los íntegros,",
          "y la heredad de ellos será para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "No serán avergonzados en el tiempo malo;",
          "en los días de hambre serán saciados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Pero los impíos perecerán,",
          "y los enemigos del SEÑOR serán consumidos como el sebo de los carneros;",
          "se disiparán como el humo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "El impío toma prestado y no paga,",
          "pero el justo tiene compasión y da."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Los que él bendiga heredarán la tierra,",
          "y los que él maldiga serán eliminados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Por el SEÑOR son afirmados los pasos del hombre,",
          "y él se complacerá en su camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Si cae, no quedará postrado",
          "porque el SEÑOR sostiene su mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Yo he sido joven y he envejecido;",
          "pero no he visto a un justo desamparado",
          "ni a sus descendientes mendigando pan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "En todo tiempo tiene compasión y presta,",
          "y su descendencia es para bendición."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Apártate del mal y haz el bien,",
          "y vivirás para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Porque el SEÑOR ama la rectitud",
          "y no desampara a sus fieles.",
          "Para siempre serán guardados,",
          "pero la descendencia de los impíos será exterminada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Los justos heredarán la tierra",
          "y vivirán para siempre sobre ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "La boca del justo expresará sabiduría,",
          "y su lengua proferirá juicio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "La ley de su Dios está en su corazón;",
          "por eso sus pasos no vacilarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "El impío acecha al justo",
          "y procura matarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "El SEÑOR no lo dejará caer en su mano",
          "ni dejará que lo condenen cuando sea juzgado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Espera en el SEÑOR y guarda su camino.",
          "Él te exaltará para heredar la tierra;",
          "y cuando los impíos sean destruidos tú lo verás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Yo he visto al impío enaltecido,",
          "que se levantaba como un cedro del Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Pero pasó y ya no apareció.",
          "Lo busqué, y no fue hallado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Considera al íntegro y mira al justo;",
          "que la posteridad de ese hombre es paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Pero los transgresores serán todos juntos destruidos;",
          "la posteridad de los impíos será eliminada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "La salvación de los justos proviene del SEÑOR;",
          "él es su fortaleza en el tiempo de angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "El SEÑOR los ayudará y los librará;",
          "los librará de los impíos y los salvará",
          "porque en él se han refugiado."
        ],
        "rlw_lines": []
      }
    ]
  },
