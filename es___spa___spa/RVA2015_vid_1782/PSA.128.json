    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bendición del que teme a Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canto de ascenso gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bienaventurado todo aquel que teme al SEÑOR",
          "y anda en sus caminos:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cuando comas del trabajo de tus manos",
          "serás feliz y te irá bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tu mujer será como una vid",
          "que lleva fruto a los lados de tu casa;",
          "tus hijos serán como brotes de olivo",
          "alrededor de tu mesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Así será bendecido el hombre que teme al SEÑOR."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡El SEÑOR te bendiga desde Sion!",
          "Que veas el bien de Jerusalén",
          "todos los días de tu vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Que veas a los hijos de tus hijos.",
          "¡La paz sea sobre Israel!"
        ],
        "rlw_lines": []
      }
    ]
  },
