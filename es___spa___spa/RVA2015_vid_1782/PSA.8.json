    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La gloria divina y la dignidad humana"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Guititc. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh SEÑOR, Dios nuestro,",
          "¡cuán grande es tu nombre en toda la tierra!",
          "Has puesto tu gloria sobre los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "De la boca de los pequeños",
          "y de los que todavía maman",
          "has establecido la alabanza",
          "frente a tus adversarios",
          "para hacer callar al enemigo y al vengativo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cuando contemplo tus cielos,",
          "obra de tus dedos,",
          "la luna y las estrellas",
          "que tú has formado,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "digo: “¿Qué es el hombre,",
          "para que de él te acuerdes;",
          "y el hijo de hombre,",
          "para que lo visites?”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Lo has hecho un poco menor que los ángeles,",
          "y lo has coronado de gloria y de esplendor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Le has hecho señorear sobre las obras de tus manos;",
          "todo lo has puesto debajo de sus pies:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "ovejas y vacas, todo ello,",
          "y también los animales del campo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "las aves de los cielos y los peces del mar:",
          "todo cuanto pasa por los senderos del mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Oh SEÑOR, Dios nuestro,",
          "¡cuán grande es tu nombre en toda la tierra!"
        ],
        "rlw_lines": []
      }
    ]
  },
