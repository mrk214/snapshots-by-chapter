    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para el director del coro: salmo de David, acerca de cuando los zifeos fueron a decirle a Saúl: «Sabemos dónde se esconde David». Acompáñese con instrumentos de cuerda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Ven con tu gran poder, oh Dios, y rescátame!",
          "Defiéndeme con tu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Escucha mi oración, oh Dios;",
          "presta atención a mi ruego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pues me atacan desconocidos;",
          "gente violenta trata de matarme.",
          "No les importa Dios en lo más mínimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Interludio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero Dios es mi ayudador;",
          "¡el Señor me mantiene con vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que los planes malvados de mis enemigos se tornen en su contra;",
          "haz lo que prometiste y acaba con ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sacrificaré una ofrenda voluntaria a ti;",
          "alabaré tu nombre,",
          "porque es bueno, oh Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pues me libraste de mis dificultades",
          "y me ayudaste a triunfar sobre mis enemigos."
        ],
        "rlw_lines": []
      }
    ]
