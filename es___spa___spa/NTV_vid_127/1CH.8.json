    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Benjamín"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El primer hijo de Benjamín fue Bela; el segundo, Asbel; el tercero, Ahara;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "el cuarto, Noha y el quinto, Rafa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Los hijos de Bela fueron Adar, Gera, Abiud,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Abisúa, Naamán, Ahoa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Gera, Sefufán y Huram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los hijos de Aod, jefes de los clanes que vivían en Geba, fueron desterrados a Manahat."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Los hijos de Aod fueron Naamán, Ahías y Gera. Gera, quien los llevó al destierro, fue el padre de Uza y Ahiud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Después que Saharaim se divorció de sus esposas Husim y Baara, tuvo hijos en la tierra de Moab."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Su esposa Hodes dio a luz a Jobab, Sibia, Mesa, Malcam,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Jeúz, Saquías y Mirma. Todos estos hijos llegaron a ser jefes de clanes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Husim, la esposa de Saharaim, ya había dado a luz a Abitob y a Elpaal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Los hijos de Elpaal fueron Heber, Misam, Semed (quien construyó las ciudades de Ono y Lod y sus aldeas cercanas),"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Bería y Sema. Ellos fueron los jefes de los clanes que vivían en Ajalón, y expulsaron a los habitantes de Gat."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ahío, Sasac, Jeremot,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Zebadías, Arad, Ader,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Micael, Ispa y Joha fueron los hijos de Bería."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Zebadías, Mesulam, Hizqui, Heber,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ismerai, Jezlías y Jobab fueron los hijos de Elpaal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Jaquim, Zicri, Zabdi,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Elienai, Ziletai, Eliel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Adaías, Beraías y Simrat fueron los hijos de Simei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ispán, Heber, Eliel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Abdón, Zicri, Hanán,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Hananías, Elam, Anatotías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Ifdaías y Peniel fueron los hijos de Sasac."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Samserai, Seharías, Atalías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Jaresías, Elías y Zicri fueron los hijos de Jeroham."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Estos fueron los jefes de los clanes patriarcales, según aparecían en sus registros genealógicos; y todos ellos vivieron en Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La familia de Saúl"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Jeiel (el padre de Gabaón) vivió en la ciudad de Gabaón. El nombre de su esposa fue Maaca,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "y su hijo mayor fue Abdón. Los otros hijos de Jeiel fueron Zur, Cis, Baal, Ner, Nadab,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Gedor, Ahío, Zacarías"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "y Miclot, quien fue el padre de Simeam. Todas estas familias vivieron unas cerca de otras en Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Ner fue el padre de Cis.",
          "Cis fue el padre de Saúl.",
          "Saúl fue el padre de Jonatán, Malquisúa, Abinadab y Es-baal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Jonatán fue el padre de Merib-baal.",
          "Merib-baal fue el padre de Micaía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Micaía fue el padre de Pitón, Melec, Tarea y Acaz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Acaz fue el padre de Jada.",
          "Jada fue el padre de Alemet, Azmavet y Zimri.",
          "Zimri fue el padre de Mosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Mosa fue el padre de Bina.",
          "Bina fue el padre de Refaías.",
          "Refaías fue el padre de Elasa.",
          "Elasa fue el padre de Azel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Azel tuvo seis hijos: Azricam, Bocru, Ismael, Searías, Obadías y Hanán. Estos fueron los hijos de Azel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "El hermano de Azel, Esec, tuvo tres hijos: el primero fue Ulam; el segundo, Jehús y el tercero, Elifelet."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Todos los hijos de Ulam fueron guerreros poderosos y expertos arqueros. Tuvieron muchos hijos y nietos: ciento cincuenta en total.",
          "Todos ellos fueron descendientes de Benjamín."
        ],
        "rlw_lines": []
      }
    ]
  },
