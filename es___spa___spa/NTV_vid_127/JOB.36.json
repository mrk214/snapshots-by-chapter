    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eliú siguió hablando:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Déjame seguir, y te mostraré la verdad,",
          "¡porque no he terminado de defender a Dios!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Presentaré argumentos profundos",
          "a favor de la justicia de mi Creador."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Estoy diciendo solamente la verdad,",
          "porque soy un hombre de gran conocimiento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Dios es poderoso, ¡pero no desprecia a nadie!",
          "Él es poderoso tanto en fuerza como en entendimiento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No deja con vida a los malvados",
          "pero hace justicia a los afligidos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nunca quita los ojos de los inocentes,",
          "sino que los pone en tronos en compañía de reyes",
          "y los exalta para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Si están encadenados,",
          "y atrapados en una red de dificultades,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "él les muestra la causa;",
          "les hace ver sus pecados de soberbia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Él capta su atención",
          "y ordena que se aparten de la maldad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "»Si escuchan y obedecen a Dios,",
          "serán bendecidos con prosperidad por el resto de su vida.",
          "Todos sus años serán agradables."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Pero si se niegan a escucharlo,",
          "cruzarán el río de la muerte;",
          "morirán por falta de entendimiento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Los incrédulos están llenos de resentimiento.",
          "Aun cuando Dios los castiga,",
          "se niegan a pedirle auxilio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Mueren en plena juventud,",
          "después de haber malgastado la vida en inmoralidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero por medio del sufrimiento, él rescata a los que sufren,",
          "pues capta su atención mediante la adversidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "»Job, Dios está alejándote del peligro,",
          "y te lleva a un lugar libre de angustia.",
          "Está poniendo en tu mesa la mejor comida,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "pero te obsesiona saber si los incrédulos serán juzgados.",
          "No te preocupes, el juicio y la justicia prevalecerán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ten cuidado, o la riqueza podrá seducirte;",
          "no dejes que el soborno te haga pecar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¿Podrá toda tu riqueza",
          "o podrán todos tus grandes esfuerzos",
          "protegerte de la angustia?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No desees el amparo de la noche",
          "porque allí es cuando la gente será destruida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Mantente en guardia! Apártate de lo malo,",
          "porque Dios envió este sufrimiento",
          "para protegerte de una vida de maldad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Eliú le recuerda a Job el poder de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "»Mira, Dios es todopoderoso.",
          "¿Quién es un maestro como él?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Nadie puede indicarle lo que tiene que hacer",
          "ni decirle: “Has hecho mal”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "En cambio, glorifica tú sus obras poderosas,",
          "entonando canciones de alabanza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Todo el mundo ha visto estas cosas,",
          "aunque solo desde lejos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "»Mira, Dios es más grande de lo que podemos comprender;",
          "sus años no se pueden contar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Él hace subir el vapor de agua",
          "y luego lo destila en lluvia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "La lluvia se derrama desde las nubes,",
          "y todos se benefician."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¿Quién puede comprender el despliegue de las nubes",
          "y el trueno que retumba desde los cielos?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Mira cómo Dios extiende el relámpago a su alrededor",
          "e ilumina las profundidades del mar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Por medio de esos actos poderosos él nutre a la gente,",
          "dándole comida en abundancia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Él llena sus manos de rayos",
          "y lanza cada uno a su objetivo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "El trueno declara su presencia;",
          "la tormenta anuncia su enojo indignado."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
