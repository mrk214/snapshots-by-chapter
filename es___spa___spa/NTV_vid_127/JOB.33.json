    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Eliú presenta sus argumentos contra Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»Job, escucha mis palabras;",
          "presta atención a lo que tengo que decir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ahora que he comenzado a hablar,",
          "déjame continuar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Hablo con toda sinceridad;",
          "digo la verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El Espíritu de Dios me ha creado,",
          "y el aliento del Todopoderoso me da vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Respóndeme, si puedes;",
          "presenta tu argumento y define tu posición."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mira, tú y yo, ambos, pertenecemos a Dios;",
          "yo también fui formado del barro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Así que no tienes que tenerme miedo;",
          "no seré duro contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»Tú has hablado en mi presencia",
          "y he escuchado tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dijiste: “Yo soy puro; no tengo pecado;",
          "soy inocente; no tengo culpa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios busca pleito conmigo",
          "y me considera su enemigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Él puso mis pies en el cepo",
          "y vigila todos mis movimientos”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Pero estás equivocado, y te mostraré el porqué,",
          "pues Dios es más grande que todo ser humano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Así que, ¿por qué presentas cargos contra él?",
          "¿Por qué dices que no responde a las quejas de la gente?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pues Dios habla una y otra vez,",
          "aunque la gente no lo reconozca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Habla en sueños, en visiones nocturnas,",
          "cuando el sueño profundo cae sobre las personas",
          "mientras están acostadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Susurra a sus oídos",
          "y las aterroriza con advertencias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Él hace que se aparten de sus malas acciones;",
          "no las deja caer en el orgullo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Él las protege de la tumba,",
          "de cruzar el río de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "»Otras veces Dios emplea el dolor para disciplinar a la gente en su lecho de enfermo,",
          "con dolores incesantes en sus huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Ellos pierden el apetito;",
          "no desean ni la comida más deliciosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Su carne se consume",
          "y son puro hueso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Están a las puertas de la muerte;",
          "los ángeles de la muerte los esperan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "»Pero si aparece un ángel del cielo",
          "—un mensajero especial para interceder por una persona",
          "y para declarar que es recta—"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "él le tendrá compasión y dirá:",
          "“Sálvalo de la tumba,",
          "porque he encontrado un rescate por su vida”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Entonces su cuerpo se volverá tan sano como el de un niño,",
          "fuerte y juvenil otra vez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Cuando él ore a Dios,",
          "será aceptado",
          "y Dios lo recibirá con alegría",
          "y lo restaurará a una relación correcta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Declarará a sus amigos:",
          "“Pequé y torcí la verdad,",
          "pero no valió la pena."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Dios me rescató de la tumba",
          "y ahora mi vida está llena de luz”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "»Así es, Dios actúa de esa forma",
          "una y otra vez por las personas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Él las rescata de la tumba",
          "para que disfruten de la luz de la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Toma nota, Job; escúchame,",
          "porque tengo más para decir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Sin embargo, si tienes algo que decir, adelante,",
          "habla, porque deseo verte justificado;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "pero si no, entonces escúchame.",
          "¡Guarda silencio y te enseñaré sabiduría!»."
        ],
        "rlw_lines": []
      }
    ]
  },
