    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tercera respuesta de Bildad a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces Bildad el suhita respondió:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Dios es poderoso y temible;",
          "él impone la paz en los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Quién puede contar su ejército celestial?",
          "¿No brilla su luz en toda la tierra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Cómo puede un mortal ser inocente ante Dios?",
          "¿Puede alguien nacido de mujer ser puro?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios es más glorioso que la luna;",
          "brilla con más intensidad que las estrellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Comparadas con él, las personas son gusanos;",
          "nosotros los mortales somos simples lombrices»."
        ],
        "rlw_lines": []
      }
    ]
