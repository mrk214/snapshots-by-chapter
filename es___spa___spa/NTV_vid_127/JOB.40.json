    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces el Señor le dijo a Job:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¿Todavía quieres discutir con el Todopoderoso?",
          "Tú criticas a Dios, pero ¿tienes las respuestas?»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Job responde al Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Entonces Job respondió al Señor:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«No soy nada, ¿cómo podría yo encontrar las respuestas?",
          "Me taparé la boca con la mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ya hablé demasiado;",
          "no tengo nada más que decir»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El Señor desafía otra vez a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Luego el Señor respondió a Job desde el torbellino:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "«Prepárate, muestra tu hombría",
          "porque tengo algunas preguntas para ti",
          "y tendrás que contestarlas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»¿Pondrás en duda mi justicia",
          "y me condenarás solamente para probar que tienes razón?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Acaso eres tan fuerte como Dios?",
          "¿Puede tronar tu voz como la suya?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Bien, vístete de tu gloria y esplendor,",
          "de tu honor y majestad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Da rienda suelta a tu enojo;",
          "deja que se derrame contra los orgullosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Humíllalos con una mirada;",
          "pisa a los malvados allí donde están."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Entiérralos en el polvo;",
          "enciérralos en el mundo de los muertos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Entonces hasta yo te elogiaría,",
          "porque tu propia fuerza te podría salvar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "»Echa un vistazo al Behemot,",
          "a quien hice, al igual que a ti.",
          "Come hierba como un buey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mira qué fuertes son sus lomos",
          "y los músculos de su vientre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Su rabo es tan fuerte como un cedro;",
          "los tendones de sus muslos se entrelazan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Sus huesos son tubos de bronce;",
          "sus extremidades son barras de hierro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Es un excelente ejemplo de la obra de Dios,",
          "y solo su Creador puede amenazarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Las montañas le ofrecen su mejor alimento,",
          "donde juegan los animales salvajes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Se tiende bajo los lotos",
          "donde los juncos del pantano lo esconden."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Las plantas de loto le dan sombra",
          "entre los sauces junto al arroyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El río tempestuoso no le molesta,",
          "ni le preocupa cuando el creciente Jordán se arremolina a su alrededor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Nadie puede sorprenderlo con la guardia baja",
          "ni ponerle un aro en la nariz para llevárselo."
        ],
        "rlw_lines": []
      }
    ]
  },
