    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alef"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Felices son los íntegros,",
          "los que siguen las enseñanzas del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Felices son los que obedecen sus leyes",
          "y lo buscan con todo el corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No negocian con el mal",
          "y andan solo en los caminos del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Nos has ordenado",
          "que cumplamos cuidadosamente tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Oh, cuánto deseo que mis acciones",
          "sean un vivo reflejo de tus decretos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Entonces no tendré vergüenza",
          "cuando compare mi vida con tus mandatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A medida que aprendo tus justas ordenanzas,",
          "te daré las gracias viviendo como debo hacerlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Obedeceré tus decretos;",
          "¡por favor, no te des por vencido conmigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Cómo puede un joven mantenerse puro?",
          "Obedeciendo tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Me esforcé tanto por encontrarte;",
          "no permitas que me aleje de tus mandatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "He guardado tu palabra en mi corazón,",
          "para no pecar contra ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Te alabo, oh Señor;",
          "enséñame tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Recité en voz alta",
          "todas las ordenanzas que nos has dado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Me alegré en tus leyes",
          "tanto como en las riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Estudiaré tus mandamientos",
          "y reflexionaré sobre tus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Me deleitaré en tus decretos",
          "y no olvidaré tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Guímel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sé bueno con este siervo tuyo,",
          "para que viva y obedezca tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Abre mis ojos, para que vea",
          "las verdades maravillosas que hay en tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "No soy más que un extranjero en la tierra.",
          "¡No escondas de mí tus mandatos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Siempre me conmueve",
          "el deseo de conocer tus ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Tú reprendes al arrogante;",
          "los que se alejan de tus mandatos son malditos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "No permitas que se burlen de mí y me insulten,",
          "pues he obedecido tus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Hasta los príncipes se sientan y hablan contra mí,",
          "pero yo meditaré en tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Tus leyes me agradan;",
          "me dan sabios consejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dálet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Estoy tirado en el polvo;",
          "revíveme con tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Te conté mis planes y me respondiste.",
          "Ahora, enséñame tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Ayúdame a comprender el significado de tus mandamientos,",
          "y meditaré en tus maravillosas obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Lloro con tristeza;",
          "aliéntame con tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Líbrame de mentirme a mí mismo;",
          "dame el privilegio de conocer tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "He optado por ser fiel;",
          "estoy decidido a vivir de acuerdo con tus ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Me aferro a tus leyes.",
          "Señor, ¡no dejes que pase vergüenza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Perseguiré tus mandatos,",
          "porque tú aumentas mi comprensión."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "He"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Enséñame tus decretos, oh Señor;",
          "los cumpliré hasta el fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Dame entendimiento y obedeceré tus enseñanzas;",
          "las pondré en práctica con todo mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Hazme andar por el camino de tus mandatos,",
          "porque allí es donde encuentro mi felicidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Dame entusiasmo por tus leyes",
          "en lugar de amor por el dinero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Aparta mis ojos de cosas inútiles",
          "y dame vida mediante tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Confirma a tu siervo tu promesa,",
          "la promesa que hiciste a los que te temen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Ayúdame a abandonar mis caminos vergonzosos,",
          "porque tus ordenanzas son buenas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "¡Anhelo obedecer tus mandamientos!",
          "Renueva mi vida con tu bondad."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Vav"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Señor, concédeme tu amor inagotable,",
          "la salvación que me prometiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Entonces podré responder a los que se burlan de mí,",
          "porque confío en tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "No arrebates de mí tu palabra de verdad,",
          "pues tus ordenanzas son mi única esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Seguiré obedeciendo tus enseñanzas",
          "por siempre y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Caminaré en libertad,",
          "porque me he dedicado a tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "A los reyes les hablaré de tu ley,",
          "y no me avergonzaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "¡Cuánto me deleito en tus mandatos!",
          "¡Cómo los amo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Honro y amo tus mandatos;",
          "en tus decretos medito."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Zain"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Recuerda la promesa que me hiciste;",
          "es mi única esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Tu promesa renueva mis fuerzas;",
          "me consuela en todas mis dificultades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Los orgullosos me tratan con un desprecio total,",
          "pero yo no me aparto de tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Medito en tus antiguas ordenanzas;",
          "oh Señor, ellas me consuelan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Me pongo furioso con los perversos,",
          "porque rechazan tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Tus decretos han sido el tema de mis canciones",
          "en todos los lugares donde he vivido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "De noche reflexiono sobre quién eres, Señor;",
          "por lo tanto, obedezco tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Así paso mis días:",
          "obedeciendo tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "¡Señor, eres mío!",
          "¡Prometo obedecer tus palabras!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Deseo tus bendiciones con todo el corazón;",
          "ten misericordia, como lo prometiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Consideré el rumbo de mi vida",
          "y decidí volver a tus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Me apresuraré sin demora",
          "a obedecer tus mandatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Gente malvada trata de arrastrarme al pecado,",
          "pero estoy firmemente anclado a tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "Me levanto a medianoche para agradecerte",
          "por tus justas ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Soy amigo de todo el que te teme,",
          "de todo el que obedece tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Oh Señor, tu amor inagotable llena la tierra;",
          "enséñame tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Señor, has hecho muchas cosas buenas a mi favor",
          "tal como lo prometiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Creo en tus mandatos;",
          "ahora enséñame el buen juicio y dame conocimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Yo solía desviarme, hasta que me disciplinaste;",
          "pero ahora sigo de cerca tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Tú eres bueno y haces únicamente el bien;",
          "enséñame tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "Los arrogantes me difaman con mentiras,",
          "pero la verdad es que obedezco tus mandamientos con todo el corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "El corazón de ellos es torpe y necio;",
          "yo, en cambio, me deleito en tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "El sufrimiento me hizo bien,",
          "porque me enseñó a prestar atención a tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "Tus enseñanzas son más valiosas para mí",
          "que millones en oro y plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Yod"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "Tú me hiciste; me creaste.",
          "Ahora dame la sensatez de seguir tus mandatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "Que todos los que te temen encuentren en mí un motivo de alegría,",
          "porque he puesto mi esperanza en tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "Señor, sé que tus ordenanzas son justas;",
          "me disciplinaste porque lo necesitaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "Ahora deja que tu amor inagotable me consuele,",
          "tal como le prometiste a este siervo tuyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "Rodéame con tus tiernas misericordias para que viva,",
          "porque tus enseñanzas son mi deleite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "Trae deshonra sobre los arrogantes que mintieron sobre mí;",
          "mientras tanto, me concentraré en tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Permite que esté unido a todos los que te temen,",
          "los que conocen tus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "Que sea intachable en guardar tus decretos;",
          "entonces nunca seré avergonzado."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Caf"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "Estoy agotado de tanto esperar a que me rescates,",
          "pero he puesto mi esperanza en tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          82
        ],
        "lines": [
          "Mis ojos se esfuerzan por ver cumplidas tus promesas;",
          "¿cuándo me consolarás?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          83
        ],
        "lines": [
          "Estoy arrugado como un odre ahumado,",
          "pero no me olvidé de obedecer tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          84
        ],
        "lines": [
          "¿Hasta cuándo tendré que esperar?",
          "¿Cuándo castigarás a los que me persiguen?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          85
        ],
        "lines": [
          "Estos arrogantes que odian tus enseñanzas",
          "cavaron hoyos profundos para atraparme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          86
        ],
        "lines": [
          "Todos tus mandatos son confiables.",
          "Protégeme de aquellos que me persiguen sin causa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          87
        ],
        "lines": [
          "Casi acaban conmigo,",
          "pero me negué a abandonar tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          88
        ],
        "lines": [
          "En tu amor inagotable, perdona mi vida;",
          "entonces podré continuar obedeciendo tus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lámed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          89
        ],
        "lines": [
          "Tu eterna palabra, oh Señor,",
          "se mantiene firme en el cielo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          90
        ],
        "lines": [
          "Tu fidelidad se extiende a cada generación,",
          "y perdura igual que la tierra que creaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          91
        ],
        "lines": [
          "Tus ordenanzas siguen siendo verdad hasta el día de hoy,",
          "porque todo está al servicio de tus planes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          92
        ],
        "lines": [
          "Si tus enseñanzas no me hubieran sostenido con alegría,",
          "ya habría muerto en mi sufrimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          93
        ],
        "lines": [
          "Jamás olvidaré tus mandamientos,",
          "pues por medio de ellos me diste vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          94
        ],
        "lines": [
          "Soy tuyo, ¡rescátame!,",
          "porque me he esforzado mucho en obedecer tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          95
        ],
        "lines": [
          "Aunque los malvados se escondan por el camino para matarme,",
          "con calma, mantendré mi mente puesta en tus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          96
        ],
        "lines": [
          "Aun la perfección tiene sus límites,",
          "pero tus mandatos no tienen límite."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Mem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          97
        ],
        "lines": [
          "¡Oh, cuánto amo tus enseñanzas!",
          "Pienso en ellas todo el día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          98
        ],
        "lines": [
          "Tus mandatos me hacen más sabio que mis enemigos,",
          "pues me guían constantemente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          99
        ],
        "lines": [
          "Así es, tengo mejor percepción que mis maestros,",
          "porque siempre pienso en tus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          100
        ],
        "lines": [
          "Hasta soy más sabio que los ancianos,",
          "porque he obedecido tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          101
        ],
        "lines": [
          "Me negué a andar por cualquier mal camino,",
          "a fin de permanecer obediente a tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          102
        ],
        "lines": [
          "No me he apartado de tus ordenanzas,",
          "porque me has enseñado bien."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          103
        ],
        "lines": [
          "¡Qué dulces son a mi paladar tus palabras!",
          "Son más dulces que la miel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          104
        ],
        "lines": [
          "Tus mandamientos me dan entendimiento;",
          "¡con razón detesto cada camino falso de la vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Nun"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          105
        ],
        "lines": [
          "Tu palabra es una lámpara que guía mis pies",
          "y una luz para mi camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          106
        ],
        "lines": [
          "Lo prometí una vez y volveré a prometerlo:",
          "obedeceré tus justas ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          107
        ],
        "lines": [
          "He sufrido mucho, oh Señor;",
          "restaura mi vida, como lo prometiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          108
        ],
        "lines": [
          "Señor, acepta mi ofrenda de alabanza",
          "y enséñame tus ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          109
        ],
        "lines": [
          "Mi vida pende de un hilo constantemente,",
          "pero no dejaré de obedecer tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          110
        ],
        "lines": [
          "Los malvados me han tendido sus trampas,",
          "pero no me apartaré de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          111
        ],
        "lines": [
          "Tus leyes son mi tesoro;",
          "son el deleite de mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          112
        ],
        "lines": [
          "Estoy decidido a obedecer tus decretos",
          "hasta el final."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sámec"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          113
        ],
        "lines": [
          "Detesto a los que tienen divididas sus lealtades,",
          "pero amo tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          114
        ],
        "lines": [
          "Tú eres mi refugio y mi escudo;",
          "tu palabra es la fuente de mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          115
        ],
        "lines": [
          "Lárguense de mi vida, ustedes los de mente malvada,",
          "porque tengo la intención de obedecer los mandatos de mi Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          116
        ],
        "lines": [
          "¡Señor, sostenme como prometiste para que viva!",
          "No permitas que se aplaste mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          117
        ],
        "lines": [
          "Sostenme y seré rescatado;",
          "entonces meditaré continuamente en tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          118
        ],
        "lines": [
          "Pero has rechazado a todos los que se apartan de tus decretos,",
          "quienes no hacen más que engañarse a sí mismos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          119
        ],
        "lines": [
          "Desechas a los perversos de la tierra como si fueran desperdicios;",
          "¡con razón me encanta obedecer tus leyes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          120
        ],
        "lines": [
          "Me estremezco por mi temor a ti;",
          "quedo en temor reverente ante tus ordenanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          121
        ],
        "lines": [
          "No me dejes a merced de mis enemigos,",
          "porque he hecho lo que es correcto y justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          122
        ],
        "lines": [
          "Te ruego que me des seguridad de una bendición.",
          "¡No permitas que los arrogantes me opriman!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          123
        ],
        "lines": [
          "Mis ojos se esfuerzan por ver tu rescate,",
          "por ver la verdad de tu promesa cumplida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          124
        ],
        "lines": [
          "Soy tu siervo; trátame con tu amor inagotable",
          "y enséñame tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          125
        ],
        "lines": [
          "Da discernimiento a este siervo tuyo;",
          "entonces comprenderé tus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          126
        ],
        "lines": [
          "Señor, es tiempo de que actúes,",
          "porque esta gente malvada ha desobedecido tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          127
        ],
        "lines": [
          "De verdad, amo tus mandatos",
          "más que el oro, incluso que el oro más fino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          128
        ],
        "lines": [
          "Cada uno de tus mandamientos es recto;",
          "por eso detesto todo camino falso."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          129
        ],
        "lines": [
          "Tus leyes son maravillosas.",
          "¡Con razón las obedezco!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          130
        ],
        "lines": [
          "La enseñanza de tu palabra da luz,",
          "de modo que hasta los simples pueden entender."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          131
        ],
        "lines": [
          "Abro la boca y jadeo",
          "anhelando tus mandatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          132
        ],
        "lines": [
          "Ven y muéstrame tu misericordia,",
          "como lo haces con todos los que aman tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          133
        ],
        "lines": [
          "Guía mis pasos conforme a tu palabra,",
          "para que no me domine el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          134
        ],
        "lines": [
          "Rescátame de la opresión de la gente malvada,",
          "entonces podré obedecer tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          135
        ],
        "lines": [
          "Mírame con amor;",
          "enséñame tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          136
        ],
        "lines": [
          "Torrentes de lágrimas brotan de mis ojos,",
          "porque la gente desobedece tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tsade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          137
        ],
        "lines": [
          "Oh Señor, tú eres recto,",
          "y tus ordenanzas son justas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          138
        ],
        "lines": [
          "Tus leyes son perfectas",
          "y absolutamente confiables."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          139
        ],
        "lines": [
          "La indignación me agobia,",
          "porque mis enemigos despreciaron tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          140
        ],
        "lines": [
          "Tus promesas fueron sometidas a una prueba rigurosa;",
          "por eso las amo tanto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          141
        ],
        "lines": [
          "Soy insignificante y despreciado,",
          "pero no olvido tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          142
        ],
        "lines": [
          "Tu justicia es eterna,",
          "y tus enseñanzas son totalmente ciertas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          143
        ],
        "lines": [
          "Cuando la presión y el estrés se me vienen encima,",
          "yo encuentro alegría en tus mandatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          144
        ],
        "lines": [
          "Tus leyes siempre tienen razón;",
          "ayúdame a entenderlas para poder vivir."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cof"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          145
        ],
        "lines": [
          "Oro con todo el corazón; ¡respóndeme, Señor!",
          "Obedeceré tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          146
        ],
        "lines": [
          "A ti clamo; rescátame",
          "para que pueda obedecer tus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          147
        ],
        "lines": [
          "Me levanto temprano, antes de que salga el sol;",
          "clamo en busca de ayuda y pongo mi esperanza en tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          148
        ],
        "lines": [
          "Me quedo despierto durante toda la noche,",
          "pensando en tu promesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          149
        ],
        "lines": [
          "Oh Señor, en tu fiel amor oye mi clamor;",
          "que el seguir tus ordenanzas me reanime."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          150
        ],
        "lines": [
          "Los que no respetan la ley vienen a atacarme;",
          "viven alejados de tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          151
        ],
        "lines": [
          "Pero tú estás cerca, oh Señor,",
          "y todos tus mandatos son ciertos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          152
        ],
        "lines": [
          "Desde los primeros días",
          "sé que tus leyes durarán para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resh"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          153
        ],
        "lines": [
          "Mira mi sufrimiento y rescátame,",
          "porque no me he olvidado de tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          154
        ],
        "lines": [
          "¡Defiende mi caso; ponte de mi lado!",
          "Protege mi vida como lo prometiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          155
        ],
        "lines": [
          "Los perversos están lejos de ser rescatados,",
          "porque no se interesan en tus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          156
        ],
        "lines": [
          "Señor, qué grande es tu misericordia;",
          "que el seguir tus ordenanzas me reanime."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          157
        ],
        "lines": [
          "Muchos me persiguen y me molestan,",
          "sin embargo, no me he desviado de tus leyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          158
        ],
        "lines": [
          "Ver a esos traidores me enferma el corazón,",
          "porque no les importa nada tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          159
        ],
        "lines": [
          "Mira cómo amo tus mandamientos, Señor.",
          "Por tu amor inagotable, devuélveme la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          160
        ],
        "lines": [
          "La esencia misma de tus palabras es verdad;",
          "tus justas ordenanzas permanecerán para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Shin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          161
        ],
        "lines": [
          "Gente poderosa me acosa sin razón,",
          "pero mi corazón tiembla únicamente ante tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          162
        ],
        "lines": [
          "Me alegro en tu palabra",
          "como alguien que descubre un gran tesoro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          163
        ],
        "lines": [
          "Odio y detesto toda falsedad,",
          "pero amo tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          164
        ],
        "lines": [
          "Te alabaré siete veces al día",
          "porque todas tus ordenanzas son justas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          165
        ],
        "lines": [
          "Los que aman tus enseñanzas tienen mucha paz",
          "y no tropiezan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          166
        ],
        "lines": [
          "Anhelo que me rescates, Señor,",
          "por eso, he obedecido tus mandatos."
