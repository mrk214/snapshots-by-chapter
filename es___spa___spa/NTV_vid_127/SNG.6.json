    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Las jóvenes de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿Adónde se ha ido tu amante,",
          "oh mujer de singular belleza?",
          "Dinos por cuál camino se fue",
          "para ayudarte a encontrarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La joven"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mi amante ha bajado a su jardín,",
          "a sus lechos de especias,",
          "para pasear por los jardines",
          "y juntar los lirios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Yo soy de mi amante, y mi amante es mío.",
          "Él apacienta entre los lirios."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El joven"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eres hermosa, amada mía,",
          "como la bella ciudad de Tirsa.",
          "Sí, eres tan hermosa como Jerusalén,",
          "tan majestuosa como un ejército con sus estandartes desplegados al viento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aparta de mí tus ojos,",
          "porque me dominan.",
          "Tu cabello cae en ondas,",
          "como un rebaño de cabras que serpentea por las laderas de Galaad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tus dientes son blancos como ovejas",
          "recién bañadas.",
          "Tu sonrisa es perfecta;",
          "cada diente hace juego con su par."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tus mejillas son como granadas de color rosado",
          "detrás de tu velo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Aun entre sesenta reinas",
          "y ochenta concubinas",
          "e incontables doncellas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "yo todavía elegiría a mi paloma, a mi mujer perfecta,",
          "la favorita de su madre,",
          "muy amada por quien la dio a luz.",
          "Las jóvenes la ven y la alaban;",
          "hasta las reinas y las concubinas del palacio le entonan alabanzas:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "«¿Quién es esa, que se levanta como la aurora,",
          "tan hermosa como la luna,",
          "tan resplandeciente como el sol,",
          "tan majestuosa como un ejército con sus estandartes desplegados al viento?»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La joven"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Bajé a la arboleda de nogales",
          "y salí al valle para ver los nuevos brotes primaverales,",
          "para ver si habían brotado las vides",
          "o si las granadas ya estaban florecidas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Antes de darme cuenta,",
          "mis fuertes deseos me habían llevado a la carroza de un hombre noble."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Las jóvenes de Jerusalén"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Vuelve, vuelve a nosotras, oh doncella de Sulam.",
          "Regresa, regresa, para que te veamos otra vez."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El joven"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Por qué miran así a esta jovencita de Sulam",
          "mientras se mueve con tanta gracia entre dos filas de bailarines?"
        ],
        "rlw_lines": []
      }
    ]
  },
