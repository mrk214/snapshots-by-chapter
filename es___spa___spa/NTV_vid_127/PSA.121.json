    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico para los peregrinos que suben a Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Levanto la vista hacia las montañas;",
          "¿viene de allí mi ayuda?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Mi ayuda viene del Señor,",
          "quien hizo el cielo y la tierra!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Él no permitirá que tropieces;",
          "el que te cuida no se dormirá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En efecto, el que cuida a Israel",
          "nunca duerme ni se adormece."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡El Señor mismo te cuida!",
          "El Señor está a tu lado como tu sombra protectora."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El sol no te hará daño durante el día,",
          "ni la luna durante la noche."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El Señor te libra de todo mal",
          "y cuida tu vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El Señor te protege al entrar y al salir,",
          "ahora y para siempre."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
