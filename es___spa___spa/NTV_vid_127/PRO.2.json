    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Los beneficios de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hijo mío, presta atención a lo que digo",
          "y atesora mis mandatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Afina tus oídos a la sabiduría",
          "y concéntrate en el entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Clama por inteligencia",
          "y pide entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Búscalos como si fueran plata,",
          "como si fueran tesoros escondidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Entonces comprenderás lo que significa temer al Señor",
          "y obtendrás conocimiento de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Pues el Señor concede sabiduría!",
          "De su boca provienen el saber y el entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Al que es honrado, él le concede el tesoro del sentido común.",
          "Él es un escudo para los que caminan con integridad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Él cuida las sendas de los justos",
          "y protege a los que le son fieles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Entonces comprenderás lo que es correcto, justo e imparcial",
          "y encontrarás el buen camino que debes seguir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pues la sabiduría entrará en tu corazón,",
          "y el conocimiento te llenará de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Las decisiones sabias te protegerán;",
          "el entendimiento te mantendrá a salvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "La sabiduría te salvará de la gente mala,",
          "de los que hablan con palabras retorcidas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Estos hombres se alejan del camino correcto",
          "para andar por sendas tenebrosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Se complacen en hacer lo malo",
          "y disfrutan los caminos retorcidos del mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Sus acciones son torcidas,",
          "y sus caminos son errados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "La sabiduría te librará de la mujer inmoral,",
          "de las palabras seductoras de la mujer promiscua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ella abandonó a su marido",
          "y no hace caso del pacto que hizo ante Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Entrar a su casa lleva a la muerte;",
          "es el camino a la tumba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El hombre que la visita está condenado;",
          "nunca llegará a los senderos de la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por lo tanto, sigue los pasos de los buenos",
          "y permanece en los caminos de los justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Pues solo los justos vivirán en la tierra",
          "y los íntegros permanecerán en ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Pero los perversos serán quitados de la tierra,",
          "y los traidores serán arrancados de raíz."
        ],
        "rlw_lines": []
      }
    ]
  },
