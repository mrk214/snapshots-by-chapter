    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David, acerca de cuando huía de su hijo Absalón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oh Señor, tengo tantos enemigos;",
          "son muchos los que están en mi contra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Son tantos los que dicen:",
          "«¡Dios no lo rescatará!»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Interludio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pero tú, oh Señor, eres un escudo que me rodea;",
          "eres mi gloria, el que sostiene mi cabeza en alto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Clamé al Señor,",
          "y él me respondió desde su monte santo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Interludio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me acosté y dormí,",
          "pero me desperté a salvo,",
          "porque el Señor me cuidaba."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No tengo miedo a los diez mil enemigos",
          "que me rodean por todas partes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Levántate, oh Señor!",
          "¡Rescátame, Dios mío!",
          "¡Abofetea a todos mis enemigos!",
          "¡Destroza los dientes de los malvados!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "La victoria proviene de ti, oh Señor;",
          "bendice a tu pueblo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Interludio"
        ],
