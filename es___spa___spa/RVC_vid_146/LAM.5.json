    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración del pueblo afligido"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, recuerda lo que nos ha sucedido;",
          "¡míranos, y toma en cuenta nuestro oprobio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nuestra heredad ha pasado a manos ajenas;",
          "nuestras casas son ahora de gente extraña."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Nos hemos quedado huérfanos, sin padre;",
          "nuestras madres se han quedado como viudas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pagamos por el agua que bebemos,",
          "y hasta la leña tenemos que comprarla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Estamos sujetos a la persecución;",
          "nos fatigamos, no tenemos reposo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Suplicantes extendimos la mano a los egipcios,",
          "y a los asirios les rogamos saciarnos de pan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nuestros padres pecaron, y murieron,",
          "¡pero a nosotros nos tocó llevar el castigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ahora los esclavos son nuestros señores,",
          "y no hay quien nos libre de sus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Desafiando a los guerreros del desierto,",
          "arriesgamos la vida para obtener nuestro pan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El hambre nos hace arder en fiebre;",
          "¡tenemos la piel requemada como un horno!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "En Sión violaron a nuestras mujeres;",
          "¡en las ciudades de Judá violaron a nuestras doncellas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A los príncipes los colgaron de las manos;",
          "¡no mostraron ningún respeto por los viejos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "A nuestros mejores hombres los obligaron a moler;",
          "¡a nuestros niños los agobiaron bajo el peso de la leña!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ya no se ven ancianos sentados a la puerta;",
          "los jóvenes dejaron de cantar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Para nuestro corazón terminó la alegría;",
          "nuestras danzas se volvieron cantos de dolor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Se nos cayó de la cabeza la corona.",
          "¡Pobres de nosotros! ¡Somos pecadores!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Por eso tenemos triste el corazón;",
          "por eso los ojos se nos han nublado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tan asolado está el monte Sión",
          "que por él merodean las zorras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pero tú, Señor, eres el rey eterno;",
          "¡tu trono permanecerá por toda la eternidad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Por qué te has olvidado de nosotros?",
          "¿Por qué nos has abandonado tanto tiempo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Restáuranos, Señor, y nos volveremos a ti!",
          "¡Haz de nuestra vida un nuevo comienzo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Lo cierto es que nos has desechado;",
          "¡muy grande ha sido tu enojo contra nosotros!"
        ],
        "rlw_lines": []
      }
    ]
  },
