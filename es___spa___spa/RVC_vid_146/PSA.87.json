    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El privilegio de vivir en Sión"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de los hijos de Coré. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El Señor se estableció en el monte santo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El amor del Señor por las puertas de Sión",
          "es mayor que su amor por todas las ciudades de Jacob."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "De ti, ciudad de Dios,",
          "se dicen cosas gloriosas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Entre los que me conocen,",
          "tengo presentes a Rajab y a Babilonia.",
          "Aquí están Filistea y Tiro, con Etiopía.",
          "Este nació allí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "De Sión se dirá:",
          "«Este y aquel nacieron en ella.»",
          "El Altísimo mismo la establecerá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Al inscribir a los pueblos, el Señor anotará:",
          "«Este nació allá.»"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Los que cantan y danzan en ella, dirán:",
          "«Todas mis fuentes están en ti.»"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
