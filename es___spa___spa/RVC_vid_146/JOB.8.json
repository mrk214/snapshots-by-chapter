    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primera reprensión de Bildad a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces Bildad el suhita, dijo:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¿Cuánto tiempo vas a hablar así,",
          "con palabras impetuosas como el viento?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dios no pervierte la justicia;",
          "el Todopoderoso no retuerce el derecho."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Si tus hijos pecaron contra él,",
          "murieron porque él les dio su merecido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero si tú buscas al Dios Todopoderoso,",
          "desde muy temprano imploras su compasión,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "él te brindará su protección y te restaurará tus bienes,",
          "siempre y cuando actúes con pureza y rectitud."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Las pocas riquezas que llegaste a poseer",
          "no podrán compararse con las que tendrás después."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»Consulta la experiencia de los que ya pasaron,",
          "y disponte a averiguar lo que sus padres descubrieron."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Nosotros nacimos ayer, y muy poco sabemos;",
          "nuestros días en este mundo pasan como una sombra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ellos te hablarán y te enseñarán;",
          "te hablarán con el corazón en la mano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Acaso crecen los juncos si no hay pantano?",
          "¿O crecen los papiros donde no hay agua?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sin embargo, aún verdes y sin haberlos cortado,",
          "se marchitan antes que cualquier otra hierba."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Así también son los que de Dios se olvidan;",
          "así termina la esperanza de los malvados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Toda su esperanza y su confianza",
          "es tan frágil como la tela de una araña."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Quien se apoye en sus hilos, no quedará en pie;",
          "en cuanto los agarre, se reventarán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Son como la hierba verde y tendida al sol,",
          "que esparce sus renuevos por todo el jardín;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "echan raíces en torno a una fuente,",
          "y se arraigan en lugares pedregosos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "pero si son arrancados de su sitio",
          "nadie sabrá si alguna vez estuvieron allí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Tal vez disfrute de su corta prosperidad,",
          "pero allí mismo brotarán otros renuevos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "»Dios no rechaza al de conducta intachable,",
          "ni tiende la mano al que vive en la maldad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Así que él volverá a hacerte reír,",
          "y en tus labios pondrá una radiante sonrisa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Tus enemigos serán avergonzados,",
          "y sus casas serán destruidas.»"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
