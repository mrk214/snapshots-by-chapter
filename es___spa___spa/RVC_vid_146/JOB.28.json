    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Elogio de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "«La plata se extrae de las minas,",
          "y el oro se refina en el crisol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Del polvo de la tierra se saca el hierro,",
          "y el cobre se aparta de la escoria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Con el fuego se ha puesto fin a las tinieblas,",
          "y el hombre examina con detalle",
          "cada piedra que hay en esa densa oscuridad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Abre minas en lugares no habitados,",
          "en sitios donde nadie ha plantado el pie,",
          "y entran los mineros, balanceándose con sogas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "De la tierra se obtiene el alimento,",
          "y abajo de ella todo se convierte en fuego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "En su seno se encuentran zafiros,",
          "y aun el polvo de la tierra es oro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Son lugares que las aves desconocen,",
          "y que jamás vieron los ojos de los buitres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Nunca pasaron por allí las fieras,",
          "ni tampoco el león feroz pisó ese lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Con el duro pedernal en la mano,",
          "el hombre cava la raíz de las montañas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Hace túneles en las rocas,",
          "y sus ojos descubren piedras preciosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Explora el lugar donde nacen los ríos,",
          "y saca a la luz muchas cosas escondidas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Pero ¿dónde se halla la sabiduría?",
          "¿En qué lugar está la inteligencia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Nadie sabe lo que vale,",
          "pues no se halla en este mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El mar profundo dice: “Aquí no está”,",
          "y el océano asegura: “Yo no la tengo”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "La sabiduría no se compra con oro,",
          "ni su precio puede pagarse con plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "No se compra con oro de Ofir,",
          "ni con el precioso ónice, ni con el zafiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ni los diamantes ni el oro se le comparan,",
          "ni se da a cambio de finas alhajas de oro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "No se le comparan el coral y las perlas;",
          "la sabiduría es más valiosa que las piedras preciosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ni el topacio de Etiopía, ni el oro más fino,",
          "son de tanto valor como ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "»¿De dónde viene la sabiduría?",
          "¿En qué lugar se encuentra la inteligencia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Se halla escondida de todo ser vivo;",
          "se halla escondida de las aves del cielo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Aunque la muerte y el sepulcro aseguran",
          "que a sus oídos ha llegado su fama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "»Solo Dios sabe llegar hasta ella;",
          "solo él sabe en dónde se halla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Con su mirada ve hasta los confines de la tierra,",
          "y ve también lo que pasa bajo el cielo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Cuando Dios determinó el peso del viento,",
          "y midió el agua de mares y ríos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "cuando estableció una ley para las lluvias,",
          "y señaló la ruta de los relámpagos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "vio a la sabiduría, que estaba allí,",
          "y la puso a prueba y reconoció su valor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Entonces dijo a la humanidad:",
          "“El temor del Señor es la sabiduría.",
          "Quien se aparta del mal es inteligente.”»"
        ],
        "rlw_lines": []
      }
    ]
  },
