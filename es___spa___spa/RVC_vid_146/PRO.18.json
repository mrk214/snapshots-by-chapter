    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El egoísta solo piensa en sí mismo,",
          "y se entromete en cualquier asunto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Al necio, la inteligencia no le causa placer;",
          "tan solo le interesa exhibir lo que piensa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Llega el impío, llega el desprecio;",
          "con la deshonra viene la afrenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Los dichos del hombre son aguas profundas,",
          "pero la sabiduría es una fuente inagotable."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "No está bien favorecer al impío",
          "y no hacerle justicia al hombre honrado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Las palabras del necio provocan contiendas;",
          "sus labios convocan a los golpes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El necio provoca su propio mal;",
          "con sus propios labios se tiende una trampa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los chismes empalagan,",
          "pero calan hasta lo más profundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El que es negligente en su trabajo",
          "es también íntimo amigo de gente nociva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El nombre del Señor es una fortaleza",
          "a la que el justo acude en busca de ayuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "El rico piensa que sus riquezas",
          "son una fortaleza de altas murallas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El orgullo humano es presagio del fracaso;",
          "la humildad es preludio de la gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Cuán presuntuoso y ridículo se muestra",
          "el que responde antes de oír!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El espíritu humano sostiene al enfermo,",
          "pero al espíritu angustiado, ¿quién lo sostiene?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "La mente inteligente adquiere sabiduría,",
          "y los oídos sabios van en pos de la ciencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los obsequios te allanan el camino",
          "y te llevan ante grandes potentados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "El primero en defenderse alega inocencia,",
          "hasta que llega su adversario y lo desmiente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Las suertes ponen fin a las querellas,",
          "y dictan sentencia entre los litigantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El hermano ofendido es más impenetrable",
          "que una ciudad amurallada;",
          "persisten más los pleitos entre hermanos",
          "que los cerrojos de una fortaleza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Hay quienes, con lo que dicen,",
          "logran satisfacer su hambre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "El que ama la lengua comerá de sus frutos;",
          "ella tiene poder sobre la vida y la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¿Hallaste esposa? ¡Has hallado el bien!",
          "¡Has alcanzado el favor del Señor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El pobre habla con ruegos;",
          "el rico responde con rudeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Hay amigos que no son amigos,",
          "y hay amigos que son más que hermanos."
        ],
        "rlw_lines": []
      }
    ]
  },
