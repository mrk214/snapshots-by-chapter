    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Clamor de venganza"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios de mi alabanza, ¡no te quedes callado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Gente malvada y mentirosa habla en contra mía,",
          "y con sus mentiras me calumnia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Con palabras llenas de odio me persiguen,",
          "y pelean contra mí sin tener motivo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Yo los trato con amor, y ellos me pagan con odio;",
          "¡pero yo sigo orando por ellos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Les hago un bien y me pagan con un mal;",
          "me tratan con odio, aunque yo los amo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Que lo juzgue un juez injusto!",
          "¡Que el maligno lo condene!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Que sea declarado culpable!",
          "¡Que su oración revele su maldad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Que sus años de vida se reduzcan,",
          "y que otro se quede con su oficio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Que se queden huérfanos sus hijos!",
          "¡Que se quede viuda su mujer!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Que sus hijos se queden sin techo,",
          "y que mendiguen el pan lejos de sus ruinas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Que sus acreedores les quiten todos sus bienes!",
          "¡Que gente extraña los despoje de sus posesiones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡Que nadie tenga de él misericordia!",
          "¡Que nadie compadezca a sus huérfanos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Que no quede rastro de sus descendientes!",
          "¡Que su nombre sea borrado de la generación siguiente!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Señor, ¡no olvides la maldad de su padre!",
          "¡Ten presente el pecado de su madre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Señor, ¡no pases por alto su maldad,",
          "y borra de la tierra su memoria!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque este se olvidó de la misericordia,",
          "y persiguió hasta darle muerte",
          "al miserable que sufre y tiene roto el corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ya que amó la maldición, ¡que sea maldito!",
          "Despreció la bendición, ¡que nunca sea bendecido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "La maldad lo envolvió como un manto;",
          "como agua, penetró en todo su ser;",
          "como aceite, le caló hasta los huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Pues que lo envuelva la maldad como un manto,",
          "y que lo oprima para siempre como un cinto!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Así les pague el Señor a los que me acusan,",
          "a los que me calumnian y buscan mi mal!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Pero tú, mi Señor y Dios,",
          "¡trátame bien por causa de tu nombre!",
          "Por tu bondad y misericordia, ¡sálvame!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Te necesito, pues estoy muy afligido;",
          "mi corazón tiene profundas heridas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Siento que me muero, como muere el día;",
          "soy sacudido como una langosta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Las rodillas se me doblan por causa del ayuno,",
          "estoy tan débil que mi cuerpo desfallece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Soy para la gente objeto de burla;",
          "los que me ven, mueven burlones la cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Señor y Dios mío, ¡ayúdame!;",
          "por tu gran misericordia, ¡sálvame!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Así sabrán que esto viene de tu mano,",
          "y que eres tú, Señor, quien me ha salvado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "No importa que me maldigan, ¡bendíceme tú!",
          "Podrán atacarme, pero quedarán avergonzados,",
          "mientras que este siervo tuyo se regocijará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Cubre de vergüenza a los que me critican;",
          "¡que la confusión los envuelva como un manto!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Yo te alabaré, Señor, con mucho gozo;",
          "¡te cantaré en medio de una gran multitud!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Porque defiendes al que nada tiene,",
          "y lo libras de quienes lo condenan a muerte."
        ],
        "rlw_lines": []
      }
    ]
  },
