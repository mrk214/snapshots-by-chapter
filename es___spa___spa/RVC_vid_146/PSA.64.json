    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria en que se pide protección contra enemigos ocultos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios mío, ¡escucha la voz de mi queja!",
          "¡Protege mi vida de mi temible enemigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Escóndeme de esa caterva de malhechores,",
          "que en secreto conspiran y hacen planes malvados!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Afilan su lengua, como si fuera una espada;",
          "lanzan acres invectivas, como si fueran saetas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "y a escondidas hieren al hombre íntegro.",
          "Lo atacan de repente y sin temor alguno;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "obstinados en cumplir sus inicuos designios,",
          "pretenden disimular sus trampas,",
          "creyendo que nadie los va a ver."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Elucubran iniquidades, investigan al detalle;",
          "y sus ideas son tan incomprensibles",
          "que no es posible penetrar en ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Pero Dios los herirá con sus saetas!",
          "¡Sus plagas les sobrevendrán de repente!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Su propia lengua les será un tropiezo,",
          "y serán la burla de todos los que los vean."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Entonces la humanidad entera sentirá temor,",
          "y todos proclamarán las obras de Dios",
          "y entenderán el porqué de sus acciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los justos se regocijarán en el Señor",
          "y pondrán en él su confianza.",
          "¡Todos los rectos de corazón lo alabarán!"
        ],
        "rlw_lines": []
      }
    ]
  },
