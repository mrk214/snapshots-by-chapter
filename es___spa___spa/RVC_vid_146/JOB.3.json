    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Queja de Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Después de eso, Job habló y maldijo el día de su nacimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Y dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "«Que perezca el día en que me concibieron,",
          "y la noche en que dijeron: “¡Ya nació un varón!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Que se oscurezca ese día,",
          "y que Dios en lo alto no lo tome en cuenta.",
          "Que ese día el sol deje de brillar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "y las tinieblas de muerte lo oscurezcan.",
          "Que lo envuelva un manto de oscuridad",
          "y lo deje como un día horrible y bochornoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Que sea esa noche todo oscuridad;",
          "que nadie la cuente entre los días del año;",
          "¡que no sea incluida en ninguno de los meses!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que sea contada como una noche estéril,",
          "en la que nadie emitió un solo grito de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Que maldigan esa noche los que conjuran al mar,",
          "los que saben despertar al furioso Leviatán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Que no brillen las estrellas en el alba,",
          "ni llegue nunca la esperada luz;",
          "¡que no se vea la luz de la mañana!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "»¿Por qué no fue cegado el vientre de mi madre?",
          "¿Por qué no se escondió de mis ojos la miseria?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Por qué no morí dentro de su vientre,",
          "o al momento mismo de nacer?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Por qué me recibió entre sus rodillas?",
          "¿Por qué me amamantó en su pecho?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Ahora estaría yo tranquilo y en reposo!",
          "¡Estaría disfrutando de un sueño sosegado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Descansaría entre reyes y ministros,",
          "cuyos monumentos hoy están en ruinas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡estaría entre poderosos gobernantes,",
          "que llenaban de oro y plata sus palacios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "»¿Por qué no me trataron como a un abortivo,",
          "y me enterraron para nunca ver la luz?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "En la tumba los malvados no perturban;",
          "allí descansan los cansados de vivir;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "allí reposan de sus penas los cautivos,",
          "pues no escuchan más la voz del capataz;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "allí los niños y los viejos son iguales,",
          "y el esclavo se libera de su amo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "»¿Por qué llega a ver la luz el que trabaja,",
          "y se deja vivir al de espíritu amargado?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Esperan la muerte, y esta no llega,",
          "aunque la anhelan más que al oro,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¡pero cuán grande es su alegría",
          "cuando al fin encuentran el sepulcro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "»¿Para qué vivir en un camino incierto,",
          "donde Dios te cierra el paso?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¡Mi pan lo ingiero entre suspiros,",
          "y entre lágrimas que corren como el agua!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Me ha sobrevenido un temor espantoso;",
          "lo que más temía, me ha sucedido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "No encuentro paz ni reposo;",
          "vivo intranquilo y en constante turbación.»"
        ],
        "rlw_lines": []
      }
    ]
  },
