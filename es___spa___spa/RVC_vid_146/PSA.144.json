    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración por la prosperidad del pueblo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Bendito seas, Señor, mi roca!",
          "Tú me entrenas para la batalla;",
          "fortaleces mis manos para el combate."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tú eres mi castillo de misericordia,",
          "mi fortaleza, mi libertador;",
          "eres mi escudo, y en ti me refugio;",
          "¡tú haces que los pueblos se sometan a mí!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Señor, ¿qué son los mortales",
          "para que te preocupes por ellos?",
          "¿Qué son los seres humanos",
          "para que los tomes en cuenta?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Los mortales son una ilusión pasajera;",
          "su vida pasa como una sombra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Señor, inclina los cielos y desciende;",
          "toca los montes y hazlos humear."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dispersa con tus relámpagos a mis enemigos,",
          "lanza contra ellos tus dardos de fuego, y confúndelos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "extiende tu mano desde las alturas,",
          "y rescátame del mar, porque me ahogo;",
          "líbrame del poder de esos extraños"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "cuya boca dice cosas sin sentido",
          "y cuyo poder es un poder falso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Señor, voy a dedicarte un canto nuevo;",
          "lo cantaré al son del arpa y del salterio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tú eres quien da la victoria a los reyes;",
          "tú libras de la espada a tu siervo David."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Rescátame! ¡Líbrame del poder de gente extraña,",
          "cuya boca dice cosas sin sentido",
          "y cuyo poder es un poder falso!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Que nuestros hijos, en su juventud,",
          "crezcan como plantas vigorosas.",
          "Que nuestras hijas sean hermosas",
          "como las columnas labradas de un palacio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Que nuestros graneros se llenen",
          "y rebosen con toda clase de grano.",
          "Que nuestros ganados en el campo",
          "se multipliquen por cientos y miles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Que nuestros bueyes resistan el trabajo.",
          "Que no nos tomen por asalto ni nos lleven cautivos,",
          "ni haya pánico en nuestras calles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Dichoso el pueblo que tiene todo esto!",
          "¡Dichoso el pueblo cuyo Dios es el Señor!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
