    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Motivo de los proverbios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Proverbios de Salomón, hijo de David, rey de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Para entender sabiduría y doctrina,",
          "y conocer razones prudentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Para recibir prudentes consejos,",
          "y justicia, juicio y equidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Para dar sagacidad a los incautos,",
          "e inteligencia y cordura a los jóvenes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que lo oiga el sabio, y aumente su saber,",
          "y que el entendido reciba consejo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "para entender proverbios y enigmas,",
          "y palabras sabias y profundas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El principio de la sabiduría es el temor al Señor;",
          "los necios desprecian la sabiduría y la enseñanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Amonestaciones de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Atiende, hijo mío, las correcciones de tu padre,",
          "y no menosprecies las enseñanzas de tu madre;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "adorno de gracia serán sobre tu cabeza,",
          "y collares alrededor de tu cuello."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Hijo mío, si los pecadores quisieran engañarte,",
          "no te dejes llevar por ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tal vez te digan: «¡Ven con nosotros!",
          "Estemos al acecho para derramar sangre.",
          "Acechemos sin motivo a los incautos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Seamos como el sepulcro, como el abismo,",
          "y traguémonos viva y entera a la gente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Hallaremos toda clase de riquezas",
          "y llenaremos con despojos nuestras casas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Comparte tu destino con nosotros,",
          "y compartiremos todos una misma bolsa.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero, hijo mío, no vayas por su camino;",
          "¡aleja tus pasos de sus veredas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Sus pies corren hacia el mal,",
          "¡se apresuran a derramar sangre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No tiene caso tender una trampa",
          "a la vista de todas las aves;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "pero ellos atentan contra su propia vida;",
          "¡ellos mismos se tienden la trampa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Así son las sendas de la gente ambiciosa:",
          "¡su propia ambición les quita la vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "La sabiduría clama en las calles,",
          "y deja oír su voz por las plazas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Clama en los principales puntos de encuentro;",
          "a la entrada de la ciudad expone sus razones:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "«Ustedes, muchachos inexpertos y burlones,",
          "¿hasta cuándo seguirán amando la simpleza?",
          "¿Hasta cuándo seguirán burlándose de todo?",
          "¿Hasta cuándo aborrecerán el conocimiento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¡Presten atención a mis reprensiones!",
          "Yo derramaré mi espíritu sobre ustedes,",
          "y les daré a conocer mis argumentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "»Pero yo los llamé, y nadie quiso oírme;",
          "les tendí la mano, y nadie me hizo caso;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "al contrario, desecharon todos mis consejos",
          "y no quisieron recibir mi reprensión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Por eso, yo me burlaré de ustedes",
          "cuando les sobrevenga la temida calamidad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "cuando la calamidad que tanto temen",
          "les sobrevenga como un torbellino;",
          "¡cuando les sobrevengan tribulaciones y angustias!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Entonces me llamarán, y no les responderé;",
          "me buscarán de mañana, y no me hallarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Puesto que aborrecen la sabiduría,",
          "y no optaron por temer al Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "ni quisieron seguir mis consejos,",
          "sino que menospreciaron todas mis reprensiones,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "comerán los frutos de sus andanzas",
          "y se hartarán con sus propios consejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Los incautos mueren por sus propios desvíos;",
          "a los necios los destruye su autosuficiencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Pero los que me oyen vivirán tranquilos,",
          "sin sobresaltos ni temor de ningún mal.»"
        ],
        "rlw_lines": []
      }
    ]
  },
