    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertencias contra la pereza y la mentira"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hijo mío, si sales fiador por tu amigo,",
          "y empeñas tu palabra en favor de un extraño,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "te has enredado con tus propias palabras;",
          "¡eres cautivo de tus propias promesas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Hijo mío, has caído en manos de tu prójimo.",
          "Para librarte, tienes que hacer lo siguiente:",
          "Ve a hablar con tu prójimo, y humíllate ante él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No te des un momento de reposo;",
          "no cierres los ojos ni te duermas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sé como gacela, y escápate del cazador;",
          "sé como un ave, y líbrate del que pone trampas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Perezoso, mira a las hormigas;",
          "fíjate en sus caminos, y ponte a pensar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ellas no tienen quien las mande,",
          "ni quien les dé órdenes ni las gobierne."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Preparan su comida en el verano,",
          "y en el tiempo de la siega recogen su comida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Perezoso, ¿cuánto más seguirás durmiendo?",
          "¿Cuándo vas a despertar de tu sueño?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Un poco de dormir, un poco de soñar,",
          "un poco de cruzarse de brazos para descansar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "y así vendrán tu necesidad y tu pobreza:",
          "como un vago, como un mercenario."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El que es malvado y canalla",
          "siempre anda diciendo cosas perversas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "guiña los ojos, mueve los pies,",
          "hace señas con los dedos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "en su corazón solo hay perversidad,",
          "y todo el tiempo anda pensando en el mal.",
          "¡Siempre anda sembrando discordias!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por eso, cuando menos lo espere,",
          "le sobrevendrá la ruina sin que pueda evitarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Hay seis, y hasta siete cosas",
          "que el Señor detesta con toda el alma:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los ojos altivos, la lengua mentirosa,",
          "las manos que derraman sangre inocente,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "la mente que maquina planes inicuos,",
          "los pies que se apresuran a hacer el mal,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "el testigo falso que propaga mentiras,",
          "y el que siembra discordia entre hermanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertencia contra el adulterio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Hijo mío, cumple el mandamiento de tu padre,",
          "y no te apartes de la enseñanza de tu madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Llévalos siempre dentro de tu corazón;",
          "pórtalos alrededor de tu cuello."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Serán tu guía cuando camines,",
          "te protegerán cuando duermas,",
          "y te hablarán cuando despiertes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El mandamiento es lámpara,",
          "la enseñanza es luz,",
          "y las reprensiones son el camino de la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Te librarán de la mujer malvada,",
          "de la lengua sutil de la mujer ajena."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "No codicies en tu corazón su hermosura,",
          "ni dejes que ella te atrape con sus miradas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Una ramera te cuesta un bocado de pan,",
          "pero la mujer ajena te puede costar la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "¿Quién se echa fuego en el pecho",
          "sin que se queme su ropa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "¿Quién puede andar sobre brasas",
          "sin que se quemen sus pies?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¡Pues tampoco puede clamar inocencia",
          "el que se acuesta con la mujer de su prójimo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Nadie desprecia al que roba,",
          "si lo hace para calmar su apetito;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "si lo sorprenden, debe pagar siete veces",
          "y entregar todo el patrimonio de su casa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "pero cometer adulterio es no tener cabeza;",
          "quien adultera, se corrompe a sí mismo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "lo que obtiene son golpes y vergüenza,",
          "y nunca logra borrar esa mancha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Los celos despiertan la ira del hombre,",
          "y en el día de la venganza este no perdona;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "no perdona ni se da por satisfecho,",
          "aunque se le ofrezcan muchos obsequios."
        ],
        "rlw_lines": []
      }
    ]
  },
