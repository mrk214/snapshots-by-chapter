    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contra los amigos falsos y traicioneros"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. En Neginot. Masquil de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios mío, ¡escucha mi oración!",
          "No te escondas; ¡atiende mi súplica!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Préstame atención; ¡respóndeme!",
          "En mi oración clamo a ti, y me conmuevo"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "por las amenazas de mis enemigos,",
          "por la opresión de los malvados.",
          "Sobre mí han descargado su iniquidad,",
          "y furiosos me persiguen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dentro de mí, el corazón me duele;",
          "sobre mí han caído terrores de muerte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me ha sobrevenido un terrible temblor,",
          "y estoy temblando de miedo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Cómo quisiera tener alas de paloma!",
          "¡Así podría volar, y descansaría!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Me escaparía muy lejos de aquí,",
          "y me quedaría a vivir en el desierto!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Presuroso escaparía del viento borrascoso!",
          "¡Huiría de la tempestad!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Destrúyelos, Señor! ¡Confunde su lengua!",
          "¡En la ciudad solo veo violencia y rencillas,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "que día y noche rodean sus murallas!",
          "En su interior solo hay iniquidad y violencia;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "en su interior solo hay continua maldad;",
          "el fraude y el engaño no se apartan de sus calles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "No me ha ofendido un enemigo,",
          "lo cual yo podría tolerar;",
          "tampoco me ha atacado quien me aborrece,",
          "pues de él podría haberme escondido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Has sido tú, que parecías ser mi amigo,",
          "mi compañero, mi hermano del alma!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tú y yo compartíamos dulces secretos,",
          "y juntos andábamos por la casa de Dios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Que la muerte sorprenda a mis enemigos!",
          "¡Que desciendan vivos al sepulcro,",
          "porque en ellos y en sus casas hay maldad!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por mi parte, yo clamaré a Dios;",
          "¡el Señor vendrá a salvarme!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "En la tarde, en la mañana, al mediodía,",
          "clamaré a Dios, y él oirá mi voz;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "me salvará de la guerra desatada contra mí,",
          "y me hará vivir en paz,",
          "aun cuando sean muchos los que me ataquen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Dios me oirá, y los humillará,",
          "pues él es el Rey eterno.",
          "Puesto que esos malvados no cambian,",
          "ni dan muestras de temer a Dios,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "violan su pacto y extienden la mano",
          "contra los que están en paz con ellos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Sus palabras son suaves, como mantequilla,",
          "pero en su corazón se libra una batalla.",
          "Sus palabras son suaves, como el aceite,",
          "pero en realidad son espadas desnudas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Tú, deja tus pesares en las manos del Señor,",
          "y el Señor te mantendrá firme;",
          "el Señor no deja a sus fieles caídos para siempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Y tú, Dios mío, ¡haz que esa gente descienda",
          "al profundo pozo de la perdición!",
          "¡Esa gente sanguinaria y mentirosa",
          "no llegará a la mitad de su vida!",
          "Pero yo, siempre confiaré en ti."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
