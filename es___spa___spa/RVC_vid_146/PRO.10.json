    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contraste entre el justo y el malvado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Los proverbios de Salomón.",
          "El hijo sabio alegra a su padre;",
          "el hijo necio entristece a su madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Las riquezas malvadas no son de provecho,",
          "pero la justicia libra de la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El Señor no deja que el justo pase hambre,",
          "pero rechaza la iniquidad de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Las manos negligentes llevan a la pobreza;",
          "las manos diligentes conducen a la riqueza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Cosechar en el verano es pensar con sensatez;",
          "dormirse en la cosecha es no tener vergüenza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "La cabeza del justo se cubre de bendiciones;",
          "la boca de los impíos encubre violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Recordar a los justos es una bendición;",
          "nombrar a los impíos resulta repugnante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El sabio de corazón hace suyos los mandamientos;",
          "el necio de labios acabará por caer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El de vida íntegra vive confiado;",
          "el de conducta perversa será descubierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El que guiña el ojo acarrea tristeza;",
          "el necio de labios será castigado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "La boca del justo es un manantial de vida,",
          "pero la boca del impío disimula su violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El odio despierta rencillas;",
          "pero el amor cubre todas las faltas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La sabiduría se halla en labios del prudente;",
          "la vara es para las espaldas del falto de cordura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los sabios atesoran el conocimiento;",
          "la boca del necio es calamidad cercana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El rico se atrinchera tras sus riquezas;",
          "el pobre se refugia en su pobreza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Con sus obras, el justo se gana la vida;",
          "con sus frutos, el impío se dedica a pecar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Acatar la corrección conduce a la vida;",
          "desechar la reprensión es perder el camino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Miente quien disimula su odio;",
          "es un necio quien propaga calumnias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "En las muchas palabras no falta el pecado;",
          "el que es prudente refrena sus labios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "La lengua del justo es plata escogida;",
          "la mente impía es lo mismo que nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Con sus labios el justo dirige a muchos;",
          "los necios mueren por falta de cordura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La bendición del Señor es un tesoro;",
          "nunca viene acompañada de tristeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El necio se divierte cometiendo maldades;",
          "el sabio se recrea con la sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "El impío es víctima de sus grandes temores;",
          "los justos reciben lo que más desean."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "El malvado pasa como un torbellino,",
          "pero el justo permanece para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "El que envía a un mensajero perezoso",
          "se echa vinagre en los dientes y humo en los ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El temor del Señor alarga la vida,",
          "pero los años del impío son acortados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "La esperanza de los justos es su alegría;",
          "la esperanza de los impíos se esfuma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "El camino del Señor fortalece al perfecto,",
          "pero destruye a los que hacen el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "El justo jamás tendrá un tropiezo,",
          "pero los impíos no habitarán la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "De la boca del justo mana sabiduría,",
          "pero la lengua perversa será extirpada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Los labios del justo dicen palabras gratas;",
          "la boca de los impíos arroja perversidades."
        ],
        "rlw_lines": []
      }
    ]
  },
