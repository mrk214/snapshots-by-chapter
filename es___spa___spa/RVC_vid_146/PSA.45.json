    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cántico para las bodas del rey"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Lirios. Masquil de los hijos de Coré. Cántico nupcial."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Rebosa mi corazón con un bello poema.",
          "Esta obra mía se la dedico al rey.",
          "¡Mi lengua es la pluma de inspirado poeta!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Eres el más hermoso de los mortales;",
          "la gracia mana de tus labios;",
          "¡por eso Dios te ha bendecido para siempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Cíñete la espada, valiente guerrero,",
          "y cúbrete de honra y majestad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Que tengas prosperidad y gloria!",
          "¡Cabalga defendiendo la verdad, la humildad y la justicia,",
          "guiado por tu diestra portentosa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Que penetren, oh rey, tus agudas flechas",
          "en el corazón de tus enemigos,",
          "y que los pueblos se rindan ante ti!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Oh Dios, tu trono es eterno y permanente;",
          "tu cetro real es un cetro de justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque amas la justicia y odias la maldad,",
          "Dios, tu Dios, te ha ungido como rey;",
          "ha derramado en ti el perfume de alegría;",
          "¡te eligió a ti, y no a tus compañeros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mirra, áloe y canela perfuman tus vestidos,",
          "y en los palacios de marfil te brindan alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Entre tus favoritas hay muchas princesas;",
          "la reina, a tu derecha, luce joyas de oro de Ofir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "«Hija mía, inclina tu oído y préstame atención:",
          "Olvídate de tu pueblo y de la casa paterna,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "que el rey desea poseer tu hermosura;",
          "él es tu señor, y le debes obediencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Gente de Tiro vendrá a ti con presentes;",
          "los ricos del pueblo implorarán tu favor.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Esplendorosa se ve la princesa en su alcoba!",
          "¡Sus vestidos son de brocado de oro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Así ataviada se presenta ante el rey,",
          "seguida por su séquito de doncellas,",
          "traídas de lejos para hacerle compañía;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "y entre jubilosas voces de alegría",
          "serán conducidas al palacio real."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tus hijos sucederán a tus padres,",
          "y los harás príncipes de toda la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Yo perpetuaré tu nombre para siempre,",
          "y perpetuamente los pueblos te alabarán."
        ],
        "rlw_lines": []
      }
    ]
  },
