    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»La vida se me escapa. Mis días se acortan.",
          "El sepulcro me está esperando."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Estoy rodeado de gente burlona,",
          "y tengo que verlos derramar su amargura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "»Dios mío, ¡ten la bondad de ser mi fiador!",
          "Si tú no respondes por mí, ¿quién más podría hacerlo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Has ofuscado la inteligencia de estos,",
          "y no permitirás que salgan triunfantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El que traiciona a su amigo por ganancia,",
          "verá desfallecer de hambre a sus hijos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "»Tú me has puesto en la boca de todos,",
          "y los que me ven se burlan de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El dolor me va nublando la vista,",
          "y mis pensamientos se van ofuscando."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ante esto, los hombres buenos se asombran",
          "y los inocentes se rebelan contra los malvados;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "los hombres buenos mantienen su postura,",
          "y los hombres honrados se revisten de fuerza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Vengan acá, todos ustedes, vengan!",
          "¡Ya sé que ninguno de ustedes es sabio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mis años pasan, mis planes se malogran,",
          "lo mismo que los designios de mi corazón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "pero ustedes cambian la noche en día;",
          "aún está oscuro, y dicen que está amaneciendo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Si mi única esperanza es el sepulcro,",
          "y he de yacer en medio de tinieblas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "si he de reconocer como “padre” al sepulcro,",
          "y llamar “madre” y “hermanas” a los gusanos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "entonces ¿qué otra esperanza me queda?",
          "Si acaso la hay, ¿dónde está, que no la veo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Bajará conmigo hasta el sepulcro,",
          "y allí descansaremos, envueltos en el polvo!»"
        ],
        "rlw_lines": []
      }
    ]
  },
