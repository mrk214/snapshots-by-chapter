    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segunda reprensión de Bildad a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces Bildad el suhita le dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¿Cuándo vas a dejar de hablar?",
          "Ponte a pensar, y después de eso hablaremos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Por qué nos consideras unas bestias?",
          "¿Por qué nos ves como gente despreciable?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Aunque airado te desgarres el alma,",
          "la tierra no va a quedarse sin vida por tu causa,",
          "ni las rocas van a cambiar de lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»La vida del malvado habrá de extinguirse,",
          "y el resplandor de su fuego dejará de brillar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "La luz se irá apagando en su casa,",
          "y su lámpara dejará de alumbrar;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "sus pasos irán perdiendo su vigor,",
          "y sus planes se volverán contra él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A su paso se le tenderán trampas,",
          "y quedará enredado entre redes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Sus tobillos quedarán atrapados",
          "en la trampa que se le tienda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Le esperan trampas ocultas en el suelo;",
          "hay trampas escondidas, esperando que pase."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por todas partes lo asaltará el terror;",
          "por todos lados se verá perseguido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El hambre le hará perder fuerzas,",
          "y el desastre no lo abandonará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La enfermedad irá minando su cuerpo,",
          "y la muerte le roerá las manos y los pies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Arrancado de la seguridad de su casa,",
          "será arrastrado por el rey de los terrores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Vivirá en su propia casa como en casa ajena,",
          "y sobre su casa caerá polvo de azufre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Será desarraigado de su pueblo,",
          "y nunca llegará a formar una familia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Su nombre será olvidado por todos,",
          "y nadie en la calle lo reconocerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Será arrojado de la luz a las tinieblas,",
          "y expulsado de este mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "No tendrá entre su pueblo pariente alguno,",
          "ni habrá tampoco quien herede sus posesiones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Su final aterrará a los de occidente,",
          "y hará temblar de miedo a los de oriente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Así termina la vida de los malvados;",
          "en eso paran los que no reconocen a Dios.»"
        ],
        "rlw_lines": []
      }
    ]
  },
