    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La justicia del Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Muchas han sido mis angustias",
          "desde mi juventud…",
          "—que lo reconozca el pueblo de Israel—,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "muchas han sido mis angustias",
          "desde mi juventud,",
          "pero no lograron vencerme."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sobre mis espaldas pasaron los arados",
          "y me dejaron profundas huellas,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "pero el Señor, que es justo,",
          "me libró de las ataduras de los malvados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Que huyan avergonzados",
          "todos los que odian a Sión!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Que sean como la hierba en el tejado,",
          "que se marchita y nunca crece,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "que no alcanza a llenar la mano del segador,",
          "ni jamás llega a formar un manojo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Que nunca le digan los que pasan:",
          "«¡Que el Señor los bendiga!",
          "¡Nosotros los bendecimos en el nombre del Señor!»"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
