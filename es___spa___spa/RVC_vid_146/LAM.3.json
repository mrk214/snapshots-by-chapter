{"version":{"version_id":146,"local_abbreviation":"RVC","local_title":"Reina Valera Contemporánea","language":{"iso_639_1":"es","iso_639_3":"spa","language_tag":"spa","local_name":"Español (América Latina)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-es-spa","publisher":{"name":"United Bible Societies"},"copyright":{"html":"<p>Reina Valera Contemporánea™ © Sociedades Bíblicas Unidas, 2009, 2010.</p>","text":"Reina Valera Contemporánea™ © Sociedades Bíblicas Unidas, 2009, 2010."}},"book":{"book_usfm":"LAM","name":"Lamentaciones"},"chapter":{"chapter_usfm":"LAM.3","is_chapter":true,"previous":{"usfm":"LAM.2","human":"Lamentaciones 2","canonical":true,"toc":true},"current":{"usfm":"LAM.3","human":"Lamentaciones 3"},"next":{"usfm":"LAM.4","human":"Lamentaciones 4","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["La misericordia de Dios es constante"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Yo soy aquel que ha visto la aflicción","bajo el látigo de su enojo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Me ha llevado por un sendero","no de luz sino de tinieblas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["A todas horas vuelve y revuelve","su mano contra mí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Ha hecho envejecer mi carne y mi piel;","me ha despedazado los huesos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Ha levantado en torno mío","un muro de amargura y de trabajo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Me ha dejado en las tinieblas,","como a los que murieron hace tiempo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Por todos lados me asedia y no puedo escapar;","¡muy pesadas son mis cadenas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Grito pidiéndole ayuda,","pero él no atiende mi oración."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Ha cercado con piedras mis caminos;","me ha cerrado el paso."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Como un oso en acecho,","como león agazapado,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["me desgarró por completo","y me obligó a cambiar de rumbo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Tensó su arco y me puso","como blanco de sus flechas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Me clavó en las entrañas","las saetas de su aljaba."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Todo el tiempo soy para mi pueblo","motivo de burla."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["¡Me ha llenado de amargura!","¡Me ha embriagado de ajenjo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Me ha roto los dientes,","me ha cubierto de ceniza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Ya no sé lo que es tener paz","ni lo que es disfrutar del bien,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["y concluyo: «Fuerzas ya no tengo,","ni esperanza en el Señor.»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Tan amargo como la hiel es pensar","en mi aflicción y mi tristeza,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["y lo traigo a la memoria","porque mi alma está del todo abatida;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["pero en mi corazón recapacito,","y eso me devuelve la esperanza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Por la misericordia del Señor","no hemos sido consumidos;","¡nunca su misericordia se ha agotado!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["¡Grande es su fidelidad,","y cada mañana se renueva!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Por eso digo con toda el alma:","«¡El Señor es mi herencia, y en él confío!»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Es bueno el Señor con quienes le buscan,","con quienes en él esperan."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Es bueno esperar en silencio","que el Señor venga a salvarnos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Es bueno que llevemos el yugo","desde nuestra juventud."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Dios nos lo ha impuesto.","Así que callemos y confiemos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Hundamos la cara en el polvo.","Tal vez aún haya esperanza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Demos la otra mejilla a quien nos hiera.","¡Cubrámonos de afrentas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["El Señor no nos abandonará para siempre;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["nos aflige, pero en su gran bondad","también nos compadece."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["No es la voluntad del Señor","afligirnos ni entristecernos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Hay quienes oprimen a todos","los encarcelados de la tierra,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["y tuercen los derechos humanos","en presencia del Altísimo,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[36],"lines":["y aun trastornan las causas que defienden.","Pero el Señor no lo aprueba."],"rlw_lines":[]},{"type":"verse","verse_numbers":[37],"lines":["¿Quién puede decir que algo sucede","sin que el Señor lo ordene?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[38],"lines":["¿Acaso lo malo y lo bueno no proviene","de la boca del Altísimo?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[39],"lines":["¿Cómo podemos quejarnos,","si sufrimos por nuestros pecados?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[40],"lines":["Examinemos nuestra conducta;","busquemos al Señor y volvámonos a él."],"rlw_lines":[]},{"type":"verse","verse_numbers":[41],"lines":["Elevemos al Dios de los cielos","nuestras manos y nuestros corazones."],"rlw_lines":[]},{"type":"verse","verse_numbers":[42],"lines":["Hemos sido rebeldes y desleales,","y tú no nos perdonaste."],"rlw_lines":[]},{"type":"verse","verse_numbers":[43],"lines":["Lleno de ira, no nos perdonaste;","¡nos perseguiste y nos mataste!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[44],"lines":["Te envolviste en una nube","para no escuchar nuestros ruegos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[45],"lines":["Entre los paganos hiciste de nosotros","motivo de vergüenza y de rechazo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[46],"lines":["Todos nuestros enemigos nos tuercen la boca;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[47],"lines":["son para nosotros una trampa,","¡son motivo de temor, destrucción y quebranto!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[48],"lines":["¡Los ojos se me llenan de llanto","al ver el desastre de mi ciudad amada!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[49],"lines":["Mis ojos no dejan de llorar,","pues ya no hay remedio,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[50],"lines":["a menos que desde los cielos","el Señor se digne mirarnos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[51],"lines":["Me llena de tristeza ver el sufrimiento","de las mujeres de mi ciudad."],"rlw_lines":[]},{"type":"verse","verse_numbers":[52],"lines":["Mis enemigos me acosaron sin motivo,","como si persiguieran a un ave;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[53],"lines":["me ataron y me arrojaron en un pozo,","y sobre mí pusieron una piedra;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[54],"lines":["las aguas me llegaron hasta el cuello,","y llegué a darme por muerto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[55],"lines":["Desde el fondo de la cárcel","invoqué, Señor, tu nombre,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[56],"lines":["y tú oíste mi voz; no cerraste tus oídos","al clamor de mis suspiros;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[57],"lines":["el día que te invoqué, viniste a mí","y me dijiste: «No tengas miedo.»"],"rlw_lines":[]},{"type":"verse","verse_numbers":[58],"lines":["Tú, Señor, me defendiste;","me salvaste la vida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[59],"lines":["Tú, Señor, viste mi agravio","y viniste en mi defensa;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[60],"lines":["te diste cuenta de que ellos","solo pensaban en vengarse de mí."],"rlw_lines":[]},{"type":"verse","verse_numbers":[61],"lines":["Tú, Señor, sabes cómo me ofenden,","cómo hacen planes contra mí;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[62],"lines":["sabes que mis enemigos","a todas horas piensan hacerme daño;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[63],"lines":["¡en todo lo que hacen","soy el tema de sus burlas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[64],"lines":["¡Dales, Señor, el pago que merecen sus acciones!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[65],"lines":["¡Déjalos en manos de su obstinación!","¡Que tu maldición caiga sobre ellos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[66],"lines":["En tu furor, Señor, ¡persíguelos!","¡Haz que desaparezcan de este mundo!"],"rlw_lines":[]}]}}