        "lines": [
          "La misericordia del Señor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Alabemos al Señor, porque él es bueno!",
          "¡Su misericordia permanece para siempre!"
