    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Entre la paz y la guerra"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico gradual."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "En mi angustia, clamé al Señor,",
          "y el Señor me respondió."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Líbrame, Señor, de los mentirosos,",
          "de la gente de lengua embustera!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tú, lengua mentirosa,",
          "¿qué ganas con engañar a todos?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Serás asaeteado con agudas flechas,",
          "ardientes como el fuego de retama!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Ay de mí! ¡Soy un extranjero en Mesec!",
          "¡Habito entre las tiendas de Cedar!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Ya he convivido mucho tiempo",
          "con los que no pueden vivir en paz!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Aunque soy un hombre de paz,",
          "cuando les hablo, me declaran la guerra."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
