    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, el único refugio"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. A Jedutún. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Solo en Dios halla tranquilidad mi alma;",
          "solo de él viene mi salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Solo Dios es mi salvación y mi roca;",
          "porque él es mi refugio, jamás resbalaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Hasta cuándo harán planes todos ustedes",
          "con la intención de derrotar a un solo hombre?",
          "¡Lo ven como pared desplomada!",
          "¡Lo ven como una cerca en el suelo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Conspiran para despojarlo de su grandeza;",
          "les agrada decir mentiras;",
          "¡bendicen con los labios, pero maldicen con el corazón!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Solo en Dios halla tranquilidad mi alma;",
          "solo en él he puesto mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Solo Dios es mi salvación y mi roca;",
          "porque él es mi refugio, no resbalaré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Solo Dios es mi salvación y mi gloria;",
          "¡Dios es mi roca fuerte y mi refugio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pueblos todos, ¡confíen siempre en Dios!",
          "¡Vacíen delante de él su corazón!",
          "¡Dios es nuestro refugio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los hombres, sean ricos o sean pobres,",
          "no son más que un vapor engañoso.",
          "Puestos todos ellos en la balanza,",
          "podrá verse que no son nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No confíen en la violencia,",
          "ni pongan vanas esperanzas en la rapiña;",
          "si acaso llegan a acumular riquezas,",
          "no les entreguen su corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios habló una vez,",
          "y yo lo escuché dos veces:",
          "Tuyo, Dios mío, es el poder;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "tuya, Señor, es la misericordia;",
          "tú das a cada uno lo que merecen sus obras."
        ],
        "rlw_lines": []
      }
    ]
  },
