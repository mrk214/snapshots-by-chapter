    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Excelencias de la ley de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Álef"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dichosos los de conducta perfecta,",
          "los que siguen las enseñanzas del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Dichosos los que cumplen sus testimonios,",
          "y lo buscan de todo corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ellos no cometen ninguna maldad,",
          "porque van por los caminos del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tú, Señor, has ordenado",
          "que se cumplan bien tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Cómo quisiera ordenar mis caminos",
          "para cumplir con tus estatutos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Así no sentiría yo vergüenza",
          "de atender a todos tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Te alabaré con un corazón sincero",
          "cuando haya aprendido tus justas sentencias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Quiero obedecer tus estatutos;",
          "¡no me abandones del todo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Bet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Cómo puede el joven limpiar su camino?",
          "¡Obedeciendo tu palabra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Yo te he buscado de todo corazón;",
          "¡no dejes que me aparte de tus mandamientos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "En mi corazón he atesorado tus palabras,",
          "para no pecar contra ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡Bendito seas, Señor!",
          "¡Permíteme aprender tus estatutos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Con mis labios siempre proclamo",
          "todas las sentencias que has dictado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Me alegra seguir el camino de tus testimonios",
          "más que poseer muchas riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Siempre medito en tus mandamientos,",
          "y fijo mi atención en tus sendas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mi alegría es el cumplir tus estatutos;",
          "¡nunca me olvido de tus palabras!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Guímel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Concédele a tu siervo una larga vida,",
          "y obedecer siempre tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ábreme los ojos para contemplar",
          "las grandes maravillas de tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "En este mundo estoy de paso;",
          "¡no escondas de mí tus mandamientos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Con ansias anhela mi alma",
          "conocer en todo tiempo tus sentencias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Tú reprendes a los soberbios y malvados",
          "que se apartan de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Aparta de mí la vergüenza y el desprecio,",
          "porque yo he cumplido con tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Los magnates se reunieron para condenarme,",
          "pero este siervo tuyo meditaba en tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Yo me deleito en tus testimonios,",
          "porque son mis mejores consejeros."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Dálet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Me siento totalmente desanimado;",
          "¡infúndeme vida, conforme a tu palabra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Te he contado mis planes, y me has respondido;",
          "ahora dame a conocer tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Hazme entender cómo andar en tus mandatos,",
          "para que medite yo en tus maravillas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "La ansiedad me corroe el alma;",
          "¡susténtame con tu palabra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Apártame de andar tras la mentira,",
          "y en tu misericordia enséñame tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Yo he escogido seguirte fielmente;",
          "y tengo presentes tus sentencias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Señor, yo me ciño a tus testimonios;",
          "¡no permitas que sea yo avergonzado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Quiero seguir la senda de tus mandamientos,",
          "porque tú le das libertad a mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "He"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Señor, guíame por el camino de tus estatutos,",
          "y yo los obedeceré hasta el fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Hazme entender tu ley, para cumplirla;",
          "la obedeceré de todo corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Encamíname hacia tus mandamientos,",
          "porque en ellos me deleito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Inclina mi corazón hacia tus testimonios,",
          "y no hacia la avaricia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Aparta mis ojos de los dioses falsos,",
          "y dame vida para andar contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Confirma tu palabra a tu siervo,",
          "porque este siervo tuyo te honra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Aléjame del temor a la deshonra,",
          "porque tú eres bondadoso en tus juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Ansío conocer tus mandamientos;",
          "¡dame vida conforme a tu justicia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Vau"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Señor, ten misericordia de mí,",
          "y envíame tu salvación, como lo has prometido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Así responderé a los que se burlan de mí,",
          "que yo he puesto en ti mi confianza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "No quites de mis labios la verdad de tu palabra,",
          "pues he puesto mi esperanza en tu justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Yo cumpliré siempre tu ley,",
          "desde ahora y para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Solo así seré completamente libre,",
          "pues he buscado seguir tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "En presencia de reyes hablaré de tus testimonios,",
          "y no tendré de qué avergonzarme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Tus mandamientos son mi alegría,",
          "porque los amo profundamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Con amor levanto mis manos hacia tus mandamientos,",
          "y medito en tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Záyin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Recuerda las promesas que me hiciste,",
          "en las cuales he puesto mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "En mi aflicción, ellas son mi consuelo;",
          "pues tu palabra me infunde nueva vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Los soberbios se burlan mucho de mí,",
          "pero ni así me aparto de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Mi consuelo, Señor, es recordar",
          "que tu justicia es siempre la misma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Me horroriza pensar que hay malvados",
          "que se mantienen alejados de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Aunque en este mundo estoy de paso,",
          "mis canciones son tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Por las noches pienso en ti, Señor,",
          "pues quiero obedecer tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Esto es lo que me ha tocado:",
          "poner en práctica tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Jet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "Señor, tú eres todo lo que tengo,",
          "y prometo que obedeceré tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "De todo corazón busco tu presencia;",
          "ten compasión de mí, conforme a tu promesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "He estado pensando en mis acciones,",
          "y decidí encaminar mis pies hacia tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Voy a darme prisa, y sin tardanza",
          "cumpliré con tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Me hallo sujeto a gente sin piedad,",
          "pero no me olvido de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "Me levanto a medianoche, y te alabo",
          "porque tus juicios son rectos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Soy amigo de todos los que te honran,",
          "de todos los que obedecen tus preceptos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Señor, tu misericordia llena la tierra;",
          "¡enséñame tus decretos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Tet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Señor, tú has tratado con bondad a tu siervo,",
          "de acuerdo a lo que le prometiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Enséñame a tener sabiduría y buen juicio,",
          "pues yo creo en tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Antes de sufrir, yo andaba descarriado;",
          "pero ahora obedezco tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Tú eres bueno, y me tratas bien;",
          "enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "Gente arrogante inventa mentiras en mi contra,",
          "pero yo cumplo tus mandamientos de todo corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "Esa gente tiene el corazón insensible,",
          "pero yo me regocijo con tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "Me convino que me hayas castigado,",
          "porque así pude aprender tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "Para mí, es mejor la ley que mana de tus labios",
          "que miles de monedas de oro y plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Yod"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "Tú, con tus propias manos me formaste;",
          "dame la capacidad de comprender tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "Cuando me vean los que te honran, se alegrarán,",
          "porque en tu palabra he puesto mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "Señor, yo sé que tus juicios son justos,",
          "y que por tu fidelidad me afligiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "Muéstrame tu misericordia, y ven a consolarme,",
          "pues esa fue tu promesa a este siervo tuyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "Compadécete de mí, y viviré,",
          "pues en tu ley encuentro mi deleite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "Avergüenza a esos arrogantes que me calumnian;",
          "por mi parte, yo meditaré en tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Que se unan a mí aquellos que te honran,",
          "aquellos que conocen tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "Perfecciona mi corazón con tus estatutos,",
          "para que no tenga de qué avergonzarme."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Caf"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "Siento que me muero esperando tu salvación,",
          "pero sigo confiando en tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          82
        ],
        "lines": [
          "Los ojos se me apagan esperando tu promesa,",
          "y me pregunto: «¿Cuándo vendrás a consolarme?»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          83
        ],
        "lines": [
          "Me siento tan inútil como un odre viejo,",
          "pero tengo presentes tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          84
        ],
        "lines": [
          "¿Cuántos años más me quedan de vida?",
          "¿Cuándo dictarás sentencia contra mis enemigos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          85
        ],
        "lines": [
          "Gente altanera me ha tendido trampas,",
          "pues no actúa de acuerdo con tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          86
        ],
        "lines": [
          "Todos tus mandamientos son verdaderos;",
          "¡ayúdame, porque sin razón soy perseguido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          87
        ],
        "lines": [
          "Poco ha faltado para que me derriben,",
          "pero ni así me he apartado de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          88
        ],
        "lines": [
          "¡Dame vida, conforme a tu misericordia,",
          "para que cumpla los testimonios que has emitido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Lámed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          89
        ],
        "lines": [
          "Señor, tu palabra es eterna,",
          "y permanece firme como los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          90
        ],
        "lines": [
          "Tu fidelidad es la misma por todas las edades;",
          "tú afirmaste la tierra, y esta permanece firme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          91
        ],
        "lines": [
          "Por tus decretos, todo subsiste hoy,",
          "y todo está a tu servicio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          92
        ],
        "lines": [
          "Si en tu ley no hallara mi regocijo,",
          "la aflicción ya habría acabado conmigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          93
        ],
        "lines": [
          "Jamás me olvidaré de tus mandamientos,",
          "porque con ellos me has devuelto la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          94
        ],
        "lines": [
          "Mi vida te pertenece; ¡sálvame, Señor,",
          "pues yo estudio tus mandamientos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          95
        ],
        "lines": [
          "Los malvados buscan cómo destruirme,",
          "pero yo trato de entender tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          96
        ],
        "lines": [
          "He visto que aun lo perfecto se acaba,",
          "pero tus mandamientos son eternos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Mem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          97
        ],
        "lines": [
          "¡Cuánto amo yo tus enseñanzas!",
          "¡Todo el día medito en ellas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          98
        ],
        "lines": [
          "Me has hecho más sabio que a mis perseguidores,",
          "porque tus enseñanzas están siempre conmigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          99
        ],
        "lines": [
          "Entiendo más que mis maestros,",
          "porque tus testimonios son mi meditación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          100
        ],
        "lines": [
          "Comprendo mejor que los ancianos,",
          "porque obedezco tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          101
        ],
        "lines": [
          "Me he apartado de todo mal camino,",
          "para obedecer tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          102
        ],
        "lines": [
          "No me he apartado de tus juicios",
          "porque eres tú quien me dirige."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          103
        ],
        "lines": [
          "¡Cuán dulces son tus palabras en mi boca!",
          "¡Son más dulces que la miel en mis labios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          104
        ],
        "lines": [
          "Tus mandamientos me han dado inteligencia;",
          "por eso odio toda senda de mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Nun"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          105
        ],
        "lines": [
          "Tu palabra es una lámpara a mis pies;",
          "¡es la luz que ilumina mi camino!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          106
        ],
        "lines": [
          "Me comprometí, y no me arrepiento:",
          "voy a obedecer tus justas sentencias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          107
        ],
        "lines": [
          "Señor, me encuentro muy afligido;",
          "dame vida, conforme a tu promesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          108
        ],
        "lines": [
          "Señor, espero que te agraden mis votos;",
          "enséñame a entender tus juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          109
        ],
        "lines": [
          "Mi vida está siempre en peligro,",
          "pero yo no me olvido de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          110
        ],
        "lines": [
          "Gente malvada me ha tendido trampas,",
          "pero yo no me he apartado de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          111
        ],
        "lines": [
          "Tengo tu palabra como herencia eterna,",
          "porque ella me alegra el corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          112
        ],
        "lines": [
          "De corazón me dispongo a cumplir tus estatutos",
          "siempre, hasta el fin de mis días."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Sámej"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          113
        ],
        "lines": [
          "No soporto a la gente hipócrita,",
          "pero amo tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          114
        ],
        "lines": [
          "Tú eres mi escondite; eres mi escudo;",
          "en tu palabra he puesto mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          115
        ],
        "lines": [
          "Ustedes los malhechores: ¡apártense de mí,",
          "que quiero obedecer los mandamientos de mi Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          116
        ],
        "lines": [
          "Aliméntame con tu palabra, y viviré;",
          "¡no permitas que se frustre mi esperanza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          117
        ],
        "lines": [
          "Sostenme, y estaré a salvo,",
          "y siempre me alegraré en tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          118
        ],
        "lines": [
          "Tú humillas a los que se apartan de tus estatutos,",
          "porque su astucia es pura falsedad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          119
        ],
        "lines": [
          "Consumes como a basura a todos los malvados,",
          "por eso yo amo tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          120
        ],
        "lines": [
          "Todo mi ser se estremece de temor;",
          "¡tiemblo a causa de tus sentencias!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          121
        ],
        "lines": [
          "Yo practico el derecho y la justicia;",
          "¡no me dejes caer en poder de mis enemigos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          122
        ],
        "lines": [
          "Trata con bondad a este siervo tuyo;",
          "que no se aprovechen de mí los soberbios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          123
        ],
        "lines": [
          "Mis ojos desfallecen esperando que me salves,",
          "y que con tu palabra me hagas justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          124
        ],
        "lines": [
          "Trátame con misericordia,",
          "y enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          125
        ],
        "lines": [
          "Yo soy tu siervo, y quiero entender",
          "y llegar a conocer tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          126
        ],
        "lines": [
          "Señor, ¡llegó el momento de que actúes,",
          "pues los malvados han anulado tu ley!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          127
        ],
        "lines": [
          "Por eso yo amo tus mandamientos,",
          "porque son mejores que el oro más puro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          128
        ],
        "lines": [
          "Yo estimo la rectitud y pureza de tus mandamientos;",
          "por eso me he alejado de la senda de mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          129
        ],
        "lines": [
          "Tus testimonios son admirables;",
          "por eso son el tesoro de mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          130
        ],
        "lines": [
          "La enseñanza de tus palabras ilumina;",
          "y hasta la gente sencilla las entiende."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          131
        ],
        "lines": [
          "Grandes son mi sed y mis ansias",
          "por recibir y entender tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          132
        ],
        "lines": [
          "Mírame, y ten misericordia de mí,",
          "como la tienes con quienes te aman."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          133
        ],
        "lines": [
          "Ordena mis pasos con tu palabra,",
          "para que el pecado no me domine."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          134
        ],
        "lines": [
          "Protégeme de los hombres violentos,",
          "porque deseo obedecer tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          135
        ],
        "lines": [
          "Alumbra con tu presencia a este siervo tuyo,",
          "y enséñame tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          136
        ],
        "lines": [
          "De mis ojos brota el llanto a mares,",
          "porque hay gente que no obedece tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Tsade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          137
        ],
        "lines": [
          "Tú, Señor, eres justo,",
          "y tus sentencias son rectas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          138
        ],
        "lines": [
          "Los mandamientos que nos has dado",
          "son también justos y verdaderos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          139
        ],
        "lines": [
          "Pero el enojo me consume,",
          "porque mis enemigos olvidaron tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          140
        ],
        "lines": [
          "Tu palabra es todo pureza;",
          "por eso yo, tu siervo, la amo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          141
        ],
        "lines": [
          "Yo soy insignificante, y nada valgo,",
          "pero no me olvido de tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          142
        ],
        "lines": [
          "Tu justicia es siempre justa,",
          "y tu ley es la verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          143
        ],
        "lines": [
          "La aflicción y la angustia me dominan,",
          "pero el gozo de tus mandamientos me levanta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          144
        ],
        "lines": [
          "Tus testimonios son siempre justos;",
          "dame entendimiento y viviré."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cof"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          145
        ],
        "lines": [
          "Señor, yo te llamo con todo el corazón;",
          "¡respóndeme, y cumpliré tus estatutos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          146
        ],
        "lines": [
          "¡Sálvame, pues a ti elevo mi clamor!",
          "¡Quiero obedecer tus testimonios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          147
        ],
        "lines": [
          "Clamo a ti antes de que amanezca,",
          "y me quedo esperando tu respuesta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          148
        ],
        "lines": [
          "Me mantengo despierto toda la noche",
          "para meditar en tus mandatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          149
        ],
        "lines": [
          "Señor, escúchame, por tu misericordia;",
          "¡dame vida, conforme a tu justicia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          150
        ],
        "lines": [
          "Mis malvados perseguidores ya están cerca,",
          "pero de tu ley están muy lejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          151
        ],
        "lines": [
          "Pero tú, Señor, sí estás muy cerca,",
          "y todos tus mandamientos son verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          152
        ],
        "lines": [
          "Hace tiempo llegué a conocer tus mandatos,",
          "los cuales estableciste para la eternidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Resh"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          153
        ],
        "lines": [
          "Mira mi aflicción, y ven a salvarme,",
          "pues no me he olvidado de tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          154
        ],
        "lines": [
          "¡Defiéndeme, y ponme a salvo!",
          "¡Dame vida con tu palabra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          155
        ],
        "lines": [
          "Los malvados están lejos de tu salvación,",
          "porque no buscan tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          156
        ],
        "lines": [
          "Señor, tú eres muy bondadoso;",
          "¡dame vida de acuerdo a tu justicia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          157
        ],
        "lines": [
          "Son muchos los enemigos que me persiguen,",
          "pero yo no me aparto de tus testimonios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          158
        ],
        "lines": [
          "No soporto ver a esos traidores,",
          "porque no obedecen tus palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          159
        ],
        "lines": [
          "Señor, ¡mira cuánto amo tus mandamientos!",
          "¡Dame vida, conforme a tu misericordia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          160
        ],
        "lines": [
          "La verdad es la esencia de tu palabra,",
          "y tus juicios son siempre justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Shin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          161
        ],
        "lines": [
          "Los poderosos me persiguen sin motivo,",
          "pero yo respeto y honro tu palabra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          162
        ],
        "lines": [
          "Es tal la alegría que me causa tu palabra",
          "que es como hallar un gran tesoro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          163
        ],
        "lines": [
          "No soporto la mentira. ¡La aborrezco!",
          "Pero amo tus enseñanzas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          164
        ],
        "lines": [
          "Siete veces al día te alabo",
          "porque tus juicios son siempre justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          165
        ],
        "lines": [
          "Los que aman tu ley viven en completa paz,",
          "porque saben que no tropezarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          166
        ],
        "lines": [
          "Señor, espero que me salves;",
          "mientras viva, cumpliré tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          167
        ],
        "lines": [
          "Toda mi vida he obedecido tus estatutos,",
          "pues son el gran amor de mi vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          168
        ],
        "lines": [
          "He cumplido tus mandamientos y tus testimonios",
          "pues tú sabes todo lo que hago."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Tav"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          169
        ],
        "lines": [
          "Señor, ¡escucha mi clamor!",
          "¡Dame entendimiento, conforme a tu palabra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          170
        ],
        "lines": [
          "¡Que llegue mi oración a tu presencia!",
          "¡Líbrame, como lo has prometido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          171
        ],
        "lines": [
          "De mis labios se desbordará la alabanza",
          "cuando me hayas enseñado tus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          172
        ],
        "lines": [
          "Con mis labios proclamaré tu palabra,",
          "porque todos tus mandamientos son justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          173
        ],
        "lines": [
          "Extiende tu mano para socorrerme,",
          "porque he elegido obedecer tus mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          174
        ],
        "lines": [
          "Señor, yo espero que me salves,",
          "porque me deleito en tu ley."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          175
        ],
        "lines": [
          "Concédeme vida para alabarte,",
          "y sosténme con tus juicios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          176
        ],
        "lines": [
          "Ando sin rumbo, como oveja perdida;",
          "¡ven en busca de este siervo tuyo",
          "que no ha olvidado tus mandamientos!"
        ],
        "rlw_lines": []
      }
    ]
