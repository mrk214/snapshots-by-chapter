    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, el Juez supremo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "El Señor, el Dios de dioses, ha hablado;",
          "de este a oeste ha convocado a la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Desde Sión, la ciudad bella y perfecta,",
          "Dios deja ver su esplendor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Nuestro Dios viene, pero no en silencio.",
          "Un fuego consumidor lo precede;",
          "una poderosa tempestad lo rodea."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Convoca a los cielos y a la tierra,",
          "pues viene a juzgar a su pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "«Reúnan a mi pueblo santo,",
          "a los que han hecho un pacto conmigo",
          "y me han ofrecido un sacrificio.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Y los cielos declaran su justicia;",
          "declaran que Dios mismo es el juez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "«Escucha, Israel, pueblo mío;",
          "voy a hablar y a testificar contra ti.",
          "Yo soy Dios. Yo soy tu Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No voy a reprenderte por tus sacrificios,",
          "ni por los holocaustos que siempre me ofreces;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "no voy a tomar ningún becerro de tu casa,",
          "ni ningún macho cabrío de tus apriscos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "pues míos son todos los animales del bosque,",
          "¡los miles de animales que hay en las colinas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mías son todas las aves de los montes;",
          "mío es todo lo que se mueve en los campos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Si yo tuviera hambre, no te lo diría,",
          "pues el mundo y su plenitud me pertenecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Acaso me alimento con carne de toros,",
          "o bebo sangre de machos cabríos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Yo soy el Dios altísimo;",
          "en vez de sacrificios, ofréceme alabanzas",
          "y cúmpleme todos los votos que me hagas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Invócame en el día de la angustia;",
          "yo te libraré, y tú me honrarás.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pero al malvado Dios le dice:",
          "«¿Qué tienes tú que ver con mis leyes?",
          "¿Por qué te atreves a hablar de mi pacto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¡Si tú aborreces la corrección,",
          "y echas en saco roto mis palabras!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si ves un ladrón, corres a su encuentro;",
          "¡eres gran amigo de los adúlteros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Para el mal, no mides tus palabras;",
          "con tu lengua urdes toda clase de engaños."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "En los tribunales, hablas contra tu hermano;",
          "contra tu propio hermano profieres infamias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Todo esto has hecho, y yo me he callado;",
          "habrás pensado que yo soy como tú.",
          "Pero ahora voy a reprenderte;",
          "voy a exhibir todas tus maldades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "»Ustedes, los que se olvidan de mí,",
          "entiendan bien esto;",
          "no vaya a ser que los despedace",
          "y no haya quien los libre de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El que me ofrece alabanzas, me honra;",
          "al que enmiende su camino, yo lo salvaré.»"
        ],
        "rlw_lines": []
      }
    ]
  },
