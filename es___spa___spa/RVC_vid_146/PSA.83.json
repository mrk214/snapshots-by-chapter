    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria contra los enemigos de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios mío, ¡no guardes silencio!",
          "Dios mío, ¡no te quedes callado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Date cuenta de que tus enemigos rugen,",
          "de que te desafían los que te aborrecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Con astucia y en secreto conspiran contra tu pueblo;",
          "se han juntado y hacen planes contra tus protegidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Amenazantes dicen: «¡Vamos a destruir a Israel!",
          "¡Borremos de la memoria el nombre de esa nación!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Conspiran con un solo propósito:",
          "establecen alianzas para luchar en contra tuya"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "los campamentos edomitas e ismaelitas,",
          "y también los moabitas y los agarenos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "los de Gebal, los de Amón y de Amalec,",
          "los filisteos y los habitantes de Tiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "También los asirios se les han unido,",
          "y brindan su apoyo a los descendientes de Lot."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Haz con ellos lo que hiciste con Madián!",
          "¡Trátalos como a Sísara y Jabín en el arroyo de Cisón!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ellos fueron derrotados en Endor,",
          "y se convirtieron en estiércol para la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Trata a sus capitanes y a todos sus príncipes",
          "como trataste a Oreb y a Zeeb, a Zebaj y a Salmuná,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "esos que amenazantes decían:",
          "«¡Vamos a adueñarnos de los pastizales de Dios!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Dios mío, ¡envuélvelos en un torbellino!",
          "¡Arrástralos como hojas secas lanzadas al viento!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡Que ardan como el fuego que consume el monte!",
          "¡Que ardan como las llamas que abrasan el bosque!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Persíguelos con tu tempestad!",
          "¡Hazlos temblar de miedo con tu torbellino!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡Llénales la cara de vergüenza,",
          "para que busquen, Señor, tu nombre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¡Que sean avergonzados y turbados para siempre!",
          "¡Que sean deshonrados, y perezcan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¡Que reconozcan que tu nombre es el Señor,",
          "y que solo tú, Altísimo, estás sobre toda la tierra!"
        ],
        "rlw_lines": []
      }
    ]
  },
