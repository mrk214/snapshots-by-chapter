    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Adán"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Adán, Set, Enós,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cainán, Malalel, Yared,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enoc, Matusalén, Lamec,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Noé, Sem, Cam y Jafet."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de los hijos de Noé"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los hijos de Jafet fueron Gomer, Magog, Maday, Javán, Tubal, Mesec y Tiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los hijos de Gomer fueron Askenaz, Rifat y Togarmá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Los hijos de Javán fueron Elisa, Tarsis, Quitín y Rodanín."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Los hijos de Cam fueron Cus, Misrayin, Fut y Canaán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los hijos de Cus fueron Sebá, Javilá, Sabta, Ragama y Sabteca.",
          "Los hijos de Ragama fueron Sebá y Dedán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cus fue el padre de Nimrod, y este llegó a ser poderoso en la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Misrayin fue el padre de Ludim, Anamim, Lehabim, Naftuhim,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Patrusim y Casluhim. De estos salieron los filisteos y los caftoritas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Canaán fue el padre de Sidón, su primogénito, de Jet,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "y de los jebuseos, amorreos, gergeseos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "jivitas, araceos, sineos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "arvadeos, semareos y jamatitas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los hijos de Sem fueron Elam, Asur, Arfaxad, Lud, Aram, Uz, Jul, Geter y Mesec."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Arfaxad fue el padre de Sela, y Sela fue el padre de Éber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Éber tuvo dos hijos. Uno de ellos se llamó Peleg, porque durante sus días se dividió la tierra. Su hermano se llamó Joctán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Joctán fue el padre de Almodad, Selef, Jasar Mávet, Yera,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Hadorán, Uzal, Diclá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ebal, Abimael, Sebá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ofir, Javilá y Jobab. Todos ellos fueron hijos de Joctán."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Sem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Sem, Arfaxad, Sela,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Éber, Peleg, Reu,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Serug, Najor, Téraj,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "y Abrán, también llamado Abrahán."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Ismael y de Cetura"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Los hijos de Abrahán fueron Isaac e Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Estos fueron sus descendientes: Nebayot, primogénito de Ismael; seguido de Cedar, Adbel, Mibsán,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Misma, Duma, Massa, Hadad, Tema,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Jetur, Nafís y Quedemá. Estos fueron los hijos de Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Cetura, la concubina de Abrahán, dio a luz a Zimram, Jocsán, Medán, Madián, Isbac y Súaj.",
          "Los hijos de Jocsán fueron Sebá y Dedán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Los hijos de Madián fueron Efa, Efer, Janoc, Abidá y Eldá. Todos ellos fueron hijos de Cetura."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Esaú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Abrahán fue el padre de Isaac.",
          "Los hijos de Isaac fueron Esaú e Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Los hijos de Esaú fueron Elifaz, Reuel, Jeús, Jalán y Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Los hijos de Elifaz fueron Temán, Omar, Sefó, Gatán, Cenaz, Timna y Amalec."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Los hijos de Reuel fueron Najat, Zeraj, Samá y Miza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Los hijos de Seír fueron Lotán, Sobal, Sibón, Aná, Disón, Eser y Disán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Los hijos de Lotán fueron Jorí y Hemán. Timna fue hermana de Lotán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Los hijos de Sobal fueron Alván, Manajat, Ebal, Sefo y Onam.",
          "Los hijos de Sibón fueron Ayá y Aná."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Disón fue hijo de Aná.",
          "Los hijos de Disón fueron Amirán, Esbán, Itrán y Querán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Los hijos de Eser fueron Bilán, Zaván y Yacán.",
          "Los hijos de Disán fueron Uz y Arán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Estos son los reyes que reinaron en la tierra de Edom, antes de que los hijos de Israel tuvieran un rey:",
          "Bela hijo de Beor. El nombre de su ciudad fue Dinaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "A la muerte de Bela reinó en su lugar Jobab hijo de Zeraj, de Bosra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "A la muerte de Jobab reinó en su lugar Jusán, de la tierra de los temanitas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "A la muerte de Jusán reinó en su lugar Hadad hijo de Bedad, que derrotó a Madián en el campo de Moab. El nombre de su ciudad fue Avit."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "A la muerte de Hadad reinó en su lugar Samla de Masreca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "A la muerte de Samla reinó en su lugar Saúl de Rejobot, la ciudad que está junto al río Éufrates."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "A la muerte de Saúl reinó en su lugar Baal Janán hijo de Acbor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "A la muerte de Baal Janán reinó en su lugar Hadad. El nombre de su ciudad fue Pay, y el nombre de su mujer fue Mehitabel hija de Matred, hija de Mezab."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "A la muerte de Hadad, los jefes de Edom fueron Timna, Alva, Jetet,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Aholibama, Elá, Pinón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Cenaz, Temán, Mibsar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Magdiel e Iram. Estos fueron los jefes de Edom."
        ],
        "rlw_lines": []
      }
    ]
  },
