    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pasado y presente de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Masquil de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios nuestro, lo oímos con nuestros oídos,",
          "y nuestros padres nos lo contaron:",
          "¡las grandes proezas que, en su favor,",
          "realizaste en los días de antaño!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Tú mismo desalojaste a las naciones,",
          "castigaste duramente a esos pueblos,",
          "y a nuestros padres los dejaste echar raíces!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque no fue la espada",
          "lo que les dio posesión de la tierra;",
          "ni fue tampoco su brazo lo que les dio la victoria;",
          "¡fue tu mano derecha, fue tu brazo,",
          "fue el resplandor de tu rostro,",
          "porque en ellos te complacías!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dios mío, ¡tú eres mi rey!",
          "¡Envía tu salvación al pueblo de Jacob!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Por ti derrotaremos a nuestros enemigos!",
          "¡En tu nombre los hundiremos en el suelo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Yo no confiaría en mis flechas,",
          "ni tampoco mi espada podría salvarme;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "pero tú puedes salvarnos de nuestros enemigos,",
          "y poner en vergüenza a los que nos odian."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡En ti, Dios nuestro, nos gloriaremos siempre,",
          "y nunca dejaremos de alabar tu nombre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pero nos has abandonado,",
          "nos has puesto en vergüenza.",
          "Ya no acompañas a nuestros ejércitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Nos has hecho retroceder ante el enemigo,",
          "y los que nos aborrecen nos despojan de todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Has dejado que nos maten como a ovejas,",
          "y nos has esparcido entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡Has vendido a tu pueblo de balde!",
          "¡Nada has ganado con venderlo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Nos has humillado ante nuestros vecinos;",
          "somos motivo de burla para los que nos rodean."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Has hecho de nosotros la burla de la gente;",
          "al vernos, todos mueven burlones la cabeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Todo el tiempo debo encarar mi vergüenza;",
          "me abruma no poder dar la cara"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "por lo que dicen los que tanto me ofenden,",
          "¡por lo que hacen mis vengativos enemigos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Aunque todo esto nos ha sucedido,",
          "jamás nos hemos olvidado de ti;",
          "jamás hemos quebrantado tu pacto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Jamás ha decaído nuestro ánimo,",
          "ni nos hemos apartado de tus sendas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Pero tú nos arrojaste en cuevas de chacales!",
          "¡Nos cubriste con las sombras de la muerte!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Dios nuestro,",
          "si nos hubiéramos olvidado de tu nombre,",
          "o si hubiéramos rendido culto a otro dios,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¿acaso tú no habrías llegado a saberlo?",
          "¡Si tú conoces los secretos más recónditos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Pero por ti nos matan todo el tiempo;",
          "¡nos consideran ovejas para el matadero!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¡Despierta, Señor! ¿Por qué duermes?",
          "¡Levántate, no te alejes para siempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¿Por qué te escondes de nosotros?",
          "¿Por qué te olvidas de la opresión que sufrimos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Nuestro ánimo se halla por el suelo,",
          "¡nuestros cuerpos se arrastran por la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡Levántate, ven a ayudarnos",
          "y, por tu gran misericordia, sálvanos!"
        ],
        "rlw_lines": []
      }
    ]
  },
