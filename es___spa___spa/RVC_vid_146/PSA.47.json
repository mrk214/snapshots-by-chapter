    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios, el Rey de toda la tierra"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Pueblos todos, ¡agiten las manos!",
          "¡Aclamen a Dios con voces de júbilo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El Señor, el Altísimo, es en verdad temible;",
          "¡es el gran Rey de toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El Señor humillará bajo nosotros a los pueblos;",
          "pondrá a las naciones bajo nuestros pies."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Escogió para nosotros la tierra que habitamos;",
          "¡es el orgullo de Jacob, a quien amó!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios, el Señor, se ha entronizado",
          "entre aclamaciones y sonido de trompetas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Cantemos salmos a nuestro Dios!",
          "¡Cantemos salmos a nuestro Rey!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Cantémosle un salmo digno de él,",
          "porque Dios es el Rey de toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Dios reina ya sobre las naciones!",
          "¡Dios ocupa ya su santo trono!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los príncipes de los pueblos se reúnen",
          "con el pueblo del Dios de Abrahán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Dios merece ser grandemente exaltado,",
          "porque de él son los poderes de la tierra!"
        ],
        "rlw_lines": []
      }
    ]
  },
