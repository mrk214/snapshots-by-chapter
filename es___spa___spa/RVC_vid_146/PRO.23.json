  "book": {
    "book_usfm": "PRO",
    "name": "Proverbios"
  },
  "chapter": {
    "usfm": "PRO.23",
    "human": "Proverbios 23",
    "previous": {
      "usfm": "PRO.22",
      "human": "Proverbios 22"
    },
    "next": {
      "usfm": "PRO.24",
      "human": "Proverbios 24"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cuando te sientes a la mesa de un gran señor,",
          "piensa bien en presencia de quién estás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ponte un cuchillo en la garganta",
          "y refrena en lo posible tu apetito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No quieras llenarte con sus deliciosos platillos,",
          "porque son un pan engañoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No te entusiasmes por hacerte rico;",
          "usa tu buen juicio, y desiste de esa idea."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Apenas logras poner los ojos en las riquezas,",
          "cuando estas ya han desaparecido!",
          "¡Es como si les salieran alas, alas de águila,",
          "y desaparecen volando por el cielo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No compartas la mesa con el avaro;",
          "no quieras llenarte con sus deliciosos platillos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "porque en su interior sigue siendo avaro.",
          "Te invitará a comer y beber,",
          "pero no te invitará de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Después vomitarás lo que hayas comido,",
          "y habrás desperdiciado tus halagos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No trates de hacerte oír por un necio,",
          "porque este no apreciará tus sabias razones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No traspases los linderos de antaño",
          "ni invadas la propiedad de los huérfanos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "ellos cuentan con un poderoso defensor,",
          "que saldrá en su defensa y contra ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Abre tu corazón a la enseñanza,",
          "y tus oídos a las palabras del saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "No dejes de corregir al joven,",
          "que no va a morirse si lo castigas con vara."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Al contrario, castígalo con vara",
          "y lo librarás de caer en el sepulcro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Hijo mío, si en tu corazón eres sabio,",
          "eso alegrará también mi corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "En mi interior sentiré gran alegría",
          "cuando con tus labios digas lo que es justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No abrigues en ti envidia por los pecadores,",
          "sino manténte siempre en el temor del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Lo cierto es que hay un futuro,",
          "y tu esperanza no se verá frustrada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Hijo mío, escúchame y adquiere sabiduría.",
          "Deja que tu corazón enderece el rumbo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No te juntes con los que se hartan de vino",
          "ni con los que se atiborran de carne,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "porque unos y otros se quedarán pobres,",
          "y por indolentes acabarán cubiertos de harapos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Escucha al padre que te dio la vida,",
          "y no menosprecies a tu anciana madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "La verdad y la sabiduría,",
          "la enseñanza y la inteligencia,",
          "son algo que debes comprar y nunca vender."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "El padre del justo siente gran alegría;",
          "el que engendra un hijo sabio se regocija."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "¡Haz que tu padre y tu madre se alegren!",
          "¡Haz que se regocije la madre que te dio a luz!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Hijo mío, entrégame tu corazón,",
          "y no apartes la mirada de mis caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Porque la ramera es un abismo profundo;",
          "la mujer ajena es un pozo estrecho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Siempre está al acecho, como los ladrones,",
          "y hace que el pecado aumente entre los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¿Quién se queja? ¿Quién se duele?",
          "¿Quién se ve envuelto en pleitos?",
          "¿Quién sufre? ¿Quién es herido sin razón?",
          "¿Quién anda con los ojos morados?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "¡El que se pasa el tiempo tomando vino!",
          "¡El que anda en busca de bebidas mezcladas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "No dejes que te atraiga lo rojo del vino;",
          "¡que no te deslumbre su brillo en la copa!",
          "Suavemente se desliza por la garganta,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "pero al final muerde como serpiente;",
          "¡causa más dolor que una víbora!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Hará que tus ojos vean cosas extrañas,",
          "y que tu corazón diga cosas perversas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Creerás estar dormido en medio del mar,",
          "o acostado en la punta del palo mayor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "y dirás: «Estoy herido, pero no me duele;",
          "estoy molido, pero no lo siento.",
          "¿Cuándo voy a despertar, para ir por más?»"
        ],
        "rlw_lines": []
      }
    ]
  },
