    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Grito de angustia y canto de alabanza"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Ajelet-sahar. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios mío, Dios mío, ¿por qué me has abandonado?",
          "¿Por qué estás tan lejos, y no vienes a salvarme?",
          "¿Por qué no atiendes mi clamor?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Dios mío, te llamo de día, y no me respondes;",
          "te llamo de noche, y no hallo reposo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tú eres santo, tú eres rey;",
          "tú eres alabado por Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Nuestros padres confiaron en ti;",
          "en ti confiaron, y tú los libraste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A ti clamaron, y fueron librados;",
          "en ti confiaron, y no quedaron en vergüenza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pero yo soy más gusano que hombre;",
          "¡un ser despreciable del que todos se burlan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Los que me ven, se burlan de mí;",
          "me hacen muecas, sacuden la cabeza, y dicen:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "«Este puso su confianza en el Señor,",
          "¡pues que el Señor lo salve!",
          "¡Que venga el Señor a librarlo,",
          "ya que en él se complacía!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pero eres tú quien me dio la vida,",
          "eres tú quien me infundió confianza",
          "desde que era un niño de pecho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Antes de nacer fui puesto a tu cuidado;",
          "aún estaba yo en el vientre de mi madre,",
          "y tú eras ya mi Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "No te apartes de mí, que me cerca la angustia",
          "y nadie viene en mi ayuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mucha gente poderosa me rodea;",
          "son fuertes como toros de Basán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Como leones feroces y rugientes,",
          "abren sus fauces, dispuestos a atacarme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Me voy diluyendo, como el agua;",
          "tengo todos los huesos dislocados.",
          "El corazón, dentro del pecho,",
          "se me derrite como la cera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Tengo seca, muy seca, la garganta;",
          "la lengua se me pega al paladar;",
          "¡me has lanzado al polvo de la muerte!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Me ha cercado una banda de malvados;",
          "¡me tienen rodeado, como perros!",
          "¡Han taladrado mis manos y mis pies!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Puedo contarme todos los huesos,",
          "mientras ellos se regodean al verme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Echan a la suerte mis vestidos",
          "y se los reparten por sorteo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pero tú, Señor, ¡no te alejes!",
          "Tú eres mi fuerza, ¡ven pronto en mi ayuda!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Rescata de la espada y de esos perros",
          "la única vida que tengo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Sálvame de las fauces de esos leones!",
          "¡Líbrame de los cuernos de esos búfalos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Anunciaré tu nombre a mis hermanos;",
          "te alabaré en medio de la comunidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ustedes, los que temen al Señor, ¡alábenlo!",
          "Descendientes de Jacob, ¡denle gloria!",
          "Hijos todos de Israel, ¡adórenlo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "El Señor no rechaza al afligido,",
          "no desprecia a los que sufren,",
          "ni esconde de ellos su rostro;",
          "cuando a él claman, les responde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Yo lo alabaré en medio de la comunidad,",
          "y ante los que le temen cumpliré mis promesas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Los pobres comerán, y quedarán satisfechos;",
          "los que buscan al Señor lo alabarán,",
          "y tendrán una larga vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Todos los rincones de la tierra",
          "invocarán al Señor, y a él se volverán;",
          "¡ante él se inclinarán todas las naciones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "El reinado es del Señor,",
          "y él gobierna a todas las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Todos los poderosos de la tierra lo adorarán;",
          "todos los mortales le rendirán pleitesía,",
          "todos los que no tienen vida propia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Las generaciones futuras le servirán,",
          "y hablarán del Señor a la generación venidera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Se dirá a los que aún no han nacido",
          "que el Señor es justo en todo lo que hace."
        ],
        "rlw_lines": []
      }
    ]
  },
