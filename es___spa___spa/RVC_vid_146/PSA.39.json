    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pasamos como una sombra"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. A Jedutún. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Decidí prestar atención a mis caminos",
          "para no incurrir en pecado con mi lengua;",
          "decidí refrenar mis palabras",
          "mientras tuviera un malvado cerca de mí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Y guardé un profundo silencio;",
          "ni siquiera hablaba de lo bueno.",
          "Y mi dolor se agravó."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "En mi interior, mi corazón se enardeció;",
          "al pensar en esto, estalló mi enojo",
          "y no pude menos que decir:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«Señor, hazme saber qué fin tendré,",
          "y cuánto tiempo me queda de vida.",
          "¡Quiero saber cuán frágil soy!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tú me has dado una vida muy corta;",
          "ante ti, mis años de vida no son nada.",
          "¡Ay, un simple soplo somos los mortales!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Ay, todos pasamos como una sombra!",
          "¡Ay, de nada nos sirve tratar de enriquecernos,",
          "pues nadie sabe para quién trabaja!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Señor, ¿qué puedo esperar,",
          "si en ti he puesto mi esperanza?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Líbrame de todos mis pecados!",
          "¡No permitas que los necios se burlen de mí!»"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Y volví a guardar silencio. No abrí la boca,",
          "porque tú eres quien actúa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Deja ya de hostilizarme,",
          "pues tus golpes están acabando conmigo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tú nos corriges al castigar nuestros pecados,",
          "pero destruyes, como polilla, lo que más amamos.",
          "¡Ay, solo un soplo somos los mortales!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Señor, ¡escucha mi oración!",
          "¡Atiende a mi clamor!",
          "¡No guardes silencio ante mis lágrimas!",
          "Ciertamente, para ti soy un extraño;",
          "soy un advenedizo, como mis antepasados,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "pero déjame recobrar las fuerzas",
          "antes de que parta y deje de existir."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
