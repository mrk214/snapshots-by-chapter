    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bondad de Dios y perversidad de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Gitit. Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantemos con gozo a Dios, nuestra fortaleza;",
          "aclamemos con júbilo al Dios de Jacob."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Entonemos cánticos, al son del pandero,",
          "de la melodiosa arpa y del salterio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Toquemos la trompeta en el novilunio,",
          "en el día señalado para nuestra fiesta solemne."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Esto es un estatuto para Israel;",
          "es una ordenanza del Dios de Jacob,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "que la constituyó como testimonio para José",
          "cuando salió contra la tierra de Egipto.",
          "Oí un lenguaje que no pude entender:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "«Liberé tu hombro de llevar pesada carga;",
          "tus manos dejaron de cargar los cestos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En tu angustia clamaste a mí, y yo te salvé;",
          "desde el centro del trueno te respondí,",
          "y junto a las aguas de Meriba te puse a prueba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»Escúchame, pueblo mío, que quiero amonestarte.",
          "¡Cómo quisiera yo, Israel, que me escucharas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No debes tener ningún dios ajeno.",
          "No debes inclinarte ante dioses extraños."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Yo soy el Señor, tu Dios;",
          "yo te saqué de la tierra de Egipto.",
          "Abre la boca, y yo te daré de comer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "»Pero tú, mi pueblo, no escuchaste mi voz;",
          "tú, Israel, no quisiste obedecerme,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "y por tu obstinación te abandoné",
          "para que siguieras tus propios consejos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Ay, pueblo mío! ¡Si me hubieras escuchado!",
          "¡Ay, Israel! ¡Si hubieras seguido mis caminos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡En un instante habría derrotado a tus enemigos,",
          "y habría descargado mi mano sobre tus adversarios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Los que me aborrecen se me habrían sometido,",
          "y yo, el Señor, pondría para siempre fin a sus días."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pero a ti te alimentaría con lo mejor del trigo,",
          "y apagaría tu sed con miel extraída de la peña.»"
        ],
        "rlw_lines": []
      }
    ]
  },
