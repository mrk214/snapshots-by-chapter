    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Alabanza por el retorno del cautiverio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Aleluya!",
          "¡Cuán bueno es cantar salmos a nuestro Dios!",
          "¡Cuán grato y hermoso es alabarlo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "El Señor reconstruye a Jerusalén,",
          "y hace volver a los israelitas desterrados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "El Señor reanima a los descorazonados,",
          "y sana sus heridas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El Señor creó todas la estrellas del cielo,",
          "y a cada una le puso nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Nuestro Señor es grande y poderoso,",
          "y su sabiduría no tiene límite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El Señor exalta a los humildes,",
          "y humilla hasta el polvo a los malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Cantemos alabanzas al Señor!",
          "¡Cantemos salmos a nuestro Dios al son del arpa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El Señor cubre de nubes los cielos,",
          "y hace que llueva sobre la tierra;",
          "el Señor hace crecer la hierba de los montes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "da de comer a los ganados,",
          "y también a los polluelos de los cuervos, cuando piden."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El Señor no se deleita en los caballos briosos,",
          "ni se complace en la agilidad de los jinetes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "el Señor se complace en los que le honran,",
          "y en los que confían en su misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Jerusalén, ¡alaba al Señor!",
          "Sión, ¡alaba a tu Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "El Señor refuerza los cerrojos de tus puertas,",
          "y bendice a los que habitan dentro de tus muros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El Señor mantiene en paz tus fronteras,",
          "y te sacia con lo mejor del trigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El Señor envía su palabra a la tierra,",
          "y sus órdenes se cumplen de inmediato."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Cae la nieve como copos de lana,",
          "y la escarcha se esparce como ceniza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Deja caer las piedrecillas de granizo;",
          "y a causa del frío todo se congela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero da otra orden, y el hielo se derrite;",
          "sopla el viento, y las aguas vuelven a correr."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El Señor comunicó a Jacob, que es Israel,",
          "sus estatutos y sus sentencias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No hizo lo mismo con ninguna otra nación;",
          "nadie más conoció sus mandamientos.",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
