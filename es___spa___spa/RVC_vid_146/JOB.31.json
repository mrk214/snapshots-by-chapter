  "book": {
    "book_usfm": "JOB",
    "name": "Job"
  },
  "chapter": {
    "usfm": "JOB.31",
    "human": "Job 31",
    "previous": {
      "usfm": "JOB.30",
      "human": "Job 30"
    },
    "next": {
      "usfm": "JOB.32",
      "human": "Job 32"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»Hice un compromiso con mis ojos",
          "de no poner la mirada en ninguna doncella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Cómo podría Dios premiarme por eso?",
          "¿Qué me daría el Todopoderoso en las alturas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Acaso él no castiga a los malvados?",
          "¿Acaso no hay dolor para los malhechores?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Acaso Dios no vigila mis pasos",
          "y se fija en todo lo que hago?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Si acaso me he conducido con mentira,",
          "o me he apresurado a engañar a todo el mundo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "que Dios me pese en su balanza,",
          "para que compruebe que soy inocente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Si acaso me he apartado del camino,",
          "y permití que mis ojos guiaran mis sentidos;",
          "o dejé que mis manos tomaran algo ajeno,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡que otro coseche lo que yo siembre,",
          "y que mis siembras sean desarraigadas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "»Si me dejé seducir por la mujer ajena,",
          "y esperé a que mi prójimo saliera de su casa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡que mi esposa cocine para otro,",
          "y que otros hombres la posean!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Esos actos son malvados, son inicuos,",
          "y deben ser castigados por los jueces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Son un fuego que consume hasta el sepulcro,",
          "y que acabaría con todas mis posesiones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Si no hubiera atendido a mi siervo y a mi sierva",
          "cuando me reclamaban que les hiciera justicia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¿con qué cara podría presentarme ante Dios,",
          "y responderle cuando me preguntara por ellos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡El mismo Dios nos dio vida en el vientre!",
          "¡A ellos y a mí nos dio forma en la matriz!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "»¿Acaso impedí la felicidad del pobre,",
          "o dejé que las viudas desfallecieran de hambre?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¿Acaso me aparté para comer a solas,",
          "para no compartir mi pan con los huérfanos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¡Más bien, para los huérfanos fui un padre,",
          "y protegí a las viudas como a mi propia madre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "»¿Acaso vi a alguien totalmente desnudo,",
          "y dejé al pobre sin un abrigo con qué cubrirse?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Más bien, me bendijo de todo corazón",
          "cuando entró en calor con mis vestidos de lana!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»Jamás alcé mi mano contra el huérfano,",
          "cuando estuvo en mi mano impartir justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¡Que se me zafen los brazos si miento!",
          "¡Que se me rompan los huesos del brazo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¡Siempre he sido temeroso de Dios!",
          "¡Ante su gran poder, nada puedo hacer!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "»Jamás puse mi esperanza en las riquezas,",
          "ni deposité en el oro toda mi confianza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Jamás me alegré de que mis posesiones",
          "aumentaran por el buen trabajo de mis manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Jamás disfruté del sol radiante,",
          "ni de las bellas noches de luna,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "con la idea de adorarlos en secreto",
          "y de enviarles un beso con la mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "¡Eso hubiera sido un gran pecado,",
          "pues habría pecado contra el Dios altísimo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Jamás me alegré al ver caer a mi enemigo,",
          "ni me regocijé cuando le sobrevino el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Jamás le pedí a Dios maldecir a alguno;",
          "para no pecar, prefería quedarme callado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Jamás permití que mis siervos",
          "abusaran de alguno de mis huéspedes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Jamás un extranjero que llamó a mi puerta",
          "pasó la noche fuera de mi casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "»Si acaso como humano encubrí mis faltas,",
          "si guardé el secreto de mi maldad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "fue por temor al desprecio de los nobles",
          "y a lo que el pueblo pensara de mí;",
          "pero guardé silencio y no salí de mi casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "»¡Cómo quisiera que alguien me escuchara!",
          "Aunque mi enemigo me someta a juicio,",
          "confío en que el Todopoderoso hablará por mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Con mucho gusto aceptaré su juicio;",
          "con mucho gusto lo portaré como corona."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Le daré cuenta de todas mis acciones,",
          "y me presentaré ante él, orgulloso como un príncipe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "»Si mis tierras hablan contra mí,",
          "y lloran de dolor por lo que les hice;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "si saqué provecho de ellas, sin retribución,",
          "o me aproveché de la bondad de sus dueños,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "¡que en lugar de trigo me rindan abrojos!",
          "¡Que me den espinos en lugar de cebada!»",
          "Aquí terminan los discursos de Job."
        ],
        "rlw_lines": []
      }
    ]
  },
