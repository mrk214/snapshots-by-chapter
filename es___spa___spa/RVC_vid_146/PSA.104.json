    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios cuida de su creación"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Bendice, alma mía, al Señor!",
          "¡Cuán grande eres, Señor mi Dios!",
          "¡Estás rodeado de gloria y de esplendor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Te has revestido de luz, como de una vestidura!",
          "¡Extiendes los cielos como una cortina!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Dispones tus mansiones sobre las aguas!",
          "¡Las nubes son tu lujoso carruaje,",
          "y te transportas sobre las alas del viento!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Los vientos son tus mensajeros!",
          "¡Las llamas de fuego están a tu servicio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tú afirmaste la tierra sobre sus cimientos,",
          "y de allí nada la moverá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Con las aguas del abismo la cubriste!",
          "Las aguas se detuvieron sobre los montes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "pero las reprendiste, y huyeron;",
          "al escuchar tu voz, bajaron presurosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Subieron a los montes, bajaron por los valles,",
          "al sitio que les habías destinado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Les pusiste un límite, que no debían cruzar,",
          "para que no volvieran a cubrir la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tú llenas las fuentes con los arroyos",
          "que corren ligeros entre los montes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "allí apagan su sed los animales salvajes;",
          "allí los asnos monteses mitigan su sed."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "En sus riberas anidan las aves del cielo,",
          "y entre las ramas se escuchan sus trinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Desde las alturas riegas los montes,",
          "y la tierra se sacia con el fruto de tus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Haces crecer la hierba para los ganados,",
          "y las plantas que el hombre cultiva",
          "para sacar de la tierra el pan que come"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "y el vino que le alegra el corazón,",
          "el aceite que da brillo a su rostro,",
          "y el pan que sustenta su vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Se llenan de savia los árboles del Señor,",
          "los cedros del Líbano que él mismo plantó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "En sus ramas anidan las aves;",
          "en las hayas hacen su nido las cigüeñas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "en las altas montañas retozan las cabras monteses;",
          "en las peñas se resguardan los damanes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Tú hiciste la luna para medir los tiempos;",
          "el sol sabe cuándo debe ocultarse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Dejas caer las sombras, y anochece;",
          "y entonces corretean los animales salvajes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Rugen los leones que van tras su presa,",
          "y reclaman la comida que Dios les provee."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Cuando sale el sol, corren a sus cuevas",
          "y satisfechos se tienden a descansar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Sale entonces el hombre a sus labores,",
          "y trabaja hasta que cae la noche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¡Tus obras, Señor, son innumerables!",
          "¡Todas las hiciste con gran sabiduría!",
          "¡La tierra está llena de tus criaturas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "¡Vean el vasto mar! ¡Contemplen su grandeza!",
          "En él se mueven incontables seres vivos,",
          "lo mismo grandes que pequeños."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Allí navegan las grandes naves;",
          "allí está Leviatán, que creaste para jugar con él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Todos los seres esperan de ti",
          "que a su tiempo les des de comer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Si abres tu mano y les das su pan,",
          "ellos lo toman y quedan satisfechos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Si te escondes de ellos, se desconciertan;",
          "si les retiras su espíritu, mueren y vuelven al polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Pero si envías tu espíritu, vuelven a la vida,",
          "y así renuevas la faz de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "¡Sea tu gloria eterna, Señor!",
          "¡Que te regocijen las obras que has hecho!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Si miras la tierra, esta tiembla;",
          "si tocas los montes, estos echan humo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Señor, ¡toda mi vida te cantaré!",
          "Dios mío, ¡yo te cantaré salmos mientras viva!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Señor, dígnate agradarte de mis pensamientos,",
          "pues yo hallo en ti mi alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Que sean borrados de la tierra los malvados;",
          "¡que dejen de existir los malhechores!",
          "¡Bendice, alma mía, al Señor!",
          "¡Aleluya!"
        ],
        "rlw_lines": []
      }
    ]
  },
