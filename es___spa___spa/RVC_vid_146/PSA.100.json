      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Invitación a la gratitud"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de alabanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Canten alegres al Señor,",
          "habitantes de toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Sirvan al Señor con alegría!",
          "¡Vengan a su presencia con regocijo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Reconozcan que el Señor es Dios;",
          "él nos hizo, y de él somos.",
          "Somos su pueblo. ¡Somos las ovejas de su prado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Entremos por sus puertas y por sus atrios",
          "con alabanzas y con acción de gracias;",
          "¡alabémosle, bendigamos su nombre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡El Señor es bueno!",
          "¡Su misericordia es eterna!",
          "¡Su verdad permanece para siempre!"
        ],
        "rlw_lines": []
      }
    ]
