    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»¿Sabes tú cuándo paren las cabras del monte?",
          "¿Has visto acaso nacer a los cervatillos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Sabes cuántos meses dura su preñez,",
          "y cuándo los cervatos tienen que nacer?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Para que nazcan, la cierva se encorva,",
          "y en cuanto nace su cría se calma su dolor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Y los cervatos crecen, y se hacen fuertes,",
          "y se apartan de la madre para nunca volver."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»¿Quién ha criado libre al asno montés?",
          "¿Quién lo liberó de sus ataduras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Fui yo quien lo hizo habitar en la soledad,",
          "quien le dio el páramo por hábitat."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "La ciudad y sus tumultos le resultan divertidos;",
          "no sabe obedecer los gritos de los arrieros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Busca pastos en los altos montes,",
          "y hace de toda hierba su alimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "»¿Y acaso el búfalo querrá servirte?",
          "¿Se quedará tranquilo en tu pesebre?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Podrás ponerle un yugo para trabajar la tierra?",
          "¿Hará surcos en el valle porque se lo mandas tú?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Podrás confiar en su gran fuerza?",
          "¿Crees que puedes confiarle tus labores?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Podrás encargarle que recoja tu semilla,",
          "y que la amontone en tu granero?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»El avestruz agita su bello plumaje,",
          "que no es tan bello como el del pavo real."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pone huevos, y luego los abandona,",
          "y los deja calentar bajo el polvo de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "No le importa que alguien los aplaste,",
          "ni que las bestias del campo los destrocen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Es cruel con sus polluelos, como si no fueran suyos,",
          "no piensa que su trabajo pudo haber sido en vano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Y es que yo no lo doté de sabiduría;",
          "tampoco lo doté de gran inteligencia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¡pero en cuanto emprende la carrera",
          "se burla del caballo y de su jinete!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "»¿Acaso tú dotaste al caballo de su fuerza?",
          "¿Cubriste acaso su cuello de ondulantes crines?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Puedes asustarlo, como si fuera una langosta?",
          "¡Si un resoplido suyo asusta a cualquiera!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Tan fuerte es que escarba el suelo con sus cascos,",
          "y así se apresta a entrar en combate."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Nada le espanta, a nada le teme,",
          "ni se arredra ante la espada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Suenan a su lado las flechas en la aljaba,",
          "brillan las lanzas, chocan las jabalinas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "pero él, impetuoso, escarba la tierra,",
          "sin que le asusten los toques de trompeta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Más bien, el sonido del clarín lo excita,",
          "y a la distancia percibe los olores del combate,",
          "el griterío y las órdenes de ataque."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "»¿Acaso por órdenes tuyas vuela el gavilán,",
          "y tiende el vuelo para dirigirse al sur?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "¿Acaso por mandato tuyo se remonta el águila,",
          "y pone su nido en lo alto de las rocas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Su nido se halla en los altos montes,",
          "en la punta de los más altos peñascos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Con sus dos potentes ojos,",
          "desde lejos acecha a su presa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "y alimenta a sus polluelos con la sangre de su presa.",
          "“Donde hay un cadáver, hay un águila.”»"
        ],
        "rlw_lines": []
      }
    ]
  },
