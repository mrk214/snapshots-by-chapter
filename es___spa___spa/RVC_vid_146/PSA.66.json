    "name": "Salmos"
  },
  "chapter": {
    "usfm": "PSA.66",
    "human": "Salmos 66",
    "previous": {
      "usfm": "PSA.65",
      "human": "Salmos 65"
    },
    "next": {
      "usfm": "PSA.67",
