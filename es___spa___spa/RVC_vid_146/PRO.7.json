    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Artimañas de la mujer ajena"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hijo mío, obedece mis palabras,",
          "y guarda como un tesoro mis mandamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Obedece mis mandamientos y enseñanzas;",
          "cuídalos como las niñas de tus ojos, y vivirás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Átalos alrededor de tus dedos;",
          "anótalos en la pizarra de tu corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dile a la sabiduría: «¡Hermana mía!»",
          "Declárate pariente de la inteligencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ellas te protegerán de la mujer ajena,",
          "de esa extraña de melosas palabras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Un día estaba yo en la ventana de mi casa,",
          "y miraba a través de la celosía."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Observaba yo a los jóvenes incautos,",
          "y me llamó la atención uno de ellos,",
          "claramente falto de entendimiento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "que cruzó la calle, dobló la esquina,",
          "y se dirigió a la casa de esa mujer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Era tarde, y comenzaba a oscurecer;",
          "las sombras de la noche comenzaban a caer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "De pronto, esa mujer salió a su encuentro,",
          "vestida como ramera y con claras intenciones:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Era provocativa y desafiante,",
          "de esas que no pueden poner un pie en su casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Unas veces en la calle, otras veces en las plazas,",
          "y en constante acecho en las esquinas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Se prendió de él, le dio un beso,",
          "y descaradamente le propuso:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "«Yo había prometido sacrificios de paz,",
          "y hoy he cumplido con mis votos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Por eso he salido a tu encuentro!",
          "¡Ansiaba verte, y he dado contigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mi lecho lo he cubierto con finas colchas,",
          "colchas recamadas con hilo egipcio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Mi alcoba la he perfumado",
          "con mirra, áloes y canela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¡Ven, embriaguémonos de amores!",
          "¡Gocemos del amor hasta el amanecer!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Mi marido no está en casa,",
          "pues salió para hacer un largo viaje."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Se llevó la bolsa de dinero,",
          "y no volverá hasta el día señalado.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "La mujer lo venció con sus muchas lisonjas;",
          "lo persuadió con sus labios zalameros,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "y el joven se fue enseguida tras ella,",
          "como el buey que va al degolladero;",
          "como el necio que preso avanza al castigo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "hasta que una flecha le parte el corazón;",
          "como el ave que vuela presurosa hacia la red,",
          "sin saber que eso le costará la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Hijos, por favor, ¡escúchenme!",
          "¡Presten atención a mis declaraciones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "No inclines tu corazón hacia sus caminos;",
          "no pierdas el rumbo por sus atajos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Por su culpa, muchos han caído heridos;",
          "aun los más fuertes han muerto por causa de ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Su casa va camino al sepulcro,",
          "y desciende a las mansiones de la muerte."
        ],
        "rlw_lines": []
      }
    ]
  },
