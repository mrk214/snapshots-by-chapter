  "book": {
    "book_usfm": "JOB",
    "name": "Job"
  },
  "chapter": {
    "usfm": "JOB.37",
    "human": "Job 37",
    "previous": {
      "usfm": "JOB.36",
      "human": "Job 36"
    },
    "next": {
      "usfm": "JOB.38",
      "human": "Job 38"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»Al pensar en esto, mi corazón se acelera",
          "y parece querer salirse de mi pecho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Presten atención al estruendo de su voz,",
          "y al potente sonido que sale de su boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Oigan cómo retumba a través del cielo,",
          "y cómo su luz alumbra los confines de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tras su luz se oye un bramido",
          "que estalla con majestuoso furor;",
          "al escucharlo, nadie puede sostenerse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios deja oír su voz atronadora",
          "y hace grandes cosas que no logramos entender."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A la nieve le ordena caer sobre la tierra,",
          "y también a las lloviznas y a las lluvias torrenciales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "La gente corre entonces a esconderse,",
          "y así todo el mundo reconoce sus obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Las bestias del campo corren a sus cuevas,",
          "y allí en su refugio esperan con paciencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "»Desde el sur, viene el candente torbellino;",
          "desde el norte llega el viento frío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios sopla y forma bloques de hielo,",
          "y hace que las grandes aguas se congelen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Carga de humedad las densas nubes,",
          "y desde ellas manda sus rayos luminosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Revuelve las nubes de un lugar a otro,",
          "y las lleva por toda la faz de la tierra,",
          "para que cumplan con todos sus designios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Dios las usa para castigar al hombre,",
          "pero también para mostrar su amor por la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "»Tenme paciencia, Job, y escúchame;",
          "mira con atención las maravillas de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¿Sabes cómo Dios ordena las nubes,",
          "y hace que el relámpago brille entre ellas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¿Sabes por qué las nubes son diferentes,",
          "que son una maravilla de sabiduría perfecta?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¿O por qué tu ropa te acalora",
          "cuando Dios detiene el cálido viento del sur?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "¿Acaso lo ayudaste a extender los cielos,",
          "y los afirmaste como reluciente espejo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Enséñanos qué debemos decirle;",
          "nuestra oscura mente no nos permite ordenar las ideas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Debo anunciarme cuando quiera hablar con él?",
          "¿Quién se atreve a hablar para ser destruido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»No se puede ver de frente la luz del sol,",
          "cuando el cielo está limpio y sin nubes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Desde el norte vienen rayos dorados",
          "que anuncian la imponente majestad de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "No podemos comprender al Todopoderoso;",
          "grande es su poder, y grande es su justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Por eso los seres humanos le temen,",
          "aunque él no teme a los que se consideran sabios.»"
        ],
        "rlw_lines": []
      }
    ]
  },
