    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Exhortación a un rey"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palabras proféticas del rey Lemuel, que su madre le enseñó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Qué puedo decirte, hijo mío?",
          "¿Qué puedo decirte, hijo de mis entrañas?",
          "¿Qué puedo decirte, respuesta a mis oraciones?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que no entregues tu vigor a las mujeres,",
          "ni vayas por caminos que destruyen a los reyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Lemuel, hijo mío,",
          "no está bien que los reyes beban vino,",
          "ni que los príncipes beban sidra;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "no sea que por beber se olviden de la ley,",
          "y tuerzan el derecho de todos los afligidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sea la sidra para el que desfallece,",
          "y el vino para los de ánimo amargado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Que beban y se olviden de sus carencias!",
          "¡Que no se acuerden más de su miseria!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Habla en lugar de los que no pueden hablar;",
          "¡defiende a todos los desvalidos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Habla en su lugar, y hazles justicia;",
          "¡defiende a los pobres y menesterosos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Elogio a la esposa ejemplar"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mujer ejemplar, ¿quién dará con ella?",
          "Su valor excede al de las piedras preciosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Su esposo confía en ella de todo corazón,",
          "y por ella no carece de ganancias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Siempre lo trata bien, nunca mal,",
          "todos los días de su vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sale en busca de lana y de lino,",
          "y afanosa los trabaja con sus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Se asemeja a una nave de mercaderes,",
          "que de muy lejos trae sus provisiones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Aun durante la noche se levanta",
          "para dar de comer a su familia",
          "y asignar a las criadas sus deberes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pondera el valor de un terreno, y lo compra,",
          "y con lo que gana planta un viñedo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Saca fuerzas de flaqueza,",
          "y con ahínco se dispone a trabajar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Está atenta a la buena marcha de su negocio,",
          "y por la noche mantiene su lámpara encendida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Sabe cómo manejar el huso,",
          "y no le es ajeno manejar la rueca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Sabe ayudar a los pobres,",
          "y tender la mano a los menesterosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Cuando nieva, no teme por su familia,",
          "pues todos ellos visten ropas dobles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ella misma se hace tapices,",
          "y se viste de lino fino y de púrpura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Su esposo es bien conocido en la ciudad,",
          "y es parte del consejo local de ancianos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Las telas que hace, las vende,",
          "y provee a los comerciantes con cinturones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Se reviste de fuerza y de honra,",
          "y no le preocupa lo que pueda venir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Habla siempre con sabiduría,",
          "y su lengua se rige por la ley del amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Siempre atenta a la marcha de su hogar,",
          "nunca come un pan que no se haya ganado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Sus hijos se levantan y la llaman dichosa;",
          "también su esposo la congratula:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "«Muchas mujeres han hecho el bien,",
          "pero tú las sobrepasas a todas.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "La belleza es engañosa, y hueca la hermosura,",
          "pero la mujer que teme al Señor será alabada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "¡Reconózcase lo que ha hecho con sus manos!",
          "¡Sea alabada ante todos por sus logros!"
        ],
        "rlw_lines": []
      }
    ]
  },
