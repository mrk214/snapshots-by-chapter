    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Acción de gracias por la salvación"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Alabemos al Señor, porque él es bueno;",
          "porque su misericordia permanece para siempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Que lo diga ahora Israel:",
          "«¡Su misericordia permanece para siempre!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que lo digan los descendientes de Aarón:",
          "«¡Su misericordia permanece para siempre!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Que lo digan los temerosos del Señor:",
          "«¡Su misericordia permanece para siempre!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "En medio de la angustia clamé al Señor,",
          "y él me respondió y me dio libertad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El Señor está conmigo; no tengo miedo",
          "de lo que simples mortales me puedan hacer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "El Señor está conmigo y me brinda su ayuda;",
          "¡he de ver derrotados a los que me odian!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Es mejor confiar en el Señor",
          "que confiar en simples mortales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Es mejor confiar en el Señor",
          "que confiar en gente poderosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todas las naciones me han rodeado,",
          "pero en el nombre del Señor las venceré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Me han rodeado y me acosan,",
          "pero en el nombre del Señor las venceré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Zumban a mi alrededor, como abejas;",
          "crepitan como espinos que arden;",
          "pero en el nombre del Señor las venceré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Me empujan con violencia, para hacerme caer,",
          "pero el Señor me sostendrá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El Señor es mi fuerza, y a él dedico mi canto",
          "porque en él he hallado salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "En el campamento de los hombres justos",
          "se oyen gritos jubilosos de victoria:",
          "«¡La diestra del Señor hace grandes proezas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡La diestra del Señor se ha levantado!",
          "La diestra del Señor hace grandes proezas!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No voy a morir. Más bien, voy a vivir",
          "para dar a conocer las obras del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Aunque el Señor me castigó con dureza,",
          "no me entregó a la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "¡Ábranme las puertas donde habita la justicia!",
          "¡Quiero entrar por ellas para alabar al Señor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Ellas son las puertas que llevan al Señor,",
          "y por ellas entran quienes son justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Te alabo, Señor, porque me escuchas,",
          "y porque me das tu salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La piedra que los constructores rechazaron,",
          "ha llegado a ser la piedra angular."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Esto viene de parte del Señor,",
          "y al verlo nuestros ojos se quedan maravillados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Este es el día que el Señor ha hecho;",
          "y en él nos alegraremos y regocijaremos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Señor, ¡te ruego que vengas a salvarnos!",
          "¡Te ruego que nos concedas la victoria!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡Bendito el que viene en el nombre del Señor!",
          "Desde el templo del Señor los bendecimos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El Señor es Dios, y nos brinda su luz.",
          "¡Que comience la fiesta!",
          "¡Aten las ofrendas a los cuernos del altar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Tú eres mi Dios, y siempre te alabaré;",
          "siempre, Dios mío, exaltaré tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¡Alabemos al Señor, porque él es bueno;",
          "porque su misericordia permanece para siempre!"
        ],
        "rlw_lines": []
      }
    ]
  },
