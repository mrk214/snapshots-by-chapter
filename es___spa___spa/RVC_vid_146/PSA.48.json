    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La gloriosa hermosura de Sión"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Grande es el Señor, nuestro Dios!",
          "¡Digno es de grandes alabanzas",
          "en su ciudad, en su santo monte!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Hermosa colina es el monte Sión,",
          "situada al norte de la ciudad del gran Rey;",
          "¡es motivo de gozo en toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dentro de sus fortificaciones",
          "Dios es reconocido como un refugio seguro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Los reyes de la tierra se reunieron",
          "y juntos avanzaron contra la ciudad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "pero al verla quedaron perplejos,",
          "y desconcertados, huyeron presurosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Allí mismo les sobrevino gran temblor;",
          "¡se retorcían de dolor, como parturientas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Y es que tú, con el viento solano,",
          "destrozaste las naves de Tarsis!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Lo que antes oímos, ahora lo hemos visto",
          "en la ciudad de nuestro Dios,",
          "en la ciudad del Señor de los ejércitos:",
          "¡Dios afirmará su ciudad para siempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dios nuestro, dentro de tu templo",
          "nos acordamos de tu misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios nuestro, tu nombre es digno de loor",
          "hasta los confines de la tierra;",
          "con tu diestra prodigas justicia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "por tus juicios se alegra el monte Sión",
          "y se regocijan las ciudades de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Recorran los alrededores de Sión;",
          "paseen por ella y cuenten sus torres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Observen con atención sus murallas;",
          "fíjense en sus fortificaciones,",
          "para que puedan decir a los que están por nacer:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "«¡Este es nuestro Dios, ahora y para siempre!",
          "¡El Dios nuestro nos guiará más allá de la muerte!»"
        ],
        "rlw_lines": []
      }
    ]
  },
