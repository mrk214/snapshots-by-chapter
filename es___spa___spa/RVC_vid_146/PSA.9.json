    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Acción de gracias por la justicia de Dios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Mut Labén. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, te alabaré de todo corazón",
          "y hablaré de todos tus portentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Por ti me alegraré, oh Dios altísimo,",
          "y cantaré alabanzas a tu nombre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ante ti, mis enemigos huyen;",
          "ruedan por el suelo y perecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tú eres un juez justo, y desde tu trono",
          "defiendes mi causa y me haces justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sometes a las naciones, destruyes a los malvados,",
          "y borras para siempre su memoria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mis adversarios se han desvanecido;",
          "han quedado destruidos para siempre.",
          "Con ellos se borró el recuerdo",
          "de las ciudades que tú destruiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pero tú, Señor, permaneces para siempre,",
          "y tienes preparado tu tribunal de justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Con justicia juzgarás al mundo;",
          "con rectitud juzgarás a las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tú, Señor, eres el refugio de los pobres;",
          "eres su amparo en momentos de angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "En ti confían los que conocen tu nombre,",
          "porque tú, Señor, proteges a los que te buscan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Canten al Señor, que vive en Sión!",
          "¡Proclamen entre los pueblos sus acciones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El Dios vengador se acordó de ellos;",
          "¡no olvidó el clamor de los afligidos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Señor, ¡ten misericordia de mí!",
          "¡Mira cómo me hacen sufrir mis enemigos!",
          "Tú me libras de las puertas de la muerte,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "para que a las puertas de Sión",
          "proclame tus alabanzas y goce de tu salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Las naciones cayeron en el hoyo que cavaron;",
          "¡quedaron atrapadas en su propia trampa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "El Señor se ha revelado al hacer justicia;",
          "los malvados se enredan con sus propios hechos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Esos malvados serán llevados al sepulcro,",
          "con todos los que se olvidan de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Porque no siempre serán olvidados los pobres,",
          "ni todo el tiempo se desvanecerá su esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Señor, ¡levántate y juzga a las naciones!",
          "¡No dejes que el ser humano se envanezca!",
          "¡Haz que las naciones comparezcan ante ti!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Infúndeles, Señor, temor de ti!",
          "¡Que sepan las naciones que solo son seres humanos!"
        ],
        "rlw_lines": []
      }
    ]
  },
