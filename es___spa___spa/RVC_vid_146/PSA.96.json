    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cántico de alabanza"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Canten al Señor un cántico nuevo!",
          "¡Canten al Señor todos en la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Canten al Señor! ¡Bendigan su nombre!",
          "¡Anuncien su salvación todos los días!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Proclamen su gloria entre las naciones,",
          "y sus maravillas entre todos los pueblos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El Señor es grande, y digno de alabanza;",
          "¡es temible, más que todos los dioses!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Todos los dioses de los pueblos son ídolos,",
          "pero el Señor es quien creó los cielos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "En su presencia hay alabanza y magnificencia;",
          "en su santuario hay poder y gloria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ustedes, familias de los pueblos,",
          "¡tributen al Señor la gloria y el poder!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Tributen al Señor la honra que merece su nombre!",
          "¡Traigan sus ofrendas, y vengan a sus atrios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Adoren al Señor en la hermosura de la santidad!",
          "¡Tiemblen ante él todos en la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Digan entre las naciones: «¡El Señor es rey!",
          "El Señor afirmó el mundo, y no será conmovido;",
          "el Señor juzga a los pueblos con justicia.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Que se alegren los cielos y se regocije la tierra!",
          "¡Que brame el mar y todo lo que contiene!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡Que se alegre el campo y todo lo que hay en él!",
          "¡Que todos los árboles del bosque rebosen de gozo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "delante del Señor, que ya viene!",
          "¡Sí, el Señor viene a juzgar la tierra!",
          "¡Juzgará al mundo con justicia,",
          "y a los pueblos con su verdad!"
        ],
        "rlw_lines": []
      }
    ]
  },
