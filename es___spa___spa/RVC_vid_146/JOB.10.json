    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»¡Estoy cansado de esta vida!",
          "Voy a dar rienda suelta a mi queja;",
          "voy a hablar con toda la amargura de mi alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Le diré a Dios: “No me condenes.",
          "Hazme saber qué tienes contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Acaso está bien que me oprimas,",
          "que desprecies esta creación de tus manos",
          "y te pongas de parte de los impíos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Acaso ves con ojos humanos,",
          "con los ojos de simples mortales?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Acaso tus días son como los nuestros,",
          "o vives tus años como un simple mortal?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿Para qué investigar mis faltas?",
          "¿Para qué rebuscar en mi maldad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»”Tú bien sabes que no soy un malvado,",
          "y que nadie puede librarme de tus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tú, con tus propias manos me formaste;",
          "¡me hiciste y me rehiciste!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Recuerda que fuiste tú quien me dio forma,",
          "¿y ahora deshaces ese barro que moldeaste?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Me batiste, como si batieras leche,",
          "y me hiciste cuajar, como queso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Me recubriste con carne y piel,",
          "y entretejiste mis huesos con mis nervios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Me diste vida y me llenaste de amor;",
          "con tus cuidados protegiste mi espíritu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»”Pero hay cosas que tu corazón se guarda,",
          "y que siempre tienes presentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tú me vigilas, y si acaso he pecado,",
          "no me declares limpio de mi maldad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Ay de mí, si hubiera pecado!",
          "¡Pero soy inocente, y no puedo dar la cara!",
          "¡Estoy cansado de verme deshonrado y afligido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Recurres a tus maravillas y me acechas como león;",
          "¡apenas levanto la cabeza, y tú me destruyes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Arremetes contra mí, como ejército impetuoso,",
          "¿pero qué pruebas tienes contra mí?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "»”¿Por qué me dejaste nacer?",
          "Si yo hubiera muerto, nadie me habría visto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Quisiera no haber existido nunca,",
          "y haber sido llevado del vientre a la sepultura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¿Acaso no tengo pocos días de vida?",
          "¡Pues déjame tranquilo! ¡Dame un poco de consuelo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "antes que me vaya para nunca volver!",
          "Me iré al reino de las sombras y la muerte,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "al reino de la más profunda oscuridad,",
          "donde la luz se parece a las tinieblas.”»"
        ],
        "rlw_lines": []
      }
    ]
  },
