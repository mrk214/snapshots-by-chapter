    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»¿Acaso puedes pescar a Leviatán con anzuelo?",
          "¿Puedes atarle la lengua con una simple cuerda?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Puedes atarle una soga en la nariz,",
          "y horadarle con ganchos la quijada?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Acaso crees que te pedirá clemencia,",
          "o que con palabras dulces te pedirá su libertad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Crees que se comprometerá contigo",
          "a ser tu siervo para siempre?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Podrás jugar con él, como con un ave,",
          "y ponerle un lazo para que se diviertan tus hijas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿Ofrecerás con él un banquete para tus amigos?",
          "¿Podrán los carniceros descuartizarlo y venderlo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¿Podrás cortar con cuchillo su dura piel?",
          "¿Podrás clavarle un arpón en la cabeza?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Haz el intento siquiera de tocarlo:",
          "¡será una batalla memorable, que nunca más repetirás!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "»En vano espera quien pretenda domarlo;",
          "de solo verlo cerca, el más valiente tiembla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No hay nadie tan osado que lo quiera despertar;",
          "entonces, ¿quién podría enfrentarse a mí?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Quién me ha dado algo, para que se lo devuelva?",
          "¡Mío es todo lo que hay debajo de los cielos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Aún me falta decir algo acerca de sus miembros,",
          "de su gran poder y de su elegante presencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Hay alguien capaz de hacerle frente?",
          "¿Alguien que se arme de valor y le coloque un freno?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¿Quién podrá abrirle esas potentes quijadas,",
          "sin que se espante al ver sus filosos colmillos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Está orgullosamente revestido de duros escudos,",
          "cuyo cerrado tejido resguarda su cuerpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tan estrechamente unidos están unos con otros,",
          "que ni el viento más fino los puede atravesar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Cada escudo se entrelaza con el otro;",
          "están trabados entre sí, y no se pueden separar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cuando esta bestia resopla, lanza fuego,",
          "y sus ojos brillan como la luz del amanecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "De su hocico brotan lenguas de fuego;",
          "¡chispas de lumbre salen disparadas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por su trompa lanza humo como chimenea,",
          "¡despide vapor como una olla en el fuego!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Con sus resoplidos prende fuego a los carbones,",
          "pues brama y lanza fuego por sus fauces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "La fuerza de su cuerpo está en su cuello;",
          "cuando ataca, cunde el miedo como polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Su piel parece blanda, pero es dura;",
          "es tan firme y resistente como el hierro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Su corazón es duro como una roca,",
          "rígido como una piedra de molino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Aún los más valientes se le enfrentan temerosos,",
          "y llenos de miedo se rinden ante él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Si alguno le da alcance, con la espada no lo hiere,",
          "ni con lanza ni flechas, ni su escudo lo protege."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El hierro es para él como la paja,",
          "y el bronce es como un tronco podrido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "No le espantan las flechas que sobre él caen,",
          "y las piedras lanzadas con honda le son como paja."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Para él, las armas son como hojas secas,",
          "y el silbido de la jabalina le resulta divertido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Su pecho está cubierto de agudas escamas,",
          "y al arrastrarse va abriendo surcos en el fango."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Si se lanza al mar, este hierve,",
          "y brotan candentes burbujas de agua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Tras de sí va dejando una brillante estela,",
          "¡cabellera de plata se torna la blanca espuma!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Nada en la tierra se le puede comparar;",
          "es un monstruo que a nada le teme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "A los poderosos los mira con desprecio;",
          "¡es el rey de todos los soberbios!»"
        ],
        "rlw_lines": []
      }
    ]
  },
