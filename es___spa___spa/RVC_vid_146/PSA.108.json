    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Disposición a la alabanza"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mi corazón está dispuesto, Dios mío;",
          "quiero cantar salmos en tu honor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Despierten, salterio y arpa,",
          "que voy a despertar al nuevo día!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Yo, Señor, te alabaré entre los pueblos;",
          "te cantaré salmos entre las naciones,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "pues tu bondad es más grande que los cielos;",
          "¡hasta las nubes llega tu verdad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tú, mi Dios, estás por encima de los cielos;",
          "¡tu gloria domina toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Sálvanos con tu diestra! ¡Respóndenos!",
          "¡Así se salvará tu pueblo amado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En su santuario, Dios ha sentenciado:",
          "«Con gran alegría fraccionaré Siquén,",
          "y dividiré en parcelas el valle de Sucot."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Galaad y Manasés me pertenecen,",
          "Efraín es un yelmo en mi cabeza,",
          "y Judá es un cetro en mi mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Moab es la vasija en que me lavo,",
          "sobre Edom arrojaré mis sandalias,",
          "y sobre Filistea proclamaré mi victoria.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Y quién me dará entrada en Edom?",
          "¿Quién me hará entrar en esa ciudad amurallada?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿No eres tú, mi Dios, quien nos ha desechado?",
          "¿No eres tú quien ya no sale con nuestros ejércitos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Bríndanos tu apoyo contra el enemigo,",
          "pues vana resulta la ayuda de los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Por ti, Dios nuestro, haremos proezas;",
          "¡tú harás morder el polvo a nuestros enemigos!"
        ],
        "rlw_lines": []
      }
    ]
  },
