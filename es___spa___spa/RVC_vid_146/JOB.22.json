    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tercera reprensión de Elifaz a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Pero Elifaz el temanita le respondió a Job:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¿En qué se beneficia Dios con el hombre,",
          "aun cuando este sea un hombre inteligente?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Se complace el Todopoderoso en tu inocencia,",
          "o gana algo con que vayas por el buen camino?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Acaso te castiga por tu piedad,",
          "y por eso te somete a juicio?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Demasiado grande es tu maldad!",
          "¡Tu pecado no tiene límites!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sin razón tomaste prenda de tus hermanos,",
          "y a los pobres los despojaste de sus ropas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "No le diste de beber al sediento,",
          "y al hambriento no le diste de comer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "En cambio, a los poderosos les diste tierras,",
          "y a los magnates les permitiste habitarlas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A las viudas las despediste con las manos vacías,",
          "y a los huérfanos los despojaste de todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por eso te ves enredado en esas trampas,",
          "y te asaltan temores repentinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Las tinieblas no te dejan ver,",
          "y las aguas profundas te abruman."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Pero Dios está en las alturas de los cielos;",
          "¡mira cuán altas se hallan las refulgentes estrellas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Y tú dices que Dios no sabe lo que haces,",
          "y que la densa oscuridad le impide juzgar?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¿Que no te puede ver porque las nubes lo rodean,",
          "y porque va y viene por la bóveda celeste?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¿Acaso quieres seguir por la antigua senda",
          "que han recorrido los malvados?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ellos fueron arrebatados antes de tiempo,",
          "porque sus fundamentos no eran firmes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Le pidieron a Dios que se apartara de ellos,",
          "sin que el Omnipotente les hubiera hecho daño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Más bien, Dios colmó sus casas de bienes.",
          "¡Lejos sea de mí el juntarme con ellos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Al verlos destruidos, los justos se alegrarán,",
          "y los inocentes se burlarán de ellos y dirán:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "“Nuestros enemigos han sido destruidos;",
          "el fuego ha consumido lo que de ellos quedaba.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»Reconcíliate con Dios, y recupera la paz;",
          "así él te devolverá la prosperidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Permítele que él mismo te instruya,",
          "y pon sus palabras en tu corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Si te vuelves a Dios, él te levantará;",
          "así alejarás de tu casa la aflicción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Si arrojas por el suelo tus riquezas,",
          "tendrás tanto oro de Ofir como piedras en el río."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "El Todopoderoso será tu defensor,",
          "y en tu casa abundará la plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Hallarás tu deleite en el Todopoderoso,",
          "y ante Dios podrás levantar la cara."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Cuando lo llames, él te escuchará,",
          "y tú podrás cumplirle tus promesas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Llevarás a buen término todos tus planes,",
          "y en tus caminos brillará la luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "A los humildes, Dios los exalta;",
          "a los abatidos, Dios les da su salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Dios libera al que es inocente,",
          "y si eres inocente, también serás liberado.»"
        ],
        "rlw_lines": []
      }
    ]
  },
