    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ventajas de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Hijos, escuchen las enseñanzas de su padre;",
          "presten atención, y adquirirán entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Yo les doy buenas enseñanzas;",
          "no rechacen mis instrucciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "También yo fui hijo, y tuve un padre;",
          "era el hijo predilecto de mi madre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi padre me enseñaba, y me decía:",
          "«Guarda mis razones en tu corazón.",
          "Cumple mis mandamientos, y vivirás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Adquiere sabiduría e inteligencia,",
          "y nunca te olvides ni te apartes",
          "de las palabras de mi boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ama a la sabiduría. Nunca la dejes,",
          "y ella te cuidará y te protegerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "En primer lugar, adquiere sabiduría;",
          "sobre todas las cosas, adquiere inteligencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Hónrala, y ella te enaltecerá;",
          "abrázala, y ella te honrará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Adorno de gracia pondrá sobre tu cabeza;",
          "te coronará con una bella diadema.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Hijo mío, óyeme y acepta mis razones,",
          "y los años de tu vida se alargarán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Yo te muestro el camino de la sabiduría,",
          "y te llevo por senderos de rectitud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Tus pasos no encontrarán obstáculos,",
          "y cuando corras no tropezarás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Retén mis consejos; no los abandones.",
          "Resguárdalos, porque te darán vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "No vayas por la senda de los impíos,",
          "ni sigas el camino de los malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Deja esa senda, no vayas por ella;",
          "apártate de ella y sigue adelante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ellos no duermen si no han hecho mal;",
          "pierden el sueño si no hacen caer a alguno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Se alimentan con la maldad;",
          "apagan su sed cometiendo robos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero la senda de los justos es como la aurora:",
          "¡su luz va en aumento, hasta la plenitud del día!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "El camino de los impíos es como la oscuridad;",
          "¡ni siquiera saben contra qué tropiezan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Hijo mío, presta atención a mis palabras;",
          "inclina tu oído para escuchar mis razones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No las pierdas de vista;",
          "guárdalas en lo más profundo de tu corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ellas son vida para quienes las hallan;",
          "son la medicina para todo su cuerpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Cuida tu corazón más que otra cosa,",
          "porque él es la fuente de la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Aparta de tu boca las palabras perversas;",
          "aleja de tus labios las palabras inicuas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Dirige la mirada hacia adelante;",
          "fíjate en lo que tienes delante de tus ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Piensa qué camino vas a seguir,",
          "y plántate firme en todos tus caminos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Apártate del mal. No te desvíes",
          "ni a la derecha ni a la izquierda."
        ],
        "rlw_lines": []
      }
    ]
  },
