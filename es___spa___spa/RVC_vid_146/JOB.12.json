    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Job responde a Sofar"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Job tomó la palabra y dijo:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¡No hay duda! ¡Ustedes son la voz del pueblo!",
          "¡Cuando ustedes mueran, morirá la sabiduría!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pero yo también tengo un poco de sesos,",
          "y no me siento inferior a ustedes.",
          "¿Quién no sabe todo lo que han dicho?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "»Yo invocaba a Dios, y él me respondía;",
          "¡pero ahora hasta mis amigos se burlan de mí!",
          "¡Por ser honesto soy objeto de burlas!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“El que está por caer, ¡que se caiga!”",
          "Eso piensan quienes se sienten seguros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "En esta vida los ladrones prosperan,",
          "Y se sienten seguros los que ofenden a Dios.",
          "¡Creen que Dios mismo les ha dado todo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Observa a los animales, y aprende de ellos;",
          "Mira a las aves en los cielos, y oye lo que te dicen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Habla con la tierra, para que te enseñe;",
          "hasta los peces te lo han de contar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Habrá entre estos alguien que no sepa",
          "que todo esto lo hizo la mano del Señor?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "La vida de todo ser está en sus manos;",
          "¡él infunde vida a toda la humanidad!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "»El oído distingue las palabras,",
          "el paladar reconoce los sabores,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "los ancianos poseen sabiduría,",
          "y una larga vida acumula entendimiento;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "pero la sabiduría y el poder son de Dios,",
          "y suya también la decisión inteligente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Lo que Dios destruye, nadie lo reconstruye;",
          "a quien él encierra, nadie puede liberarlo;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "si él detiene las aguas, viene la sequía;",
          "si envía lluvias torrenciales, la tierra se inunda."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Suyos son la sabiduría y el poder;",
          "suyos son los que yerran y los que hacen errar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Él despoja de buen juicio a los consejeros,",
          "y entorpece el criterio de los jueces;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "deshace las cadenas de los tiranos,",
          "y los manda en cadena al cautiverio;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "despoja de su poder a los sacerdotes,",
          "y derriba del trono a los poderosos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "arrebata la palabra a los consejeros,",
          "y deja a los ancianos sin inteligencia;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "cubre de ignominia a los príncipes,",
          "y expone a la vergüenza a los poderosos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "saca a la luz las fuerza ocultas,",
          "y pone al descubierto las más densas tinieblas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Por él las naciones prosperan o son destruidas;",
          "es él quien las dispersa o las vuelve a reunir;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "él entorpece el juicio de los gobernantes,",
          "y los hace vagar sin rumbo por el desierto;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "y estos caminan a tientas, como ciegos sin guía,",
          "y van dando traspiés, como todo borracho."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
