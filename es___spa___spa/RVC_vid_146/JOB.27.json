    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Job continuó con su discurso, y dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¡Vive Dios, el Todopoderoso,",
          "que me amarga la vida al negarme su justicia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pero mientras me quede vida,",
          "mientras quede en mí el hálito divino,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "no emitirán mis labios nada reprochable,",
          "ni mi lengua pronunciará engaño alguno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Jamás podré dar a ustedes la razón;",
          "sostendré mi inocencia hasta la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No renunciaré a insistir en mi justicia;",
          "mientras viva, tendré la conciencia tranquila."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Que sean mis enemigos como los malvados!",
          "¡Que sean mis adversarios como los inicuos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»¿Qué fin le espera al malvado y ladrón,",
          "cuando Dios le arrebate la vida?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Acaso Dios escuchará su clamor",
          "cuando le sobrevenga la angustia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Hallará placer al lado del Todopoderoso?",
          "¿Invocará acaso a Dios en todo momento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Voy a enseñarles algo del poder de Dios!",
          "¡Les voy a revelar lo que sé del Todopoderoso!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "No hay duda de que todos ustedes lo han visto;",
          "entonces, ¿por qué dicen tantas tonterías?»"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tercera reprensión de Sofar a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "«El Dios Todopoderoso tiene ya preparada",
          "la herencia de los malvados y violentos:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Podrán tener muchos hijos, pero morirán por la espada;",
          "los más pequeños siempre carecerán de pan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Si acaso alguno sobrevive, no será sepultado,",
          "ni su viuda llorará su muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Podrá vivir entre montones de plata,",
          "y acumular grandes cantidades de ropa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "pero al final los hombres justos e inocentes",
          "se pondrán esa ropa y se repartirán la plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "»La casa que edifica está carcomida por dentro;",
          "es tan frágil como una choza de vigilancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Se va a descansar seguro de sus riquezas,",
          "pero al despertar ya está en la miseria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Entonces el terror lo domina como un río,",
          "y en la noche lo arrastra como un torbellino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Un viento calcinante lo lanza a las alturas;",
          "una fuerte tempestad lo arranca de su lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Dios lo castigará sin piedad,",
          "y aunque quiera escapar, no lo conseguirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Al verlo, la gente aplaudirá",
          "y se alegrará de verlo arruinado.»"
        ],
        "rlw_lines": []
      }
    ]
  },
