    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primera reprensión de Sofar a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Habló entonces Sofar el namatita:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«El que habla mucho, ¿no debe escuchar?",
          "¿Se declara inocente al parlanchín?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Vas a engañarnos con tus embustes?",
          "¿Te burlas de nosotros sin que nadie te responda?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tú afirmas: “Lo que digo es la verdad.",
          "No tengo nada de qué avergonzarme.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Cómo quisiera yo que Dios hablara",
          "y que con sus propios labios te acusara;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "que te revelara los secretos de la sabiduría,",
          "y te hiciera ver el otro lado de la moneda!",
          "Verías entonces que Dios no te ha castigado",
          "como realmente lo merece tu maldad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»¿Puedes descubrir los secretos de Dios?",
          "¿Puedes ser tan perfecto como el Todopoderoso?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¿Cómo podrías, si están por encima de los cielos?",
          "¿Cómo podrías, si son más profundos que el sepulcro?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Son más extensos que la tierra!",
          "¡son más vastos que el ancho mar!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Si Dios te aprehende, y te llama a cuentas,",
          "no podrás hacerlo desistir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios sabe cuando la gente es falsa;",
          "se da cuenta cuando la gente actúa mal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Sabes cuándo el necio llegará a ser sabio?",
          "¡Cuando de un asno montés nazca un hombre!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Si de todo corazón elevas tus manos,",
          "y te dispones a rogarle a Dios;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "y si te arrepientes de toda maldad,",
          "y alejas de tu casa la iniquidad,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "podrás levantar la cara limpia de pecado,",
          "y podrás sentirte libre y sin ningún temor;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "te olvidarás de tus tristezas,",
          "o pensarás en ellas como el agua que pasa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tu vida será más clara que la luz del mediodía,",
          "y aun la oscuridad será como el amanecer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Volverás a confiar porque tendrás esperanza;",
          "y rodeado de paz podrás dormir tranquilo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Nada podrá perturbar tu sueño;",
          "y muchos te buscarán para pedir tu favor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Pero los malvados irán perdiendo la vista,",
          "y no hallarán un lugar de refugio;",
          "solo desearán exhalar el último suspiro.»"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
