        "lines": [
          "Exhortación a la alabanza universal"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Sobre Neginot. Salmo. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios mío, ¡ten misericordia de nosotros, y bendícenos!",
          "¡Haz resplandecer tu rostro sobre nosotros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Que sea reconocido en la tierra tu camino,",
          "y en todas las naciones tu salvación!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Que te alaben los pueblos, Dios mío!",
          "¡Que todos los pueblos te alaben!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Que las naciones se llenen de gozo,",
          "porque tú juzgas a los pueblos con equidad",
          "y eres el Pastor de todas las naciones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Que te alaben los pueblos, Dios mío!",
          "¡Que todos los pueblos te alaben!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Que la tierra rinda sus frutos!",
          "¡Que el Dios nuestro nos bendiga!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Que nuestro Dios nos bendiga,",
          "y que todos los confines de la tierra lo teman!"
        ],
        "rlw_lines": []
      }
    ]
