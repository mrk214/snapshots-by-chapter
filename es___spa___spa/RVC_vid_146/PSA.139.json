    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dios está en todas partes"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al músico principal. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, tú me has examinado y me conoces;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "tú sabes cuando me siento o me levanto;",
          "¡desde lejos sabes todo lo que pienso!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Me vigilas cuando camino y cuando descanso;",
          "¡estás enterado de todo lo que hago!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todavía no tengo las palabras en la lengua,",
          "¡y tú, Señor, ya sabes lo que estoy por decir!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu presencia me envuelve por completo;",
          "la palma de tu mano reposa sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Saber esto rebasa mi entendimiento;",
          "¡es tan sublime que no alcanzo a comprenderlo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¿Dónde puedo esconderme de tu espíritu?",
          "¿Cómo podría huir de tu presencia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Si subiera yo a los cielos, allí estás tú;",
          "si me tendiera en el sepulcro, también estás allí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Si levantara el vuelo hacia el sol naciente,",
          "o si habitara en los confines del mar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "aun allí tu mano me sostendría;",
          "¡tu mano derecha no me soltaría!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Si quisiera esconderme en las tinieblas,",
          "y que se hiciera noche la luz que me rodea,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¡ni las tinieblas me esconderían de ti,",
          "pues para ti la noche es como el día!",
          "¡Para ti son lo mismo las tinieblas y la luz!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tú, Señor, diste forma a mis entrañas;",
          "¡tú me formaste en el vientre de mi madre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Te alabo porque tus obras son formidables,",
          "porque todo lo que haces es maravilloso.",
          "¡De esto estoy plenamente convencido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Aunque en lo íntimo me diste forma,",
          "y en lo más secreto me fui desarrollando,",
          "nada de mi cuerpo te fue desconocido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Con tus propios ojos viste mi embrión;",
          "todos los días de mi vida ya estaban en tu libro;",
          "antes de que me formaras, los anotaste,",
          "y no faltó uno solo de ellos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Dios mío, ¡cuán preciosos me son tus pensamientos!",
          "¡Cuán vastos son en su totalidad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Si los contara, serían más que la arena;",
          "si terminara de contarlos, tú aún estarías allí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Dios mío, ¡quítales la vida a los malvados!",
          "¡Aparta de mí a la gente violenta,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "a esos enemigos tuyos",
          "que blasfeman y se burlan de ti!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Señor, tú sabes que odio a los que te odian,",
          "que mi enojo se enciende contra tus enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Son para mí totalmente aborrecibles;",
          "¡los considero mis peores enemigos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Señor, examina y reconoce mi corazón:",
          "pon a prueba cada uno de mis pensamientos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Así verás si voy por mal camino,",
          "y me guiarás por el camino eterno."
        ],
        "rlw_lines": []
      }
    ]
  },
