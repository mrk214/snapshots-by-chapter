    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Proverbios sobre la vida y la conducta"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Del corazón del hombre surgen los planes,",
          "pero del Señor proviene la respuesta de la lengua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Según el hombre, todo camino es limpio,",
          "pero el Señor pondera los espíritus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Encomienda al Señor tus acciones,",
          "y tus pensamientos serán afirmados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El Señor lo ha hecho todo para sí mismo;",
          "¡hasta el impío está hecho para el día fatal!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "El Señor aborrece a los de corazón altivo,",
          "y es un hecho que no quedarán impunes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "El amor verdadero perdona el pecado;",
          "el temor del Señor aparta del mal a los hombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Si el Señor aprueba los caminos del hombre,",
          "hasta sus enemigos hacen la paz con él."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Es mejor lo poco del justo",
          "que los muchos frutos del injusto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "El corazón del hombre pondera su camino,",
          "pero el Señor le corrige el rumbo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El rey tiene el veredicto en sus labios;",
          "no hay error cuando emite la sentencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Las pesas y medidas justas son del Señor;",
          "todas las balanzas son su propia creación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Es repugnante que los reyes cometan el mal,",
          "porque el trono se afirma en la justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Es grato que los reyes hablen con justicia,",
          "y que amen a los que dicen la verdad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "La ira del rey es heraldo de muerte,",
          "pero el que es sabio sabe evitarla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "El rostro alegre del rey es presagio de vida;",
          "su favor es una nube cargada de lluvia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ganar sabiduría e inteligencia",
          "es mejor que adquirir oro y plata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los hombres rectos se apartan del mal camino;",
          "quien cuida sus pasos, cuida su vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "La soberbia precede al fracaso;",
          "la arrogancia anticipa la caída."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Es mejor ser humilde entre los humildes",
          "que compartir despojos con los soberbios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El que atiende a la palabra, halla el bien;",
          "¡dichoso aquel que confía en el Señor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Al de corazón sabio se le llama prudente;",
          "los labios amables aumentan el saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Tener cordura es tener la fuente de la vida;",
          "a los necios los castiga su propia necedad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El sabio de corazón habla con prudencia,",
          "y a sus labios añade sabiduría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Las palabras amables son un panal de miel;",
          "endulzan el alma y sanan el cuerpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Hay caminos que el hombre considera buenos,",
          "pero que al final resultan caminos de muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "El trabajador se afana para calmar su apetito;",
          "su estímulo es llenarse la boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "El que es perverso escarba en el mal;",
          "hay en sus labios una llama de fuego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "El que es perverso provoca contiendas;",
          "el chismoso aparta a los mejores amigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "El que es violento adula a su prójimo",
          "y lo hace andar por el mal camino;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "cierra los ojos y hace planes malvados,",
          "mueve los labios y consuma el mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "La vejez es la corona de una vida honrada,",
          "y se la halla en el camino de la justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Ser paciente es mejor que ser valiente;",
          "es mejor dominarse uno mismo que tomar una ciudad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Las suertes se echan en el regazo;",
          "pero el resultado depende del Señor."
        ],
        "rlw_lines": []
      }
    ]
  },
