    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cuarto discurso de Eliú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Todavía añadió Eliú:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Tenme un poco de paciencia, y te mostraré",
          "que de Dios aún tengo mucho que decir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Lo que de él sé tiene una larga historia,",
          "y voy a demostrarte que mi Creador es justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En mis palabras no hay nada de mentira;",
          "¡tienes ante ti a la sabiduría perfecta!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "»Aunque Dios es grande y poderoso,",
          "no desprecia a los de corazón sincero;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "no da larga vida a los malvados,",
          "y sí hace justicia a los oprimidos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "está al pendiente de los hombres justos,",
          "para exaltarlos siempre junto con los reyes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Aunque estén encadenados y en la cárcel,",
          "sujetos a las ataduras de la aflicción,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dios da a conocer sus malas obras",
          "y la insolencia de sus rebeliones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Les abre los oídos para que se corrijan,",
          "y los exhorta a apartarse del mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Si obedecen a Dios y le sirven,",
          "Dios les concede días de paz y bienestar;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "pero si no obedecen, la espada les espera",
          "y mueren sin llegar a tener entendimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Los hipócritas son rencorosos con Dios,",
          "y no piden clemencia aunque sufran su castigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pierden la vida en plena juventud,",
          "como la pierden los que se han prostituido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero Dios libra al pobre de su pobreza,",
          "y en la aflicción le enseña a ser obediente;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "lo libra de vivir siempre angustiado",
          "y lo lleva a lugares espaciosos,",
          "donde le prepara un suculento banquete."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "»Pero tú no llevaste a juicio al malvado,",
          "ni defendiste al huérfano en los tribunales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cuídate de no dejarte llevar por las riquezas,",
          "ni te dejes seducir por el soborno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ante Dios, de nada te sirven todas tus riquezas,",
          "ni todo tu poder y tu fuerza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No esperes que llegue la noche,",
          "momento en que los pueblos desaparecen."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Cuídate de no caer en la maldad,",
          "pues por preferirla ahora sufres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Mira que el poder de Dios es sublime;",
          "no hay maestro que se le pueda comparar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¿Quién le puede señalar el camino a seguir?",
          "¿Quién puede reprenderlo por lo que hace?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "»No te olvides de exaltar su creación,",
          "la cual admira la humanidad entera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Todo el mundo puede contemplarla,",
          "no importa cuán lejos se encuentre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Dios es grande, pero no lo conocemos;",
          "nadie sabe cuántos años ha existido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Dios reúne las gotas de agua,",
          "y hace que el vapor se convierta en lluvia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "las nubes contienen esa lluvia,",
          "y esta cae en abundancia sobre la humanidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "»¿Quién conoce la extensión de las nubes,",
          "o entiende el estruendo de los rayos en su seno?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Dios derrama su luz sobre la tierra,",
          "y cubre con ella las profundidades del mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Con la lluvia da vida a los pueblos",
          "y la tierra produce el sustento de muchos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Las densas nubes esconden la luz,",
          "y la tierra se cubre de sombras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "El trueno denuncia la ira de Dios;",
          "la tempestad proclama su rechazo a la maldad."
        ],
        "rlw_lines": []
      }
    ]
  },
