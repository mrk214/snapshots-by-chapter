    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Job responde a Elifaz"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Job le respondió, y dijo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¡Cómo quisiera que pusieran en la misma balanza",
          "mi tormento por un lado y mi queja por el otro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Verían que pesan más que la arena del mar!",
          "¡Por eso he hablado sin ton ni son!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "El Dios poderoso me ha clavado sus flechas,",
          "y puedo sentir su veneno penetrar en mi espíritu;",
          "¡los terrores de Dios me tienen asediado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Rebuzna el asno montés si no le falta hierba?",
          "¿Muge el buey si no le falta pastura?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿Habrá quien coma sin sal la comida desabrida?",
          "¿A quién le gusta la clara del huevo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Pues las cosas que antes no soportaba",
          "son las que ahora me alimentan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»¡Cómo quisiera que Dios me escuchara,",
          "y que me concediera lo que más anhelo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Cómo quisiera que Dios me quitara la vida,",
          "que descargara su mano y me hiciera morir!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Para mí, sería un gran consuelo",
          "morir de inmediato sin importar el dolor,",
          "pues no he renegado de su santa voluntad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Quién me refuerza y me mantiene de pie?",
          "He perdido la paciencia, pues desconozco mi fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Soy acaso tan duro como la roca?",
          "¿Acaso es mi piel resistente como el bronce?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Estoy tan débil, que no me puedo mover,",
          "y nadie viene para brindarme auxilio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Al amigo que sufre se le consuela,",
          "aunque se haya olvidado del Todopoderoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Pero mis impetuosos amigos me han fallado!",
          "¡Son como las corrientes que se salen de su cauce!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Son como el agua turbia y congelada,",
          "que se queda cubierta por la nieve"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "pero que con el sol se derrite",
          "y con el calor se evapora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Sin agua, las caravanas pierden el rumbo",
          "y acaban por perderse en el desierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Las caravanas de Temán y de Sabá",
          "buscaban agua y esperaban encontrarla,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Pero al llegar allí se quedaron pasmados;",
          "se vio frustrada su esperanza de vivir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¡Y así me han dejado ustedes a mí!",
          "¡Al ver mi sufrimiento, se han llenado de miedo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¿Acaso les pedí que trajeran sus bienes,",
          "y que me sacaran de mi doloroso apuro?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "¿Les pedí que me libraran de mi enemigo,",
          "o que me rescataran del poder de los violentos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "»¡Ilústrenme, y guardaré silencio!",
          "Quiero comprender cuál es mi error."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Cuando es justa la censura, es bienvenida;",
          "pero ustedes me acusan sin razón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Ustedes censuran todo lo que digo,",
          "¡pero son palabras que se lleva el viento!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "¡Ustedes son capaces de vender a un huérfano,",
          "y de cavar un hoyo para enterrar a un amigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "»Escúchenme, si quieren atenderme;",
          "piensen bien si soy capaz de mentirles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Vuelvan a juzgarme, pero sin saña;",
          "reconsideren mi causa y vean si es justa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "¿Acaso he hablado con malas intenciones?",
          "¿Acaso no distingo entre el bien y el mal?"
        ],
        "rlw_lines": []
      }
    ]
  },
