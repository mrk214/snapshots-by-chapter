    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La sabiduría y la mujer insensata"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La sabiduría ha edificado su casa;",
          "la ha afirmado con siete columnas labradas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "ha sacrificado los animales para el banquete,",
          "ha mezclado el vino y preparado la mesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ahora llama desde lo alto de la ciudad,",
          "luego de haber enviado a sus criadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Invita a los ingenuos a acercarse;",
          "les dice a los faltos de cordura:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "«¡Vengan y coman de mi pan!",
          "¡Beban del vino que he mezclado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¡Déjense de tonterías, y vivan!",
          "¡Sigan el camino de la inteligencia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Corrige al blasfemo y recibirás afrentas;",
          "reprende al impío y te ganarás insultos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No reprendas al blasfemo, y no te aborrecerá;",
          "corrige al sabio, y te amará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dale al sabio, y se hará más sabio;",
          "enseña al justo, y aumentará su saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "El principio de la sabiduría es el temor del Señor;",
          "el conocimiento de lo santo es inteligencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Yo haré que vivas mucho tiempo;",
          "¡te daré muchos años de vida!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si te haces sabio, el provecho es tuyo;",
          "si te vuelves blasfemo, sufrirás las consecuencias.»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La mujer insensata es provocativa;",
          "es insulsa e ignorante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Se entroniza a la puerta de su casa,",
          "o en los lugares más altos de la ciudad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "y llama a los que pasan por ahí,",
          "a los que van por el camino recto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Invita a los ingenuos a acercarse,",
          "y les dice a los faltos de cordura:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "«¡Qué dulce es el agua robada!",
          "¡Qué sabroso es el pan comido a escondidas!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Y ellos no saben que sus invitados",
          "terminan muertos en el fondo del sepulcro."
        ],
        "rlw_lines": []
      }
    ]
  },
