    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Leví"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Los hijos de Leví fueron Guersón, Coat y Merari."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Los hijos de Coat fueron Amirán, Isar, Hebrón y Uziel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Los hijos de Amirán fueron Aarón, Moisés y María.",
          "Los hijos de Aarón fueron Nadab, Abiú, Eleazar e Itamar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eleazar fue el padre de Finés, Finés fue el padre de Abisúa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Abisúa fue el padre de Buqui, Buqui fue el padre de Uzi,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Uzi fue el padre de Zeraías, Zeraías fue el padre de Merayot,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Merayot fue el padre de Amarías, Amarías fue el padre de Ajitob,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ajitob fue el padre de Sadoc, Sadoc fue el padre de Ajimaz,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ajimaz fue el padre de Azarías, Azarías fue el padre de Johanán,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "y Johanán fue el padre de Azarías, el que fue sacerdote en el templo que Salomón construyó en Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Azarías fue el padre de Amarías, Amarías fue el padre de Ajitob,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ajitob fue el padre de Sadoc, Sadoc fue el padre de Salún,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Salún fue el padre de Hilcías, Hilcías fue el padre de Azarías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Azarías fue el padre de Seraías, y Seraías fue el padre de Josadac,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "el que fue llevado cautivo cuando el Señor hizo que Judá y Jerusalén fueran deportados por Nabucodonosor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los hijos de Leví fueron Guersón, Coat y Merari."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Los nombres de los hijos de Guersón fueron Libni y Simey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Los hijos de Coat fueron Amirán, Isar, Hebrón y Uziel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Los hijos de Merari fueron Mali y Musi.",
          "Estas son las familias de Leví, comenzando por los padres:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Guersón, Libni, Yajat, Zima,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Yoaj, Iddo, Zeraj y Yatray."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Los descendientes de Coat en línea directa fueron Aminadab, Coré, Asir,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Elcana, Ebiasaf, Asir,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Tajat, Uriel, Uzías y Saúl."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Los hijos de Elcana fueron Amasay y Ajimot."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Los descendientes de Elcana fueron Sofay, Najat,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Eliab, Jeroán, Elcana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Los hijos de Samuel fueron Vasni, su primogénito, y Abías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Los descendientes de Merari fueron Mali, Libni, Simey, Uzá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Simea, Jaguías y Asaías."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Los cantores del templo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "A partir de que el arca se quedó en un lugar fijo, David nombró cantores para el templo del Señor. Estos son los cantores que nombró,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "los cuales cantaban ante la tienda del tabernáculo de reunión hasta que Salomón construyó el templo del Señor en Jerusalén. Después siguieron cumpliendo con su ministerio, como de costumbre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Estos son los que rendían este servicio, junto con sus hijos:",
          "De los hijos de Coat, el cantor Hemán hijo de Joel, que era descendiente en línea directa de Samuel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Elcana, Jeroán, Eliel, Toaj,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Suf, Elcana, Majat, Amasay,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Elcana, Joel, Azarías, Sofonías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Tajat, Asir, Ebiasaf, Coré,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Isar, Coat, Leví e Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "A la derecha de Hemán estaba su pariente Asaf hijo de Berequías, que era descendiente en línea directa de Simea,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Micael, Baseías, Malquías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Etni, Zeraj, Adaías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Etán, Zima, Simey,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Yajat, Guersón y Leví."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "A la izquierda de Hemán estaba su pariente Etán hijo de Quisi, de los descendientes en línea directa de Merari, Abdi, Maluc,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Jasabías, Amasías, Hilcías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Amsi, Bani, Semer,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Mali, Musi, Merari y Leví."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Sus parientes levitas fueron puestos a cargo de todo el ministerio del tabernáculo del templo de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Aarón"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Aarón y sus descendientes ofrecían sacrificios sobre el altar del holocausto, quemaban incienso sobre el altar del perfume, ministraban en todo lo relacionado con el lugar santísimo y hacían las expiaciones por Israel, conforme a todo lo que había ordenado Moisés, el siervo de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Los descendientes de Aarón, en línea directa, fueron Eleazar, Finés, Abisúa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Buqui, Uzi, Zeraías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Merayot, Amarías, Ajitob,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Sadoc y Ajimaz."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ciudades de los levitas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Estos fueron los asentamientos que les tocaron en suerte a los coatitas, descendientes de Aarón, según sus lugares de residencia y sus linderos:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Hebrón, en el territorio de Judá, con los ejidos que rodeaban esta ciudad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "aunque el territorio de la ciudad y sus aldeas se le dieron a Caleb, hijo de Yefune."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "Las ciudades de refugio que los descendientes de Aarón recibieron en Judá fueron Hebrón, Libna, Jatir, Estemoa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Hilén, Debir,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Asán y Bet Semes, todas ellas con sus ejidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Además, en territorio de la tribu de Benjamín recibieron las ciudades de Geba, Alemet y Anatot. En total, recibieron trece ciudades con sus ejidos, repartidas entre sus linajes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Los restantes descendientes de Coat recibieron en sorteo diez ciudades de la media tribu de Manasés."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "Los descendientes de Guersón, en el orden de sus linajes, recibieron trece ciudades de las tribus de Isacar, Aser, Neftalí y Manasés, en Basán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Los descendientes de Merari, en el orden de sus linajes, recibieron en sorteo doce ciudades de las tribus de Rubén, Gad y Zabulón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Los israelitas dieron a los levitas en sorteo ciudades con sus ejidos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "las cuales tomaron de las tribus de Judá, Simeón y Benjamín, y a las cuales les dieron sus nombres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "De la tribu de Efraín, las familias de los coatitas recibieron,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "como ciudades de refugio, Siquén, que está en el monte de Efraín; Guézer,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Jocmeán, Bet Jorón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "Ayalón y Gat Rimón, todas ellas con sus ejidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "De la media tribu de Manasés, las familias coatitas restantes recibieron las ciudades de Aner y Bileán, ambas con sus ejidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "De la media tribu de Manasés, los descendientes de Guersón recibieron las ciudades de Golán, que está en Basán, y Astarot, ambas con sus ejidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "De la tribu de Isacar recibieron las ciudades de Cedes, Daberat,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "Ramot y Anén, todas ellas con sus ejidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "De la tribu de Aser recibieron las ciudades de Masal, Abdón,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "Jucoc y Rejob, todas ellas con sus ejidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "De la tribu de Neftalí recibieron las ciudades de Cedes de Galilea, Gamón y Quiriatayin, todas ellas con sus ejidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "De la tribu de Zabulón, los restantes descendientes de Merari recibieron las ciudades de Rimón y Tabor, ambas con sus ejidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "De la tribu de Rubén, que está en la ribera oriental del río Jordán, frente a Jericó, recibieron las ciudades de Beser (que está en el desierto), Yahás,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Cademot y Mefagat, todas ellas con sus ejidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "De la tribu de Gad recibieron las ciudades de Ramot de Galaad, Majanayin,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "Jesbón y Jazer, todas ellas con sus ejidos."
        ],
        "rlw_lines": []
      }
    ]
  },
