    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segunda reprensión de Elifaz a Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Esta es la respuesta de Elifaz el temanita:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¿Responde el sabio con palabras huecas?",
          "¿O exhala de su vientre aire caliente?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Acaso disputa con palabras sin sustento,",
          "o con discursos sin sentido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "En cambio, tú reniegas del temor de Dios;",
          "tienes en poco la devoción en su presencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero tu misma maldad te condena al hablar,",
          "pues hablas como cualquier hombre astuto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tus propias palabras te condenan, no las mías;",
          "¡son tus labios los que hablan contra ti!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»¿Acaso naciste antes que Adán?",
          "¿Fuiste formado antes que las montañas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¿Participas en el concilio de Dios?",
          "¿Eres acaso el único sabio?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Qué sabes tú, que nosotros no sepamos?",
          "¿Qué entiendes tú, que nosotros ignoremos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¡Entre nosotros hay gente de gran experiencia,",
          "con más canas y años de vida que tu padre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Tan poco te parece que Dios mismo te consuele,",
          "y que te hablemos con palabras llenas de ternura?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Por qué permites que el enojo te domine,",
          "y te haga echar chispas por los ojos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¿Por qué te vuelves furioso contra Dios,",
          "y no les pones freno a tus labios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¿Qué vale el hombre, nacido de mujer,",
          "para creerse limpio y alegar ser inocente?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Si Dios ni en sus ángeles confía,",
          "y a sus ojos ni los cielos están limpios,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "¡mucho menos confía en un ser vil y repugnante,",
          "que apaga su sed cometiendo maldad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "»Ponme atención, que te voy a contar",
          "las cosas que me ha tocado ver;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "cosas del pasado que los sabios nos enseñan,",
          "que aprendieron de sus padres y no las esconden."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A ellos solos Dios les dio la tierra,",
          "sin la intervención de ningún extraño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "El violento vive lleno de tormentos y dolor,",
          "sin que sepa ese malvado cuánto tiempo vivirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "En sus oídos resuenan ruidos espantosos;",
          "cuando goza de paz, viene el ladrón y lo asalta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Sin esperanza, se hunde en las tinieblas,",
          "y solo espera el puñal que le quitará la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Hambriento vaga, preguntando dónde hay pan,",
          "sabiendo que la muerte muy pronto llegará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Vive abrumado y en angustia constante,",
          "como un rey al que están por atacar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Esto le sucede por rebelarse contra Dios,",
          "por desafiar osadamente al Todopoderoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Se lanzó contra Dios en abierto desafío,",
          "con la sola protección de un pesado escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Su cara es una bola de grasa;",
          "su cintura está sobrada de carnes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "habita en ciudades desoladas,",
          "en casas que nadie puede habitar",
          "porque han quedado en ruinas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Sus riquezas pronto se acabarán,",
          "y no podrá extender sus posesiones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Nada lo librará de caer en la tumba;",
          "Será como rama consumida por el fuego,",
          "¡como flores arrancadas por el viento!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "»Que no confíe ingenuamente en el engaño,",
          "porque acabará siendo engañado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "La muerte le llegará antes de tiempo,",
          "mucho antes de llegar a tener descendientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Será como una viña sin racimos de uvas,",
          "¡como un olivo que no llega a florecer!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Los malvados desaparecerán de la tierra;",
          "la casa del que soborna será pasto de las llamas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "pues concibe hacer el mal y da a luz iniquidad;",
          "¡en sus entrañas se gesta el engaño!»"
        ],
        "rlw_lines": []
      }
    ]
  },
