    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Plegaria en que se pide vindicación"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Sigaión que David cantó al Señor por lo que dijo Cus hijo de Benjamín."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, mi Dios, en ti confío;",
          "¡ponme a salvo de los que me persiguen!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡No permitas que, como leones, me desgarren;",
          "que me destrocen sin que nadie me defienda!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Señor, mi Dios, ¿qué mal he cometido?",
          "¿Acaso hay maldad en mis manos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¿Acaso les he pagado mal a mis aliados",
          "dejando sin más en libertad a nuestros adversarios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Si es así, ¡que el enemigo me persiga!",
          "¡Que me alcance y me haga rodar por tierra!",
          "¡Que ponga mi honor por los suelos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Señor, ¡levántate, y en tu furor",
          "enfréntate a la furia de mis adversarios!",
          "¡Despierta, y dicta tu sentencia en mi favor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Rodeado entonces de todas las naciones,",
          "reinarás sobre ellas desde el alto cielo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tú, Señor, que juzgas a las naciones,",
          "júzgame como corresponde a tu justicia,",
          "y de acuerdo con mi integridad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pon fin a la maldad de los perversos,",
          "pero mantén firme al hombre honrado,",
          "pues tú eres un Dios justo",
          "que examina el corazón y la mente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dios es mi escudo;",
          "él salva a los rectos de corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dios es un juez justo,",
          "siempre enojado con la gente malvada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Listos tiene el arco y la espada",
          "para actuar contra ellos, si no se arrepienten."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Listas tiene también armas mortales;",
          "¡ya ha preparado ardientes saetas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "El malvado concibe hacer el mal;",
          "tan preñado está de maldad",
          "que de él nace la mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ha cavado un pozo muy profundo,",
          "y en ese mismo pozo caerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Su maldad se volverá contra él;",
          "sus agravios recaerán sobre él mismo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¡Yo alabaré al Señor por su justicia!",
          "¡Cantaré salmos al nombre del Dios altísimo!"
        ],
        "rlw_lines": []
      }
    ]
  },
