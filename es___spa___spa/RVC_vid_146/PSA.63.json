    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Solo Dios satisface al alma"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David, cuando estaba en el desierto de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios mío, ¡tú eres mi Dios!",
          "Yo te buscaré de madrugada.",
          "Mi alma desfallece de sed por ti;",
          "mi ser entero te busca con ansias,",
          "en terrenos secos e inhóspitos, sin agua,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "con deseos de ver tu poder y tu gloria,",
          "como los he mirado en el santuario."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tu misericordia es mejor que la vida;",
          "por eso mis labios te alaban."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Yo te bendeciré mientras tenga vida,",
          "y en tu nombre levantaré mis manos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mi alma quedará del todo satisfecha,",
          "como si comiera los mejores platillos,",
          "y mis labios te aclamarán jubilosos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "al pensar en ti recostado en mi lecho,",
          "al meditar en ti durante mis desvelos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque tú has sido mi socorro,",
          "alegre viviré bajo la sombra de tus alas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mi alma está apegada a ti;",
          "tu mano derecha me brinda apoyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los que buscan matarme y acabar conmigo",
          "caerán a lo más profundo de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Los matarán a filo de espada;",
          "servirán de alimento a los chacales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pero el rey se regocijará en Dios,",
          "y todos los que juran por él serán alabados,",
          "pero la boca de los mentirosos será acallada."
        ],
        "rlw_lines": []
      }
    ]
  },
