    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica ante una muerte inminente"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico. Salmo de los hijos de Coré. Al músico principal. Para cantar sobre Majalat. Masquil de Hemán ezraíta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, Dios de mi salvación,",
          "delante de ti clamo noche y día."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Permite que mi oración llegue a tu presencia;",
          "¡inclina tu oído a mi clamor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Las calamidades me abruman;",
          "¡ya me encuentro al borde del sepulcro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "¡Hay quienes ya me dan por muerto,",
          "pues las fuerzas me abandonan!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me encuentro relegado entre los muertos;",
          "como los caídos en batalla que yacen sepultados,",
          "y de los cuales ya no te acuerdas,",
          "pues fueron arrebatados de tu mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Me arrojaste en profunda fosa;",
          "¡en el lugar de las tinieblas más profundas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Has descargado tu enojo sobre mí;",
          "¡me has afligido con tus embates de ira!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Has alejado de mí a mis conocidos;",
          "me has hecho repugnante a sus ojos.",
          "Me encuentro encerrado, y no puedo salir;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "la aflicción me nubla los ojos.",
          "A ti, Señor, clamo todos los días;",
          "¡a ti extiendo mis manos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Acaso manifiestas tus maravillas a los muertos?",
          "¿Se levantarán los muertos a alabarte?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¿Acaso en el sepulcro se alaba tu misericordia?",
          "¿Se proclama acaso tu verdad entre los muertos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "¿Hay en las tinieblas quien reconozca tus maravillas,",
          "o quien proclame tu justicia en la tierra del olvido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "¡Pues yo sí clamo a ti, Señor!",
          "¡Por la mañana dirijo a ti mis oraciones!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Señor, ¿por qué me rechazas?",
          "¿Por qué escondes de mí tu rostro?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Entre aflicciones, necesidades y temores,",
          "desde mi juventud he soportado terribles penas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tu ira pesa sobre mí, y me abruma;",
          "tus terribles ataques me han vencido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Como un diluvio, a todas horas me rodean;",
          "¡me tienen completamente cercado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Has alejado de mí a mis amigos y compañeros,",
          "¡y las tinieblas son mi sola compañía!"
        ],
        "rlw_lines": []
      }
    ]
  },
