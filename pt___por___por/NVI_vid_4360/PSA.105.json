  "book": {
    "book_usfm": "PSA",
    "name": "Salmos"
  },
  "chapter": {
    "usfm": "PSA.105",
    "human": "Salmos 105",
    "previous": {
      "usfm": "PSA.104",
      "human": "Salmos 104"
    },
    "next": {
      "usfm": "PSA.106",
      "human": "Salmos 106"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deem graças ao Senhor,",
          "proclamem o seu nome;",
          "divulguem os seus feitos entre as nações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cantem para ele e louvem-no;",
          "relatem todas as suas maravilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Gloriem-se no seu santo nome;",
          "alegre-se o coração dos que buscam o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Recorram ao Senhor e ao seu poder;",
          "busquem sempre a sua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Lembrem-se das maravilhas que ele fez,",
          "dos seus prodígios e das sentenças de juízo que pronunciou,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "ó descendentes de Abraão, seu servo,",
          "ó filhos de Jacó, seus escolhidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele é o Senhor, o nosso Deus;",
          "seus decretos são para toda a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele se lembra para sempre da sua aliança,",
          "por mil gerações, da palavra que ordenou,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "da aliança que fez com Abraão,",
          "do juramento que fez a Isaque."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ele o confirmou como decreto a Jacó,",
          "a Israel como aliança eterna, quando disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Darei a você a terra de Canaã,",
          "a herança que lhe pertence”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Quando ainda eram poucos,",
          "um punhado de peregrinos na terra,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "e vagueavam de nação em nação,",
          "de um reino a outro,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "ele não permitiu que ninguém os oprimisse,",
          "mas a favor deles repreendeu reis, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "“Não toquem nos meus ungidos;",
          "não maltratem os meus profetas”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ele mandou vir fome sobre a terra",
          "e destruiu todo o seu sustento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "mas enviou um homem adiante deles,",
          "José, que foi vendido como escravo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Machucaram-lhe os pés com correntes",
          "e com ferros prenderam-lhe o pescoço,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "até cumprir-se a sua predição",
          "e a palavra do Senhor confirmar o que dissera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O rei mandou soltá-lo,",
          "o governante dos povos o libertou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Ele o constituiu senhor de seu palácio",
          "e administrador de todos os seus bens,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "para instruir os seus oficiais como desejasse",
          "e ensinar a sabedoria às autoridades do rei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Então Israel foi para o Egito,",
          "Jacó viveu como estrangeiro na terra de Cam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Deus fez proliferar o seu povo,",
          "tornou-o mais poderoso do que os seus adversários"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "e mudou o coração deles para que odiassem o seu povo,",
          "para que tramassem contra os seus servos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Então enviou seu servo Moisés,",
          "e Arão, a quem tinha escolhido,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "por meio dos quais realizou os seus sinais milagrosos",
          "e as suas maravilhas na terra de Cam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Ele enviou trevas, e houve trevas,",
          "e eles não se rebelaram contra as suas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Ele transformou as águas deles em sangue,",
          "causando a morte dos seus peixes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "A terra deles ficou infestada de rãs,",
          "até mesmo os aposentos reais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Ele ordenou, e enxames de moscas e piolhos",
          "invadiram o território deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Deu-lhes granizo, em vez de chuva,",
          "e raios flamejantes por toda a sua terra;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "arrasou as suas videiras e figueiras",
          "e destruiu as árvores do seu território."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Ordenou, e vieram enxames de gafanhotos,",
          "gafanhotos inumeráveis,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "e devoraram toda a vegetação daquela terra,",
          "e consumiram tudo o que a lavoura produziu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Depois matou todos os primogênitos da terra deles,",
          "todas as primícias da sua virilidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Ele tirou de lá Israel, que saiu cheio de prata e ouro.",
          "Não havia em suas tribos quem fraquejasse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Os egípcios alegraram-se quando eles saíram,",
          "pois estavam com verdadeiro pavor dos israelitas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Ele estendeu uma nuvem para lhes dar sombra,",
          "e fogo para iluminar a noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Pediram, e ele enviou codornizes",
          "e saciou-os com pão do céu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Ele fendeu a rocha, e jorrou água,",
          "que escorreu como um rio pelo deserto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Pois ele se lembrou da santa promessa",
          "que fizera ao seu servo Abraão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Fez o seu povo sair cheio de júbilo",
          "e os seus escolhidos com cânticos alegres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Deu-lhes as terras das nações,",
          "e eles tomaram posse do fruto do trabalho de outros povos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "para que obedecessem aos seus decretos",
          "e guardassem as suas leis.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
