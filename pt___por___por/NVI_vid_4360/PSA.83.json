    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Uma canção. Salmo da família de Asafe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, não te emudeças;",
          "não fiques em silêncio nem te detenhas, ó Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Vê como se agitam os teus inimigos,",
          "como os teus adversários te desafiam de cabeça erguida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Com astúcia conspiram contra o teu povo;",
          "tramam contra aqueles que são o teu tesouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eles dizem: “Venham, vamos destruí-los como nação,",
          "para que o nome de Israel não seja mais lembrado!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Com um só propósito tramam juntos;",
          "é contra ti que fazem acordo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "as tendas de Edom e os ismaelitas,",
          "Moabe e os hagarenos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Gebal, Amom e Amaleque,",
          "a Filístia, com os habitantes de Tiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Até a Assíria aliou-se a eles,",
          "e trouxe força aos descendentes de Ló."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Trata-os como trataste Midiã,",
          "como trataste Sísera e Jabim no rio Quisom,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "os quais morreram em En-Dor",
          "e se tornaram esterco para a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Faze com os seus nobres o que fizeste com Orebe e Zeebe,",
          "e com todos os seus príncipes o que fizeste com Zeba e Zalmuna,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "que disseram:",
          "“Vamos apossar-nos das pastagens de Deus”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Faze-os como folhas secas levadas no redemoinho, ó meu Deus,",
          "como palha ao vento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Assim como o fogo consome a floresta",
          "e as chamas incendeiam os montes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "persegue-os com o teu vendaval",
          "e aterroriza-os com a tua tempestade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Cobre-lhes de vergonha o rosto",
          "até que busquem o teu nome, Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sejam eles humilhados e aterrorizados para sempre;",
          "pereçam em completa desgraça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Saibam eles que tu, cujo nome é Senhor,",
          "somente tu, és o Altíssimo sobre toda a terra."
        ],
        "rlw_lines": []
      }
    ]
  },
