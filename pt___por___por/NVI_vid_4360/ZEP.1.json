  "chapter": {
    "usfm": "ZEP.1",
    "human": "Sofonias 1",
    "previous": {
      "usfm": "HAB.3",
      "human": "Habacuque 3"
    },
    "next": {
      "usfm": "ZEP.2",
      "human": "Sofonias 2"
