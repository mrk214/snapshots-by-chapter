    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Meus olhos viram tudo isso,",
          "meus ouvidos o ouviram e entenderam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O que vocês sabem, eu também sei;",
          "não sou inferior a vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mas desejo falar ao Todo-poderoso",
          "e defender a minha causa diante de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Vocês, porém, me difamam com mentiras;",
          "todos vocês são médicos que de nada valem!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Se tão somente ficassem calados,",
          "mostrariam sabedoria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Escutem agora o meu argumento;",
          "prestem atenção à réplica de meus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Vocês vão falar com maldade em nome de Deus?",
          "Vão falar enganosamente a favor dele?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Vão revelar parcialidade por ele?",
          "Vão defender a causa a favor de Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tudo iria bem se ele os examinasse?",
          "Vocês conseguiriam enganá-lo",
          "como podem enganar os homens?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Com certeza ele os repreenderia",
          "se, no íntimo, vocês fossem parciais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O esplendor dele não os aterrorizaria?",
          "O pavor dele não cairia sobre vocês?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "As máximas que vocês citam são provérbios de cinza;",
          "suas defesas não passam de barro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Aquietem-se e deixem-me falar,",
          "e aconteça comigo o que acontecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Por que me ponho em perigo",
          "e tomo a minha vida em minhas mãos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Embora ele me mate, ainda assim esperarei nele;",
          "certo é que defenderei os meus caminhos diante dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Aliás, será essa a minha libertação,",
          "pois nenhum ímpio ousaria apresentar-se a ele!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Escutem atentamente as minhas palavras;",
          "que os seus ouvidos acolham o que eu digo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Agora que preparei a minha defesa,",
          "sei que serei justificado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Haverá quem me acuse?",
          "Se houver, ficarei calado e morrerei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "“Concede-me só estas duas coisas, ó Deus,",
          "e não me esconderei de ti:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Afasta de mim a tua mão",
          "e não mais me assustes com os teus terrores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Chama-me, e eu responderei,",
          "ou deixa-me falar, e tu responderás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Quantos erros e pecados cometi?",
          "Mostra-me a minha falta e o meu pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Por que escondes o teu rosto",
          "e me consideras teu inimigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Atormentarás uma folha levada pelo vento?",
          "Perseguirás a palha?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Pois fazes constar contra mim coisas amargas",
          "e me fazes herdar os pecados da minha juventude."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Acorrentas os meus pés",
          "e vigias todos os meus caminhos,",
          "pondo limites aos meus passos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "“Assim o homem se consome como coisa podre,",
          "como a roupa que a traça vai roendo."
        ],
        "rlw_lines": []
      }
    ]
  },
