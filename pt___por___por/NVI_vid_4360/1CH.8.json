    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os Descendentes de Benjamim"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Benjamim gerou",
          "Belá, seu filho mais velho;",
          "Asbel, seu segundo filho, Aará, o terceiro;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Noá, o quarto; e Rafa, o quinto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Estes foram os filhos de Belá:",
          "Adar, Gera, pai de Eúde,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Abisua, Naamã, Aoá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Gera, Sefufá e Hurão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Estes foram os descendentes de Eúde, chefes das famílias dos habitantes de Geba, que foram deportados para Manaate:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Naamã, Aías e Gera. Esse Gera, pai de Uzá e de Aiúde, foi quem os deportou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Depois de ter se divorciado de suas mulheres Husim e Baara, Saaraim teve filhos na terra de Moabe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Com sua mulher Hodes ele gerou Jobabe, Zíbia, Messa, Malcã,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Jeús, Saquias e Mirma. Esses foram seus filhos, chefes de famílias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Com Husim ele gerou Abitube e Elpaal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Estes foram os filhos de Elpaal:",
          "Héber, Misã, Semede, que fundou Ono e Lode com seus povoados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Berias e Sema foram os chefes das famílias dos habitantes de Aijalom e foram eles que expulsaram os habitantes de Gate."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Aiô, Sasaque, Jeremote,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Zebadias, Arade, Éder,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Micael, Ispa e Joá foram descendentes de Berias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Zebadias, Mesulão, Hizqui, Héber,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ismerai, Izlias e Jobabe foram descendentes de Elpaal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Jaquim, Zicri, Zabdi,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Elienai, Ziletai, Eliel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Adaías, Beraías e Sinrate foram descendentes de Simei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ispã, Héber, Eliel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Abdom, Zicri, Hanã,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Hananias, Elão, Antotias,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Ifdeias e Penuel foram descendentes de Sasaque."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Sanserai, Searias, Atalias,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Jaaresias, Elias e Zicri foram descendentes de Jeroão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Todos esses foram chefes de famílias, líderes, conforme alistados em suas genealogias, e moravam em Jerusalém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Jeiel, pai de Gibeom, morou na cidade de Gibeom.",
          "O nome de sua mulher era Maaca;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "o de seu filho mais velho, Abdom; e o de seus outros filhos, Zur, Quis, Baal, Ner, Nadabe,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Gedor, Aiô, Zequer"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "e Miclote, que gerou Simeia. Eles também moravam perto de seus parentes, em Jerusalém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Ner gerou Quis, que gerou Saul. Saul gerou Jônatas, Malquisua, Abinadabe e Esbaal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "O filho de Jônatas foi",
          "Meribe-Baal, que gerou Mica."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Estes foram os filhos de Mica:",
          "Pitom, Meleque, Tareia e Acaz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Acaz gerou Jeoada, Jeoada gerou Alemete, Azmavete e Zinri, e Zinri gerou Mosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Mosa gerou Bineá, pai de Rafa, que foi o pai de Eleasa, pai de Azel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Azel teve seis filhos chamados",
          "Azricão, Bocru, Ismael, Searias, Obadias e Hanã. Todos esses foram filhos de Azel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Estes foram os filhos de Eseque, seu irmão:",
          "Ulão, o mais velho; Jeús, o segundo; e Elifelete, o terceiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Os filhos de Ulão eram soldados valentes e bons flecheiros. Tiveram muitos filhos e netos, eram cento e cinquenta ao todo.",
          "Todos esses foram descendentes de Benjamim."
        ],
        "rlw_lines": []
      }
    ]
  },
