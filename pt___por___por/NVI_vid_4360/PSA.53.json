    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para o mestre de música. De acordo com mahalath. Poema davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Diz o tolo em seu coração:",
          "“Deus não existe!”",
          "Corromperam-se e cometeram injustiças detestáveis;",
          "não há ninguém que faça o bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deus olha lá dos céus",
          "para os filhos dos homens,",
          "para ver se há alguém que tenha entendimento,",
          "alguém que busque a Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Todos se desviaram,",
          "igualmente se corromperam;",
          "não há ninguém que faça o bem;",
          "nem um sequer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Será que os malfeitores não aprendem?",
          "Eles devoram o meu povo como quem come pão",
          "e não clamam a Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Olhem! Estão tomados de pavor,",
          "quando não existe motivo algum para temer!",
          "Pois foi Deus quem espalhou os ossos",
          "dos que atacaram você;",
          "você os humilhou porque Deus os rejeitou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ah, se de Sião viesse a salvação para Israel!",
          "Quando Deus restaurar o seu povo,",
          "Jacó exultará! Israel se regozijará!"
        ],
        "rlw_lines": []
      }
    ]
  },
