    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palavras que Amós, criador de ovelhas em Tecoa, recebeu em visões, a respeito de Israel, dois anos antes do terremoto. Nesse tempo, Uzias era rei de Judá e Jeroboão, filho de Jeoás, era rei de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele disse:",
          "“O Senhor ruge de Sião",
          "e troveja de Jerusalém;",
          "secam-se as pastagens dos pastores,",
          "e murcha o topo do Carmelo”."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Julgamento dos Povos Vizinhos de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões de Damasco",
          "e ainda mais por quatro, não anularei o castigo.",
          "Porque trilhou Gileade",
          "com trilhos de ferro pontudos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "porei fogo na casa de Hazael,",
          "e as chamas consumirão as fortalezas de Ben-Hadade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Derrubarei a porta de Damasco;",
          "destruirei o rei que está no vale de Áven",
          "e aquele que segura o cetro em Bete-Éden.",
          "O povo da Síria irá para o exílio em Quir”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões de Gaza,",
          "e ainda mais por quatro, não anularei o castigo.",
          "Porque levou cativas comunidades inteiras",
          "e as vendeu a Edom,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "porei fogo nos muros de Gaza,",
          "e as chamas consumirão as suas fortalezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Destruirei o rei de Asdode",
          "e aquele que segura o cetro em Ascalom.",
          "Erguerei a minha mão contra Ecrom,",
          "até que morra o último dos filisteus”,",
          "diz o Senhor, o Soberano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões de Tiro,",
          "e ainda mais por quatro,",
          "não anularei o castigo.",
          "Porque vendeu comunidades inteiras de cativos a Edom,",
          "desprezando irmãos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "porei fogo nos muros de Tiro,",
          "e as chamas consumirão as suas fortalezas”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões de Edom,",
          "e ainda mais por quatro, não anularei o castigo.",
          "Porque com a espada perseguiu seu irmão",
          "e reprimiu toda a compaixão,",
          "mutilando-o furiosamente",
          "e perpetuando para sempre a sua ira,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "porei fogo em Temã,",
          "e as chamas consumirão as fortalezas de Bozra”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões de Amom,",
          "e ainda mais por quatro,",
          "não anularei o castigo.",
          "Porque rasgou ao meio as grávidas de Gileade",
          "a fim de ampliar as suas fronteiras,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "porei fogo nos muros de Rabá,",
          "e as chamas consumirão as suas fortalezas",
          "em meio a gritos de guerra no dia do combate,",
          "em meio a ventos violentos num dia de tempestade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O seu rei irá para o exílio,",
          "ele e toda a sua corte”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
