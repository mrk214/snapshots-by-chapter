    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para o mestre de música. Salmo davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Que o Senhor te responda no tempo da angústia;",
          "o nome do Deus de Jacó te proteja!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Do santuário te envie auxílio",
          "e de Sião te dê apoio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Lembre-se de todas as tuas ofertas",
          "e aceite os teus holocaustos."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Conceda-te o desejo do teu coração",
          "e leve a efeito todos os teus planos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Saudaremos a tua vitória com gritos de alegria",
          "e ergueremos as nossas bandeiras em nome do nosso Deus.",
          "Que o Senhor atenda a todos os teus pedidos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Agora sei que o Senhor",
          "dará vitória ao seu ungido;",
          "dos seus santos céus lhe responde",
          "com o poder salvador da sua mão direita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Alguns confiam em carros e outros em cavalos,",
          "mas nós confiamos no nome do Senhor, o nosso Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eles vacilam e caem,",
          "mas nós nos erguemos e estamos firmes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Senhor, concede vitória ao rei!",
          "Responde-nos quando clamamos!"
        ],
        "rlw_lines": []
      }
    ]
  },
