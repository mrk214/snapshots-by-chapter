    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Atribuam ao Senhor, ó seres celestiais,",
          "atribuam ao Senhor glória e força."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Atribuam ao Senhor",
          "a glória que o seu nome merece;",
          "adorem o Senhor",
          "no esplendor do seu santuário."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A voz do Senhor ressoa sobre as águas;",
          "o Deus da glória troveja,",
          "o Senhor troveja sobre as muitas águas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A voz do Senhor é poderosa;",
          "a voz do Senhor é majestosa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A voz do Senhor quebra os cedros;",
          "o Senhor despedaça os cedros do Líbano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ele faz o Líbano saltar como bezerro,",
          "o Siriom como novilho selvagem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A voz do Senhor corta os céus",
          "com raios flamejantes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A voz do Senhor faz tremer o deserto;",
          "o Senhor faz tremer o deserto de Cades."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A voz do Senhor retorce os carvalhos",
          "e despe as florestas.",
          "E no seu templo todos clamam: “Glória!”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O Senhor assentou-se soberano sobre o Dilúvio;",
          "o Senhor reina soberano para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor dá força ao seu povo;",
          "o Senhor dá a seu povo a bênção da paz."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
