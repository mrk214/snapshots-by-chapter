    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Testemunhas Convocadas para Acusar Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ouçam esta palavra que o Senhor falou contra vocês, ó israelitas; contra toda esta família que tirei do Egito:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Escolhi apenas vocês",
          "de todas as famílias da terra;",
          "por isso eu os castigarei",
          "por todas as suas maldades”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Duas pessoas andarão juntas",
          "se não estiverem de acordo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O leão ruge na floresta",
          "se não apanhou presa alguma?",
          "O leão novo ruge em sua toca",
          "se nada caçou?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Cai o pássaro numa armadilha",
          "que não foi armada?",
          "Será que a armadilha se desarma",
          "se nada foi apanhado?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quando a trombeta toca na cidade,",
          "o povo não treme?",
          "Ocorre alguma desgraça na cidade",
          "sem que o Senhor a tenha mandado?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Certamente o Senhor, o Soberano,",
          "não faz coisa alguma",
          "sem revelar o seu plano",
          "aos seus servos, os profetas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O leão rugiu,",
          "quem não temerá?",
          "O Senhor, o Soberano, falou,",
          "quem não profetizará?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Proclamem nos palácios de Asdode e do Egito:",
          "“Reúnam-se nos montes de Samaria",
          "para verem o grande tumulto que há ali,",
          "e a opressão no meio do seu povo”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Eles não sabem agir com retidão”,",
          "declara o Senhor,",
          "“eles, que acumulam em seus palácios",
          "o que roubaram e saquearam”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Portanto, assim diz o Senhor, o Soberano:",
          "“Um inimigo cercará o país.",
          "Ele derrubará as suas fortalezas",
          "e saqueará os seus palácios”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Assim como o pastor livra a ovelha,",
          "arrancando da boca do leão só dois ossos da perna",
          "ou um pedaço da orelha,",
          "assim serão arrancados os israelitas de Samaria,",
          "com a ponta de uma cama",
          "e um pedaço de sofá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Ouçam isto e testemunhem contra a descendência de Jacó”, declara o Senhor, o Soberano, o Deus dos Exércitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“No dia em que eu castigar Israel",
          "por causa dos seus pecados,",
          "destruirei os altares de Betel;",
          "as pontas do altar serão cortadas e cairão no chão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Derrubarei a casa de inverno",
          "junto com a casa de verão;",
          "as casas enfeitadas de marfim serão destruídas,",
          "e as mansões desaparecerão”,",
          "declara o Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
