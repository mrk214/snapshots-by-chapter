    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deem graças ao Senhor, porque ele é bom.",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deem graças ao Deus dos deuses.",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Deem graças ao Senhor dos senhores.",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ao único que faz grandes maravilhas,",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que com habilidade fez os céus,",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Que estendeu a terra sobre as águas;",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Àquele que fez os grandes luminares:",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O sol para governar o dia,",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A lua e as estrelas para governarem a noite.",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Àquele que matou os primogênitos do Egito",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "E tirou Israel do meio deles",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Com mão poderosa e braço forte.",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Àquele que dividiu o mar Vermelho",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "E fez Israel atravessá-lo,",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mas lançou o faraó e o seu exército no mar Vermelho.",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Àquele que conduziu seu povo pelo deserto,",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Feriu grandes reis",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "E matou reis poderosos:",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Seom, rei dos amorreus,",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "E Ogue, rei de Basã,",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "E deu a terra deles como herança,",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Como herança ao seu servo Israel.",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Àquele que se lembrou de nós quando fomos humilhados",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "E nos livrou dos nossos adversários;",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Àquele que dá alimento a todos os seres vivos.",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Deem graças ao Deus dos céus.",
          "O seu amor dura para sempre!"
        ],
        "rlw_lines": []
