    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de Peregrinação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quando o Senhor trouxe os cativos",
          "de volta a Sião, foi como um sonho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Então a nossa boca encheu-se de riso",
          "e a nossa língua de cantos de alegria.",
          "Até nas outras nações se dizia:",
          "“O Senhor fez coisas grandiosas por este povo”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sim, coisas grandiosas fez o Senhor por nós,",
          "por isso estamos alegres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Senhor, restaura-nos,",
          "assim como enches o leito dos ribeiros no deserto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aqueles que semeiam com lágrimas,",
          "com cantos de alegria colherão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Aquele que sai chorando",
          "enquanto lança a semente,",
          "voltará com cantos de alegria,",
          "trazendo os seus feixes."
        ],
        "rlw_lines": []
      }
    ]
  },
