  },
  "chapter": {
    "chapter_usfm": "1CH.6",
    "previous": {
      "usfm": "1CH.5",
      "human": "1 Crônicas 5"
    },
    "current": {
      "usfm": "1CH.6",
      "human": "1 Crônicas 6"
