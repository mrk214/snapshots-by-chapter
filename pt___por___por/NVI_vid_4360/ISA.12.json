    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ação de Graças"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Naquele dia, você dirá:",
          "“Eu te louvarei, Senhor!",
          "Pois estavas irado contra mim,",
          "mas a tua ira desviou-se,",
          "e tu me consolaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deus é a minha salvação;",
          "terei confiança e não temerei.",
          "O Senhor, sim, o Senhor",
          "é a minha força e o meu cântico;",
          "ele é a minha salvação!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Com alegria vocês tirarão água",
          "das fontes da salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Naquele dia, vocês dirão:",
          "“Louvem o Senhor, invoquem o seu nome;",
          "anunciem entre as nações os seus feitos,",
          "e façam-nas saber que o seu nome é exaltado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Cantem louvores ao Senhor, pois ele tem feito coisas gloriosas,",
          "sejam elas conhecidas em todo o mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Gritem bem alto e cantem de alegria, habitantes de Sião,",
          "pois grande é o Santo de Israel no meio de vocês”."
        ],
        "rlw_lines": []
      }
    ]
  },
