    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para o mestre de música. Salmo davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O rei se alegra na tua força, ó Senhor!",
          "Como é grande a sua exultação pelas vitórias que lhe dás!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tu lhe concedeste o desejo do seu coração",
          "e não lhe rejeitaste o pedido dos seus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tu o recebeste dando-lhe ricas bênçãos,",
          "e em sua cabeça puseste uma coroa de ouro puro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ele te pediu vida, e tu lhe deste!",
          "Vida longa e duradoura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pelas vitórias que lhe deste, grande é a sua glória;",
          "de esplendor e majestade o cobriste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Fizeste dele uma grande bênção para sempre",
          "e lhe deste a alegria da tua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O rei confia no Senhor:",
          "por causa da fidelidade do Altíssimo ele não será abalado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tua mão alcançará todos os teus inimigos;",
          "tua mão direita atingirá todos os que te odeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No dia em que te manifestares",
          "farás deles uma fornalha ardente.",
          "Na sua ira o Senhor os devorará,",
          "um fogo os consumirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Acabarás com a geração deles na terra,",
          "com a sua descendência entre os homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Embora tramem o mal contra ti",
          "e façam planos perversos, nada conseguirão;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "pois tu os porás em fuga",
          "quando apontares para eles o teu arco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sê exaltado, Senhor, na tua força!",
          "Cantaremos e louvaremos o teu poder."
        ],
        "rlw_lines": []
      }
    ]
  },
