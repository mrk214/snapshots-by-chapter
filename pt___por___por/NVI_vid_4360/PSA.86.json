    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oração davídica."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Inclina os teus ouvidos, ó Senhor, e responde-me,",
          "pois sou pobre e necessitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Guarda a minha vida, pois sou fiel a ti.",
          "Tu és o meu Deus;",
          "salva o teu servo que em ti confia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Misericórdia, Senhor,",
          "pois clamo a ti sem cessar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alegra o coração do teu servo,",
          "pois a ti, Senhor, elevo a minha alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu és bondoso e perdoador, Senhor,",
          "rico em graça para com todos os que te invocam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Escuta a minha oração, Senhor;",
          "atenta para a minha súplica!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "No dia da minha angústia clamarei a ti,",
          "pois tu me responderás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Nenhum dos deuses é comparável a ti, Senhor,",
          "nenhum deles pode fazer o que tu fazes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Todas as nações que tu formaste",
          "virão e te adorarão, Senhor,",
          "e glorificarão o teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois tu és grande e realizas feitos maravilhosos;",
          "só tu és Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ensina-me o teu caminho, Senhor,",
          "para que eu ande na tua verdade;",
          "dá-me um coração inteiramente fiel,",
          "para que eu tema o teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "De todo o meu coração te louvarei, Senhor, meu Deus;",
          "glorificarei o teu nome para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pois grande é o teu amor para comigo;",
          "tu me livraste das profundezas do Sheol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Os arrogantes estão me atacando, ó Deus;",
          "um bando de homens cruéis,",
          "gente que não faz caso de ti procura tirar-me a vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mas tu, Senhor, és Deus compassivo e misericordioso,",
          "muito paciente, rico em amor e em fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Volta-te para mim! Tem misericórdia de mim!",
          "Concede a tua força a teu servo",
          "e salva o filho da tua serva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Dá-me um sinal da tua bondade,",
          "para que os meus inimigos vejam e sejam humilhados,",
          "pois tu, Senhor, me ajudaste e me consolaste."
        ],
        "rlw_lines": []
      }
    ]
  },
