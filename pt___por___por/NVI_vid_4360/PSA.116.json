    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu amo o Senhor, porque ele me ouviu",
          "quando lhe fiz a minha súplica."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele inclinou os seus ouvidos para mim;",
          "eu o invocarei toda a minha vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "As cordas da morte me envolveram,",
          "as angústias do Sheol vieram sobre mim;",
          "aflição e tristeza me dominaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Então clamei pelo nome do Senhor:",
          "Livra-me, Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor é misericordioso e justo;",
          "o nosso Deus é compassivo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor protege os simples;",
          "quando eu já estava sem forças, ele me salvou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Retorne ao seu descanso, ó minha alma,",
          "porque o Senhor tem sido bom para você!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pois tu me livraste da morte,",
          "livraste os meus olhos das lágrimas",
          "e os meus pés de tropeçar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para que eu pudesse andar diante do Senhor",
          "na terra dos viventes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eu cri, ainda que tenha dito:",
          "Estou muito aflito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Em pânico eu disse:",
          "Ninguém merece confiança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Como posso retribuir ao Senhor",
          "toda a sua bondade para comigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Erguerei o cálice da salvação",
          "e invocarei o nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cumprirei para com o Senhor os meus votos,",
          "na presença de todo o seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O Senhor vê com pesar",
          "a morte de seus fiéis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Senhor, sou teu servo,",
          "Sim, sou teu servo, filho da tua serva;",
          "livraste-me das minhas correntes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Oferecerei a ti um sacrifício de gratidão",
          "e invocarei o nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cumprirei para com o Senhor os meus votos,",
          "na presença de todo o seu povo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "nos pátios da casa do Senhor,",
          "no seu interior, ó Jerusalém!",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
