    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para o mestre de música. Salmo davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ouve-me, ó Deus, quando faço a minha queixa;",
          "protege a minha vida do inimigo ameaçador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Defende-me da conspiração dos ímpios",
          "e da ruidosa multidão de malfeitores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Eles afiam a língua como espada",
          "e apontam, como flechas, palavras envenenadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "De onde estão emboscados atiram no homem íntegro;",
          "atiram de surpresa, sem nenhum temor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Animam-se uns aos outros com planos malignos,",
          "combinam como ocultar as suas armadilhas,",
          "e dizem: “Quem as verá?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tramam a injustiça e dizem:",
          "“Fizemos um plano perfeito!”",
          "A mente e o coração de cada um deles o escondem!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mas Deus atirará neles suas flechas;",
          "repentinamente serão atingidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pelas próprias palavras farão cair uns aos outros;",
          "menearão a cabeça e zombarão deles",
          "todos os que os virem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Todos os homens temerão",
          "e proclamarão as obras de Deus,",
          "refletindo no que ele fez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Alegrem-se os justos no Senhor",
          "e nele busquem refúgio;",
          "congratulem-se todos os retos de coração!"
        ],
        "rlw_lines": []
      }
    ]
  },
