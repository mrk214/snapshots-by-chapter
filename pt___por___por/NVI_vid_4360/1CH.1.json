    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Descendência de Adão"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Adão, Sete, Enos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cainã, Maalaleel, Jarede,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enoque, Matusalém, Lameque,",
          "Noé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Estes foram os filhos de Noé: Sem, Cam e Jafé."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os Descendentes dos Filhos de Noé"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Estes foram os filhos de Jafé:",
          "Gômer, Magogue, Madai, Javã, Tubal, Meseque e Tirás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Estes foram os filhos de Gômer:",
          "Asquenaz, Rifate e Togarma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Estes foram os filhos de Javã:",
          "Elisá, Társis, Quitim e Rodanim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Estes foram os filhos de Cam:",
          "Cuxe, Mizraim, Fute e Canaã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Estes foram os filhos de Cuxe:",
          "Sebá, Havilá, Sabtá, Raamá e Sabtecá.",
          "Estes foram os filhos de Raamá:",
          "Sabá e Dedã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cuxe gerou",
          "Ninrode, o primeiro homem poderoso na terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mizraim gerou",
          "os luditas, os anamitas, os leabitas, os naftuítas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "os patrusitas, os casluítas, dos quais se originaram os filisteus, e os caftoritas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Canaã gerou",
          "Sidom, seu filho mais velho, e Hete,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "como também os jebuseus, os amorreus, os girgaseus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "os heveus, os arqueus, os sineus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "os arvadeus, os zemareus e os hamateus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Estes foram os filhos de Sem:",
          "Elão, Assur, Arfaxade, Lude e Arã.",
          "Estes foram os filhos de Arã:",
          "Uz, Hul, Géter e Meseque."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Arfaxade gerou Salá,",
          "e este gerou Héber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A Héber nasceram dois filhos:",
          "um deles se chamou Pelegue, porque em sua época a terra foi dividida; seu irmão chamou-se Joctã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Joctã gerou",
          "Almodá, Salefe, Hazarmavé, Jerá, 2"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Adorão, Uzal, Dicla,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Obal, Abimael, Sabá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ofir, Havilá e Jobabe. Todos esses foram filhos de Joctã."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Descendência de Sem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Sem, Arfaxade, Salá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Héber, Pelegue, Reú,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Serugue, Naor, Terá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "e Abrão, que é Abraão."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os Descendentes de Abraão"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Estes foram os filhos de Abraão: Isaque e Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Foram estes os seus descendentes:",
          "Nebaiote, o filho mais velho de Ismael, Quedar, Adbeel, Mibsão,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Misma, Dumá, Massá, Hadade, Temá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Jetur, Nafis e Quedemá.",
          "Esses foram os filhos de Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Estes foram os filhos de Abraão com sua concubina Quetura:",
          "Zinrã, Jocsã, Medã, Midiã, Isbaque e Suá.",
          "Foram estes os filhos de Jocsã:",
          "Sabá e Dedã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Foram estes os filhos de Midiã:",
          "Efá, Éfer, Enoque, Abida e Elda.",
          "Todos esses foram descendentes de Quetura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Abraão gerou Isaque.",
          "Estes foram os filhos de Isaque:",
          "Esaú e Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os Descendentes de Esaú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Estes foram os filhos de Esaú:",
          "Elifaz, Reuel, Jeús, Jalão e Corá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Estes foram os filhos de Elifaz:",
          "Temã, Omar, Zefô, Gaetã e Quenaz;",
          "e Amaleque, de Timna, sua concubina."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Estes foram os filhos de Reuel:",
          "Naate, Zerá, Samá e Mizá."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os Descendentes de Seir"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Estes foram os filhos de Seir:",
          "Lotã, Sobal, Zibeão, Aná, Disom, Ézer e Disã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Estes foram os filhos de Lotã:",
          "Hori e Homã. Lotã tinha uma irmã chamada Timna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Estes foram os filhos de Sobal:",
          "Alvã, Manaate, Ebal, Sefô e Onã.",
          "Estes foram os filhos de Zibeão:",
          "Aiá e Aná."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Este foi o filho de Aná:",
          "Disom.",
          "Estes foram os filhos de Disom:",
          "Hendã, Esbã, Itrã e Querã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Estes foram os filhos de Ézer:",
          "Bilã, Zaavã e Acã.",
          "Estes foram os filhos de Disã:",
          "Uz e Arã."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os Reis e os Chefes de Edom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Estes foram os reis que reinaram no território de Edom antes que os israelitas tivessem um rei:",
          "Belá, filho de Beor. Sua cidade chamava-se Dinabá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Belá morreu; e Jobabe, filho de Zerá, de Bozra, foi o seu sucessor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Jobabe morreu; e Husã, da terra dos temanitas, foi o seu sucessor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Husã morreu; e Hadade, filho de Bedade, que tinha derrotado os midianitas na terra de Moabe, foi o seu sucessor. Sua cidade chamava-se Avite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Hadade morreu; e Samlá de Masreca foi o seu sucessor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Samlá morreu; e Saul, de Reobote, próxima ao Eufrates, foi o seu sucessor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Saul morreu; e Baal-Hanã, filho de Acbor, foi o seu sucessor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Baal-Hanã morreu, e Hadade foi o seu sucessor. Sua cidade chamava-se Paú, e o nome de sua mulher era Meetabel, filha de Matrede e neta de Mezaabe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Após a morte de Hadade, Edom foi governada pelos seguintes chefes:",
          "Timna, Alva, Jetete,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Oolibama, Elá, Pinom,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Quenaz, Temã, Mibzar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Magdiel e Irã.",
          "Foram esses os chefes de Edom."
        ],
        "rlw_lines": []
      }
    ]
  },
