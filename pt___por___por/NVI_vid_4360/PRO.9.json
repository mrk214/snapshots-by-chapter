    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os Convites da Sabedoria e da Insensatez"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A sabedoria construiu sua casa;",
          "ergueu suas sete colunas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Matou animais para a refeição,",
          "preparou seu vinho e arrumou sua mesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enviou suas servas para fazerem convites",
          "desde o ponto mais alto da cidade, clamando:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Venham todos os inexperientes!”",
          "Aos que não têm bom senso ela diz:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Venham comer a minha comida",
          "e beber o vinho que preparei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Deixem a insensatez, e vocês terão vida;",
          "andem pelo caminho do entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Quem corrige o zombador traz sobre si o insulto;",
          "quem repreende o ímpio mancha o próprio nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Não repreenda o zombador,",
          "caso contrário ele o odiará;",
          "repreenda o sábio, e ele o amará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Instrua o homem sábio, e ele será ainda mais sábio;",
          "ensine o homem justo, e ele aumentará o seu saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“O temor do Senhor é o princípio da sabedoria,",
          "e o conhecimento do Santo é entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pois por meu intermédio os seus dias serão multiplicados,",
          "e o tempo da sua vida se prolongará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Se você for sábio, o benefício será seu;",
          "se for zombador, sofrerá as consequências”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "A insensatez é pura exibição,",
          "sedução e ignorância."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sentada à porta de sua casa,",
          "no ponto mais alto da cidade,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "clama aos que passam por ali",
          "seguindo o seu caminho:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "“Venham todos os inexperientes!”",
          "Aos que não têm bom senso ela diz:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“A água roubada é doce,",
          "e o pão que se come escondido é saboroso!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Mas eles nem imaginam que ali estão os espíritos dos mortos,",
          "que os seus convidados estão nas profundezas da sepultura."
        ],
        "rlw_lines": []
      }
    ]
  },
