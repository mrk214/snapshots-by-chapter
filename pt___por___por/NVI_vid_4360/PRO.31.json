    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ditados do Rei Lemuel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ditados do rei Lemuel; uma exortação que sua mãe lhe fez:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Ó meu filho, filho do meu ventre,",
          "filho de meus votos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "não gaste sua força com mulheres,",
          "seu vigor com aquelas que destroem reis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Não convém aos reis, ó Lemuel;",
          "não convém aos reis beber vinho,",
          "não convém aos governantes desejar bebida fermentada,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "para não suceder que bebam e se esqueçam do que a lei determina",
          "e deixem de fazer justiça aos oprimidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dê bebida fermentada aos que estão prestes a morrer,",
          "vinho aos que estão angustiados;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para que bebam e se esqueçam da sua pobreza,",
          "e não mais se lembrem da sua infelicidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Erga a voz em favor dos que não podem defender-se,",
          "seja o defensor de todos os desamparados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Erga a voz e julgue com justiça;",
          "defenda os direitos dos pobres e dos necessitados”."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Epílogo: A Mulher Exemplar"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Uma esposa exemplar; feliz quem a encontrar!",
          "É muito mais valiosa que os rubis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Seu marido tem plena confiança nela",
          "e nunca lhe falta coisa alguma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ela só lhe faz o bem, e nunca o mal,",
          "todos os dias da sua vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Escolhe a lã e o linho",
          "e com prazer trabalha com as mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Como os navios mercantes,",
          "ela traz de longe as suas provisões."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Antes de clarear o dia ela se levanta,",
          "prepara comida para todos os de casa",
          "e dá tarefas às suas servas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ela avalia um campo e o compra;",
          "com o que ganha planta uma vinha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Entrega-se com vontade ao seu trabalho;",
          "seus braços são fortes e vigorosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Administra bem o seu comércio lucrativo,",
          "e a sua lâmpada fica acesa durante a noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Nas mãos segura o fuso",
          "e com os dedos pega a roca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Acolhe os necessitados",
          "e estende as mãos aos pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Não teme por seus familiares quando chega a neve,",
          "pois todos eles vestem agasalhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Faz cobertas para a sua cama;",
          "veste-se de linho fino e de púrpura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Seu marido é respeitado na porta da cidade,",
          "onde toma assento entre as autoridades da sua terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Ela faz vestes de linho e as vende,",
          "e fornece cintos aos comerciantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Reveste-se de força e dignidade;",
          "sorri diante do futuro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Fala com sabedoria",
          "e ensina com amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Cuida dos negócios de sua casa",
          "e não dá lugar à preguiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Seus filhos se levantam e a elogiam;",
          "seu marido também a elogia, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "“Muitas mulheres são exemplares,",
          "mas você a todas supera”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "A beleza é enganosa, e a formosura é passageira;",
          "mas a mulher que teme o Senhor será elogiada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Que ela receba a recompensa merecida,",
          "e as suas obras sejam elogiadas à porta da cidade."
        ],
        "rlw_lines": []
      }
    ]
  },
