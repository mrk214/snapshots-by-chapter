    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Não a nós, Senhor, nenhuma glória para nós,",
          "mas sim ao teu nome,",
          "por teu amor e por tua fidelidade!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Por que perguntam as nações:",
          "“Onde está o Deus deles?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O nosso Deus está nos céus,",
          "e pode fazer tudo o que lhe agrada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os ídolos deles, de prata e ouro,",
          "são feitos por mãos humanas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Têm boca, mas não podem falar;",
          "olhos, mas não podem ver;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "têm ouvidos, mas não podem ouvir;",
          "nariz, mas não podem sentir cheiro;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "têm mãos, mas nada podem apalpar;",
          "pés, mas não podem andar;",
          "e não emitem som algum com a garganta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tornem-se como eles aqueles que os fazem",
          "e todos os que neles confiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Confie no Senhor, ó Israel!",
          "Ele é o seu socorro e o seu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Confiem no Senhor, sacerdotes!",
          "Ele é o seu socorro e o seu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Vocês que temem o Senhor,",
          "confiem no Senhor!",
          "Ele é o seu socorro e o seu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O Senhor lembra-se de nós e nos abençoará;",
          "abençoará os israelitas,",
          "abençoará os sacerdotes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "abençoará os que temem o Senhor,",
          "do menor ao maior."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Que o Senhor os multiplique,",
          "vocês e os seus filhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Sejam vocês abençoados pelo Senhor,",
          "que fez os céus e a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Os mais altos céus pertencem ao Senhor,",
          "mas a terra, ele a confiou ao homem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os mortos não louvam o Senhor,",
          "tampouco nenhum dos que descem ao silêncio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Mas nós bendiremos o Senhor,",
          "desde agora e para sempre!",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
