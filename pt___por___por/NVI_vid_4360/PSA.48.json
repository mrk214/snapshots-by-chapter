  "chapter": {
    "usfm": "PSA.48",
    "human": "Salmos 48",
    "previous": {
      "usfm": "PSA.47",
      "human": "Salmos 47"
    },
    "next": {
      "usfm": "PSA.49",
      "human": "Salmos 49"
