},{"type":"verse","verse_numbers":[8],"lines":["Como já temos ouvido,","agora também temos visto","na cidade do Senhor dos Exércitos,","na cidade de nosso Deus:","Deus a preserva firme para sempre."],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["Pausa"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["No teu templo, ó Deus,","meditamos em teu amor leal."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Como o teu nome, ó Deus,","o teu louvor alcança os confins da terra;","a tua mão direita está cheia de justiça."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["O monte Sião se alegra,","as cidades de Judá exultam","por causa das tuas decisões justas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Percorram Sião, contornando-a,","contem as suas torres,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["observem bem as suas muralhas,","examinem as suas cidadelas,","para que vocês falem à próxima geração"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["que este Deus é o nosso Deus para todo o sempre;","ele será o nosso guia até o fim."],"rlw_lines":[]}]}}