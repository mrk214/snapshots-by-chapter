    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para o mestre de música. Salmo da família de Asafe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "É Deus quem preside a assembleia divina;",
          "no meio dos deuses, ele é o juiz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Até quando vocês vão absolver os culpados",
          "e favorecer os ímpios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Garantam justiça para os fracos e para os órfãos;",
          "mantenham os direitos dos necessitados e dos oprimidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Livrem os fracos e os pobres;",
          "libertem-nos das mãos dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Eles nada sabem, nada entendem.",
          "Vagueiam pelas trevas;",
          "todos os fundamentos da terra estão abalados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Eu disse: ‘Vocês são deuses,",
          "todos vocês são filhos do Altíssimo’."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mas vocês morrerão como simples homens;",
          "cairão como qualquer outro governante.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Levanta-te, ó Deus, julga a terra,",
          "pois todas as nações te pertencem."
        ],
        "rlw_lines": []
      }
    ]
  },
