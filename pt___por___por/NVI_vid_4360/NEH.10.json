        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pasur, Amarias, Malquias,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
