    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para o mestre de música. De acordo com a melodia Não Destruas. Poema epigráfico davídico. Quando Davi fugiu de Saul para a caverna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Misericórdia, ó Deus; misericórdia,",
          "pois em ti a minha alma se refugia.",
          "Eu me refugiarei à sombra das tuas asas,",
          "até que passe o perigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Clamo ao Deus Altíssimo,",
          "a Deus, que para comigo cumpre o seu propósito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dos céus ele me envia a salvação,",
          "põe em fuga os que me perseguem de perto;"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Deus envia o seu amor e a sua fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Estou em meio a leões,",
          "ávidos para devorar;",
          "seus dentes são lanças e flechas,",
          "sua língua é espada afiada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sê exaltado, ó Deus, acima dos céus!",
          "Sobre toda a terra esteja a tua glória!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Preparam armadilhas para os meus pés;",
          "fiquei muito abatido.",
          "Abriram uma cova no meu caminho,",
          "mas foram eles que nela caíram."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Meu coração está firme, ó Deus,",
          "meu coração está firme;",
          "cantarei ao som de instrumentos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Acorde, minha alma!",
          "Acordem, harpa e lira!",
          "Vou despertar a alvorada!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Eu te louvarei, ó Senhor, entre as nações;",
          "cantarei teus louvores entre os povos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois o teu amor é tão grande que alcança os céus;",
          "a tua fidelidade vai até as nuvens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Sê exaltado, ó Deus, acima dos céus!",
          "Sobre toda a terra esteja a tua glória!"
        ],
        "rlw_lines": []
      }
    ]
