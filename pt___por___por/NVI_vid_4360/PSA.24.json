    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Do Senhor é a terra e tudo o que nela existe,",
          "o mundo e os que nele vivem;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "pois foi ele quem a estabeleceu sobre os mares",
          "e a firmou sobre as águas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quem poderá subir o monte do Senhor?",
          "Quem poderá entrar no seu Santo Lugar?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Aquele que tem as mãos limpas e o coração puro,",
          "que não recorre aos ídolos",
          "nem jura por deuses falsos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele receberá bênçãos do Senhor,",
          "e Deus, o seu Salvador, lhe fará justiça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "São assim aqueles que o buscam,",
          "que buscam a tua face, ó Deus de Jacó."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Abram-se, ó portais;",
          "abram-se, ó portas antigas,",
          "para que o Rei da glória entre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Quem é o Rei da glória?",
          "O Senhor forte e valente,",
          "o Senhor valente nas guerras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Abram-se, ó portais;",
          "abram-se, ó portas antigas,",
          "para que o Rei da glória entre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quem é esse Rei da glória?",
          "O Senhor dos Exércitos;",
          "ele é o Rei da glória!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
