    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entrei em meu jardim,",
          "minha irmã, minha noiva;",
          "ajuntei a minha mirra com as minhas especiarias.",
          "Comi o meu favo e o meu mel;",
          "bebi o meu vinho e o meu leite."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Poeta"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Comam, amigos,",
          "bebam quanto puderem, ó amados!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Eu estava quase dormindo,",
          "mas o meu coração estava acordado.",
          "Escutem! O meu amado está batendo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Abra-me a porta, minha irmã,",
          "minha querida, minha pomba,",
          "minha mulher ideal,",
          "pois a minha cabeça está encharcada de orvalho;",
          "o meu cabelo, da umidade da noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Já tirei a túnica;",
          "terei que vestir-me de novo?",
          "Já lavei os pés;",
          "terei que sujá-los de novo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O meu amado pôs a mão por uma abertura da tranca;",
          "meu coração começou a palpitar por causa dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Levantei-me para abrir-lhe a porta;",
          "minhas mãos destilavam mirra,",
          "meus dedos vertiam mirra,",
          "na maçaneta da tranca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu abri, mas o meu amado se fora;",
          "o meu amado já havia partido.",
          "Quase desmaiei de tristeza!",
          "Procurei-o, mas não o encontrei.",
          "Eu o chamei, mas ele não respondeu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "As sentinelas me encontraram",
          "enquanto faziam a ronda na cidade.",
          "Bateram-me, feriram-me;",
          "e tomaram o meu manto,",
          "as sentinelas dos muros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ó mulheres de Jerusalém, eu as faço jurar:",
          "se encontrarem o meu amado,",
          "que dirão a ele?",
          "Digam-lhe que estou doente de amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Amigas (As Mulheres de Jerusalém)"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Que diferença há entre o seu amado e outro qualquer,",
          "ó você, das mulheres a mais linda?",
          "Que diferença há entre o seu amado e outro qualquer,",
          "para você nos obrigar a tal promessa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O meu amado tem a pele bronzeada;",
          "ele se destaca entre dez mil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Sua cabeça é como ouro, o ouro mais puro;",
          "seus cabelos ondulam ao vento como ramos de palmeira;",
          "são negros como o corvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Seus olhos são como pombas",
          "junto aos regatos de água,",
          "lavados em leite,",
          "incrustados como joias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Suas faces são como um jardim de especiarias",
          "que exalam perfume.",
          "Seus lábios são como lírios",
          "que destilam mirra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Seus braços são cilindros de ouro",
          "com berilo neles engastado.",
          "Seu tronco é como marfim polido",
          "adornado de safiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Suas pernas são colunas de mármore",
          "firmadas em bases de ouro puro.",
          "Sua aparência é como o Líbano;",
          "ele é elegante como os cedros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Sua boca é a própria doçura;",
          "ele é mui desejável.",
          "Esse é o meu amado, esse é o meu querido,",
          "ó mulheres de Jerusalém."
        ],
        "rlw_lines": []
      }
    ]
  },
