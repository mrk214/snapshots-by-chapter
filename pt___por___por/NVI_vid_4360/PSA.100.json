        "lines": [
          "Salmo. Para ação de graças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aclamem o Senhor todos os habitantes da terra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Prestem culto ao Senhor com alegria;",
          "entrem na sua presença com cânticos alegres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Reconheçam que o Senhor é o nosso Deus.",
          "Ele nos fez e somos dele:",
          "somos o seu povo, e rebanho do seu pastoreio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Entrem por suas portas com ações de graças",
          "e em seus átrios com louvor;",
          "deem-lhe graças e bendigam o seu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois o Senhor é bom e o seu amor leal é eterno;",
          "a sua fidelidade permanece por todas as gerações."
        ],
        "rlw_lines": []
      }
    ]
