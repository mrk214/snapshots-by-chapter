    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quando Israel saiu do Egito",
          "e a casa de Jacó saiu do meio de um povo de língua estrangeira,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Judá tornou-se o santuário de Deus;",
          "Israel, o seu domínio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O mar olhou e fugiu,",
          "o Jordão retrocedeu;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "os montes saltaram como carneiros;",
          "as colinas, como cordeiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Por que fugir, ó mar?",
          "E você, Jordão, por que retroceder?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por que vocês saltaram como carneiros, ó montes?",
          "E vocês, colinas, porque saltaram como cordeiros?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Estremeça na presença do Soberano, ó terra,",
          "na presença do Deus de Jacó!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele fez da rocha um açude,",
          "do rochedo uma fonte."
        ],
        "rlw_lines": []
      }
    ]
  },
