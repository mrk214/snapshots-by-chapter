    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi, quando fugiu de seu filho Absalão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, muitos são os meus adversários!",
          "Muitos se rebelam contra mim!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "São muitos os que dizem a meu respeito:",
          "“Deus nunca o salvará!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mas tu, Senhor, és o escudo que me protege;",
          "és a minha glória e me fazes andar de cabeça erguida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ao Senhor clamo em alta voz,",
          "e do seu santo monte ele me responde."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eu me deito e durmo, e torno a acordar,",
          "porque é o Senhor que me sustém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não me assustam os milhares que me cercam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Levanta-te, Senhor!",
          "Salva-me, Deus meu!",
          "Quebra o queixo de todos os meus inimigos;",
          "arrebenta os dentes dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Do Senhor vem o livramento.",
          "A tua bênção está sobre o teu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      }
    ]
  },
