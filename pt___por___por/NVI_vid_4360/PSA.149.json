    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Cantem ao Senhor uma nova canção,",
          "louvem-no na assembleia dos fiéis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alegre-se Israel no seu Criador,",
          "exulte o povo de Sião no seu Rei!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Louvem eles o seu nome com danças;",
          "ofereçam-lhe música com tamborim e harpa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O Senhor agrada-se do seu povo;",
          "ele coroa de vitória os oprimidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Regozijem-se os seus fiéis nessa glória",
          "e em seu leito cantem alegremente!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Altos louvores estejam em seus lábios",
          "e uma espada de dois gumes em suas mãos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para impor vingança às nações",
          "e trazer castigo aos povos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "para prender os seus reis com grilhões",
          "e seus nobres com algemas de ferro;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para executar a sentença escrita contra eles.",
          "Esta é a glória de todos os seus fiéis.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
