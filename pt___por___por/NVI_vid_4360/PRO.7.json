    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertência contra a Mulher Adúltera"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Meu filho, obedeça às minhas palavras",
          "e no íntimo guarde os meus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Obedeça aos meus mandamentos,",
          "e você terá vida;",
          "guarde os meus ensinos",
          "como a menina dos seus olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Amarre-os aos dedos;",
          "escreva-os na tábua do seu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Diga à sabedoria: “Você é minha irmã”,",
          "e chame ao entendimento seu parente;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "eles o manterão afastado da mulher imoral,",
          "da mulher leviana com suas palavras sedutoras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Da janela de minha casa",
          "olhei através da grade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "e vi entre os inexperientes,",
          "no meio dos jovens,",
          "um rapaz sem juízo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele vinha pela rua,",
          "próximo à esquina de certa mulher,",
          "andando em direção à casa dela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Era crepúsculo, o entardecer do dia,",
          "chegavam as sombras da noite, crescia a escuridão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A mulher veio então ao seu encontro,",
          "vestida como prostituta, cheia de astúcia no coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "(Ela é espalhafatosa e provocadora,",
          "seus pés nunca param em casa;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "uma hora na rua, outra nas praças,",
          "em cada esquina fica à espreita.)"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ela agarrou o rapaz,",
          "beijou-o e lhe disse descaradamente:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Tenho em casa a carne dos sacrifícios de comunhão,",
          "que hoje fiz para cumprir os meus votos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por isso saí para encontrá-lo;",
          "vim à sua procura e encontrei!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Estendi sobre o meu leito",
          "cobertas de linho fino do Egito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Perfumei a minha cama",
          "com mirra, aloés e canela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Venha, vamos embriagar-nos de carícias até o amanhecer;",
          "gozemos as delícias do amor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pois o meu marido não está em casa;",
          "partiu para uma longa viagem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Levou uma bolsa cheia de prata",
          "e não voltará antes da lua cheia”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Com a sedução das palavras o persuadiu",
          "e o atraiu com o dulçor dos lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Imediatamente ele a seguiu",
          "como o boi levado ao matadouro,",
          "ou como o cervo que vai cair no laço"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "até que uma flecha lhe atravesse o fígado,",
          "ou como o pássaro que salta para dentro do alçapão,",
          "sem saber que isso lhe custará a vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Então, meu filho, ouça-me;",
          "dê atenção às minhas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Não deixe que o seu coração",
          "se volte para os caminhos dela,",
          "nem se perca em tais veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Muitas foram as suas vítimas;",
          "os que matou são uma grande multidão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "A casa dela é um caminho que desce para a sepultura,",
          "para as moradas da morte."
        ],
        "rlw_lines": []
      }
    ]
  },
