    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para o mestre de música. Com instrumentos de cordas. Poema davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Escuta a minha oração, ó Deus,",
          "não ignores a minha súplica;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "ouve-me e responde-me!",
          "Os meus pensamentos me perturbam, e estou atordoado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "diante do barulho do inimigo,",
          "diante da gritaria dos ímpios;",
          "pois eles aumentam o meu sofrimento",
          "e, irados, mostram seu rancor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O meu coração está acelerado;",
          "os pavores da morte me assaltam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Temor e tremor me dominam;",
          "o medo tomou conta de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Então eu disse: Quem dera eu tivesse asas como a pomba;",
          "voaria até encontrar repouso!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sim, eu fugiria para bem longe,",
          "e no deserto eu teria o meu abrigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eu me apressaria em achar refúgio",
          "longe do vendaval e da tempestade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Destrói os ímpios, Senhor, confunde a língua deles,",
          "pois vejo violência e brigas na cidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dia e noite eles rondam por seus muros;",
          "nela permeiam o crime e a maldade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A destruição impera na cidade;",
          "a opressão e a fraude jamais deixam suas ruas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Se um inimigo me insultasse,",
          "eu poderia suportar;",
          "se um adversário se levantasse contra mim,",
          "eu poderia defender-me;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "mas logo você, meu colega,",
          "meu companheiro, meu amigo chegado,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "você, com quem eu partilhava",
          "agradável comunhão",
          "enquanto íamos com a multidão festiva",
          "para a casa de Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Que a morte apanhe os meus inimigos de surpresa!",
          "Desçam eles vivos para a sepultura,",
          "pois entre eles o mal acha guarida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Eu, porém, clamo a Deus,",
          "e o Senhor me salvará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "À tarde, pela manhã e ao meio-dia",
          "choro angustiado,",
          "e ele ouve a minha voz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ele me guarda ileso na batalha,",
          "sendo muitos os que estão contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Deus, que reina desde a eternidade,",
          "me ouvirá e os castigará."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pois jamais mudam sua conduta",
          "e não têm temor de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Aquele homem se voltou contra os seus aliados,",
          "violando o seu acordo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Macia como manteiga é a sua fala,",
          "mas a guerra está no seu coração;",
          "suas palavras são mais suaves que o óleo,",
          "mas são afiadas como punhais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Entregue suas preocupações ao Senhor,",
          "e ele o susterá;",
          "jamais permitirá que o justo venha a cair."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Mas tu, ó Deus, farás descer à cova da destruição",
          "aqueles assassinos e traidores,",
          "os quais não viverão a metade dos seus dias.",
          "Quanto a mim, porém, confio em ti."
        ],
        "rlw_lines": []
      }
    ]
  },
