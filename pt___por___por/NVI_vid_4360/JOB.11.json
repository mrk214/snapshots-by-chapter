    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Zofar"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Zofar, de Naamate, respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Ficarão sem resposta todas essas palavras?",
          "Irá confirmar-se o que esse tagarela diz?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sua conversa tola calará os homens?",
          "Ninguém o repreenderá por sua zombaria?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Você diz a Deus: ‘A doutrina que eu aceito é perfeita,",
          "e sou puro aos teus olhos’."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ah, se Deus falasse com você,",
          "se contra você abrisse os lábios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "e revelasse os segredos da sabedoria!",
          "Pois a verdadeira sabedoria é complexa.",
          "Fique sabendo que Deus esqueceu",
          "alguns dos seus pecados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Você consegue perscrutar os mistérios de Deus?",
          "Pode sondar os limites do Todo-poderoso?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "São mais altos que os céus!",
          "O que você poderá fazer?",
          "São mais profundos que as profundezas!",
          "O que você poderá saber?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Seu comprimento é maior que a terra",
          "e a sua largura é maior que o mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Se ele ordena uma prisão e convoca o tribunal,",
          "quem poderá opor-se?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pois ele não identifica os enganadores",
          "e não reconhece a iniquidade logo que a vê?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mas o tolo só será sábio",
          "quando a cria do jumento selvagem nascer homem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Contudo, se você lhe consagrar o coração",
          "e estender as mãos para ele;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "se afastar das suas mãos o pecado",
          "e não permitir que a maldade habite em sua tenda,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "então você levantará o rosto sem envergonhar-se;",
          "será firme e destemido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Você esquecerá as suas desgraças,",
          "lembrando-as apenas como águas passadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A vida será mais refulgente que o meio-dia,",
          "e as trevas serão como a manhã em seu fulgor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Você estará confiante,",
          "graças à esperança que haverá;",
          "olhará ao redor e repousará em segurança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Você se deitará, e não terá medo de ninguém,",
          "e muitos procurarão o seu favor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Mas os olhos dos ímpios fenecerão",
          "e em vão procurarão refúgio;",
          "o suspiro da morte será a esperança que terão”."
        ],
        "rlw_lines": []
      }
    ]
  },
