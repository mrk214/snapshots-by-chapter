    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de Peregrinação. Davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Se o Senhor não estivesse do nosso lado;",
          "que Israel o repita:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Se o Senhor não estivesse do nosso lado",
          "quando os inimigos nos atacaram,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "eles já nos teriam engolido vivos,",
          "quando se enfureceram contra nós;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "as águas nos teriam arrastado",
          "e as torrentes nos teriam afogado;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "sim, as águas violentas nos teriam afogado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Bendito seja o Senhor,",
          "que não nos entregou para sermos dilacerados pelos dentes deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Como um pássaro escapamos da armadilha do caçador;",
          "a armadilha foi quebrada, e nós escapamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O nosso socorro está no nome do Senhor,",
          "que fez os céus e a terra."
        ],
        "rlw_lines": []
      }
    ]
  },
