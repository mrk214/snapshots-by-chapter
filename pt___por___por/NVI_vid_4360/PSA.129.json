    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de Peregrinação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Muitas vezes me oprimiram desde a minha juventude;",
          "que Israel o repita:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Muitas vezes me oprimiram desde a minha juventude,",
          "mas jamais conseguiram vencer-me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Passaram o arado em minhas costas",
          "e fizeram longos sulcos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O Senhor é justo!",
          "Ele libertou-me das algemas dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Retrocedam envergonhados",
          "todos os que odeiam Sião."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sejam como o capim do terraço,",
          "que seca antes de crescer,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "que não enche as mãos do ceifeiro",
          "nem os braços daquele que faz os fardos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "E que ninguém que passa diga:",
          "“Seja sobre vocês a bênção do Senhor;",
          "nós os abençoamos em nome do Senhor!”"
        ],
        "rlw_lines": []
      }
    ]
  },
