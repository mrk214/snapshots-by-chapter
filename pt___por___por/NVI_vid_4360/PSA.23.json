    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O Senhor é o meu pastor; de nada terei falta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Em verdes pastagens me faz repousar",
          "e me conduz a águas tranquilas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "restaura-me o vigor.",
          "Guia-me nas veredas da justiça",
          "por amor do seu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mesmo quando eu andar",
          "por um vale de trevas e morte,",
          "não temerei perigo algum, pois tu estás comigo;",
          "a tua vara e o teu cajado me protegem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Preparas um banquete para mim",
          "à vista dos meus inimigos.",
          "Tu me honras, ungindo a minha cabeça com óleo",
          "e fazendo transbordar o meu cálice."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sei que a bondade e a fidelidade",
          "me acompanharão todos os dias da minha vida,",
          "e voltarei à casa do Senhor enquanto eu viver."
        ],
        "rlw_lines": []
      }
    ]
  },
