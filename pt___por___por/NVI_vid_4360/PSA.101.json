    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantarei a lealdade e a justiça.",
          "A ti, Senhor, cantarei louvores!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Seguirei o caminho da integridade;",
          "quando virás ao meu encontro?",
          "Em minha casa viverei de coração íntegro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Repudiarei todo mal.",
          "Odeio a conduta dos infiéis;",
          "jamais me dominará!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Longe estou dos perversos de coração;",
          "não quero envolver-me com o mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Farei calar ao que difama o próximo às ocultas.",
          "Não vou tolerar o homem de olhos arrogantes",
          "e de coração orgulhoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Meus olhos aprovam os fiéis da terra,",
          "e eles habitarão comigo.",
          "Somente quem tem vida íntegra me servirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quem pratica a fraude não habitará no meu santuário;",
          "o mentiroso não permanecerá na minha presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Cada manhã fiz calar todos os ímpios desta terra;",
          "eliminei todos os malfeitores da cidade do Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
