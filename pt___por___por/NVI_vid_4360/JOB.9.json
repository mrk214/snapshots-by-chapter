    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Bem sei que isso é verdade.",
          "Mas como pode o mortal ser justo diante de Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ainda que quisesse discutir com ele,",
          "não conseguiria argumentar nem uma vez em mil."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sua sabedoria é profunda, seu poder é imenso.",
          "Quem tentou resistir-lhe e saiu ileso?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele transporta montanhas sem que elas o saibam",
          "e em sua ira as põe de cabeça para baixo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sacode a terra e a tira do lugar,",
          "e faz suas colunas tremerem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Fala com o sol, e ele não brilha;",
          "ele veda e esconde a luz das estrelas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Só ele estende os céus",
          "e anda sobre as ondas do mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ele é o Criador da Ursa e do Órion,",
          "das Plêiades e das constelações do sul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Realiza maravilhas que não se pode perscrutar,",
          "milagres incontáveis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Quando passa por mim, não posso vê-lo;",
          "se passa junto de mim, não o percebo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Se ele apanha algo, quem pode pará-lo?",
          "Quem pode dizer-lhe: ‘O que fazes?’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Deus não refreia a sua ira;",
          "até o séquito de Raabe encolheu-se diante dos seus pés."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Como então poderei eu discutir com ele?",
          "Como achar palavras para com ele argumentar?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Embora inocente, eu seria incapaz de responder-lhe;",
          "poderia apenas implorar misericórdia ao meu Juiz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mesmo que eu o chamasse e ele me respondesse,",
          "não creio que me daria ouvidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ele me esmagaria com uma tempestade",
          "e sem motivo multiplicaria minhas feridas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Não me permitiria recuperar o fôlego,",
          "mas me engolfaria em agruras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Recorrer à força? Ele é mais poderoso!",
          "Ao tribunal? Quem o intimará?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Mesmo sendo eu inocente, minha boca me condenaria;",
          "se eu fosse íntegro, ela me declararia culpado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "“Conquanto eu seja íntegro, já não me importo comigo;",
          "desprezo a minha própria vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "É tudo a mesma coisa; por isso digo:",
          "Ele destrói tanto o íntegro como o ímpio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Quando um flagelo causa morte repentina,",
          "ele zomba do desespero dos inocentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Quando um país cai nas mãos dos ímpios,",
          "ele venda os olhos de seus juízes.",
          "Se não é ele, quem é então?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "“Meus dias correm mais velozes que um atleta;",
          "eles voam sem um vislumbre de alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Passam como barcos de papiro,",
          "como águias que mergulham sobre as presas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Se eu disser:",
          "Vou esquecer a minha queixa,",
          "vou mudar o meu semblante e sorrir,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "ainda assim me apavoro com todos os meus sofrimentos,",
          "pois sei que não me considerarás inocente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Uma vez que já fui considerado culpado,",
          "por que deveria eu lutar em vão?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Mesmo que eu me lavasse com sabão",
          "e limpasse as minhas mãos com soda de lavadeira,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "tu me atirarias num poço de lodo,",
          "para que até as minhas roupas me detestassem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "“Ele não é homem como eu, para que eu lhe responda",
          "e nos enfrentemos em juízo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Se tão somente houvesse alguém",
          "para servir de árbitro entre nós,",
          "para impor as mãos sobre nós dois,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "alguém que afastasse de mim a vara de Deus,",
          "para que o seu terror não mais me assustasse!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Então eu falaria sem medo;",
          "mas não é esse o caso."
        ],
        "rlw_lines": []
      }
    ]
  },
