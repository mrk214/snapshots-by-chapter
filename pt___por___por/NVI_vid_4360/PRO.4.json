    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Sabedoria é Suprema"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ouçam, meus filhos, a instrução de um pai;",
          "estejam atentos e obterão discernimento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O ensino que ofereço a vocês é bom;",
          "por isso não abandonem a minha instrução."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quando eu era menino, ainda pequeno,",
          "em companhia de meu pai,",
          "um filho muito especial para minha mãe,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "ele me ensinava e me dizia:",
          "“Apegue-se às minhas palavras de todo o coração;",
          "obedeça aos meus mandamentos, e você terá vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Procure obter sabedoria e entendimento;",
          "não se esqueça das minhas palavras nem delas se afaste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não abandone a sabedoria, e ela o protegerá;",
          "ame-a, e ela cuidará de você."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O conselho da sabedoria é:",
          "Procure obter sabedoria;",
          "use tudo o que você possui para adquirir entendimento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dedique alta estima à sabedoria, e ela o exaltará;",
          "abrace-a, e ela o honrará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ela porá um belo diadema sobre a sua cabeça",
          "e dará de presente a você uma coroa de esplendor”."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ouça, meu filho, e aceite o que digo,",
          "e você terá vida longa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eu o conduzi pelo caminho da sabedoria",
          "e o encaminhei por veredas retas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Assim, quando você por elas seguir, não encontrará obstáculos;",
          "quando correr, não tropeçará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Apegue-se à instrução, não a abandone; guarde-a bem,",
          "pois dela depende a sua vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Não siga pela vereda dos ímpios",
          "nem ande no caminho dos maus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Evite-o, não passe por ele;",
          "afaste-se e não se detenha."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque eles não conseguem dormir enquanto não fazem o mal;",
          "perdem o sono se não causarem a ruína de alguém."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pois eles se alimentam de maldade,",
          "e se embriagam de violência."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "A vereda do justo é como a luz da alvorada,",
          "que brilha cada vez mais até a plena claridade do dia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Mas o caminho dos ímpios é como densas trevas;",
          "nem sequer sabem em que tropeçam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Meu filho, escute o que digo a você;",
          "preste atenção às minhas palavras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Nunca as perca de vista;",
          "guarde-as no fundo do coração,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "pois são vida para quem as encontra",
          "e saúde para todo o seu ser."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Acima de tudo, guarde o seu coração,",
          "pois dele depende toda a sua vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Afaste da sua boca as palavras perversas;",
          "fique longe dos seus lábios a maldade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Olhe sempre para a frente,",
          "mantenha o olhar fixo no que está adiante de você."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Veja bem por onde anda,",
          "e os seus passos serão seguros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Não se desvie nem para a direita nem para a esquerda;",
          "afaste os seus pés da maldade."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
