    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Sou uma flor de Sarom,",
          "um lírio dos vales."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como um lírio entre os espinhos",
          "é a minha amada entre as jovens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Como uma macieira entre as árvores da floresta",
          "é o meu amado entre os jovens.",
          "Tenho prazer em sentar-me à sua sombra;",
          "o seu fruto é doce ao meu paladar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ele me levou ao salão de banquetes,",
          "e o seu estandarte sobre mim é o amor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Por favor, sustentem-me com passas,",
          "revigorem-me com maçãs,",
          "pois estou doente de amor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O seu braço esquerdo esteja debaixo da minha cabeça,",
          "e o seu braço direito me abrace."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mulheres de Jerusalém, eu as faço jurar",
          "pelas gazelas e pelas corças do campo:",
          "não despertem nem provoquem o amor",
          "enquanto ele não o quiser."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Escutem! É o meu amado!",
          "Vejam! Aí vem ele,",
          "saltando pelos montes,",
          "pulando sobre as colinas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O meu amado é como uma gazela,",
          "como um cervo novo.",
          "Vejam! Lá está ele atrás do nosso muro,",
          "observando pelas janelas,",
          "espiando pelas grades."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O meu amado falou e me disse:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Levante-se, minha querida,",
          "minha bela, e venha comigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Veja! O inverno passou;",
          "acabaram-se as chuvas e já se foram."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Aparecem flores na terra,",
          "e chegou o tempo de cantar;",
          "já se ouve em nossa terra",
          "o arrulhar dos pombos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "A figueira produz os primeiros frutos;",
          "as vinhas florescem e espalham sua fragrância.",
          "Levante-se, venha, minha querida;",
          "minha bela, venha comigo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Minha pomba que está",
          "nas fendas da rocha,",
          "nos esconderijos,",
          "nas encostas dos montes,",
          "mostre-me seu rosto,",
          "deixe-me ouvir sua voz;",
          "pois a sua voz é suave",
          "e o seu rosto é lindo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A Amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Apanhem para nós as raposas,",
          "as raposinhas que estragam as vinhas,",
          "pois as nossas vinhas estão floridas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O meu amado é meu, e eu sou dele;",
          "ele pastoreia entre os lírios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Volte, amado meu,",
          "antes que rompa o dia",
          "e fujam as sombras;",
          "seja como a gazela",
          "ou como o cervo novo",
          "nas colinas escarpadas."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
