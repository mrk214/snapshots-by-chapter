    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O Senhor disse ao meu Senhor:",
          "“Senta-te à minha direita",
          "até que eu faça dos teus inimigos",
          "um estrado para os teus pés”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O Senhor estenderá o cetro de teu poder desde Sião,",
          "e dominarás sobre os teus inimigos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quando convocares as tuas tropas,",
          "o teu povo se apresentará voluntariamente.",
          "Trajando vestes santas,",
          "desde o romper da alvorada",
          "os teus jovens virão como o orvalho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O Senhor jurou e não se arrependerá:",
          "“Tu és sacerdote para sempre,",
          "segundo a ordem de Melquisedeque”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor está à tua direita;",
          "ele esmagará reis no dia da sua ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Julgará as nações, amontoando os mortos",
          "e esmagando governantes em toda a extensão da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "No caminho beberá de um ribeiro,",
          "e então erguerá a cabeça."
        ],
        "rlw_lines": []
      }
    ]
  },
