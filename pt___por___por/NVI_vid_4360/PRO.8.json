    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Chamado da Sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A sabedoria está clamando,",
          "o discernimento ergue a sua voz;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "nos lugares altos, junto ao caminho,",
          "nos cruzamentos ela se coloca;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "ao lado das portas, à entrada da cidade,",
          "portas adentro, ela clama em alta voz:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“A vocês, homens, eu clamo;",
          "a todos levanto a minha voz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Vocês, inexperientes, adquiram a prudência;",
          "e vocês, tolos, tenham bom senso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ouçam, pois tenho coisas importantes para dizer;",
          "os meus lábios falarão do que é certo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Minha boca fala a verdade,",
          "pois a maldade causa repulsa aos meus lábios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Todas as minhas palavras são justas;",
          "nenhuma delas é distorcida ou perversa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Para os que têm discernimento, são todas claras,",
          "e retas para os que têm conhecimento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Prefiram a minha instrução à prata,",
          "e o conhecimento ao ouro puro,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "pois a sabedoria é mais preciosa do que rubis;",
          "nada do que vocês possam desejar compara-se a ela."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Eu, a sabedoria, moro com a prudência,",
          "e tenho o conhecimento que vem do bom senso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Temer o Senhor é odiar o mal;",
          "odeio o orgulho e a arrogância,",
          "o mau comportamento e o falar perverso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Meu é o conselho sensato;",
          "a mim pertencem o entendimento e o poder."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por meu intermédio os reis governam,",
          "e as autoridades exercem a justiça;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "também por meu intermédio governam os nobres,",
          "todos os juízes da terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Amo os que me amam,",
          "e quem me procura me encontra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Comigo estão riquezas e honra,",
          "prosperidade e justiça duradouras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Meu fruto é melhor do que o ouro, do que o ouro puro;",
          "o que ofereço é superior à prata escolhida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Ando pelo caminho da retidão,",
          "pelas veredas da justiça,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "concedendo riqueza aos que me amam",
          "e enchendo os seus tesouros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“O Senhor me criou como o princípio de seu caminho,",
          "antes das suas obras mais antigas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "fui formada desde a eternidade,",
          "desde o princípio, antes de existir a terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Nasci quando ainda não havia abismos,",
          "quando não existiam fontes de águas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "antes de serem estabelecidos os montes",
          "e de existirem colinas eu nasci."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Ele ainda não havia feito a terra,",
          "nem os campos,",
          "nem o pó com o qual formou o mundo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Quando ele estabeleceu os céus, lá estava eu;",
          "quando traçou o horizonte sobre a superfície do abismo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "quando colocou as nuvens em cima",
          "e estabeleceu as fontes do abismo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "quando determinou as fronteiras do mar",
          "para que as águas não violassem a sua ordem,",
          "quando marcou os limites dos alicerces da terra,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "eu estava ao seu lado",
          "e era o seu arquiteto; dia a dia eu era o seu prazer",
          "e me alegrava continuamente com a sua presença."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Eu me alegrava com o mundo que ele criou,",
          "e a humanidade me dava alegria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "“Ouçam-me agora, meus filhos:",
          "Como são felizes os que guardam os meus caminhos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Ouçam a minha instrução e serão sábios.",
          "Não a desprezem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Como é feliz o homem que me ouve,",
          "vigiando diariamente à minha porta,",
          "esperando junto às portas da minha casa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Pois todo aquele que me encontra,",
          "encontra a vida e recebe o favor do Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Mas aquele que de mim se afasta, a si mesmo se agride;",
          "todos os que me odeiam amam a morte”."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
