    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de Peregrinação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, lembra-te de Davi",
          "e das dificuldades que enfrentou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele jurou ao Senhor",
          "e fez um voto ao Poderoso de Jacó:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“Não entrarei na minha tenda",
          "nem me deitarei no meu leito;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "não permitirei que os meus olhos peguem no sono",
          "nem que as minhas pálpebras descansem,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "enquanto não encontrar um lugar para o Senhor,",
          "uma habitação para o Poderoso de Jacó”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Soubemos que a arca estava em Efrata,",
          "mas nós a encontramos nos campos de Jaar:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Vamos para a habitação do Senhor!",
          "Vamos adorá-lo diante do estrado de seus pés!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Levanta-te, Senhor, e vem para o teu lugar de descanso,",
          "tu e a arca onde está o teu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Vistam-se de retidão os teus sacerdotes;",
          "cantem de alegria os teus fiéis”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por amor ao teu servo Davi,",
          "não rejeites o teu ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor fez um juramento a Davi,",
          "um juramento firme que ele não revogará:",
          "“Colocarei um dos seus descendentes no seu trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Se os seus filhos forem fiéis à minha aliança",
          "e aos testemunhos que eu lhes ensino,",
          "também os filhos deles o sucederão no trono para sempre”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O Senhor escolheu Sião,",
          "com o desejo de fazê-la sua habitação:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Este será o meu lugar de descanso para sempre;",
          "aqui firmarei o meu trono, pois esse é o meu desejo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Abençoarei este lugar com fartura;",
          "os seus pobres suprirei de pão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Vestirei de salvação os seus sacerdotes",
          "e os seus fiéis a celebrarão com grande alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Ali farei renascer o poder de Davi",
          "e farei brilhar a luz do meu ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Vestirei de vergonha os seus inimigos,",
          "mas nele brilhará a sua coroa”."
        ],
        "rlw_lines": []
      }
    ]
  },
