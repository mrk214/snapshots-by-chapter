    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "TERCEIRO LIVRO"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo da família de Asafe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Certamente Deus é bom para Israel,",
          "para os puros de coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quanto a mim, os meus pés quase tropeçaram;",
          "por pouco não escorreguei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois tive inveja dos arrogantes",
          "quando vi a prosperidade desses ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eles não passam por sofrimento",
          "e têm o corpo saudável e forte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Estão livres dos fardos de todos;",
          "não são atingidos por doenças como os outros homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por isso o orgulho lhes serve de colar,",
          "e eles se vestem de violência."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Do seu íntimo brota a maldade;",
          "da sua mente transbordam maquinações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eles zombam e falam com más intenções;",
          "em sua arrogância ameaçam com opressão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Com a boca arrogam a si os céus,",
          "e com a língua se apossam da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por isso o seu povo se volta para eles",
          "e bebe suas palavras até saciar-se."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eles dizem: “Como saberá Deus?",
          "Terá conhecimento o Altíssimo?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Assim são os ímpios;",
          "sempre despreocupados, aumentam suas riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Certamente me foi inútil manter puro o coração",
          "e lavar as mãos na inocência,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "pois o dia inteiro sou afligido,",
          "e todas as manhãs sou castigado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Se eu tivesse dito: “Falarei como eles”,",
          "teria traído os teus filhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Quando tentei entender tudo isso,",
          "achei muito difícil para mim,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "até que entrei no santuário de Deus,",
          "e então compreendi o destino dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Certamente os pões em terreno escorregadio",
          "e os fazes cair na ruína."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Como são destruídos de repente,",
          "completamente tomados de pavor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "São como um sonho que se vai quando acordamos;",
          "quando te levantares, Senhor,",
          "tu os farás desaparecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Quando o meu coração estava amargurado",
          "e no íntimo eu sentia inveja,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "agi como insensato e ignorante;",
          "minha atitude para contigo era a de um animal irracional."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Contudo, sempre estou contigo;",
          "tomas a minha mão direita e me susténs."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Tu me diriges com o teu conselho,",
          "e depois me receberás com honras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "A quem tenho nos céus senão a ti?",
          "E, na terra, nada mais desejo além de estar junto a ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "O meu corpo e o meu coração poderão fraquejar,",
          "mas Deus é a força do meu coração",
          "e a minha herança para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Os que te abandonam sem dúvida perecerão;",
          "tu destróis todos os infiéis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Mas, para mim, bom é estar perto de Deus;",
          "fiz do Soberano Senhor o meu refúgio;",
          "proclamarei todos os teus feitos."
        ],
        "rlw_lines": []
      }
    ]
  },
