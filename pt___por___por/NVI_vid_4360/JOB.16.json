    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Já ouvi muitas palavras como essas.",
          "Pobres consoladores são vocês todos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Esses discursos inúteis nunca terminarão?",
          "E você, o que o leva a continuar discutindo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Bem que eu poderia falar como vocês,",
          "se estivessem em meu lugar;",
          "eu poderia condená-los com belos discursos",
          "e menear a cabeça contra vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mas a minha boca procuraria encorajá-los;",
          "a consolação dos meus lábios daria alívio para vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Contudo, se falo, a minha dor não se alivia;",
          "se me calo, ela não desaparece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sem dúvida, ó Deus, tu me esgotaste as forças;",
          "deste fim a toda a minha família."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tu me deixaste deprimido, o que é uma testemunha disso;",
          "a minha magreza se levanta e depõe contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Deus, em sua ira, ataca-me e faz-me em pedaços",
          "e range os dentes contra mim;",
          "meus inimigos fitam-me com olhar ferino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os homens abrem sua boca contra mim,",
          "esmurram meu rosto com zombaria e se unem contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Deus fez-me cair nas mãos dos ímpios",
          "e atirou-me nas garras dos maus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eu estava tranquilo, mas ele me arrebentou;",
          "agarrou-me pelo pescoço e esmagou-me.",
          "Fez de mim o seu alvo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "seus flecheiros me cercam.",
          "Ele traspassou sem dó os meus rins",
          "e derramou na terra a minha bílis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Lança-se sobre mim uma e outra vez;",
          "ataca-me como um guerreiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "“Costurei veste de lamento sobre a minha pele",
          "e enterrei a minha testa no pó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Meu rosto está rubro de tanto eu chorar,",
          "e sombras densas circundam os meus olhos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "apesar de não haver violência em minhas mãos",
          "e de ser pura a minha oração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "“Ó terra, não cubra o meu sangue!",
          "Não haja lugar de repouso para o meu clamor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Saibam que agora mesmo a minha testemunha está nos céus;",
          "nas alturas está o meu advogado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O meu intercessor é meu amigo,",
          "quando diante de Deus correm lágrimas dos meus olhos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "ele defende a causa do homem perante Deus,",
          "como quem defende a causa de um amigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“Pois mais alguns anos apenas,",
          "e farei a viagem sem retorno."
        ],
        "rlw_lines": []
      }
    ]
  },
