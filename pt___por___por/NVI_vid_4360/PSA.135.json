    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Louvem o nome do Senhor;",
          "louvem-no, servos do Senhor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "vocês, que servem na casa do Senhor,",
          "nos pátios da casa de nosso Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Louvem o Senhor, pois o Senhor é bom;",
          "cantem louvores ao seu nome, pois é nome amável."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque o Senhor escolheu Jacó;",
          "a Israel, como seu tesouro pessoal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Na verdade, sei que o Senhor é grande,",
          "que o nosso Soberano é maior do que todos os deuses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor faz tudo o que lhe agrada,",
          "nos céus e na terra,",
          "nos mares e em todas as suas profundezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele traz as nuvens desde os confins da terra;",
          "envia os relâmpagos que acompanham a chuva",
          "e faz que o vento saia dos seus depósitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Foi ele que matou os primogênitos do Egito,",
          "tanto dos homens como dos animais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ele realizou em pleno Egito sinais e maravilhas,",
          "contra o faraó e todos os seus conselheiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Foi ele que feriu muitas nações",
          "e matou reis poderosos:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Seom, rei dos amorreus,",
          "Ogue, rei de Basã,",
          "e todos os reinos de Canaã;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "e deu a terra deles como herança,",
          "como herança a Israel, o seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O teu nome, Senhor, permanece para sempre,",
          "a tua fama, Senhor, por todas as gerações!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor defenderá o seu povo",
          "e terá compaixão dos seus servos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os ídolos das nações não passam de prata e ouro,",
          "feitos por mãos humanas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Têm boca, mas não podem falar;",
          "olhos, mas não podem ver;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "têm ouvidos, mas não podem escutar",
          "nem há respiração em sua boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tornem-se como eles aqueles que os fazem",
          "e todos os que neles confiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Bendigam o Senhor, ó israelitas!",
          "Bendigam o Senhor, ó sacerdotes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Bendigam o Senhor, ó levitas!",
          "Bendigam o Senhor os que temem o Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Bendito seja o Senhor desde Sião,",
          "aquele que habita em Jerusalém.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
