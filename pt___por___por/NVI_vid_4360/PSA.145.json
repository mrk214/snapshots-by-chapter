    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Um cântico de louvor. Davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu te exaltarei, meu Deus e meu rei;",
          "bendirei o teu nome para todo o sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Todos os dias te bendirei",
          "e louvarei o teu nome para todo o sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Grande é o Senhor e digno de ser louvado;",
          "sua grandeza não tem limites."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Uma geração contará à outra a grandiosidade dos teus feitos;",
          "eles anunciarão os teus atos poderosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Proclamarão o glorioso esplendor da tua majestade,",
          "e meditarei nas maravilhas que fazes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Anunciarão o poder dos teus feitos temíveis,",
          "e eu falarei das tuas grandes obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Comemorarão a tua imensa bondade",
          "e celebrarão a tua justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O Senhor é misericordioso e compassivo,",
          "paciente e transbordante de amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O Senhor é bom para todos;",
          "a sua compaixão alcança todas as suas criaturas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Rendam-te graças todas as tuas criaturas, Senhor,",
          "e os teus fiéis te bendigam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eles anunciarão a glória do teu reino",
          "e falarão do teu poder,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "para que todos saibam dos teus feitos poderosos",
          "e do glorioso esplendor do teu reino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O teu reino é reino eterno,",
          "e o teu domínio permanece de geração em geração.",
          "O Senhor é fiel em todas as suas promessas",
          "e é bondoso em tudo o que faz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor ampara todos os que caem",
          "e levanta todos os que estão prostrados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os olhos de todos estão voltados para ti,",
          "e tu lhes dás o alimento no devido tempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Abres a tua mão e satisfazes os desejos",
          "de todos os seres vivos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O Senhor é justo em todos os seus caminhos",
          "e bondoso em tudo o que faz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "O Senhor está perto de todos os que o invocam,",
          "de todos os que o invocam com sinceridade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ele realiza os desejos daqueles que o temem;",
          "ouve-os gritar por socorro e os salva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O Senhor cuida de todos os que o amam,",
          "mas a todos os ímpios destruirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Com meus lábios louvarei o Senhor.",
          "Que todo ser vivo bendiga o seu santo nome",
          "para todo o sempre!"
        ],
        "rlw_lines": []
      }
    ]
  },
