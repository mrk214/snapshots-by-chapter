    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bildade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Bildade, de Suá, respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Quando você vai parar de falar?",
          "Proceda com sensatez, e depois poderemos conversar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Por que somos considerados como animais",
          "e somos ignorantes aos seus olhos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ah, você, que se dilacera de ira!",
          "Deve-se abandonar a terra por sua causa?",
          "Ou devem as rochas mudar de lugar?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“A lâmpada do ímpio se apaga,",
          "e a chama do seu fogo se extingue."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Na sua tenda a luz se escurece;",
          "a lâmpada de sua vida se apaga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O vigor dos seus passos se enfraquece,",
          "e os seus próprios planos o lançam por terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por seus próprios pés você se prende na rede,",
          "e se perde na sua malha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A armadilha o pega pelo calcanhar;",
          "o laço o prende firme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O nó corredio está escondido na terra para pegá-lo,",
          "há uma armadilha em seu caminho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Terrores de todos os lados o assustam",
          "e o perseguem em todos os seus passos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A calamidade tem fome de alcançá-lo;",
          "a desgraça está à espera de sua queda"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "e consome partes da sua pele;",
          "o primogênito da morte devora os membros do seu corpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ele é arrancado da segurança de sua tenda,",
          "e o levam à força ao rei dos terrores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O fogo mora na tenda dele;",
          "espalham enxofre ardente sobre a sua habitação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Suas raízes secam-se embaixo,",
          "e seus ramos murcham em cima."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sua lembrança desaparece da terra,",
          "e nome não tem, em parte alguma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "É lançado da luz para as trevas;",
          "é banido do mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Não tem filhos nem descendentes entre o seu povo,",
          "nem lhe restou sobrevivente algum",
          "nos lugares onde antes vivia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Os homens do ocidente assustam-se com a sua ruína,",
          "e os do oriente enchem-se de pavor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "É assim a habitação do perverso;",
          "essa é a situação de quem não conhece a Deus”."
        ],
        "rlw_lines": []
      }
    ]
  },
