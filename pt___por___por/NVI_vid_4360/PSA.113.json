    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Louvem, ó servos do Senhor,",
          "louvem o nome do Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Seja bendito o nome do Senhor,",
          "desde agora e para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Do nascente ao poente,",
          "seja louvado o nome do Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O Senhor está exaltado acima de todas as nações;",
          "e acima dos céus está a sua glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem é como o Senhor, o nosso Deus,",
          "que reina em seu trono nas alturas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "mas se inclina para contemplar",
          "o que acontece nos céus e na terra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele levanta do pó o necessitado",
          "e ergue do lixo o pobre,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "para fazê-los sentar-se com príncipes,",
          "com os príncipes do seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dá um lar à estéril,",
          "e dela faz uma feliz mãe de filhos.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
