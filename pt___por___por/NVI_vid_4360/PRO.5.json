    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertência contra o Adultério"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Meu filho, dê atenção à minha sabedoria,",
          "incline os ouvidos para perceber o meu discernimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Assim você manterá o bom senso,",
          "e os seus lábios guardarão o conhecimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois os lábios da mulher imoral destilam mel,",
          "sua voz é mais suave que o azeite;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "mas no final é amarga como fel,",
          "afiada como uma espada de dois gumes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os seus pés descem para a morte;",
          "os seus passos conduzem diretamente para a sepultura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ela nem percebe que anda por caminhos tortuosos",
          "e não enxerga a vereda da vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Agora, então, meu filho, ouça-me;",
          "não se desvie das minhas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Fique longe dessa mulher;",
          "não se aproxime da porta de sua casa,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para que você não entregue aos outros o seu vigor",
          "nem a sua vida a algum homem cruel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "para que estranhos não se fartem do seu trabalho",
          "e outros não se enriqueçam à custa do seu esforço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "No final da vida você gemerá,",
          "com sua carne e seu corpo desgastados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Você dirá: “Como odiei a disciplina!",
          "Como o meu coração rejeitou a repreensão!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Não ouvi os meus mestres",
          "nem escutei os que me ensinavam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cheguei à beira da ruína completa,",
          "à vista de toda a comunidade”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Beba das águas da sua cisterna,",
          "das águas que brotam do seu próprio poço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por que deixar que as suas fontes transbordem pelas ruas,",
          "e os seus ribeiros pelas praças?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Que elas sejam exclusivamente suas,",
          "nunca repartidas com estranhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Seja bendita a sua fonte!",
          "Alegre-se com a esposa da sua juventude."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Gazela amorosa, corça graciosa;",
          "que os seios de sua esposa sempre o fartem de prazer,",
          "e sempre o embriaguem os carinhos dela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por que, meu filho, ser desencaminhado pela mulher imoral?",
          "Por que abraçar o seio de uma leviana?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "O Senhor vê os caminhos do homem",
          "e examina todos os seus passos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "As maldades do ímpio o prendem;",
          "ele se torna prisioneiro das cordas do seu pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Certamente morrerá por falta de disciplina;",
          "andará cambaleando por causa da sua insensatez."
        ],
        "rlw_lines": []
      }
    ]
  },
