    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Para o mestre de música. Salmo davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Livra-me, Senhor, dos maus;",
          "protege-me dos violentos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "que no coração tramam planos perversos",
          "e estão sempre provocando guerra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Afiam a língua como a da serpente;",
          "veneno de víbora está em seus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Protege-me, Senhor, das mãos dos ímpios;",
          "protege-me dos violentos,",
          "que pretendem fazer-me tropeçar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Homens arrogantes prepararam armadilhas contra mim,",
          "perversos estenderam as suas redes;",
          "no meu caminho armaram ciladas contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu declaro ao Senhor: Tu és o meu Deus.",
          "Ouve, Senhor, a minha súplica!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ó Soberano Senhor, meu salvador poderoso,",
          "tu me proteges a cabeça no dia da batalha;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "não atendas aos desejos dos ímpios, Senhor!",
          "Não permitas que os planos deles tenham sucesso,",
          "para que não se orgulhem."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Pausa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Recaia sobre a cabeça dos que me cercam",
          "a maldade que os seus lábios proferiram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Caiam brasas sobre eles,",
          "e sejam lançados ao fogo,",
          "em covas das quais jamais possam sair."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Que os difamadores não se estabeleçam na terra,",
          "que a desgraça persiga os violentos até a morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sei que o Senhor defenderá a causa do necessitado",
          "e fará justiça aos pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Com certeza os justos darão graças ao teu nome,",
          "e os homens íntegros viverão na tua presença."
        ],
        "rlw_lines": []
      }
    ]
  },
