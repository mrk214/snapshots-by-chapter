    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Até agora me queixo com amargura;",
          "a mão dele é pesada, a despeito de meu gemido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Se tão somente eu soubesse",
          "onde encontrá-lo e como ir à sua habitação!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eu lhe apresentaria a minha causa",
          "e encheria a minha boca de argumentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Estudaria o que ele me respondesse",
          "e analisaria o que me dissesse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Será que ele se oporia a mim com grande poder?",
          "Não, ele não me faria acusações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O homem íntegro poderia apresentar-lhe sua causa;",
          "eu seria liberto para sempre de quem me julga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Mas, se vou para o oriente, lá ele não está;",
          "se vou para o ocidente, não o encontro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Quando ele está em ação no norte, não o enxergo;",
          "quando vai para o sul, nem sombra dele eu vejo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mas ele conhece o caminho por onde ando;",
          "se me puser à prova, aparecerei como o ouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Meus pés seguiram de perto as suas pegadas;",
          "mantive-me no seu caminho sem desviar-me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Não me afastei dos mandamentos dos seus lábios;",
          "dei mais valor às palavras de sua boca",
          "do que ao meu pão de cada dia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Mas ele é ele!",
          "Quem poderá fazer-lhe oposição? Ele faz o que quer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Executa o seu decreto contra mim",
          "e tem muitos outros planos semelhantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por isso fico apavorado diante dele;",
          "pensar nisso me enche de medo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Deus fez desmaiar o meu coração;",
          "o Todo-poderoso causou-me pavor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Contudo, não fui silenciado pelas trevas,",
          "pelas densas trevas que cobrem o meu rosto."
        ],
        "rlw_lines": []
      }
    ]
  },
