    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Discurso de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Depois disso Jó abriu a boca e amaldiçoou o dia do seu nascimento,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“Pereça o dia do meu nascimento e a noite em que se disse:",
          "‘Nasceu um menino!’"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Transforme-se aquele dia em trevas,",
          "e Deus, lá do alto, não se importe com ele;",
          "não resplandeça a luz sobre ele."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Chamem-no de volta as trevas",
          "e a mais densa escuridão;",
          "coloque-se uma nuvem sobre ele",
          "e o negrume aterrorize a sua luz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Apoderem-se daquela noite densas trevas!",
          "Não seja ela incluída entre os dias do ano,",
          "nem faça parte de nenhum dos meses."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Seja aquela noite estéril,",
          "e nela não se ouçam brados de alegria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Amaldiçoem aquele dia os que amaldiçoam os dias",
          "e são capazes de atiçar o Leviatã."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Fiquem escuras as suas estrelas matutinas,",
          "espere ele em vão pela luz do sol",
          "e não veja os primeiros raios da alvorada,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "pois não fechou as portas do ventre materno",
          "para evitar que eu contemplasse males."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Por que não morri ao nascer",
          "e não pereci quando saí do ventre?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por que houve joelhos para me receberem",
          "e seios para me amamentarem?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Agora eu bem poderia estar deitado em paz",
          "e achar repouso"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "junto aos reis e conselheiros da terra,",
          "que construíram para si lugares que agora jazem em ruínas,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "com governantes que possuíam ouro,",
          "que enchiam suas casas de prata."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por que não me sepultaram como criança abortada,",
          "como um bebê que nunca viu a luz do dia?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ali os ímpios já não se agitam,",
          "e ali os cansados permanecem em repouso;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "os prisioneiros também desfrutam sossego,",
          "já não ouvem mais os gritos do feitor de escravos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Os simples e os poderosos ali estão,",
          "e o escravo está livre do seu senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "“Por que se dá luz aos infelizes,",
          "e vida aos de alma amargurada,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "aos que anseiam pela morte e esta não vem,",
          "e a procuram mais do que a um tesouro oculto,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "aos que se enchem de alegria",
          "e exultam quando vão para a sepultura?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Por que se dá vida àquele",
          "cujo caminho é oculto",
          "e a quem Deus fechou as saídas?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Pois me vêm suspiros em vez de comida;",
          "meus gemidos transbordam como água."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "O que eu temia veio sobre mim;",
          "o que eu receava me aconteceu."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Não tenho paz, nem tranquilidade, nem descanso;",
          "somente inquietação”."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
