    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Álef"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Como são felizes os que andam em caminhos irrepreensíveis,",
          "que vivem conforme a lei do Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como são felizes os que obedecem aos seus estatutos",
          "e de todo o coração o buscam!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não praticam o mal",
          "e andam nos caminhos do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tu mesmo ordenaste os teus preceitos",
          "para que sejam fielmente obedecidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem dera fossem firmados os meus caminhos",
          "na obediência aos teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Então não ficaria decepcionado",
          "ao considerar todos os teus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Eu te louvarei de coração sincero",
          "quando aprender as tuas justas ordenanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Obedecerei aos teus decretos;",
          "nunca me abandones."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bêt"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Como pode o jovem manter pura a sua conduta?",
          "Vivendo de acordo com a tua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eu te busco de todo o coração;",
          "não permitas que eu me desvie dos teus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Guardei no coração a tua palavra",
          "para não pecar contra ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Bendito sejas, Senhor!",
          "Ensina-me os teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Com os lábios repito",
          "todas as leis que promulgaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Regozijo-me em seguir os teus testemunhos",
          "como o que se regozija com grandes riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Meditarei nos teus preceitos",
          "e darei atenção às tuas veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tenho prazer nos teus decretos;",
          "não me esqueço da tua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Guímel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Trata com bondade o teu servo",
          "para que eu viva e obedeça à tua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Abre os meus olhos",
          "para que eu veja as maravilhas da tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Sou peregrino na terra;",
          "não escondas de mim os teus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "A minha alma consome-se",
          "de perene desejo das tuas ordenanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Tu repreendes os arrogantes;",
          "malditos os que se desviam dos teus mandamentos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Tira de mim a afronta e o desprezo,",
          "pois obedeço aos teus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Mesmo que os poderosos se reúnam para conspirar contra mim,",
          "ainda assim o teu servo meditará nos teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Sim, os teus testemunhos são o meu prazer;",
          "eles são os meus conselheiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dálet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Agora estou prostrado no pó;",
          "preserva a minha vida conforme a tua promessa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "A ti relatei os meus caminhos e tu me respondeste;",
          "ensina-me os teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Faze-me discernir o propósito dos teus preceitos;",
          "então meditarei nas tuas maravilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "A minha alma se consome de tristeza;",
          "fortalece-me conforme a tua promessa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Desvia-me dos caminhos enganosos;",
          "por tua graça, ensina-me a tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Escolhi o caminho da fidelidade;",
          "decidi seguir as tuas ordenanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Apego-me aos teus testemunhos, ó Senhor;",
          "não permitas que eu fique decepcionado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Corro pelo caminho que os teus mandamentos apontam,",
          "pois me deste maior entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "He"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Ensina-me, Senhor, o caminho dos teus decretos,",
          "e a eles obedecerei até o fim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Dá-me entendimento, para que eu guarde a tua lei",
          "e a ela obedeça de todo o coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Dirige-me pelo caminho dos teus mandamentos,",
          "pois nele encontro satisfação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Inclina o meu coração para os teus estatutos,",
          "e não para a ganância."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Desvia os meus olhos das coisas inúteis;",
          "faze-me viver nos caminhos que traçaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Cumpre a tua promessa para com o teu servo,",
          "para que sejas temido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Livra-me da afronta que me apavora,",
          "pois as tuas ordenanças são boas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Como anseio pelos teus preceitos!",
          "Preserva a minha vida por tua justiça!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Vav"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Que o teu amor alcance-me, Senhor,",
          "e a tua salvação, segundo a tua promessa;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "então responderei aos que me afrontam,",
          "pois confio na tua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Jamais tires da minha boca a palavra da verdade,",
          "pois nas tuas ordenanças depositei a minha esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Obedecerei constantemente à tua lei,",
          "para todo o sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Andarei em verdadeira liberdade,",
          "pois tenho buscado os teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Falarei dos teus testemunhos diante de reis,",
          "sem ficar envergonhado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Tenho prazer nos teus mandamentos;",
          "eu os amo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "A ti levanto minhas mãos",
          "e medito nos teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Zain"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Lembra-te da tua palavra ao teu servo,",
          "pela qual me deste esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Este é o meu consolo no meu sofrimento:",
          "A tua promessa dá-me vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Os arrogantes zombam de mim o tempo todo,",
          "mas eu não me desvio da tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Lembro-me, Senhor, das tuas ordenanças do passado",
          "e nelas acho consolo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Fui tomado de ira tremenda por causa dos ímpios",
          "que rejeitaram a tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Os teus decretos são o tema",
          "da minha canção em minha peregrinação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "De noite lembro-me do teu nome, Senhor!",
          "Vou obedecer à tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Esta tem sido a minha prática:",
          "Obedecer aos teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hêt"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "Tu és a minha herança, Senhor;",
          "prometi obedecer às tuas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "De todo o coração suplico a tua graça;",
          "tem misericórdia de mim, conforme a tua promessa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Refleti em meus caminhos e voltei os meus passos",
          "para os teus testemunhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Eu me apressarei e não hesitarei",
          "em obedecer aos teus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Embora as cordas dos ímpios queiram prender-me,",
          "eu não me esqueço da tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "À meia-noite me levanto para dar-te graças",
          "pelas tuas justas ordenanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Sou amigo de todos os que te temem",
          "e obedecem aos teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "A terra está cheia do teu amor, Senhor;",
          "ensina-me os teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tét"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Trata com bondade o teu servo, Senhor,",
          "conforme a tua promessa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Ensina-me o bom senso e o conhecimento,",
          "pois confio em teus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Antes de ser castigado, eu andava desviado,",
          "mas agora obedeço à tua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Tu és bom, e o que fazes é bom;",
          "ensina-me os teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "Os arrogantes mancharam o meu nome com mentiras,",
          "mas eu obedeço aos teus preceitos de todo o coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "O coração deles é insensível;",
          "eu, porém, tenho prazer na tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "Foi bom para mim ter sido castigado,",
          "para que aprendesse os teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "Para mim vale mais a lei que decretaste",
          "do que milhares de peças de prata e ouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Iode"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "As tuas mãos me fizeram e me formaram;",
          "dá-me entendimento para aprender os teus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "Quando os que têm temor de ti me virem, se alegrarão,",
          "pois na tua palavra depositei a minha esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "Sei, Senhor, que as tuas ordenanças são justas,",
          "e que por tua fidelidade me castigaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "Seja o teu amor o meu consolo,",
          "conforme a tua promessa ao teu servo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "Alcance-me a tua misericórdia para que eu tenha vida,",
          "porque a tua lei é o meu prazer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "Sejam humilhados os arrogantes, pois me prejudicaram sem motivo;",
          "mas eu meditarei nos teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Venham apoiar-me aqueles que te temem,",
          "aqueles que entendem os teus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "Seja o meu coração íntegro para com os teus decretos,",
          "para que eu não seja humilhado."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Caf"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "Estou quase desfalecido, aguardando a tua salvação,",
          "mas na tua palavra depositei a minha esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          82
        ],
        "lines": [
          "Os meus olhos fraquejam de tanto esperar pela tua promessa,",
          "e pergunto: “Quando me consolarás?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          83
        ],
        "lines": [
          "Embora eu seja como uma vasilha inútil,",
          "não me esqueço dos teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          84
        ],
        "lines": [
          "Até quando o teu servo deverá esperar",
          "para que castigues os meus perseguidores?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          85
        ],
        "lines": [
          "Cavaram uma armadilha contra mim os arrogantes,",
          "os que não seguem a tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          86
        ],
        "lines": [
          "Todos os teus mandamentos merecem confiança;",
          "ajuda-me, pois sou perseguido com mentiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          87
        ],
        "lines": [
          "Quase acabaram com a minha vida na terra,",
          "mas não abandonei os teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          88
        ],
        "lines": [
          "Preserva a minha vida pelo teu amor,",
          "e obedecerei aos estatutos que decretaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lâmed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          89
        ],
        "lines": [
          "A tua palavra, Senhor,",
          "para sempre está firmada nos céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          90
        ],
        "lines": [
          "A tua fidelidade é constante por todas as gerações;",
          "estabeleceste a terra, que firme subsiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          91
        ],
        "lines": [
          "Conforme as tuas ordens, tudo permanece até hoje,",
          "pois tudo está a teu serviço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          92
        ],
        "lines": [
          "Se a tua lei não fosse o meu prazer,",
          "o sofrimento já me teria destruído."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          93
        ],
        "lines": [
          "Jamais me esquecerei dos teus preceitos,",
          "pois é por meio deles que preservas a minha vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          94
        ],
        "lines": [
          "Salva-me, pois a ti pertenço",
          "e busco os teus preceitos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          95
        ],
        "lines": [
          "Os ímpios estão à espera para destruir-me,",
          "mas eu considero os teus testemunhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          96
        ],
        "lines": [
          "Tenho constatado que toda perfeição tem limite;",
          "mas não há limite para o teu mandamento."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Mem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          97
        ],
        "lines": [
          "Como eu amo a tua lei!",
          "Medito nela o dia inteiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          98
        ],
        "lines": [
          "Os teus mandamentos me tornam mais sábio que os meus inimigos,",
          "porquanto estão sempre comigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          99
        ],
        "lines": [
          "Tenho mais discernimento que todos os meus mestres,",
          "pois medito nos teus testemunhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          100
        ],
        "lines": [
          "Tenho mais entendimento que os anciãos,",
          "pois obedeço aos teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          101
        ],
        "lines": [
          "Afasto os pés de todo caminho mau",
          "para obedecer à tua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          102
        ],
        "lines": [
          "Não me afasto das tuas ordenanças,",
          "pois tu mesmo me ensinas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          103
        ],
        "lines": [
          "Como são doces para o meu paladar as tuas palavras!",
          "Mais que o mel para a minha boca!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          104
        ],
        "lines": [
          "Ganho entendimento por meio dos teus preceitos;",
          "por isso odeio todo caminho de falsidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Nun"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          105
        ],
        "lines": [
          "A tua palavra é lâmpada que ilumina os meus passos",
          "e luz que clareia o meu caminho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          106
        ],
        "lines": [
          "Prometi sob juramento e o cumprirei:",
          "vou obedecer às tuas justas ordenanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          107
        ],
        "lines": [
          "Passei por muito sofrimento;",
          "preserva, Senhor, a minha vida, conforme a tua promessa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          108
        ],
        "lines": [
          "Aceita, Senhor, a oferta de louvor dos meus lábios,",
          "e ensina-me as tuas ordenanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          109
        ],
        "lines": [
          "A minha vida está sempre em perigo,",
          "mas não me esqueço da tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          110
        ],
        "lines": [
          "Os ímpios prepararam uma armadilha contra mim,",
          "mas não me desviei dos teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          111
        ],
        "lines": [
          "Os teus testemunhos são a minha herança permanente;",
          "são a alegria do meu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          112
        ],
        "lines": [
          "Dispus o meu coração para cumprir",
          "os teus decretos até o fim."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sâmeq"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          113
        ],
        "lines": [
          "Odeio os que são inconstantes,",
          "mas amo a tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          114
        ],
        "lines": [
          "Tu és o meu abrigo e o meu escudo;",
          "e na tua palavra depositei a minha esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          115
        ],
        "lines": [
          "Afastem-se de mim os que praticam o mal!",
          "Quero obedecer aos mandamentos do meu Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          116
        ],
        "lines": [
          "Sustenta-me, segundo a tua promessa, e eu viverei;",
          "não permitas que se frustrem as minhas esperanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          117
        ],
        "lines": [
          "Ampara-me, e estarei seguro;",
          "sempre estarei atento aos teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          118
        ],
        "lines": [
          "Tu rejeitas todos os que se desviam dos teus decretos,",
          "pois os seus planos enganosos são inúteis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          119
        ],
        "lines": [
          "Tu destróis como refugo todos os ímpios da terra;",
          "por isso amo os teus testemunhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          120
        ],
        "lines": [
          "O meu corpo estremece diante de ti;",
          "as tuas ordenanças enchem-me de temor."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Áin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          121
        ],
        "lines": [
          "Tenho vivido com justiça e retidão;",
          "não me abandones nas mãos dos meus opressores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          122
        ],
        "lines": [
          "Garante o bem-estar do teu servo;",
          "não permitas que os arrogantes me oprimam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          123
        ],
        "lines": [
          "Os meus olhos fraquejam, aguardando a tua salvação",
          "e o cumprimento da tua justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          124
        ],
        "lines": [
          "Trata o teu servo conforme o teu amor leal",
          "e ensina-me os teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          125
        ],
        "lines": [
          "Sou teu servo; dá-me discernimento",
          "para compreender os teus testemunhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          126
        ],
        "lines": [
          "Já é tempo de agires, Senhor,",
          "pois a tua lei está sendo desrespeitada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          127
        ],
        "lines": [
          "Eu amo os teus mandamentos mais do que o ouro,",
          "mais do que o ouro puro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          128
        ],
        "lines": [
          "Por isso considero justos os teus preceitos",
          "e odeio todo caminho de falsidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pê"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          129
        ],
        "lines": [
          "Os teus testemunhos são maravilhosos;",
          "por isso lhes obedeço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          130
        ],
        "lines": [
          "A explicação das tuas palavras ilumina",
          "e dá discernimento aos inexperientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          131
        ],
        "lines": [
          "Abro a boca e suspiro,",
          "ansiando por teus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          132
        ],
        "lines": [
          "Volta-te para mim e tem misericórdia de mim,",
          "como sempre fazes aos que amam o teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          133
        ],
        "lines": [
          "Dirige os meus passos, conforme a tua palavra;",
          "não permitas que nenhum pecado me domine."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          134
        ],
        "lines": [
          "Resgata-me da opressão dos homens,",
          "para que eu obedeça aos teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          135
        ],
        "lines": [
          "Faze o teu rosto resplandecer sobre o teu servo",
          "e ensina-me os teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          136
        ],
        "lines": [
          "Rios de lágrimas correm dos meus olhos,",
          "porque a tua lei não é obedecida."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tsade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          137
        ],
        "lines": [
          "Justo és, Senhor,",
          "e retas são as tuas ordenanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          138
        ],
        "lines": [
          "Ordenaste os teus testemunhos com justiça;",
          "dignos são de inteira confiança!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          139
        ],
        "lines": [
          "O meu zelo me consome,",
          "pois os meus adversários se esquecem das tuas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          140
        ],
        "lines": [
          "A tua promessa foi plenamente comprovada,",
          "e, por isso, o teu servo a ama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          141
        ],
        "lines": [
          "Sou pequeno e desprezado,",
          "mas não esqueço os teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          142
        ],
        "lines": [
          "A tua justiça é eterna,",
          "e a tua lei é a verdade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          143
        ],
        "lines": [
          "Tribulação e angústia me atingiram,",
          "mas os teus mandamentos são o meu prazer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          144
        ],
        "lines": [
          "Os teus testemunhos são eternamente justos,",
          "dá-me discernimento para que eu tenha vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cof"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          145
        ],
        "lines": [
          "Eu clamo de todo o coração;",
          "responde-me, Senhor, e obedecerei aos teus testemunhos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          146
        ],
        "lines": [
          "Clamo a ti; salva-me,",
          "e obedecerei aos teus estatutos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          147
        ],
        "lines": [
          "Antes do amanhecer me levanto e suplico o teu socorro;",
          "na tua palavra depositei a minha esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          148
        ],
        "lines": [
          "Fico acordado nas vigílias da noite,",
          "para meditar nas tuas promessas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          149
        ],
        "lines": [
          "Ouve a minha voz pelo teu amor leal;",
          "faze-me viver, Senhor, conforme as tuas ordenanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          150
        ],
        "lines": [
          "Os meus perseguidores aproximam-se com más intenções,",
          "mas estão distantes da tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          151
        ],
        "lines": [
          "Tu, porém, Senhor, estás perto,",
          "e todos os teus mandamentos são verdadeiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          152
        ],
        "lines": [
          "Há muito aprendi dos teus testemunhos",
          "que tu os estabeleceste para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Rêsh"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          153
        ],
        "lines": [
          "Olha para o meu sofrimento e livra-me,",
          "pois não me esqueço da tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          154
        ],
        "lines": [
          "Defende a minha causa e resgata-me;",
          "preserva a minha vida conforme a tua promessa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          155
        ],
        "lines": [
          "A salvação está longe dos ímpios,",
          "pois eles não buscam os teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          156
        ],
        "lines": [
          "Grande é a tua compaixão, Senhor;",
          "preserva a minha vida conforme as tuas leis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          157
        ],
        "lines": [
          "Muitos são os meus adversários e os meus perseguidores,",
          "mas eu não me desvio dos teus estatutos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          158
        ],
        "lines": [
          "Com grande desgosto vejo os infiéis,",
          "que não obedecem à tua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          159
        ],
        "lines": [
          "Vê como amo os teus preceitos!",
          "Dá-me vida, Senhor, conforme o teu amor leal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          160
        ],
        "lines": [
          "A verdade é a essência da tua palavra,",
          "e todas as tuas justas ordenanças são eternas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Shin e Sin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          161
        ],
        "lines": [
          "Os poderosos perseguem-me sem motivo,",
          "mas é diante da tua palavra que o meu coração treme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          162
        ],
        "lines": [
          "Eu me regozijo na tua promessa como alguém",
          "que encontra grandes despojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          163
        ],
        "lines": [
          "Odeio e detesto a falsidade,",
          "mas amo a tua lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          164
        ],
        "lines": [
          "Sete vezes por dia eu te louvo",
          "por causa das tuas justas ordenanças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          165
        ],
        "lines": [
          "Os que amam a tua lei desfrutam paz,",
          "e nada há que os faça tropeçar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          166
        ],
        "lines": [
          "Aguardo a tua salvação, Senhor,",
          "e pratico os teus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          167
        ],
        "lines": [
          "Obedeço aos teus testemunhos;",
          "amo-os infinitamente!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          168
        ],
        "lines": [
          "Obedeço a todos os teus preceitos e testemunhos,",
          "pois conheces todos os meus caminhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tau"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          169
        ],
        "lines": [
          "Chegue à tua presença o meu clamor, Senhor!",
          "Dá-me entendimento conforme a tua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          170
        ],
        "lines": [
          "Chegue a ti a minha súplica.",
          "Livra-me, conforme a tua promessa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          171
        ],
        "lines": [
          "Meus lábios transbordarão de louvor,",
          "pois me ensinas os teus decretos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          172
        ],
        "lines": [
          "A minha língua cantará a tua palavra,",
          "pois todos os teus mandamentos são justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          173
        ],
        "lines": [
          "Com tua mão vem ajudar-me,",
          "pois escolhi os teus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          174
        ],
        "lines": [
          "Anseio pela tua salvação, Senhor,",
          "e a tua lei é o meu prazer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          175
        ],
        "lines": [
          "Permite-me viver para que eu te louve;",
          "e que as tuas ordenanças me sustentem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          176
        ],
        "lines": [
          "Andei vagando como ovelha perdida;",
          "vem em busca do teu servo,",
          "pois não me esqueci dos teus mandamentos."
        ],
        "rlw_lines": []
      }
    ]
