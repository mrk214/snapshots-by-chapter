    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de Peregrinação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Das profundezas clamo a ti, Senhor;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "ouve, Senhor, a minha voz!",
          "Estejam atentos os teus ouvidos às minhas súplicas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Se tu, Soberano Senhor,",
          "registrasses os pecados, quem escaparia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mas contigo está o perdão",
          "para que sejas temido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Espero no Senhor com todo o meu ser",
          "e na sua palavra ponho a minha esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Espero pelo Senhor",
          "mais do que as sentinelas pela manhã;",
          "sim, mais do que as sentinelas esperam pela manhã!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ponha a sua esperança no Senhor, ó Israel,",
          "pois no Senhor há amor leal e plena redenção."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele próprio redimirá Israel",
          "de todas as suas culpas."
        ],
        "rlw_lines": []
      }
    ]
  },
