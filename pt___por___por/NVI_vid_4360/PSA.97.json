    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O Senhor reina! Exulte a terra",
          "e alegrem-se as regiões costeiras distantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nuvens escuras e espessas o cercam;",
          "retidão e justiça são a base do seu trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Fogo vai adiante dele",
          "e devora os adversários ao redor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Seus relâmpagos iluminam o mundo;",
          "a terra os vê e estremece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os montes se derretem como cera diante do Senhor,",
          "diante do Soberano de toda a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os céus proclamam a sua justiça,",
          "e todos os povos contemplam a sua glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ficam decepcionados todos os que adoram imagens",
          "e se vangloriam de ídolos.",
          "Prostram-se diante dele todos os deuses!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sião ouve e se alegra,",
          "e as cidades de Judá exultam,",
          "por causa das tuas sentenças, Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pois tu, Senhor, és o Altíssimo sobre toda a terra!",
          "És exaltado muito acima de todos os deuses!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Odeiem o mal, vocês que amam o Senhor,",
          "pois ele protege a vida dos seus fiéis",
          "e os livra das mãos dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A luz nasce sobre o justo",
          "e a alegria sobre os retos de coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Alegrem-se no Senhor, justos,",
          "e louvem o seu santo nome."
        ],
        "rlw_lines": []
      }
    ]
  },
