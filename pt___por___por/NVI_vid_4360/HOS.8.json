    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Castigo de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Coloquem a trombeta em seus lábios!",
          "Ele vem ameaçador como uma águia",
          "sobre o templo do Senhor,",
          "porquanto quebraram a minha aliança",
          "e se rebelaram contra a minha Lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Israel clama a mim:",
          "‘Ó nosso Deus, nós te reconhecemos!’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mas Israel rejeitou o que é bom;",
          "um inimigo o perseguirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eles instituíram reis sem o meu consentimento;",
          "escolheram líderes sem a minha aprovação.",
          "Com prata e ouro fizeram ídolos para si,",
          "para a sua própria destruição."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Lance fora o seu ídolo em forma de bezerro, ó Samaria!",
          "A minha ira se acende contra eles.",
          "Até quando serão incapazes de pureza?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Este bezerro procede de Israel! Um escultor o fez.",
          "Ele não é Deus.",
          "Será partido em pedaços",
          "o bezerro de Samaria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Eles semeiam vento",
          "e colhem tempestade.",
          "Talo sem espiga;",
          "que não produz farinha.",
          "Ainda que produzisse trigo,",
          "estrangeiros o devorariam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Israel é devorado;",
          "agora está entre as nações",
          "como algo sem valor;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "foi para a Assíria.",
          "O jumento selvagem mantém-se livre,",
          "mas Efraim vendeu-se para os seus amantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Embora tenham se vendido às nações,",
          "agora os ajuntarei,",
          "e logo começarão a definhar",
          "sob a opressão do poderoso rei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Embora Efraim tenha construído",
          "muitos altares para ofertas pelo pecado,",
          "eles se tornaram altares para o pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eu lhes escrevi todos os ensinos da minha Lei,",
          "mas eles os consideraram algo estranho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Eles oferecem sacrifícios e comem a carne,",
          "mas o Senhor não se agrada deles.",
          "Doravante, ele se lembrará da impiedade deles",
          "e castigará os seus pecados:",
          "eles voltarão para o Egito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Israel esqueceu o seu Criador",
          "e construiu palácios;",
          "Judá fortificou muitas cidades.",
          "Mas sobre as suas cidades enviarei fogo",
          "que consumirá suas fortalezas.”"
        ],
        "rlw_lines": []
      }
    ]
  },
