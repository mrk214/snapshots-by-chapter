    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Conselhos da Sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Meu filho, não se esqueça da minha lei,",
          "mas guarde no coração os meus mandamentos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "pois eles prolongarão a sua vida por muitos anos",
          "e darão a você prosperidade e paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que o amor e a fidelidade jamais o abandonem;",
          "prenda-os ao redor do seu pescoço,",
          "escreva-os na tábua do seu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Então você terá o favor de Deus e dos homens",
          "e boa reputação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Confie no Senhor de todo o seu coração",
          "e não se apoie em seu próprio entendimento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "reconheça o Senhor em todos os seus caminhos,",
          "e ele endireitará as suas veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Não seja sábio aos seus próprios olhos;",
          "tema o Senhor e evite o mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Isso dará a você saúde ao corpo",
          "e vigor aos ossos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Honre o Senhor com todos os seus recursos",
          "e com os primeiros frutos de todas as suas plantações;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "os seus celeiros ficarão plenamente cheios,",
          "e os seus barris transbordarão de vinho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Meu filho, não despreze a disciplina do Senhor",
          "nem se magoe com a sua repreensão,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "pois o Senhor disciplina a quem ama,",
          "assim como o pai faz ao filho de quem deseja o bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Como é feliz o homem que acha a sabedoria,",
          "o homem que obtém entendimento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "pois a sabedoria é mais proveitosa do que a prata",
          "e rende mais do que o ouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "É mais preciosa do que rubis;",
          "nada do que você possa desejar se compara a ela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Na mão direita, a sabedoria garante a você vida longa;",
          "na mão esquerda, riquezas e honra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os caminhos da sabedoria são caminhos agradáveis,",
          "e todas as suas veredas são paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "A sabedoria é árvore que dá vida a quem a abraça;",
          "quem a ela se apega será abençoado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Por sua sabedoria o Senhor lançou os alicerces da terra,",
          "por seu entendimento fixou no lugar os céus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "por seu conhecimento as fontes profundas se rompem",
          "e as nuvens gotejam o orvalho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Meu filho, guarde consigo a sensatez e o equilíbrio,",
          "nunca os perca de vista;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "trarão vida a você",
          "e serão um enfeite para o seu pescoço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Então você seguirá o seu caminho em segurança",
          "e não tropeçará;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "quando se deitar, não terá medo,",
          "e o seu sono será tranquilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Não terá medo da calamidade repentina",
          "nem da ruína que atinge os ímpios,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "pois o Senhor será a sua segurança",
          "e o impedirá de cair em armadilha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Quanto for possível,",
          "não deixe de fazer o bem a quem dele precisa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Não diga ao seu próximo:",
          "“Volte amanhã, e eu darei algo a você”,",
          "se pode ajudá-lo hoje."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Não planeje o mal contra o seu próximo",
          "que confiantemente mora perto de você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Não acuse alguém sem motivo",
          "se ele não fez nenhum mal a você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Não tenha inveja de quem é violento",
          "nem adote nenhum dos seus procedimentos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "pois o Senhor detesta o perverso,",
          "mas o justo é seu grande amigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "A maldição do Senhor está sobre a casa dos ímpios,",
          "mas ele abençoa o lar dos justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Ele zomba dos zombadores,",
          "mas concede graça aos humildes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "A honra é herança dos sábios,",
          "mas o Senhor expõe os tolos ao ridículo."
        ],
        "rlw_lines": []
      }
    ]
  },
