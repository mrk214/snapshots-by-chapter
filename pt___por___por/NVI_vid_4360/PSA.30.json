    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo. Cântico para a dedicação do templo. Davídico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu te exaltarei, Senhor, pois tu me reergueste",
          "e não deixaste que os meus inimigos se divertissem à minha custa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Senhor meu Deus, a ti clamei por socorro,",
          "e tu me curaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Senhor, tiraste-me da sepultura;",
          "prestes a descer à cova, devolveste-me à vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cantem louvores ao Senhor, vocês, os seus fiéis;",
          "louvem o seu santo nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois a sua ira só dura um instante,",
          "mas o seu favor dura a vida toda;",
          "o choro pode persistir uma noite,",
          "mas de manhã irrompe a alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quando me senti seguro, disse:",
          "Jamais serei abalado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Senhor, com o teu favor,",
          "deste-me firmeza e estabilidade;",
          "mas, quando escondeste a tua face,",
          "fiquei aterrorizado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A ti, Senhor, clamei,",
          "ao Senhor pedi misericórdia:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Se eu morrer, se eu descer à cova,",
          "que vantagem haverá?",
          "Acaso o pó te louvará?",
          "Proclamará a tua fidelidade?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ouve, Senhor, e tem misericórdia de mim;",
          "Senhor, sê tu o meu auxílio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mudaste o meu pranto em dança,",
          "a minha veste de lamento em veste de alegria,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "para que o meu coração cante louvores a ti e não se cale.",
          "Senhor, meu Deus, eu te darei graças para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
