  "book": {
    "book_usfm": "PRO",
    "name": "Provérbios"
  },
  "chapter": {
    "chapter_usfm": "PRO.19",
    "current": {
      "usfm": "PRO.19",
      "human": "Provérbios 19"
    },
    "previous": {
      "usfm": "PRO.18",
      "human": "Provérbios 18"
    },
    "next": {
      "usfm": "PRO.20",
      "human": "Provérbios 20"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Melhor é o pobre que anda",
          "na sua integridade",
          "do que o perverso de lábios,",
          "que é um tolo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Não é bom agir sem pensar;",
          "quem se precipita acaba pecando."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A tolice de uma pessoa",
          "perverte o seu caminho,",
          "mas é contra o Senhor que",
          "o seu coração se irrita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Na riqueza,",
          "os amigos se multiplicam;",
          "mas o pobre, até o seu único amigo",
          "o abandona."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A falsa testemunha",
          "não ficará impune,",
          "e o que profere mentiras",
          "não escapará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ao generoso, muitos o adulam,",
          "e todos são amigos",
          "de quem dá presentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Se os irmãos do pobre",
          "o detestam,",
          "quanto mais se afastarão dele",
          "os seus amigos!",
          "Corre atrás deles com súplicas,",
          "mas não os alcança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Quem adquire sabedoria",
          "ama a sua alma;",
          "o que conserva o entendimento",
          "acha o bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A falsa testemunha",
          "não ficará impune,",
          "e o que profere mentiras perecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ao tolo não fica bem",
          "viver no luxo;",
          "quanto menos ao escravo",
          "dominar os príncipes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O bom senso leva a pessoa",
          "a controlar a sua ira;",
          "a sua glória é perdoar as ofensas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A indignação do rei",
          "é como o rugido do leão,",
          "mas a sua bondade",
          "é como o orvalho sobre a relva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Um filho tolo",
          "é a desgraça do pai,",
          "e uma esposa briguenta",
          "é como uma goteira",
          "que não para."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "A casa e os bens vêm",
          "como herança dos pais,",
          "mas a esposa sensata",
          "vem do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "A preguiça faz cair",
          "em profundo sono,",
          "e o ocioso passará fome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Quem guarda o mandamento",
          "guarda a sua alma,",
          "mas o que despreza",
          "os seus caminhos,",
          "esse morrerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Quem se compadece do pobre",
          "empresta ao Senhor,",
          "e este lhe retribuirá o benefício."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Corrija o seu filho,",
          "enquanto há esperança,",
          "mas não se exceda",
          "a ponto de matá-lo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Aquele que se deixa levar pela ira",
          "terá de sofrer o castigo;",
          "porque, se você o livrar,",
          "terá de livrá-lo de novo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Ouça os conselhos",
          "e receba a instrução,",
          "para que você seja sábio",
          "a partir de agora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Há muitos planos",
          "no coração do ser humano,",
          "mas o propósito do Senhor",
          "permanecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "O que torna alguém agradável",
          "é a sua misericórdia;",
          "o pobre é preferível ao mentiroso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "O temor do Senhor",
          "conduz à vida;",
          "aquele que o tem ficará satisfeito,",
          "e mal nenhum o visitará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "O preguiçoso põe a mão",
          "no prato",
          "e não quer ter o trabalho",
          "de a levar à boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Castigue o zombador,",
          "e o ingênuo aprenderá",
          "a prudência;",
          "repreenda o sábio,",
          "e ele crescerá",
          "no conhecimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Quem maltrata o seu pai",
          "ou manda embora a sua mãe",
          "é filho que causa vergonha",
          "e traz desonra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Meu filho, se deixar de ouvir",
          "a instrução,",
          "você se desviará das palavras",
          "do conhecimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "A testemunha depravada",
          "zomba da justiça,",
          "e a boca dos ímpios",
          "devora a iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Preparados estão os juízos",
          "para os zombadores",
          "e os açoites para as costas",
          "dos tolos."
        ],
        "rlw_lines": []
      }
    ]
  },
