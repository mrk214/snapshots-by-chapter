    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esperança somente em Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia de Jedutum. De Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Somente em Deus a minha alma",
          "espera silenciosa;",
          "dele vem a minha salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Só ele é a minha rocha,",
          "a minha salvação",
          "e o meu alto refúgio;",
          "não serei muito abalado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Até quando vocês atacarão",
          "um homem,",
          "todos vocês, para o derrubarem,",
          "como se fosse uma parede pendida",
          "ou um muro prestes a cair?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Só pensam em derrubá-lo",
          "da sua dignidade.",
          "Eles se alegram na mentira;",
          "de boca bendizem,",
          "porém no interior maldizem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Somente em Deus, ó minha alma,",
          "espere silenciosa,",
          "porque dele vem",
          "a minha esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Só ele é a minha rocha,",
          "a minha salvação",
          "e o meu alto refúgio;",
          "não serei jamais abalado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "De Deus dependem",
          "a minha salvação",
          "e a minha glória;",
          "ele é a minha forte rocha",
          "e o meu refúgio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Confie nele em todo tempo,",
          "ó povo;",
          "derrame diante dele",
          "o seu coração.",
          "Deus é o nosso refúgio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pura vaidade",
          "são os homens plebeus;",
          "os de fina estirpe",
          "não passam de falsidade;",
          "pesados em balança,",
          "eles juntos são mais leves",
          "do que a vaidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Não confiem na opressão,",
          "nem ponham falsas esperanças",
          "na rapina.",
          "Se as riquezas de vocês aumentam,",
          "não ponham nelas o coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Uma vez Deus falou,",
          "duas vezes ouvi isto:",
          "Que o poder pertence a Deus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "e a ti, Senhor, pertence a graça,",
          "pois a cada um retribuis",
          "segundo as suas obras."
        ],
        "rlw_lines": []
      }
    ]
  },
