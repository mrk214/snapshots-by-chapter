    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "Terceiro diálogo"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "Caps.22—27"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Terceira fala de Elifaz"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Você cometeu muitos pecados"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Elifaz, o temanita, tomou a palavra e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Pode o homem ser",
          "de algum proveito para Deus?",
          "Não! O sábio só é útil a si mesmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Será que o Todo-Poderoso",
          "tem interesse",
          "em que você seja justo?",
          "Será que ele tem algum lucro,",
          "se você for perfeito",
          "em todos os seus caminhos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ou será que é por causa",
          "do seu temor a Deus",
          "que ele o repreende",
          "ou entra em juízo contra você?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Não é fato que é grande",
          "a sua maldade,",
          "e incalculável a sua iniquidade?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque sem motivo você exigiu",
          "penhores do seu irmão",
          "e despojou das roupas",
          "os que estavam seminus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Você não deu água ao cansado",
          "e ao faminto você se recusou",
          "a dar pão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A terra pertencia",
          "ao homem poderoso,",
          "e só os privilegiados",
          "moravam nela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Você despediu as viúvas",
          "de mãos vazias,",
          "e os braços dos órfãos",
          "foram quebrados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por isso, você está cercado",
          "de laços,",
          "e repentino pavor",
          "toma conta de você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Está submerso por trevas,",
          "que impedem você de enxergar,",
          "e pelas águas transbordantes",
          "que o cobrem.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Você quer seguir os iníquos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Não está Deus",
          "nas alturas do céu?",
          "Olhe para as estrelas mais altas!",
          "Que altura!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "E você diz:",
          "‘O que é que Deus sabe?",
          "Será que ele pode julgar",
          "através de densa escuridão?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Grossas nuvens o encobrem,",
          "de modo que não pode ver;",
          "ele só passeia",
          "pela abóbada do céu.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "“Você quer seguir a rota antiga,",
          "que os iníquos percorreram?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Estes foram levados",
          "antes do tempo;",
          "uma torrente arrastou",
          "os seus alicerces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Diziam a Deus:",
          "‘Deixa-nos em paz.’",
          "E perguntavam:",
          "‘O que pode fazer-nos",
          "o Todo-Poderoso?’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Contudo, foi Deus",
          "quem encheu de bens",
          "as casas deles.",
          "Longe de mim",
          "o conselho dos ímpios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Os justos veem",
          "a destruição deles",
          "e se alegram;",
          "o inocente zomba deles,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "dizendo: ‘Na verdade,",
          "os nossos adversários",
          "foram destruídos,",
          "e o fogo consumiu o resto deles.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Reconcilie-se com Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "“Portanto, reconcilie-se",
          "com Deus, viva em paz com ele",
          "e assim lhe sobrevirá o bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Aceite a instrução",
          "que vem da boca de Deus",
          "e guarde as palavras dele",
          "em seu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Se você se converter",
          "ao Todo-Poderoso,",
          "será restabelecido;",
          "se afastar da sua tenda a injustiça"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "e lançar ao pó o seu ouro —",
          "o ouro de Ofir",
          "entre pedras dos ribeiros —,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "então o Todo-Poderoso",
          "será o seu ouro",
          "e a sua prata escolhida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Então você encontrará prazer",
          "no Todo-Poderoso",
          "e levantará o seu rosto para Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Você fará oração,",
          "e Deus o ouvirá;",
          "e você pagará os seus votos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Se você projetar alguma coisa,",
          "ela lhe será bem-sucedida,",
          "e a luz brilhará em seus caminhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Se forem humilhados,",
          "você dirá: ‘Para cima!’",
          "E Deus salvará o humilde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Livrará até o que não é inocente;",
          "sim, será libertado,",
          "porque você tem",
          "as mãos limpas.”"
        ],
        "rlw_lines": []
      }
    ]
  },
