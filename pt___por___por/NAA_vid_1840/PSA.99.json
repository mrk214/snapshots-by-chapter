    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A santidade de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Reina o Senhor;",
          "tremam os povos.",
          "Ele está entronizado",
          "acima dos querubins;",
          "abale-se a terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O Senhor é grande em Sião",
          "e está exaltado",
          "acima de todos os povos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Celebrem eles o teu nome",
          "grande e tremendo,",
          "porque é santo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "És rei poderoso",
          "que ama a justiça;",
          "tu estabeleces o direito,",
          "executas o juízo e a justiça em Jacó."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Exaltem o Senhor, nosso Deus,",
          "e prostrem-se diante do estrado",
          "de seus pés.",
          "O Senhor é santo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Moisés e Arão,",
          "entre os seus sacerdotes,",
          "e, Samuel, entre os que",
          "lhe invocam o nome,",
          "clamavam ao Senhor,",
          "e ele os ouvia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Falava-lhes na coluna de nuvem;",
          "eles guardavam",
          "os seus mandamentos",
          "e a lei que lhes tinha dado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tu lhes respondeste,",
          "ó Senhor, nosso Deus;",
          "foste para eles Deus perdoador,",
          "ainda que os tenhas castigado",
          "por seus atos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Exaltem o Senhor, nosso Deus,",
          "e prostrem-se",
          "diante do seu santo monte,",
          "porque santo é o Senhor,",
          "nosso Deus."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
