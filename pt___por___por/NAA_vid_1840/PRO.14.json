{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PRO","name":"Provérbios"},"chapter":{"chapter_usfm":"PRO.14","is_chapter":true,"previous":{"usfm":"PRO.13","human":"Provérbios 13","canonical":true,"toc":true},"current":{"usfm":"PRO.14","human":"Provérbios 14"},"next":{"usfm":"PRO.15","human":"Provérbios 15","canonical":true,"toc":true},"items":[{"type":"verse","verse_numbers":[1],"lines":["A mulher sábia edifica a sua casa,","mas a insensata a derruba","com as próprias mãos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Quem anda na retidão","teme o Senhor,","mas o que anda","em caminhos tortuosos,","esse o despreza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Na boca do tolo","está a vara","para a sua própria soberba,","mas os lábios dos sábios","os protegerão."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Quando não há bois,","o celeiro fica vazio,","mas pela força do boi","há abundância de colheitas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["A testemunha verdadeira","não mente,","mas a testemunha falsa despeja mentiras."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["O zombador procura a sabedoria","e não a encontra,","mas o sábio adquire","o conhecimento com facilidade."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Fuja da presença do insensato,","porque nele você não encontrará","palavras de conhecimento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["A sabedoria do prudente","é entender","o seu próprio caminho,","mas a insensatez dos tolos","é enganadora."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Os insensatos","zombam do pecado,","mas entre os retos há boa vontade."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["O coração conhece","a sua própria amargura,","e da alegria que ele sente","os estranhos","não poderão participar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["A casa dos ímpios será destruída,","mas a tenda dos retos florescerá."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Há caminho que ao ser humano","parece direito,","mas o fim dele","é caminho de morte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Até no riso","o coração pode ter dor,","e o fim da alegria","pode ser a tristeza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["O infiel de coração","sofre as consequências","dos seus próprios caminhos,","mas quem é de bem","é recompensado","pelo seu próprio proceder."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["O ingênuo dá crédito","a tudo o que se diz,","mas o prudente reflete","antes de dar um passo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["O sábio é cauteloso","e se desvia do mal,","mas o tolo é afoito","e se dá por seguro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Quem logo se irrita","comete loucuras,","e aquele que tem más intenções","será odiado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Os ingênuos herdam a tolice,","mas os prudentes","se coroam de conhecimento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Os maus se inclinarão","diante dos bons,","e os ímpios farão súplicas","junto às portas do justo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["O pobre é odiado","até pelo seu vizinho,","mas o rico tem muitos amigos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Quem despreza o seu vizinho","peca,","mas o que se compadece","dos pobres é feliz."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Por acaso não se afastam","do caminho","os que planejam o mal?","Mas haverá amor e fidelidade","para os que planejam o bem."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Em todo trabalho há proveito;","meras palavras, porém,","levam à pobreza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Para os sábios a riqueza é coroa,","mas a tolice dos insensatos","não passa de tolice."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["A testemunha verdadeira","salva vidas,","mas quem profere mentiras","é enganador."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Quem teme o Senhor","tem forte amparo,","e isso é refúgio para os seus filhos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["O temor do Senhor","é fonte de vida","para evitar os laços da morte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Na multidão do povo","está a glória do rei,","mas na falta de povo","está a ruína do príncipe."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Quem tarda em irar-se","é grande em entendimento,","mas o que facilmente","perde a calma","faz um elogio à loucura."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["O ânimo sereno","é a vida do corpo,","mas a inveja","é a podridão dos ossos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Quem oprime o pobre","insulta aquele que o criou,","mas o que se compadece","do necessitado honra a Deus."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["O ímpio é derrubado","pela sua maldade,","mas o justo, até na morte","tem esperança."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["No coração do prudente","repousa a sabedoria,","mas o que há no interior dos tolos","logo se manifesta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["A justiça é a glória da nação,","mas o pecado é a vergonha","dos povos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["O servo prudente","recebe o favor do rei,","mas o que causa vergonha","é objeto do seu furor."],"rlw_lines":[]}]}}