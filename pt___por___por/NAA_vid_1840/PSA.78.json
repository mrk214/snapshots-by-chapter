    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus e o seu povo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo didático de Asafe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Meu povo, escute a minha lei;",
          "dê ouvidos às palavras",
          "da minha boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Abrirei os meus lábios",
          "para proferir parábolas",
          "e publicarei enigmas",
          "dos tempos antigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O que ouvimos e aprendemos,",
          "o que os nossos pais",
          "nos contaram,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "não o encobriremos",
          "a seus filhos;",
          "contaremos à geração vindoura",
          "os louvores do Senhor,",
          "e o seu poder,",
          "e as maravilhas que fez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele estabeleceu",
          "um testemunho em Jacó,",
          "e instituiu uma lei em Israel,",
          "e ordenou aos nossos pais",
          "que os transmitissem a seus filhos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "a fim de que a nova geração",
          "os conhecesse,",
          "e os filhos que ainda hão de nascer",
          "se levantassem e, por sua vez,",
          "os contassem",
          "aos seus descendentes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para que pusessem",
          "a sua confiança em Deus",
          "e não se esquecessem",
          "dos feitos de Deus,",
          "mas lhe observassem",
          "os mandamentos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "e que não fossem,",
          "como seus pais,",
          "geração obstinada e rebelde,",
          "geração de coração inconstante,",
          "e cujo espírito não foi fiel a Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os filhos de Efraim,",
          "embora armados com arcos,",
          "bateram em retirada",
          "no dia do combate."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Não guardaram",
          "a aliança de Deus,",
          "não quiseram andar na sua lei;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "esqueceram-se das suas obras",
          "e das maravilhas",
          "que lhes havia mostrado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Deus fez prodígios",
          "na presença de seus pais",
          "na terra do Egito, no campo de Zoã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Dividiu o mar",
          "e os fez passar por ele;",
          "fez parar as águas",
          "como um montão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Durante o dia,",
          "os guiou com uma nuvem",
          "e de noite,",
          "com um clarão de fogo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "No deserto, fendeu rochas",
          "e lhes deu de beber",
          "abundantemente",
          "como de abismos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Da pedra fez brotar torrentes,",
          "fez manar água como rios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Mas, ainda assim, continuaram",
          "a pecar contra ele",
          "e se rebelaram, no deserto,",
          "contra o Altíssimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tentaram a Deus no seu coração,",
          "pedindo alimento",
          "que lhes fosse do gosto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Falaram contra Deus, dizendo:",
          "“Será que Deus pode preparar-nos",
          "uma mesa no deserto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "É verdade que ele feriu a rocha,",
          "e dela manaram águas,",
          "transbordaram as torrentes.",
          "Mas será que ele pode",
          "dar-nos pão também?",
          "Ou fornecer carne",
          "para o seu povo?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Ouvindo isto,",
          "o Senhor ficou indignado;",
          "acendeu-se fogo contra Jacó,",
          "e também se levantou",
          "o seu furor contra Israel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "porque não creram em Deus,",
          "nem confiaram na sua salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Mesmo assim,",
          "deu ordens às nuvens",
          "e abriu as portas dos céus;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "fez chover maná sobre eles,",
          "para alimentá-los,",
          "e lhes deu cereal do céu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Todos comeram o pão dos anjos;",
          "ele enviou-lhes comida à vontade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Fez soprar no céu",
          "o vento do Oriente",
          "e pelo seu poder conduziu",
          "o vento do Sul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Também fez chover sobre eles",
          "carne como poeira",
          "e aves numerosas",
          "como a areia do mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Fez com que caíssem",
          "no meio do arraial deles,",
          "ao redor de suas tendas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Então comeram",
          "e se fartaram a valer;",
          "pois lhes fez o que desejavam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Porém não reprimiram o apetite.",
          "Ainda tinham o alimento na boca,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "quando se elevou contra eles",
          "a ira de Deus,",
          "e entre os seus mais robustos",
          "semeou a morte,",
          "e prostrou os jovens de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Apesar de tudo isso,",
          "continuaram a pecar",
          "e não creram",
          "nas maravilhas de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Por isso, ele fez",
          "com que os seus dias",
          "se dissipassem num sopro",
          "e os seus anos, em súbito terror."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Quando os fazia morrer,",
          "eles o buscavam;",
          "arrependidos, procuravam Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Lembravam-se de que Deus",
          "era a sua rocha",
          "e o Deus Altíssimo, o seu Redentor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Lisonjeavam-no, porém de boca,",
          "e com a língua lhe mentiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Porque o coração deles",
          "não era firme para com ele,",
          "nem foram fiéis à sua aliança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Ele, porém, que é misericordioso,",
          "perdoa a iniquidade e não destrói;",
          "muitas vezes desvia a sua ira",
          "e não desperta",
          "toda a sua indignação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Lembra-se de que eles são",
          "simples mortais,",
          "vento que passa e não volta mais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Quantas vezes se rebelaram",
          "contra ele no deserto",
          "e nos lugares áridos",
          "lhe causaram tristeza!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Tornaram a pôr Deus à prova,",
          "ofenderam o Santo de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Não se lembraram do poder dele,",
          "nem do dia em que os resgatou",
          "do adversário;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "de como no Egito",
          "ele operou os seus sinais",
          "e os seus prodígios,",
          "no campo de Zoã;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "e transformou em sangue",
          "os rios deles,",
          "para que das suas correntes",
          "não bebessem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Enviou contra eles",
          "enxames de moscas",
          "que os devorassem",
          "e rãs que os destruíssem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Entregou às lagartas",
          "as suas colheitas",
          "e aos gafanhotos,",
          "o fruto do seu trabalho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Com chuvas de pedra",
          "lhes destruiu as vinhas",
          "e os seus sicômoros, com geada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Entregou ao granizo o gado deles",
          "e aos raios, os seus rebanhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Lançou contra eles",
          "o furor da sua ira:",
          "cólera, indignação e calamidade,",
          "legião de anjos",
          "portadores de males."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Deu livre curso à sua ira;",
          "não poupou da morte a alma deles,",
          "mas entregou a vida deles à peste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Matou todos",
          "os primogênitos no Egito,",
          "as primícias do vigor",
          "nas tendas de Cam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Fez sair o seu povo como ovelhas",
          "e o guiou pelo deserto,",
          "como um rebanho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Dirigiu-o com segurança,",
          "e não tiveram medo,",
          "ao passo que o mar",
          "submergiu os seus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Levou-os até a sua terra santa,",
          "até o monte que",
          "a sua mão direita adquiriu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Da presença deles",
          "expulsou as nações,",
          "cuja região repartiu com eles",
          "por herança;",
          "e nas suas tendas fez habitar",
          "as tribos de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Ainda assim, tentaram",
          "o Deus Altíssimo,",
          "e a ele resistiram,",
          "e não lhe guardaram",
          "os testemunhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "Tornaram atrás e foram infiéis",
          "como os seus pais;",
          "desviaram-se",
          "como um arco enganoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Pois o provocaram à ira",
          "com os seus lugares altos",
          "e com as suas imagens de escultura",
          "despertaram o seu ciúme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Deus ouviu isso e se indignou;",
          "rejeitou completamente",
          "o povo de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Por isso, abandonou",
          "o tabernáculo de Siló,",
          "a tenda de sua morada",
          "aqui na terra,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "e passou a arca da aliança",
          "ao cativeiro,",
          "e a sua glória, à mão do adversário."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "Entregou o seu povo à espada",
          "e se encolerizou",
          "contra a sua própria herança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "O fogo devorou os jovens deles,",
          "e as suas donzelas",
          "não tiveram canto nupcial."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Os seus sacerdotes",
          "caíram à espada,",
          "e as suas viúvas",
          "não fizeram lamentações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Então o Senhor despertou",
          "como de um sono,",
          "como um valente que grita",
          "excitado pelo vinho;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "fez recuar a golpes",
          "os seus adversários",
          "e os entregou",
          "a perpétuo desprezo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Além disso, rejeitou",
          "a tenda de José",
          "e não elegeu a tribo de Efraim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Pelo contrário,",
          "escolheu a tribo de Judá,",
          "o monte Sião, que ele amava."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "E construiu o seu santuário",
          "durável como os céus",
          "e firme como a terra",
          "que estabeleceu para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "Também escolheu",
          "o seu servo Davi,",
          "e o tirou do aprisco das ovelhas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "do cuidado das ovelhas",
          "e suas crias,",
          "para ser o pastor de Jacó, seu povo,",
          "e de Israel, sua herança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "E ele os apascentou",
          "segundo a integridade",
          "do seu coração",
          "e os dirigiu com sábias mãos."
        ],
        "rlw_lines": []
      }
    ]
  },
