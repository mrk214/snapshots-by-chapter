    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contra a aliança com o Egito"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Ai dos filhos rebeldes”,",
          "diz o Senhor,",
          "“que executam planos",
          "que não procedem de mim",
          "e fazem aliança sem consultar",
          "o meu Espírito,",
          "para acrescentarem",
          "pecado sobre pecado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Eles descem ao Egito",
          "sem me consultar,",
          "buscando refúgio em Faraó",
          "e abrigo à sombra do Egito!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mas o refúgio de Faraó",
          "se transformará",
          "em vergonha para vocês,",
          "e o abrigo na sombra do Egito",
          "resultará em humilhação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque os príncipes de Judá",
          "já estão em Zoã,",
          "e os seus embaixadores",
          "já chegaram a Hanes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mas todos ficarão envergonhados",
          "por causa de um povo",
          "que não os ajudará em nada,",
          "que não servirá nem de ajuda",
          "nem de proveito,",
          "porém de vergonha e de vexame.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sentença contra a Besta do Sul.",
          "“Atravessando a terra da aflição",
          "e da angústia,",
          "de onde vêm a leoa, o leão,",
          "a víbora e a serpente voadora,",
          "os embaixadores levam",
          "as suas riquezas",
          "em lombo de jumento,",
          "e transportam os seus tesouros",
          "sobre as corcovas de camelos.",
          "Levam as suas riquezas",
          "e os seus tesouros",
          "a um povo que não lhes será",
          "de proveito algum."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pois, quanto ao Egito,",
          "o seu auxílio é vão e inútil.",
          "Por isso, eu o chamo de",
          "‘Besta que nada faz’.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Um povo rebelde"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Agora vá e escreva isso",
          "numa tabuinha diante deles,",
          "escreva-o num livro,",
          "para que fique registrado",
          "para os dias vindouros,",
          "para sempre, perpetuamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque este é um povo rebelde;",
          "são filhos mentirosos,",
          "filhos que não querem ouvir",
          "a lei do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eles dizem aos videntes:",
          "‘Não tenham mais visões!’",
          "E aos profetas: ‘Não profetizem",
          "para nós o que é reto;",
          "digam-nos coisas agradáveis,",
          "profetizem ilusões."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Desviem-se do caminho,",
          "afastem-se da vereda;",
          "não nos falem mais",
          "a respeito do Santo de Israel.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por isso o Santo de Israel diz:",
          "“Vocês rejeitam esta palavra,",
          "confiam na opressão",
          "e na perversidade",
          "e se apoiam sobre isso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Portanto, esta maldade",
          "será para vocês",
          "como brecha num muro alto,",
          "que, formando uma barriga,",
          "está prestes a cair,",
          "e cuja queda vem de repente,",
          "num momento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor quebrará esse muro",
          "como se quebra o vaso do oleiro,",
          "despedaçando-o por completo;",
          "não se achará entre os seus cacos",
          "um que sirva para tirar brasas",
          "da lareira",
          "ou apanhar água da cisterna.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Porque assim diz o Senhor Deus,",
          "o Santo de Israel:",
          "“Na conversão e no descanso",
          "está a salvação de vocês;",
          "na tranquilidade e na confiança",
          "reside a força de vocês.",
          "Mas vocês não quiseram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pelo contrário, disseram:",
          "‘Nada disso!",
          "Nós vamos fugir a cavalo!’",
          "Portanto, vocês fugirão.",
          "E vocês disseram:",
          "‘Vamos cavalgar",
          "sobre cavalos ligeiros!’",
          "Portanto, ligeiros serão aqueles",
          "que perseguem vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Mil homens fugirão",
          "pela ameaça de apenas um;",
          "pela ameaça de cinco,",
          "todos vocês fugirão,",
          "até que sejam deixados",
          "como um mastro",
          "no alto do monte",
          "e como um estandarte",
          "no topo da colina.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Promessas consoladoras para Sião"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Por isso, o Senhor espera,",
          "para ter misericórdia de vocês,",
          "e se levanta, para se compadecer",
          "de vocês,",
          "porque o Senhor é Deus de justiça.",
          "Bem-aventurados todos os que nele esperam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Porque o povo habitará em Sião, em Jerusalém. Vocês não vão chorar mais. Ele certamente se compadecerá, ao ouvir o clamor de vocês; e, ouvindo-o, lhes responderá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Embora o Senhor lhes dê pão de angústia e água de aflição, os mestres de vocês não se esconderão mais; vocês os verão com os seus próprios olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Quando vocês se desviarem para a direita ou para a esquerda, ouvirão atrás de vocês uma palavra, dizendo: “Este é o caminho; andem nele.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Vocês tratarão como impuras as imagens esculpidas cobertas de prata e as imagens de fundição revestidas de ouro; vocês as jogarão fora como coisa impura e dirão a cada uma delas: “Fora daqui!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "O Senhor lhes dará chuva para as sementes que vocês semearem na terra, e também lhes dará o alimento que a terra produzir, o qual será farto e nutritivo. Naquele dia, o gado de vocês pastará em lugares espaçosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Os bois e os jumentos que lavram a terra comerão forragem com sal, espalhada com pá e forcado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "No dia do grande massacre, quando caírem as torres, haverá ribeiros e correntes de água em todos os montes altos e em todas as colinas elevadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "A luz da lua será como a do sol, e a do sol será sete vezes maior, como a luz de sete dias, no dia em que o Senhor tratar as fraturas do seu povo e curar a ferida do golpe que ele deu."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O julgamento da Assíria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Eis que o nome do Senhor",
          "vem de longe,",
          "ardendo na sua ira,",
          "no meio de espessas nuvens.",
          "Os seus lábios",
          "estão cheios de indignação,",
          "e a sua língua",
          "é como fogo devorador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "A sua respiração",
          "é como a torrente",
          "que transborda",
          "e chega até o pescoço.",
          "Ele vem peneirar as nações",
          "com peneira de destruição;",
          "porá na boca dos povos um freio",
          "para fazer com que andem errantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Vocês cantarão como nas noites",
          "em que se celebra",
          "uma festa santa;",
          "terão alegria de coração",
          "como a daquele que sai",
          "ao som da flauta",
          "para ir ao monte do Senhor,",
          "à Rocha de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "O Senhor fará ouvir",
          "a sua voz majestosa",
          "e fará ver o golpe do seu braço,",
          "que desce com indignação de ira,",
          "no meio de chamas devoradoras,",
          "de chuvas torrenciais,",
          "de tempestades e de granizo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Porque a Assíria ficará apavorada",
          "com a voz do Senhor,",
          "quando ele a ferir com",
          "o seu bastão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Cada pancada castigadora",
          "que o Senhor lhe der com o bastão",
          "será ao som de tamborins e harpas;",
          "ele combaterá desferindo",
          "golpes contra eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Porque há muito está preparada",
          "a fogueira;",
          "sim, preparada para o rei.",
          "Ela é profunda e larga,",
          "com fogo e lenha em abundância;",
          "o sopro do Senhor,",
          "como torrente de enxofre,",
          "a acenderá."
        ],
        "rlw_lines": []
      }
    ]
  },
