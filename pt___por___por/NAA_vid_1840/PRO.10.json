    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O justo em contraste com o ímpio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Provérbios de Salomão.",
          "O filho sábio",
          "é a alegria do seu pai,",
          "mas o filho tolo",
          "é a tristeza da sua mãe."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Os tesouros conseguidos",
          "de forma iníqua",
          "não servem para nada,",
          "mas a justiça livra da morte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O Senhor não deixa",
          "o justo passar fome,",
          "mas rechaça a avidez dos ímpios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Quem trabalha",
          "com a mão ociosa fica pobre,",
          "mas o que trabalha",
          "com diligência enriquece."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem ajunta no verão",
          "é filho sábio,",
          "mas o que dorme",
          "no tempo da colheita",
          "é filho que envergonha."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sobre a cabeça do justo",
          "há bênçãos,",
          "mas na boca dos ímpios",
          "mora a violência."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A memória do justo",
          "é abençoada,",
          "mas o nome dos ímpios",
          "irá apodrecer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Quem tem coração sábio aceita",
          "os mandamentos,",
          "mas o que fala tolices",
          "acaba em ruína."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Quem anda com integridade",
          "anda seguro,",
          "mas o que perverte",
          "os seus caminhos",
          "será descoberto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quem pisca os olhos",
          "traz desgosto,",
          "e o que fala tolices acaba em ruína."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A boca do justo",
          "é manancial de vida,",
          "mas na boca dos ímpios",
          "mora a violência."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O ódio provoca conflitos,",
          "mas o amor cobre",
          "todas as transgressões."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Nos lábios do sábio",
          "se acha sabedoria,",
          "mas a vara é para as costas",
          "de quem não tem juízo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Os sábios acumulam",
          "conhecimento,",
          "mas a fala dos insensatos",
          "é ruína iminente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os bens do rico",
          "são a sua fortaleza;",
          "o que leva os pobres à ruína",
          "é a sua pobreza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "A obra do justo conduz à vida,",
          "e o rendimento do ímpio",
          "leva ao pecado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O caminho para a vida",
          "é de quem guarda o ensino,",
          "mas o que abandona a repreensão",
          "anda errante."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "O que encobre o ódio",
          "tem lábios mentirosos,",
          "e o que difama é tolo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Quem fala demais acaba caindo",
          "em transgressão,",
          "mas quem controla a língua",
          "é sábio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "A fala dos justos",
          "é prata escolhida,",
          "mas o coração dos ímpios",
          "vale muito pouco."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "As palavras dos justos",
          "alimentam muitos,",
          "mas os insensatos",
          "morrem por falta de juízo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "A bênção do Senhor enriquece,",
          "e ele não acrescenta",
          "nenhum desgosto a ela."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Praticar a maldade",
          "é como um divertimento",
          "para o insensato;",
          "o homem inteligente",
          "se diverte com a sabedoria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Aquilo que o ímpio teme,",
          "isso lhe sobrevém;",
          "o que os justos desejam",
          "Deus lhes concede."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "O ímpio desaparece assim",
          "como passa a tempestade,",
          "mas o justo",
          "tem um alicerce eterno."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Como vinagre para os dentes",
          "e fumaça para os olhos,",
          "assim é o preguiçoso",
          "para aqueles que o enviam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "O temor do Senhor prolonga",
          "os dias da vida,",
          "mas o tempo dos ímpios",
          "será abreviado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "A esperança dos justos é alegria,",
          "mas a expectativa dos ímpios",
          "perecerá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "O caminho do Senhor",
          "é fortaleza para os íntegros,",
          "mas ruína para os que praticam",
          "a iniquidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "O justo nunca será abalado,",
          "mas os ímpios",
          "não habitarão na terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "A boca do justo",
          "produz sabedoria,",
          "mas a língua da perversidade",
          "será arrancada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Os lábios do justo",
          "sabem o que agrada,",
          "mas da boca dos ímpios",
          "só saem perversidades."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
