    },
    "next": {
      "usfm": "JOB.38",
      "human": "Jó 38"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Diante disto,",
          "o meu coração treme",
          "e salta do seu lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ouçam atentamente",
          "o trovão de Deus,",
          "o estrondo que sai da sua boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ele o solta por baixo",
          "de todos os céus,",
          "e o seu relâmpago chega",
          "até os confins da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Depois deste, ruge a sua voz,",
          "troveja com o estrondo",
          "da sua majestade,",
          "e ele já não retém o relâmpago",
          "quando se ouve a sua voz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Com a sua voz Deus",
          "troveja maravilhosamente;",
          "ele faz grandes coisas,",
          "que nós não compreendemos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque ele diz à neve:",
          "‘Caia sobre a terra’;",
          "e à chuva e ao aguaceiro:",
          "‘Sejam fortes’."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Assim, ele torna inativas",
          "as mãos de todos,",
          "para que reconheçam",
          "as obras dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os animais entram",
          "nos seus esconderijos",
          "e ficam nas suas cavernas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "De suas recâmaras",
          "sai a tempestade,",
          "e os ventos fortes trazem o frio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pelo sopro de Deus",
          "se dá a geada,",
          "e uma grande extensão de água",
          "congela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Carrega de umidade",
          "as densas nuvens,",
          "e do meio delas",
          "irradia o seu relâmpago."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Então as nuvens,",
          "segundo o rumo que ele dá,",
          "se espalham",
          "para uma e outra direção,",
          "para fazerem tudo",
          "o que lhes ordena",
          "sobre a superfície da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "E tudo isso ele faz vir",
          "para disciplina,",
          "se convém à terra,",
          "ou para exercer",
          "a sua misericórdia.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus é perfeito em conhecimento"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Dê ouvidos a isto, Jó;",
          "pare e pense",
          "nas maravilhas de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Será que você sabe",
          "como Deus comanda as nuvens",
          "e como faz resplandecer",
          "o relâmpago da sua nuvem?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Será que você sabe algo",
          "sobre o equilíbrio das nuvens",
          "e sobre as maravilhas",
          "daquele que é perfeito",
          "em conhecimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Você, cujas roupas",
          "ficam aquecidas",
          "quando há forte calor",
          "por causa do vento sul,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "será que você pode ajudar",
          "Deus a estender o firmamento,",
          "que é sólido como espelho",
          "de metal fundido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ensine-nos o que devemos",
          "dizer a ele,",
          "porque nós, envoltos em trevas,",
          "não podemos expor",
          "a nossa causa diante dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Será que alguém deveria",
          "contar a Deus que eu quero",
          "falar com ele?",
          "Se alguém fizesse isso,",
          "seria devorado.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "“Eis que ninguém",
          "pode olhar para o sol,",
          "que brilha no céu,",
          "uma vez passado o vento",
          "que o deixa limpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Do norte vem o áureo esplendor,",
          "pois Deus está cercado",
          "de tremenda majestade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Quanto ao Todo-Poderoso,",
          "não o podemos compreender.",
          "Ele é grande em poder,",
          "porém não perverte o juízo",
          "e a plenitude da justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Por isso, as pessoas o temem;",
          "ele não olha",
          "para os que se julgam sábios.”"
        ],
        "rlw_lines": []
      }
    ]
  },
