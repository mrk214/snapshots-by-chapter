  "book": {
    "book_usfm": "PRO",
    "name": "Provérbios"
  },
  "chapter": {
    "chapter_usfm": "PRO.22",
    "is_chapter": true,
    "previous": {
      "usfm": "PRO.21",
      "human": "Provérbios 21"
    },
    "current": {
      "usfm": "PRO.22",
      "human": "Provérbios 22"
    },
    "next": {
      "usfm": "PRO.23",
      "human": "Provérbios 23"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mais vale o bom nome",
          "do que as muitas riquezas;",
          "ser estimado é melhor",
          "do que a prata e o ouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O rico e o pobre",
          "têm algo em comum:",
          "o Senhor fez",
          "tanto um como o outro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O prudente vê o mal",
          "e se esconde;",
          "mas os ingênuos seguem em frente",
          "e sofrem as consequências."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A recompensa da humildade",
          "e do temor do Senhor",
          "são riquezas, honra e vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "No caminho do perverso",
          "há espinhos e armadilhas;",
          "quem quer guardar a sua vida",
          "afasta-se deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ensine a criança no caminho",
          "em que deve andar,",
          "e ainda quando for velho",
          "não se desviará dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O rico domina sobre o pobre,",
          "e o que pede emprestado",
          "é servo de quem empresta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O que semeia a injustiça",
          "colhe a desgraça,",
          "e a vara da sua indignação",
          "será destruída."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O generoso será abençoado,",
          "porque reparte o seu pão",
          "com os pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mande embora o zombador,",
          "e com ele se irá a discórdia;",
          "cessarão as discussões",
          "e a vergonha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Quem ama a pureza do coração",
          "e é habilidoso no falar",
          "terá a amizade do rei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Os olhos do Senhor",
          "preservam o conhecimento,",
          "mas ele subverte",
          "as palavras dos infiéis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O preguiçoso diz:",
          "“Um leão está lá fora!",
          "Serei morto no meio da rua!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cova profunda",
          "é a boca da mulher estranha;",
          "aquele contra quem",
          "o Senhor se irar cairá nela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "A tolice está ligada",
          "ao coração da criança,",
          "mas a vara da disciplina",
          "a afastará dela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Quem oprime o pobre",
          "para enriquecer a si",
          "ou o que dá presentes ao rico",
          "certamente empobrecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Trinta provérbios dos sábios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Preste atenção e ouça",
          "as palavras dos sábios;",
          "aplique o coração",
          "aos meus ensinamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Porque será agradável",
          "se você os guardar",
          "em seu coração",
          "e se tiver todos eles presentes",
          "nos seus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Quero que a sua confiança",
          "esteja no Senhor;",
          "por isso, hoje dou esta instrução",
          "a você — a você mesmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por acaso, não lhe escrevi",
          "trinta provérbios",
          "de conselhos e conhecimentos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Fiz isso para que você",
          "tenha certeza",
          "das palavras da verdade,",
          "a fim de que possa responder",
          "claramente aos que",
          "lhe fizerem perguntas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 1 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Não roube o pobre,",
          "porque é pobre,",
          "nem oprima o necessitado",
          "no tribunal,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "porque o Senhor defenderá",
          "a causa deles",
          "e tirará a vida",
          "daqueles que os exploram."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 2 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Não faça amizade com quem",
          "facilmente fica irado,",
          "nem ande na companhia",
          "de quem é agressivo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "para que você não aprenda",
          "os seus caminhos",
          "e, assim, fique preso",
          "numa armadilha."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 3 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Não esteja entre os que",
          "se comprometem",
          "e ficam por fiadores de dívidas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "pois, se você não tiver",
          "com que pagar,",
          "vão acabar lhe tirando até mesmo",
          "a cama em que costuma",
          "se deitar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 4 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Não remova os marcos antigos",
          "que os seus pais colocaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 5 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Você está vendo alguém",
          "que é habilidoso",
          "naquilo que faz?",
          "Ele será posto diante de reis;",
          "não estará a serviço da plebe."
        ],
        "rlw_lines": []
      }
    ]
  },
