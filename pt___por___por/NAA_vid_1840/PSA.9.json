    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvor a Deus pela sua justiça"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “A morte para o filho”. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu te louvarei, Senhor,",
          "de todo o meu coração;",
          "contarei todas as tuas maravilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Em ti me alegrarei e exultarei;",
          "ao teu nome, ó Altíssimo,",
          "eu cantarei louvores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois, ao retrocederem",
          "os meus inimigos,",
          "tropeçam e somem",
          "da tua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque defendes o meu direito",
          "e a minha causa;",
          "no trono te assentas",
          "e julgas retamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu repreendes as nações,",
          "destróis o ímpio",
          "e para todo o sempre",
          "lhes apagas o nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quanto aos inimigos,",
          "estão consumidos,",
          "suas ruínas são perpétuas;",
          "arrasaste as suas cidades;",
          "até a memória deles pereceu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mas o Senhor permanece",
          "no seu trono eternamente,",
          "trono que erigiu para julgar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele mesmo julga o mundo",
          "com justiça;",
          "julgará os povos com retidão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O Senhor é também",
          "alto refúgio para o oprimido,",
          "refúgio nas horas de angústia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Em ti, pois, confiam",
          "os que conhecem o teu nome,",
          "porque tu, Senhor,",
          "não desamparas",
          "os que te buscam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Cantem louvores ao Senhor,",
          "que habita em Sião;",
          "proclamem entre os povos",
          "o que ele tem feito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Pois aquele que requer o sangue",
          "lembra-se deles",
          "e não se esquece",
          "do clamor dos aflitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Compadece-te de mim, Senhor;",
          "vê a que sofrimentos",
          "me reduziram",
          "os que me odeiam,",
          "tu que me levantas",
          "das portas da morte;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "para que, às portas",
          "da filha de Sião,",
          "eu proclame",
          "todos os teus louvores",
          "e me alegre na tua salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "As nações se afundaram",
          "na cova que fizeram,",
          "no laço que esconderam",
          "ficou preso o seu pé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O Senhor se dá a conhecer",
          "pelo juízo que executa;",
          "os ímpios ficam enredados",
          "nas obras",
          "de suas próprias mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "No inferno serão lançados",
          "os perversos,",
          "todas as nações",
          "que se esquecem de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pois o necessitado não será",
          "esquecido para sempre,",
          "e a esperança dos aflitos",
          "não será frustrada",
          "perpetuamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Levanta-te, Senhor;",
          "não deixes que",
          "os mortais prevaleçam.",
          "Sejam as nações julgadas",
          "na tua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Infunde-lhes o medo, Senhor;",
          "saibam as nações que não passam",
          "de simples mortais."
        ],
        "rlw_lines": []
      }
    ]
  },
