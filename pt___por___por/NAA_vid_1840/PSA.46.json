    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus é o nosso refúgio e fortaleza"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Dos filhos de Corá. Em voz de soprano. Cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deus é o nosso refúgio",
          "e fortaleza,",
          "socorro bem presente",
          "nas tribulações."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Portanto, não temeremos,",
          "ainda que a terra se transtorne",
          "e os montes se abalem",
          "no seio dos mares;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "ainda que as águas",
          "tumultuem e espumejem",
          "e na sua fúria",
          "os montes estremeçam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Há um rio, cujas correntes",
          "alegram a cidade de Deus,",
          "o santuário das moradas",
          "do Altíssimo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Deus está no meio dela;",
          "jamais será abalada.",
          "Deus a ajudará",
          "desde o romper da manhã."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Bramam nações,",
          "reinos se abalam.",
          "Deus faz ouvir a sua voz,",
          "e a terra se dissolve."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor dos Exércitos",
          "está conosco;",
          "o Deus de Jacó é o nosso refúgio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Venham contemplar",
          "as obras do Senhor,",
          "que tem feito desolações na terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ele faz cessar as guerras",
          "até os confins do mundo,",
          "quebra o arco e despedaça a lança;",
          "queima os carros no fogo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Aquietem-se e saibam",
          "que eu sou Deus;",
          "sou exaltado entre as nações,",
          "sou exaltado na terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor dos Exércitos",
          "está conosco;",
          "o Deus de Jacó é o nosso refúgio."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
