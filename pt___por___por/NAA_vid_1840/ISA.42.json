{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.42","is_chapter":true,"previous":{"usfm":"ISA.41","human":"Isaías 41","canonical":true,"toc":true},"current":{"usfm":"ISA.42","human":"Isaías 42"},"next":{"usfm":"ISA.43","human":"Isaías 43","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["O Servo do Senhor"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["“Eis aqui o meu servo,","a quem sustenho;","o meu escolhido, em quem","a minha alma se agrada.","Pus sobre ele o meu Espírito,","e ele promulgará o direito","para os gentios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Não clamará, não gritará,","nem fará ouvir na praça a sua voz."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Não esmagará a cana quebrada,","nem apagará o pavio que fumega;","com fidelidade,","promulgará o direito."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Não desanimará,","nem será esmagado","até que estabeleça na terra","a justiça;","e as terras do mar","aguardarão a sua doutrina.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Assim diz Deus, o Senhor,","que criou os céus e os estendeu;","que formou a terra","e tudo o que ela produz;","que dá fôlego de vida","ao povo que nela está","e o espírito aos que andam nela:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["“Eu, o Senhor, chamei você","em justiça;","eu o tomarei pela mão,","o guardarei,","e farei de você mediador da aliança","com o povo","e luz para os gentios;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["para abrir os olhos dos cegos,","para tirar da prisão os cativos,","e do cárcere,","os que jazem em trevas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Eu sou o Senhor:","este é o meu nome.","Não darei a mais ninguém","a minha glória,","nem a minha honra,","às imagens de escultura.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["“Eis que as primeiras predições","já se cumpriram,","e agora eu lhes anuncio","coisas novas;","e, antes que se cumpram,","eu as revelo a vocês.”"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Cântico de louvor pela salvação do povo"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Cantem ao Senhor","um cântico novo!","Que ele seja louvado","desde os confins da terra","pelos que navegam no mar,","por todas as criaturas","que vivem nele,","e pelas terras do mar","e os seus moradores."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Ergam a voz o deserto,","as suas cidades","e as aldeias habitadas por Quedar;","exultem os que habitam em Sela","e clamem do alto dos montes;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["deem honra ao Senhor","e anunciem a sua glória","nas terras do mar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["O Senhor sairá como valente,","despertará o seu zelo","como homem de guerra.","Clamará, lançará forte grito","de guerra","e mostrará sua força","contra os seus inimigos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["“Por muito tempo me calei,","estive em silêncio e me contive;","mas agora darei gritos","como mulher","que está dando à luz,","e ao mesmo tempo ofegarei,","e estarei esbaforido."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Devastarei os montes","e as colinas,","e farei secar toda a sua vegetação;","tornarei os rios em terra firme","e secarei os lagos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Guiarei os cegos","por um caminho","que não conhecem,","farei com que andem","por veredas desconhecidas;","tornarei as trevas em luz","diante deles","e aplanarei os caminhos ásperos.","Estas coisas lhes farei","e nunca os abandonarei."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Retrocederão e ficarão","cobertos de vergonha","os que confiam em imagens","de escultura","e que dizem às imagens","de fundição:","‘Vocês são os nossos deuses.’”"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Lamento sobre a cegueira de Israel"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["“Escutem, surdos,","e vocês, cegos, olhem,","para que possam ver."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Quem é tão cego","como o meu servo,","ou tão surdo","como o meu mensageiro,","a quem envio?","Quem é tão cego","como o meu amigo,","e tão cego","como o servo do Senhor?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Você vê muitas coisas,","mas não as observa;","ainda que tenha","os ouvidos abertos,","não ouve nada.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Foi do agrado do Senhor,","por amor da sua própria justiça,","engrandecer a lei","e torná-la gloriosa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Mas este é um povo","roubado e saqueado.","Todos estão trancados em cavernas","e escondidos em cárceres;","foram feitos prisioneiros,","e não há ninguém que os livre;","foram levados como despojo,","e ninguém diz: “Devolva!”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Quem de vocês dará ouvidos","a isto?","Quem dará atenção e ouvirá","o que há de ser depois?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Quem entregou Jacó por despojo","e Israel aos roubadores?","Por acaso não foi o Senhor,","aquele contra quem pecaram","e nos caminhos do qual","não queriam andar,","não dando ouvidos à sua lei?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Por isso derramou sobre eles","o furor da sua ira","e a violência da guerra;","ateou fogo em tudo","o que estava em volta deles,","mas eles não entenderam;","ele os queimou,","mas eles não fizeram caso."],"rlw_lines":[]}]}}