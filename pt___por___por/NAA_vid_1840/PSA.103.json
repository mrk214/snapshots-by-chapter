    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A misericórdia de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bendiga, minha alma, o Senhor,",
          "e tudo o que há em mim",
          "bendiga o seu santo nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bendiga, minha alma, o Senhor,",
          "e não se esqueça de nem um só",
          "de seus benefícios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ele é quem perdoa",
          "todas as suas iniquidades;",
          "quem cura",
          "todas as suas enfermidades;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "quem da cova redime a sua vida",
          "e coroa você",
          "de graça e misericórdia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "É ele quem enche de bens",
          "a sua vida,",
          "de modo que a sua mocidade",
          "se renova como a da águia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor faz justiça",
          "e julga todos os oprimidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Manifestou os seus caminhos",
          "a Moisés",
          "e os seus feitos aos filhos de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O Senhor é compassivo",
          "e bondoso;",
          "tardio em irar-se",
          "e rico em bondade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não repreende perpetuamente,",
          "nem conserva para sempre",
          "a sua ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Não nos trata",
          "segundo os nossos pecados,",
          "nem nos retribui conforme",
          "as nossas iniquidades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pois quanto o céu se eleva",
          "acima da terra,",
          "assim é grande a sua misericórdia",
          "para com os que o temem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Quanto o Oriente",
          "está longe do Ocidente,",
          "assim ele afasta de nós",
          "as nossas transgressões."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Como um pai se compadece",
          "de seus filhos,",
          "assim o Senhor se compadece",
          "dos que o temem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pois ele conhece",
          "a nossa estrutura",
          "e sabe que somos pó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Quanto ao ser humano,",
          "os seus dias são como a relva.",
          "Como a flor do campo,",
          "assim ele floresce;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "mas, soprando nela o vento,",
          "desaparece",
          "e não conhecerá, daí em diante,",
          "o seu lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Mas a misericórdia do Senhor",
          "é de eternidade a eternidade",
          "sobre os que o temem,",
          "e a sua justiça,",
          "sobre os filhos dos filhos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "para com os que guardam",
          "a sua aliança",
          "e para com os que se lembram",
          "dos seus preceitos",
          "e os cumprem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Nos céus, o Senhor",
          "estabeleceu o seu trono,",
          "e o seu reino domina sobre tudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Bendigam o Senhor",
          "os seus anjos,",
          "valorosos em poder,",
          "que executam as suas ordens",
          "e lhe obedecem à palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Bendigam o Senhor",
          "todos os seus exércitos,",
          "ministros seus,",
          "que fazem a sua vontade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Bendigam o Senhor",
          "todas as suas obras,",
          "em todos os lugares",
          "do seu domínio.",
          "Bendiga, minha alma, o Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
