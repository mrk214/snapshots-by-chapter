    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Conselho paternal"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Filhos, escutem",
          "a instrução do pai;",
          "estejam atentos para que",
          "obtenham o entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque eu lhes dou",
          "boa instrução;",
          "não abandonem o meu ensino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quando eu era menino",
          "em companhia de meu pai,",
          "uma criança inexperiente, mas única",
          "aos olhos de minha mãe,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "ele me ensinava e me dizia:",
          "“Que o seu coração retenha",
          "as minhas palavras;",
          "guarde os meus mandamentos",
          "e você viverá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Adquira a sabedoria,",
          "adquira o entendimento;",
          "não se esqueça nem se afaste",
          "das minhas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não abandone a sabedoria,",
          "e ela guardará você;",
          "ame-a, e ela o protegerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O princípio da sabedoria é:",
          "adquira a sabedoria;",
          "sim, com tudo o que você possui,",
          "adquira o entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Valorize a sabedoria,",
          "e ela o exaltará;",
          "se você a abraçar, ela o honrará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ela porá um diadema de graça",
          "em sua cabeça",
          "e lhe entregará",
          "uma coroa de glória.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Meu filho, escute e aceite",
          "as minhas palavras,",
          "e os anos de sua vida",
          "se multiplicarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eu ensinei a você",
          "o caminho da sabedoria",
          "e o fiz andar",
          "pelas veredas da retidão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Se você andar por elas,",
          "os seus passos",
          "não se embaraçarão;",
          "se você correr, não tropeçará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Retenha a instrução",
          "e não a deixe;",
          "guarde-a, porque ela é a sua vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Não entre na vereda dos ímpios,",
          "nem siga pelo caminho dos maus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Evite esse caminho;",
          "não passe por ele;",
          "desvie-se dele e passe longe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Os maus não dormem,",
          "se não fizerem o mal;",
          "o sono foge deles, se não fizerem",
          "alguém tropeçar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Porque comem",
          "o pão da maldade",
          "e bebem o vinho das violências."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Mas a vereda dos justos",
          "é como a luz do alvorecer,",
          "que vai brilhando mais e mais",
          "até ser dia claro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "O caminho dos ímpios",
          "é como a escuridão;",
          "nem eles sabem em que tropeçam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Meu filho, escute",
          "as minhas palavras;",
          "preste atenção",
          "aos meus ensinamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Não deixe que eles se afastem",
          "dos seus olhos;",
          "guarde-os no mais íntimo",
          "do seu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Porque são vida",
          "para quem os encontra",
          "e saúde para todo o seu corpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "De tudo o que se deve guardar,",
          "guarde bem o seu coração,",
          "porque dele procedem",
          "as fontes da vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Afaste de você",
          "a falsidade da boca",
          "e mantenha longe de você",
          "a perversidade dos lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Que os seus olhos olhem direito,",
          "e que as suas vistas se fixem",
          "no que está diante de você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Faça plana a vereda de seus pés,",
          "para que todos os seus caminhos",
          "sejam retos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Não se incline nem para a direita",
          "nem para a esquerda;",
          "afaste os seus pés do mal."
        ],
        "rlw_lines": []
      }
    ]
  },
