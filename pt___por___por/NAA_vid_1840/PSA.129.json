    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Perseguido, mas não derrotado"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de peregrinação"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Muitas vezes me angustiaram",
          "desde a minha mocidade —",
          "Israel que o diga —;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "muitas vezes me angustiaram",
          "desde a minha mocidade,",
          "mas não prevaleceram contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os lavradores passaram o arado",
          "nas minhas costas",
          "e abriram longos sulcos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mas o Senhor é justo;",
          "cortou as cordas dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sejam envergonhados e repelidos",
          "todos os que odeiam Sião!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sejam como a erva dos telhados,",
          "que seca antes de florescer,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "que não enche a mão do ceifeiro,",
          "nem os braços daquele",
          "que ata os feixes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "E também os que passam",
          "não digam:",
          "“A bênção do Senhor",
          "seja com vocês!",
          "Nós os abençoamos",
          "em nome do Senhor!”"
        ],
        "rlw_lines": []
      }
    ]
  },
