    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resposta de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Será que é do homem que eu me queixo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Ouçam com atenção",
          "as minhas palavras;",
          "seja esta a consolação",
          "que vocês me trazem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tenham paciência, e eu falarei;",
          "e, havendo eu falado,",
          "poderão zombar de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Será que é do homem",
          "que eu me queixo?",
          "Não tenho motivo",
          "para ficar impaciente?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Olhem para mim",
          "e fiquem pasmos,",
          "e ponham a mão sobre a boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque só de pensar nisso",
          "fico apavorado,",
          "e sinto um calafrio",
          "passar pelo meu corpo.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Os maus cantam e se alegram"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Como é que os ímpios",
          "continuam vivos,",
          "envelhecem e ainda se tornam",
          "mais poderosos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os seus filhos se estabelecem",
          "na sua presença;",
          "e os seus descendentes,",
          "diante dos seus olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "As suas casas têm paz",
          "e estão livres do medo;",
          "e a vara de Deus não os fustiga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os seus touros geram",
          "e não falham;",
          "as suas novilhas têm a cria",
          "e não abortam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Deixam as suas crianças correr",
          "como um rebanho;",
          "os seus filhos saltam de alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Cantam com tamborim e harpa",
          "e alegram-se ao som da flauta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Passam os seus dias",
          "em prosperidade",
          "e em paz descem à sepultura.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“E são estes os que se dirigem",
          "a Deus, dizendo:",
          "‘Deixa-nos em paz.",
          "Não queremos conhecer",
          "os teus caminhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Quem é o Todo-Poderoso,",
          "para que o sirvamos?",
          "E o que ganhamos,",
          "se lhe fizermos orações?’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Vejam que não provém deles",
          "a sua prosperidade.",
          "Longe de mim",
          "o conselho dos ímpios!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Que Deus castigue os ímpios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Quantas vezes se apaga",
          "a lâmpada dos ímpios?",
          "Quantas vezes lhes sobrevém",
          "a destruição?",
          "Quantas vezes Deus, na sua ira,",
          "os faz sofrer?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Quantas vezes são como a palha",
          "diante do vento",
          "e como a poeira que é levada",
          "pela tempestade?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "“Vocês dizem que Deus",
          "reserva o castigo do perverso",
          "para os filhos dele.",
          "Mas é ao perverso que Deus",
          "deveria punir,",
          "para que o sinta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Seus próprios olhos devem",
          "ver a sua ruína;",
          "que ele beba do furor",
          "do Todo-Poderoso!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Porque depois de morto,",
          "e acabada a contagem",
          "dos seus meses,",
          "que interessa a ele a sua casa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Será que alguém pode",
          "ensinar algo a Deus,",
          "a ele que julga",
          "os que estão nos céus?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "“Um morre em pleno vigor,",
          "despreocupado e tranquilo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "com os seus baldes",
          "cheios de leite",
          "e os ossos repletos de tutano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Outro, ao contrário,",
          "morre com o coração",
          "cheio de amargura,",
          "não havendo provado o bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Juntamente jazem no pó,",
          "onde os vermes os cobrem.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Vocês querem me consolar com palavras vazias?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "“Eis que eu conheço",
          "os pensamentos de vocês",
          "e os planos injustos que fazem",
          "para me prejudicar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Porque vocês perguntam:",
          "‘Onde está agora",
          "a casa do príncipe?’",
          "E: ‘Onde ficou a tenda",
          "em que moravam os ímpios?’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "“Será que vocês",
          "nunca interrogaram",
          "os que viajam?",
          "E não levaram em conta",
          "as suas declarações,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "que o mau é poupado",
          "no dia da calamidade,",
          "e é socorrido no dia do furor?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Quem lhe jogará na cara",
          "o que ele fez?",
          "Quem o fará pagar pelo que fez?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Finalmente, é levado à sepultura,",
          "e sobre o seu túmulo",
          "se faz vigilância."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "A terra do vale que o cobre",
          "é leve;",
          "todos os homens o seguem,",
          "assim como são inumeráveis",
          "os que foram adiante dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Como, então, vocês querem",
          "me consolar",
          "com palavras vazias?",
          "Nas respostas de vocês",
          "só há falsidade.”"
        ],
        "rlw_lines": []
      }
    ]
  },
