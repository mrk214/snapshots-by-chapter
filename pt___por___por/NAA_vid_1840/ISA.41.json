{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.41","is_chapter":true,"previous":{"usfm":"ISA.40","human":"Isaías 40","canonical":true,"toc":true},"current":{"usfm":"ISA.41","human":"Isaías 41"},"next":{"usfm":"ISA.42","human":"Isaías 42","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Deus promete salvar o povo de Israel"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["“Calem-se diante de mim, ó ilhas!","E que os povos renovem","as suas forças!","Que se aproximem e, então, falem;","vamos nos reunir","para o julgamento.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["“Quem fez surgir no Oriente","aquele a cujos passos","segue a vitória?","Quem lhe entrega as nações","e faz com que os reis","se submetam a ele?","Com a sua espada","ele os transforma em pó,","e com o seu arco,","em palha que o vento dispersa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Ele os persegue","e avança em segurança,","por um caminho em que ele","nunca havia passado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Quem fez e executou tudo isso?","Aquele que desde o princípio","tem chamado as gerações","à existência,","eu, o Senhor, o primeiro,","e aquele que estará","com os últimos; eu mesmo.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Os países do mar viram isto","e temeram;","os confins da terra tremeram;","eles se aproximaram e vieram."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Um ajuda o outro","e diz a seu próximo: “Seja forte.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["O artífice anima o ourives,","e o que trabalha com o martelo","encoraja o que bate na bigorna,","dizendo que a soldagem","foi bem-feita.","Então fixam tudo com pregos","para que não oscile."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["“Mas você, Israel, meu servo;","você, Jacó, a quem escolhi;","você, descendente de Abraão,","meu amigo;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["você, a quem eu trouxe","dos confins da terra","e chamei dos seus cantos","mais remotos,","e a quem eu disse:","‘Você é o meu servo,","eu o escolhi e não o rejeitei’;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["não tema,","porque eu estou com você;","não fique com medo,","porque eu sou o seu Deus.","Eu lhe dou forças; sim, eu o ajudo;","sim, eu o seguro com a mão direita","da minha justiça.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["“Eis que serão envergonhados","e humilhados","todos os que se enfurecem","contra você;","os que lutam contra você","serão reduzidos a nada e perecerão."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Você procurará","os que lutam contra você,","porém não os achará;","serão reduzidos a nada","e a coisa de nenhum valor","os que fazem guerra contra você."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Porque eu, o Senhor, seu Deus,","o tomo pela mão direita e lhe digo:","‘Não tenha medo,","pois eu o ajudarei.’”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["“Não tenha medo,","ó vermezinho de Jacó,","povozinho de Israel,","pois eu o ajudarei”,","diz o Senhor;","“o seu Redentor é o Santo de Israel."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Eis que farei de você","um debulhador de cereais","cortante e novo,","armado de lâminas duplas.","Você trilhará","e esmagará os montes,","e reduzirá as colinas a palha."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Você os jogará para cima","com a pá,","e o vento os levará,","e o redemoinho os espalhará.","Então você se alegrará no Senhor","e se gloriará no Santo de Israel.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["“Os pobres e necessitados","buscam água,","mas não a encontram;","a língua deles","está ressequida de sede.","Mas eu, o Senhor, os ouvirei,","eu, o Deus de Israel,","não os abandonarei."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Abrirei rios no alto dos montes","e fontes no meio dos vales;","transformarei o deserto","em lençóis de águas","e a terra seca, em mananciais."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Plantarei no deserto o cedro,","a acácia, a murta e a oliveira;","porei juntos no ermo o cipreste,","o olmeiro e o buxo,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["para que todos vejam e saibam,","considerem e juntamente","entendam","que a mão do Senhor fez isso,","e que o Santo de Israel o criou.”"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["O Senhor desafia os deuses"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["“Exponham a sua causa”,","diz o Senhor;","“apresentem as suas razões”,","diz o Rei de Jacó."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["“Aproximem-se e anunciem-nos","as coisas que hão de acontecer;","contem-nos as profecias","anteriores,","para que as examinemos","e saibamos se elas se cumpriram;","ou falem-nos a respeito","das coisas futuras."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Anunciem-nos as coisas","que ainda hão de vir,","para que saibamos","que vocês são deuses.","Façam alguma coisa,","seja boa ou seja má,","para que fiquemos com medo,","e juntamente o veremos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Eis que vocês","são menos do que nada,","e menos do que nada","é o que vocês fazem;","abominável é quem os escolhe.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["“Do Norte suscitei um homem,","e ele vem;","desde o Oriente, onde nasce o sol,","ele invocará o meu nome;","pisará os governantes","como se fossem lama,","como o oleiro pisa o barro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Quem anunciou isso","desde o princípio,","a fim de que o possamos saber?","Quem falou disso","antecipadamente,","para que digamos:","‘É isso mesmo’?","Mas não houve quem anunciasse,","quem proclamasse,","nem ainda quem tivesse ouvido","qualquer palavra","da parte de vocês."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Eu sou o que primeiro disse","a Sião: ‘Eis! Ei-los aí!’","E a Jerusalém dou um mensageiro","de boas-novas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Quando eu olho,","não há ninguém;","entre eles não há","nenhum conselheiro","a quem eu pergunte,","e me responda."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Eis que todos são nada;","as suas obras são coisa nenhuma;","as suas imagens de fundição","são vento e vácuo.”"],"rlw_lines":[]}]}}