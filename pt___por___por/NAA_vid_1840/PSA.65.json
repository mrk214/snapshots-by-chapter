    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Gratidão pelas colheitas"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. De Davi. Cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A ti, ó Deus, o louvor",
          "é devido em Sião,",
          "e a ti se pagarão os votos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ó tu que escutas a oração,",
          "a ti virão todas as pessoas,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "por causa de suas iniquidades.",
          "Se prevalecem",
          "as nossas transgressões,",
          "tu as perdoas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Bem-aventurado",
          "aquele a quem escolhes",
          "e aproximas de ti, para que habite",
          "nos teus átrios.",
          "Ficaremos satisfeitos",
          "com a bondade de tua casa —",
          "o teu santo templo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Com tremendos feitos",
          "nos respondes",
          "em tua justiça,",
          "ó Deus, Salvador nosso,",
          "esperança de todos os confins",
          "da terra",
          "e dos mares longínquos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Com a tua força",
          "consolidas os montes,",
          "cingido de poder."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tu acalmas o rugido dos mares,",
          "o ruído das suas ondas",
          "e o tumulto dos povos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os que habitam",
          "nos confins da terra",
          "temem os teus sinais;",
          "os que vêm do Oriente",
          "e do Ocidente,",
          "tu os fazes exultar de júbilo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tu visitas a terra e a regas;",
          "tu a enriqueces grandemente.",
          "Os ribeiros de Deus",
          "são abundantes de água;",
          "provês o cereal,",
          "porque para isso preparas a terra,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "regando-lhe os sulcos",
          "e desmanchando os torrões.",
          "Tu a amoleces com chuviscos",
          "e lhe abençoas a produção."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Coroas o ano da tua bondade;",
          "as tuas pegadas destilam fartura,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "destilam sobre as pastagens",
          "do deserto,",
          "e de júbilo se revestem as colinas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Os campos se cobrem",
          "de rebanhos,",
          "e os vales se enchem de espigas;",
          "exultam de alegria e cantam."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
