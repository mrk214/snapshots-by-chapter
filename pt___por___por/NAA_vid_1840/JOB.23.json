    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resposta de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Quem dera eu soubesse onde encontrar Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Ainda hoje a minha queixa",
          "é de um revoltado,",
          "apesar de a minha mão",
          "reprimir o meu gemido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quem dera eu soubesse",
          "onde encontrá-lo!",
          "Então me chegaria ao seu tribunal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Exporia diante dele",
          "a minha causa,",
          "encheria a minha boca",
          "de argumentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Saberia com que palavras",
          "ele me responderia",
          "e entenderia",
          "o que ele fosse me dizer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Será que ele discutiria comigo,",
          "segundo a grandeza",
          "do seu poder?",
          "Não! Ele me atenderia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ali, o homem reto apresentaria",
          "a sua causa diante dele,",
          "e eu me livraria para sempre",
          "do meu juiz.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus sabe o meu caminho"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Se me adianto, Deus não está ali;",
          "se volto para trás, não o percebo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Se ele age à minha esquerda,",
          "não o vejo;",
          "se ele se esconde à minha direita,",
          "não o enxergo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mas ele sabe o meu caminho;",
          "se ele me provasse,",
          "eu sairia como o ouro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Os meus pés seguiram",
          "as suas pisadas;",
          "guardei o seu caminho",
          "e não me desviei dele."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Do mandamento dos seus lábios",
          "nunca me afastei;",
          "escondi no meu íntimo",
          "as palavras da sua boca.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus cumprirá o que está ordenado a meu respeito"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Mas, se Deus resolveu",
          "alguma coisa,",
          "quem o pode convencer",
          "a mudar de ideia?",
          "O que ele quer, isso fará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pois ele cumprirá",
          "o que está ordenado",
          "a meu respeito",
          "e muitas coisas como estas",
          "ainda tem planejado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por isso, fico apavorado",
          "na sua presença;",
          "e, quando penso nisso,",
          "tenho medo dele."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Deus é quem fez",
          "o meu coração esmorecer;",
          "o Todo-Poderoso",
          "me encheu de pavor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Porque não estou desfalecido",
          "por causa das trevas,",
          "nem porque a escuridão",
          "cobre o meu rosto.”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
