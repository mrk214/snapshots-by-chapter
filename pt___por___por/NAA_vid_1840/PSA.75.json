    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus é juiz"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “Não destruas”. Salmo de Asafe. Cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Graças te rendemos, ó Deus,",
          "graças te rendemos!",
          "Invocamos o teu nome,",
          "e declaramos",
          "as tuas maravilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pois disseste: “Quando chegar",
          "o tempo determinado,",
          "julgarei com retidão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ainda que tremam a terra",
          "e todos os seus moradores,",
          "eu firmarei as suas colunas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Digo aos soberbos",
          "que não sejam arrogantes;",
          "e aos ímpios, que não fiquem",
          "de nariz empinado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Não levantem orgulhosamente",
          "o seu nariz,",
          "nem falem com insolência.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque não é do Oriente,",
          "não é do Ocidente,",
          "nem do deserto que vem o auxílio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Deus é o juiz;",
          "a um ele humilha,",
          "a outro ele exalta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Porque na mão do Senhor",
          "há um cálice",
          "cujo vinho espumeja,",
          "cheio de mistura;",
          "dele dá a beber;",
          "sorvem-no, até a última gota,",
          "todos os ímpios da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Quanto a mim,",
          "exultarei para sempre;",
          "cantarei louvores ao Deus de Jacó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ele diz: “Abaterei",
          "as forças dos ímpios;",
          "mas a força dos justos",
          "será exaltada.”"
        ],
        "rlw_lines": []
      }
    ]
  },
