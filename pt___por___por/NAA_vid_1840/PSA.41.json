    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração de um doente"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bem-aventurado é aquele",
          "que ajuda os necessitados;",
          "o Senhor o livra no dia do mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O Senhor o protege,",
          "preserva-lhe a vida",
          "e o faz feliz na terra;",
          "não o entrega à vontade",
          "dos seus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O Senhor o assiste",
          "no leito da enfermidade.",
          "Quando doente,",
          "tu lhe restauras a saúde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eu disse: “Compadece-te",
          "de mim, Senhor;",
          "sara a minha alma,",
          "porque pequei contra ti.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os meus inimigos",
          "falam mal de mim:",
          "“Quando é que ele vai morrer",
          "e ser esquecido?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Se algum deles vem me visitar,",
          "diz coisas vãs,",
          "amontoando maldades no coração;",
          "ao sair, é disso que fala."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todos os que me odeiam",
          "se reúnem",
          "e ficam cochichando;",
          "pensam o pior a respeito de mim,",
          "dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Foi uma peste que deu nele”;",
          "e: “Caiu de cama,",
          "e não vai se levantar mais.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Até o meu amigo íntimo,",
          "em quem eu confiava,",
          "que comia do meu pão,",
          "levantou contra mim",
          "o seu calcanhar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tu, porém, Senhor,",
          "compadece-te de mim",
          "e levanta-me,",
          "para que eu lhes pague",
          "segundo merecem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Com isto saberei",
          "que te agradas de mim:",
          "em não triunfar contra mim",
          "o meu inimigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Quanto a mim, tu me susténs",
          "na minha integridade",
          "e me pões na tua presença",
          "para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Bendito seja o Senhor,",
          "Deus de Israel,",
          "de eternidade a eternidade!",
          "Amém e amém!"
        ],
        "rlw_lines": []
      }
    ]
  },
