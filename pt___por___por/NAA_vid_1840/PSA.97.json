    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A majestade e o domínio de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Reina o Senhor.",
          "Alegre-se a terra,",
          "exultem as muitas ilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nuvens e escuridão o rodeiam,",
          "justiça e juízo",
          "são a base do seu trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Adiante dele vai um fogo",
          "que consome os inimigos",
          "ao seu redor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os seus relâmpagos",
          "iluminam o mundo;",
          "a terra os vê e estremece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os montes se derretem como cera",
          "na presença do Senhor,",
          "na presença do Senhor",
          "de toda a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os céus anunciam a sua justiça,",
          "e todos os povos",
          "veem a sua glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sejam envergonhados todos",
          "os que adoram",
          "imagens de escultura,",
          "os que se gloriam de ídolos.",
          "Todos os deuses prostrem-se",
          "diante dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sião ouve e se alegra,",
          "as filhas de Judá exultam,",
          "por causa da tua justiça, ó Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pois tu, Senhor, és o Altíssimo",
          "sobre toda a terra;",
          "tu estás muito acima",
          "de todos os deuses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Vocês que amam o Senhor,",
          "odeiem o mal;",
          "ele protege a vida dos seus santos,",
          "e os livra das mãos dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A luz se difunde para o justo,",
          "e a alegria,",
          "para os retos de coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Alegrem-se no Senhor, ó justos,",
          "e deem graças ao seu santo nome."
        ],
        "rlw_lines": []
      }
    ]
  },
