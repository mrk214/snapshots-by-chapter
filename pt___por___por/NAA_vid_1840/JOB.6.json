    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resposta de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Por que prolongar a vida, se o fim é certo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Ah! Se a minha queixa, de fato,",
          "pudesse ser pesada,",
          "e contra ela, numa balança,",
          "se pusesse a minha miséria,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "esta, na verdade, pesaria mais",
          "que a areia dos mares.",
          "Por isso é que as minhas palavras",
          "foram precipitadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque as flechas",
          "do Todo-Poderoso",
          "estão cravadas em mim,",
          "e o meu espírito sorve",
          "o veneno delas;",
          "os terrores de Deus",
          "se armam contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Será que o jumento selvagem",
          "zurra quando está junto à relva?",
          "Ou será que o boi berra",
          "junto ao seu pasto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pode-se comer sem sal",
          "o que é insípido?",
          "Ou haverá sabor na clara do ovo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Aquilo que a minha alma",
          "recusava tocar,",
          "isso é agora a minha comida",
          "repugnante.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Quem dera que se cumprisse",
          "o meu pedido,",
          "e que Deus me concedesse",
          "o que desejo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Que fosse do agrado de Deus",
          "esmagar-me,",
          "que soltasse a sua mão",
          "e acabasse comigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Isto ainda seria",
          "a minha consolação,",
          "e eu saltaria de contente",
          "na minha dor, que é implacável;",
          "porque não tenho negado",
          "as palavras do Santo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por que esperar,",
          "se já não tenho forças?",
          "Por que prolongar a vida,",
          "se o meu fim é certo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por acaso a minha força",
          "é a força da pedra?",
          "Ou é de bronze a minha carne?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Não encontro socorro",
          "em mim mesmo;",
          "foram afastados de mim",
          "os meus recursos.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Meus amigos me enganaram"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Ao aflito deve o amigo",
          "mostrar compaixão,",
          "mesmo ao que abandonou",
          "o temor do Todo-Poderoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Meus irmãos me enganaram;",
          "são como um ribeiro,",
          "como a torrente",
          "que transborda no vale,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "turvada com o gelo e com a neve",
          "que nela se esconde,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "torrente que seca",
          "quando o tempo aquece,",
          "e que no calor desaparece",
          "do seu lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "As caravanas se desviam",
          "dos seus caminhos,",
          "sobem para lugares desolados",
          "e perecem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "As caravanas de Temá procuram",
          "essa torrente,",
          "os viajantes de Sabá",
          "por ela suspiram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Ficam envergonhados",
          "por terem confiado;",
          "quando chegam ali,",
          "ficam decepcionados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Assim também vocês",
          "não me ajudaram em nada;",
          "veem os meus males",
          "e ficam com medo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Por acaso pedi",
          "que me dessem recompensa?",
          "Ou que da riqueza de vocês",
          "me trouxessem algum presente?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Será que pedi que me livrassem",
          "do poder do opressor?",
          "Ou que me resgatassem",
          "das mãos dos tiranos?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Vejam que não estou mentindo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "“Ensinem-me, e eu me calarei;",
          "mostrem-me em que tenho errado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Como são persuasivas",
          "as palavras retas!",
          "Mas o que é que a repreensão",
          "de vocês repreende?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Por acaso vocês pensam",
          "em reprovar",
          "as minhas palavras,",
          "ditas por um desesperado",
          "ao vento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Até sobre um órfão",
          "vocês lançariam sortes",
          "e seriam capazes",
          "de vender um amigo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Agora, pois, tenham a bondade",
          "de olhar para mim",
          "e vejam que não estou mentindo",
          "na cara de vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Por favor, mudem de parecer,",
          "e que não haja injustiça;",
          "mudem de parecer,",
          "e a justiça da minha causa",
          "triunfará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Há iniquidade em meus lábios?",
          "Será que a minha",
          "boca não consegue",
          "discernir coisas perniciosas?”"
        ],
        "rlw_lines": []
      }
    ]
  },
