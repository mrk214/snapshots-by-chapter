    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Profecia contra Moabe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Sentença contra Moabe.",
          "Certamente numa noite",
          "Ar de Moabe foi arrasada,",
          "e ela está destruída;",
          "certamente numa noite",
          "Quir de Moabe foi arrasada,",
          "e ela está destruída."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sobe-se ao templo e a Dibom,",
          "aos lugares altos, para chorar.",
          "Por Nebo e por Medeba,",
          "Moabe lamenta;",
          "todas as cabeças são rapadas,",
          "e toda barba é cortada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Nas ruas andam vestidos",
          "de panos de saco;",
          "nos terraços e nas praças",
          "todos pranteiam,",
          "desatando-se em lágrimas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tanto Hesbom como Eleale",
          "andam gritando;",
          "até Jaza se ouve a sua voz.",
          "Por isso, os soldados de Moabe",
          "clamam;",
          "a sua alma treme dentro deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O meu coração clama",
          "por causa de Moabe.",
          "Os seus fugitivos",
          "vão até a região de Zoar",
          "e Eglate-Selisia;",
          "vão chorando pela subida de Luíte",
          "e no caminho de Horonaim",
          "levantam gritos de desespero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque as águas de Ninrim",
          "desapareceram;",
          "seca-se o pasto, acaba-se o capim,",
          "e não há mais nada",
          "que esteja verde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Por isso, eles mesmos levam",
          "a riqueza que adquiriram",
          "e guardaram",
          "para além do ribeiro dos Salgueiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Porque o pranto se espalha",
          "pelo território de Moabe;",
          "o seu clamor chega até Eglaim;",
          "o clamor chega até Beer-Elim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "As águas de Dimom",
          "estão cheias de sangue,",
          "mas trarei ainda mais sobre Dimom:",
          "um leão para atacar aqueles",
          "que escaparem de Moabe",
          "e os que permanecerem na terra."
        ],
        "rlw_lines": []
      }
    ]
  },
