    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resposta de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Vocês me insultaram"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Até quando vocês vão",
          "me atormentar",
          "e me esmagar",
          "com as suas palavras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Já dez vezes vocês",
          "me insultaram",
          "e não se envergonham",
          "de me injuriar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Se eu tivesse realmente",
          "cometido algum erro,",
          "isso interessaria somente a mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Se vocês querem se engrandecer",
          "contra mim",
          "e usam a minha vergonha",
          "como argumento contra mim,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "então saibam que Deus",
          "foi injusto comigo",
          "e me cercou com a sua rede.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus me arruinou"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Eis que clamo: ‘Violência!’,",
          "mas não sou ouvido;",
          "grito: ‘Socorro!’,",
          "porém não há justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Deus fechou o meu caminho,",
          "e não consigo passar;",
          "e nas minhas veredas pôs trevas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Despojou-me da minha honra",
          "e tirou a coroa da minha cabeça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Arruinou-me de todos os lados,",
          "e eu me vou;",
          "tirou-me a esperança,",
          "como se arranca uma árvore."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Acendeu contra mim a sua ira",
          "e me trata como um",
          "dos seus adversários."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Juntas vieram as suas tropas;",
          "prepararam contra mim",
          "o seu caminho",
          "e acamparam",
          "ao redor da minha tenda.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Todos me abandonaram"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Deus levou os meus irmãos",
          "para longe de mim,",
          "e os que me conhecem,",
          "como estranhos,",
          "se afastaram de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Os meus parentes",
          "me abandonaram,",
          "e os meus conhecidos",
          "se esqueceram de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os que se abrigam",
          "na minha casa",
          "e as minhas servas me consideram",
          "como um estranho;",
          "vim a ser um estrangeiro",
          "aos olhos deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Chamo o meu servo,",
          "e ele não me responde;",
          "tenho de suplicar-lhe, eu mesmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O meu hálito é intolerável",
          "à minha mulher,",
          "e pelo mau cheiro sou repugnante",
          "aos meus irmãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Até as crianças me desprezam,",
          "e, quando tento me levantar,",
          "zombam de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Todos os meus amigos íntimos",
          "me detestam,",
          "e até os que eu amava",
          "se voltaram contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Os meus ossos se apegam",
          "à minha pele e à minha carne;",
          "escapei só com a pele",
          "dos meus dentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Tenham pena de mim,",
          "meus amigos,",
          "tenham pena de mim,",
          "porque a mão de Deus",
          "me atingiu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Por que vocês me perseguem",
          "como Deus me persegue",
          "e não cessam de devorar",
          "a minha carne?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Eu sei que o meu Redentor vive"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "“Quem dera fossem agora",
          "escritas as minhas palavras!",
          "Quem dera fossem gravadas",
          "em livro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Que, com pena de ferro",
          "e com chumbo,",
          "para sempre fossem esculpidas",
          "na rocha!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Porque eu sei",
          "que o meu Redentor vive",
          "e por fim se levantará",
          "sobre a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Depois, revestido",
          "este meu corpo",
          "da minha pele,",
          "em minha carne verei a Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Eu o verei por mim mesmo,",
          "os meus olhos o verão,",
          "e não outros;",
          "de saudade o meu coração",
          "desfalece dentro de mim.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "“Se vocês disserem:",
          "‘Como o perseguiremos?’",
          "E: ‘A causa deste mal",
          "se acha nele mesmo’,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "então tenham medo da espada,",
          "porque tais acusações",
          "merecem o seu furor,",
          "para que vocês saibam",
          "que há um juízo.”"
        ],
        "rlw_lines": []
      }
    ]
  },
