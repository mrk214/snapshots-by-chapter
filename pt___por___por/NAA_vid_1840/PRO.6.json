    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertência contra o servir de fiador"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Meu filho, se você ficou",
          "por fiador do seu próximo",
          "e se comprometeu",
          "com um estranho,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "está enredado com as palavras",
          "da sua boca,",
          "e ficou preso pelo que você falou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Agora, meu filho, faça o seguinte",
          "para se livrar,",
          "pois você caiu",
          "nas mãos dessa pessoa:",
          "vá, humilhe-se",
          "e importune o seu próximo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Não se deite para dormir,",
          "não dê descanso aos seus olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Livre-se, como a gazela,",
          "das mãos do caçador",
          "e, como a ave,",
          "das mãos do passarinheiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertência contra a preguiça"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Vá ter com a formiga,",
          "ó preguiçoso!",
          "Observe os caminhos dela",
          "e seja sábio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Não tendo ela chefe,",
          "nem oficial, nem comandante,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "no verão prepara a sua comida,",
          "no tempo da colheita",
          "ajunta o seu mantimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ó preguiçoso, até quando",
          "vai ficar deitado?",
          "Quando se levantará do seu sono?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Um pouco de sono,",
          "um breve cochilo,",
          "braços cruzados para descansar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "e a sua pobreza virá",
          "como um ladrão,",
          "a miséria atacará",
          "como um homem armado."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertência contra a maldade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Perverso e vil",
          "é o que anda com a iniquidade",
          "na boca,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "pisca os olhos, arrasta os pés",
          "e faz sinais com os dedos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "No seu coração há perversidade;",
          "está sempre planejando o mal",
          "e semeando discórdias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por isso a sua destruição",
          "virá repentinamente;",
          "de um momento para outro",
          "ficará irremediavelmente",
          "arruinado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Seis coisas o Senhor Deus odeia,",
          "e uma sétima a sua alma detesta:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "olhos cheios de orgulho,",
          "língua mentirosa,",
          "mãos que derramam",
          "sangue inocente,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "coração que faz",
          "planos perversos,",
          "pés que se apressam",
          "a fazer o mal,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "testemunha falsa",
          "que profere mentiras",
          "e o que semeia discórdia",
          "entre irmãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertência contra o adultério"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Meu filho, guarde",
          "o mandamento de seu pai",
          "e não abandone",
          "a instrução de sua mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Tenha-os sempre",
          "amarrados ao seu coração,",
          "pendure-os no seu pescoço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Quando você andar,",
          "essa instrução o guiará;",
          "quando você se deitar,",
          "ela o guardará;",
          "quando acordar,",
          "falará com você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Porque o mandamento",
          "é lâmpada, e a instrução é luz;",
          "e as repreensões da disciplina",
          "são o caminho da vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Eles o protegerão",
          "da mulher perversa",
          "e das lisonjas da mulher estranha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Não cobice no coração",
          "a sua formosura,",
          "nem se deixe seduzir",
          "pelo seu olhar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "O máximo que se paga",
          "por uma prostituta",
          "é um pedaço de pão,",
          "mas a adúltera anda à caça",
          "de uma vida preciosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Poderá alguém carregar",
          "fogo no colo,",
          "sem que as suas roupas",
          "se incendeiem?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Ou andará alguém sobre brasas,",
          "sem que os seus pés se queimem?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Assim será com",
          "o que se aproximar",
          "da mulher do seu próximo;",
          "não ficará sem castigo todo aquele",
          "que tocar nela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Não se despreza o ladrão",
          "quando, faminto,",
          "rouba para matar a fome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Pois este, ao ser apanhado,",
          "pagará sete vezes tanto;",
          "entregará todos os bens",
          "de sua casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Quem comete adultério",
          "não tem juízo;",
          "só mesmo quem quer arruinar-se",
          "é que pratica tal coisa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Achará açoites e desonra,",
          "e a sua vergonha nunca passará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Porque o ciúme desperta",
          "o furor do marido;",
          "ele não terá compaixão",
          "no dia da vingança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Não se contentará",
          "com o resgate,",
          "nem aceitará presentes,",
          "ainda que sejam muitos."
        ],
        "rlw_lines": []
      }
    ]
  },
