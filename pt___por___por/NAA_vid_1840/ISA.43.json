    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Só Deus resgata Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mas agora, assim diz o Senhor,",
          "que o criou, ó Jacó,",
          "e que o formou, ó Israel:",
          "“Não tenha medo,",
          "porque eu o remi;",
          "eu o chamei pelo seu nome;",
          "você é meu."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quando você passar pelas águas,",
          "eu estarei com você;",
          "quando passar pelos rios,",
          "eles não o submergirão;",
          "quando passar pelo fogo,",
          "você não se queimará;",
          "as chamas não o atingirão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque eu sou o Senhor,",
          "seu Deus,",
          "o Santo de Israel, o seu Salvador;",
          "dei o Egito em resgate por você,",
          "e a Etiópia e Sebá",
          "para que você fosse meu."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Visto que você é",
          "precioso aos meus olhos",
          "e digno de honra,",
          "e porque eu o amo,",
          "darei homens por você",
          "e povos em troca de sua vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Não tenha medo,",
          "porque eu estarei com você.”",
          "“Trarei a sua descendência",
          "desde o Oriente",
          "e a ajuntarei desde o Ocidente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Direi ao Norte: ‘Entregue!’",
          "E ao Sul: ‘Não os impeça de sair!’",
          "Tragam os meus filhos de longe",
          "e as minhas filhas",
          "dos confins da terra,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "todos os que são chamados",
          "pelo meu nome,",
          "e os que criei para minha glória,",
          "sim, aqueles que formei e fiz.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Traga o povo que é cego,",
          "ainda que tenha olhos,",
          "e que é surdo,",
          "ainda que tenha ouvidos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Todas as nações se congreguem,",
          "e os povos se reúnam.",
          "Quem dentre eles",
          "pode anunciar isto",
          "e mostrar-nos",
          "as predições antigas?",
          "Que apresentem",
          "as suas testemunhas,",
          "para que se justifiquem,",
          "e para que se ouça e se diga:",
          "‘É verdade!’”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Vocês são",
          "as minhas testemunhas”,",
          "diz o Senhor.",
          "“Vocês são o meu servo",
          "a quem escolhi,",
          "para que vocês saibam,",
          "creiam em mim",
          "e entendam que eu sou,",
          "e que antes de mim",
          "deus nenhum se formou,",
          "e depois de mim nenhum haverá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eu, eu sou o Senhor,",
          "e fora de mim não há salvador."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eu anunciei salvação,",
          "eu a realizei e a fiz ouvir;",
          "deus estranho não houve",
          "entre vocês,",
          "pois vocês são",
          "as minhas testemunhas”,",
          "diz o Senhor.",
          "“Eu sou Deus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ainda antes que houvesse dia,",
          "eu sou;",
          "e não há quem possa livrar alguém",
          "das minhas mãos;",
          "agindo eu, quem o impedirá?”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Libertação do jugo da Babilônia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Assim diz o Senhor,",
          "o seu Redentor, o Santo de Israel:",
          "“Por causa de vocês,",
          "enviarei inimigos",
          "contra a Babilônia",
          "e a todos os babilônios",
          "farei embarcar",
          "como fugitivos nos navios",
          "de que se orgulhavam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eu sou o Senhor,",
          "o Santo Deus de vocês,",
          "o Criador de Israel e o seu Rei.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Assim diz o Senhor,",
          "que preparou um caminho no mar",
          "e uma vereda",
          "nas águas impetuosas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "que fez sair os carros de guerra",
          "e os cavalos,",
          "o exército e a força,",
          "e eles jazem ali",
          "e jamais se levantarão;",
          "estão extintos, apagados",
          "como um pavio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "“Não fiquem lembrando",
          "das coisas passadas,",
          "nem pensem nas coisas antigas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Eis que faço uma coisa nova.",
          "Agora mesmo ela está saindo à luz.",
          "Será que vocês não o percebem?",
          "Eis que porei um caminho",
          "no deserto",
          "e rios nos lugares áridos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Os animais do campo",
          "me glorificarão,",
          "os chacais e os filhotes",
          "de avestruzes,",
          "porque porei águas no deserto",
          "e rios nos lugares áridos,",
          "para dar de beber ao meu povo,",
          "ao meu escolhido,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "a este povo que formei",
          "para mim,",
          "para celebrar o meu louvor.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A misericórdia do Senhor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“Contudo, você não me invocou,",
          "ó Jacó;",
          "e você se cansou de mim, ó Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Você não me trouxe as ovelhas",
          "para os holocaustos,",
          "nem me honrou",
          "com os seus sacrifícios.",
          "Não lhe dei trabalho",
          "com ofertas de cereais,",
          "nem o cansei, pedindo incenso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Você não me comprou",
          "cana aromática,",
          "nem me satisfez com a gordura",
          "dos seus sacrifícios.",
          "Mas você me deu trabalho",
          "com os seus pecados",
          "e me cansou",
          "com as suas iniquidades.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "“Eu, eu mesmo, sou o que",
          "apago as suas transgressões",
          "por amor de mim;",
          "dos pecados que você cometeu",
          "não me lembro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Relembre-me o que aconteceu!",
          "Vamos juntos ao tribunal!",
          "Apresente as suas razões,",
          "para que você possa se justificar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "O seu primeiro pai pecou,",
          "e os seus guias se revoltaram",
          "contra mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Por isso, profanarei",
          "os líderes do santuário,",
          "e entregarei Jacó à destruição",
          "e Israel, à zombaria.”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
