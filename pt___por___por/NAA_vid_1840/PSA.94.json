    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Apelo para a justiça de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Senhor, Deus das vinganças,",
          "ó Deus das vinganças, resplandece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Levanta-te, ó juiz da terra,",
          "e dá aos soberbos o castigo",
          "que eles merecem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Até quando, Senhor, os ímpios,",
          "até quando os ímpios exultarão?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Fazem alarde",
          "e falam com arrogância;",
          "todos os que praticam a iniquidade",
          "se vangloriam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Esmagam o teu povo, Senhor,",
          "e oprimem a tua herança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Matam as viúvas e os estrangeiros",
          "e assassinam os órfãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "E dizem:",
          "“O Senhor não está vendo;",
          "o Deus de Jacó não faz caso disso.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Prestem atenção,",
          "ó estúpidos dentre o povo;",
          "e vocês, tolos,",
          "quando se tornarão sábios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Aquele que fez o ouvido",
          "será que não ouve?",
          "Aquele que formou os olhos",
          "será que não enxerga?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Aquele que repreende as nações",
          "será que não vai punir?",
          "Aquele que dá aos seres humanos",
          "o conhecimento",
          "será que não tem sabedoria?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor conhece",
          "os pensamentos do ser humano,",
          "e sabe que são pensamentos vãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Bem-aventurado, Senhor,",
          "é aquele a quem tu repreendes,",
          "a quem ensinas a tua lei,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "para lhe dares descanso",
          "dos dias maus,",
          "até que se abra a cova",
          "para o ímpio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pois o Senhor não abandonará",
          "o seu povo;",
          "ele não irá desamparar",
          "a sua herança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Nos tribunais voltará a imperar",
          "a justiça,",
          "e todos os de coração reto",
          "a seguirão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Quem se levantará a meu favor",
          "contra os perversos?",
          "Quem estará comigo",
          "contra os que praticam",
          "a iniquidade?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Se não fosse o auxílio do Senhor,",
          "a minha alma já estaria",
          "na região do silêncio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Quando eu digo:",
          "“Os meus pés vão resvalar”,",
          "a tua bondade, Senhor, me sustém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Multiplicando-se em mim",
          "as inquietações,",
          "as tuas consolações",
          "me alegram a alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Será que pode associar-se",
          "contigo o trono da perversidade,",
          "que forja o mal,",
          "tendo uma lei por pretexto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Ajuntam-se",
          "contra a vida dos justos",
          "e condenam à morte os inocentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Mas o Senhor",
          "é o meu alto refúgio;",
          "o meu Deus é o rochedo",
          "em que me abrigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Sobre eles faz recair",
          "a sua iniquidade",
          "e pela maldade deles próprios",
          "os destruirá;",
          "o Senhor, nosso Deus,",
          "os destruirá."
        ],
        "rlw_lines": []
      }
    ]
  },
