    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Desejos pelo santuário"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Faze-me justiça, ó Deus,",
          "e defende a minha causa",
          "contra a nação infiel;",
          "livra-me dessa gente fraudulenta",
          "e injusta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pois tu és o Deus",
          "da minha fortaleza.",
          "Por que me rejeitas?",
          "Por que hei de andar",
          "eu lamentando",
          "sob a opressão",
          "dos meus inimigos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Envia a tua luz e a tua verdade,",
          "para que me guiem",
          "e me levem ao teu santo monte",
          "e aos teus tabernáculos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Então irei ao altar de Deus,",
          "de Deus, que é a minha",
          "grande alegria;",
          "ao som da harpa eu te louvarei,",
          "ó Deus, Deus meu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Por que você está abatida,",
          "ó minha alma?",
          "Por que se perturba",
          "dentro de mim?",
          "Espere em Deus,",
          "pois ainda o louvarei,",
          "a ele, meu auxílio",
          "e Deus meu."
        ],
        "rlw_lines": []
      }
    ]
  },
