  },
  "chapter": {
    "usfm": "PRO.29",
    "human": "Provérbios 29",
    "previous": {
      "usfm": "PRO.28",
      "human": "Provérbios 28"
    },
    "next": {
      "usfm": "PRO.30",
      "human": "Provérbios 30"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quem teima em rejeitar",
          "a repreensão",
          "será destruído de repente",
          "sem que haja remédio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quando os justos se multiplicam,",
          "o povo se alegra;",
          "quando o ímpio domina,",
          "então o povo lamenta."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quem ama a sabedoria",
          "alegra o seu pai,",
          "mas o companheiro de prostitutas",
          "desperdiça os bens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O rei justo",
          "traz estabilidade ao país,",
          "mas o amigo de impostos",
          "o leva à ruína."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem lisonjeia o seu próximo",
          "está armando uma rede",
          "para os seus pés."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Na transgressão do homem mau,",
          "há uma armadilha,",
          "mas o justo canta e se alegra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O justo se interessa",
          "pelo direito dos pobres,",
          "mas o ímpio não se importa",
          "com isso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os zombadores",
          "alvoroçam a cidade,",
          "mas os sábios acalmam os ânimos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Se o sábio discute",
          "com um insensato,",
          "quer este se enfureça, quer se ria,",
          "não haverá descanso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os homens sanguinários",
          "odeiam o íntegro,",
          "mas os retos procuram o seu bem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O tolo derrama toda a sua ira,",
          "mas o sábio se domina e a reprime."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Se um governador dá atenção",
          "a palavras mentirosas,",
          "todos os seus servos",
          "virão a ser perversos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O pobre e o seu opressor",
          "têm algo em comum:",
          "é o Senhor quem dá luz",
          "aos olhos de ambos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O rei que julga os pobres",
          "segundo a verdade",
          "firmará o seu trono para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "A vara e a disciplina",
          "dão sabedoria,",
          "mas a criança entregue a si mesma",
          "envergonha a sua mãe."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Quando os ímpios",
          "se multiplicam,",
          "multiplicam-se as transgressões,",
          "mas os justos verão a ruína deles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Corrija o seu filho,",
          "e você terá descanso;",
          "ele será um prazer para a sua alma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Não havendo profecia,",
          "o povo se corrompe;",
          "mas o que guarda a lei, esse é feliz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "O servo não se emendará",
          "com palavras,",
          "porque, mesmo que entenda,",
          "não obedecerá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Você viu alguém que é",
          "precipitado no falar?",
          "Há mais esperança para um tolo",
          "do que para ele."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Se alguém mimar o escravo",
          "desde a infância,",
          "por fim ele vai querer ser filho."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "A pessoa colérica",
          "provoca discórdias,",
          "e quem facilmente fica irado",
          "multiplica as transgressões."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "O orgulho do ser humano",
          "o abaterá,",
          "mas o humilde de espírito",
          "obterá honra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Quem tem parte com um ladrão",
          "odeia a própria alma;",
          "mesmo ouvindo a maldição,",
          "permanece calado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Quem tem medo dos outros",
          "cai numa armadilha,",
          "mas o que confia no Senhor",
          "está seguro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Muitos buscam o favor",
          "daquele que governa,",
          "mas a justiça do Senhor",
          "vem para todos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Para os justos,",
          "a pessoa iníqua é abominação,",
          "e o reto em seu caminho",
          "é abominação ao ímpio."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
