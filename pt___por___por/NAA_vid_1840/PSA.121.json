    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus, o nosso protetor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de peregrinação"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Elevo os meus olhos",
          "para os montes:",
          "de onde me virá o socorro?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O meu socorro vem do Senhor,",
          "que fez o céu e a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ele não permitirá",
          "que os seus pés vacilem;",
          "não dormitará",
          "aquele que guarda você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "É certo que não dormita,",
          "nem dorme",
          "o guarda de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor é quem guarda você;",
          "o Senhor é a sombra à sua direita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "De dia não lhe fará mal o sol,",
          "nem de noite, a lua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor guardará você",
          "de todo mal;",
          "guardará a sua alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O Senhor guardará a sua saída",
          "e a sua entrada,",
          "desde agora e para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
