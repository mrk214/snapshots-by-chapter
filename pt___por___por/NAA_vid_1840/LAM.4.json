    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os sofrimentos do cerco"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Como se escureceu o ouro!",
          "Como o ouro refinado",
          "perdeu o seu brilho!",
          "Como estão espalhadas",
          "as pedras do santuário",
          "pelas esquinas de todas as ruas!",
          "Bete —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Os nobres filhos de Sião,",
          "comparáveis a ouro puro,",
          "agora são tratados",
          "como simples objetos de barro,",
          "obra das mãos de oleiro!",
          "Guímel —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Até os chacais",
          "dão o peito,",
          "dão de mamar aos seus filhotes;",
          "mas a filha do meu povo",
          "tornou-se cruel",
          "como as avestruzes no deserto.",
          "Dálete —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A língua do bebê",
          "que mama",
          "fica pegada, pela sede,",
          "ao céu da boca;",
          "as crianças pedem pão,",
          "mas não há quem as alimente.",
          "Hê —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os que se alimentavam",
          "de comidas finas",
          "desfalecem nas ruas;",
          "os que se criaram entre escarlate",
          "agora vivem entre montes de lixo.",
          "Vau —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque a maldade",
          "da filha do meu povo",
          "é maior do que o pecado",
          "de Sodoma,",
          "que foi destruída num momento,",
          "sem intervenção humana.",
          "Zaine —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os seus príncipes",
          "eram mais alvos do que a neve,",
          "mais brancos do que o leite;",
          "eram mais ruivos de corpo",
          "do que os corais",
          "e tinham a formosura da safira.",
          "Hete —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas agora o aspecto deles",
          "é mais escuro do que a fuligem;",
          "não são reconhecidos nas ruas.",
          "A sua pele grudou nos ossos,",
          "secou-se como a madeira.",
          "Tete —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mais felizes foram",
          "as vítimas da espada",
          "do que as vítimas da fome;",
          "porque estas se definham",
          "atingidas mortalmente",
          "pela falta do produto",
          "dos campos.",
          "Iode —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "As mãos das mulheres",
          "que antes eram compassivas",
          "cozinharam",
          "os seus próprios filhos;",
          "estes lhes serviram de alimento",
          "quando a filha do meu povo",
          "foi destruída.",
          "Cafe —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor deu cumprimento",
          "à sua indignação,",
          "derramou o furor da sua ira;",
          "acendeu fogo em Sião,",
          "que consumiu os seus alicerces.",
          "Lâmede —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Nem os reis da terra,",
          "nem todos os moradores",
          "do mundo acreditavam",
          "que o adversário ou inimigo",
          "pudesse entrar",
          "pelos portões de Jerusalém.",
          "Mem —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tudo isso aconteceu",
          "por causa dos pecados",
          "dos seus profetas",
          "e por causa das maldades",
          "dos seus sacerdotes,",
          "que derramaram no meio dela",
          "o sangue dos justos.",
          "Num —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Vagueiam como cegos",
          "pelas ruas,",
          "andam contaminados de sangue,",
          "de maneira que ninguém",
          "pode tocar na roupa deles.",
          "Sâmeque —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "E o povo grita:",
          "“Afastem-se, impuros!",
          "Afastem-se, afastem-se,",
          "não toquem em nada!”",
          "Quando fugiram",
          "e andaram errantes,",
          "dizia-se entre as nações:",
          "“Aqui eles não podem morar.”",
          "Pê —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "A ira do Senhor os espalhou;",
          "ele já não dá atenção a eles.",
          "Não respeitaram os sacerdotes,",
          "nem se compadeceram",
          "dos anciãos.",
          "Aim —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os nossos olhos",
          "ainda desfalecem,",
          "esperando socorro",
          "que nunca chega;",
          "de nossas torres,",
          "temos olhado para um povo",
          "que não nos pode livrar.",
          "Tsadê —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Espreitavam",
          "os nossos passos,",
          "de maneira que",
          "não podíamos andar",
          "pelas nossas ruas.",
          "Nosso fim se aproximava,",
          "os nossos dias estavam contados,",
          "era chegado o nosso fim.",
          "Cofe —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Os nossos perseguidores",
          "foram mais ligeiros",
          "do que as águias nos céus;",
          "sobre os montes nos perseguiram,",
          "no deserto nos armaram ciladas.",
          "Rexe —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O ungido do Senhor,",
          "que era o nosso alento,",
          "foi preso nas armadilhas deles.",
          "Dele dizíamos:",
          "“Debaixo da sua sombra,",
          "viveremos entre as nações.”",
          "Chim —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Exulte e alegre-se agora,",
          "ó filha de Edom,",
          "você que habita na terra de Uz.",
          "Logo chegará a sua hora",
          "de beber do cálice;",
          "você ficará embriagada e despida.",
          "Tau —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "O castigo por causa",
          "da sua maldade",
          "está consumado,",
          "ó filha de Sião;",
          "o Senhor nunca mais a levará",
          "para o exílio.",
          "Mas ele castigará a sua maldade,",
          "ó filha de Edom;",
          "porá a descoberto os pecados",
          "que você cometeu."
        ],
        "rlw_lines": []
      }
    ]
  },
