  "chapter": {
    "usfm": "HOS.7",
    "human": "Oseias 7",
    "previous": {
      "usfm": "HOS.6",
      "human": "Oseias 6"
    },
    "next": {
      "usfm": "HOS.8",
      "human": "Oseias 8"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quando tento sarar Israel,",
          "se descobre a iniquidade de Efraim",
          "e a maldade de Samaria,",
          "porque praticam a falsidade;",
          "ladrões invadem as casas",
          "e bandos assaltam nas ruas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Não se dão conta de que",
          "eu me lembro de todas",
          "as suas maldades.",
          "Agora estão rodeados",
          "pelas suas más ações,",
          "que estão sempre diante de mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Alegram o rei",
          "com as suas maldades,",
          "e os príncipes,",
          "com as suas mentiras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todos eles são adúlteros.",
          "São semelhantes ao forno",
          "aceso pelo padeiro,",
          "que não precisa atiçar o fogo",
          "desde que sovou a massa",
          "até que seja levedada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "No dia da festa do nosso rei,",
          "os príncipes adoeceram",
          "de tanto beber vinho,",
          "e o rei estendeu a mão",
          "aos zombadores."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Enquanto estão à espreita,",
          "preparam o coração",
          "como um forno:",
          "durante a noite",
          "o seu furor se abranda,",
          "mas, pela manhã, queima",
          "como um fogo abrasador."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todos eles são quentes",
          "como um forno",
          "e consomem os seus juízes.",
          "Todos os seus reis caem,",
          "mas não há ninguém entre eles",
          "que me invoque.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Efraim se mistura com os povos",
          "e é um pão que não foi virado",
          "na hora de assar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Estrangeiros sugam",
          "as suas forças,",
          "mas ele não percebe;",
          "cabelos brancos",
          "se espalham pela cabeça,",
          "mas ele não o sabe."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A arrogância de Israel",
          "abertamente dá testemunho",
          "contra eles,",
          "mas eles não voltam",
          "para o Senhor, seu Deus,",
          "nem o buscam em tudo isso.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Porque Efraim é como",
          "uma pomba ingênua,",
          "sem entendimento:",
          "chamam o Egito",
          "e se voltam para a Assíria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Quando forem,",
          "estenderei a minha rede sobre eles",
          "e farei com que desçam",
          "como as aves do céu.",
          "Eu os castigarei de acordo",
          "com o que ouviram",
          "na sua congregação."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "— Ai deles!",
          "Porque fugiram de mim.",
          "Destruição sobre eles,",
          "porque se rebelaram",
          "contra mim!",
          "Eu os remiria,",
          "mas eles falam mentiras",
          "contra mim.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Não clamam a mim de coração,",
          "mas dão uivos nas suas camas.",
          "Eles se ajuntam para o trigo",
          "e para o vinho,",
          "mas se rebelam contra mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eu treinei e fortaleci",
          "os seus braços,",
          "mas eles planejam",
          "o mal contra mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Eles voltam,",
          "mas não para o Altíssimo.",
          "Fizeram-se",
          "como um arco defeituoso.",
          "Os seus príncipes",
          "serão mortos à espada,",
          "por causa da insolência",
          "da sua língua.",
          "Serão motivo de zombaria",
          "na terra do Egito.”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
