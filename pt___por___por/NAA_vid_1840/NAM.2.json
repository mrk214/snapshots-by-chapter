    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A queda de Nínive"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O destruidor avança",
          "contra você, Nínive!",
          "Guarde a fortaleza,",
          "vigie o caminho,",
          "prepare-se para lutar,",
          "reúna todas as suas forças!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque o Senhor restaurará",
          "a glória de Jacó,",
          "como a glória de Israel;",
          "porque saqueadores os saquearam",
          "e destruíram os seus ramos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os escudos dos seus heróis",
          "são vermelhos;",
          "os homens valentes",
          "vestem escarlate.",
          "Os carros de guerra",
          "brilham como fogo",
          "no dia da sua preparação,",
          "e as lanças são agitadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os carros de guerra passam",
          "furiosamente pelas ruas",
          "e se cruzam velozes pelas praças;",
          "parecem tochas,",
          "correm como relâmpago."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os nobres são chamados,",
          "mas tropeçam no seu caminho;",
          "apressam-se para chegar à muralha",
          "e preparam a defesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "As comportas dos rios se abrem,",
          "e o palácio é destruído."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Está decretado:",
          "a cidade-rainha está despida,",
          "levada em cativeiro;",
          "as suas servas gemem",
          "como pombas",
          "e batem no peito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Nínive, desde que existe,",
          "tem sido como um tanque de águas;",
          "mas, agora, o seu povo foge.",
          "Alguém grita: “Parem! Parem!”,",
          "mas ninguém se volta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Saqueiem a prata,",
          "saqueiem o ouro,",
          "porque os tesouros não têm fim;",
          "a cidade está repleta de objetos de valor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Vazio, desolação, ruína!",
          "O coração se derrete,",
          "os joelhos tremem,",
          "acabam-se as forças,",
          "e o rosto de todos empalidece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Onde está, agora,",
          "o covil dos leões",
          "e o lugar onde os leõezinhos",
          "se alimentavam,",
          "onde passeavam o leão,",
          "a leoa e o filhote do leão,",
          "sem que ninguém os espantasse?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O leão arrebatava o bastante",
          "para os seus filhotes,",
          "estrangulava a presa",
          "para as suas leoas,",
          "e enchia de vítimas",
          "as suas cavernas,",
          "e os seus covis, de rapina."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Eis que eu estou contra você”,",
          "diz o Senhor dos Exércitos;",
          "“queimarei os seus carros de guerra,",
          "a espada devorará",
          "os seus leõezinhos,",
          "arrancarei da terra a sua presa,",
          "e nunca mais se ouvirá a voz",
          "dos seus embaixadores.”"
        ],
        "rlw_lines": []
      }
    ]
  },
