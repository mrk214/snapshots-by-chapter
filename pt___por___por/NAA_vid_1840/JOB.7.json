    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "A vida é uma luta sem fim"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Não é verdade que a vida",
          "do ser humano neste mundo",
          "é uma luta sem fim?",
          "Não são os seus dias como",
          "os de um trabalhador diarista?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como o escravo",
          "que suspira pela sombra",
          "e como o trabalhador",
          "que espera pelo seu salário,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "assim me deram por herança",
          "meses de desengano",
          "e me proporcionaram",
          "noites de aflição."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ao deitar-me, pergunto:",
          "quando me levantarei?",
          "Mas a noite é longa,",
          "e estou farto de me virar na cama,",
          "até o amanhecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O meu corpo está",
          "vestido de vermes",
          "e de crostas terrosas;",
          "a minha pele racha",
          "e de novo forma pus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os meus dias são mais velozes",
          "do que a lançadeira do tecelão",
          "e se findam sem esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Lembra-te, ó Deus, de que",
          "a minha vida é um sopro;",
          "os meus olhos não tornarão",
          "a ver a felicidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os olhos de quem agora me vê",
          "não me verão mais;",
          "os teus olhos me procurarão,",
          "mas já terei desaparecido.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deixa-me em paz"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“Assim como a nuvem",
          "se desfaz e passa,",
          "aquele que desce à sepultura",
          "jamais voltará a subir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Nunca mais voltará",
          "para a sua casa,",
          "e o lugar onde mora",
          "nunca mais o conhecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por isso, não reprimirei",
          "a minha boca.",
          "Na angústia do meu espírito,",
          "falarei;",
          "na amargura da minha alma,",
          "eu me queixarei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Será que eu sou o mar",
          "ou algum monstro marinho,",
          "para que me ponhas sob guarda?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Quando digo:",
          "‘O meu leito me consolará,",
          "a minha cama",
          "aliviará a minha queixa’,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "então me assustas com sonhos",
          "e me atemorizas com visões."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por isso, prefiro",
          "ser estrangulado;",
          "antes a morte do que esta tortura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Estou farto da minha vida;",
          "não quero viver para sempre.",
          "Deixa-me em paz,",
          "porque os meus dias",
          "são um sopro.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Que é o homem?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Que é o homem,",
          "para que tu lhe dês",
          "tanta importância,",
          "para que dês a ele atenção,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "para que a cada manhã o visites,",
          "e que a cada momento",
          "o ponhas à prova?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Até quando não desviarás",
          "de mim o teu olhar?",
          "Até quando não me darás tempo",
          "de engolir a minha saliva?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Se pequei, que mal fiz a ti,",
          "ó Espreitador da humanidade?",
          "Por que fizeste de mim o teu alvo,",
          "tornando-me um peso",
          "para mim mesmo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Por que não perdoas",
          "a minha transgressão",
          "e não tiras a minha iniquidade?",
          "Pois agora me deitarei no pó;",
          "e, se me procuras,",
          "já terei desaparecido.”"
        ],
        "rlw_lines": []
      }
    ]
  },
