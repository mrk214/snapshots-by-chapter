    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A justiça e a bondade de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo didático de Davi, quando Doegue, edomita, foi contar a Saul que Davi tinha ido à casa de Abimeleque"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Por que você se gloria",
          "na maldade,",
          "ó homem poderoso?",
          "Pois a bondade de Deus",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Com a língua você trama",
          "planos de destruição;",
          "ela é como navalha afiada,",
          "que só produz enganos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Você ama o mal",
          "mais do que o bem;",
          "prefere mentir a falar a verdade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Você ama todas as palavras",
          "devoradoras,",
          "ó língua fraudulenta!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Também Deus o destruirá",
          "para sempre;",
          "ele o pegará e arrancará da tenda",
          "em que você habita",
          "e o extirpará da terra dos viventes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os justos verão tudo isso,",
          "temerão e vão rir dele, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Eis o homem",
          "que não fazia de Deus",
          "a sua fortaleza,",
          "mas confiava na abundância",
          "dos seus próprios bens",
          "e se fortalecia na sua perversidade.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Quanto a mim, porém,",
          "sou como a oliveira verde",
          "na Casa de Deus;",
          "confio na misericórdia de Deus",
          "para todo o sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Sempre te louvarei,",
          "porque assim o fizeste;",
          "na presença dos teus fiéis,",
          "esperarei no teu nome,",
          "porque é bom."
        ],
        "rlw_lines": []
      }
    ]
  },
