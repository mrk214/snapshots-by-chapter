    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O rei justo e o seu reinado eterno"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Salomão"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Concede ao rei, ó Deus,",
          "os teus juízos",
          "e a tua justiça, ao filho do rei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Que ele julgue o teu povo",
          "com justiça",
          "e os teus aflitos, com retidão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os montes trarão paz ao povo;",
          "também as colinas a trarão,",
          "com justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Que o rei julgue",
          "os aflitos do povo,",
          "salve os filhos dos necessitados",
          "e esmague o opressor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele permanecerá",
          "enquanto existir o sol",
          "e enquanto durar a lua,",
          "através das gerações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Seja ele como chuva que desce",
          "sobre a campina ceifada,",
          "como aguaceiros que regam a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que em seus dias",
          "floresçam os justos,",
          "e haja abundância de paz",
          "até que cesse de haver lua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Domine ele de mar a mar",
          "e desde o rio",
          "até os confins da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Curvem-se diante dele",
          "os habitantes do deserto,",
          "e os seus inimigos lambam o pó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Que os reis de Társis e das ilhas",
          "lhe paguem tributo;",
          "os reis de Sabá e de Sebá",
          "lhe ofereçam presentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "E todos os reis se prostrem",
          "diante dele;",
          "todas as nações o sirvam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque ele livra os necessitados",
          "que pedem socorro,",
          "e também os aflitos e aqueles",
          "que não têm quem os ajude."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ele se compadece dos fracos",
          "e dos necessitados",
          "e salva a alma dos que precisam",
          "de auxílio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ele os redime da opressão",
          "e da violência,",
          "e precioso lhe é o sangue deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Viva o rei! E que lhe deem",
          "ouro de Sabá!",
          "Que continuamente",
          "se faça por ele oração,",
          "e o bendigam todos os dias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Haja na terra",
          "abundância de cereais,",
          "que ondulem",
          "até o alto dos montes.",
          "Sejam os seus frutos",
          "como os do Líbano,",
          "e das cidades floresçam",
          "os habitantes",
          "como a erva da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Que o nome do rei permaneça",
          "para sempre,",
          "e que prospere",
          "enquanto o sol brilhar!",
          "Que todos sejam abençoados",
          "por meio dele,",
          "e que todas as nações lhe chamem",
          "bem-aventurado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Bendito seja o Senhor Deus,",
          "o Deus de Israel,",
          "o único que faz maravilhas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Bendito para sempre",
          "o seu glorioso nome,",
          "e da sua glória se encha",
          "toda a terra.",
          "Amém e amém!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Aqui terminam as orações",
          "de Davi, filho de Jessé."
        ],
        "rlw_lines": []
      }
    ]
  },
