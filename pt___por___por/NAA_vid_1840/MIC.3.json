    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ameaças contra os maus governantes e os falsos profetas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu disse:",
          "Escutem agora,",
          "governantes de Jacó",
          "e chefes da casa de Israel:",
          "Por acaso não é a vocês",
          "que compete",
          "conhecer a justiça?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Mas vocês odeiam o bem",
          "e amam o mal;",
          "arrancam a pele do meu povo",
          "e a carne de cima dos seus ossos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Vocês comem a carne",
          "do meu povo",
          "e lhes arrancam a pele;",
          "quebram os seus ossos,",
          "e os repartem em pedaços",
          "que vão para a panela",
          "e em carne que vai",
          "para o caldeirão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Um dia eles hão de invocar",
          "o Senhor,",
          "mas ele não os ouvirá;",
          "naquele tempo, esconderá deles",
          "a sua face,",
          "por causa do mal que praticaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Assim diz o Senhor",
          "a respeito dos profetas",
          "que fazem o meu povo",
          "andar errante",
          "e que clamam: “Paz”,",
          "quando têm o que mastigar,",
          "mas apregoam guerra santa",
          "contra aqueles",
          "que não lhes dão nada para comer:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Por isso, vocês terão noites",
          "sem visões;",
          "vocês terão trevas",
          "sem adivinhações.",
          "O sol se porá sobre os profetas,",
          "e o dia se transformará em escuridão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os videntes serão envergonhados,",
          "e os adivinhos serão humilhados.",
          "Todos eles colocarão a mão",
          "sobre a boca,",
          "porque não haverá resposta",
          "de Deus.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Quanto a mim, estou cheio",
          "do poder do Espírito do Senhor,",
          "cheio de justiça e de força,",
          "para declarar a Jacó",
          "a sua transgressão",
          "e a Israel, o seu pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Escutem agora isto,",
          "governantes da casa de Jacó",
          "e chefes da casa de Israel,",
          "vocês que detestam a justiça",
          "e pervertem tudo o que é correto,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "que edificam Sião com sangue",
          "e Jerusalém, com iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Os seus cabeças dão",
          "as sentenças por suborno,",
          "os seus sacerdotes ensinam",
          "por interesse,",
          "e os seus profetas adivinham",
          "por dinheiro.",
          "E ainda se apoiam no Senhor,",
          "dizendo:",
          "“Não está o Senhor",
          "no meio de nós?",
          "Nenhum mal nos sobrevirá.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Portanto, por causa de vocês,",
          "Sião será lavrada como um campo,",
          "e Jerusalém se tornará",
          "um montão de ruínas,",
          "e o monte do templo,",
          "numa colina coberta de mato."
        ],
        "rlw_lines": []
      }
    ]
  },
