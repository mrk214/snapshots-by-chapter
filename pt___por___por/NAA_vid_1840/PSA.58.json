    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O castigo dos ímpios"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “Não destruas”. Hino de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Será que vocês, juízes,",
          "tomam decisões justas?",
          "Julgam com retidão",
          "os filhos dos homens?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Longe disso!",
          "Pelo contrário, no íntimo",
          "vocês planejam iniquidades",
          "e distribuem na terra",
          "a violência de suas mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os ímpios se desviam",
          "desde a sua concepção;",
          "nascem e já se desencaminham,",
          "proferindo mentiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Têm veneno semelhante",
          "ao veneno da serpente;",
          "são como a víbora surda,",
          "que tapa os ouvidos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "para não ouvir",
          "a voz dos encantadores,",
          "do mais fascinante",
          "em encantamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ó Deus, quebra-lhes",
          "os dentes na boca;",
          "arranca, Senhor,",
          "as presas dos leõezinhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que eles desapareçam",
          "como as águas que se escoam;",
          "ao dispararem flechas,",
          "que elas se despedacem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sejam como a lesma,",
          "que se dilui ao passar;",
          "como o aborto de mulher,",
          "que nunca vejam a luz do sol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Como espinheiros,",
          "antes que as panelas",
          "de vocês sintam deles o calor,",
          "tanto os verdes",
          "como os que estão em brasa,",
          "serão arrebatados",
          "como por um redemoinho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os justos se alegrarão",
          "ao verem a vingança;",
          "banharão os pés",
          "no sangue dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Então se dirá: “Na verdade,",
          "há recompensa para os justos;",
          "de fato há um Deus",
          "que julga na terra.”"
        ],
        "rlw_lines": []
      }
    ]
  },
