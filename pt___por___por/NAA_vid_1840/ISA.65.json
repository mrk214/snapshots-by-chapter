    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os rebeldes serão rejeitados"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Fui buscado pelos que",
          "não perguntavam por mim;",
          "fui achado por aqueles que",
          "não me buscavam.",
          "A um povo que não se chamava",
          "pelo meu nome,",
          "eu disse: ‘Eis-me aqui!",
          "Eis-me aqui!’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Todo o dia estendi as mãos",
          "a um povo rebelde,",
          "que anda por um caminho",
          "que não é bom,",
          "seguindo os seus próprios",
          "pensamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "É um povo que de contínuo",
          "me irrita abertamente,",
          "sacrificando em jardins",
          "e queimando incenso",
          "sobre altares de tijolos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eles se assentam",
          "entre as sepulturas",
          "e passam as noites",
          "em lugares misteriosos.",
          "Comem carne de porco",
          "e nos seus pratos têm ensopado",
          "de carne abominável."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "É um povo que diz:",
          "‘Fique onde você está!",
          "Não se aproxime de mim,",
          "porque sou mais santo",
          "do que você.’",
          "Estes são como fumaça",
          "no meu nariz,",
          "como fogo que queima o dia todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eis que está escrito",
          "diante de mim:",
          "‘Não me calarei, mas retribuirei;",
          "farei retribuição total"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "pelas iniquidades de vocês",
          "e também pelas iniquidades",
          "dos seus pais’”,",
          "diz o Senhor.",
          "“Eles queimaram incenso",
          "nos montes",
          "e me afrontaram nas colinas;",
          "por isso, eu os farei pagar",
          "integralmente",
          "pelas suas obras antigas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus poupará os seus servos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Como quando se acha suco",
          "num cacho de uvas",
          "e se diz: ‘Não o destruam,",
          "pois há bênção nele’,",
          "assim farei por amor",
          "de meus servos",
          "e não destruirei todos eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Farei sair de Jacó descendência",
          "e de Judá, um herdeiro",
          "que possua os meus montes.",
          "Os meus eleitos herdarão a terra,",
          "e os meus servos habitarão nela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Sarom servirá de pasto",
          "para as ovelhas,",
          "e o vale de Acor, de lugar",
          "de repouso para o gado,",
          "para o meu povo que me buscar.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Mas quanto a vocês",
          "que se afastam do Senhor,",
          "que se esquecem",
          "do meu santo monte,",
          "que preparam uma mesa",
          "para a deusa Fortuna",
          "e misturam vinho",
          "para o deus Destino,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "eu os destinarei à espada,",
          "e todos vocês se encurvarão",
          "à matança.",
          "Porque eu chamei,",
          "e vocês não responderam;",
          "falei, e não atenderam,",
          "mas fizeram o que é mau",
          "aos meus olhos",
          "e escolheram aquilo",
          "em que eu não tenho prazer.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Portanto,",
          "assim diz o Senhor Deus:",
          "“Eis que os meus servos comerão,",
          "mas vocês passarão fome;",
          "os meus servos beberão,",
          "mas vocês terão sede;",
          "os meus servos se alegrarão,",
          "mas vocês passarão vergonha;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "os meus servos cantarão",
          "por terem o coração alegre,",
          "mas vocês gritarão",
          "pela tristeza do coração",
          "e uivarão pela angústia de espírito.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "“O nome de vocês será deixado",
          "como fórmula de maldição",
          "para os meus eleitos.",
          "O Senhor Deus fará com que",
          "vocês morram,",
          "e aos servos dele chamará",
          "por outro nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Assim, quem quiser",
          "ser abençoado na terra,",
          "será abençoado",
          "pelo Deus da verdade;",
          "e quem jurar na terra,",
          "jurará pelo Deus da verdade.",
          "Porque as angústias passadas",
          "serão esquecidas",
          "e ficarão escondidas",
          "dos meus olhos.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Novos céus e nova terra"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Pois eis que eu crio",
          "novos céus e nova terra;",
          "e não haverá lembrança",
          "das coisas passadas,",
          "jamais haverá memória delas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Exultem e alegrem-se",
          "para sempre no que eu crio;",
          "porque eis que crio",
          "para Jerusalém alegria",
          "e para o seu povo, exultação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Eu me alegrarei",
          "por causa de Jerusalém",
          "e exultarei no meu povo,",
          "e nunca mais se ouvirá nela",
          "nem voz de choro nem de clamor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Não haverá mais nela criança",
          "que viva somente alguns dias,",
          "nem velho que não complete",
          "os seus dias.",
          "Porque morrer aos cem anos",
          "será morrer ainda jovem,",
          "e quem pecar só aos cem anos",
          "será amaldiçoado.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "“Eles construirão casas",
          "e nelas habitarão;",
          "plantarão vinhas",
          "e comerão o seu fruto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Não construirão",
          "para que outros habitem,",
          "nem plantarão",
          "para que outros comam.",
          "Porque a longevidade do meu povo",
          "será como a da árvore,",
          "e os meus eleitos desfrutarão",
          "ao máximo",
          "as obras das suas próprias mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Não farão o seu trabalho",
          "em vão,",
          "nem irão gerar filhos",
          "para a calamidade,",
          "porque são a descendência",
          "dos benditos do Senhor,",
          "e os seus filhos estarão com eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Antes mesmo que clamem,",
          "eu responderei;",
          "estando eles ainda falando,",
          "eu os ouvirei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "O lobo e o cordeiro",
          "pastarão juntos,",
          "e o leão comerá palha como o boi;",
          "pó será a comida da serpente.",
          "Não se fará mal nem dano algum",
          "em todo o meu santo monte”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
