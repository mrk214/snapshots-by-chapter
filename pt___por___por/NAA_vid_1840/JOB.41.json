{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"JOB","name":"Jó"},"chapter":{"chapter_usfm":"JOB.41","is_chapter":true,"previous":{"usfm":"JOB.40","human":"Jó 40","canonical":true,"toc":true},"current":{"usfm":"JOB.41","human":"Jó 41"},"next":{"usfm":"JOB.42","human":"Jó 42","canonical":true,"toc":true},"items":[{"type":"heading2","verse_numbers":[],"lines":["Quem é capaz de enfrentar o monstro Leviatã?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["“Você é capaz de pescar","o monstro Leviatã","com um anzol","e prender a sua língua","com uma corda?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Você consegue passar","uma vara de junco","pelo nariz dele?","Ou furar o queixo dele","com um gancho?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Por acaso ele lhe fará","muitas súplicas?","Ou lhe falará palavras brandas?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Será que ele fará","um acordo com você,","para que seja seu escravo","para sempre?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Será que você vai brincar","com ele, como se fosse","um passarinho?","Irá prendê-lo com uma corda,","para dá-lo às suas meninas?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Será que os seus sócios","o colocarão à venda?","Ou irão reparti-lo","entre os negociantes?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Você consegue encher","de arpões a pele dele?","Ou cravar fisgas de pesca","na sua cabeça?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Ponha a mão sobre ele;","você se lembrará da luta","e nunca mais repetirá o gesto.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["“Eis que a gente se engana","na esperança que tem;","não é fato que alguém cairá","por terra só em vê-lo?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Ninguém é tão ousado,","que se atreva a despertá-lo.”","“Quem então será capaz","de se erguer diante de mim?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Quem primeiro deu algo","a mim, para que eu tenha","de retribuir-lhe?","Pois o que está debaixo","de todos os céus é meu.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["“Não me calarei a respeito","das pernas do Leviatã,","nem da sua grande força,","nem da graça","da sua compostura."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Quem poderá tirar","a capa do seu dorso?","Ou lhe penetrará a dupla couraça?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Quem abriria as portas","de sua boca?","Pois em roda dos seus dentes","está o terror."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["As fileiras de suas escamas","são o seu orgulho,","cada uma bem-encostada","como por um selo","que as ajusta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["A tal ponto uma se junta à outra,","que entre elas não passa nem o ar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Elas se ligam umas às outras,","aderem entre si","e não podem ser separadas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Cada um dos seus espirros","faz resplandecer a luz,","e os seus olhos são como","os raios do amanhecer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Da sua boca saem tochas;","faíscas de fogo saltam dela."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Das suas narinas","procede fumaça,","como de uma panela fervente","sobre juncos em chama."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["O sopro dele acende o carvão;","da sua boca saem chamas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["No seu pescoço reside a força;","e diante dele salta o desespero."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Suas partes carnudas","são bem-pegadas entre si;","todas fundidas nele e imóveis."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["O coração dele","é duro como uma pedra,","firme como a pedra inferior","de um moinho."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Quando ele se levanta,","os valentes tremem;","quando ele irrompe,","ficam como que fora de si."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Se o golpe de espada o alcança,","isso não tem efeito algum,","e o mesmo vale para a lança,","o dardo ou a flecha."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Para ele, o ferro é como palha,","e o cobre, como pau podre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["As flechas não o fazem fugir;","para ele, as pedras das fundas","se transformam em palha."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Os porretes são para ele","como talos de capim;","quando agitam a lança,","ele dá risada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Debaixo do ventre","ele tem escamas pontiagudas;","arrasta-se sobre a lama,","como um instrumento","de debulhar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Leva as profundezas a ferver","como panela;","torna o mar","como caldeira de unguento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["Deixa atrás de si","um sulco luminoso,","como se o abismo","tivesse uma cabeleira branca."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["Na terra, não há ninguém","como ele,","pois foi feito para nunca ter medo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["O Leviatã olha com desprezo","tudo o que é alto;","é rei sobre todos os orgulhosos.”"],"rlw_lines":[]}]}}