{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"JOB","name":"Jó"},"chapter":{"chapter_usfm":"JOB.34","is_chapter":true,"previous":{"usfm":"JOB.33","human":"Jó 33","canonical":true,"toc":true},"current":{"usfm":"JOB.34","human":"Jó 34"},"next":{"usfm":"JOB.35","human":"Jó 35","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Segunda fala de Eliú"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Eliú disse mais:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["“Vocês que são sábios,","ouçam as minhas palavras;","vocês que são instruídos,","escutem o que vou dizer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Porque o ouvido","avalia as palavras,","assim como o paladar","prova a comida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Escolhamos para nós","o que é direito;","conheçamos entre nós","o que é bom.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Deus não perverte o direito"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["“Porque Jó disse: ‘Sou justo,","e Deus tirou o meu direito."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Apesar do meu direito,","sou considerado mentiroso;","a minha ferida é incurável,","embora não tenha cometido","nenhum pecado.’”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["“Será que existe outro homem","semelhante a Jó","que bebe a zombaria","como se fosse água?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Ele segue o caminho","dos que praticam a iniquidade","e anda com homens perversos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Pois disse: ‘De nada adianta","ao homem","ter o seu prazer em Deus.’”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["“Por isso, vocês que têm","entendimento, me escutem:","longe de Deus o praticar ele","a maldade,","e longe do Todo-Poderoso","o cometer injustiça."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Pois Deus retribui ao homem","segundo as suas obras","e paga a cada um","conforme o seu caminho."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Na verdade,","Deus não pratica o mal;","o Todo-Poderoso","não perverte o direito."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Quem lhe entregou","o governo da terra?","Quem lhe confiou o universo?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Se Deus pensasse","apenas em si mesmo","e fizesse voltar para si","o seu espírito e o seu sopro,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["toda a humanidade morreria","ao mesmo tempo,","e o homem voltaria para o pó.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Deus é justo e poderoso"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["“Portanto, se você","tem entendimento, escute isto;","dê ouvidos ao som","das minhas palavras."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Se Deus odiasse o direito,","será que poderia governar?","E será que você quer condenar","aquele que é justo e poderoso?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Será que alguém diria a um rei:","‘Você não vale nada!’?","Ou diria aos príncipes:","‘Seus perversos!’?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Quanto menos dirá isso","àquele que não privilegia","os príncipes,","e que não favorece","o rico em prejuízo do pobre;","porque todos","são obra de suas mãos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["De repente, morrem;","no meio da noite, as pessoas","são abaladas e passam,","e os poderosos são levados","por uma força invisível."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Os olhos de Deus estão","sobre os caminhos do homem","e veem todos os seus passos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Não há trevas nem sombra","profunda o bastante,","onde os que praticam a iniquidade","possam se esconder."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Pois Deus não precisa observar","o homem por muito tempo","antes de o fazer comparecer","em juízo diante dele."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Deus arrasa os poderosos,","sem os inquirir,","e põe outros em seu lugar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Porque ele conhece","as obras deles;","de noite, os transtorna","e eles são esmagados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Ele os castiga","como se fossem ímpios,","à vista de todos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["porque se afastaram de Deus,","e não quiseram compreender","nenhum de seus caminhos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["e assim fizeram com que","o grito dos pobres","subisse até Deus,","e este ouviu o lamento dos aflitos.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["“Se ele se calar,","quem o condenará?","Se encobrir o rosto,","quem poderá vê-lo?","Mas ele está acima dos povos","e das pessoas,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["para que o ímpio não reine,","e não haja quem iluda o povo.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Você prometeu parar de praticar injustiça?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["“Se alguém se dirige a Deus,","dizendo:","‘Sofri, não vou pecar mais;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["ensina-me o que","não consigo ver;","se cometi injustiça,","jamais voltarei a praticá-la’,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["será que Deus deve","recompensá-lo segundo","o que você quer ou não quer?","Será que ele deve dizer:","‘Escolha você, e não eu;","diga o que você sabe; fale’?”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["“Os homens que têm","entendimento me responderão,","o sábio que me ouve dirá:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["‘Jó falou sem conhecimento,","e nas palavras dele","não há sabedoria.’"],"rlw_lines":[]},{"type":"verse","verse_numbers":[36],"lines":["Quem dera Jó","fosse provado até o fim,","porque ele respondeu","como homem iníquo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[37],"lines":["Pois ao seu pecado","acrescenta rebelião;","entre nós, em tom de zombaria,","bate palmas","e multiplica as suas palavras","contra Deus.”"],"rlw_lines":[]}]}}