    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Terceira fala de Bildade"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Pode o homem ser justo diante de Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Bildade, o suíta, tomou a palavra e disse:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“A Deus pertence o domínio",
          "e o poder;",
          "ele faz reinar a paz",
          "nas alturas celestes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Será que é possível contar",
          "os seus exércitos?",
          "E sobre quem não se levanta",
          "a sua luz?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Como pode o mortal ser justo",
          "diante de Deus?",
          "E como pode ser puro",
          "aquele que nasce de mulher?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eis que até a lua não tem brilho,",
          "e as estrelas não são puras",
          "aos olhos dele."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quanto menos o homem,",
          "que é larva,",
          "e o filho do homem, que é verme!”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
