    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A corrupção moral de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ai de mim!",
          "Porque estou como quando",
          "são colhidas as frutas do verão,",
          "como quando se procuram uvas",
          "depois da vindima:",
          "não há cacho de uvas para chupar,",
          "nem figos temporãos",
          "que eu gostaria de comer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Desapareceram da terra",
          "os piedosos,",
          "e não há entre todos",
          "um só que seja reto.",
          "Todos ficam à espreita",
          "para derramar sangue;",
          "cada um caça o seu irmão",
          "com rede."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "As suas mãos são hábeis",
          "na prática do mal.",
          "As autoridades exigem,",
          "os juízes aceitam suborno,",
          "os poderosos manifestam",
          "os seus maus desejos",
          "e, assim, em conjunto",
          "tramam os seus projetos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O melhor deles",
          "é como um espinheiro;",
          "o mais reto é pior",
          "do que uma cerca de espinhos.",
          "É chegado o dia anunciado",
          "por suas sentinelas,",
          "o dia em que vocês",
          "serão castigados;",
          "agora começará a confusão deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Não acredite em seu amigo,",
          "nem confie no seu companheiro.",
          "Não compartilhe os seus segredos",
          "nem mesmo com a sua mulher."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque o filho despreza o pai,",
          "a filha se levanta contra a mãe,",
          "a nora, contra a sogra;",
          "os inimigos de uma pessoa",
          "são os da sua própria casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Eu, porém, olharei para o Senhor",
          "e esperarei no Deus",
          "da minha salvação;",
          "o meu Deus me ouvirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus se compadece de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Minha inimiga, não se alegre",
          "a respeito de mim;",
          "ainda que tenha caído,",
          "eu tornarei a me levantar;",
          "se morar nas trevas,",
          "o Senhor será a minha luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Sofrerei a ira do Senhor,",
          "porque pequei contra ele,",
          "até que julgue a minha causa",
          "e execute o meu direito;",
          "ele me levará para a luz,",
          "e eu verei a sua justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A minha inimiga verá isso;",
          "ficará coberta de vergonha",
          "aquela que me disse:",
          "“Onde está o Senhor, seu Deus?”",
          "Os meus olhos a contemplarão;",
          "agora ela será pisada",
          "como a lama das ruas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "No dia da reedificação",
          "das suas muralhas, ó Jerusalém,",
          "nesse dia, os seus limites",
          "serão ampliados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Nesse dia, virão a você",
          "desde a Assíria até o Egito,",
          "e do Egito até o Eufrates,",
          "e do mar até o mar,",
          "e da montanha até a montanha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mas a terra se tornará em desolação,",
          "por causa dos seus moradores,",
          "por causa do fruto das suas ações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ó Senhor, apascenta o teu povo",
          "com o teu bordão,",
          "o rebanho da tua herança,",
          "que mora a sós numa floresta,",
          "no meio da terra fértil;",
          "que ele seja apascentado",
          "em Basã e Gileade,",
          "como nos dias da antiguidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eu lhe mostrarei maravilhas,",
          "como nos dias em que você saiu",
          "da terra do Egito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "As nações verão isso",
          "e se envergonharão",
          "de todo o seu poder;",
          "porão a mão sobre a boca,",
          "e os seus ouvidos ficarão surdos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Lamberão o pó como serpentes;",
          "como animais que se arrastam",
          "pelo chão,",
          "tremendo, sairão dos seus esconderijos",
          "e, tremendo, virão ao Senhor,",
          "nosso Deus;",
          "e terão medo de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Quem é semelhante a ti, ó Deus,",
          "que perdoas a iniquidade",
          "e te esqueces da transgressão",
          "do remanescente",
          "da tua herança?",
          "O Senhor não retém",
          "a sua ira para sempre,",
          "porque tem prazer",
          "na misericórdia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ele voltará a ter",
          "compaixão de nós;",
          "pisará aos pés",
          "as nossas iniquidades",
          "e lançará todos os nossos pecados",
          "nas profundezas do mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Mostrarás a Jacó a fidelidade",
          "e a Abraão, a misericórdia,",
          "as quais juraste aos nossos pais,",
          "desde os dias antigos."
        ],
        "rlw_lines": []
      }
    ]
  },
