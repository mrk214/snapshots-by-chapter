    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Uso dos provérbios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Provérbios de Salomão,",
          "filho de Davi, rei de Israel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "para aprender a sabedoria",
          "e o ensino;",
          "para entender as palavras",
          "de inteligência;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "para obter o ensino",
          "do bom proceder,",
          "a justiça, o juízo e a equidade;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "para dar prudência aos simples",
          "e conhecimento e discernimento",
          "aos jovens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que o sábio ouça",
          "e cresça em prudência;",
          "e que o instruído adquira",
          "habilidade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "para entender provérbios",
          "e parábolas,",
          "as palavras e os enigmas",
          "dos sábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O temor do Senhor",
          "é o princípio do saber,",
          "mas os insensatos desprezam",
          "a sabedoria e o ensino."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contra as seduções dos pecadores"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Meu filho, ouça o ensino",
          "de seu pai",
          "e não despreze a instrução",
          "de sua mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque serão um diadema",
          "de graça para a sua cabeça",
          "e colares para o seu pescoço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Meu filho, se os pecadores",
          "quiserem seduzir você,",
          "não consinta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Talvez eles digam:",
          "“Venha conosco!",
          "Vamos preparar uma emboscada",
          "para matar alguém;",
          "vamos espreitar os inocentes,",
          "ainda que sem motivo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Vamos engoli-los vivos,",
          "como o mundo dos mortos,",
          "e inteiros, como",
          "os que descem ao abismo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Acharemos todo tipo",
          "de bens preciosos;",
          "encheremos a nossa casa",
          "de despojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Junte-se a nós!",
          "Teremos todos uma só bolsa.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Meu filho, não se ponha",
          "a caminho com eles;",
          "fique com os seus pés",
          "longe das suas veredas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque os pés deles",
          "correm para o mal",
          "e se apressam a derramar sangue."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pois em vão se estende a rede",
          "se a ave estiver olhando;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "mas estes armam emboscadas",
          "contra o seu próprio sangue",
          "e ficam à espreita",
          "contra a própria vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Este é o fim de todo ganancioso;",
          "e este espírito de ganância",
          "tira a vida de quem o possui."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O convite da Sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "A Sabedoria grita nas ruas;",
          "nas praças, levanta a sua voz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Do alto das muralhas clama,",
          "à entrada dos portões",
          "e nas cidades",
          "profere as suas palavras:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“Até quando vocês, ingênuos,",
          "amarão a ingenuidade?",
          "E vocês, zombadores, até quando",
          "terão prazer na zombaria?",
          "E vocês, tolos, até quando",
          "odiarão o conhecimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Deem ouvidos",
          "à minha repreensão;",
          "eis que derramarei",
          "o meu espírito sobre vocês",
          "e lhes darei a conhecer",
          "as minhas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Mas porque clamei,",
          "e vocês se recusaram a ouvir;",
          "porque estendi a minha mão,",
          "e não houve quem atendesse;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "— pelo contrário, rejeitaram",
          "todo o meu conselho",
          "e não quiseram",
          "a minha repreensão —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "também eu darei risada",
          "da desgraça de vocês;",
          "ficarei zombando",
          "quando chegar o terror,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "quando o terror chegar",
          "como a tormenta,",
          "quando a calamidade chegar",
          "como o redemoinho,",
          "quando lhes sobrevierem",
          "o aperto e a angústia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Então eles me invocarão,",
          "mas eu não responderei;",
          "sairão à minha procura,",
          "porém não me encontrarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Porque odiaram o conhecimento",
          "e não preferiram",
          "o temor do Senhor;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "não quiseram o meu conselho",
          "e desprezaram",
          "toda a minha repreensão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Portanto, comerão do fruto",
          "da sua conduta",
          "e dos seus próprios conselhos",
          "se fartarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Os ingênuos são mortos",
          "porque se desviam",
          "da sabedoria;",
          "os tolos são destruídos",
          "por estarem satisfeitos",
          "consigo mesmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Mas o que me der ouvidos",
          "habitará seguro,",
          "tranquilo e sem temor do mal.”"
        ],
        "rlw_lines": []
      }
    ]
  },
