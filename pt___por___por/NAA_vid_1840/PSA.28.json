    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica e ações de graças"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A ti clamo, ó Senhor;",
          "rocha minha, não sejas surdo",
          "para comigo;",
          "porque, se te calares",
          "quanto a mim,",
          "serei semelhante",
          "aos que descem à cova."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ouve a voz das minhas súplicas,",
          "quando a ti clamar por socorro,",
          "quando erguer as mãos",
          "para o teu santuário."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não me arrastes com os ímpios,",
          "com os que praticam a iniquidade.",
          "Eles falam de paz ao seu próximo,",
          "porém no coração",
          "têm perversidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Paga-lhes segundo as suas obras,",
          "segundo a maldade dos seus atos.",
          "Dá-lhes conforme a obra",
          "de suas mãos,",
          "retribui-lhes o que merecem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "E, visto que não compreendem",
          "os feitos do Senhor,",
          "nem o que as suas mãos fazem,",
          "ele os derrubará",
          "e não os reedificará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Bendito seja o Senhor,",
          "porque ouviu a voz",
          "das minhas súplicas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor é a minha força",
          "e o meu escudo;",
          "nele o meu coração confia,",
          "nele fui socorrido;",
          "por isso, o meu coração exulta,",
          "e com o meu cântico o louvarei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O Senhor é a força do seu povo,",
          "o refúgio salvador do seu ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Salva o teu povo",
          "e abençoa a tua herança;",
          "apascenta-os",
          "e exalta-os para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
