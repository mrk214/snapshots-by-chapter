{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.83","is_chapter":true,"previous":{"usfm":"PSA.82","human":"Salmos 82","canonical":true,"toc":true},"current":{"usfm":"PSA.83","human":"Salmos 83"},"next":{"usfm":"PSA.84","human":"Salmos 84","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Julgamento de Deus contra as nações inimigas"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["Cântico. Salmo de Asafe"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Ó Deus, não te cales!","Não te emudeças,","nem fiques inativo, ó Deus!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Os teus inimigos se alvoroçam,","e os que te odeiam","levantam a cabeça."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Tramam astutamente","contra o teu povo","e conspiram","contra os teus protegidos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Eles dizem:","“Venham, vamos riscá-los","da lista dos povos!","E que ninguém mais se lembre","do nome de Israel!”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Pois tramam de comum acordo","e firmam aliança contra ti."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["São as tendas de Edom","e os ismaelitas,","Moabe e os hagarenos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Gebal, Amom e Amaleque,","a Filístia com os habitantes de Tiro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Também a Assíria se alia com eles,","e se constituem braço forte","aos filhos de Ló."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Faze com eles","como fizeste com Midiã,","como fizeste com Sísera","e com Jabim","no ribeiro de Quisom;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["eles foram destruídos em En-Dor","e se tornaram adubo para a terra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Sejam os seus nobres","como Orebe e como Zeebe,","e os seus príncipes,","como Zeba e como Salmuna,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["que disseram:","“Vamos nos apoderar","das habitações de Deus.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Deus meu, faze-os como folhas","impelidas por um redemoinho,","como a palha que o vento leva."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Como o fogo devora um bosque","e as chamas incendeiam os montes,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["assim persegue-os","com a tua tempestade","e amedronta-os","com o teu vendaval."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Cobre o rosto deles de vergonha,","para que busquem","o teu nome, Senhor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Sejam envergonhados","e confundidos para sempre;","que pereçam","em completa desgraça."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Então reconhecerão que só tu,","cujo nome é Senhor,","és o Altíssimo sobre toda a terra."],"rlw_lines":[]}]}}