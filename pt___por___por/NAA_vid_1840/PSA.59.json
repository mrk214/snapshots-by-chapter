    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica por libertação"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “Não destruas”. Hino de Davi, quando Saul mandou que lhe vigiassem a casa, para o matar"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Livra-me, Deus meu,",
          "dos meus inimigos;",
          "põe-me fora do alcance",
          "dos meus adversários."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Livra-me dos que praticam",
          "a iniquidade",
          "e salva-me",
          "dos homens sanguinários."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois eis que armam ciladas",
          "à minha alma;",
          "contra mim se reúnem os fortes,",
          "sem que eu tenha cometido",
          "qualquer transgressão",
          "ou pecado, ó Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sem culpa minha,",
          "eles se apressam",
          "para me atacar;",
          "desperta, vem ao meu encontro",
          "e vê."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu, Senhor, Deus dos Exércitos,",
          "és o Deus de Israel;",
          "desperta, pois, e castiga",
          "todas as nações;",
          "não te compadeças de nenhum",
          "dos que traiçoeiramente",
          "praticam a iniquidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ao anoitecer, uivam como cães,",
          "à volta da cidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Proferem ameaças;",
          "em seus lábios há espadas.",
          "Pois dizem: “Quem vai ouvir?”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas tu, Senhor, vais rir deles;",
          "zombarás de todas as nações."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Em ti, força minha, esperarei;",
          "pois Deus é meu alto refúgio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Meu Deus virá ao meu encontro",
          "com a sua misericórdia,",
          "Deus me fará ver",
          "a derrota dos meus inimigos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Não os mates, para que",
          "o meu povo não se esqueça;",
          "dispersa-os pelo teu poder",
          "e abate-os,",
          "ó Senhor, escudo nosso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Pelo pecado de sua boca,",
          "pelas palavras dos seus lábios,",
          "na sua própria soberba",
          "sejam enredados",
          "e pelas maldições",
          "e mentiras que proferem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Consome-os com indignação,",
          "consome-os,",
          "para que deixem de existir",
          "e se saiba que Deus reina em Jacó,",
          "até os confins da terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ao anoitecer, uivam como cães,",
          "à volta da cidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Vagueiam à procura de comida",
          "e, se não se fartam, então rosnam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Eu, porém, cantarei a tua força;",
          "pela manhã louvarei com alegria",
          "a tua misericórdia,",
          "pois tu me tens sido alto refúgio",
          "e proteção no dia",
          "da minha angústia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A ti, força minha,",
          "cantarei louvores,",
          "porque Deus é meu alto refúgio,",
          "é o Deus da minha misericórdia."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
