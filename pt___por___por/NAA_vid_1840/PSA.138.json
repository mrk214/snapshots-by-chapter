    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Gratidão a Deus por sua fidelidade"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu te darei graças, Senhor,",
          "de todo o meu coração;",
          "na presença dos poderosos",
          "te cantarei louvores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Voltado para o teu santo templo,",
          "eu me prostrarei",
          "e louvarei o teu nome,",
          "por causa da tua misericórdia",
          "e da tua verdade,",
          "pois engrandeceste acima de tudo",
          "o teu nome e a tua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No dia em que eu clamei,",
          "tu me respondeste",
          "e alentaste a força",
          "de minha alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todos os reis da terra",
          "te louvarão, Senhor,",
          "quando ouvirem",
          "as palavras da tua boca,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "e cantarão",
          "os caminhos do Senhor,",
          "pois grande é a glória do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor é excelso, contudo,",
          "atenta para os humildes;",
          "os soberbos,",
          "ele os conhece de longe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Se ando em meio à angústia,",
          "tu me refazes a vida;",
          "estendes a mão contra a ira",
          "dos meus inimigos;",
          "a tua mão direita me salva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O que diz respeito a mim",
          "o Senhor levará a bom termo;",
          "a tua misericórdia, ó Senhor,",
          "dura para sempre;",
          "não desampares",
          "as obras das tuas mãos."
        ],
        "rlw_lines": []
      }
    ]
  },
