    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O cântico de Débora"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Naquele dia Débora e Baraque, filho de Abinoão, cantaram assim:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Porque os chefes se puseram",
          "à frente de Israel,",
          "e o povo se ofereceu",
          "voluntariamente,",
          "bendigam o Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Escutem, ó reis!",
          "Ouçam, ó príncipes!",
          "Eu, eu mesma cantarei",
          "ao Senhor;",
          "salmodiarei ao Senhor,",
          "Deus de Israel.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Quando tu, ó Senhor,",
          "saíste de Seir,",
          "marchando desde o campo",
          "de Edom,",
          "a terra estremeceu;",
          "os céus gotejaram,",
          "sim, até as nuvens gotejaram água."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os montes tremeram",
          "diante do Senhor,",
          "e até o Sinai, diante do Senhor,",
          "Deus de Israel.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Nos dias de Sangar,",
          "filho de Anate,",
          "nos dias de Jael,",
          "cessaram as caravanas;",
          "e os viajantes tomavam",
          "desvios tortuosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ficaram desertas",
          "as aldeias em Israel,",
          "ficaram desertas até que eu,",
          "Débora, me levantei;",
          "levantei-me por mãe em Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Escolheram-se deuses novos;",
          "então a guerra estava às portas;",
          "não se via escudo nem lança",
          "entre quarenta mil em Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Meu coração está",
          "com os comandantes de Israel,",
          "que, voluntariamente,",
          "se ofereceram entre o povo.",
          "Bendigam o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Vocês que cavalgam",
          "jumentas brancas,",
          "que se assentam em juízo",
          "e que andam pelo caminho,",
          "falem disto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "À música dos distribuidores",
          "de água,",
          "lá entre os canais dos rebanhos,",
          "falem dos atos de justiça",
          "do Senhor,",
          "das justiças a favor",
          "de suas aldeias em Israel.",
          "Então o povo do Senhor pôde",
          "descer aos portões da cidade.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Desperte, Débora, desperte!",
          "Desperte, acorde,",
          "entoe um cântico!",
          "Levante-se, Baraque,",
          "filho de Abinoão,",
          "e leve presos os que o prenderam.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Então desceu",
          "o restante dos nobres,",
          "o povo do Senhor em meu auxílio",
          "contra os poderosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "De Efraim, cujas raízes estão",
          "na antiga região de Amaleque,",
          "desceram guerreiros;",
          "depois de você, ó Débora,",
          "seguiu Benjamim com seus povos;",
          "de Maquir desceram comandantes,",
          "e, de Zebulom, os que levam",
          "a vara de comando."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Também os príncipes de Issacar",
          "foram com Débora;",
          "Issacar seguiu Baraque,",
          "em cujas pegadas",
          "foi enviado para o vale.",
          "Entre as facções de Rúben",
          "houve grande discussão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por que vocês ficaram",
          "entre os currais",
          "para ouvir a flauta?",
          "Entre as facções de Rúben",
          "houve grande discussão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Gileade ficou",
          "do outro lado do Jordão,",
          "e Dã, por que se deteve",
          "junto a seus navios?",
          "Aser ficou junto à costa do mar",
          "e repousou nas suas baías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Zebulom é povo",
          "que arriscou a sua vida,",
          "bem como Naftali,",
          "nas alturas do campo.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "“Vieram reis e lutaram.",
          "Os reis de Canaã lutaram",
          "em Taanaque,",
          "junto às águas de Megido,",
          "mas não levaram",
          "nenhum despojo de prata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Lá do céu as estrelas lutaram;",
          "desde os lugares dos seus cursos",
          "lutaram contra Sísera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "O ribeiro de Quisom os arrastou,",
          "Quisom, o antigo ribeiro.",
          "Avante, ó minha alma, firme!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Então os cascos dos cavalos",
          "socavam pelo galopar,",
          "o galopar dos seus guerreiros.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "“Amaldiçoem Meroz,",
          "diz o Anjo do Senhor,",
          "amaldiçoem duramente",
          "os seus moradores,",
          "porque não vieram",
          "em socorro do Senhor,",
          "em socorro do Senhor",
          "e seus heróis.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "“Que a mais bendita",
          "entre as mulheres seja Jael,",
          "mulher de Héber, o queneu;",
          "que seja a mais bendita",
          "entre as mulheres",
          "que vivem em tendas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Sísera pediu água,",
          "e ela lhe deu leite;",
          "em taça de príncipes",
          "lhe ofereceu nata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Ela estendeu uma das mãos",
          "e apanhou a estaca,",
          "e, com a mão direita,",
          "pegou o martelo",
          "dos trabalhadores.",
          "Golpeou Sísera,",
          "rachou-lhe a cabeça,",
          "furou e atravessou-lhe",
          "as têmporas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Aos pés dela ele se encurvou,",
          "caiu e ficou estirado;",
          "a seus pés se encurvou e caiu;",
          "onde se encurvou, ali caiu morto.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "“A mãe de Sísera",
          "olhava pela janela",
          "e exclamava pela grade:",
          "‘Por que tarda em vir o seu carro?",
          "Por que se demoram",
          "os passos dos seus cavalos?’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "As mais sábias das suas damas",
          "respondem,",
          "e até ela a si mesma respondia:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "‘Não é verdade que acharam",
          "e estão repartindo os despojos?",
          "Uma ou duas moças",
          "para cada homem;",
          "tecidos de várias cores para Sísera,",
          "tecidos de várias cores",
          "de bordados;",
          "um ou dois tecidos bordados,",
          "para o pescoço da esposa.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "“Assim, ó Senhor, pereçam",
          "todos os teus inimigos!",
          "Porém os que te amam",
          "brilhem como o sol",
          "quando se levanta",
          "no seu esplendor.”",
          "E a terra ficou em paz durante quarenta anos."
        ],
        "rlw_lines": []
      }
    ]
  },
