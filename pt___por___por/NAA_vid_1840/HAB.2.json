{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"HAB","name":"Habacuque"},"chapter":{"chapter_usfm":"HAB.2","is_chapter":true,"previous":{"usfm":"HAB.1","human":"Habacuque 1","canonical":true,"toc":true},"current":{"usfm":"HAB.2","human":"Habacuque 2"},"next":{"usfm":"HAB.3","human":"Habacuque 3","canonical":true,"toc":true},"items":[{"type":"verse","verse_numbers":[1],"lines":["Estarei na minha torre de vigia,","ficarei na fortaleza","e vigiarei para ver","o que Deus me dirá","e que resposta eu terei","à minha queixa."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Nova resposta de Deus"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["O Senhor me respondeu e disse:","“Escreva a visão,","torne-a bem legível sobre tábuas,","para que possa ser lida","até por quem passa correndo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Porque a visão ainda está","para se cumprir","no tempo determinado;","ela se apressa para o fim","e não falhará.","Mesmo que pareça demorar,","espere,","porque certamente virá;","não tardará.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["“Eis que a sua alma","está orgulhosa!","A sua alma não é reta nele;","mas o justo viverá pela sua fé."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Assim como o vinho é enganoso,","também o arrogante","não se contém.","O seu apetite é como a sepultura;","ele é como a morte,","que nunca se farta.","Ele ajunta para si todas as nações","e congrega todos os povos.”"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Cinco ais sobre os caldeus"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Não é fato que todos esses povos proferirão contra ele um provérbio, um dito em tom de zombaria? Eles dirão:","“Ai daquele que acumula","o que não é seu","— até quando? —,","e daquele que se enche","de coisas penhoradas!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Será que não se levantarão","de repente contra você","os seus credores?","E não despertarão aqueles","que farão você tremer?","Você lhes servirá de despojo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Visto que você despojou","muitas nações,","todos os povos que restaram","virão despojá-lo.","Porque você derramou","muito sangue","e cometeu violência contra a terra,","contra as cidades","e contra todos os seus moradores.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["“Ai daquele que ajunta","em sua casa","bens mal-adquiridos,","para pôr o seu ninho","num lugar bem alto,","a fim de livrar-se","das garras do mal!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Os seus planos resultarão","em vergonha para a sua casa.","Ao destruir muitos povos,","você pecou contra a sua própria vida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Porque as pedras das paredes","clamarão contra você,","e as vigas do madeiramento","farão eco.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["“Ai daquele que edifica","uma cidade com sangue","e a fundamenta na iniquidade!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Será que não é a vontade","do Senhor dos Exércitos","que os povos trabalhem","para o fogo","e que as nações se fatiguem","em vão?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Porque a terra se encherá","do conhecimento","da glória do Senhor,","como as águas cobrem o mar.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["“Ai daquele que dá","ao seu companheiro","vinho misturado com o seu furor,","e que o embebeda","para lhe contemplar a nudez!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Você ficará coberto de vergonha","em vez de honra.","Beba você também","e mostre a sua incircuncisão!","Chegará a sua vez de pegar o cálice","da mão direita do Senhor,","e a sua glória se transformará","em vergonha."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Porque a violência","contra o Líbano","cairá sobre você,","e você ficará apavorado","por ter destruído os animais.","Porque você derramou","muito sangue","e cometeu violência contra a terra,","contra as cidades","e contra todos os seus moradores.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["“Para que serve o ídolo,","visto que o seu artífice o esculpiu?","E de que serve a","imagem de fundição,","mestra de mentiras,","para que o artífice","confie na sua obra,","fazendo ídolos mudos?”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["“Ai daquele que diz à madeira:","‘Acorde!’","E à pedra muda: ‘Levante-se!’","Pode o ídolo ensinar?","Eis que está coberto de ouro","e de prata,","mas, no seu interior,","não há fôlego nenhum."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["O Senhor, porém,","está no seu santo templo;","cale-se diante dele toda a terra.”"],"rlw_lines":[]}]}}