{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PRO","name":"Provérbios"},"chapter":{"chapter_usfm":"PRO.5","is_chapter":true,"previous":{"usfm":"PRO.4","human":"Provérbios 4","canonical":true,"toc":true},"current":{"usfm":"PRO.5","human":"Provérbios 5"},"next":{"usfm":"PRO.6","human":"Provérbios 6","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Advertência contra a imoralidade"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Meu filho, dê atenção","à minha sabedoria;","incline os ouvidos","à minha inteligência,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["para que você conserve","o discernimento,","e para que os seus lábios guardem","o conhecimento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Porque os lábios","da mulher imoral destilam mel,","e as suas palavras são mais suaves","do que o azeite;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["mas o seu fim é amargo como fel,","e cortante como uma espada","de dois gumes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Os seus pés descem","para a morte;","os seus passos conduzem","ao inferno."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Ela não faz plana","a vereda da vida;","anda errante nos seus caminhos","e não o sabe."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["E agora, meu filho,","escute o que eu digo","e não se desvie","das palavras da minha boca."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Afaste o seu caminho","dessa mulher;","não se aproxime","da porta da casa dela,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["para que você não dê a outros","a sua honra,","nem a sua vida a homens cruéis;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["para que os estranhos","não se fartem dos seus bens,","e o fruto do seu trabalho","não acabe em casa alheia."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["No fim de sua vida","você ficará gemendo,","quando a sua carne e o seu corpo","se consumirem."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Então você dirá: “Como foi","que eu pude odiar o ensino?","E por que o meu coração","desprezou a disciplina?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Não escutei a voz","dos que me ensinavam,","nem dei ouvidos","aos meus mestres!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Quase caí em ruína completa","no meio da congregação reunida.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Beba a água","da sua própria cisterna","e das correntes do seu poço."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Por que você derramaria","as suas fontes lá fora,","e os seus ribeiros de água","pelas praças?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Que sejam para você somente","e não para os estranhos","que estão com você."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Seja bendito o seu manancial,","e alegre-se com a mulher","da sua mocidade,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["corça amorosa e gazela graciosa.","Que os seios dela saciem você","em todo o tempo;","embriague-se sempre","com as suas carícias."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Meu filho, por que você andaria","cego atrás de uma estranha","e abraçaria os seios de outra?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Porque os caminhos do homem","estão diante dos olhos do Senhor,","e ele considera","todas as suas veredas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Quanto ao ímpio,","as suas iniquidades","o prenderão,","e com as cordas do seu pecado","será detido."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Ele morrerá","pela falta de disciplina,","e, pelo excesso de sua loucura,","sai cambaleando por aí."],"rlw_lines":[]}]}}