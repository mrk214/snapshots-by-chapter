    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A poderosa voz de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deem ao Senhor,",
          "ó filhos de Deus,",
          "deem ao Senhor glória e força."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deem ao Senhor",
          "a glória devida ao seu nome,",
          "adorem o Senhor",
          "na beleza da sua santidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ouve-se a voz do Senhor",
          "sobre as águas;",
          "o Deus da glória troveja;",
          "o Senhor está",
          "sobre as muitas águas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A voz do Senhor é poderosa;",
          "a voz do Senhor",
          "é cheia de majestade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A voz do Senhor",
          "quebra os cedros;",
          "sim, o Senhor despedaça",
          "os cedros do Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ele faz o Líbano saltar",
          "como um bezerro,",
          "e o monte Hermom pular",
          "como um boi selvagem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A voz do Senhor",
          "produz chamas de fogo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A voz do Senhor",
          "faz tremer o deserto;",
          "o Senhor faz tremer",
          "o deserto de Cades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A voz do Senhor",
          "faz dar cria às corças",
          "e desnuda os bosques;",
          "e no seu templo",
          "todos dizem: “Glória!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O Senhor governa os dilúvios;",
          "como rei, o Senhor governa",
          "para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor dá força ao seu povo,",
          "o Senhor abençoa o seu povo",
          "com paz."
        ],
        "rlw_lines": []
      }
    ]
  },
