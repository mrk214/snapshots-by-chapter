    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confiança em Deus na angústia"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, com instrumentos de cordas. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Responde-me quando clamo,",
          "ó Deus da minha justiça;",
          "na angústia, tu me deste alívio;",
          "tem misericórdia de mim",
          "e ouve a minha oração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Filhos dos homens, até quando",
          "vocês vão querer transformar",
          "a minha glória em vergonha?",
          "Até quando amarão a vaidade",
          "e buscarão a mentira?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Saibam, porém, que o Senhor",
          "distingue para si o piedoso;",
          "o Senhor me ouve",
          "quando eu clamo por ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tremam de medo e não pequem;",
          "consultem no travesseiro o coração",
          "e sosseguem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ofereçam sacrifícios de justiça",
          "e confiem no Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Há muitos que dizem:",
          "“Quem nos dará",
          "a conhecer o bem?”",
          "Senhor, levanta sobre nós",
          "a luz do teu rosto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mais alegria me puseste",
          "no coração",
          "do que a alegria deles,",
          "quando eles têm fartura",
          "de cereal e de vinho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Em paz me deito",
          "e logo pego no sono,",
          "porque só tu, Senhor,",
          "me fazes repousar seguro."
        ],
        "rlw_lines": []
      }
    ]
  },
