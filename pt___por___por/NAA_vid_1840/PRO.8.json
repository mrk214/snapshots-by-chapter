    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A excelência da Sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Por acaso, não clama",
          "a Sabedoria?",
          "E o Entendimento",
          "não faz ouvir a sua voz?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "A Sabedoria se coloca no topo",
          "dos lugares elevados,",
          "junto ao caminho,",
          "nas encruzilhadas das veredas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Junto aos portões,",
          "à entrada da cidade,",
          "à entrada dos portões",
          "ela está gritando:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“É para vocês, homens,",
          "que eu clamo;",
          "e a minha voz se dirige",
          "aos filhos dos homens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Vocês, ingênuos,",
          "entendam a prudência;",
          "e vocês, tolos,",
          "entendam a sabedoria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Escutem, pois falarei",
          "coisas excelentes;",
          "os meus lábios dirão",
          "o que é reto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque a minha boca",
          "proclamará a verdade;",
          "os meus lábios",
          "detestam a maldade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Todas as palavras da minha boca",
          "são justas;",
          "não há nelas nenhuma coisa torta,",
          "nem perversa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Todas são retas",
          "para os que têm compreensão",
          "e justas, para os que acham",
          "o conhecimento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Aceitem o meu ensino,",
          "em vez da prata,",
          "e o conhecimento,",
          "em lugar do ouro escolhido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque a sabedoria",
          "é melhor do que as joias,",
          "e tudo o que se possa desejar",
          "não se compara com ela.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Eu, a Sabedoria,",
          "moro com a prudência",
          "e disponho de conhecimento",
          "e de conselhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O temor do Senhor consiste",
          "em odiar o mal.",
          "Eu odeio a soberba, a arrogância,",
          "o mau caminho e a boca",
          "que fala coisas perversas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Meu é o conselho",
          "e a verdadeira sabedoria;",
          "eu sou o Entendimento,",
          "minha é a fortaleza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por meio de mim",
          "os reis governam,",
          "e os príncipes decretam justiça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por meio de mim",
          "governam os príncipes,",
          "os nobres e todos os juízes",
          "da terra.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Eu amo os que me amam;",
          "os que me procuram",
          "me encontram."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Riquezas e honra estão comigo,",
          "bens duráveis e justiça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "O meu fruto é melhor",
          "do que o ouro,",
          "do que o ouro refinado;",
          "e o meu rendimento é maior",
          "do que a prata escolhida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Ando pelo caminho da justiça",
          "e sigo as veredas do juízo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "para dotar de bens os que me amam",
          "e encher os seus tesouros.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A eternidade da Sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“O Senhor me possuía",
          "no início da sua obra,",
          "antes das suas obras mais antigas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Fui estabelecida",
          "desde a eternidade,",
          "desde o princípio,",
          "antes do começo da terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Nasci antes de haver abismos,",
          "quando ainda não havia fontes",
          "carregadas de águas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Antes que os montes",
          "fossem firmados,",
          "antes de haver colinas, eu nasci."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Deus ainda não tinha feito",
          "a terra, nem os seus campos,",
          "nem sequer o princípio",
          "do pó do mundo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Eu estava lá",
          "quando ele preparava os céus,",
          "quando traçava o horizonte",
          "sobre a face do abismo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Estava lá quando ele firmava",
          "as nuvens de cima,",
          "quando estabelecia",
          "as fontes do abismo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "quando fixava ao mar",
          "os seus limites,",
          "para que as águas",
          "não transgredissem",
          "a sua ordem.",
          "Quando ele compunha",
          "os fundamentos da terra,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "eu estava com ele",
          "e era o seu arquiteto.",
          "Dia após dia eu era a sua alegria,",
          "divertindo-me em todo o tempo",
          "na sua presença,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "divertindo-me",
          "no seu mundo habitável",
          "e achando alegria",
          "junto aos filhos dos homens.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "“Agora, meus filhos,",
          "escutem o que eu digo,",
          "porque felizes são os que guardam",
          "os meus caminhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Ouçam o ensino, sejam sábios",
          "e não o rejeitem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Feliz é aquele que me ouve,",
          "vigiando dia após dia",
          "diante das minhas portas,",
          "esperando na entrada",
          "da minha casa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Pois quem me encontra",
          "encontra a vida",
          "e alcança favor do Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Mas quem peca contra mim",
          "violenta a própria alma.",
          "Todos os que me odeiam",
          "amam a morte.”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
