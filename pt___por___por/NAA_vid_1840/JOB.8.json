    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primeira fala de Bildade"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Busque a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Bildade, o suíta, tomou a palavra e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Até quando você falará",
          "estas coisas?",
          "E até quando as palavras",
          "da sua boca serão",
          "como um vento impetuoso?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Será que Deus",
          "perverteria o direito?",
          "Será que o Todo-Poderoso",
          "perverteria a justiça?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Se os seus filhos",
          "pecaram contra ele,",
          "também ele os entregou ao poder",
          "da transgressão que cometeram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mas, se você buscar a Deus",
          "e pedir misericórdia",
          "ao Todo-Poderoso,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "se você for puro e reto,",
          "ele, sem demora,",
          "despertará para ajudá-lo",
          "e restaurará a justiça",
          "da sua morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O seu primeiro estado",
          "parecerá pequeno",
          "comparado com a grandeza",
          "do seu último estado.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "A esperança dos ímpios perecerá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Por favor, pergunte agora",
          "aos que são",
          "de gerações passadas",
          "e atente para a experiência",
          "dos pais deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque nós somos de ontem",
          "e nada sabemos;",
          "pois os nossos dias sobre a terra",
          "são como a sombra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Será que os pais",
          "não o ensinarão,",
          "falando com você?",
          "Será que do próprio entendimento",
          "não proferirão estas palavras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "‘Pode o papiro crescer",
          "fora do pântano?",
          "Ou cresce o junco sem água?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Quando estão verdes,",
          "e ainda não foram colhidos,",
          "secam antes de qualquer",
          "outra erva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "São assim as veredas de todos",
          "os que se esquecem de Deus;",
          "e a esperança dos ímpios perecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "A sua firmeza será frustrada,",
          "e a sua confiança é teia de aranha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ele se encosta em sua casa,",
          "mas ela não resiste;",
          "agarra-se a ela,",
          "mas ela não fica em pé.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "“Ele é viçoso diante do sol,",
          "e os seus renovos",
          "se espalham pelo jardim;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "as suas raízes se entrelaçam",
          "num montão de pedras",
          "e penetram até as muralhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Mas, se o arrancam do seu lugar,",
          "este o negará, dizendo:",
          "‘Eu nunca vi você.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Eis no que deu a sua vida!",
          "E do pó brotarão outros.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "“Eis que Deus não",
          "rejeita o íntegro,",
          "nem toma os malfeitores pela mão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Ele encherá a sua boca de riso",
          "e os seus lábios de alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Os que o odeiam",
          "se cobrirão de vergonha,",
          "e a tenda dos ímpios",
          "não subsistirá.”"
        ],
        "rlw_lines": []
      }
    ]
  },
