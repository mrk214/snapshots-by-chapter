    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus abençoará Judá e Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Peçam ao Senhor chuva",
          "no tempo das últimas chuvas;",
          "peçam ao Senhor,",
          "que faz as nuvens de chuva,",
          "e ele lhes dará chuva abundante",
          "e a cada um,",
          "a vegetação no campo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque os ídolos do lar",
          "falam coisas vãs",
          "e os adivinhos veem mentiras",
          "e contam sonhos enganadores;",
          "oferecem consolações vazias.",
          "Por isso, o povo anda",
          "como ovelhas,",
          "aflito por não ter pastor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“É contra os pastores",
          "que se acendeu a minha ira;",
          "castigarei os bodes",
          "que vão adiante do rebanho.",
          "Mas o Senhor dos Exércitos cuidará",
          "do seu rebanho, a casa de Judá,",
          "e fará dela o seu majestoso cavalo",
          "na batalha."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "De Judá sairá a pedra angular;",
          "dele, a estaca da tenda;",
          "dele, o arco de guerra;",
          "dele sairão todos os chefes juntos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "E serão como valentes",
          "que, na batalha,",
          "pisam aos pés os seus inimigos",
          "na lama das ruas.",
          "Lutarão, porque o Senhor",
          "está com eles,",
          "e envergonharão os que andam",
          "montados em cavalos.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Fortalecerei a casa de Judá",
          "e salvarei a casa de José.",
          "Eu os farei voltar,",
          "porque me compadeço deles;",
          "e serão como se eu",
          "não os tivesse rejeitado,",
          "porque eu sou o Senhor,",
          "seu Deus, e os ouvirei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os de Efraim serão",
          "como um valente,",
          "e o seu coração se alegrará",
          "como se tivessem bebido vinho;",
          "os seus filhos verão isso",
          "e se alegrarão;",
          "o seu coração exultará no Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eu lhes assobiarei e os reunirei,",
          "porque já os remi;",
          "eles se multiplicarão",
          "como antes",
          "tinham se multiplicado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Embora eu os tenha espalhado",
          "entre os povos,",
          "eles se lembram de mim",
          "em lugares distantes;",
          "continuarão vivos",
          "com os seus filhos e voltarão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque eu os farei voltar",
          "da terra do Egito",
          "e os congregarei da Assíria.",
          "Eu os trarei à terra de Gileade",
          "e ao Líbano,",
          "e não haverá lugar para todos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Passarão pelo mar de angústia,",
          "serão feridas as ondas do mar,",
          "e todas as profundezas do Nilo",
          "se secarão.",
          "Então será derrubado",
          "o orgulho da Assíria,",
          "e o cetro do Egito será removido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eu os fortalecerei no Senhor,",
          "e eles andarão no meu nome”,",
          "diz o Senhor."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
