    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Darei livre curso à minha queixa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Estou cansado de viver.",
          "Darei livre curso à minha queixa,",
          "falarei na amargura da minha alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pedirei a Deus:",
          "‘Não me condenes!’",
          "Faze-me saber",
          "o que tens contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Será que tens prazer",
          "em me oprimir,",
          "em rejeitar a obra das tuas mãos",
          "e em favorecer",
          "o conselho dos ímpios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Por acaso, tens olhos de gente?",
          "Ou vês tu como vê uma pessoa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "São os teus dias",
          "como os dias de um mortal?",
          "Ou são os teus anos",
          "como os anos de um ser humano,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "para te informares",
          "da minha iniquidade",
          "e indagares o meu pecado?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Bem sabes",
          "que eu não sou culpado;",
          "todavia, não há ninguém que possa",
          "me livrar da tua mão.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Vais reduzir-me a pó?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“As tuas mãos me plasmaram",
          "e me fizeram,",
          "porém, agora, queres destruir-me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Lembra-te de que me formaste",
          "como em barro.",
          "E, agora, queres",
          "reduzir-me a pó?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por acaso, não me derramaste",
          "como leite",
          "e não me coalhaste como queijo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "De pele e carne me vestiste",
          "e de ossos e tendões me teceste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Tu me deste vida e bondade,",
          "e o teu cuidado guardou",
          "o meu espírito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mas ocultaste estas coisas",
          "no teu coração;",
          "e agora sei",
          "que este era o teu plano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Se eu pecar, tu me observas;",
          "e da minha iniquidade",
          "não me perdoarás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Se for iníquo, ai de mim!",
          "E, se for justo,",
          "não ouso levantar a cabeça,",
          "pois estou envergonhado",
          "e olho para a minha miséria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque, se levanto a cabeça,",
          "tu me caças como um leão feroz",
          "e de novo revelas",
          "o teu poder maravilhoso",
          "contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Renovas contra mim",
          "as tuas testemunhas",
          "e multiplicas contra mim a tua ira;",
          "males e lutas se sucedem",
          "contra mim.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Ó Deus, deixa-me em paz!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "“Por que me tiraste",
          "do ventre de minha mãe?",
          "Eu deveria ter morrido",
          "antes que um olho me visse!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Teria sido como alguém",
          "que nunca existiu",
          "e já do ventre teria sido levado",
          "à sepultura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Não são poucos os meus dias?",
          "Cessa, pois, e deixa-me em paz,",
          "para que por um pouco",
          "eu tome alento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "antes que eu vá para o lugar",
          "do qual não voltarei,",
          "para a terra das trevas",
          "e da sombra da morte,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "terra de escuridão,",
          "de trevas profundas,",
          "terra da sombra da morte",
          "e do caos,",
          "onde a própria luz",
          "é como a escuridão.”"
        ],
        "rlw_lines": []
      }
    ]
  },
