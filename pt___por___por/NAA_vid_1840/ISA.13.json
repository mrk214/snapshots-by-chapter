    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Profecia contra a Babilônia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Sentença contra a Babilônia que Isaías, filho de Amoz, recebeu numa visão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sobre um monte escalvado,",
          "levantem um estandarte.",
          "Ergam a voz para eles,",
          "acenem com a mão,",
          "para que entrem",
          "pelos portões dos príncipes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Eu dei ordens",
          "aos meus consagrados,",
          "sim, chamei os meus valentes,",
          "os que exultam",
          "com a minha majestade,",
          "para que executem a minha ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Já se ouve sobre os montes",
          "um rumor como o de",
          "uma grande multidão,",
          "o clamor de reinos",
          "e de nações já congregados.",
          "O Senhor dos Exércitos reúne",
          "as tropas de guerra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eles vêm de um país remoto,",
          "desde a extremidade dos céus:",
          "é o Senhor e os instrumentos",
          "da sua indignação,",
          "para destruir toda a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Lamentem, pois o Dia do Senhor",
          "está perto;",
          "ele vem como destruição",
          "da parte do Todo-Poderoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Por isso, todas as mãos",
          "desfalecerão,",
          "e o coração de todos",
          "se derreterá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ficarão apavorados;",
          "angústia e dores",
          "tomarão conta deles,",
          "e se contorcerão qual mulher",
          "que está dando à luz.",
          "Olharão espantados",
          "uns para os outros,",
          "com os rostos da cor do fogo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Eis que vem o Dia do Senhor,",
          "dia cruel, com ira e ardente furor,",
          "para fazer da terra uma desolação",
          "e exterminar dela os pecadores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque as estrelas",
          "e constelações dos céus",
          "não darão a sua luz;",
          "o sol, logo ao nascer, se escurecerá,",
          "e a lua não fará resplandecer",
          "a sua luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Castigarei o mundo",
          "por causa da sua maldade,",
          "e os perversos,",
          "por causa da sua iniquidade.",
          "Farei cessar",
          "a arrogância dos atrevidos",
          "e abaterei o orgulho dos violentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Farei com que as pessoas",
          "sejam mais escassas",
          "do que o ouro puro,",
          "mais raras do que o ouro de Ofir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Portanto, farei estremecer",
          "os céus,",
          "e a terra será sacudida do seu lugar,",
          "por causa da ira",
          "do Senhor dos Exércitos",
          "e por causa do dia",
          "do seu ardente furor.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Cada um será como a gazela",
          "que foge",
          "e como o rebanho",
          "que ninguém recolhe;",
          "cada um voltará para o seu povo",
          "e cada um fugirá para a sua terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Quem for achado",
          "será traspassado,",
          "e aquele que for apanhado",
          "será morto à espada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "As crianças serão esmagadas",
          "diante dos olhos deles;",
          "as casas serão saqueadas,",
          "e as mulheres deles, violentadas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Eis que contra os babilônios",
          "eu despertarei os medos,",
          "que não farão caso de prata,",
          "nem se alegrarão com ouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "As suas flechas matarão os jovens;",
          "eles não se compadecerão",
          "dos recém-nascidos,",
          "e os seus olhos",
          "não pouparão as crianças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Babilônia, a joia dos reinos,",
          "glória e orgulho dos caldeus,",
          "será como Sodoma e Gomorra,",
          "quando Deus as destruiu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Nunca mais será habitada,",
          "ninguém morará nela",
          "de geração em geração.",
          "Os árabes não armarão ali",
          "as suas tendas,",
          "e os pastores não levarão",
          "para lá os seus rebanhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Porém, nela, os animais",
          "do deserto repousarão,",
          "e as suas casas",
          "se encherão de corujas.",
          "Ali habitarão os avestruzes,",
          "e os bodes selvagens pularão ali."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "As hienas uivarão",
          "nos seus castelos;",
          "os chacais,",
          "nos seus palácios de prazer.",
          "A hora da Babilônia está chegando,",
          "e os seus dias",
          "não serão prolongados.”"
        ],
        "rlw_lines": []
      }
    ]
  },
