    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração de confiança em Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “A pomba nos terebintos distantes”. Hino de Davi, quando os filisteus o prenderam em Gate"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Tem misericórdia de mim, ó Deus,",
          "porque os homens",
          "querem me destruir;",
          "todo o dia eles me oprimem",
          "e lutam contra mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Os meus inimigos sempre",
          "querem me destruir;",
          "são muitos os que atrevidamente",
          "me combatem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quando eu ficar com medo,",
          "hei de confiar em ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Em Deus, cuja palavra eu exalto,",
          "neste Deus ponho",
          "a minha confiança",
          "e nada temerei.",
          "Que me pode fazer um mortal?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Todo o dia",
          "torcem as minhas palavras;",
          "os seus pensamentos são todos",
          "contra mim para o mal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ajuntam-se, escondem-se,",
          "espionam os meus passos,",
          "como aguardando a hora",
          "de me tirarem a vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dá-lhes a retribuição",
          "segundo a sua iniquidade.",
          "Derruba os povos, ó Deus,",
          "na tua ira!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Contaste os meus passos",
          "quando sofri perseguições.",
          "Recolhe as minhas lágrimas",
          "no teu odre;",
          "não estão elas inscritas",
          "no teu livro?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "No dia em que eu te invocar,",
          "os meus inimigos",
          "baterão em retirada.",
          "Uma coisa eu sei:",
          "que Deus é por mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Em Deus, cuja palavra eu louvo,",
          "no Senhor, cuja palavra eu louvo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "neste Deus ponho",
          "a minha confiança",
          "e nada temerei.",
          "Que me pode fazer",
          "um simples ser humano?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Os votos que fiz,",
          "eu os manterei, ó Deus;",
          "trarei as ofertas",
          "de ações de graças."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pois da morte livraste",
          "a minha alma,",
          "sim, livraste da queda os meus pés,",
          "para que eu ande",
          "na presença de Deus,",
          "na luz da vida."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
