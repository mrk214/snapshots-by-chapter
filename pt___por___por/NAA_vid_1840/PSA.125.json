    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Fé inabalável"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de peregrinação"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Os que confiam no Senhor",
          "são como o monte Sião,",
          "que não se abala,",
          "mas continua firme",
          "para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como em volta de Jerusalém",
          "estão os montes,",
          "assim o Senhor está",
          "ao redor do seu povo,",
          "desde agora e para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O cetro dos ímpios",
          "não permanecerá",
          "na terra dos justos,",
          "para que os justos não comecem",
          "a praticar a iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Faze o bem, Senhor,",
          "aos bons e aos retos de coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quanto aos que se desviam",
          "para caminhos tortuosos,",
          "o Senhor os levará",
          "juntamente com os malfeitores.",
          "Paz sobre Israel!"
        ],
        "rlw_lines": []
      }
    ]
  },
