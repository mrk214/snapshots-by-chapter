    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Os pecados de Jerusalém e de Judá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deem uma volta",
          "pelas ruas de Jerusalém,",
          "olhem, investiguem,",
          "procurem nas suas praças",
          "para ver se acham alguém,",
          "se há uma pessoa",
          "que pratique a justiça",
          "ou busque a verdade.",
          "Se acharem, eu perdoarei a cidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Embora digam: “Tão certo",
          "como vive o Senhor”,",
          "certamente juram falso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Senhor, por acaso os teus olhos",
          "não atentam para a fidelidade?",
          "Tu feriste esse povo,",
          "mas eles não sentiram nada;",
          "tu os consumiste,",
          "mas eles não quiseram",
          "aceitar a disciplina;",
          "endureceram o rosto",
          "mais do que uma rocha;",
          "não quiseram voltar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mas eu pensei:",
          "“São apenas pobres insensatos,",
          "pois não conhecem",
          "o caminho do Senhor,",
          "o direito do seu Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Irei aos poderosos",
          "e falarei com eles,",
          "porque eles sabem",
          "o caminho do Senhor,",
          "o direito do seu Deus.”",
          "Mas todos eles quebraram o jugo",
          "e romperam as algemas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por isso, um leão do bosque",
          "os matará,",
          "um lobo dos desertos",
          "os despedaçará,",
          "um leopardo estará à espreita",
          "das suas cidades.",
          "Quem sair das cidades",
          "será devorado;",
          "porque as transgressões deles",
          "são muitas,",
          "e as suas rebeldias",
          "se multiplicaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Jerusalém, como posso",
          "perdoá-la?",
          "Os seus filhos me abandonaram",
          "e juram pelos que não são deuses.",
          "Depois de eu ter-lhes",
          "saciado a fome,",
          "adulteraram e se reuniram",
          "em casas de prostitutas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como garanhões bem fartos",
          "e cheios de desejo,",
          "cada um fica rinchando",
          "para a mulher do seu próximo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Deixaria eu de castigar",
          "estas coisas?” —",
          "diz o Senhor.",
          "“Não deveria eu me vingar",
          "de uma nação como esta?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Que os inimigos passem",
          "pelas carreiras da vinha",
          "e a destruam,",
          "porém não por completo;",
          "tirem os ramos,",
          "porque não são do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque a casa de Israel",
          "e a casa de Judá",
          "foram totalmente infiéis a mim”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Negaram o Senhor e disseram:",
          "“Não é ele. Nenhum mal",
          "nos sobrevirá;",
          "não veremos a guerra",
          "nem passaremos fome.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Os profetas não passam de vento,",
          "porque a palavra",
          "não está com eles;",
          "as suas ameaças se cumprirão",
          "contra eles mesmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Portanto, o Senhor,",
          "o Deus dos Exércitos, me disse:",
          "“Visto que eles proferiram",
          "tais palavras,",
          "eis que transformarei em fogo",
          "as minhas palavras na sua boca",
          "e farei deste povo a lenha;",
          "e o fogo os consumirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eis que trago contra você",
          "uma nação de longe,",
          "ó casa de Israel”,",
          "diz o Senhor;",
          "“nação robusta, nação antiga,",
          "nação cuja língua",
          "você não conhece;",
          "e cuja fala você não entende."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "A aljava deles",
          "é como uma sepultura aberta;",
          "todos os seus homens são valentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Devorarão as colheitas",
          "e o pão de vocês,",
          "devorarão os seus filhos",
          "e as suas filhas;",
          "comerão as suas ovelhas",
          "e o seu gado;",
          "comerão os frutos das suas videiras",
          "e figueiras;",
          "e com a espada derrubarão",
          "as cidades fortificadas",
          "em que vocês confiam.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "— Porém, mesmo naqueles dias, diz o Senhor, não os destruirei completamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Quando perguntarem: “Por que o Senhor, nosso Deus, nos fez todas essas coisas?”, você lhes responderá: “Vocês me abandonaram e serviram a deuses estranhos na terra de vocês. Por isso, terão de servir a estrangeiros numa terra que não é de vocês.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus avisa o seu povo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Anunciem isto na casa de Jacó",
          "e façam uma proclamação em Judá,",
          "dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "“Escute agora isto, povo tolo",
          "e sem entendimento,",
          "vocês que têm olhos e não veem,",
          "têm ouvidos e não ouvem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Por que não me temem?” —",
          "diz o Senhor.",
          "“Por que não tremem",
          "diante de mim?",
          "Pois fui eu que pus a areia",
          "como limite do mar,",
          "limite perpétuo,",
          "que ele não irá ultrapassar.",
          "Ainda que se levantem",
          "as suas ondas,",
          "elas não prevalecerão;",
          "ainda que bramem,",
          "não passarão daquele limite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Mas este povo tem um coração",
          "teimoso e rebelde;",
          "desviaram-se e se foram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Em seu coração não dizem:",
          "‘Temamos agora o Senhor,",
          "nosso Deus,",
          "que nos dá a seu tempo as chuvas,",
          "as primeiras e as últimas,",
          "e que nos reserva as semanas",
          "determinadas da colheita.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "As maldades que vocês fizeram",
          "desviaram essas coisas boas,",
          "e os seus pecados afastaram",
          "de vocês o bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Porque no meio do meu povo",
          "se encontram ímpios,",
          "que andam espiando,",
          "como espreitam os passarinheiros.",
          "Como eles, preparam armadilhas",
          "e prendem os homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Como uma gaiola",
          "cheia de pássaros,",
          "assim as casas deles estão",
          "cheias de fraude;",
          "por isso, se tornaram poderosos",
          "e enriqueceram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Engordaram, ficaram estufados",
          "e não há limite",
          "para as suas maldades.",
          "Não julgam a causa dos órfãos,",
          "para que ela prospere,",
          "nem defendem o direito",
          "dos necessitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Deixaria eu de castigar",
          "estas coisas?” —",
          "diz o Senhor.",
          "“Não deveria eu me vingar",
          "de uma nação como esta?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Coisa espantosa e horrenda",
          "se anda fazendo na terra:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "os profetas profetizam",
          "falsamente,",
          "e os sacerdotes dominam",
          "de mãos dadas com eles.",
          "E é o que o meu povo deseja.",
          "Porém o que é que vocês farão",
          "quando o fim chegar?"
        ],
        "rlw_lines": []
      }
    ]
  },
