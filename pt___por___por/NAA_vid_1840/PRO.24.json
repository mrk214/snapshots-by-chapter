    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 19 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Não tenha inveja dos maus",
          "nem queira estar com eles,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "porque o coração deles",
          "planeja a violência,",
          "e os seus lábios falam para ferir."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 20 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Com a sabedoria",
          "se constrói a casa,",
          "e com a inteligência ela se firma;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "pelo conhecimento",
          "os seus cômodos",
          "se encherão",
          "de todo tipo de bens,",
          "preciosos e agradáveis."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 21 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem é sábio é forte,",
          "e aquele que tem conhecimento",
          "consolida a sua força."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque com prudência",
          "você deve fazer a guerra;",
          "na multidão de conselheiros",
          "está a vitória."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 22 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A sabedoria é elevada demais",
          "para o insensato;",
          "no tribunal, ele não abre a boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 23 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Quem só pensa em fazer o mal",
          "será chamado",
          "“mestre de intrigas”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os planos do tolo são pecado,",
          "e o zombador é abominável",
          "às pessoas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 24 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Se você se mostra fraco",
          "no dia da angústia,",
          "é porque a sua força é pequena."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 25 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Liberte os que estão sendo",
          "levados para a morte",
          "e salve os que cambaleiam",
          "ao ser levados para a matança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Você poderá dizer:",
          "“Não sabíamos de nada!”",
          "Mas será que aquele",
          "que pesa os corações",
          "não o perceberá?",
          "Aquele que atenta para a sua alma",
          "não ficará sabendo?",
          "E não pagará ele a cada um",
          "segundo as suas obras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 26 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Meu filho, coma mel,",
          "porque é saudável,",
          "e o favo, porque é doce",
          "ao seu paladar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Saiba que assim é a sabedoria",
          "para a sua alma.",
          "Se você a encontrar,",
          "haverá um futuro,",
          "e a sua esperança",
          "não será frustrada."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 27 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Não espie a habitação do justo,",
          "ó perverso,",
          "nem destrua o lugar",
          "do seu repouso,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "porque sete vezes cairá o justo",
          "e se levantará;",
          "mas os perversos são derrubados",
          "pela calamidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 28 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Quando o seu inimigo cair,",
          "não se alegre,",
          "nem se regozije o seu coração",
          "quando ele tropeçar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "para que o Senhor não veja isso",
          "e se desagrade,",
          "e desvie do inimigo a sua ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 29 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Não se irrite",
          "por causa dos malfeitores,",
          "nem tenha inveja dos ímpios,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "porque os maus",
          "não terão futuro,",
          "e a lâmpada dos ímpios",
          "se apagará."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 30 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Meu filho,",
          "tema o Senhor e o rei;",
          "não se meta com os revoltosos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "porque de repente",
          "serão destruídos,",
          "e a ruína que virá do Senhor",
          "e do rei, quem a conhecerá?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Mais alguns provérbios dos sábios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Estes também são provérbios dos sábios.",
          "Parcialidade no julgamento",
          "não é bom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Quem disser ao ímpio:",
          "“Você é justo”",
          "será amaldiçoado pelos povos",
          "e detestado pelas nações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Mas haverá bem-estar",
          "para os que repreenderem",
          "o ímpio,",
          "e sobre eles virão grandes bênçãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Como beijo nos lábios,",
          "assim é a resposta com palavras sinceras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Cuide dos seus negócios lá fora,",
          "apronte a lavoura no campo",
          "e, depois, edifique a sua casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Não testemunhe sem motivo",
          "contra o seu próximo,",
          "nem o engane com os seus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Não diga: “Vou fazer com ele",
          "o mesmo que ele fez comigo;",
          "pagarei a cada um",
          "segundo as suas obras.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Passei pelo campo do preguiçoso",
          "e junto à vinha do homem",
          "sem juízo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Eis que tudo estava",
          "cheio de espinhos",
          "e coberto de urtigas;",
          "e o muro de pedra",
          "estava em ruínas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Ao contemplar aquilo,",
          "eu fiquei pensando;",
          "olhei, e tirei a seguinte lição:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Um pouco de sono,",
          "um breve cochilo,",
          "braços cruzados para descansar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "e a sua pobreza",
          "virá como um ladrão,",
          "a miséria atacará",
          "como um homem armado."
        ],
        "rlw_lines": []
      }
    ]
  },
