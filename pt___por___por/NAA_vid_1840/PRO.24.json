    "name": "Provérbios"
  },
  "chapter": {
    "chapter_usfm": "PRO.24",
    "is_chapter": true,
    "previous": {
      "usfm": "PRO.23",
      "human": "Provérbios 23"
    },
    "current": {
      "usfm": "PRO.24",
