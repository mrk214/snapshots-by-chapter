    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hino de louvor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Louvores de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu te exaltarei, ó Deus meu e Rei;",
          "bendirei o teu nome",
          "para todo o sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Todos os dias te bendirei",
          "e louvarei o teu nome",
          "para todo o sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Grande é o Senhor",
          "e mui digno de ser louvado;",
          "a sua grandeza é insondável."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Uma geração louvará",
          "à outra geração as tuas obras",
          "e anunciará",
          "os teus poderosos feitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Meditarei no glorioso esplendor",
          "da tua majestade",
          "e nas tuas maravilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Falarão do poder",
          "dos teus feitos tremendos,",
          "e eu anunciarei a tua grandeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Divulgarão a memória",
          "da tua imensa bondade",
          "e com júbilo celebrarão",
          "a tua justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Bondoso e compassivo é o Senhor,",
          "tardio em irar-se",
          "e grande em misericórdia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O Senhor é bom para todos,",
          "e as suas misericórdias permeiam",
          "todas as suas obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todas as tuas obras",
          "te renderão graças, Senhor;",
          "e os teus santos te bendirão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Falarão da glória do teu reino",
          "e confessarão o teu poder,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "para que os filhos dos homens",
          "conheçam",
          "os teus feitos poderosos",
          "e a glória da majestade",
          "do teu reino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O teu reino é um reino eterno,",
          "e o teu domínio subsiste",
          "por todas as gerações.",
          "O Senhor é fiel",
          "em todas as suas palavras",
          "e santo em todas as suas obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor sustém",
          "todos os que vacilam",
          "e levanta",
          "todos os que estão prostrados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Em ti esperam os olhos de todos,",
          "e tu, a seu tempo,",
          "lhes dás o alimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Abres a mão",
          "e satisfazes os desejos",
          "de todos os viventes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Justo é o Senhor em todos",
          "os seus caminhos,",
          "bondoso em todas as suas obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Perto está o Senhor",
          "de todos os que o invocam,",
          "de todos os que o invocam",
          "em verdade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ele satisfaz o desejo",
          "dos que o temem;",
          "ouve o seu clamor e os salva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O Senhor protege",
          "todos os que o amam;",
          "porém todos os ímpios",
          "serão exterminados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "A minha boca proclamará",
          "o louvor do Senhor.",
          "Que todos os seres vivos",
          "louvem o seu santo nome,",
          "para todo o sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
