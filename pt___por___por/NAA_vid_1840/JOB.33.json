    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Os meus lábios proferem o puro saber"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“E agora, Jó, escute",
          "os meus argumentos",
          "e dê ouvidos",
          "a todas as minhas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Passo agora a falar;",
          "em minha boca fala a língua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os meus argumentos provam",
          "a sinceridade do meu coração,",
          "e os meus lábios",
          "proferem o puro saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O Espírito de Deus me fez,",
          "e o sopro do Todo-Poderoso",
          "me dá vida.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Responda-me, se for capaz;",
          "prepare os seus argumentos",
          "e apresente-se diante de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eis que diante de Deus",
          "sou igual a você;",
          "também eu fui formado do barro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Por isso, não tenha medo",
          "de mim;",
          "a minha mão não será pesada",
          "sobre você.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Você disse que não tem iniquidade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Na verdade, você falou",
          "diante de mim;",
          "eu ouvi o som das suas palavras,",
          "dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "‘Estou limpo, sem transgressão;",
          "sou puro e não tenho iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eis que Deus procura",
          "pretextos contra mim",
          "e me considera seu inimigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Prendeu os meus pés",
          "com correntes",
          "e observa",
          "todas as minhas veredas.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus é maior do que o homem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Devo lhe dizer que nisto",
          "você não tem razão;",
          "porque Deus é maior",
          "do que o homem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Por que você discute com ele,",
          "afirmando que ele",
          "não presta contas",
          "de nenhum dos seus atos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pelo contrário, Deus fala",
          "de um modo,",
          "sim, de dois modos,",
          "mas o homem",
          "não atenta para isso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Em sonho ou em visão de noite,",
          "quando o sono profundo cai",
          "sobre as pessoas,",
          "quando adormecem na cama,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "então lhes abre os ouvidos",
          "e lhes sela a sua instrução,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "para afastar o ser humano",
          "dos seus planos",
          "e livrá-lo do orgulho;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "para guardar a sua alma da cova",
          "e a sua vida de passar",
          "pela espada.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus lhe restitui a sua justiça"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "“Também no seu leito",
          "é castigado com dores,",
          "com incessante conflito",
          "em seus ossos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "de modo que abomina o pão,",
          "e detesta até",
          "a comida mais saborosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "A sua carne, que se via,",
          "agora desaparece,",
          "e os seus ossos, que não se viam,",
          "agora aparecem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "A sua alma está perto da morte,",
          "e a sua vida se aproxima",
          "dos que trazem a morte.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "“Se com ele houver",
          "um anjo intercessor,",
          "um dos milhares,",
          "para declarar ao homem",
          "o que é certo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "então Deus",
          "terá misericórdia dele",
          "e dirá ao anjo:",
          "‘Livre-o, para que",
          "não desça à cova;",
          "já achei um resgate para ele.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Então a sua carne recupera",
          "o vigor da infância,",
          "e ele volta aos dias da juventude."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Ele ora a Deus,",
          "que se agrada dele;",
          "com alegria vê a face de Deus,",
          "e Deus lhe restitui a sua justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Depois, cantará",
          "diante de todos e dirá:",
          "‘Pequei, perverti o direito",
          "e não fui punido como merecia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Deus livrou a minha alma",
          "de ir para a cova,",
          "e a minha vida verá a luz.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "“Eis que Deus faz tudo isto",
          "duas e três vezes no seu trato",
          "com o ser humano,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "para reconduzir da cova",
          "a sua alma",
          "e iluminá-lo",
          "com a luz dos viventes.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "“Agora, Jó, preste atenção",
          "e escute o que vou dizer;",
          "fique calado, porque vou falar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Se você tem alguma coisa",
          "a dizer, diga;",
          "fale, porque gostaria",
          "de lhe dar razão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Se não, escute o que vou dizer;",
          "fique calado, e eu lhe ensinarei",
          "a sabedoria.”"
        ],
        "rlw_lines": []
      }
    ]
  },
