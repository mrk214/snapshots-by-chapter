    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus entrará em juízo com o seu povo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Escutem agora",
          "o que diz o Senhor:",
          "“Levante-se, defenda a sua causa",
          "diante dos montes,",
          "e que as colinas ouçam a sua voz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ó montes, escutem",
          "a controvérsia do Senhor,",
          "e vocês, duráveis fundamentos",
          "da terra,",
          "prestem atenção, porque o Senhor",
          "tem uma controvérsia",
          "com o seu povo",
          "e entrará em juízo com Israel.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“Meu povo,",
          "o que foi que eu lhe fiz?",
          "E como foi que eu",
          "o levei a ficar cansado?",
          "Responda!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pois eu o tirei da terra do Egito",
          "e o resgatei da casa da servidão,",
          "e enviei adiante de você",
          "Moisés, Arão e Miriã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Meu povo,",
          "lembre-se do que Balaque,",
          "rei de Moabe, havia planejado",
          "e do que Balaão, filho de Beor,",
          "lhe respondeu.",
          "Lembre-se também",
          "do que aconteceu",
          "desde Sitim até Gilgal,",
          "para que você conheça",
          "os atos de justiça do Senhor.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O que Deus exige"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Com que me apresentarei",
          "ao Senhor",
          "e me inclinarei diante",
          "do Deus excelso?",
          "Virei diante dele com holocaustos,",
          "com bezerros de um ano?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Será que o Senhor se agrada",
          "com milhares de carneiros,",
          "com dez mil ribeiros de azeite?",
          "Darei o meu primogênito",
          "pela minha transgressão,",
          "o fruto do meu corpo,",
          "pelo pecado da minha alma?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele já mostrou a você o que é bom;",
          "e o que o Senhor pede de você?",
          "Que pratique a justiça,",
          "ame a misericórdia",
          "e ande humildemente",
          "com o seu Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A injustiça terá seu castigo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A voz do Senhor",
          "se dirige à cidade,",
          "e é verdadeira sabedoria",
          "temer o seu nome.",
          "“Escutem, ó tribo",
          "e todos os moradores!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ainda se encontram,",
          "na casa dos ímpios,",
          "os tesouros da impiedade",
          "e a medida falsa que eu detesto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Poderei eu inocentar",
          "balanças desonestas",
          "e uma bolsa",
          "com pesos adulterados?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque os ricos da cidade",
          "estão cheios de violência;",
          "os seus habitantes falam mentiras",
          "e a língua deles é enganosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Assim, também",
          "eu passarei a feri-los",
          "e os destruirei",
          "por causa dos seus pecados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Vocês comerão,",
          "mas não ficarão satisfeitos;",
          "a fome continuará",
          "nas suas entranhas.",
          "Tentarão pôr os seus bens a salvo,",
          "mas não conseguirão preservá-los;",
          "e aquilo que preservarem,",
          "eu entregarei à espada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Vocês irão semear,",
          "mas não colherão nada;",
          "vocês esmagarão as azeitonas,",
          "mas não se ungirão com o azeite;",
          "pisarão as uvas,",
          "mas não beberão o vinho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Vocês observaram",
          "os estatutos de Onri",
          "e todas as obras da casa de Acabe",
          "e andaram nos conselhos deles.",
          "Por isso, farei de Jerusalém",
          "um lugar desolado,",
          "e dos seus moradores",
          "um objeto de vaias.",
          "E vocês terão de suportar",
          "a zombaria dos povos.”"
        ],
        "rlw_lines": []
      }
    ]
  },
