    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "Livro II"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "Salmos 42—72"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A alma suspira por Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo didático dos filhos de Corá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Assim como a corça suspira",
          "pelas correntes das águas,",
          "assim, por ti, ó Deus, suspira",
          "a minha alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "A minha alma tem sede de Deus,",
          "do Deus vivo.",
          "Quando irei e me apresentarei",
          "diante da face de Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "As minhas lágrimas têm sido",
          "o meu alimento dia e noite,",
          "enquanto me dizem",
          "continuamente:",
          "“E o seu Deus, onde está?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Lembro-me destas coisas —",
          "e dentro de mim",
          "se derrama a minha alma —,",
          "de como eu passava",
          "com a multidão de povo",
          "e os guiava em procissão",
          "à Casa de Deus,",
          "entre gritos de alegria e louvor,",
          "multidão em festa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Por que você está abatida,",
          "ó minha alma?",
          "Por que se perturba",
          "dentro de mim?",
          "Espere em Deus,",
          "pois ainda o louvarei,",
          "a ele, meu auxílio",
          "e Deus meu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sinto abatida dentro de mim",
          "a minha alma;",
          "lembro-me, portanto, de ti,",
          "nas terras do Jordão, no Hermom,",
          "e no monte Mizar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Um abismo chama outro abismo,",
          "ao ruído das tuas cachoeiras;",
          "todas as tuas ondas e vagas",
          "passaram sobre mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Contudo, o Senhor, durante o dia,",
          "me concede a sua misericórdia,",
          "e de noite está comigo",
          "o seu cântico,",
          "uma oração",
          "ao Deus da minha vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pergunto a Deus, minha rocha:",
          "“Por que te esqueceste de mim?",
          "Por que hei de andar",
          "eu lamentando",
          "sob a opressão",
          "dos meus inimigos?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os meus ossos se esmigalham,",
          "quando os meus adversários",
          "me insultam,",
          "perguntando sem parar:",
          "“E o seu Deus, onde está?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por que você está abatida,",
          "ó minha alma?",
          "Por que se perturba",
          "dentro de mim?",
          "Espere em Deus,",
          "pois ainda o louvarei,",
          "a ele, meu auxílio",
          "e Deus meu."
        ],
        "rlw_lines": []
      }
    ]
  },
