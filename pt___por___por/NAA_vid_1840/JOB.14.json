    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "A brevidade da vida"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“O ser humano, nascido de mulher,",
          "vive breve tempo,",
          "cheio de inquietação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nasce como a flor e murcha;",
          "foge como a sombra",
          "e não permanece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sobre ele abres os teus olhos?",
          "E me fazes entrar em juízo contigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Quem poderá tirar coisa pura",
          "daquilo que é impuro?",
          "Ninguém!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Visto que os dias do ser humano",
          "estão contados,",
          "o número dos seus meses",
          "está nas tuas mãos;",
          "traçaste limites além dos quais",
          "não passará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Desvia dele o teu olhar,",
          "para que tenha repouso,",
          "até que, como o trabalhador,",
          "tenha prazer no seu dia.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Porque há esperança",
          "para a árvore,",
          "pois, mesmo cortada,",
          "voltará a brotar,",
          "e não cessarão os seus rebentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Se as suas raízes",
          "envelhecerem na terra,",
          "e o seu tronco morrer no chão,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "ao cheiro das águas brotará",
          "e dará ramos como a planta nova."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mas, se alguém morre,",
          "fica prostrado;",
          "o ser humano expira e para onde vai?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Como as águas do lago",
          "evaporam,",
          "e o rio se esgota e seca,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "assim o ser humano se deita",
          "e não se levanta;",
          "enquanto existirem os céus,",
          "não acordará,",
          "nem será despertado do seu sono.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Eu esperarei a minha mudança"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Quem dera me escondesses",
          "na sepultura",
          "e me ocultasses",
          "até que a tua ira passasse!",
          "Quem dera me fixasses um prazo",
          "e depois te lembrasses de mim!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Quando alguém morre,",
          "será que volta a viver?",
          "Todos os dias da minha luta",
          "esperaria,",
          "até que viesse a minha mudança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Tu me chamarias,",
          "e eu te responderia;",
          "terias saudades",
          "da obra das tuas mãos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "e até contarias os meus passos",
          "e não levarias em conta",
          "os meus pecados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A minha transgressão",
          "estaria selada num saco,",
          "e terias encoberto",
          "as minhas iniquidades.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Tu destróis a esperança humana"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "“Mas como o monte",
          "que desmorona e se desfaz,",
          "e a rocha que se move",
          "do seu lugar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "como as águas gastam as pedras,",
          "e as cheias levam o pó da terra,",
          "assim destróis",
          "a esperança humana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Tu prevaleces para sempre",
          "contra o ser humano, e ele passa;",
          "mudas o semblante dele",
          "e o despedes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Os seus filhos recebem honras,",
          "e ele não sabe;",
          "são humilhados,",
          "e ele não percebe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ele sente as dores",
          "apenas de seu próprio corpo,",
          "e a sua alma lamenta",
          "apenas por si mesma.”"
        ],
        "rlw_lines": []
      }
    ]
  },
