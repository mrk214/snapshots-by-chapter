    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A visão de um cesto de frutos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O Senhor Deus também me mostrou o seguinte: um cesto de frutos de verão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "E perguntou:",
          "— O que você está vendo, Amós?",
          "E eu respondi:",
          "— Um cesto de frutos de verão.",
          "Então o Senhor me disse:",
          "“Chegou o fim para o meu povo",
          "de Israel;",
          "não posso mais ignorar",
          "o que fazem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Naquele dia”,",
          "diz o Senhor Deus,",
          "“os cânticos do templo",
          "serão gritos de dor.",
          "Muitos cadáveres!",
          "Cadáveres jogados por toda parte!",
          "Silêncio!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A ruína de Israel está perto"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ouçam isto, vocês que pisam",
          "os necessitados",
          "e destroem os miseráveis da terra,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "dizendo: “Quando passará",
          "a Festa da Lua Nova,",
          "para vendermos os cereais?",
          "E o sábado, para abrirmos",
          "os celeiros de trigo,",
          "diminuindo a quantidade,",
          "aumentando o peso",
          "e enganando com balanças",
          "desonestas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "para comprarmos os pobres",
          "por dinheiro",
          "e os necessitados",
          "por um par de sandálias",
          "e vendermos o refugo do trigo?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor jurou",
          "pela glória de Jacó, dizendo:",
          "“Nunca me esquecerei",
          "de nenhuma das suas obras!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por causa disto, será que",
          "a terra não vai tremer?",
          "E não estarão enlutados",
          "todos os seus moradores?",
          "Toda a terra se levantará",
          "como o Nilo,",
          "será agitada e abaixará",
          "como o rio do Egito.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“Naquele dia”,",
          "diz o Senhor Deus,",
          "“farei com que o sol",
          "se ponha ao meio-dia",
          "e com que a terra se cubra",
          "de trevas em pleno dia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Transformarei as suas festas",
          "em luto",
          "e todos os seus cânticos",
          "em lamentações.",
          "Vou fazer com que todos vistam",
          "roupas feitas de pano de saco",
          "e rapem a cabeça.",
          "Farei com que isso seja",
          "como luto por um filho único,",
          "luto cujo fim será",
          "como dia de amargura.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Eis que vêm dias”,",
          "diz o Senhor Deus,",
          "“em que enviarei sobre a terra",
          "fome — não de pão,",
          "e sede — não de água,",
          "mas de ouvir as palavras",
          "do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Andarão de mar a mar",
          "e do Norte até o Oriente;",
          "correrão por toda parte,",
          "procurando a palavra do Senhor,",
          "mas não a acharão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Naquele dia, as moças bonitas",
          "e os jovens desmaiarão de sede,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "os que agora juram",
          "pelo ídolo de Samaria",
          "e dizem: ‘Tão certo como vive",
          "o seu deus, ó Dã!’",
          "E: ‘Tão certo como vive",
          "o culto de Berseba!’",
          "Esses mesmos cairão",
          "e nunca mais se levantarão.”"
        ],
        "rlw_lines": []
      }
    ]
  },
