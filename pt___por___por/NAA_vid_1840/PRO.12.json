    "human": "Provérbios"
  },
  "chapter": {
    "usfm": "PRO.12",
    "human": "Provérbios 12",
    "previous": {
      "usfm": "PRO.11",
      "human": "Provérbios 11"
    },
    "next": {
      "usfm": "PRO.13",
      "human": "Provérbios 13"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quem ama a disciplina",
          "ama o conhecimento,",
          "mas o que odeia a repreensão",
          "é tolo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quem faz o bem",
          "alcança o favor do Senhor,",
          "mas aquele que tem más intenções,",
          "este o Senhor condena."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ninguém se estabelece",
          "pela maldade,",
          "mas a raiz dos justos",
          "não será removida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A mulher virtuosa",
          "é a coroa do seu marido,",
          "mas a que envergonha o marido",
          "é como podridão",
          "nos seus ossos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os pensamentos dos justos",
          "são retos;",
          "os conselhos dos ímpios são falsos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "As palavras dos ímpios",
          "são emboscadas",
          "para derramar sangue,",
          "mas a boca dos retos",
          "salva da morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os ímpios são derrubados",
          "e desaparecem,",
          "mas a casa dos justos",
          "permanecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Cada um será louvado",
          "segundo o seu entendimento,",
          "mas quem tem coração perverso",
          "será desprezado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Melhor é ser modesto",
          "e fazer o seu trabalho",
          "do que engrandecer a si mesmo",
          "e não ter o que comer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O justo cuida dos seus animais,",
          "mas o coração dos ímpios é cruel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O que lavra a sua terra",
          "terá pão em abundância,",
          "mas quem corre",
          "atrás de coisas sem valor",
          "não tem juízo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O ímpio quer viver",
          "do que caçam os maus,",
          "mas a raiz dos justos",
          "produz o seu fruto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Os maus se enredam",
          "na transgressão",
          "daquilo que falam,",
          "mas os justos escaparão",
          "da angústia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cada um se farta de bem",
          "pelo fruto daquilo que diz,",
          "e o que as suas mãos fizerem,",
          "isso receberá de volta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O caminho do insensato",
          "parece reto aos seus olhos,",
          "mas o sábio ouve os conselhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O insensato mostra logo",
          "a sua ira,",
          "mas o prudente ignora os insultos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Quem diz a verdade",
          "favorece a justiça,",
          "mas a testemunha falsa",
          "está a serviço da fraude."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Palavras precipitadas",
          "são como pontas de espada,",
          "mas as palavras dos sábios",
          "são remédio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Os lábios que falam a verdade",
          "permanecem para sempre,",
          "mas a língua mentirosa desaparece",
          "num instante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Há fraude no coração",
          "dos que planejam o mal,",
          "mas os que aconselham a paz",
          "têm alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Nenhuma desgraça",
          "sobrevirá ao justo,",
          "mas os ímpios,",
          "o mal os apanhará em cheio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "O Senhor detesta",
          "lábios mentirosos,",
          "mas aqueles que praticam",
          "a verdade são o seu prazer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Aquele que é prudente",
          "oculta o conhecimento,",
          "mas o coração dos insensatos",
          "proclama a tolice."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "O homem esforçado dominará,",
          "mas o preguiçoso ficará sujeito",
          "a trabalhos forçados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "A ansiedade no coração",
          "pode abater alguém,",
          "mas uma boa palavra traz alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "O justo serve de guia",
          "para o seu companheiro,",
          "mas o caminho dos ímpios os leva",
          "a andar errantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "O preguiçoso não assará",
          "a sua caça,",
          "mas o bem precioso do homem",
          "é ser esforçado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Na vereda da justiça está a vida,",
          "e neste caminho não há morte."
        ],
        "rlw_lines": []
      }
    ]
  },
