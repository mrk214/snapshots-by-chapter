    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resposta de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Eu também tenho entendimento"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Na verdade, vocês são o povo,",
          "e com vocês morrerá a sabedoria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mas eu também tenho",
          "entendimento;",
          "em nada sou inferior a vocês.",
          "Quem não sabe coisas como essas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eu sou motivo de riso",
          "para os meus amigos —",
          "eu, que invocava a Deus,",
          "e ele me respondia;",
          "o justo e o reto são motivo de riso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "No pensamento",
          "de quem está seguro",
          "há desprezo pela desgraça,",
          "um empurrão para aquele",
          "cujos pés já vacilam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os opressores têm paz",
          "em suas tendas,",
          "e os que provocam a Deus",
          "estão seguros;",
          "o deus deles é a sua própria força.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Os animais o ensinarão"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Mas pergunte agora aos animais,",
          "e cada um deles o ensinará;",
          "pergunte às aves do céu,",
          "e elas lhe contarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ou fale com a terra,",
          "e ela o instruirá;",
          "até os peixes do mar lhe contarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "De todos estes, quem não sabe",
          "que a mão do Senhor fez isto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Na sua mão está a vida",
          "de todos os seres vivos",
          "e o espírito de todo",
          "o gênero humano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por acaso, o ouvido",
          "não avalia as palavras,",
          "assim como o paladar",
          "prova as comidas?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Com Deus estão a sabedoria e a força"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Está a sabedoria com os idosos?",
          "Será que a longevidade",
          "traz o entendimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Com Deus estão a sabedoria",
          "e a força;",
          "ele tem conselho e entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O que ele derruba",
          "não pode ser reconstruído;",
          "se ele lança alguém na prisão,",
          "ninguém a pode abrir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Se ele retém as águas,",
          "elas secam;",
          "se ele as solta,",
          "elas devastam a terra.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "“Com ele estão a força",
          "e a sabedoria;",
          "a ele pertencem o enganado",
          "e o enganador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ele leva os conselheiros embora,",
          "descalços,",
          "e faz os juízes de tolos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Solta os laços",
          "que prendem os reis",
          "e amarra uma corda",
          "aos seus lombos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ele leva os sacerdotes embora,",
          "descalços,",
          "e transtorna os poderosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Deixa os conselheiros",
          "sem palavras",
          "e tira o entendimento dos anciãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Lança desprezo",
          "sobre os príncipes",
          "e afrouxa o cinto dos fortes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Das trevas revela",
          "coisas profundas",
          "e traz à luz a densa escuridão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Deus engrandece as nações",
          "e depois as destrói;",
          "dispersa-as e de novo as congrega."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Tira o entendimento",
          "dos chefes do povo da terra",
          "e os faz vaguear pelos desertos",
          "sem caminhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Nas trevas andam tateando,",
          "sem terem luz;",
          "ele os faz cambalear",
          "como bêbados.”"
        ],
        "rlw_lines": []
      }
    ]
  },
