    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primeira fala de Elifaz"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Chegou a sua vez de sofrer"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Elifaz, o temanita, tomou a palavra e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Se alguém tentar falar,",
          "você terá paciência para ouvir?",
          "Mas quem poderá conter",
          "as palavras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Veja bem! Você ensinou a muitos",
          "e fortaleceu mãos cansadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "As suas palavras sustentaram",
          "os que tropeçavam,",
          "e você fortaleceu",
          "joelhos vacilantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mas agora,",
          "quando chega a sua vez,",
          "você perde a paciência;",
          "ao ser atingido,",
          "você fica apavorado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Você não tem confiança",
          "no seu temor a Deus?",
          "Não tem esperança na integridade",
          "dos seus caminhos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pense bem: será que algum",
          "inocente já chegou a perecer?",
          "E onde os retos foram destruídos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Segundo eu tenho visto,",
          "os que lavram a iniquidade",
          "e semeiam o mal,",
          "isso mesmo eles colhem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Com o hálito de Deus perecem;",
          "e com o sopro da sua ira",
          "são consumidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cessa o bramido do leão",
          "e a voz do leão feroz,",
          "e os dentes dos leõezinhos",
          "são quebrados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O leão morre,",
          "porque não há presa,",
          "e os filhos da leoa",
          "andam dispersos.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Pode um mortal ser justo diante de Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Uma palavra me foi trazida",
          "em segredo,",
          "e os meus ouvidos perceberam",
          "um sussurro dela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Entre pensamentos",
          "de visões noturnas,",
          "quando o sono profundo",
          "cai sobre as pessoas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "sobrevieram-me",
          "o espanto e o tremor,",
          "e todos os meus ossos",
          "estremeceram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Então um espírito passou",
          "por diante de mim;",
          "e se arrepiaram os cabelos",
          "do meu corpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ele parou, mas não reconheci",
          "a sua aparência.",
          "Um vulto estava",
          "diante dos meus olhos;",
          "houve silêncio, e ouvi uma voz:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "‘Pode um mortal ser justo",
          "diante de Deus?",
          "Pode alguém ser puro",
          "diante do seu Criador?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Eis que Deus não confia",
          "nos seus servos",
          "e aos seus anjos",
          "atribui imperfeições;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "quanto mais àqueles",
          "que habitam em casas de barro,",
          "cujo fundamento está no pó,",
          "e que são esmagados",
          "como a traça!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Nascem de manhã",
          "e à tarde são destruídos;",
          "perecem para sempre,",
          "sem que ninguém",
          "se importe com isso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Se o fio da vida lhes é cortado,",
          "morrem e não alcançam",
          "a sabedoria.’”"
        ],
        "rlw_lines": []
      }
    ]
  },
