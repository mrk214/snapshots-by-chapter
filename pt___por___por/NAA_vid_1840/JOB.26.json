    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jó critica Bildade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Como você sabe ajudar",
          "o que não tem força!",
          "Como você sabe socorrer o braço",
          "que não tem vigor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Como você sabe aconselhar",
          "o que não tem sabedoria",
          "e revelar plenitude",
          "de verdadeiro conhecimento!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Com a ajuda de quem",
          "você profere tais palavras?",
          "E de quem é o espírito",
          "que fala em você?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Continuação da terceira fala de Bildade"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "A grandeza do poder de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Os mortos tremem",
          "debaixo das águas",
          "com os seus moradores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O mundo dos mortos",
          "está desnudo",
          "diante de Deus,",
          "e não há coberta para o abismo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele estende o norte sobre o vazio",
          "e faz a terra pairar sobre o nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Prende as águas",
          "em densas nuvens,",
          "e as nuvens não se rasgam",
          "debaixo delas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Encobre a face do seu trono",
          "e sobre ele estende a sua nuvem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Traçou um círculo",
          "sobre a superfície das águas,",
          "no limite entre a luz e as trevas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "As colunas do céu tremem",
          "e se espantam",
          "diante da sua ameaça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Com a sua força dominou o mar",
          "e com o seu entendimento",
          "despedaçou o monstro Raabe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pelo seu sopro o céu se aclarou,",
          "a sua mão feriu a serpente veloz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Eis que isto são apenas",
          "as bordas dos seus caminhos!",
          "Dele temos ouvido",
          "apenas um leve sussurro!",
          "Mas o trovão do seu poder,",
          "quem o entenderá?”"
        ],
        "rlw_lines": []
      }
    ]
  },
