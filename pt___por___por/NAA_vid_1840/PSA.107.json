    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "Livro V"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "Salmos 107—150"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus salva de todas as tribulações"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deem graças ao Senhor,",
          "porque ele é bom,",
          "e a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Digam-no os remidos do Senhor,",
          "os que ele resgatou",
          "da mão do inimigo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "e congregou dentre as terras,",
          "do Oriente e do Ocidente,",
          "do Norte e do Sul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Andaram errantes pelo deserto,",
          "por lugares áridos,",
          "sem achar cidade",
          "em que pudessem morar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Famintos e sedentos,",
          "desfalecia neles a alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Então, na sua angústia,",
          "clamaram ao Senhor,",
          "e ele os livrou das suas tribulações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Conduziu-os pelo caminho direito,",
          "para que fossem à cidade",
          "em que pudessem morar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Que eles deem graças ao Senhor",
          "por sua bondade",
          "e por suas maravilhas",
          "para com os filhos dos homens!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pois saciou a alma sedenta",
          "e encheu de bens a alma faminta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Alguns se assentaram nas trevas",
          "e nas sombras da morte,",
          "presos em aflição",
          "e em correntes de ferro,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "por terem se rebelado",
          "contra a palavra de Deus",
          "e desprezado",
          "o conselho do Altíssimo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "de modo que lhes abateu",
          "o coração com trabalhos —",
          "esses caíram, e não houve",
          "quem os socorresse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Então, na sua angústia,",
          "clamaram ao Senhor,",
          "e ele os livrou das suas tribulações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tirou-os das trevas",
          "e das sombras da morte",
          "e quebrou as correntes",
          "que os prendiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Que eles deem graças ao Senhor",
          "por sua bondade",
          "e por suas maravilhas",
          "para com os filhos dos homens!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pois derrubou",
          "as portas de bronze",
          "e despedaçou as trancas de ferro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os insensatos, por causa do seu",
          "caminho de transgressão",
          "e por causa das suas iniquidades,",
          "serão afligidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Abominaram",
          "todo tipo de comida,",
          "e chegaram às portas da morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Então, na sua angústia,",
          "clamaram ao Senhor,",
          "e ele os livrou das suas tribulações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Enviou-lhes a sua palavra,",
          "e os sarou,",
          "e os livrou do que lhes era mortal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Que eles deem graças ao Senhor",
          "por sua bondade",
          "e por suas maravilhas",
          "para com os filhos dos homens!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Que ofereçam sacrifícios",
          "de ações de graças",
          "e proclamem com júbilo",
          "as suas obras!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Os que, tomando navios,",
          "descem aos mares,",
          "os que fazem comércio",
          "na imensidade das águas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "esses veem as obras do Senhor",
          "e as suas maravilhas",
          "nas profundezas do abismo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Pois Deus falou e fez levantar",
          "o vento tempestuoso,",
          "que elevou as ondas do mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Subiram até os céus,",
          "desceram até os abismos;",
          "no meio destas angústias,",
          "desfalecia-lhes a alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Andaram, e cambalearam",
          "como bêbados,",
          "e de nada adiantou",
          "a sua habilidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Então, na sua angústia,",
          "clamaram ao Senhor,",
          "e ele os livrou das suas tribulações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Fez cessar a tormenta,",
          "e as ondas se acalmaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Então se alegraram",
          "com a calmaria;",
          "e, assim, os levou",
          "ao porto desejado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Que eles deem graças ao Senhor",
          "por sua bondade",
          "e por suas maravilhas",
          "para com os filhos dos homens!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Que o exaltem",
          "na assembleia do povo",
          "e o glorifiquem",
          "no conselho dos anciãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Deus transformou rios",
          "em desertos",
          "e mananciais, em terra seca;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "fez da terra frutífera",
          "um deserto salgado,",
          "por causa da maldade",
          "dos seus habitantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Transformou o deserto",
          "em lençóis de água",
          "e a terra seca, em mananciais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Estabeleceu aí os famintos,",
          "os quais construíram uma cidade",
          "em que pudessem morar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Semearam campos,",
          "e plantaram vinhas,",
          "e tiveram fartas colheitas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Ele os abençoou,",
          "e eles se multiplicaram muito;",
          "e o gado deles não diminuiu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Mas outra vez foram reduzidos",
          "e humilhados pela opressão,",
          "pela adversidade e pelo sofrimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Deus mostra desprezo",
          "pelos príncipes",
          "e os faz andar errantes,",
          "onde não há caminho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Mas levanta da opressão",
          "o necessitado,",
          "e faz aumentar a sua família",
          "como um rebanho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Os retos veem isso e se alegram,",
          "mas todos os ímpios",
          "têm de fechar a boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Quem é sábio",
          "atente para essas coisas",
          "e considere",
          "as misericórdias do Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
