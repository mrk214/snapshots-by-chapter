    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A corrupção do pecador e sua redenção"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo didático de Davi, para cítara"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Diz o insensato no seu coração:",
          "“Não há Deus.”",
          "Corrompem-se",
          "e praticam iniquidade;",
          "já não há quem faça o bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Do céu Deus olha",
          "para os filhos dos homens,",
          "para ver se há quem entenda,",
          "se há quem busque a Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Todos se desviaram",
          "e juntamente se corromperam;",
          "não há quem faça o bem,",
          "não há nem um sequer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Será que não entendem nada",
          "esses que praticam",
          "a iniquidade,",
          "que devoram o meu povo",
          "como se comessem pão",
          "e que não invocam a Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ficam tomados de grande pavor,",
          "onde não há o que temer;",
          "porque Deus dispersa os ossos",
          "daqueles que cercam você;",
          "você faz com que",
          "fiquem envergonhados,",
          "porque Deus os rejeita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quem dera que de Sião",
          "viesse já a salvação de Israel!",
          "Quando Deus restaurar",
          "a sorte do seu povo,",
          "Jacó exultará",
          "e Israel se encherá de alegria."
        ],
        "rlw_lines": []
      }
    ]
  },
