    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração por auxílio divino"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "De Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A ti, Senhor, elevo a minha alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deus meu, em ti confio.",
          "Não seja eu envergonhado,",
          "nem exultem sobre mim",
          "os meus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Na verdade,",
          "dos que em ti esperam,",
          "ninguém será envergonhado;",
          "envergonhados serão",
          "os que, sem motivo,",
          "procedem traiçoeiramente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Faze-me conhecer",
          "os teus caminhos, Senhor;",
          "ensina-me as tuas veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Guia-me na tua verdade",
          "e ensina-me,",
          "pois tu és o Deus",
          "da minha salvação,",
          "em quem eu espero todo o dia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Lembra-te, Senhor,",
          "das tuas misericórdias",
          "e das tuas bondades,",
          "que são desde a eternidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Não te lembres dos meus",
          "pecados da mocidade,",
          "nem das minhas transgressões.",
          "Lembra-te de mim,",
          "segundo a tua misericórdia,",
          "por causa da tua bondade,",
          "ó Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Bom e reto é o Senhor,",
          "por isso aponta o caminho",
          "aos pecadores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Guia os humildes na justiça",
          "e ensina aos mansos",
          "o seu caminho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todas as veredas do Senhor",
          "são misericórdia e verdade",
          "para os que guardam a sua aliança",
          "e os seus testemunhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por causa do teu nome, Senhor,",
          "perdoa a minha iniquidade,",
          "que é grande."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Àquele que teme o Senhor,",
          "ele o instruirá no caminho",
          "que deve escolher."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Na prosperidade",
          "repousará a sua alma,",
          "e a sua descendência",
          "herdará a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor confia o seu segredo",
          "aos que o temem,",
          "aos quais ele dará a conhecer",
          "a sua aliança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os meus olhos se elevam",
          "continuamente ao Senhor,",
          "pois ele tirará os meus pés do laço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Volta-te para mim",
          "e tem compaixão,",
          "porque estou sozinho e aflito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Alivia-me as tribulações",
          "do coração;",
          "tira-me das minhas angústias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Considera as minhas aflições",
          "e o meu sofrimento",
          "e perdoa todos os meus pecados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Considera os meus inimigos,",
          "pois são muitos",
          "e têm por mim um ódio mortal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Guarda a minha alma e livra-me;",
          "não seja eu envergonhado,",
          "pois em ti me refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Que a sinceridade",
          "e a retidão me preservem,",
          "porque em ti espero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ó Deus, redime Israel",
          "de todas as suas tribulações."
        ],
        "rlw_lines": []
      }
    ]
  },
