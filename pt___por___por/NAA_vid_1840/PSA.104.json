    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvor ao Deus Criador"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bendiga, minha alma, o Senhor!",
          "Senhor, Deus meu,",
          "como tu és grandioso!",
          "Estás revestido de glória",
          "e majestade,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "coberto de luz",
          "como de um manto.",
          "Tu estendes o céu",
          "como uma cortina,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "pões nas águas",
          "o vigamento da tua morada,",
          "tomas as nuvens por carruagem",
          "e voas nas asas do vento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Fazes a teus anjos ventos",
          "e a teus ministros,",
          "labaredas de fogo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Lançaste os fundamentos da terra,",
          "para que ela não se abale",
          "em tempo nenhum."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tomaste o abismo",
          "por vestuário e a cobriste;",
          "as águas ficaram",
          "acima das montanhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Com a tua repreensão,",
          "as águas fugiram,",
          "com a voz do teu trovão,",
          "bateram em retirada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Elevaram-se os montes,",
          "desceram os vales,",
          "até o lugar",
          "que lhes havias preparado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Puseste às águas divisa",
          "que não ultrapassarão,",
          "para que não voltem",
          "a cobrir a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tu fazes rebentar fontes no vale,",
          "cujas águas correm",
          "entre os montes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "dão de beber",
          "a todos os animais do campo;",
          "os jumentos selvagens",
          "matam a sua sede."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Junto delas as aves do céu",
          "têm o seu pouso",
          "e, por entre a ramagem,",
          "elas se põem a cantar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Do alto de tua morada,",
          "regas os montes;",
          "a terra farta-se",
          "do fruto de tuas obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Fazes crescer a relva",
          "para os animais",
          "e as plantas que o ser humano",
          "cultiva,",
          "para que da terra",
          "tire o seu alimento:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "o vinho, que alegra o coração,",
          "o azeite, que lhe dá brilho ao rosto,",
          "e o pão, que lhe sustém as forças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "São saciadas",
          "as árvores do Senhor",
          "e os cedros do Líbano",
          "que ele plantou,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "em que as aves",
          "fazem os seus ninhos;",
          "quanto à cegonha,",
          "a sua casa é nos ciprestes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Os altos montes",
          "são das cabras-monteses,",
          "e as rochas,",
          "o refúgio dos arganazes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Fez a lua para marcar o tempo;",
          "o sol conhece a hora de se pôr."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Envias as trevas e vem a noite,",
          "na qual vagueiam",
          "os animais da selva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Os leõezinhos rugem pela presa",
          "e buscam de Deus o sustento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "em vindo o sol, eles se recolhem",
          "e se acomodam nos seus covis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Então as pessoas saem",
          "para o seu trabalho",
          "e para o seu serviço até a tarde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Que variedade, Senhor,",
          "nas tuas obras!",
          "Fizeste todas elas com sabedoria;",
          "a terra está cheia das tuas riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Eis o mar vasto, imenso,",
          "no qual se movem seres sem conta,",
          "animais pequenos e grandes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Por ele transitam os navios",
          "e o Leviatã que formaste",
          "para nele brincar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Todos esperam de ti",
          "que lhes dês de comer",
          "a seu tempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Se lhes dás, eles o recolhem;",
          "se abres a mão,",
          "eles se fartam de bens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Se escondes o rosto,",
          "eles se perturbam;",
          "se lhes cortas a respiração,",
          "morrem",
          "e voltam ao pó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Envias o teu Espírito,",
          "eles são criados,",
          "e assim renovas a face da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Que a glória do Senhor",
          "dure para sempre!",
          "Exulte o Senhor por suas obras!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Com só olhar para a terra,",
          "ele a faz tremer;",
          "toca as montanhas,",
          "e elas fumegam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Cantarei ao Senhor",
          "enquanto eu viver;",
          "cantarei louvores ao meu Deus",
          "durante a minha vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Seja-lhe agradável",
          "a minha meditação;",
          "eu me alegrarei no Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Desapareçam da terra",
          "os pecadores,",
          "e que os perversos",
          "deixem de existir.",
          "Bendiga, minha alma, o Senhor!",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
