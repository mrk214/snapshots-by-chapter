    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Convite a louvar a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Venham, cantemos",
          "ao Senhor com júbilo,",
          "celebremos o Rochedo",
          "da nossa salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Saiamos ao seu encontro",
          "com ações de graças,",
          "vitoriemo-lo com salmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque o Senhor",
          "é o Deus supremo",
          "e o grande Rei",
          "acima de todos os deuses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Nas suas mãos estão",
          "as profundezas da terra,",
          "e as alturas dos montes",
          "lhe pertencem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dele é o mar, pois ele o fez;",
          "obra de suas mãos,",
          "os continentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Venham, adoremos",
          "e prostremo-nos;",
          "ajoelhemos diante do Senhor,",
          "que nos criou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele é o nosso Deus,",
          "e nós somos povo do seu pasto",
          "e ovelhas de sua mão.",
          "Hoje, se ouvirem a sua voz,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "não endureçam o coração,",
          "como em Meribá,",
          "como naquele dia em Massá,",
          "no deserto,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "quando os pais de vocês",
          "me tentaram,",
          "pondo-me à prova,",
          "apesar de terem visto",
          "as minhas obras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Durante quarenta anos,",
          "estive irritado",
          "com essa geração",
          "e disse: “Este é um povo",
          "que gosta de se desviar;",
          "eles não conhecem",
          "os meus caminhos.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por isso, jurei na minha ira:",
          "“Eles não entrarão",
          "no meu descanso.”"
        ],
        "rlw_lines": []
      }
    ]
  },
