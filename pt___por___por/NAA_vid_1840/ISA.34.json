    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A indignação de Deus contra as nações"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aproximem-se, ó nações,",
          "para ouvir,",
          "e vocês, povos, escutem!",
          "Que a terra e a sua plenitude",
          "ouçam;",
          "que o mundo e tudo",
          "o que ele produz escutem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque a indignação do Senhor",
          "está contra todas as nações,",
          "e o seu furor está contra",
          "todo o exército delas;",
          "ele as destinou para a destruição",
          "e as entregou à matança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os mortos deles",
          "serão lançados fora,",
          "e dos seus cadáveres",
          "subirá o mau cheiro;",
          "os montes se inundarão",
          "do sangue deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todo o exército dos céus",
          "se dissolverá,",
          "e os céus se enrolarão",
          "como um pergaminho;",
          "todo o exército dos céus cairá,",
          "como cai a folha da videira",
          "e a folha da figueira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque a minha espada",
          "se embriagou nos céus;",
          "eis que, para exercer juízo,",
          "ela desce sobre Edom",
          "e sobre o povo que destinei",
          "para a destruição."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A espada do Senhor",
          "está cheia de sangue,",
          "engrossada da gordura",
          "e do sangue de cordeiros",
          "e de bodes,",
          "da gordura dos rins de carneiros.",
          "Porque o Senhor fará",
          "um sacrifício em Bozra",
          "e grande matança",
          "na terra de Edom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os bois selvagens",
          "cairão com eles,",
          "e os novilhos, com os touros.",
          "A terra deles ficará embriagada",
          "de sangue,",
          "e o pó ficará encharcado",
          "de gordura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Porque esse será",
          "o dia da vingança do Senhor,",
          "o ano de retribuições",
          "pela causa de Sião."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os ribeiros de Edom",
          "se transformarão em piche,",
          "e o seu pó, em enxofre;",
          "a sua terra se tornará",
          "em piche ardente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O fogo não se apagará",
          "nem de noite nem de dia,",
          "e a sua fumaça subirá",
          "para sempre.",
          "De geração em geração",
          "ficará abandonada,",
          "e para todo o sempre",
          "ninguém passará por ela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O pelicano e o ouriço",
          "tomarão posse do lugar;",
          "a coruja e o corvo",
          "habitarão nessa terra.",
          "O Senhor estenderá sobre Edom",
          "o cordel de destruição",
          "e o prumo de ruína."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Já não haverá nobres",
          "para proclamarem um rei;",
          "os seus príncipes já não existem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Nos seus palácios,",
          "crescerão espinhos,",
          "e as urtigas e os cardos",
          "tomarão conta",
          "das suas fortalezas.",
          "Edom será uma habitação",
          "de chacais",
          "e morada de avestruzes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Os animais do deserto",
          "se encontrarão com as hienas,",
          "e os bodes selvagens",
          "clamarão uns aos outros;",
          "animais noturnos ali pousarão",
          "e acharão para si lugar de repouso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ali a coruja fará o seu ninho,",
          "porá os seus ovos e os chocará;",
          "e na sua sombra abrigará",
          "os seus filhotes.",
          "Também ali os abutres",
          "se ajuntarão,",
          "cada um com o seu par."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Procurem no livro do Senhor",
          "e leiam:",
          "Nenhuma dessas criaturas faltará,",
          "e nenhuma estará sem o seu par.",
          "Porque a boca do Senhor",
          "o ordenou,",
          "e o seu Espírito mesmo as ajuntará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Porque ele lançou as sortes",
          "a favor delas,",
          "e a sua mão lhes repartiu a terra",
          "com o cordel;",
          "para sempre a possuirão,",
          "através das gerações",
          "habitarão nela."
        ],
        "rlw_lines": []
      }
    ]
  },
