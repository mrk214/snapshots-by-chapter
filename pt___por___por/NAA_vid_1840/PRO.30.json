    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "As palavras de Agur"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palavras de Agur, filho de Jaque, de Massá.",
          "O homem disse:",
          "“Estou cansado, ó Deus;",
          "estou cansado, ó Deus, e exausto"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "porque sou demasiadamente",
          "estúpido para ser homem.",
          "Não tenho a inteligência",
          "de um ser humano,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "não aprendi a sabedoria,",
          "nem tenho o conhecimento",
          "do Santo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Quem subiu ao céu e desceu?",
          "Quem pegou o vento",
          "com as suas mãos?",
          "Quem amarrou as águas",
          "na sua roupa?",
          "Quem estabeleceu",
          "todas as extremidades da terra?",
          "Qual é o seu nome,",
          "e qual é o nome de seu filho,",
          "se é que você o sabe?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Toda palavra de Deus é pura.",
          "Ele é escudo",
          "para os que nele confiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não acrescente nada",
          "às suas palavras,",
          "para que ele não o repreenda,",
          "e você seja achado mentiroso.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Uma oração"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Duas coisas te peço, ó Deus;",
          "não recuses o meu pedido,",
          "antes que eu morra:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "afasta de mim a falsidade",
          "e a mentira;",
          "não me dês nem a pobreza",
          "nem a riqueza;",
          "dá-me o pão",
          "que me for necessário,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para não acontecer que,",
          "estando eu farto, te negue",
          "e diga: “Quem é o Senhor?”",
          "Ou que, empobrecido,",
          "venha a furtar",
          "e profane o nome de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Outros provérbios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Não calunie o servo",
          "diante de seu senhor,",
          "para que você não seja",
          "amaldiçoado por aquele servo",
          "e seja visto como culpado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Há pessoas que amaldiçoam",
          "o próprio pai",
          "e que não bendizem a própria mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Há pessoas que são puras",
          "aos próprios olhos",
          "e que jamais foram lavadas",
          "da sua sujeira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Há pessoas cujos olhos",
          "são arrogantes",
          "e que olham para os outros",
          "com desdém!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Há pessoas cujos dentes",
          "são espadas,",
          "e cujas mandíbulas são facas,",
          "para consumirem os aflitos da terra",
          "e os necessitados deste mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "A sanguessuga tem duas filhas,",
          "que se chamam Dá e Dá.",
          "Há três coisas que nunca se fartam;",
          "na verdade, há quatro",
          "que nunca dizem: “Basta!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Elas são o mundo dos mortos,",
          "o ventre estéril,",
          "a terra, que não se farta de água,",
          "e o fogo, que nunca diz: “Basta!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os olhos de quem zomba do pai",
          "ou de quem nega obediência",
          "à sua mãe,",
          "corvos do vale os arrancarão",
          "e pelos filhotes da águia",
          "serão comidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Há três coisas que são",
          "maravilhosas demais para mim;",
          "na verdade, há quatro",
          "que eu não entendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "o caminho da águia no céu,",
          "o caminho da cobra na rocha,",
          "o caminho do navio",
          "no meio do mar",
          "e o caminho do homem",
          "com uma moça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Tal é o caminho",
          "da mulher adúltera:",
          "come, limpa a boca",
          "e depois diz:",
          "“Não fiz nada de errado!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Três coisas fazem a terra tremer;",
          "na verdade, são quatro",
          "que ela não pode suportar:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "o escravo que se torna rei;",
          "o insensato que anda farto de pão;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "a mulher desprezada",
          "que se casa;",
          "e a escrava que se torna",
          "herdeira da sua senhora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Há quatro coisas",
          "bem pequenas na terra,",
          "mas que são mais sábias",
          "do que os sábios:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "as formigas, povo sem força,",
          "mas que no verão",
          "prepara a sua comida;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "os arganazes,",
          "povo que não é poderoso,",
          "mas que faz a sua casa nas rochas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "os gafanhotos, que não têm rei,",
          "mas que marcham",
          "todos em bandos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "a lagartixa, que se pode apanhar",
          "com as mãos,",
          "mas que se encontra",
          "até nos palácios dos reis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Há três que têm passo elegante;",
          "na verdade, quatro",
          "que são imponentes no andar:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "o leão, o mais forte dos animais,",
          "que não foge diante de nada;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "o galo, que anda ereto; o bode;",
          "e o rei, a quem não se pode resistir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Se você foi tolo",
          "a ponto de se exaltar",
          "ou se planejou o mal,",
          "ponha a mão sobre a sua boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Porque o bater do leite",
          "produz manteiga,",
          "o torcer do nariz produz sangue",
          "e o instigar a ira produz brigas."
        ],
        "rlw_lines": []
      }
    ]
  },
