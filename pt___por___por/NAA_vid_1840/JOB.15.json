{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"JOB","name":"Jó"},"chapter":{"chapter_usfm":"JOB.15","is_chapter":true,"previous":{"usfm":"JOB.14","human":"Jó 14","canonical":true,"toc":true},"current":{"usfm":"JOB.15","human":"Jó 15"},"next":{"usfm":"JOB.16","human":"Jó 16","canonical":true,"toc":true},"items":[{"type":"section1","verse_numbers":[],"lines":["Segundo diálogo"],"rlw_lines":[]},{"type":"section2","verse_numbers":[],"lines":["Caps.15—21"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Segunda fala de Elifaz"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["A sua própria boca o condena"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Então Elifaz, o temanita, tomou a palavra e disse:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["“Será que um sábio","daria respostas vazias?","Será que encheria a si mesmo","de vento leste?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Argumentaria com palavras","que de nada servem","e com razões","das quais nada se aproveita?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Mas você destrói","o temor de Deus","e diminui a devoção a ele devida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Pois o que você fala","se inspira em sua iniquidade,","e você adota a língua dos astutos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["A sua própria boca o condena,","e não eu;","os seus lábios dão testemunho","contra você.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["“Será que você é","o primeiro homem que nasceu?","Por acaso, você foi formado","antes dos montes?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Será que você ouviu","o conselho secreto de Deus","e detém toda a sabedoria?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["O que você sabe,","que nós não sabemos?","O que você entende,","que nós não entendemos?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Também há entre nós","homens idosos","e de cabelos brancos,","muito mais velhos","do que o seu pai.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["“Você faz pouco caso","das consolações de Deus","e das suaves palavras","que dirigimos a você?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Por que você se deixa levar","pelo seu coração?","Por que os seus olhos flamejam,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["para que você dirija","contra Deus o seu furor?","E por que deixa que tais palavras","saiam de sua boca?”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["“Que é o homem,","para que seja puro?","E o que nasce de mulher,","para ser justo?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Eis que Deus não confia","nem nos seus santos!","Nem os céus são puros","aos seus olhos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["quanto menos o homem,","que é abominável e corrupto,","que bebe a iniquidade","como a água!”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["O ímpio é atormentado todos os dias"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["“Escute o que eu vou explicar;","vou contar-lhe o que eu vi,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["o que os sábios anunciaram,","sem ocultar nada,","tendo-o recebido dos pais deles,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["aos quais somente foi dada","esta terra,","sem que nenhum estrangeiro","passasse entre eles.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["“O ímpio é atormentado","todos os dias,","no curto número de anos","que se reservam","para o opressor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["O som dos horrores","está nos seus ouvidos;","na prosperidade lhe sobrevém","o destruidor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Não crê que possa escapar","das trevas,","e sim que a espada o espera."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Anda vagando, em busca de pão,","dizendo: ‘Onde está?’","Bem sabe que o dia das trevas","está perto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["A angústia e a tribulação","o assombram;","prevalecem contra ele,","como o rei preparado","para a batalha."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Porque ele levantou a mão","contra Deus","e desafiou o Todo-Poderoso;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["arremete contra ele","obstinadamente,","protegido por um grosso escudo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Porque cobriu o rosto","com a sua gordura,","que se acumulou também na cintura;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["morou em cidades assoladas,","em casas em que ninguém","devia morar,","que estavam prestes a virar ruínas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Por isso, não ficará rico,","nem subsistirá a sua riqueza;","nem se estenderão os seus bens","pela terra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Não escapará das trevas;","a chama do fogo","secará os seus rebentos,","e ao sopro da boca de Deus","será arrebatado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Que ele não confie na vaidade,","enganando a si mesmo,","porque a vaidade","será a sua recompensa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["Esta lhe chegará antes da hora,","e o seu ramo não reverdecerá."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["Será como a videira","que perde as uvas ainda verdes,","como a oliveira que deixa cair","a sua flor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Porque a companhia dos ímpios","será estéril,","e o fogo consumirá","as tendas do suborno."],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["Concebem o mal","e dão à luz a iniquidade;","o coração deles","só prepara enganos.”"],"rlw_lines":[]}]}}