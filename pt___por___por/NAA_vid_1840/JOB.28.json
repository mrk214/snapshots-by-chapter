    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Elogio da sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Os seus olhos veem o que há de precioso"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Na verdade, a prata",
          "tem as suas minas,",
          "e o ouro, que se refina,",
          "tem o seu lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O ferro é tirado da terra,",
          "e da pedra se funde o cobre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os homens põem termo",
          "à escuridão",
          "e até os últimos confins procuram",
          "as pedras ocultas nas trevas",
          "e na densa escuridão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Abrem entrada para minas",
          "longe da habitação",
          "dos homens;",
          "são esquecidos",
          "pelos que passam por cima;",
          "e, assim, longe de todos,",
          "dependurados em cordas,",
          "balançam de um lado",
          "para outro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Da terra procede o alimento,",
          "mas embaixo ela é revolvida",
          "como que pelo fogo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Nas suas pedras",
          "se encontra safira,",
          "e há pó que contém ouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Essa vereda,",
          "a ave de rapina a ignora,",
          "e os olhos do falcão nunca a viram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Feras majestosas nunca pisaram",
          "essa vereda,",
          "e nenhum leão passou por ali."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O homem estende a sua mão",
          "contra o rochedo",
          "e revolve os montes",
          "desde as suas raízes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Abre canais nas pedras,",
          "e os seus olhos veem tudo",
          "o que há de mais precioso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tapa os veios de água,",
          "e nem uma gota sai deles;",
          "e traz à luz",
          "o que estava escondido.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "O valor da sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Mas onde se achará",
          "a sabedoria?",
          "E em que lugar estará",
          "o entendimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O ser humano não conhece",
          "o valor da sabedoria,",
          "e ela não se encontra",
          "na terra dos viventes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O abismo diz:",
          "‘Ela não está em mim.’",
          "E o mar diz: ‘Não está comigo.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Não se compra a sabedoria",
          "com ouro fino;",
          "ela também não pode",
          "ser paga com prata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O seu valor",
          "não pode ser avaliado",
          "pelo ouro de Ofir,",
          "nem pelo precioso ônix,",
          "nem pela safira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O ouro não se iguala a ela,",
          "nem o cristal;",
          "não se pode trocá-la",
          "por joias de ouro fino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ela faz esquecer o coral",
          "e o cristal;",
          "o preço da sabedoria",
          "é maior que o das pérolas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "O topázio da Etiópia",
          "não se compara com ela;",
          "não se compra a sabedoria",
          "nem com ouro puro.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "O temor do Senhor é a sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "“Mas de onde vem a sabedoria?",
          "E em que lugar",
          "estará o entendimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Está encoberta aos olhos",
          "de todos os seres vivos,",
          "e oculta às aves do céu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "O abismo e a morte dizem:",
          "‘Ouvimos com os nossos ouvidos",
          "a sua fama.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "“Deus lhe entende o caminho,",
          "e ele é quem sabe o seu lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Porque o seu olhar",
          "alcança as extremidades",
          "da terra;",
          "ele vê tudo o que há",
          "debaixo dos céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Quando Deus regulou",
          "o peso do vento",
          "e fixou a medida das águas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "quando determinou leis",
          "para a chuva",
          "e caminho para o relâmpago",
          "dos trovões,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "então ele viu a sabedoria",
          "e a manifestou;",
          "estabeleceu-a",
          "e também a examinou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "E disse ao ser humano:",
          "‘Eis que o temor do Senhor",
          "é a sabedoria,",
          "e afastar-se do mal",
          "é o entendimento.’”"
        ],
        "rlw_lines": []
      }
    ]
  },
