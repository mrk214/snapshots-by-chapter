    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pedindo justiça"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de Davi. Entoado ao Senhor, com respeito às palavras de Cuxe, benjamita"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, meu Deus,",
          "em ti me refugio;",
          "salva-me de todos",
          "os que me perseguem",
          "e livra-me,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "para que ninguém, como leão,",
          "me arrebate,",
          "despedaçando-me, não havendo",
          "quem me livre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Senhor, meu Deus, se eu fiz isso",
          "de que me culpam,",
          "se cometi alguma injustiça,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "se paguei com o mal",
          "a quem estava em paz comigo,",
          "eu, que poupei aquele",
          "que sem razão me oprimia,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "então que o inimigo me persiga",
          "e me alcance,",
          "pisoteie no chão a minha vida",
          "e reduza a pó a minha glória."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Levanta-te, Senhor,",
          "na tua indignação,",
          "mostra a tua grandeza contra",
          "a fúria dos meus adversários",
          "e desperta-te em meu favor,",
          "segundo o juízo que designaste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Reúnam-se os povos",
          "ao redor de ti,",
          "e das alturas domina sobre eles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O Senhor julga os povos;",
          "julga-me, Senhor,",
          "segundo a minha justiça",
          "e segundo a integridade",
          "que há em mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Que cesse a maldade dos ímpios.",
          "Fortalece o justo,",
          "pois sondas a mente e o coração,",
          "ó Deus justo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Deus é o meu escudo;",
          "ele salva os retos de coração."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Deus é justo juiz,",
          "Deus que sente indignação",
          "todos os dias."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Se alguém não se converter,",
          "Deus afiará a sua espada;",
          "já armou e deixou pronto",
          "o seu arco;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "para ele já preparou",
          "armas mortais,",
          "fez as suas setas inflamadas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Eis que o ímpio está com dores",
          "de iniquidade;",
          "concebeu a maldade",
          "e dá à luz a mentira."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Abre e aprofunda uma cova,",
          "e cai nesse mesmo poço que faz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "A sua maldade recai",
          "sobre a cabeça,",
          "e sobre o próprio crânio",
          "desce a sua violência."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Eu, porém, louvarei o Senhor,",
          "segundo a sua justiça,",
          "e cantarei louvores",
          "ao nome do Senhor Altíssimo."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
