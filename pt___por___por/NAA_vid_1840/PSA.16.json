    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Santo de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Hino de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Guarda-me, ó Deus,",
          "porque em ti me refugio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Digo ao Senhor:",
          "“Tu és o meu Senhor;",
          "outro bem não possuo,",
          "senão a ti somente.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quanto aos santos",
          "que há na terra,",
          "eles são os notáveis",
          "nos quais tenho todo o meu prazer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Muitas serão as dores",
          "dos que trocam o Senhor",
          "por outros deuses;",
          "não oferecerei as suas libações",
          "de sangue,",
          "e os meus lábios não pronunciarão",
          "os nomes deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor é a porção",
          "da minha herança",
          "e o meu cálice;",
          "tu sustentas a minha sorte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "As minhas divisas caíram",
          "em lugares agradáveis;",
          "é linda a minha herança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Bendigo o Senhor,",
          "que me aconselha;",
          "pois até durante a noite",
          "o meu coração me ensina."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tenho o Senhor sempre",
          "diante de mim;",
          "estando ele à minha direita,",
          "não serei abalado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por isso o meu coração se alegra",
          "e o meu espírito exulta;",
          "até o meu corpo repousará seguro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois não deixarás",
          "a minha alma na morte,",
          "nem permitirás que o teu Santo",
          "veja corrupção."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tu me farás ver",
          "os caminhos da vida;",
          "na tua presença",
          "há plenitude de alegria,",
          "à tua direita,",
          "há delícias perpetuamente."
        ],
        "rlw_lines": []
      }
    ]
  },
