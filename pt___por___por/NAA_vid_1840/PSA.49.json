    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A vaidade das riquezas"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo dos filhos de Corá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Povos todos, escutem isto;",
          "deem ouvidos,",
          "todos os moradores da terra,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "tanto os humildes",
          "como os poderosos,",
          "todos juntamente,",
          "os ricos e os pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os meus lábios falarão sabedoria,",
          "e o meu coração terá",
          "pensamentos profundos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Inclinarei os meus ouvidos",
          "a uma parábola,",
          "decifrarei o meu enigma",
          "ao som da harpa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Por que temerei nos dias maus,",
          "quando me cercar a iniquidade",
          "dos que me perseguem,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "dos que confiam nos seus bens",
          "e se gloriam na sua muita riqueza?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ao irmão, verdadeiramente,",
          "ninguém o pode remir,",
          "nem pagar por ele a Deus",
          "o seu resgate —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "pois a redenção da alma deles",
          "é caríssima,",
          "e cessará a tentativa",
          "para sempre —,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para que continue a viver",
          "perpetuamente",
          "e não venha a morrer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque vê-se",
          "que os sábios morrem,",
          "e que perecem também",
          "os tolos e estúpidos,",
          "os quais deixam as suas riquezas",
          "para os outros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Em seu íntimo pensam",
          "que as suas casas",
          "serão perpétuas",
          "e, as suas moradas,",
          "para todas as gerações;",
          "chegam a dar o seu próprio nome",
          "às suas terras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Todavia, o ser humano",
          "não permanece",
          "em sua ostentação;",
          "pelo contrário, é como os animais,",
          "que perecem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tal proceder é tolice deles;",
          "mas os seus seguidores aplaudem",
          "o que eles dizem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Como ovelhas",
          "são postos na sepultura;",
          "a morte é o seu pastor;",
          "eles descem diretamente",
          "para a cova,",
          "onde a sua formosura se consome;",
          "o mundo dos mortos é o lugar",
          "em que habitam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mas Deus remirá a minha alma",
          "do poder da morte,",
          "pois ele me tomará para si."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Não tenha medo,",
          "quando alguém enriquecer,",
          "quando aumentar",
          "a glória de sua casa;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "pois, quando morrer,",
          "nada levará consigo,",
          "a sua glória não o acompanhará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ainda que durante a vida",
          "ele tenha se lisonjeado,",
          "e ainda que o louvem",
          "quando faz o bem a si mesmo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "irá juntar-se à geração",
          "de seus pais,",
          "os quais já não verão a luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O ser humano,",
          "revestido de honrarias,",
          "mas sem entendimento,",
          "é como os animais, que perecem."
        ],
        "rlw_lines": []
      }
    ]
  },
