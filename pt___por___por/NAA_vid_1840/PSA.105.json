{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.105","is_chapter":true,"previous":{"usfm":"PSA.104","human":"Salmos 104","canonical":true,"toc":true},"current":{"usfm":"PSA.105","human":"Salmos 105"},"next":{"usfm":"PSA.106","human":"Salmos 106","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Deus e o seu povo"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Deem graças ao Senhor,","invoquem o seu nome;","tornem conhecidos entre os povos","os seus feitos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Cantem a Deus,","cantem louvores a ele;","falem de todas as suas maravilhas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Gloriem-se no seu santo nome;","alegre-se o coração","dos que buscam o Senhor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Busquem o Senhor e o seu poder;","busquem continuamente","a sua presença."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Lembrem-se das maravilhas","que ele fez,","dos seus prodígios e dos juízos","de seus lábios,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["vocês, descendentes de Abraão,","seu servo,","vocês, filhos de Jacó,","seus escolhidos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Ele é o Senhor, nosso Deus;","os seus juízos permeiam","toda a terra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Lembra-se perpetuamente","da sua aliança,","da palavra que empenhou","para mil gerações;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["da aliança que fez com Abraão","e do juramento que fez a Isaque;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["o qual confirmou a Jacó","por decreto","e a Israel por aliança perpétua,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["dizendo: “Eu lhe darei","a terra de Canaã","como porção da sua herança.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Quando eles eram","em pequeno número,","pouquíssimos e estrangeiros","na terra de Canaã;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["quando andavam","de nação em nação,","de um reino para outro reino,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Deus não permitiu","que ninguém os oprimisse,","e, por amor deles, repreendeu reis,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["dizendo: “Não toquem","nos meus ungidos,","nem maltratem os meus profetas.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Deus fez vir fome sobre a terra","e cortou os meios de se obter pão."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Adiante deles enviou um homem,","José, que foi vendido","como escravo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Apertaram os seus pés","com correntes","e puseram uma coleira de ferro","no seu pescoço,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["até cumprir-se a profecia","a respeito dele,","e tê-lo provado","a palavra do Senhor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["O rei mandou soltá-lo;","o dominador dos povos o pôs","em liberdade."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Constituiu-o senhor de sua casa","e administrador de tudo","o que possuía,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["para, como bem quisesse,","sujeitar os seus príncipes","e ensinar a sabedoria","aos seus anciãos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Então Israel entrou no Egito,","e Jacó peregrinou na terra de Cam."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Deus fez sobremodo fecundo","o seu povo","e o tornou mais forte","do que os seus opressores."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Mudou o coração dos egípcios","para que odiassem o seu povo","e usassem de astúcia","para com os seus servos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Deus lhes enviou Moisés,","seu servo,","e Arão, a quem havia escolhido,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["por meio dos quais fez,","entre eles,","os seus sinais e maravilhas","na terra de Cam."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Enviou trevas, e tudo escureceu;","e Moisés e Arão não foram","rebeldes à sua palavra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Transformou-lhes","as águas em sangue","e assim lhes fez morrer os peixes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["A terra deles produziu rãs","em abundância,","até nos aposentos dos reis."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Deus falou, e vieram","nuvens de moscas e piolhos","em toda a terra do Egito."],"rlw_lines":[]},{"type":"verse","verse_numbers":[32],"lines":["Por chuva deu-lhes granizo","e fogo chamejante, naquela terra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[33],"lines":["Devastou-lhes os vinhedos","e os figueirais","e quebrou as árvores","da terra deles."],"rlw_lines":[]},{"type":"verse","verse_numbers":[34],"lines":["Ele falou, e vieram gafanhotos","e lagartas sem conta,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[35],"lines":["que devoraram","toda a vegetação do país","e comeram o fruto","dos seus campos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[36],"lines":["Também feriu de morte","todos os primogênitos","da terra deles,","as primícias do seu vigor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[37],"lines":["Então Deus fez sair o seu povo,","com prata e ouro,","e entre as suas tribos","não havia um só inválido."],"rlw_lines":[]},{"type":"verse","verse_numbers":[38],"lines":["O Egito se alegrou","quando eles saíram,","porque lhe tinham","infundido terror."],"rlw_lines":[]},{"type":"verse","verse_numbers":[39],"lines":["Deus estendeu uma nuvem","que lhes servisse de toldo","e um fogo para os iluminar","de noite."],"rlw_lines":[]},{"type":"verse","verse_numbers":[40],"lines":["Pediram,","e Deus fez vir codornizes","e os saciou com pão do céu."],"rlw_lines":[]},{"type":"verse","verse_numbers":[41],"lines":["Fendeu a rocha,","e dela brotaram águas,","que correram como um rio","pelo deserto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[42],"lines":["Porque estava lembrado","da sua santa palavra","e de Abraão, seu servo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[43],"lines":["Ele conduziu o seu povo","com alegria","e, com júbilo, os seus escolhidos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[44],"lines":["Deu-lhes as terras das nações,","e eles se apossaram do fruto","do trabalho dos povos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[45],"lines":["para que lhe guardassem","os preceitos","e lhe observassem as leis.","Aleluia!"],"rlw_lines":[]}]}}