    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Gratidão pela proteção de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bendito seja o Senhor,",
          "rocha minha,",
          "que treina as minhas mãos",
          "para a batalha",
          "e os dedos, para a guerra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele é a minha misericórdia",
          "e a minha fortaleza,",
          "meu alto refúgio e meu libertador,",
          "meu escudo,",
          "aquele em quem confio",
          "e quem me submete o meu povo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Senhor, que é o homem",
          "para que dele",
          "tomes conhecimento?",
          "E o filho do homem,",
          "para que o estimes?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O ser humano é como um sopro;",
          "os seus dias são",
          "como a sombra que passa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Abaixa, Senhor,",
          "os teus céus e desce;",
          "toca os montes,",
          "para que fumeguem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Manda relâmpagos",
          "e dispersa os meus inimigos;",
          "arremessa as tuas flechas",
          "para fazê-los fugir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Estende a mão lá do alto;",
          "livra-me e salva-me",
          "das muitas águas",
          "e do poder de estranhos,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "cuja boca profere mentiras,",
          "e cuja mão direita",
          "é a mão direita da falsidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A ti, ó Deus, entoarei",
          "um cântico novo;",
          "na lira de dez cordas,",
          "te cantarei louvores."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "É ele quem dá aos reis a vitória;",
          "quem livra o seu servo Davi",
          "da espada maligna."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Livra-me e salva-me",
          "do poder de estranhos,",
          "cuja boca profere mentiras,",
          "e cuja mão direita",
          "é a mão direita da falsidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Que os nossos filhos",
          "sejam, na sua mocidade,",
          "como plantas viçosas,",
          "e que as nossas filhas",
          "sejam como colunas,",
          "esculpidas para um palácio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Que os nossos celeiros",
          "transbordem,",
          "cheios de todo tipo de provisões.",
          "Que os nossos rebanhos",
          "produzam a milhares",
          "e a dezenas de milhares,",
          "em nossos campos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Que o nosso gado seja fértil,",
          "e as vacas não percam as suas crias.",
          "Não haja gritos de lamento",
          "em nossas praças."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Bem-aventurado o povo",
          "a quem assim sucede!",
          "Sim, feliz é o povo",
          "cujo Deus é o Senhor!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
