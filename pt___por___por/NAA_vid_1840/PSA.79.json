    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Apelo à misericórdia divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asafe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, as nações invadiram",
          "a tua herança,",
          "profanaram o teu santo templo,",
          "reduziram Jerusalém",
          "a um montão de ruínas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deram os cadáveres",
          "dos teus servos",
          "por alimento às aves dos céus",
          "e a carne dos teus santos,",
          "às feras da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Derramaram como água",
          "o sangue deles",
          "ao redor de Jerusalém,",
          "e não houve quem",
          "lhes desse sepultura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tornamo-nos objeto de deboche",
          "para os nossos vizinhos,",
          "de escárnio e de zombaria",
          "dos que nos rodeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Até quando, Senhor?",
          "Será para sempre a tua ira?",
          "Queimará como o fogo o teu zelo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Derrama o teu furor",
          "sobre as nações",
          "que não te conhecem",
          "e sobre os reinos",
          "que não invocam o teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque eles devoraram Jacó",
          "e destruíram as suas moradas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Não nos faças pagar",
          "pelas iniquidades",
          "de nossos pais;",
          "que as tuas misericórdias",
          "venham depressa",
          "ao nosso encontro,",
          "pois estamos muito abatidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ajuda-nos, ó Deus",
          "e Salvador nosso,",
          "pela glória do teu nome;",
          "livra-nos e perdoa",
          "os nossos pecados,",
          "por amor do teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por que diriam as nações:",
          "“Onde está o Deus deles?”",
          "Seja manifesta entre as nações",
          "e diante dos nossos olhos",
          "a vingança do sangue",
          "dos teus servos,",
          "que foi derramado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Chegue à tua presença",
          "o gemido dos prisioneiros;",
          "com o teu grande poder,",
          "preserva os que estão",
          "condenados à morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Retribui, Senhor,",
          "aos nossos vizinhos",
          "sete vezes mais",
          "as afrontas com que te afrontaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Quanto a nós, teu povo",
          "e ovelhas do teu pasto,",
          "para sempre te daremos graças;",
          "de geração em geração",
          "proclamaremos",
          "os teus louvores."
        ],
        "rlw_lines": []
      }
    ]
  },
