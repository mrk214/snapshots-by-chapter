    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O Senhor disse mais a Jó:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Será que alguém",
          "que usa de censuras",
          "poderá discutir",
          "com o Todo-Poderoso?",
          "Que responda a isso",
          "aquele que critica Deus!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primeira resposta de Jó a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Então Jó respondeu ao Senhor e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Sou indigno.",
          "Que te responderia eu?",
          "Ponho a mão sobre a minha boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Uma vez falei,",
          "e não direi mais nada;",
          "aliás, duas vezes,",
          "porém não prosseguirei.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segunda e última resposta de Deus a Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Você tem um braço tão forte como o braço de Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Então o Senhor, do meio de um redemoinho, respondeu a Jó e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Cinja os lombos como homem,",
          "pois eu lhe farei perguntas,",
          "e você me responderá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Será que você está querendo",
          "anular a minha justiça?",
          "Ou me condenará,",
          "para se justificar?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Você tem um braço tão forte",
          "como o braço de Deus?",
          "Você pode trovejar",
          "com a voz como ele troveja?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Adorne-se, então,",
          "de excelência e grandeza,",
          "e vista-se de majestade e glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Derrame as torrentes da sua ira;",
          "olhe para os orgulhosos",
          "e humilhe-os."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sim, olhe para eles e humilhe-os;",
          "esmague os ímpios",
          "no lugar onde estiverem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Cubra-os todos no pó;",
          "prenda todos eles no sepulcro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Então também eu confessarei",
          "a seu respeito",
          "que a sua mão direita",
          "lhe dá vitória.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Quem é capaz de apanhar o monstro Beemote?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "“Contemple agora",
          "o Beemote, que eu criei",
          "junto com você,",
          "e que come capim como o boi."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "A força dele está",
          "nos seus lombos,",
          "e o seu poder,",
          "nos músculos do seu ventre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ele endurece a sua cauda",
          "como cedro;",
          "os tendões das suas coxas",
          "estão entretecidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Os seus ossos",
          "são como tubos de bronze;",
          "as suas pernas",
          "são como barras de ferro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ele é obra-prima",
          "dos feitos de Deus;",
          "aquele que o fez",
          "o proveu de espada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Na verdade,",
          "os montes lhe produzem pasto,",
          "onde todos os animais selvagens",
          "se divertem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Deita-se debaixo",
          "das árvores de lótus,",
          "no esconderijo da lama,",
          "no meio dos juncos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "As árvores de lótus",
          "o cobrem com sua sombra;",
          "os salgueiros do ribeiro o rodeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Se um rio transborda,",
          "ele não se apressa;",
          "fica tranquilo mesmo que o Jordão",
          "se levante até a sua boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Será que alguém pode apanhá-lo",
          "quando ele está olhando?",
          "Ou lhe meter um laço pelo nariz?”"
        ],
        "rlw_lines": []
      }
    ]
  },
