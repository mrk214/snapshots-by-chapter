{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.35","is_chapter":true,"previous":{"usfm":"PSA.34","human":"Salmos 34","canonical":true,"toc":true},"current":{"usfm":"PSA.35","human":"Salmos 35"},"next":{"usfm":"PSA.36","human":"Salmos 36","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Oração pedindo a ajuda de Deus"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["Salmo de Davi"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Ó Senhor, defende a minha causa","contra os que me acusam;","luta contra aqueles","que me atacam."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Embraça o escudo e a couraça","e ergue-te em meu auxílio."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Empunha a lança","e reprime o passo","dos meus perseguidores.","Dize à minha alma:","“Eu sou a sua salvação.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Sejam confundidos","e cobertos de vexame","os que buscam tirar-me a vida;","retrocedam","e sejam envergonhados","os que tramam contra mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Sejam como a palha","que o vento leva,","impelindo-os o anjo do Senhor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Que o caminho deles fique escuro","e se torne escorregadio,","e que o anjo do Senhor os persiga."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Pois sem razão me armaram","ciladas,","sem motivo abriram","uma cova para mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Venha sobre o inimigo","a destruição,","quando ele menos esperar;","e prendam-no os laços","que tramou ocultamente;","caia neles para a sua própria ruína."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Então a minha alma","se alegrará no Senhor","e se regozijará na sua salvação."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Todos os meus ossos dirão:","“Senhor, quem é semelhante a ti?","Pois livras o aflito daquele que é","mais forte do que ele;","livras o pobre e o necessitado","daqueles que os exploram.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Falsas testemunhas se levantam","e me interrogam sobre coisas","que eu não sei."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Pagam-me o mal pelo bem,","o que é desolação","para a minha alma."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Quanto a mim, porém,","estando eles enfermos,","as minhas roupas","eram pano de saco;","eu afligia a minha alma com jejum","e em oração me reclinava","sobre o peito."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Portava-me como se eles fossem","meus amigos ou meus irmãos;","andava curvado, de luto,","como quem chora por sua mãe."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Quando, porém, tropecei,","eles se alegraram","e se reuniram;","reuniram-se contra mim;","homens sem valor,","que eu não conhecia,","dilaceraram-me sem tréguas;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["como hipócritas zombadores","numa festa,","rangiam os dentes contra mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Até quando, Senhor,","ficarás olhando?","Livra-me da violência deles;","salva dos leões","a minha preciosa vida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Renderei graças","na grande congregação,","te louvarei","no meio da multidão poderosa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Não se alegrem de mim os que,","sem razão, são meus inimigos;","não pisquem os olhos os que","sem motivo me odeiam."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Não é de paz que eles falam;","pelo contrário, tramam enganos","contra os pacíficos da terra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Escancaram contra mim a boca","e dizem: “Pegamos! Pegamos!","Vimos tudo","com os nossos próprios olhos!”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Tu, Senhor, tens visto isso;","não te cales;","Senhor, não te ausentes de mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Acorda e desperta","para me fazeres justiça!","Defende a minha causa,","Deus meu e Senhor meu."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Julga-me, Senhor, Deus meu,","segundo a tua justiça;","não permitas que se alegrem","à minha custa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Não digam eles lá no seu íntimo:","“Agora, sim! Cumpriu-se","o nosso desejo!”","Não digam: “Acabamos com ele!”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Envergonhem-se e, juntos,","sejam cobertos de vexame","os que se alegram com o meu mal!","Cubram-se de vergonha","e humilhação","os que se engrandecem","contra mim!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Cantem de júbilo e se alegrem","os que têm prazer","na minha retidão!","Que eles digam sempre:","“Glorificado seja o Senhor,","que se compraz na prosperidade","do seu servo!”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["E a minha língua","celebrará a tua justiça","e o teu louvor todo o dia."],"rlw_lines":[]}]}}