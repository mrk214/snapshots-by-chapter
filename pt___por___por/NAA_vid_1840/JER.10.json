    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A idolatria e a verdadeira adoração"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ouçam a palavra que o Senhor dirige a vocês, ó casa de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Não aprendam o caminho",
          "dos gentios,",
          "nem fiquem com medo",
          "dos sinais nos céus,",
          "porque com eles os gentios",
          "se atemorizam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque os costumes dos povos",
          "são vaidade.",
          "Cortam uma árvore do bosque,",
          "e um artífice a trabalha",
          "com o machado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Com prata e ouro a enfeitam,",
          "com pregos e martelos a fixam,",
          "para que não caia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os ídolos são como",
          "um espantalho em pepinal;",
          "eles não falam.",
          "Necessitam de quem os leve,",
          "porque não podem andar.",
          "Não tenham receio deles,",
          "pois não podem fazer mal;",
          "também não podem fazer o bem.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não há ninguém semelhante a ti,",
          "ó Senhor!",
          "Tu és grande, e grande",
          "é o poder do teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quem não temeria a ti,",
          "ó Rei das nações?",
          "Porque isto te é devido.",
          "Porque entre todos os sábios",
          "das nações",
          "e em todo o seu reino",
          "não há ninguém semelhante a ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas todos eles se tornaram",
          "estúpidos e tolos;",
          "seu ensino é vão e morto",
          "como um pedaço de madeira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Traz-se prata batida de Társis",
          "e ouro de Ufaz;",
          "os ídolos são obra de artífice",
          "e de mãos de ourives.",
          "Da cor azul e púrpura",
          "são as vestes deles;",
          "todos eles são obra",
          "de pessoas habilidosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mas o Senhor",
          "é o verdadeiro Deus;",
          "ele é o Deus vivo e o Rei eterno.",
          "A terra treme diante do seu furor,",
          "e as nações não podem suportar",
          "a sua indignação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Digam-lhes o seguinte:",
          "“Os deuses que não fizeram",
          "os céus e a terra",
          "desaparecerão da terra",
          "e de debaixo destes céus.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O Senhor fez a terra",
          "pelo seu poder.",
          "Com a sua sabedoria,",
          "estabeleceu o mundo;",
          "e, com a sua inteligência,",
          "estendeu os céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Quando ele faz soar a sua voz,",
          "logo há tumulto de águas no céu,",
          "e nuvens sobem",
          "das extremidades da terra.",
          "Ele cria os relâmpagos para a chuva",
          "e dos seus depósitos",
          "faz sair o vento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Todas as pessoas são tolas",
          "e não têm conhecimento.",
          "Todo ourives é envergonhado",
          "pela imagem",
          "que ele mesmo esculpiu,",
          "pois as suas imagens são falsas,",
          "e nelas não há fôlego de vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "São vaidade, obras ridículas.",
          "Quando chegar o tempo",
          "do seu castigo, virão a perecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Aquele que é a Porção de Jacó",
          "não é semelhante a essas imagens,",
          "porque ele é o Criador",
          "de todas as coisas",
          "e Israel é a tribo da sua herança.",
          "Senhor dos Exércitos",
          "é o seu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lamento sobre a destruição de Judá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ajunte do chão",
          "os seus pertences,",
          "ó filha de Sião,",
          "você que mora em lugar sitiado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Porque assim diz o Senhor:",
          "“Eis que desta vez lançarei fora",
          "os moradores da terra",
          "e os angustiarei,",
          "para que venham a senti-lo.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ai de mim, por causa",
          "da minha ruína!",
          "A minha ferida é muito grave!",
          "E eu dizia: “Certamente",
          "este é o meu sofrimento,",
          "e eu posso suportá-lo.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "A minha tenda foi destruída,",
          "todas as cordas se romperam.",
          "Os meus filhos se foram",
          "e já não existem;",
          "não restou ninguém",
          "para levantar a minha tenda",
          "e erguer as suas lonas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Porque os pastores",
          "se tornaram tolos",
          "e não buscaram o Senhor;",
          "por isso, não prosperaram,",
          "e todos os seus rebanhos",
          "se acham dispersos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Eis aí um rumor!",
          "Eis que vem grande tumulto",
          "da terra do Norte,",
          "para fazer das cidades de Judá",
          "uma desolação,",
          "morada de chacais."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jeremias ora em favor do seu povo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Eu sei, ó Senhor,",
          "que não cabe ao ser humano",
          "determinar o seu caminho,",
          "nem cabe ao que anda",
          "dirigir os seus passos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Castiga-me, ó Senhor,",
          "mas em justa medida;",
          "não na tua ira, para que",
          "não me reduzas a nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Derrama o teu furor",
          "sobre as nações",
          "que não te conhecem",
          "e sobre os povos",
          "que não invocam o teu nome.",
          "Porque foram eles",
          "que devoraram Jacó;",
          "eles o devoraram, consumiram,",
          "e destruíram as suas moradas."
        ],
        "rlw_lines": []
      }
    ]
  },
