  "book": {
    "book_usfm": "PRO",
    "name": "Provérbios"
  },
  "chapter": {
    "usfm": "PRO.16",
    "human": "Provérbios 16",
    "previous": {
      "usfm": "PRO.15",
      "human": "Provérbios 15"
    },
    "next": {
      "usfm": "PRO.17",
      "human": "Provérbios 17"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O coração do ser humano",
          "pode fazer planos,",
          "mas a resposta certa dos lábios",
          "vem do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Todos os caminhos",
          "de uma pessoa são puros",
          "aos seus próprios olhos,",
          "mas o Senhor sonda o espírito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Entregue as suas obras",
          "ao Senhor,",
          "e o que você tem planejado",
          "se realizará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O Senhor fez todas as coisas",
          "para determinados fins;",
          "até o ímpio, para o dia",
          "da calamidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor detesta todo aquele",
          "que é orgulhoso;",
          "é evidente que este",
          "não ficará impune."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pela misericórdia e pela verdade",
          "se expia a culpa;",
          "e pelo temor do Senhor",
          "se evita o mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Se os caminhos de alguém",
          "são agradáveis ao Senhor,",
          "ele faz com que até",
          "os seus inimigos",
          "vivam em paz com ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Melhor é o pouco, havendo justiça,",
          "do que grandes rendimentos",
          "com injustiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O coração do ser humano",
          "traça o seu caminho,",
          "mas o Senhor lhe dirige os passos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Nos lábios do rei se acham",
          "decisões autorizadas;",
          "que ele seja justo",
          "ao pronunciar uma sentença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Peso e balança justos",
          "pertencem ao Senhor;",
          "obra sua são todos os pesos",
          "da bolsa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Os reis detestam",
          "a prática da maldade,",
          "porque o trono se estabelece",
          "pela justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Os lábios justos",
          "são o contentamento do rei,",
          "e ele ama o que fala coisas retas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O furor do rei é como",
          "um mensageiro da morte,",
          "mas o homem sábio",
          "consegue acalmá-lo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O semblante alegre do rei",
          "significa vida,",
          "e a sua bondade",
          "é como chuva fora de época."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Quanto melhor é adquirir",
          "a sabedoria do que o ouro!",
          "E mais excelente é adquirir",
          "o entendimento",
          "do que a prata!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O caminho dos retos",
          "é desviar-se do mal;",
          "quem guarda o seu caminho",
          "preserva a sua vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Antes da ruína vem a soberba,",
          "e o espírito orgulhoso",
          "precede a queda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Melhor é ser humilde de espírito",
          "com os humildes",
          "do que repartir o despojo",
          "com os orgulhosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Quem atenta para o ensino",
          "acha o bem,",
          "e o que confia no Senhor,",
          "esse é feliz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "O sábio de coração",
          "é chamado prudente,",
          "e a doçura no falar",
          "aumenta o saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "O bom senso, para aqueles",
          "que o possuem, é fonte de vida;",
          "mas a tolice",
          "é a punição dos insensatos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "O coração do sábio",
          "é mestre de sua boca",
          "e aumenta a persuasão",
          "dos seus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Palavras agradáveis",
          "são como favo de mel:",
          "doces para a alma",
          "e remédio para o corpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Há caminho que parece",
          "direito ao ser humano,",
          "mas o fim dele",
          "é caminho de morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "A fome do trabalhador",
          "o faz trabalhar,",
          "porque a sua boca o incita a isso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "O desprezível cava o mal,",
          "e nos seus lábios",
          "há como que fogo ardente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "O perverso semeia discórdias,",
          "e o difamador",
          "separa os maiores amigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "O violento alicia",
          "o seu companheiro",
          "e guia-o por um caminho",
          "que não é bom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Quem pisca os olhos",
          "imagina o mal;",
          "quem morde os lábios o executa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Os cabelos brancos",
          "são uma coroa de honra",
          "que é encontrada",
          "no caminho da justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "É melhor ter paciência",
          "do que ser herói de guerra;",
          "o que domina o seu espírito",
          "é melhor do que",
          "o que conquista uma cidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Para fazer um sorteio",
          "são lançados os dados,",
          "mas toda decisão",
          "procede do Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
