    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O tolo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Como a neve no verão",
          "e como a chuva",
          "no tempo da colheita,",
          "assim a honra",
          "não fica bem a um tolo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como o pássaro que foge",
          "e como a andorinha no seu voo,",
          "assim a maldição sem motivo",
          "não se cumpre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O açoite é para o cavalo,",
          "o freio, para o jumento,",
          "e a vara, para as costas dos tolos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Não responda ao insensato",
          "segundo a sua tolice,",
          "para que você não se torne",
          "semelhante a ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Responda ao insensato",
          "segundo a sua tolice,",
          "para que ele não seja sábio",
          "aos seus próprios olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Como cortar os pés e sofrer dano,",
          "assim é mandar mensagens",
          "por meio de um tolo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "As pernas do coxo",
          "pendem bambas;",
          "assim é o provérbio",
          "na boca dos tolos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como amarrar a pedra na funda,",
          "assim é dar honra a um tolo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Como o espinho que entra",
          "na mão de um bêbado,",
          "assim é o provérbio",
          "na boca dos tolos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Como um flecheiro",
          "que fere a todos,",
          "assim é o que contrata os tolos",
          "e os primeiros que passam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Como o cão que volta",
          "ao seu próprio vômito,",
          "assim é o insensato",
          "que repete a sua tolice."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Você viu alguém que é sábio",
          "aos seus próprios olhos?",
          "Há mais esperança para um tolo",
          "do que para ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O preguiçoso"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O preguiçoso diz:",
          "“Um leão está no caminho!",
          "Um leão está no meio da rua!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "A porta gira nas dobradiças;",
          "o preguiçoso se vira na cama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O preguiçoso",
          "põe a mão no prato",
          "e não quer ter o trabalho",
          "de a levar à boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O preguiçoso é mais sábio",
          "aos seus próprios olhos",
          "do que sete homens",
          "que sabem responder bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Outros provérbios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Quem se mete",
          "na discussão dos outros",
          "é como aquele",
          "que pega pelas orelhas",
          "um cão que vai passando."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Como o louco que lança",
          "fogo, flechas e morte,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "assim é aquele que engana",
          "o seu próximo",
          "e diz: “Fiz isso por brincadeira.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Sem lenha, o fogo se apaga;",
          "e, não havendo difamador,",
          "cessa a discórdia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "O que o carvão é para as brasas",
          "e a lenha é para o fogo,",
          "o briguento é para acender",
          "uma discussão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "As palavras do difamador",
          "são comida fina,",
          "que desce para o mais interior",
          "do ventre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Como vaso de barro",
          "coberto de prata,",
          "assim são os lábios amorosos",
          "e o coração mau."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Quem odeia",
          "dissimula com os lábios,",
          "mas no seu íntimo",
          "esconde a falsidade;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "quando ele vier",
          "com palavras suaves,",
          "não acredite nele,",
          "porque tem sete abominações",
          "em seu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Ainda que o seu ódio se encubra",
          "com falsidade,",
          "a sua maldade será exposta",
          "aos olhos de todos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Quem abre uma cova",
          "acaba caindo nela;",
          "e a pedra rolará sobre quem",
          "a pôs em movimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "A língua falsa odeia",
          "aqueles a quem engana,",
          "e a boca lisonjeira é causa de ruína."
        ],
        "rlw_lines": []
      }
    ]
  },
