  "book": {
    "book_usfm": "PRO",
    "name": "Provérbios"
  },
  "chapter": {
    "usfm": "PRO.15",
    "human": "Provérbios 15",
    "previous": {
      "usfm": "PRO.14",
      "human": "Provérbios 14"
    },
    "next": {
      "usfm": "PRO.16",
      "human": "Provérbios 16"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A resposta branda desvia o furor,",
          "mas a palavra dura suscita a ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "A língua dos sábios",
          "adorna o conhecimento,",
          "mas a boca dos insensatos",
          "derrama tolices."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os olhos do Senhor",
          "estão em todo lugar,",
          "contemplando os maus e os bons."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A língua serena é árvore de vida,",
          "mas a língua perversa",
          "esmaga o espírito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O insensato despreza",
          "a instrução de seu pai,",
          "mas o que aceita a repreensão",
          "consegue a prudência."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Na casa do justo",
          "há grande tesouro,",
          "mas no lucro dos ímpios",
          "há infelicidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "As palavras dos sábios",
          "difundem o conhecimento,",
          "mas o coração dos insensatos",
          "não procede assim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O Senhor detesta",
          "o sacrifício dos ímpios,",
          "mas a oração dos retos",
          "é o seu prazer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O Senhor detesta",
          "o caminho do ímpio,",
          "mas ama o que segue a justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Disciplina rigorosa há",
          "para o que abandona",
          "o caminho,",
          "e quem odeia a repreensão",
          "morrerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O mundo dos mortos e o abismo",
          "estão expostos",
          "diante do Senhor;",
          "quanto mais o coração",
          "dos filhos dos homens!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O zombador não gosta",
          "de quem o repreende,",
          "nem se aproxima dos sábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O coração alegre",
          "embeleza o rosto,",
          "mas com a tristeza do coração",
          "o espírito se abate."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O coração sábio",
          "busca o conhecimento,",
          "mas a boca dos insensatos",
          "se alimenta de estupidez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Para quem está aflito,",
          "todos os dias são maus,",
          "mas a vida de quem",
          "tem o coração alegre",
          "é uma festa contínua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Melhor é o pouco, havendo",
          "o temor do Senhor,",
          "do que um grande tesouro",
          "onde há inquietação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Melhor é um prato de legumes",
          "onde há amor",
          "do que um boi inteiro",
          "acompanhado de ódio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Quem se irrita facilmente",
          "provoca discórdia,",
          "mas quem é tardio em ficar irado",
          "acalma os conflitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "O caminho do preguiçoso",
          "é como que cercado",
          "de espinhos,",
          "mas a vereda dos justos é plana."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O filho sábio alegra o seu pai,",
          "mas o insensato",
          "despreza a sua mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Quem não tem juízo se alegra",
          "com a sua tolice,",
          "mas quem é sábio",
          "anda retamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Sem conselhos",
          "os projetos fracassam,",
          "mas com muitos conselheiros",
          "há sucesso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Que alegria é ter",
          "a resposta adequada!",
          "Como é boa a palavra dita",
          "na hora certa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Para o sábio, o caminho da vida",
          "leva para cima,",
          "para desviar do inferno, embaixo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "O Senhor derruba",
          "a casa dos orgulhosos,",
          "mas preserva a herança da viúva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "O Senhor detesta",
          "os planos dos maus,",
          "mas as palavras bondosas",
          "lhe são aprazíveis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Quem é ávido",
          "por lucro desonesto",
          "arruína a sua casa,",
          "mas o que odeia o suborno,",
          "esse viverá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "O coração do justo medita",
          "o que há de responder,",
          "mas a boca dos ímpios",
          "derrama maldades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "O Senhor está longe dos ímpios,",
          "mas ouve a oração dos justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "O brilho nos olhos",
          "alegra o coração;",
          "uma boa notícia",
          "fortalece até os ossos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Quem dá ouvidos",
          "à repreensão construtiva",
          "terá a sua morada",
          "no meio dos sábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Quem rejeita a disciplina",
          "despreza a si mesmo,",
          "mas o que aceita a repreensão",
          "adquire entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "O temor do Senhor",
          "é instrução na sabedoria,",
          "e a humildade precede a honra."
        ],
        "rlw_lines": []
      }
    ]
  },
