    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Quem fez cada animal com o seu jeito de ser?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Você sabe o tempo em que",
          "as cabras-monteses",
          "têm os filhos",
          "ou cuidou das corças",
          "quando dão suas crias?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pode contar os meses",
          "que cumprem?",
          "Ou sabe o tempo do seu parto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Elas se encurvam",
          "para terem seus filhos,",
          "e lançam de si as suas dores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Seus filhos se tornam robustos,",
          "crescem no campo aberto,",
          "saem e nunca mais voltam",
          "para elas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem pôs em liberdade",
          "o jumento selvagem?",
          "Quem soltou as suas cordas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu lhe dei o deserto por casa",
          "e a terra salgada por morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele se ri do tumulto da cidade,",
          "não ouve os gritos do guia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os montes são o lugar",
          "do seu pasto,",
          "e anda à procura",
          "de tudo o que está verde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Será que o boi selvagem",
          "aceitará trabalhar para você?",
          "Será que ele passará a noite",
          "junto da sua manjedoura?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por acaso você consegue",
          "prendê-lo ao arado",
          "com cordas?",
          "Ou irá ele atrás de você",
          "para desfazer os torrões",
          "nos campos do vale?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Você vai confiar nele,",
          "por causa da grande força",
          "que ele tem,",
          "ou deixará o seu trabalho",
          "por conta dele?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Você acredita que ele trará",
          "para casa o que você semeou",
          "e o recolherá na sua eira?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“A avestruz bate alegre as asas,",
          "como se tivesse asas",
          "e plumagem de cegonha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ela põe os seus ovos no chão",
          "e deixa que sejam chocados",
          "na areia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "e se esquece de que algum pé",
          "os pode esmagar",
          "ou de que os animais do campo",
          "podem pisá-los."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Trata com dureza os seus filhos,",
          "como se não fossem seus.",
          "Embora seja em vão",
          "o seu trabalho,",
          "ela está tranquila,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "porque Deus lhe negou",
          "sabedoria",
          "e não lhe deu entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Mas, quando de um salto",
          "se levanta para correr,",
          "ri do cavalo e do cavaleiro.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "“Por acaso foi você quem deu",
          "força ao cavalo",
          "ou revestiu o seu pescoço",
          "de crinas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "É você quem o faz pular",
          "como gafanhoto?",
          "Terrível é o fogoso respirar",
          "das suas ventas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Escarva no vale,",
          "satisfeito com a sua força,",
          "e sai ao encontro dos inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Zomba do medo",
          "e não se espanta;",
          "não recua por causa da espada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Sobre ele balança a aljava,",
          "cintila a lança e o dardo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Com ímpeto e fúria",
          "vai engolindo as distâncias",
          "e não se contém ao som do clarim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "A cada toque do clarim ele diz:",
          "‘Avante!’",
          "Cheira de longe a batalha,",
          "o grito dos comandantes",
          "e o alarido de guerra.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "“Será que é pela inteligência",
          "que você tem que o falcão voa,",
          "estendendo as suas asas",
          "para o Sul?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Ou é por uma ordem sua",
          "que a águia sobe",
          "e faz o seu ninho lá no alto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Ela mora no penhasco",
          "onde faz a sua morada,",
          "no alto do penhasco,",
          "em lugar seguro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Dali, descobre a presa;",
          "seus olhos a avistam de longe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Seus filhotes chupam sangue;",
          "onde há mortos, ali ela está.”"
        ],
        "rlw_lines": []
      }
    ]
  },
