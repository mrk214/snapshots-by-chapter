    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palavras que, em visão, vieram a Amós, um pastor da cidade de Tecoa, a respeito de Israel. Isso aconteceu nos dias de Uzias, rei de Judá, e nos dias de Jeroboão, filho de Joás, rei de Israel, dois anos antes do terremoto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Amós disse:",
          "“O Senhor rugirá de Sião",
          "e de Jerusalém fará ouvir a sua voz.",
          "Os campos dos pastores",
          "estarão de luto,",
          "e o alto do Carmelo secará.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ameaças contra diversas nações"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Síria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões",
          "de Damasco,",
          "sim, por causa de quatro,",
          "não suspenderei o castigo.",
          "Porque passaram",
          "um instrumento de trilhar",
          "com pontas de ferro sobre Gileade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Por isso, porei fogo",
          "à casa de Hazael,",
          "fogo que consumirá",
          "as fortalezas de Ben-Hadade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quebrarei os ferrolhos",
          "de Damasco",
          "e eliminarei o morador",
          "de Biqueate-Áven",
          "e o que tem o cetro de Bete-Éden.",
          "O povo da Síria será levado",
          "em cativeiro a Quir”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Filístia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões de Gaza,",
          "sim, por causa de quatro,",
          "não suspenderei o castigo.",
          "Porque levaram em cativeiro",
          "todo um povo,",
          "para entregá-lo a Edom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Por isso, porei fogo",
          "nas muralhas de Gaza,",
          "fogo que consumirá",
          "as suas fortalezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eliminarei o morador de Asdode",
          "e o que tem o cetro de Asquelom.",
          "Voltarei a minha mão",
          "contra Ecrom,",
          "e o resto dos filisteus perecerá”,",
          "diz o Senhor Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Tiro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões de Tiro,",
          "sim, por causa de quatro,",
          "não suspenderei o castigo.",
          "Porque levaram em cativeiro",
          "todo um povo,",
          "para entregá-lo a Edom",
          "e não se lembraram",
          "da aliança de irmãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por isso, porei fogo",
          "nas muralhas de Tiro,",
          "fogo que consumirá",
          "as suas fortalezas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Edom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões de Edom,",
          "sim, por causa de quatro,",
          "não suspenderei o castigo.",
          "Porque perseguiu o seu irmão",
          "com a espada",
          "e não teve nenhuma compaixão dele.",
          "A sua ira não cessou",
          "de despedaçar,",
          "e conservou a sua indignação",
          "para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por isso, porei fogo em Temã,",
          "fogo que consumirá",
          "as fortalezas de Bozra.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Amom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por três transgressões",
          "dos filhos de Amom,",
          "sim, por causa de quatro,",
          "não suspenderei o castigo.",
          "Porque rasgaram o ventre",
          "das grávidas",
          "da região de Gileade,",
          "para ampliarem as suas fronteiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Por isso, porei fogo",
          "nas muralhas de Rabá,",
          "fogo que consumirá",
          "as suas fortalezas,",
          "com alarido no dia da batalha,",
          "com turbilhão",
          "no dia da tempestade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O seu rei irá para o cativeiro,",
          "ele e os seus príncipes com ele”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
