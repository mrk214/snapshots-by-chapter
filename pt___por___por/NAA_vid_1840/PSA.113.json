    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvor a Deus pela sua bondade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Louvem, ó servos do Senhor,",
          "louvem o nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bendito seja o nome do Senhor,",
          "agora e para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Do nascimento do sol",
          "até o momento em que se põe,",
          "louvado seja o nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Excelso é o Senhor,",
          "acima de todas as nações,",
          "e a sua glória está acima dos céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem é semelhante ao Senhor,",
          "nosso Deus,",
          "cujo trono está nas alturas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "que se inclina para ver",
          "o que se passa no céu",
          "e sobre a terra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele levanta o pobre do pó",
          "e tira o necessitado",
          "do monte de lixo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "para o fazer sentar",
          "ao lado dos príncipes,",
          "sim, com os príncipes do seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O Senhor faz com que",
          "a mulher estéril viva em família",
          "e seja alegre mãe de filhos.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
