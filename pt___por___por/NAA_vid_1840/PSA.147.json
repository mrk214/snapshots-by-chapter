    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvor ao Deus poderoso"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Bom e amável é cantar louvores",
          "ao nosso Deus;",
          "fica-lhe bem o cântico de louvor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O Senhor edifica Jerusalém",
          "e congrega os dispersos de Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ele sara os que têm",
          "o coração quebrantado",
          "e trata das feridas deles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Conta o número das estrelas,",
          "chamando-as todas",
          "pelo seu nome."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Grande é o Senhor nosso",
          "e mui poderoso;",
          "o seu entendimento",
          "não se pode medir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor ampara os humildes,",
          "mas faz com que os ímpios",
          "caiam por terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cantem ao Senhor",
          "com ações de graças;",
          "ao som da harpa,",
          "cantem louvores ao nosso Deus,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "que cobre de nuvens o céu,",
          "prepara a chuva para a terra,",
          "faz brotar nos montes a erva"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "e dá o alimento aos animais",
          "e aos filhos dos corvos,",
          "quando clamam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Não faz caso da força do cavalo,",
          "nem se compraz",
          "nos músculos do guerreiro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor se agrada",
          "dos que o temem",
          "e dos que esperam",
          "na sua misericórdia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Louve o Senhor, ó Jerusalém!",
          "Louve o seu Deus, ó Sião!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pois ele reforçou",
          "as trancas dos seus portões",
          "e abençoou os que habitam",
          "em seu meio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Estabeleceu a paz",
          "em seu território",
          "e farta você com o melhor do trigo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ele envia as suas ordens à terra,",
          "e sua palavra corre velozmente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Faz cair a neve como lã",
          "e espalha a geada como cinza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Faz cair o seu gelo",
          "como se fossem migalhas;",
          "quem pode resistir ao seu frio?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Manda a sua palavra",
          "e o gelo se derrete;",
          "faz soprar o vento,",
          "e as águas correm."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Anuncia a sua palavra a Jacó,",
          "as suas leis e os seus preceitos,",
          "a Israel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Não fez assim",
          "com nenhuma outra nação;",
          "todas ignoram os seus preceitos.",
          "Aleluia!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
