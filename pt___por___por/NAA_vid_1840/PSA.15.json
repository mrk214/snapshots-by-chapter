    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O que Deus espera do seu povo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, quem habitará",
          "no teu tabernáculo?",
          "Quem poderá morar",
          "no teu santo monte?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Aquele que vive com integridade,",
          "que pratica a justiça,",
          "e, de coração, fala a verdade;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "aquele que não difama",
          "com sua língua,",
          "não faz mal ao próximo,",
          "nem lança injúria",
          "contra o seu vizinho;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "aquele que, a seus olhos,",
          "tem por desprezível",
          "ao que merece reprovação,",
          "mas honra os que temem",
          "o Senhor;",
          "aquele que jura",
          "e cumpre o que prometeu,",
          "mesmo com prejuízo próprio;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "aquele que não empresta",
          "o seu dinheiro com usura,",
          "nem aceita suborno",
          "contra o inocente.",
          "Quem age assim",
          "não será jamais abalado."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
