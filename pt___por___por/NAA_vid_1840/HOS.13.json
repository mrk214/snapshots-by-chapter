    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Castigo definitivo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Quando Efraim falava,",
          "havia tremor;",
          "foi exaltado em Israel.",
          "Mas ele se fez culpado",
          "por causa de Baal e morreu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Agora, pecam cada vez mais,",
          "e da sua prata",
          "fazem imagens de fundição,",
          "ídolos segundo o seu conceito,",
          "todos obra de artífices, e dizem:",
          "‘Ofereçam sacrifícios a eles.’",
          "Chegam até a beijar esses bezerros!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Por isso, serão",
          "como a névoa da manhã,",
          "como o orvalho da madrugada,",
          "que logo desaparece,",
          "como a palha",
          "que o vento leva da eira",
          "e como a fumaça",
          "que sai por uma janela.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Mas eu sou o Senhor, seu Deus,",
          "desde a terra do Egito.",
          "Portanto, vocês não conhecerão",
          "outro deus além de mim,",
          "porque não há salvador, a não ser eu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eu os conheci no deserto,",
          "em terra muito seca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quando tinham comida,",
          "eles se fartaram,",
          "e, uma vez fartos,",
          "seu coração se encheu de orgulho;",
          "por isso, se esqueceram de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Portanto, serei para eles",
          "como um leão;",
          "como um leopardo,",
          "ficarei espreitando no caminho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como ursa,",
          "roubada dos seus filhotes,",
          "eu os atacarei",
          "e lhes rasgarei o peito.",
          "Como leão,",
          "eu os devorarei ali mesmo;",
          "como um animal selvagem,",
          "os farei em pedaços.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“A sua ruína, ó Israel,",
          "vem de você,",
          "e só de mim, o seu socorro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Onde está, agora, o seu rei,",
          "para que o salve",
          "em todas as suas cidades?",
          "E os seus juízes,",
          "dos quais você disse:",
          "‘Dê-me um rei e príncipes’?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eu lhe dei um rei na minha ira,",
          "e o tirei de você no meu furor.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“As iniquidades de Efraim",
          "estão atadas juntas;",
          "o seu pecado está armazenado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "As dores de parto virão,",
          "mas ele é filho insensato;",
          "porque será tempo de nascer,",
          "mas ele não estará no lugar",
          "por onde deve vir ao mundo.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Eu os remirei",
          "do poder do inferno",
          "e os resgatarei da morte.",
          "Onde estão, ó morte,",
          "as suas pragas?",
          "Onde está, ó inferno,",
          "a sua destruição?",
          "Meus olhos estarão fechados",
          "para a compaixão.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "“Ainda que Efraim dê frutos",
          "entre os irmãos,",
          "virá o vento leste, vento do Senhor,",
          "subindo do deserto;",
          "ele secará a sua nascente",
          "e estancará a sua fonte;",
          "ele saqueará o tesouro",
          "de todas as coisas preciosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Samaria levará sobre si",
          "a sua culpa,",
          "porque se rebelou",
          "contra o seu Deus;",
          "cairá à espada,",
          "seus filhos serão despedaçados,",
          "e as suas mulheres grávidas",
          "serão abertas pelo meio.”"
        ],
        "rlw_lines": []
      }
    ]
  },
