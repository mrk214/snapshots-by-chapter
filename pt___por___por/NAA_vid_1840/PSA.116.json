    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Salmo de gratidão"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Amo o Senhor, porque ele ouve",
          "a minha voz e as minhas súplicas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque inclinou para mim",
          "os seus ouvidos,",
          "eu o invocarei por toda a minha vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Laços de morte me cercaram,",
          "e angústias do inferno",
          "se apoderaram de mim;",
          "fiquei aflito e triste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Então invoquei",
          "o nome do Senhor:",
          "“Ó Senhor, livra a minha alma.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Compassivo e justo é o Senhor;",
          "o nosso Deus é misericordioso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor vela pelos simples;",
          "quando eu estava prostrado,",
          "ele me salvou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ó minha alma,",
          "volte ao seu sossego,",
          "pois o Senhor tem sido bom",
          "para você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pois livraste da morte",
          "a minha alma,",
          "das lágrimas, os meus olhos,",
          "da queda, os meus pés."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Andarei na presença do Senhor,",
          "na terra dos viventes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eu cria, mesmo quando eu disse:",
          "“Estou muito aflito.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eu disse na minha perturbação:",
          "“Todas as pessoas são mentirosas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Que darei ao Senhor",
          "por todos os seus benefícios",
          "para comigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Erguerei o cálice da salvação",
          "e invocarei o nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cumprirei os meus votos",
          "ao Senhor,",
          "na presença de todo o seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Preciosa é aos olhos do Senhor",
          "a morte dos seus santos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Senhor, eu sou de fato teu servo;",
          "eu sou teu servo, filho da tua serva;",
          "quebraste as correntes",
          "que me prendiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A ti oferecerei sacrifícios",
          "de ações de graças",
          "e invocarei o nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Cumprirei os meus votos",
          "ao Senhor,",
          "na presença de todo o seu povo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "nos átrios da Casa do Senhor,",
          "em seu meio, ó Jerusalém.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
