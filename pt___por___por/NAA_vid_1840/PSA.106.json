    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A graça de Deus e a ingratidão de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Deem graças ao Senhor,",
          "porque ele é bom,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quem saberá contar",
          "os poderosos feitos do Senhor",
          "ou anunciar todo o seu louvor?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Bem-aventurados",
          "os que guardam a retidão",
          "e os que praticam a justiça",
          "em todo tempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Lembra-te de mim, Senhor,",
          "segundo a tua bondade",
          "para com o teu povo;",
          "visita-me com a tua salvação,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "para que eu veja a prosperidade",
          "dos teus escolhidos,",
          "e me alegre com a alegria",
          "do teu povo,",
          "e me glorie com a tua herança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pecamos, como os nossos pais;",
          "cometemos iniquidade,",
          "procedemos mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nossos pais, no Egito,",
          "não entenderam",
          "as tuas maravilhas;",
          "não se lembraram da multidão",
          "das tuas misericórdias",
          "e foram rebeldes junto ao mar,",
          "o mar Vermelho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas Deus os salvou por amor",
          "do seu nome,",
          "para lhes revelar o seu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Repreendeu o mar Vermelho,",
          "e ele secou;",
          "ele os fez passar pelos abismos,",
          "como por um deserto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Salvou-os das mãos",
          "de quem os odiava",
          "e os resgatou do poder do inimigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "As águas cobriram",
          "os seus opressores;",
          "nem um deles escapou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Então creram nas suas palavras",
          "e lhe cantaram louvor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Logo, porém, se esqueceram",
          "das obras de Deus",
          "e não esperaram",
          "pelos seus desígnios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Entregaram-se à cobiça,",
          "no deserto;",
          "e, nos lugares áridos,",
          "puseram Deus à prova."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Concedeu-lhes o que pediram,",
          "mas enviou-lhes também",
          "uma doença terrível."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tiveram inveja de Moisés,",
          "no acampamento,",
          "e de Arão, o santo do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A terra se abriu, engoliu Datã,",
          "e cobriu o grupo de Abirão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Um fogo se acendeu",
          "contra o grupo deles;",
          "as chamas devoraram os ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Em Horebe, fizeram um bezerro",
          "e adoraram o ídolo",
          "de metal fundido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "E, assim, trocaram",
          "a glória de Deus",
          "pela imagem de um novilho",
          "que come capim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Esqueceram-se de Deus,",
          "seu Salvador,",
          "que, no Egito, havia feito",
          "coisas grandiosas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "maravilhas na terra de Cam,",
          "tremendos feitos no mar Vermelho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Deus os teria exterminado,",
          "como tinha dito,",
          "se Moisés, seu escolhido,",
          "não houvesse intercedido,",
          "impedindo que o seu furor",
          "os destruísse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Também desprezaram",
          "a terra aprazível",
          "e não deram crédito",
          "à palavra de Deus;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "pelo contrário, murmuraram",
          "em suas tendas",
          "e não ouviram a voz do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Então lhes jurou, de mão erguida,",
          "que os havia de arrasar no deserto;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "e também espalharia",
          "entre as nações",
          "a sua descendência",
          "e os dispersaria por outras terras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Também se juntaram a Baal-Peor",
          "e comeram os sacrifícios",
          "dos ídolos mortos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Assim, com tais ações,",
          "provocaram a ira do Senhor;",
          "e a peste se espalhou entre eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Então se levantou Fineias",
          "e executou o juízo;",
          "e a peste cessou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Isso lhe foi atribuído",
          "como justiça,",
          "de geração em geração,",
          "para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Depois, provocaram Deus",
          "nas águas de Meribá,",
          "e, por causa deles, aconteceu",
          "uma desgraça com Moisés,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "pois foram rebeldes",
          "ao Espírito de Deus,",
          "e Moisés falou sem refletir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Não exterminaram os povos,",
          "como o Senhor",
          "lhes havia ordenado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Em vez disso, se mesclaram",
          "com as nações",
          "e aprenderam os seus costumes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Adoraram os seus ídolos,",
          "os quais se tornaram",
          "armadilha para eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Sacrificaram seus filhos",
          "e suas filhas aos demônios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Derramaram sangue inocente,",
          "o sangue de seus filhos e filhas,",
          "que sacrificaram",
          "aos ídolos de Canaã;",
          "e a terra foi contaminada",
          "com sangue."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Assim se contaminaram",
          "com as suas obras",
          "e se prostituíram nos seus feitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Por isso, acendeu-se a ira",
          "do Senhor contra o seu povo,",
          "e ele abominou",
          "a sua própria herança"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "e os entregou",
          "ao poder das nações;",
          "sobre eles dominaram",
          "os que os odiavam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Também os oprimiram",
          "os seus inimigos,",
          "sob cujo poder foram subjugados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Muitas vezes os libertou,",
          "mas eles o provocaram",
          "com os seus planos",
          "e, na sua iniquidade,",
          "foram abatidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Mas Deus olhou para eles",
          "quando estavam angustiados",
          "e lhes ouviu o clamor;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "lembrou-se, a favor deles,",
          "de sua aliança",
          "e se compadeceu,",
          "segundo a multidão",
          "de suas misericórdias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Fez também com que deles",
          "tivessem compaixão",
          "todos os que os levaram cativos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Salva-nos, Senhor, nosso Deus,",
          "e congrega-nos dentre as nações,",
          "para que demos graças",
          "ao teu santo nome",
          "e nos gloriemos no teu louvor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Bendito seja o Senhor,",
          "Deus de Israel,",
          "de eternidade a eternidade;",
          "e todo o povo diga: “Amém!”",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
