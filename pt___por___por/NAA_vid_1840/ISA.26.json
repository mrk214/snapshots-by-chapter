    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cântico de confiança na proteção divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Naquele dia, se entoará este cântico na terra de Judá:",
          "“Temos uma cidade forte,",
          "na qual Deus põe a salvação",
          "como muralha e defesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Abram os portões,",
          "para que entre a nação justa,",
          "que guarda a fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tu, Senhor, conservarás",
          "em perfeita paz",
          "aquele cujo propósito é firme,",
          "porque ele confia em ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Confiem sempre no Senhor,",
          "porque o Senhor Deus",
          "é uma rocha eterna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele derruba os que habitam",
          "no alto, na cidade elevada;",
          "derruba e humilha",
          "até o chão, até o pó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O pé a pisará; os pés dos aflitos,",
          "e os passos dos pobres.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A vereda do justo é plana;",
          "tu, que és justo,",
          "aplanas a vereda do justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Também através dos teus juízos,",
          "Senhor, te esperamos;",
          "no teu nome e na tua memória",
          "está o desejo da nossa alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Com minha alma suspiro",
          "de noite por ti",
          "e, com o meu espírito",
          "dentro de mim,",
          "eu te busco ansiosamente.",
          "Porque, quando os teus juízos",
          "reinam na terra,",
          "os moradores do mundo",
          "aprendem a justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ainda que se mostre favor",
          "ao ímpio,",
          "nem por isso ele aprende a justiça;",
          "até na terra da retidão",
          "ele comete a iniquidade",
          "e não vê a majestade do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Senhor, a tua mão está levantada,",
          "mas eles não a veem!",
          "Porém eles verão",
          "o teu zelo pelo povo",
          "e ficarão envergonhados.",
          "Que o teu furor, por causa",
          "dos teus adversários,",
          "os consuma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Senhor, concede-nos a paz,",
          "porque todas as nossas obras",
          "tu as fazes por nós."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ó Senhor, nosso Deus,",
          "outros senhores têm tido domínio",
          "sobre nós,",
          "mas nós louvamos unicamente",
          "o teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Eles estão mortos,",
          "não voltarão a viver;",
          "são apenas sombras,",
          "não ressuscitarão.",
          "Porque tu os castigaste e destruíste,",
          "e apagaste completamente",
          "a lembrança deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Tu, Senhor, aumentaste o povo,",
          "aumentaste o povo",
          "e tens sido glorificado;",
          "alargaste todas as fronteiras do país."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Senhor, na angústia te buscaram;",
          "vindo sobre eles a tua correção,",
          "derramaram as suas orações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Como a mulher grávida",
          "que vai dar à luz",
          "se contorce e grita de dor,",
          "assim estávamos nós",
          "na tua presença,",
          "ó Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Concebemos e nos contorcemos",
          "em dores de parto,",
          "mas o que demos à luz foi vento;",
          "não trouxemos à terra",
          "livramento algum,",
          "e não nasceram",
          "moradores do mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Os teus mortos",
          "e também o meu cadáver",
          "viverão e ressuscitarão.",
          "Despertem e cantem de alegria,",
          "vocês que habitam no pó,",
          "porque o teu orvalho, ó Deus,",
          "será como o orvalho de vida,",
          "e a terra dará à luz os seus mortos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Castigo e salvação"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Meu povo,",
          "entrem nos seus quartos",
          "e tranquem as portas;",
          "escondam-se por um momento,",
          "até que passe a ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Pois eis que o Senhor",
          "sai do seu lugar,",
          "para castigar a iniquidade",
          "dos moradores da terra.",
          "A terra deixará aparecer",
          "o sangue que embebeu",
          "e não encobrirá mais",
          "aqueles que foram mortos."
        ],
        "rlw_lines": []
      }
    ]
  },
