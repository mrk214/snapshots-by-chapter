{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PRO","name":"Provérbios"},"chapter":{"chapter_usfm":"PRO.11","is_chapter":true,"previous":{"usfm":"PRO.10","human":"Provérbios 10","canonical":true,"toc":true},"current":{"usfm":"PRO.11","human":"Provérbios 11"},"next":{"usfm":"PRO.12","human":"Provérbios 12","canonical":true,"toc":true},"items":[{"type":"verse","verse_numbers":[1],"lines":["O Senhor detesta","balanças desonestas,","mas o peso justo é o seu prazer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Quando vem a soberba,","a desgraça não tarda,","mas com os humildes","está a sabedoria."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["A integridade dos retos os guia,","mas a falsidade dos infiéis","os destruirá."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["As riquezas não servem para nada","no dia da ira,","mas a justiça livra da morte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["A justiça do íntegro","endireita o seu caminho,","mas o ímpio cai","pela sua impiedade."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["A justiça dos retos os livrará,","mas os infiéis serão apanhados","na sua própria ambição."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Quando morre o ímpio,","morre a sua esperança,","e o que ele esperava do seu poder","se dissipa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["O justo é libertado da angústia,","mas o ímpio a recebe","em lugar dele."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["O ímpio destrói o próximo","com o que diz,","mas os justos são libertados","pelo conhecimento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["A cidade se alegra","com o bem-estar dos justos,","mas dá gritos de alegria","quando perecem os ímpios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Pela bênção dos retos","a cidade é exaltada,","mas pela boca dos ímpios","é destruída."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Quem fala mal do seu próximo","não tem juízo;","o homem prudente se cala."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["O mexeriqueiro","revela os segredos,","mas o fiel de espírito os encobre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Não havendo direção sábia,","o povo fracassa;","com muitos conselheiros,","há segurança."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Quem fica por fiador","de um estranho","acaba tendo um problema,","mas o que foge de ser fiador","estará seguro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["A mulher bondosa","alcança honra;","os poderosos","adquirem riqueza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["O homem bondoso","faz bem a si mesmo,","mas o cruel fere a si mesmo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["O ímpio recebe","um salário ilusório,","mas o que semeia justiça","terá recompensa verdadeira."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Tão certo como a justiça","conduz para a vida,","quem segue o mal","caminha para a morte."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["O Senhor detesta","os perversos de coração,","mas os que andam","com integridade","são o seu prazer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["É evidente que os maus","serão castigados,","mas a geração dos justos","será poupada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Como joia de ouro","em focinho de porco,","assim é a mulher bonita","que não tem juízo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["O desejo dos justos tende","somente para o bem,","mas a expectativa dos ímpios","resulta em ira."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Uns dão com generosidade","e têm cada vez mais;","outros retêm mais do que é justo","e acabam na pobreza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["A pessoa generosa prosperará,","e quem dá de beber","terá a sua sede saciada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["O povo amaldiçoa","quem retém o trigo,","mas bênção virá sobre a cabeça","daquele que o vende."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Quem procura o bem","alcança favor;","quem corre atrás do mal","acaba encontrando","o que procura."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Quem confia","nas suas riquezas cairá,","mas os justos reverdecerão","como as folhagens."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Aquele que perturba a sua casa","herdará o vento,","e o insensato será servo","do sábio de coração."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["O fruto do justo é árvore de vida,","e o que ganha almas é sábio."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Se o justo é punido na terra,","quanto mais o ímpio e o pecador!"],"rlw_lines":[]}]}}