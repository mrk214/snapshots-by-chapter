    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pedindo a ajuda de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo didático. Para instrumentos de cordas. De Davi, quando os zifeus foram dizer a Saul: “Não está Davi escondido entre nós?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, salva-me, pelo teu nome,",
          "e faze-me justiça pelo teu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Escuta, ó Deus, a minha oração,",
          "dá ouvidos às palavras",
          "da minha boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois contra mim se levantam",
          "os insolentes,",
          "e os violentos procuram",
          "tirar-me a vida;",
          "eles não têm Deus diante de si."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eis que Deus é o meu ajudador,",
          "o Senhor é quem",
          "me sustenta a vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele retribuirá o mal",
          "aos meus inimigos.",
          "Por tua fidelidade,",
          "acaba com eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu te oferecerei sacrifícios",
          "voluntariamente;",
          "louvarei o teu nome, ó Senhor,",
          "porque é bom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pois ele me livrou",
          "de todas as minhas aflições;",
          "e os meus olhos viram",
          "a ruína dos meus inimigos."
        ],
        "rlw_lines": []
      }
    ]
  },
