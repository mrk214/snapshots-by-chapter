    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cântico de Davi em ação de graças"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Davi falou ao Senhor as palavras deste cântico, no dia em que o Senhor o livrou das mãos de todos os seus inimigos e das mãos de Saul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele disse:",
          "“O Senhor é a minha rocha,",
          "a minha fortaleza,",
          "o meu libertador;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "o meu Deus, o meu rochedo",
          "em que me refugio;",
          "o meu escudo, a força",
          "da minha salvação,",
          "o meu alto refúgio.",
          "Ó Deus, tu me salvas da violência."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Invoco o Senhor,",
          "digno de ser louvado,",
          "e serei salvo dos meus inimigos.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Porque ondas de morte",
          "me cercaram,",
          "torrentes de perdição",
          "me impuseram terror."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cadeias infernais",
          "me envolveram,",
          "e tramas de morte",
          "me surpreenderam.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Na minha angústia,",
          "invoquei o Senhor;",
          "gritei por socorro ao meu Deus.",
          "Do seu templo ele ouviu",
          "a minha voz,",
          "e o meu clamor",
          "chegou aos seus ouvidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Então a terra se abalou e tremeu;",
          "vacilaram também",
          "os fundamentos dos céus",
          "e se abalaram,",
          "porque ele estava irado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Das suas narinas subiu fumaça,",
          "e fogo devorador",
          "saiu da sua boca;",
          "dele saíram brasas ardentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ele baixou os céus e desceu,",
          "e teve sob os pés densa escuridão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Cavalgava um querubim e voou;",
          "foi levado sobre as asas do vento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por abrigo",
          "pôs ao redor de si trevas,",
          "ajuntamento de águas,",
          "nuvens dos céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Do resplendor",
          "que diante dele havia,",
          "brasas de fogo se acenderam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor trovejou",
          "desde os céus;",
          "o Altíssimo levantou a sua voz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Atirou as suas flechas",
          "e espalhou os meus inimigos;",
          "multiplicou os seus raios",
          "e os dispersou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Então se viu o leito do mar,",
          "e se descobriram os fundamentos",
          "do mundo,",
          "pela repreensão do Senhor,",
          "pelo sopro irado das suas narinas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Do alto o Senhor me estendeu",
          "a mão e me segurou;",
          "ele me tirou das águas profundas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Livrou-me de forte inimigo",
          "e dos que me odiavam,",
          "pois eram mais poderosos",
          "do que eu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Eles me atacaram",
          "no dia da minha calamidade,",
          "mas o Senhor me serviu",
          "de amparo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Trouxe-me para um lugar",
          "espaçoso;",
          "livrou-me, porque ele se agradou",
          "de mim.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "“O Senhor me retribuiu",
          "segundo a minha justiça;",
          "recompensou-me conforme",
          "a pureza das minhas mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Pois tenho guardado",
          "os caminhos do Senhor",
          "e não me afastei perversamente",
          "do meu Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Porque todos os seus juízos",
          "estão diante de mim,",
          "e não rejeitei os seus preceitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Também fui íntegro para com ele",
          "e me guardei da iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Por isso, o Senhor me retribuiu",
          "segundo a minha justiça,",
          "conforme a minha pureza,",
          "na sua presença.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "“Para com quem é fiel,",
          "fiel te mostras;",
          "com o íntegro, também íntegro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Com o puro, puro te mostras;",
          "com o perverso, inflexível."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Tu salvas o povo humilde,",
          "mas, com um lance de vista,",
          "abates os orgulhosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Tu, Senhor,",
          "és a minha lâmpada;",
          "o Senhor derrama luz",
          "nas minhas trevas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Pois contigo posso",
          "atacar exércitos,",
          "com o meu Deus salto muralhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "O caminho de Deus é perfeito;",
          "a palavra do Senhor é confiável;",
          "ele é escudo para todos os que",
          "nele se refugiam.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "“Pois quem é Deus",
          "além do Senhor?",
          "E quem é rochedo,",
          "a não ser o nosso Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Deus é a minha fortaleza",
          "e a minha força",
          "e ele aperfeiçoa o meu caminho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Ele deu aos meus pés",
          "a ligeireza das corças",
          "e me firmou nas minhas alturas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Ele treinou as minhas mãos",
          "para o combate,",
          "tanto que os meus braços",
          "vergaram um arco de bronze."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Também me deste",
          "o escudo da tua salvação,",
          "e a tua clemência me engrandeceu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Alargaste o caminho",
          "sob meus passos,",
          "e os meus pés não vacilaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Persegui os meus inimigos",
          "e os derrotei,",
          "e só voltei depois de ter acabado",
          "com eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Acabei com eles, esmagando-os",
          "a tal ponto, que não puderam",
          "se levantar;",
          "caíram sob os meus pés."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Pois me cingiste",
          "de força para o combate",
          "e me submeteste os que",
          "se levantaram contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Também puseste em fuga",
          "os meus inimigos,",
          "e os que me odiavam,",
          "eu os exterminei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Olharam, mas não houve",
          "quem os salvasse;",
          "olharam para o Senhor,",
          "mas ele não respondeu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Então os moí",
          "como o pó da terra;",
          "esmaguei-os e, como a lama",
          "das ruas, os amassei.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "“Dos conflitos do meu povo",
          "me livraste",
          "e me fizeste cabeça das nações;",
          "um povo que eu não conhecia",
          "me serviu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Os estrangeiros se mostram",
          "submissos a mim;",
          "bastou-lhes ouvir a minha voz,",
          "logo me obedeceram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Os estrangeiros fraquejaram",
          "e, tremendo, saíram",
          "das suas fortalezas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "“O Senhor vive!",
          "Bendita seja a minha rocha!",
          "Exaltado seja o meu Deus,",
          "a rocha da minha salvação!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "O Deus que por mim tomou",
          "vingança",
          "e me submeteu povos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "o Deus que me tirou",
          "do meio dos meus inimigos;",
          "sim, tu que me exaltaste",
          "acima dos meus adversários",
          "e me livraste",
          "dos homens violentos.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "“Por isso, eu te glorificarei",
          "entre os gentios, ó Senhor,",
          "e cantarei louvores ao teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "É ele quem dá grandes vitórias",
          "ao seu rei",
          "e usa de misericórdia",
          "para com o seu ungido,",
          "com Davi e sua posteridade,",
          "para sempre.”"
        ],
        "rlw_lines": []
      }
    ]
  },
