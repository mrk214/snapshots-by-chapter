    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Com Deus não temeremos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O Senhor é a minha luz",
          "e a minha salvação;",
          "de quem terei medo?",
          "O Senhor é a fortaleza",
          "da minha vida;",
          "a quem temerei?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quando malfeitores",
          "me sobrevêm",
          "para me destruir,",
          "meus opressores e inimigos,",
          "eles é que tropeçam e caem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ainda que um exército",
          "se acampe contra mim,",
          "não se atemorizará",
          "o meu coração;",
          "e, se estourar contra mim a guerra,",
          "ainda assim terei confiança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Uma coisa peço ao Senhor",
          "e a buscarei:",
          "que eu possa morar",
          "na Casa do Senhor",
          "todos os dias da minha vida,",
          "para contemplar",
          "a beleza do Senhor",
          "e meditar no seu templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois, no dia da adversidade,",
          "ele me ocultará no seu abrigo;",
          "no interior do seu tabernáculo,",
          "me acolherá;",
          "ele me porá no alto de uma rocha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Agora, será exaltada",
          "a minha cabeça",
          "acima dos inimigos",
          "que me cercam.",
          "No seu tabernáculo, oferecerei",
          "sacrifícios de júbilo;",
          "cantarei e salmodiarei ao Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ouve, Senhor, a minha voz;",
          "eu clamo;",
          "tem compaixão de mim",
          "e responde-me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ao meu coração me ocorre:",
          "“Busquem a minha presença.”",
          "Buscarei, pois, Senhor,",
          "a tua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não me escondas, Senhor,",
          "a tua face;",
          "não rejeites com ira o teu servo.",
          "Tu és o meu auxílio;",
          "não me deixes,",
          "nem me abandones,",
          "ó Deus da minha salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque, se o meu pai",
          "e a minha mãe",
          "me abandonarem,",
          "o Senhor me acolherá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ensina-me, Senhor,",
          "o teu caminho",
          "e guia-me por vereda plana,",
          "por causa dos meus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Não me entregues à vontade",
          "dos meus adversários;",
          "pois contra mim se levantam",
          "falsas testemunhas",
          "e os que só respiram crueldade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Eu creio que verei",
          "a bondade do Senhor",
          "na terra dos viventes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Espere no Senhor.",
          "Anime-se, e fortifique-se",
          "o seu coração;",
          "espere, pois, no Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
