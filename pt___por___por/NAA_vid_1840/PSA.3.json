    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confiança na salvação de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi quando fugia de Absalão, seu filho"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, como tem crescido",
          "o número",
          "dos meus adversários!",
          "São numerosos os que",
          "se levantam contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "São muitos os que dizem de mim:",
          "“Não há em Deus",
          "salvação para ele.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porém tu, Senhor,",
          "és o meu escudo protetor,",
          "és a minha glória",
          "e o que exalta a minha cabeça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Com a minha voz",
          "clamo ao Senhor,",
          "e ele do seu santo monte",
          "me responde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eu me deito e pego no sono;",
          "acordo, porque o Senhor",
          "me sustenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não tenho medo dos milhares",
          "que tomam posição contra mim",
          "de todos os lados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Levanta-te, Senhor!",
          "Salva-me, Deus meu,",
          "pois desferes um golpe no queixo",
          "de todos os meus inimigos",
          "e quebras os dentes dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Do Senhor é a salvação.",
          "A tua bênção esteja",
          "sobre o teu povo!"
        ],
        "rlw_lines": []
      }
    ]
  },
