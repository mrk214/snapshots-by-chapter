    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Apelo por auxílio divino"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Dos filhos de Corá. Salmo didático"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, nós ouvimos",
          "com os próprios ouvidos;",
          "nossos pais nos contaram",
          "o que fizeste outrora, em seus dias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Com a tua mão",
          "expulsaste as nações",
          "e estabeleceste os nossos pais;",
          "afligiste os povos",
          "e ampliaste o território",
          "de nossos pais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois não foi por sua espada",
          "que eles conquistaram a terra,",
          "nem foi o seu braço",
          "que lhes deu vitória,",
          "e sim a tua mão poderosa,",
          "e o teu braço,",
          "e a luz do teu rosto,",
          "porque te agradaste deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tu és o meu rei, ó Deus;",
          "ordena a vitória de Jacó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Com o teu auxílio,",
          "vencemos os nossos inimigos;",
          "em teu nome, pisamos sobre",
          "os que se levantam contra nós."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não confio no meu arco,",
          "e não é a minha espada",
          "que me salva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pois tu nos salvaste",
          "dos nossos inimigos",
          "e cobriste de vergonha",
          "os que nos odeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Em Deus, nos temos gloriado",
          "continuamente",
          "e para sempre louvaremos",
          "o teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Agora, porém, tu nos rejeitaste",
          "e nos expuseste à vergonha,",
          "e já não acompanhas",
          "os nossos exércitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tu nos fazes bater em retirada",
          "diante dos nossos inimigos,",
          "e os que nos odeiam",
          "nos tomam por seu despojo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Entregaste-nos como ovelhas",
          "para o matadouro",
          "e nos espalhaste entre as nações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Vendes por nada o teu povo",
          "e não tens lucro com a sua venda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tu nos fazes objeto de deboche",
          "para os nossos vizinhos,",
          "de escárnio e de zombaria",
          "aos que nos rodeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tu fazes de nós provérbio",
          "entre as nações;",
          "os povos nos veem",
          "e balançam a cabeça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "A minha humilhação",
          "está sempre diante de mim;",
          "o meu rosto se cobre de vergonha,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "ante os gritos do que afronta",
          "e blasfema,",
          "à vista do inimigo e do vingador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tudo isso nos sobreveio;",
          "entretanto, não nos esquecemos",
          "de ti,",
          "nem fomos infiéis à tua aliança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "O nosso coração",
          "não voltou atrás,",
          "nem os nossos passos",
          "se desviaram",
          "dos teus caminhos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "para nos esmagares",
          "onde vivem os chacais",
          "e nos envolveres",
          "com as sombras da morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Se tivéssemos esquecido",
          "o nome do nosso Deus",
          "ou se tivéssemos estendido",
          "as mãos a um deus estranho,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "será que Deus",
          "não teria descoberto isso,",
          "ele, que conhece",
          "os segredos dos corações?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Mas, por amor de ti,",
          "somos entregues",
          "à morte continuamente,",
          "somos considerados como ovelhas",
          "para o matadouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Desperta! Por que dormes,",
          "Senhor?",
          "Desperta! Não nos rejeites",
          "para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Por que escondes o rosto",
          "e te esqueces da nossa miséria",
          "e da nossa opressão?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Pois a nossa alma",
          "está abatida até o pó,",
          "e o nosso corpo está",
          "como que pegado no chão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Levanta-te para socorrer-nos;",
          "resgata-nos por amor",
          "da tua bondade."
        ],
        "rlw_lines": []
      }
    ]
  },
