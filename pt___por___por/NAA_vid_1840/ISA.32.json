    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Um reinado de justiça"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eis aí um rei que irá reinar",
          "com justiça,",
          "e príncipes que irão governar",
          "com retidão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cada um deles servirá",
          "de esconderijo contra o vento,",
          "de refúgio contra a tempestade,",
          "de torrentes de água",
          "em lugares secos",
          "e de sombra de uma grande rocha",
          "em terra sedenta."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os olhos dos que veem",
          "não se fecharão,",
          "e os ouvidos dos que ouvem",
          "estarão atentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O coração dos apressados",
          "saberá compreender,",
          "e a língua dos gagos",
          "falará com rapidez e clareza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O tolo nunca mais",
          "será chamado de nobre,",
          "e do fraudulento nunca mais",
          "se dirá que é generoso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque o tolo fala tolices,",
          "e o seu coração só pensa",
          "em fazer o mal,",
          "para praticar a iniquidade",
          "e para proferir mentiras",
          "contra o Senhor,",
          "para deixar o faminto sem comida",
          "e o sedento sem ter o que beber."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quanto ao fraudulento,",
          "os seus projetos são maus.",
          "Ele planeja intrigas para,",
          "com palavras mentirosas,",
          "arruinar os necessitados,",
          "mesmo quando a causa dos pobres",
          "é justa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas o nobre projeta coisas nobres",
          "e pela sua nobreza",
          "se mantém em pé."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertências contra as mulheres de Jerusalém"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Vocês, mulheres",
          "que vivem tranquilas,",
          "levantem-se e ouçam a minha voz;",
          "e vocês, filhas que estão confiantes,",
          "escutem o que vou dizer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Daqui a pouco mais de um ano,",
          "vocês, que estão confiantes,",
          "vão tremer de medo,",
          "porque a vindima se acabará,",
          "e não haverá colheita."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Vocês, mulheres",
          "que vivem tranquilas,",
          "comecem a sentir pavor;",
          "e vocês, que estão confiantes,",
          "tremam de medo.",
          "Tirem as suas roupas, fiquem nuas,",
          "e vistam-se de pano de saco."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Batam no peito e chorem",
          "por causa dos campos aprazíveis",
          "e por causa das vinhas frutíferas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sobre a terra do meu povo",
          "virão espinheiros",
          "e ervas daninhas.",
          "Chorem também por causa",
          "de todas as casas",
          "onde há júbilo,",
          "na cidade cheia de alegria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O palácio será abandonado,",
          "a cidade populosa ficará deserta.",
          "Ofel e a torre da guarda",
          "servirão de cavernas",
          "para sempre,",
          "para alegria dos jumentos selvagens",
          "e pastagem dos rebanhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Isso será assim",
          "até que se derrame",
          "sobre nós o Espírito lá do alto.",
          "Então o deserto",
          "se tornará em pomar,",
          "e o pomar será tido por bosque;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "a retidão habitará no deserto,",
          "e a justiça morará no pomar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O efeito da justiça será paz,",
          "e o fruto da justiça será repouso",
          "e segurança, para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "O meu povo habitará",
          "em moradas de paz,",
          "em moradas bem seguras",
          "e em lugares quietos e tranquilos,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "mesmo que haja granizo,",
          "caia o bosque",
          "e a cidade seja",
          "inteiramente arrasada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Bem-aventurados são vocês,",
          "que semeiam junto a todas as águas",
          "e deixam os bois e jumentos",
          "pastar em liberdade."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
