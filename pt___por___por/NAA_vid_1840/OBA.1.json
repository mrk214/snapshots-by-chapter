    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Visão de Obadias."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus castigará Edom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Assim diz o Senhor Deus a respeito de Edom:",
          "“Ouvimos uma notícia",
          "vinda do Senhor,",
          "e um mensageiro foi enviado",
          "às nações para dizer:",
          "‘Preparem-se! Preparem-se",
          "para a guerra contra Edom!’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Eis que fiz de você uma nação",
          "pequena entre as outras,",
          "muito desprezada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O orgulho do seu coração",
          "o enganou.",
          "Você vive nas fendas das rochas,",
          "num lugar elevado,",
          "e diz em seu íntimo:",
          "‘Quem poderá me jogar",
          "lá para baixo?’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ainda que você suba",
          "como a águia",
          "e faça o seu ninho",
          "entre as estrelas,",
          "de lá eu o derrubarei”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Se ladrões o atacassem",
          "ou assaltantes viessem de noite",
          "— como você está destruído! —",
          "não levariam só",
          "o que lhes bastasse?",
          "Se fossem até você",
          "os que colhem uvas,",
          "não deixariam",
          "pelo menos alguns cachos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Como foram saqueados",
          "os bens de Esaú!",
          "Como foram vasculhados",
          "os seus tesouros escondidos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todos os seus aliados, ó Edom,",
          "o empurraram para fora",
          "do seu território.",
          "Aqueles que estavam em paz",
          "com você",
          "o enganaram e prevaleceram",
          "contra você.",
          "Aqueles que sentam à sua mesa",
          "prepararam uma armadilha",
          "para os seus pés.",
          "E não há em Edom entendimento.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Naquele dia”,",
          "diz o Senhor,",
          "“destruirei os sábios de Edom",
          "e o entendimento",
          "do monte de Esaú."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os seus valentes, ó Temã,",
          "ficarão apavorados,",
          "para que, do monte de Esaú,",
          "todos sejam exterminados",
          "pela matança.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A violência de Edom contra Jacó"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Por causa da violência feita",
          "ao seu irmão Jacó,",
          "você ficará coberto de vergonha",
          "e será exterminado para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "No dia em que estranhos",
          "levaram os bens",
          "de seu irmão Jacó,",
          "você estava presente;",
          "quando estrangeiros entraram",
          "pelos portões",
          "e lançaram sortes sobre Jerusalém,",
          "você mesmo era um deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Você não devia ter olhado",
          "com prazer",
          "para o dia do seu irmão,",
          "o dia da sua calamidade.",
          "Você não devia ter-se alegrado",
          "pelo que aconteceu",
          "com os filhos de Judá,",
          "no dia da sua ruína.",
          "Você não devia ter falado",
          "de boca cheia,",
          "no dia da angústia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Você não devia ter entrado",
          "pelo portão do meu povo,",
          "no dia da sua calamidade.",
          "Você não devia ter olhado",
          "com prazer para o seu mal,",
          "no dia da sua calamidade.",
          "Você não devia ter posto as mãos",
          "sobre os seus bens,",
          "no dia da sua calamidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Você não devia ter parado",
          "nas encruzilhadas,",
          "para exterminar",
          "os que escapassem.",
          "Você não devia ter entregado",
          "ao inimigo",
          "os que escaparam com vida,",
          "no dia da angústia.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A restauração e a felicidade de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "“Porque o Dia do Senhor",
          "está prestes a vir",
          "sobre todas as nações.",
          "Você será tratado da mesma forma",
          "como tratou os outros;",
          "o mal que você fez",
          "cairá sobre a sua cabeça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque, assim como vocês",
          "beberam no meu santo monte,",
          "assim todas as nações",
          "beberão sem parar;",
          "irão beber, engolir,",
          "e serão como se",
          "nunca tivessem existido.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Mas, no monte Sião,",
          "haverá livramento.",
          "O monte será santo,",
          "e os da casa de Jacó tomarão posse",
          "de sua herança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "A casa de Jacó será fogo",
          "e a casa de José será chama,",
          "mas a casa de Esaú será a palha.",
          "O fogo e a chama incendiarão",
          "a palha",
          "e a consumirão;",
          "e ninguém mais restará",
          "da casa de Esaú,",
          "porque o Senhor o falou.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "“Os de Neguebe tomarão posse",
          "do monte de Esaú,",
          "e os da Sefelá ocuparão",
          "o território dos filisteus;",
          "tomarão posse também",
          "dos campos de Efraim",
          "e dos campos de Samaria;",
          "e Benjamim tomará posse",
          "de Gileade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Os cativos do exército",
          "dos filhos de Israel",
          "tomarão posse do território",
          "dos cananeus até Sarepta,",
          "e os cativos de Jerusalém,",
          "que estão em Sefarade,",
          "tomarão posse das cidades do Sul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Salvadores hão de subir",
          "ao monte Sião,",
          "para julgarem o monte de Esaú;",
          "e o reino será do Senhor.”"
        ],
        "rlw_lines": []
      }
    ]
  },
