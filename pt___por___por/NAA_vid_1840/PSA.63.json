    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sede de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi, quando estava no deserto de Judá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, tu és o meu Deus;",
          "eu te busco ansiosamente.",
          "A minha alma tem sede de ti;",
          "meu corpo te almeja,",
          "como terra árida,",
          "exausta e sem água."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Assim, quero ver-te no santuário,",
          "para contemplar a tua força",
          "e a tua glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque a tua graça",
          "é melhor do que a vida;",
          "os meus lábios te louvam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Assim, eu te bendirei",
          "enquanto viver;",
          "em teu nome, levanto as mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Como de saborosa comida,",
          "assim se farta a minha alma;",
          "e, com júbilo nos lábios,",
          "a minha boca te louva,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "no meu leito,",
          "quando de ti me recordo",
          "e em ti medito,",
          "durante as vigílias da noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque tu tens sido o meu auxílio;",
          "à sombra das tuas asas,",
          "eu canto de alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A minha alma apega-se a ti;",
          "a tua mão direita me ampara."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porém os que procuram",
          "destruir a minha vida",
          "descerão às profundezas da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Serão entregues",
          "ao poder da espada",
          "e virão a ser pasto dos chacais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mas o rei se alegrará em Deus;",
          "quem por ele jura se gloriará,",
          "pois se tapará a boca",
          "dos que proferem mentira."
        ],
        "rlw_lines": []
      }
    ]
  },
