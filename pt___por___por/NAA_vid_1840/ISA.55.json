    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O convite gracioso de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Ah! Todos vocês que têm sede,",
          "venham às águas;",
          "e vocês que não têm dinheiro,",
          "venham, comprem e comam!",
          "Sim, venham e comprem,",
          "sem dinheiro e sem preço,",
          "vinho e leite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Por que vocês gastam o dinheiro",
          "naquilo que não é pão,",
          "e o seu suor,",
          "naquilo que não satisfaz?",
          "Ouçam com atenção o que eu digo,",
          "comam o que é bom",
          "e vocês irão saborear",
          "comidas deliciosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Deem ouvidos e venham a mim;",
          "escutem, e vocês viverão.",
          "Porque farei uma aliança eterna",
          "com vocês,",
          "que consiste nas fiéis misericórdias",
          "prometidas a Davi."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eis que eu fiz dele",
          "uma testemunha aos povos,",
          "um príncipe",
          "e governador dos povos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eis que você chamará uma nação",
          "que você não conhece,",
          "e uma nação",
          "que nunca o conheceu",
          "virá correndo para junto de você,",
          "por causa do Senhor, seu Deus,",
          "e do Santo de Israel,",
          "porque este o glorificou.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Busquem o Senhor",
          "enquanto ele pode",
          "ser encontrado;",
          "invoquem-no",
          "enquanto ele está perto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que o ímpio abandone",
          "o seu mau caminho,",
          "e o homem mau,",
          "os seus pensamentos;",
          "converta-se ao Senhor,",
          "que se compadecerá dele,",
          "e volte-se para o nosso Deus,",
          "porque é rico em perdoar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Porque os meus pensamentos",
          "não são os pensamentos",
          "de vocês,",
          "e os caminhos de vocês",
          "não são os meus caminhos”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“Porque, assim como os céus",
          "são mais altos do que a terra,",
          "assim os meus caminhos",
          "são mais altos do que os seus caminhos,",
          "e os meus pensamentos",
          "são mais altos do que",
          "os pensamentos de vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque, assim como a chuva",
          "e a neve descem dos céus",
          "e para lá não voltam,",
          "sem que primeiro reguem a terra,",
          "e a fecundem, e a façam brotar,",
          "para dar semente ao semeador",
          "e pão ao que come,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "assim será a palavra",
          "que sair da minha boca:",
          "não voltará para mim vazia,",
          "mas fará o que me apraz",
          "e prosperará naquilo",
          "para que a designei.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Vocês sairão com alegria",
          "e em paz serão guiados;",
          "os montes e as colinas",
          "romperão em cânticos",
          "diante de vocês,",
          "e todas as árvores do campo",
          "baterão palmas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Em lugar do espinheiro,",
          "crescerá o cipreste,",
          "e em lugar da sarça",
          "crescerá a murta.",
          "E isso será glória",
          "para o Senhor",
          "e sinal eterno,",
          "que nunca se apagará.”"
        ],
        "rlw_lines": []
      }
    ]
  },
