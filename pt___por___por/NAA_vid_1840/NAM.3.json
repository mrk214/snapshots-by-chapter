    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A ruína completa de Nínive"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ai da cidade sanguinária,",
          "toda cheia de mentiras e de roubo",
          "e que não solta a sua presa!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Eis o estalo dos açoites,",
          "o estrondo das rodas,",
          "o galope dos cavalos",
          "e os carros que vão saltando!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os cavaleiros que esporeiam,",
          "as espadas brilhantes,",
          "as lanças reluzentes,",
          "uma multidão de feridos,",
          "massa de cadáveres,",
          "mortos sem fim",
          "— chegam a tropeçar",
          "sobre os mortos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tudo isso por causa",
          "da grande prostituição",
          "da bela e encantadora prostituta,",
          "da mestra de feitiçarias,",
          "que seduzia as nações",
          "com a sua prostituição",
          "e os povos, com as suas feitiçarias."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Eis que eu estou contra você”,",
          "diz o Senhor dos Exércitos.",
          "“Levantarei as abas de sua saia",
          "sobre o seu rosto,",
          "e mostrarei às nações a sua nudez,",
          "e aos reinos, as suas vergonhas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Vou jogar sujeira sobre você,",
          "tratá-la com desprezo",
          "e transformá-la em espetáculo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todos os que a virem",
          "fugirão de você",
          "e dirão: ‘Nínive está destruída!’",
          "Quem terá compaixão dela?",
          "De onde buscarei",
          "quem a console?”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Será que você é melhor",
          "do que Tebas,",
          "que estava situada junto ao Nilo,",
          "cercada de águas,",
          "protegida pelo mar",
          "e tendo as águas por muralha?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A Etiópia e o Egito",
          "eram a sua força,",
          "força sem limites;",
          "Pute e Líbia eram seus aliados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todavia, ela foi levada ao exílio,",
          "foi para o cativeiro.",
          "Também os seus filhos",
          "foram despedaçados",
          "nas esquinas de todas as ruas.",
          "Sobre os seus nobres",
          "lançaram sortes,",
          "e todos os seus grandes",
          "foram presos com correntes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Também você, Nínive,",
          "será embriagada e se esconderá.",
          "Também você procurará",
          "um refúgio contra o inimigo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Todas as suas fortalezas",
          "são como figueiras",
          "com figos prematuros:",
          "é só sacudir a figueira,",
          "que os figos caem na boca",
          "de quem os há de comer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Eis que os seus soldados",
          "são como mulheres.",
          "Os portões do seu país estão",
          "completamente abertos",
          "para os seus inimigos;",
          "o fogo destruiu as trancas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tire água para o tempo do cerco,",
          "reforce as suas fortalezas,",
          "entre no lodo e pise o barro,",
          "pegue as formas para fazer tijolos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "No entanto, você será",
          "consumida pelo fogo",
          "e exterminada pela espada",
          "como folhas devoradas",
          "pelos gafanhotos.",
          "Multipliquem-se",
          "como os gafanhotos!",
          "Tornem-se tão numerosos como eles!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Os seus negociantes eram",
          "mais numerosos",
          "do que as estrelas do céu,",
          "mas como gafanhotos",
          "bateram asas e voaram."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os seus príncipes eram",
          "como gafanhotos,",
          "e os seus chefes,",
          "como gafanhotos grandes,",
          "que pousam nos muros",
          "em dias de frio;",
          "quando o sol aparece,",
          "voam embora,",
          "e não se sabe para onde vão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Os seus pastores dormem,",
          "ó rei da Assíria;",
          "os seus nobres cochilam.",
          "O seu povo está espalhado",
          "pelos montes,",
          "e não há quem possa ajuntá-lo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Não há remédio para o seu mal;",
          "o seu ferimento é grave.",
          "Todos os que ouvirem falar",
          "do que aconteceu com você",
          "baterão palmas.",
          "Pois quem não foi vítima",
          "da sua crueldade sem fim?"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
