    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvores a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Louvem o nome do Senhor!",
          "Louvem-no vocês,",
          "servos do Senhor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "que estão na Casa do Senhor,",
          "nos átrios da casa do nosso Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Louvem o Senhor,",
          "porque o Senhor é bom;",
          "cantem louvores ao seu nome,",
          "porque é agradável."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pois o Senhor escolheu Jacó",
          "para ser dele,",
          "e Israel, para ser",
          "o seu tesouro especial."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "De fato, eu sei",
          "que o Senhor é grande",
          "e que o nosso Deus está acima",
          "de todos os deuses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tudo o que agrada ao Senhor,",
          "ele o faz,",
          "nos céus e na terra,",
          "no mar e em todos os abismos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Faz subir as nuvens",
          "dos confins da terra,",
          "faz os relâmpagos para a chuva,",
          "faz sair o vento",
          "dos seus reservatórios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Foi ele quem matou",
          "os primogênitos no Egito,",
          "tanto das pessoas",
          "como dos animais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Foi ele quem fez sinais",
          "e maravilhas",
          "em seu meio, ó Egito,",
          "contra Faraó",
          "e todos os seus servos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ele destruiu muitas nações",
          "e matou reis poderosos:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Seom, rei dos amorreus,",
          "Ogue, rei de Basã,",
          "e todos os reinos de Canaã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "E a terra deles deu em herança,",
          "em herança a Israel, seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O teu nome, Senhor,",
          "permanece para sempre;",
          "a tua memória, Senhor, passará",
          "de geração em geração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pois o Senhor julga o seu povo",
          "e se compadece dos seus servos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os ídolos das nações",
          "são prata e ouro,",
          "obra de mãos humanas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Têm boca e não falam;",
          "têm olhos e não veem;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "têm ouvidos e não ouvem;",
          "pois não há alento de vida",
          "em sua boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tornam-se semelhantes a eles",
          "os que os fazem,",
          "e todos os que neles confiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Casa de Israel,",
          "bendigam o Senhor!",
          "Casa de Arão, bendigam o Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Casa de Levi, bendigam o Senhor!",
          "Vocês que temem o Senhor,",
          "bendigam o Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Desde Sião",
          "bendito seja o Senhor,",
          "que habita em Jerusalém!",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
