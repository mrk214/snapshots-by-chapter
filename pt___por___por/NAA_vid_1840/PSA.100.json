    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hino de louvor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de ações de graças"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Celebrem com júbilo ao Senhor,",
          "todas as terras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sirvam ao Senhor com alegria,",
          "apresentem-se diante dele",
          "com cântico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Saibam que o Senhor é Deus;",
          "foi ele quem nos fez, e dele somos;",
          "somos o seu povo",
          "e rebanho do seu pastoreio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Entrem por suas portas",
          "com ações de graças",
          "e nos seus átrios,",
          "com hinos de louvor;",
          "rendam-lhe graças",
          "e bendigam o seu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque o Senhor é bom,",
          "a sua misericórdia",
          "dura para sempre,",
          "e, de geração em geração,",
          "a sua fidelidade."
        ],
        "rlw_lines": []
      }
    ]
  },
