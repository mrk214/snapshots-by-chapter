    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Convite ao arrependimento"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Reúna-se e concentre-se,",
          "ó nação sem pudor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "antes que saia o decreto",
          "e o dia se vá como a palha,",
          "antes que venha sobre você",
          "o furor da ira do Senhor,",
          "sim, antes que venha sobre você",
          "o dia da ira do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Busquem o Senhor,",
          "todos vocês,",
          "os humildes da terra,",
          "que cumprem",
          "os seus mandamentos.",
          "Busquem a justiça,",
          "busquem a humildade.",
          "Talvez assim vocês sejam poupados",
          "no dia da ira do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ameaças contra os filisteus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque Gaza será abandonada,",
          "e Asquelom ficará deserta;",
          "Asdode, ao meio-dia, será expulsa,",
          "e Ecrom será desarraigada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ai dos que habitam no litoral,",
          "do povo dos queretitas!",
          "A palavra do Senhor",
          "será contra você,",
          "Canaã, terra dos filisteus.",
          "“Farei com que",
          "você seja destruída,",
          "até que não reste",
          "um morador sequer.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O litoral será de pastagens,",
          "com refúgios para os pastores",
          "e currais para os rebanhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O litoral pertencerá",
          "ao remanescente",
          "da casa de Judá.",
          "Ali apascentarão os seus rebanhos",
          "e, ao anoitecer, se deitarão",
          "nas casas de Asquelom;",
          "porque o Senhor, seu Deus,",
          "os visitará",
          "e mudará a sorte deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ameaças contra Moabe e Amom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Ouvi a zombaria de Moabe",
          "e as palavras injuriosas",
          "dos filhos de Amom,",
          "que zombaram do meu povo",
          "e se gabaram",
          "contra o seu território."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Portanto, tão certo como eu vivo”,",
          "diz o Senhor dos Exércitos,",
          "o Deus de Israel,",
          "“Moabe será como Sodoma,",
          "e os filhos de Amom,",
          "como Gomorra,",
          "campo de urtigas, poços de sal",
          "e desolação perpétua.",
          "O remanescente do meu povo",
          "os saqueará,",
          "e os sobreviventes da minha nação",
          "tomarão posse",
          "dos seus territórios.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Isso lhes sobrevirá",
          "por causa do seu orgulho,",
          "porque zombaram e se gabaram",
          "contra o povo",
          "do Senhor dos Exércitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor será terrível",
          "contra eles,",
          "porque aniquilará",
          "todos os deuses da terra.",
          "E todos os povos das nações,",
          "cada um do seu lugar, o adorarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ameaças contra a Etiópia e a Assíria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Também vocês, ó etíopes,",
          "serão mortos pela",
          "espada do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ele estenderá também",
          "a mão contra o Norte",
          "e destruirá a Assíria;",
          "e fará de Nínive uma desolação",
          "e terra seca como o deserto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "No meio dessa cidade,",
          "repousarão os rebanhos",
          "e todo tipo de animais.",
          "Nos capitéis das colunas",
          "se alojarão",
          "tanto o pelicano como o ouriço.",
          "A voz das aves ressoará nas janelas.",
          "Haverá escombros",
          "nos umbrais das portas,",
          "porque o madeiramento de cedro",
          "será arrancado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Esta é a cidade",
          "alegre e confiante,",
          "que dizia consigo mesma:",
          "“Eu sou a única,",
          "e não há outra além de mim.”",
          "Como se tornou em desolação,",
          "em pousada de animais!",
          "Todos os que passarem por ela",
          "hão de vaiar",
          "e farão gestos de desprezo."
        ],
        "rlw_lines": []
      }
    ]
  },
