    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica por proteção divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oração de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ouve, Senhor, a causa justa,",
          "atende o meu clamor!",
          "Dá ouvidos à minha oração,",
          "pois ela não procede",
          "de lábios enganosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Venha da tua presença",
          "o julgamento a meu respeito;",
          "os teus olhos veem com equidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sondas o meu coração,",
          "de noite me visitas,",
          "provas-me no fogo",
          "e não encontras em mim",
          "nenhuma iniquidade;",
          "a minha boca não transgride."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Quanto às obras humanas,",
          "pela palavra dos teus lábios",
          "eu tenho me guardado",
          "dos caminhos do violento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os meus passos se acostumaram",
          "às tuas veredas,",
          "os meus pés não resvalaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu te invoco, ó Deus,",
          "pois tu me respondes;",
          "inclina os ouvidos para mim",
          "e ouve as minhas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mostra as maravilhas",
          "da tua bondade,",
          "ó Salvador daqueles que",
          "à tua direita se refugiam",
          "dos seus adversários."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Guarda-me",
          "como a menina dos olhos;",
          "esconde-me",
          "à sombra das tuas asas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Protege-me dos perversos",
          "que me oprimem,",
          "dos inimigos que me assediam",
          "de morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Insensíveis,",
          "eles cerram o coração",
          "e falam com lábios insolentes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "andam agora cercando",
          "os nossos passos",
          "e fixam em nós os olhos",
          "para nos derrubar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Parecem-se com o leão,",
          "ávido por sua presa,",
          "ou o leãozinho,",
          "que espreita de emboscada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Levanta-te, Senhor!",
          "Enfrenta-os e arrasa-os!",
          "Com a tua espada livra",
          "a minha alma do ímpio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Com a tua mão, Senhor,",
          "livra-me dos homens",
          "deste mundo,",
          "cuja porção é desta vida",
          "e cujo ventre tu enches",
          "com os teus tesouros;",
          "os quais se fartam de filhos",
          "e o que lhes sobra deixam",
          "aos seus pequeninos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eu, porém, na justiça",
          "contemplarei a tua face;",
          "quando acordar, me satisfarei",
          "com a tua semelhança."
        ],
        "rlw_lines": []
      }
    ]
  },
