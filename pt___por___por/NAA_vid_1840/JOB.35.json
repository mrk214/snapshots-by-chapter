    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Terceira fala de Eliú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eliú disse ainda:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Você acha que é justo dizer:",
          "‘A minha justiça é maior",
          "do que a de Deus’?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque você diz:",
          "‘De que me serviria ela?",
          "Que proveito tenho,",
          "se eu não pecar?’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eu darei a resposta a você",
          "e aos seus amigos também."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Olhe para o céu e veja;",
          "contemple as altas nuvens",
          "acima de você.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "A sua impiedade só pode fazer mal ao homem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Se você peca,",
          "que mal causa a Deus?",
          "Se as suas transgressões",
          "se multiplicam, que prejuízo",
          "isso poderia trazer a ele?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Se você é justo,",
          "o que está dando a ele",
          "ou o que ele recebe da sua mão?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A sua impiedade só pode",
          "fazer mal ao homem;",
          "e a sua justiça só pode dar proveito",
          "ao filho do homem.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“Por causa das muitas opressões,",
          "as pessoas clamam;",
          "clamam por socorro",
          "contra o braço dos poderosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mas ninguém diz:",
          "‘Onde está Deus, que me fez,",
          "que inspira canções de louvor",
          "durante a noite,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "que nos ensina mais do que",
          "aos animais da terra",
          "e nos faz mais sábios",
          "do que as aves dos céus?’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Clamam,",
          "porém ele não responde,",
          "por causa da arrogância dos maus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Só gritos vazios Deus não ouvirá;",
          "o Todo-Poderoso",
          "não lhes dará atenção.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Você abre a boca com palavras vazias"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Jó, ainda que você diga",
          "que não o vê,",
          "a sua causa está diante dele;",
          "por isso, espere em Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mas agora, porque Deus",
          "na sua ira não está punindo,",
          "nem fazendo muito caso",
          "das transgressões,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "você abre a sua boca",
          "com palavras vazias,",
          "amontoando frases sem sabedoria.”"
        ],
        "rlw_lines": []
      }
    ]
  },
