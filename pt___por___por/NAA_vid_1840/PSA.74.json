    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pela libertação do povo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo didático de Asafe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, por que nos rejeitas",
          "para sempre?",
          "Por que se acende a tua ira",
          "contra as ovelhas do teu pasto?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Lembra-te da tua congregação,",
          "que adquiriste",
          "desde a antiguidade,",
          "que remiste para ser",
          "a tribo da tua herança.",
          "Lembra-te do monte Sião,",
          "no qual tens habitado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dirige os teus passos",
          "para as ruínas perpétuas,",
          "para tudo de mau que o inimigo",
          "fez no santuário."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os teus adversários bramam",
          "no lugar das assembleias",
          "e erguem as suas próprias insígnias",
          "como sinais."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Parecem-se com os que",
          "empunham os seus machados",
          "no espesso da floresta;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "e agora, com os seus machados",
          "e martelos,",
          "destroem todos os entalhes",
          "de madeira."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Incendeiam o teu santuário;",
          "profanam a morada do teu nome,",
          "arrasando-a até o chão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Disseram no seu coração:",
          "“Acabemos com eles",
          "de uma vez.”",
          "Queimaram todos os lugares santos",
          "de Deus na terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Já não vemos os nossos sinais;",
          "já não há profeta;",
          "nem há, entre nós, quem saiba",
          "até quando isso vai durar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Até quando, ó Deus, o adversário",
          "nos afrontará?",
          "Será que o inimigo blasfemará",
          "o teu nome para sempre?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por que retiras a tua mão,",
          "sim, a tua mão direita,",
          "e a conservas no teu seio?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mas Deus é meu Rei",
          "desde a antiguidade;",
          "ele é quem opera feitos salvadores",
          "no meio da terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tu, com o teu poder,",
          "dividiste o mar;",
          "esmagaste sobre as águas",
          "a cabeça dos monstros",
          "marinhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Despedaçaste as cabeças",
          "do Leviatã",
          "e o deste por alimento",
          "às criaturas do deserto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Tu abriste fontes e ribeiros;",
          "secaste rios caudalosos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Teu é o dia;",
          "tua também é a noite;",
          "a luz e o sol, tu os formaste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Fixaste os confins da terra;",
          "verão e inverno, tu os fizeste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Lembra-te disto: o inimigo",
          "tem insultado o Senhor,",
          "e um povo insensato",
          "tem blasfemado o teu nome."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Não entregues à rapina",
          "a vida de tua pomba,",
          "nem te esqueças para sempre",
          "da vida dos teus aflitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Lembra-te da tua aliança,",
          "pois os lugares tenebrosos da terra",
          "estão cheios de moradas",
          "de violência."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Não fique envergonhado",
          "o oprimido;",
          "que o aflito e o necessitado",
          "louvem o teu nome."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Levanta-te, ó Deus,",
          "e defende a tua causa;",
          "lembra-te de como o ímpio",
          "te afronta todos os dias."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Não te esqueças da gritaria",
          "dos teus inimigos,",
          "do sempre crescente tumulto",
          "dos teus adversários."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
