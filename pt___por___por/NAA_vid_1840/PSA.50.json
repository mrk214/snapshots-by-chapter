    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A verdadeira adoração"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asafe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Fala o Poderoso, o Senhor Deus,",
          "e chama a terra desde o Oriente",
          "até o Ocidente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Desde Sião,",
          "excelência de formosura,",
          "resplandece Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O nosso Deus vem",
          "e não guarda silêncio.",
          "À frente dele",
          "vem um fogo devorador,",
          "e ao seu redor",
          "ruge grande tormenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ele intima os céus lá em cima",
          "e a terra,",
          "para julgar o seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele diz: “Congreguem",
          "os meus santos,",
          "os que comigo fizeram aliança",
          "por meio de sacrifícios.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os céus anunciam a sua justiça,",
          "porque é o próprio Deus que julga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Escute, meu povo, e eu falarei;",
          "ó Israel, e eu testemunharei",
          "contra você.",
          "Eu sou Deus, o seu Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Não o repreendo",
          "pelos seus sacrifícios,",
          "nem pelos holocaustos que você",
          "continuamente me oferece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não aceitarei novilhos",
          "da sua casa,",
          "nem bodes dos seus apriscos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois são meus",
          "todos os animais do bosque",
          "e o gado aos milhares",
          "sobre as montanhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Conheço todas as aves",
          "dos montes,",
          "e são meus todos os animais",
          "que vivem no campo.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Se eu tivesse fome,",
          "não teria necessidade",
          "de dizê-lo a você,",
          "pois meu é o mundo",
          "e a sua plenitude."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Acaso como eu carne de touros?",
          "Ou bebo sangue de cabritos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ofereça a Deus",
          "sacrifício de ações de graças",
          "e cumpra os seus votos",
          "para com o Altíssimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Invoque-me no dia da angústia;",
          "eu o livrarei,",
          "e você me glorificará.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mas ao ímpio Deus diz:",
          "“De que lhe serve",
          "repetir os meus preceitos",
          "e ter nos lábios a minha aliança,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "se você odeia a disciplina",
          "e rejeita as minhas palavras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Se vê um ladrão,",
          "você se torna amigo dele,",
          "e aos adúlteros você se associa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Abre a boca para o mal,",
          "e a sua língua trama enganos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Senta-se para falar",
          "contra o seu irmão",
          "e difama o filho de sua mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Você tem feito essas coisas,",
          "e eu me calei;",
          "você pensava",
          "que eu era igual a você;",
          "mas agora eu o repreenderei",
          "e porei tudo à sua vista.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“Considerem, pois, nisto,",
          "vocês que se esquecem",
          "de Deus,",
          "para que eu não os despedace,",
          "sem haver quem os livre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Aquele que me oferece sacrifício",
          "de ações de graças,",
          "esse me glorificará;",
          "e ao que prepara o seu caminho,",
          "farei com que veja",
          "a salvação de Deus.”"
        ],
        "rlw_lines": []
      }
    ]
  },
