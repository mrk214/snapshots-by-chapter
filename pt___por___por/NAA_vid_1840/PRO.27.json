  "book": {
    "usfm": "PRO",
    "human": "Provérbios"
  },
  "chapter": {
    "usfm": "PRO.27",
    "human": "Provérbios 27",
    "previous": {
      "usfm": "PRO.26",
      "human": "Provérbios 26"
    },
    "next": {
      "usfm": "PRO.28",
      "human": "Provérbios 28"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Não se gabe do dia de amanhã,",
          "porque você não sabe",
          "o que ele trará à luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deixe que outros o louvem,",
          "e não a sua própria boca;",
          "um estranho, e não você mesmo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pesada é a pedra,",
          "e a areia também;",
          "mas a ira do insensato",
          "é mais pesada do que as duas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cruel é o furor",
          "e impetuosa é a ira,",
          "mas quem pode resistir à inveja?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Melhor é a repreensão franca",
          "do que o amor encoberto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Leais são as feridas",
          "feitas pelo que ama,",
          "porém os beijos de quem odeia",
          "são enganosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quem está farto",
          "pisa o favo de mel,",
          "mas para o faminto",
          "até o amargo é doce."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como a ave que vagueia",
          "longe do seu ninho,",
          "assim é quem anda vagueando",
          "longe do seu lar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Como o óleo e o perfume",
          "alegram o coração,",
          "assim o amigo encontra doçura",
          "no conselho cordial."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Não abandone o seu amigo,",
          "nem o amigo do seu pai.",
          "Não vá para a casa do seu irmão",
          "no dia da adversidade;",
          "mais vale o vizinho perto",
          "do que o irmão longe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Meu filho, seja sábio",
          "e alegre o meu coração,",
          "para que eu saiba responder",
          "àqueles que me afrontam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O prudente vê o mal",
          "e se esconde;",
          "mas os ingênuos seguem em frente",
          "e sofrem as consequências."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Que se tome a roupa",
          "daquele que fica",
          "por fiador de um estranho;",
          "que ela sirva de penhor,",
          "quando ele se obriga",
          "por mulher estranha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Se alguém bendiz o seu vizinho",
          "em alta voz, logo de manhã,",
          "a sua bênção soará como maldição."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "A goteira contínua",
          "num dia chuvoso",
          "e a esposa briguenta",
          "são semelhantes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "contê-la seria conter o vento,",
          "seria pegar o óleo com a mão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O ferro se afia com ferro,",
          "e uma pessoa, pela presença",
          "do seu próximo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Quem cuida da figueira",
          "comerá do seu fruto;",
          "e o que trata bem o seu senhor",
          "será honrado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Como a água reflete o rosto,",
          "assim o coração reflete",
          "o que a pessoa é."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O mundo dos mortos e o abismo",
          "nunca se fartam,",
          "e os olhos do ser humano",
          "nunca se satisfazem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Como o crisol prova a prata",
          "e o forno prova o ouro,",
          "assim o homem é provado",
          "pelos elogios que recebe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Mesmo que você moesse",
          "o insensato",
          "como se soca o cereal num pilão,",
          "a tolice não se afastaria dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Procure conhecer",
          "o estado das suas ovelhas",
          "e cuide dos seus rebanhos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "porque as riquezas",
          "não duram para sempre,",
          "nem a coroa,",
          "de geração em geração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Quando o feno for removido,",
          "aparecerem os renovos",
          "e se recolher o capim dos montes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "então os cordeiros lhe darão",
          "a lã para a roupa,",
          "os bodes serão vendidos",
          "para pagar o campo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "e as cabras produzirão leite",
          "em abundância",
          "para alimentar você,",
          "alimentar a sua casa",
          "e sustentar as suas servas."
        ],
        "rlw_lines": []
      }
    ]
  },
