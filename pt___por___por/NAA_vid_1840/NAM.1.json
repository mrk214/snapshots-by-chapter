    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Sentença contra Nínive. Livro da visão de Naum, da cidade de Elcos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A ira e a misericórdia de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O Senhor é Deus zeloso",
          "e vingador,",
          "o Senhor é vingador",
          "e cheio de ira;",
          "o Senhor toma vingança",
          "contra os seus adversários",
          "e reserva indignação",
          "para os seus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O Senhor é tardio em irar-se,",
          "mas grande em poder",
          "e jamais inocenta o culpado.",
          "O Senhor tem o seu caminho",
          "na tormenta e na tempestade,",
          "e as nuvens são a poeira",
          "dos seus pés."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Repreende o mar, e ele seca;",
          "faz com que todos os rios",
          "fiquem secos.",
          "Basã e o Carmelo desfalecem,",
          "e as flores do Líbano murcham."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os montes tremem diante dele,",
          "e as colinas se derretem.",
          "A terra se levanta diante dele,",
          "sim, o mundo",
          "e todos os seus moradores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quem pode suportar",
          "a sua indignação?",
          "E quem subsistirá diante do furor",
          "da sua ira?",
          "A sua cólera se derrama",
          "como fogo,",
          "e as rochas são por ele demolidas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor é bom,",
          "é fortaleza no dia da angústia",
          "e conhece os que nele se refugiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas, com inundação",
          "transbordante,",
          "acabará de uma vez",
          "com o lugar dessa cidade;",
          "com trevas, o Senhor perseguirá",
          "os seus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O que é que vocês estão",
          "planejando contra o Senhor?",
          "Ele mesmo os",
          "consumirá completamente;",
          "a angústia não se levantará",
          "duas vezes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque, ainda que eles",
          "se entrelacem",
          "como os espinhos",
          "e se saturem de vinho",
          "como bêbados,",
          "serão inteiramente consumidos",
          "como palha seca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "De você, Nínive, saiu um",
          "que planeja o mal contra o Senhor,",
          "alguém que aconselha a maldade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Por mais seguros que estejam",
          "e por mais numerosos que eles sejam,",
          "ainda assim serão exterminados",
          "e passarão.",
          "Meu povo, embora eu",
          "o tenha afligido,",
          "não o afligirei mais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Quebrarei o jugo deles",
          "que pesa sobre você",
          "e romperei os laços",
          "que o prendem.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porém contra você, Assíria,",
          "o Senhor deu ordem",
          "para que não haja posteridade",
          "que leve o seu nome;",
          "do templo dos seus deuses",
          "exterminarei as imagens",
          "de escultura",
          "e de fundição.",
          "Farei a sua sepultura,",
          "porque você é desprezível."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eis sobre os montes",
          "os pés do que anuncia boas-novas,",
          "do que anuncia a paz!",
          "Celebre as suas festas, ó Judá,",
          "cumpra os seus votos,",
          "porque o ímpio",
          "não mais passará por você;",
          "ele foi inteiramente exterminado."
        ],
        "rlw_lines": []
      }
    ]
  },
