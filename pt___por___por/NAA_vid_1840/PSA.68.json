    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A vitória de Deus sobre os inimigos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi. Cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deus se levanta; os seus inimigos",
          "se dispersam;",
          "os que o odeiam",
          "fogem da sua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como se dissipa a fumaça,",
          "assim tu os dispersas;",
          "como a cera se derrete",
          "perto do fogo,",
          "assim os ímpios somem",
          "da presença de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os justos, porém, se alegram;",
          "exultam na presença de Deus",
          "e transbordam de alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cantem a Deus, cantem louvores",
          "ao seu nome;",
          "exaltem aquele que cavalga",
          "sobre as nuvens.",
          "Senhor é o seu nome;",
          "exultem diante dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pai dos órfãos e juiz das viúvas",
          "é Deus em sua santa morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Deus faz com que o solitário",
          "more em família;",
          "liberta os cativos",
          "e lhes dá prosperidade;",
          "só os rebeldes habitam",
          "em terra estéril."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ao saíres, ó Deus,",
          "à frente do teu povo,",
          "ao avançares pelo deserto,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "a terra tremeu;",
          "também os céus gotejaram",
          "na presença de Deus;",
          "o próprio Sinai tremeu",
          "na presença de Deus,",
          "do Deus de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Chuva abundante derramaste,",
          "ó Deus, sobre a tua herança;",
          "quando ela já estava exausta,",
          "tu a restabeleceste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Aí habitou o teu povo;",
          "em tua bondade, ó Deus,",
          "fizeste provisão",
          "para os necessitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor deu a palavra,",
          "e grande é o exército",
          "das mensageiras",
          "das boas-novas:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Reis de exércitos fogem!",
          "Eles fogem!”",
          "E a dona de casa",
          "reparte os despojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Por que estão repousando",
          "entre as cercas dos apriscos?",
          "As asas da pomba",
          "são cobertas de prata,",
          "cujas penas maiores",
          "têm o brilho do ouro puro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Quando o Todo-Poderoso ali",
          "dispersa os reis,",
          "cai neve sobre o monte Salmom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Monte altíssimo",
          "é o monte de Basã;",
          "serra de elevações",
          "é o monte de Basã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por que olham com inveja,",
          "ó montes elevados,",
          "para o monte que Deus escolheu",
          "para sua habitação?",
          "O Senhor habitará nele",
          "para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os carros de Deus são vinte mil,",
          "sim, milhares de milhares.",
          "No meio deles, está o Senhor;",
          "o Sinai tornou-se em santuário."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Subiste às alturas,",
          "levaste cativo o cativeiro;",
          "recebeste homens por dádivas,",
          "até mesmo rebeldes,",
          "para que o Senhor Deus",
          "habite no meio deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Bendito seja o Senhor que,",
          "dia a dia, leva o nosso fardo!",
          "Deus é a nossa salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O nosso Deus é",
          "o Deus libertador;",
          "com Deus, o Senhor,",
          "está o escaparmos da morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Sim, Deus parte a cabeça",
          "dos seus inimigos",
          "e racha o crânio do que anda",
          "nos seus próprios delitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "O Senhor disse:",
          "“Eu os trarei de Basã,",
          "eu os farei voltar",
          "das profundezas do mar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "para que você banhe",
          "o seu pé em sangue,",
          "e a língua dos seus cães tenha",
          "a sua porção dos inimigos.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Viu-se, ó Deus, o teu cortejo,",
          "o cortejo do meu Deus,",
          "do meu Rei, no santuário."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Os cantores iam na frente,",
          "atrás vinham os tocadores",
          "de instrumentos de cordas,",
          "em meio às moças com tamborins."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Bendigam a Deus",
          "nas congregações,",
          "bendigam o Senhor, vocês que são",
          "da linhagem de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Ali está o mais novo,",
          "Benjamim, que os precede,",
          "os príncipes de Judá,",
          "em grande número,",
          "os príncipes de Zebulom",
          "e os príncipes de Naftali."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Reúne, ó Deus, a tua força,",
          "força divina que usaste",
          "a nosso favor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "oriunda do teu templo",
          "em Jerusalém.",
          "Os reis te oferecerão presentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Reprime a fera dos canaviais,",
          "a multidão dos fortes como touros",
          "e dos povos com novilhos,",
          "pisando sobre os que cobiçam",
          "barras de prata.",
          "Dispersa os povos que têm prazer",
          "na guerra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Príncipes vêm do Egito;",
          "a Etiópia corre a estender",
          "mãos cheias para Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Reinos da terra, cantem a Deus,",
          "cantem louvores ao Senhor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "àquele que vai montado",
          "sobre os céus,",
          "os céus da antiguidade;",
          "eis que ele faz ouvir a sua voz,",
          "voz poderosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Deem glória a Deus!",
          "A sua majestade está sobre Israel,",
          "e a sua fortaleza, nos céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Ó Deus, tu és tremendo",
          "no teu santuário!",
          "O Deus de Israel,",
          "ele dá força e poder ao seu povo.",
          "Bendito seja Deus!"
        ],
        "rlw_lines": []
      }
    ]
  },
