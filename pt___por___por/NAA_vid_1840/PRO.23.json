    },
    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 6 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quando você se assentar",
          "para comer",
          "com um governador,",
          "leve bem em conta",
          "quem está diante de você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Encoste uma faca",
          "na sua própria garganta,",
          "se você é glutão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não cobice os pratos deliciosos",
          "que ele serve,",
          "porque essa comida",
          "é enganadora."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 7 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Não se fatigue para ficar rico;",
          "não aplique nisso",
          "a sua inteligência."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Você quer pôr os seus olhos",
          "naquilo que não é nada?",
          "Porque certamente",
          "a riqueza criará asas,",
          "como a águia que voa pelos céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 8 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não coma o pão do invejoso,",
          "nem cobice",
          "os seus pratos deliciosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque, como imagina",
          "em sua alma, assim ele é.",
          "Ele diz: “Coma e beba!”,",
          "mas não está sendo sincero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Você vomitará",
          "o bocado que comeu",
          "e terá desperdiçado",
          "as palavras amáveis",
          "que falou."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 9 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não fale com um tolo,",
          "porque ele desprezará",
          "a sabedoria das suas palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 10 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Não remova os marcos antigos,",
          "nem entre nos campos dos órfãos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "porque o Redentor deles é forte",
          "e defenderá a causa deles contra você."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 11 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Aplique o seu coração ao ensino",
          "e os seus ouvidos às palavras",
          "do conhecimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 12 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Não deixe a criança",
          "sem disciplina,",
          "porque, se você a castigar",
          "com a vara, ela não morrerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Você a castigará com a vara",
          "e livrará a alma dela do inferno."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 13 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Meu filho, se o seu coração",
          "for sábio,",
          "também o meu coração",
          "se alegrará;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "o meu íntimo exultará,",
          "quando os seus lábios",
          "falarem coisas retas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 14 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Não tenha inveja dos pecadores;",
          "pelo contrário, persevere",
          "no temor do Senhor",
          "todo tempo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Porque certamente",
          "haverá um futuro,",
          "e a sua esperança",
          "não será frustrada."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 15 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Escute, meu filho, e seja sábio;",
          "guie o seu coração",
          "no caminho reto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Não se junte com os beberrões",
          "nem com os comilões,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "porque os beberrões",
          "e os comilões",
          "acabam na pobreza,",
          "e a sonolência os levará",
          "a vestir trapos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 16 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Escute o seu pai, que o gerou,",
          "e não despreze a sua mãe,",
          "quando ela envelhecer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Compre a verdade",
          "e não a venda;",
          "compre a sabedoria, a instrução",
          "e o entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "O pai de um justo",
          "fica muito feliz,",
          "e quem gerar um filho sábio",
          "terá nele a sua alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Dê essa alegria ao seu pai",
          "e à sua mãe,",
          "e que se encha de felicidade",
          "aquela que o deu à luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 17 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Meu filho, preste bem atenção",
          "no que eu digo,",
          "e que os seus olhos se agradem",
          "dos meus caminhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Pois uma prostituta",
          "é como uma cova profunda,",
          "e a mulher estranha",
          "é como um poço estreito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Como assaltante,",
          "ela fica à espreita",
          "e multiplica entre os homens",
          "os infiéis."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "— 18 —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Para quem são os ais?",
          "Para quem são os pesares?",
          "Para quem são as rixas?",
          "Para quem são as queixas?",
          "Para quem são os ferimentos",
          "sem motivo?",
          "E para quem",
          "são os olhos vermelhos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Para os que se demoram",
          "em beber vinho,",
          "para os que andam buscando",
          "bebida misturada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Não olhe para o vinho,",
          "quando se mostra vermelho,",
          "quando resplandece no copo",
          "e desce suavemente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Pois no fim",
          "morderá como a cobra",
          "e picará como a víbora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Os seus olhos",
          "verão coisas esquisitas,",
          "e o seu coração o levará",
          "a dizer coisas perversas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Você será como o que se deita",
          "no meio do mar",
          "e como o que se deita",
          "no alto do mastro do navio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Você dirá: “Fui espancado,",
          "mas não doeu;",
          "bateram em mim,",
          "mas eu não senti nada!",
          "Quando vou despertar?",
          "Então voltarei a beber.”"
        ],
        "rlw_lines": []
      }
    ]
  },
