  "book": {
    "book_usfm": "PRO",
    "name": "Provérbios"
  },
  "chapter": {
    "chapter_usfm": "PRO.23",
    "current": {
      "usfm": "PRO.23",
      "human": "Provérbios 23"
    },
    "previous": {
      "usfm": "PRO.22",
      "human": "Provérbios 22"
