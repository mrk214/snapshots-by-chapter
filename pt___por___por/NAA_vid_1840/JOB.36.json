    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Quarta fala de Eliú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eliú seguiu falando e disse:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Mais um pouco de paciência,",
          "e eu lhe mostrarei",
          "que tenho mais argumentos",
          "a favor de Deus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Trarei o meu conhecimento",
          "de longe",
          "e atribuirei a justiça",
          "ao meu Criador."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque, na verdade,",
          "as minhas palavras",
          "não são falsas;",
          "quem está diante de você",
          "é senhor do assunto.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus é grande e não despreza ninguém"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Eis que Deus é grande",
          "e não despreza ninguém;",
          "ele é grande na força",
          "da sua compreensão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não poupa a vida do ímpio,",
          "mas faz justiça aos aflitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Deus não tira os seus olhos",
          "dos justos;",
          "pelo contrário, os assenta no trono",
          "com os reis, para sempre,",
          "e eles são exaltados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Se estão presos com correntes",
          "e amarrados com cordas de aflição,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "ele lhes faz ver as suas obras,",
          "as suas transgressões,",
          "e que se mostraram arrogantes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Abre-lhes também os ouvidos",
          "para a instrução",
          "e ordena que se convertam",
          "da iniquidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Se o ouvirem e o servirem,",
          "acabarão os seus dias",
          "em felicidade",
          "e os seus anos em delícias."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porém, se não o ouvirem,",
          "serão passados pela espada",
          "e morrerão na sua cegueira.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Os ímpios de coração",
          "alimentam a ira;",
          "e, quando são aprisionados",
          "por Deus, não clamam",
          "pedindo socorro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Perdem a vida na sua mocidade",
          "e morrem entre os prostitutos",
          "cultuais."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Deus livra o aflito",
          "por meio da sua aflição",
          "e pelo sofrimento",
          "lhe abre os ouvidos.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Não se incline para a iniquidade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "“Assim também a você",
          "Deus procura tirar da angústia",
          "e levar para um lugar espaçoso,",
          "em que não há aperto,",
          "e para o conforto de uma mesa",
          "cheia de comida saborosa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Mas você se enche",
          "do juízo do perverso,",
          "e, por isso, o juízo e a justiça",
          "o alcançarão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tenha cuidado para que",
          "a ira não o leve a zombar,",
          "nem permita que a grande quantia",
          "do resgate o desvie."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Será que ele levaria em conta",
          "as suas lamúrias e todos",
          "os seus grandes esforços,",
          "para que você se veja livre",
          "da sua angústia?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Não suspire pela noite,",
          "em que povos serão tirados",
          "do seu lugar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Cuidado! Não se incline",
          "para a iniquidade,",
          "você parece preferir a iniquidade",
          "à sua miséria.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus se mostra grande em seu poder!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“Eis que Deus se mostra grande",
          "em seu poder!",
          "Quem é mestre como ele?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Quem lhe prescreveu",
          "o seu caminho",
          "ou quem pode lhe dizer:",
          "‘Cometeste uma injustiça’?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Lembre-se de exaltar",
          "as obras de Deus,",
          "que as pessoas celebram."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Toda a humanidade",
          "olha para elas;",
          "as pessoas as contemplam de longe."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Eis que Deus é grande,",
          "e não o podemos compreender;",
          "o número dos seus anos",
          "não se pode calcular.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "O poder e a majestade de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "“Ele atrai para si",
          "as gotas de água",
          "que de seu vapor",
          "destilam em chuva,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "a qual as nuvens derramam",
          "e gotejam sobre a terra",
          "em grande abundância."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Pode alguém entender",
          "como ele estende as nuvens",
          "e como os trovões",
          "ecoam em sua tenda?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Eis que ele espalha sobre elas",
          "o seu relâmpago",
          "e encobre as profundezas do mar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Pois por estas coisas",
          "ele julga os povos",
          "e lhes dá alimento em abundância."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Enche as mãos de relâmpagos",
          "e os arremessa",
          "contra o adversário."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "O fragor da tempestade",
          "dá notícias a respeito dele,",
          "dele que é zeloso na sua ira",
          "contra a injustiça.”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
