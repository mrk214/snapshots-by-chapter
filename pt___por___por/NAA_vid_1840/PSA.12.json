    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Auxílio contra a falsidade"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, para instrumentos de oito cordas. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Salva-nos, Senhor!",
          "Porque já não há",
          "quem seja piedoso;",
          "desaparecem os fiéis",
          "entre os filhos dos homens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Falam com falsidade",
          "uns aos outros,",
          "falam com lábios bajuladores",
          "e coração fingido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que o Senhor corte",
          "todos os lábios bajuladores",
          "e a língua que fala soberbamente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pois dizem: “Com a nossa língua",
          "prevaleceremos;",
          "os lábios são nossos;",
          "quem é senhor sobre nós?”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Por causa da opressão",
          "dos pobres",
          "e do gemido dos necessitados,",
          "eu me levantarei agora”,",
          "diz o Senhor,",
          "“e porei a salvo aquele que",
          "anseia por isso.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "As palavras do Senhor",
          "são palavras puras,",
          "prata refinada em forno de barro,",
          "depurada sete vezes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sim, Senhor, tu nos guardarás;",
          "tu nos livrarás desta geração",
          "para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os perversos andam",
          "por toda parte,",
          "quando aquilo que não presta",
          "é exaltado entre os filhos",
          "dos homens."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
