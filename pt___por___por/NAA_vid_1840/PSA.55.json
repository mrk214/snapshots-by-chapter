{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.55","is_chapter":true,"previous":{"usfm":"PSA.54","human":"Salmos 54","canonical":true,"toc":true},"current":{"usfm":"PSA.55","human":"Salmos 55"},"next":{"usfm":"PSA.56","human":"Salmos 56","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Confiança em meio à perseguição"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["Ao mestre de canto. Para instrumentos de cordas. Salmo didático de Davi"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Dá ouvidos, ó Deus,","à minha oração;","não te escondas da minha súplica."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Atende-me e responde-me;","sinto-me perplexo","em minha queixa","e ando perturbado,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["por causa do clamor do inimigo","e da opressão do ímpio;","pois sobre mim lançam calamidade","e furiosamente me hostilizam."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["O meu coração","estremece no peito,","terrores de morte","caem sobre mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Temor e tremor me sobrevêm,","e o horror se apodera de mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Então eu disse: “Quem me dera","ter asas como a pomba!","Voaria e acharia descanso."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Eis que fugiria para longe","e ficaria no deserto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Depressa eu me abrigaria","do vendaval e da tempestade.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Destrói, Senhor, e confunde","os seus conselhos,","porque vejo violência","e conflitos na cidade."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Dia e noite andam em volta dela,","nas suas muralhas,","e, dentro delas, reinam","a corrupção e a maldade."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Há destruição","no meio da cidade;","das suas praças não se afastam","a opressão e o engano."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Porque não é um inimigo","que me afronta;","se o fosse, eu o suportaria;","nem é o que me odeia","quem se exalta contra mim,","pois dele eu me esconderia;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["mas é você, homem meu igual,","meu companheiro","e meu íntimo amigo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Juntos nos entretínhamos","e íamos com a multidão","à Casa de Deus."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Que a morte os assalte,","e vivos desçam à sepultura!","Porque há maldade","nas suas moradas","e no seu íntimo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Eu, porém, invocarei a Deus,","e o Senhor me salvará."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["À tarde, pela manhã","e ao meio-dia,","farei as minhas queixas","e lamentarei;","e ele ouvirá a minha voz."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Em paz ele livra a minha alma","dos que me perseguem;","pois são muitos contra mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Deus ouvirá e lhes responderá,","ele, que preside","desde a eternidade,","porque não há neles","mudança nenhuma,","e não temem a Deus."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Tal homem estendeu as mãos","contra os que tinham paz","com ele;","violou a sua aliança."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["A sua fala era mais macia","que a manteiga,","porém no coração havia guerra;","as suas palavras eram mais suaves","que o azeite,","mas eram, de fato,","espadas afiadas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Lance os seus cuidados","sobre o Senhor","e ele o susterá;","jamais permitirá que o justo","seja abalado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Tu, porém, ó Deus, os lançarás","na cova profunda.","Homens sanguinários","e fraudulentos","não chegarão à metade","dos seus dias;","eu, todavia, confiarei em ti."],"rlw_lines":[]}]}}