    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Consolo para os que choram"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de peregrinação"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quando o Senhor restaurou",
          "a sorte de Sião,",
          "ficamos como quem sonha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Então a nossa boca",
          "se encheu de riso,",
          "e a nossa língua, de júbilo.",
          "Então entre as nações se dizia:",
          "“Grandes coisas o Senhor",
          "tem feito por eles.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "De fato, grandes coisas",
          "o Senhor fez por nós;",
          "por isso, estamos alegres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Restaura, Senhor, a nossa sorte,",
          "como as torrentes no Neguebe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os que com lágrimas semeiam",
          "com júbilo ceifarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quem sai andando e chorando,",
          "enquanto semeia,",
          "voltará com júbilo,",
          "trazendo os seus feixes."
        ],
        "rlw_lines": []
      }
    ]
  },
