    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Saudades de Sião"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Às margens dos rios da Babilônia,",
          "nós nos assentávamos",
          "e chorávamos,",
          "lembrando-nos de Sião."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nos salgueiros que lá havia,",
          "pendurávamos as nossas harpas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "pois aqueles que",
          "nos levaram cativos",
          "nos pediam canções,",
          "e os nossos opressores queriam",
          "que fôssemos alegres, dizendo:",
          "“Cantem para nós",
          "um dos cânticos de Sião.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mas como poderíamos entoar",
          "um cântico ao Senhor",
          "em terra estranha?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Se eu me esquecer de você,",
          "ó Jerusalém,",
          "que a minha mão direita",
          "se resseque."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Que a minha língua fique colada",
          "ao céu da boca,",
          "se eu não me lembrar de você,",
          "se eu não preferir Jerusalém",
          "à minha maior alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Contra os filhos de Edom,",
          "lembra-te, Senhor,",
          "do dia em que Jerusalém",
          "foi tomada,",
          "pois diziam: “Arrasem!",
          "Arrasem Jerusalém",
          "até os seus alicerces!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Filha da Babilônia,",
          "você que será destruída,",
          "feliz aquele que lhe retribuir",
          "o mal que você nos fez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Feliz aquele que pegar",
          "os seus filhos",
          "e esmagá-los contra a pedra."
        ],
        "rlw_lines": []
      }
    ]
  },
