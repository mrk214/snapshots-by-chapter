    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "As boas-novas da salvação"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O Espírito do Senhor Deus",
          "está sobre mim,",
          "porque o Senhor me ungiu",
          "para pregar boas-novas",
          "aos pobres,",
          "enviou-me a curar",
          "os quebrantados de coração,",
          "a proclamar libertação",
          "aos cativos",
          "e a pôr em liberdade",
          "os algemados,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "a apregoar o ano aceitável",
          "do Senhor",
          "e o dia da vingança",
          "do nosso Deus,",
          "a consolar todos os que choram"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "e a pôr sobre os que choram",
          "em Sião",
          "uma coroa em vez de cinzas,",
          "óleo de alegria em vez de pranto,",
          "manto de louvor",
          "em vez de espírito angustiado.",
          "Eles serão chamados",
          "carvalhos de justiça,",
          "plantados pelo Senhor",
          "para a sua glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Reconstruirão as antigas ruínas,",
          "restaurarão os lugares",
          "anteriormente destruídos",
          "e renovarão as cidades arruinadas,",
          "destruídas de geração",
          "em geração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Estranhos se apresentarão",
          "e apascentarão",
          "os rebanhos de vocês;",
          "estrangeiros serão os seus",
          "lavradores e vinhateiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mas vocês serão chamados",
          "sacerdotes do Senhor,",
          "e serão conhecidos como",
          "ministros do nosso Deus.",
          "Comerão as riquezas das nações",
          "e se orgulharão do que era",
          "a glória delas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Em lugar de vergonha,",
          "vocês terão dupla honra;",
          "em lugar da afronta,",
          "exultarão na herança recebida;",
          "por isso, em sua terra",
          "possuirão o dobro",
          "e terão perpétua alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Porque eu, o Senhor,",
          "amo a justiça",
          "e odeio a iniquidade do roubo;",
          "em fidelidade lhes darei",
          "a sua recompensa",
          "e com eles farei aliança eterna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A posteridade deles",
          "será conhecida entre as nações,",
          "os seus descendentes,",
          "no meio dos povos;",
          "todos os que os virem",
          "reconhecerão",
          "que eles são família bendita",
          "do Senhor.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tenho grande alegria no Senhor!",
          "A minha alma se alegra",
          "no meu Deus,",
          "porque me cobriu",
          "de vestes de salvação",
          "e me envolveu",
          "com o manto de justiça,",
          "como noivo que se adorna",
          "de turbante,",
          "como noiva que se enfeita",
          "com as suas joias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque, como a terra produz",
          "os seus renovos,",
          "e como o jardim faz brotar",
          "o que nele se semeia,",
          "assim o Senhor Deus fará brotar",
          "a justiça",
          "e o louvor diante de",
          "todas as nações."
        ],
        "rlw_lines": []
      }
    ]
  },
