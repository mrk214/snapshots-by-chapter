{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.62","is_chapter":true,"previous":{"usfm":"ISA.61","human":"Isaías 61","canonical":true,"toc":true},"current":{"usfm":"ISA.62","human":"Isaías 62"},"next":{"usfm":"ISA.63","human":"Isaías 63","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Jerusalém, a noiva do Senhor"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Por amor de Sião, não me calarei","e, por amor de Jerusalém,","não me aquietarei,","até que a sua justiça saia","como um resplendor,","e a sua salvação,","como uma tocha acesa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["As nações verão a sua justiça,","ó Jerusalém,","e todos os reis contemplarão","a sua glória;","e você será chamada","por um nome novo,","que a boca do Senhor designará."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Você será uma coroa de glória","na mão do Senhor,","um diadema real","na mão do seu Deus."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Nunca mais a chamarão","de “Abandonada”,","e a sua terra não será mais","chamada de “Arrasada”.","Você será chamada","de “Minha Delícia”,","e a sua terra, de “Casada”,","porque o Senhor se delicia","em você,","e a sua terra se casará."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Porque, como o jovem","se casa com a moça,","assim os seus filhos","se casarão com você;","como o noivo","se alegra com a noiva,","assim o seu Deus","se alegrará com você."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Sobre as suas muralhas,","ó Jerusalém, pus guardas,","que jamais se calarão,","nem de dia nem de noite.","Vocês, que farão","com que o Senhor se lembre,","não descansem,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["nem deem a ele descanso","até que restabeleça Jerusalém","e a ponha por objeto de louvor","na terra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["O Senhor jurou","pela sua mão direita","e pelo seu braço poderoso:","“Nunca mais darei o seu cereal","como alimento","para os seus inimigos,","nem os estrangeiros","beberão o seu vinho,","que você produziu","com tanto trabalho."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Mas aqueles que ajuntam","o cereal","serão os que o comerão,","louvando o Senhor;","e os que recolhem as uvas","beberão o vinho nos átrios","do meu santuário.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Passem, passem pelas portas!","Preparem o caminho para o povo!","Aterrem, aterrem a estrada,","tirem as pedras,","levantem um estandarte","para os povos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Eis que o Senhor fez ouvir","até os confins da terra","estas palavras:","“Digam à filha de Sião:","Eis que vem o seu Salvador;","com ele vem a sua recompensa,","e diante dele vem o seu galardão.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Eles serão chamados de","“Povo Santo”,","“Remidos do Senhor”,","e você, Jerusalém,","será chamada de “Procurada”,","“Cidade Não Abandonada”."],"rlw_lines":[]}]}}