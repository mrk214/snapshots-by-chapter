    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pela paz de Jerusalém"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de peregrinação. De Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Alegrei-me quando me disseram:",
          "“Vamos à Casa do Senhor.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pararam os nossos pés",
          "junto às suas portas, ó Jerusalém!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Jerusalém,",
          "você que está construída",
          "como uma cidade bem sólida,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "para onde sobem as tribos,",
          "as tribos do Senhor,",
          "como convém a Israel,",
          "para renderem graças",
          "ao nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Lá estão os tronos de justiça,",
          "os tronos da casa de Davi."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Orem pela paz de Jerusalém!",
          "“Que sejam prósperos",
          "aqueles que a amam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Reine paz em seu meio",
          "e prosperidade nos seus palácios.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por amor dos meus irmãos",
          "e amigos,",
          "eu peço: “Haja paz em você!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por amor da Casa do Senhor,",
          "nosso Deus,",
          "buscarei o seu bem."
        ],
        "rlw_lines": []
      }
    ]
  },
