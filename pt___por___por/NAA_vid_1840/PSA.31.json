    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lamento e louvor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Em ti, Senhor, me refugio;",
          "não seja eu jamais envergonhado;",
          "livra-me por tua justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Inclina-me os ouvidos,",
          "livra-me depressa;",
          "sê o meu castelo forte,",
          "cidadela fortíssima que me salve."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque tu és a minha rocha",
          "e a minha fortaleza;",
          "por causa do teu nome,",
          "tu me conduzirás e me guiarás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tira-me do laço que,",
          "às escondidas, me armaram,",
          "pois tu és a minha fortaleza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Nas tuas mãos entrego",
          "o meu espírito;",
          "tu me remiste, Senhor,",
          "Deus da verdade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tu detestas",
          "os que adoram ídolos vãos;",
          "eu, porém, confio no Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Eu me alegrarei",
          "e regozijarei na tua bondade,",
          "pois tens visto a minha aflição,",
          "conheceste as angústias",
          "de minha alma"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "e não me entregaste",
          "nas mãos do inimigo;",
          "firmaste os meus pés",
          "em lugar espaçoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Compadece-te de mim, Senhor,",
          "porque estou angustiado;",
          "de tristeza se consomem",
          "os meus olhos,",
          "a minha alma e o meu corpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Gasta-se a minha vida",
          "na tristeza,",
          "e os meus anos, em gemidos;",
          "debilita-se a minha força,",
          "por causa da minha iniquidade,",
          "e os meus ossos se consomem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tornei-me objeto de deboche",
          "para todos os meus adversários,",
          "de espanto para os meus vizinhos",
          "e de horror",
          "para os meus conhecidos;",
          "os que me veem na rua",
          "fogem de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Estou esquecido",
          "no coração deles, como morto;",
          "sou como vaso quebrado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pois tenho ouvido",
          "a murmuração de muitos,",
          "terror por todos os lados;",
          "conspirando contra mim,",
          "tramam tirar-me a vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Quanto a mim,",
          "confio em ti, Senhor.",
          "Eu disse: “Tu és o meu Deus.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Nas tuas mãos",
          "estão os meus dias;",
          "livra-me das mãos",
          "dos meus inimigos",
          "e dos meus perseguidores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Faze resplandecer o teu rosto",
          "sobre o teu servo;",
          "salva-me por tua misericórdia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Não seja eu envergonhado,",
          "Senhor,",
          "pois te invoquei;",
          "envergonhados sejam",
          "os perversos,",
          "emudecidos na morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Emudeçam os lábios mentirosos,",
          "que falam insolentemente",
          "contra o justo,",
          "com arrogância e desdém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Como é grande a tua bondade,",
          "que reservaste aos que te temem,",
          "da qual usas,",
          "diante dos filhos dos homens,",
          "para com os que em ti se refugiam!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "No recôndito da tua presença,",
          "tu os esconderás",
          "das intrigas humanas,",
          "num esconderijo os ocultarás",
          "do conflito de línguas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Bendito seja o Senhor,",
          "que engrandeceu",
          "a sua misericórdia",
          "para comigo, numa cidade sitiada!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Eu disse na minha pressa:",
          "“Estou excluído da tua presença.”",
          "Mas tu ouviste",
          "a voz das minhas súplicas,",
          "quando clamei por teu socorro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Amem o Senhor, todos vocês",
          "que são os seus santos.",
          "O Senhor preserva os fiéis,",
          "mas retribui com abundância",
          "aos soberbos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Sejam fortes,",
          "e que se revigore o coração",
          "de todos vocês",
          "que esperam no Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
