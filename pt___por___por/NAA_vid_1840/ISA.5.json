{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.5","is_chapter":true,"previous":{"usfm":"ISA.4","human":"Isaías 4","canonical":true,"toc":true},"current":{"usfm":"ISA.5","human":"Isaías 5"},"next":{"usfm":"ISA.6","human":"Isaías 6","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["A parábola da vinha"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Agora cantarei ao meu amado","o seu cântico a respeito","da sua vinha.","O meu amado teve uma vinha","numa colina fértil."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Ele cavou a terra, tirou as pedras","e plantou as melhores mudas","de videira.","No meio da vinha","ele construiu uma torre","e fez também um lagar.","Ele esperava que desse uvas boas,","mas deu uvas bravas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["“E agora,","ó moradores de Jerusalém","e homens de Judá,","peço que julguem entre mim","e a minha vinha."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Que mais se podia fazer","à minha vinha,","que eu não lhe tenha feito?","E como, esperando eu","que desse uvas boas,","veio a produzir uvas bravas?”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["“E agora lhes darei a conhecer","o que pretendo fazer","com a minha vinha:","vou tirar a cerca que está ao redor,","para que a vinha sirva de pasto;","derrubarei o seu muro,","para que ela seja pisoteada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Farei dela um lugar abandonado;","não será podada, nem cavada,","mas crescerão nela espinheiros","e ervas daninhas.","Também darei ordem às nuvens","para que não derramem","chuva sobre ela.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Porque a vinha","do Senhor dos Exércitos","é a casa de Israel,","e os homens de Judá são","a planta preferida do Senhor.","Este esperava retidão,","mas eis aí opressão;","esperava justiça, mas eis aí clamor","por causa da injustiça."],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Ai dos maus!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Ai dos que ajuntam casas","e mais casas,","reúnem para si campos","e mais campos,","até que não haja mais lugar,","e ficam como únicos moradores","no meio da terra!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Eu ouvi o Senhor dos Exércitos","dizer isto:","“Na verdade, muitas casas","ficarão desertas,","até as grandes e belas","ficarão sem moradores."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Uma grande vinha produzirá","somente alguns litros de vinho,","e um saco cheio de semente","não dará mais do que","alguns quilos de trigo.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Ai dos que se levantam","pela manhã","para logo se embriagarem,","e continuam até alta noite,","até que o vinho os esquente!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Liras e harpas, tamborins e flautas","— e vinho — não faltam","nos seus banquetes;","porém não consideram","os feitos do Senhor,","nem olham para as obras","das suas mãos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Portanto, o meu povo","será levado cativo","por falta de entendimento;","os seus nobres passarão fome,","e o povo simples morrerá de sede."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Por isso, a sepultura aumentou","o seu apetite","e abriu ao máximo a sua boca.","Para lá desce","o esplendor de Jerusalém","e a sua multidão,","o seu ruído","e os que nela se alegram."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Então o povo será abatido","e as pessoas se humilharão;","e os olhos dos orgulhosos","serão humilhados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Mas o Senhor dos Exércitos","será exaltado em juízo;","Deus, o Santo,","será santificado em justiça."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Então os cordeiros pastarão ali","como se estivessem no seu pasto;","e os nômades se nutrirão","dos campos","que os ricos deixaram","abandonados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Ai dos que puxam para si","a iniquidade","com cordões de injustiça,","que puxam o pecado como se faz","com as cordas de uma carroça!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["E dizem: “Que Deus se apresse","e termine logo a sua obra,","para que a vejamos!","Que se aproxime","e se manifeste o conselho","do Santo de Israel,","para que o conheçamos!”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Ai dos que ao mal chamam bem","e ao bem chamam mal;","que fazem das trevas luz","e da luz fazem trevas;","que mudam o amargo em doce","e o doce mudam em amargo!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Ai dos que são sábios","aos seus próprios olhos","e inteligentes","em seu próprio conceito!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Ai dos que são heróis","para beber vinho","e valentes para misturar","bebida forte;"],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["que por suborno","justificam o ímpio,","mas ao justo negam justiça!"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Deus castigará o seu povo"],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Portanto, assim como as labaredas","consomem a palha,","e a erva seca se desfaz pela chama,","assim a raiz deles","será como podridão,","e a flor deles subirá como pó;","porque rejeitaram a lei","do Senhor dos Exércitos","e desprezaram a palavra","do Santo de Israel."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Por isso, a ira do Senhor","se acendeu contra o seu povo,","povo contra o qual estendeu a mão","e ao qual castigou.","Os montes tremeram","e os seus cadáveres são como lixo","no meio das ruas.","Nem com tudo isto","se desviou a ira de Deus,","e a mão dele continua estendida."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Ele levantará um estandarte","para as nações distantes","e lhes assobiará para que venham","das extremidades da terra;","e eis que elas vêm rapidamente,","com toda pressa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Não há entre elas","quem esteja cansado,","nem quem tropece;","ninguém dormita, nem dorme.","Eles não desatam","o cinto dos seus lombos,","e as correias das suas sandálias","não se rompem."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["As suas flechas são afiadas,","e todos os seus arcos, entesados.","Os cascos dos seus cavalos","são duros como pedra,","e as rodas dos seus carros de guerra","são como um redemoinho."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["O rugido deles é como o do leão;","rugem como filhos de leão,","e, rosnando, arrebatam a presa","e a levam, e não há quem a livre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Naquele dia,","o bramido contra eles","será como o bramido do mar;","se alguém olhar para a terra,","eis que só haverá trevas e angústia;","a luz se escurecerá","em densas nuvens."],"rlw_lines":[]}]}}