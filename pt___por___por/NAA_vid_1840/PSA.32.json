    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A bem-aventurança de quem recebe o perdão"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "De Davi. Salmo didático"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bem-aventurado aquele",
          "cuja transgressão é perdoada,",
          "cujo pecado é coberto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bem-aventurado é aquele",
          "a quem o Senhor",
          "não atribui iniquidade",
          "e em cujo espírito não há engano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enquanto calei os meus pecados,",
          "envelheceram os meus ossos",
          "pelos meus constantes gemidos",
          "todo o dia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque a tua mão pesava",
          "dia e noite sobre mim,",
          "e o meu vigor secou",
          "como no calor do verão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Confessei-te o meu pecado",
          "e a minha iniquidade",
          "não mais ocultei.",
          "Eu disse: “Confessarei ao Senhor",
          "as minhas transgressões”;",
          "e tu perdoaste a iniquidade",
          "do meu pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sendo assim,",
          "todo o que é piedoso",
          "te fará súplicas",
          "em tempo de poder te encontrar.",
          "Com efeito, quando transbordarem",
          "muitas águas,",
          "não o atingirão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tu és o meu esconderijo;",
          "tu me preservas da tribulação",
          "e me cercas de alegres cantos",
          "de livramento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eu o instruirei",
          "e lhe ensinarei o caminho",
          "que você deve seguir;",
          "e, sob as minhas vistas,",
          "lhe darei conselho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não sejam",
          "como o cavalo ou a mula,",
          "que não têm entendimento,",
          "que são dominados",
          "com freios e cabrestos;",
          "do contrário não obedecem",
          "a você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Muitos são os sofrimentos",
          "do ímpio,",
          "mas o que confia no Senhor,",
          "a misericórdia o cercará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Alegrem-se no Senhor",
          "e regozijem-se, ó justos;",
          "exultem, todos vocês",
          "que são retos de coração."
        ],
        "rlw_lines": []
      }
    ]
  },
