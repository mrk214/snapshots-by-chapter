    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O castigo de diversos povos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A sentença pronunciada",
          "pelo Senhor",
          "é contra a terra de Hadraque",
          "e repousa sobre Damasco,",
          "porque o Senhor põe os olhos",
          "sobre a humanidade",
          "e sobre todas as tribos de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Também repousa sobre Hamate,",
          "que faz fronteira com Damasco,",
          "e sobre Tiro e Sidom,",
          "cuja sabedoria é grande."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tiro edificou para si uma fortaleza",
          "e amontoou prata como pó,",
          "e ouro como lama das ruas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eis que o Senhor tomará posse",
          "da cidade",
          "e jogará as riquezas dela no mar;",
          "e Tiro será consumida pelo fogo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Asquelom verá isso",
          "e ficará com medo.",
          "Também Gaza ficará com medo",
          "e terá grande dor.",
          "Igualmente Ecrom,",
          "porque a sua esperança",
          "estará perdida.",
          "O rei de Gaza perecerá,",
          "e Asquelom não será habitada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Um povo bastardo",
          "habitará em Asdode,",
          "e exterminarei o orgulho",
          "dos filisteus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Da boca destes",
          "tirarei a carne com sangue",
          "e, dos seus dentes,",
          "as suas abominações.",
          "Então eles ficarão como um resto",
          "para o nosso Deus,",
          "e serão como chefes em Judá;",
          "e Ecrom será como os jebuseus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eu me acamparei",
          "ao redor da minha casa",
          "para defendê-la",
          "contra forças invasoras,",
          "para que ninguém passe,",
          "nem volte.",
          "Nunca mais passará sobre eles",
          "o opressor,",
          "porque agora vejo isso",
          "com os meus próprios olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O rei vem de Sião"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Alegre-se muito, ó filha de Sião!",
          "Exulte, ó filha de Jerusalém!",
          "Eis que o seu rei vem até você,",
          "justo e salvador,",
          "humilde, montado em jumento,",
          "num jumentinho, cria de jumenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Destruirei os carros de guerra",
          "de Efraim",
          "e os cavalos de Jerusalém;",
          "os arcos de guerra",
          "serão destruídos.",
          "Ele anunciará paz às nações;",
          "o seu domínio se estenderá",
          "de mar a mar",
          "e desde o Eufrates",
          "até os confins da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Quanto a você, Sião,",
          "por causa do sangue",
          "da minha aliança com você,",
          "tirei os seus cativos da cova",
          "em que não havia água."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Voltem para a fortaleza,",
          "ó prisioneiros da esperança!",
          "Também hoje anuncio",
          "que lhes restituirei",
          "tudo em dobro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Porque entesei Judá",
          "como meu arco de guerra",
          "e fiz de Efraim a minha flecha.",
          "Levantarei os seus filhos, ó Sião,",
          "contra os filhos da Grécia,",
          "e farei você semelhante à espada",
          "de um valente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor será visto",
          "sobre os filhos de Sião,",
          "e as suas flechas sairão",
          "como o relâmpago.",
          "O Senhor Deus fará soar",
          "a trombeta",
          "e irá com os redemoinhos do Sul."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O Senhor dos Exércitos",
          "protegerá o seu povo.",
          "Eles engolirão os inimigos",
          "e pisarão nas pedras",
          "atiradas com as fundas.",
          "Também beberão o sangue deles",
          "como se fosse vinho;",
          "eles se encherão",
          "como as bacias do sacrifício",
          "e ficarão ensopados",
          "como os cantos do altar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Naquele dia, o Senhor,",
          "seu Deus, os salvará,",
          "como o rebanho do seu povo;",
          "porque eles são pedras",
          "de uma coroa",
          "e resplandecem na terra dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pois quão grande",
          "é a sua bondade!",
          "E quão grande é a sua formosura!",
          "O trigo fará florescer os jovens,",
          "e o vinho, as moças."
        ],
        "rlw_lines": []
      }
    ]
  },
