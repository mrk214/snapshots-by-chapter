    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A queda da Babilônia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Desça e sente-se no pó,",
          "ó virgem filha da Babilônia;",
          "sente-se no chão,",
          "pois já não há trono,",
          "ó filha dos caldeus.",
          "Porque nunca mais",
          "você será chamada",
          "sensível e delicada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pegue as pedras do moinho",
          "e faça farinha;",
          "tire o véu, levante a saia,",
          "descubra as pernas",
          "e atravesse os rios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A sua nudez será descoberta,",
          "e se verá a sua vergonha;",
          "tomarei vingança",
          "e não pouparei ninguém.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Quanto ao nosso Redentor,",
          "Senhor dos Exércitos é o seu nome,",
          "o Santo de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Fique sentada em silêncio",
          "e vá para um lugar escuro,",
          "ó filha dos caldeus,",
          "porque nunca mais",
          "você será chamada",
          "senhora dos reinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu estava irado",
          "contra o meu povo,",
          "profanei a minha herança",
          "e a entreguei nas suas mãos,",
          "mas você não usou de misericórdia",
          "com ela",
          "e até sobre os velhos",
          "você fez muito pesado",
          "o seu jugo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Você disse: ‘Eu serei senhora",
          "para sempre!’",
          "Até agora você não levou",
          "estas coisas a sério,",
          "nem se lembrou do seu fim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Agora, pois, escute isto,",
          "você que ama os prazeres,",
          "que habita segura",
          "e que diz a si mesma:",
          "‘Eu sou a única,",
          "e não há outra além de mim.",
          "Não ficarei viúva, nem conhecerei",
          "a perda de filhos.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“Mas ambas estas coisas",
          "virão sobre você",
          "num momento, no mesmo dia:",
          "perda de filhos e viuvez;",
          "virão em cheio sobre você,",
          "apesar da multidão",
          "das suas feitiçarias",
          "e da abundância",
          "dos seus encantamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque você confiou",
          "na sua maldade e dizia:",
          "‘Não há quem me veja.’",
          "A sua sabedoria",
          "e o seu conhecimento,",
          "isso fez com que você se desviasse",
          "e dissesse a si mesma:",
          "‘Eu sou a única,",
          "e não há outra além de mim.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por isso, virá sobre você",
          "uma desgraça",
          "que você não saberá afastar",
          "com os seus encantamentos.",
          "Cairá sobre você uma calamidade",
          "da qual não poderá se livrar",
          "por expiação.",
          "Porque sobre você virá,",
          "de repente,",
          "uma desolação",
          "como você não imaginava."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Continue, pois,",
          "com os seus encantamentos",
          "e com a multidão",
          "das suas feitiçarias",
          "em que você tem se fatigado",
          "desde a sua mocidade!",
          "Talvez você possa tirar",
          "algum proveito disso;",
          "talvez, com isso,",
          "consiga inspirar terror."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Você está cansada",
          "de tanto ouvir conselhos!",
          "Que se levantem, agora,",
          "os que dissecam os céus",
          "e fitam os astros,",
          "os que em cada lua nova predizem",
          "o que há de vir sobre você.",
          "Que eles a ajudem!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Eis que serão como palha,",
          "o fogo os queimará;",
          "não poderão livrar-se",
          "do poder das chamas;",
          "nenhuma brasa restará",
          "para se aquecerem,",
          "nem fogo, para que",
          "diante dele se assentem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Isso é o que lhe farão",
          "aqueles com quem você se fatigou,",
          "aqueles com quem negociou",
          "desde a sua mocidade:",
          "eles se dispersarão, cambaleantes,",
          "cada qual pelo seu caminho;",
          "não haverá ninguém",
          "para salvá-la.”"
        ],
        "rlw_lines": []
      }
    ]
  },
