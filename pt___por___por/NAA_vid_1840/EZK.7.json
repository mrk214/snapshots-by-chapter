    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O fim chegou!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A palavra do Senhor veio a mim, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "— Filho do homem, assim diz o Senhor Deus a respeito da terra de Israel:",
          "“Chegou o fim!",
          "O fim chegou",
          "sobre os quatro cantos da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Agora o fim chegou",
          "sobre você, povo de Israel.",
          "Enviarei a minha ira sobre vocês.",
          "Eu os julgarei",
          "segundo os seus caminhos",
          "e farei cair sobre vocês",
          "todas as suas abominações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os meus olhos não terão piedade,",
          "e eu não os pouparei.",
          "Pelo contrário, eu darei",
          "o que vocês merecem",
          "por seus atos,",
          "e farei com que paguem",
          "por todas as suas abominações.",
          "E vocês saberão",
          "que eu sou o Senhor.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "— Assim diz o Senhor Deus:",
          "“Calamidade após calamidade,",
          "eis que vêm."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Chegou o fim!",
          "O fim chegou,",
          "já despertou contra você!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A sua sentença chegou,",
          "ó morador desta terra.",
          "Chegou a hora. O dia está próximo,",
          "dia de tumulto, e não de alegria,",
          "sobre os montes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Agora, em breve,",
          "derramarei o meu furor",
          "sobre você,",
          "cumprirei a minha ira contra você.",
          "Eu os castigarei",
          "segundo os seus caminhos",
          "e os farei pagar por todas",
          "as suas abominações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os meus olhos não terão piedade,",
          "e eu não os pouparei.",
          "Segundo os seus caminhos,",
          "assim os castigarei,",
          "e os farei pagar",
          "por suas abominações.",
          "E vocês saberão que eu, o Senhor,",
          "sou o que castiga.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Eis o dia! Eis que chegou!",
          "Brotou a sentença,",
          "já floresceu a vara,",
          "reverdeceu a arrogância."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A violência se ergueu",
          "para servir de vara de maldade.",
          "Nada restará deles,",
          "nem da sua multidão,",
          "nem da sua riqueza,",
          "nem da sua glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Chegou a hora,",
          "o dia está próximo.",
          "Quem compra não se alegre,",
          "e quem vende não se entristeça,",
          "porque a ira cairá sobre todos eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Porque o vendedor",
          "não tornará a possuir",
          "aquilo que vendeu,",
          "por mais que viva.",
          "Porque a profecia contra todos eles",
          "não será revogada,",
          "e, por causa da própria maldade,",
          "ninguém preservará a vida.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Tocaram a trombeta",
          "e prepararam tudo,",
          "mas ninguém vai à batalha,",
          "porque a minha ira",
          "cairá sobre todos eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Fora está a espada;",
          "dentro, a peste e a fome.",
          "Quem está no campo",
          "morre à espada,",
          "e quem está na cidade,",
          "a fome e a peste o consomem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Se alguns deles, fugindo,",
          "escaparem,",
          "estarão pelos montes,",
          "como pombas dos vales,",
          "todos gemendo, cada um",
          "por causa da sua maldade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Todas as mãos desfalecerão,",
          "e todos os joelhos se desfarão",
          "em água."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Vestirão roupa",
          "feita de pano de saco,",
          "e o terror tomará conta deles.",
          "Todos os rostos",
          "ficarão cobertos de vergonha,",
          "e todas as cabeças serão rapadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Jogarão a sua prata nas ruas,",
          "e o seu ouro será tratado",
          "como se fosse sujeira.",
          "Nem a sua prata nem o seu ouro",
          "poderão livrá-los",
          "no dia da ira do Senhor;",
          "eles não saciarão a sua fome,",
          "nem lhes encherão o estômago,",
          "porque a prata e o ouro",
          "foram o tropeço",
          "que os levou a cair em iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Dessas preciosas joias fizeram",
          "seu objeto de orgulho",
          "e fabricaram",
          "as suas abomináveis imagens",
          "e seus ídolos detestáveis.",
          "Por isso, fiz com que essas coisas",
          "se tornassem como sujeira",
          "para eles.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "“Entregarei tudo isso",
          "nas mãos de estrangeiros,",
          "por presa,",
          "e aos ímpios da terra, por despojo;",
          "eles o profanarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Desviarei deles o rosto,",
          "e profanarão o meu tesouro;",
          "ladrões entrarão nele",
          "e o profanarão.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "“Prepare uma corrente,",
          "porque a terra está cheia",
          "de crimes de sangue,",
          "e a cidade, cheia de violência."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Trarei aqui as piores nações,",
          "que tomarão posse",
          "das casas deles.",
          "Farei cessar a arrogância",
          "dos valentes,",
          "e os seus lugares santos",
          "serão profanados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "A destruição está a caminho!",
          "Eles buscarão paz,",
          "mas não haverá paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Virá miséria sobre miséria,",
          "e um rumor após o outro.",
          "Buscarão visões de profetas;",
          "do sacerdote perecerá a lei,",
          "e dos anciãos, o conselho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "O rei estará de luto,",
          "o príncipe se vestirá de horror,",
          "e as mãos do povo da terra",
          "tremerão de medo.",
          "Vou tratá-los",
          "segundo a sua conduta,",
          "e os julgarei",
          "pelos seus próprios critérios.",
          "E eles saberão",
          "que eu sou o Senhor.”"
        ],
        "rlw_lines": []
      }
    ]
  },
