    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Conselhos da Sabedoria aos moços"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Meu filho, não se esqueça",
          "dos meus ensinos,",
          "e que o seu coração guarde",
          "os meus mandamentos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "porque eles aumentarão",
          "os seus dias",
          "e lhe acrescentarão",
          "anos de vida e paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não deixe que a bondade",
          "e a fidelidade abandonem você.",
          "Amarre-as ao pescoço;",
          "escreva-as na tábua do seu coração"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "e você encontrará favor",
          "e boa compreensão",
          "diante de Deus",
          "e das outras pessoas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Confie no Senhor",
          "de todo o seu coração",
          "e não se apoie",
          "no seu próprio entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Reconheça o Senhor em todos",
          "os seus caminhos,",
          "e ele endireitará as suas veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Não seja sábio",
          "aos seus próprios olhos;",
          "tema o Senhor e afaste-se do mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Isto será como um remédio",
          "para o seu corpo",
          "e refrigério para os seus ossos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Honre o Senhor com os seus bens",
          "e com as primícias",
          "de toda a sua renda;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "e os seus celeiros ficarão",
          "completamente cheios,",
          "e os seus lagares",
          "transbordarão de vinho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Meu filho, não rejeite",
          "a disciplina do Senhor,",
          "nem se aborreça",
          "com a sua repreensão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque o Senhor repreende",
          "a quem ama,",
          "assim como um pai repreende",
          "o filho a quem quer bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Feliz é quem acha",
          "a sabedoria;",
          "feliz é aquele que alcança",
          "o entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque o lucro",
          "que a sabedoria dá é melhor",
          "do que o lucro da prata,",
          "e a sua renda é melhor",
          "do que o ouro mais fino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "A sabedoria é mais preciosa",
          "do que as joias,",
          "e tudo o que você possa desejar",
          "não se compara com ela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Em sua mão direita",
          "ela oferece vida longa,",
          "e na sua mão esquerda",
          "ela tem riquezas e honra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os seus caminhos",
          "são caminhos agradáveis,",
          "e todas as suas veredas são paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ela é árvore de vida",
          "para os que a alcançam,",
          "e felizes são todos os que a retêm."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "O Senhor com sabedoria lançou",
          "os fundamentos da terra;",
          "com inteligência",
          "estabeleceu os céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Pelo seu conhecimento",
          "os abismos se romperam,",
          "e as nuvens destilam o orvalho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Meu filho, que estas coisas",
          "não se afastem dos seus olhos;",
          "guarde a verdadeira sabedoria",
          "e o discernimento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "porque serão vida para a sua alma",
          "e enfeite para o seu pescoço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Então você andará seguro",
          "no seu caminho,",
          "e o seu pé não tropeçará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Quando se deitar,",
          "você não terá medo;",
          "sim, você se deitará",
          "e o seu sono será tranquilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Não temerá o pavor repentino,",
          "nem a desgraça dos ímpios,",
          "quando vier."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Porque o Senhor",
          "será a sua segurança",
          "e ele não deixará",
          "que os seus pés sejam presos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Não deixe de fazer o bem",
          "aos que dele precisam,",
          "estando em sua mão",
          "o poder de fazê-lo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Não diga ao seu próximo:",
          "“Vá e volte mais tarde;",
          "amanhã eu terei algo para dar”,",
          "se você tem isso em suas mãos agora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Não planeje nenhum mal",
          "contra o seu próximo,",
          "pois ele mora ao seu lado",
          "e confia em você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Não entre em litígio",
          "com alguém,",
          "se ele não tiver feito",
          "nenhum mal a você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Não tenha inveja",
          "do homem violento,",
          "nem siga nenhum",
          "de seus caminhos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "porque o Senhor",
          "detesta o perverso,",
          "mas aos retos",
          "trata com intimidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "A maldição do Senhor está",
          "sobre a casa dos ímpios,",
          "porém a morada dos justos",
          "ele abençoa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Certamente ele zomba",
          "dos zombadores,",
          "mas dá graça aos humildes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Os sábios herdarão honra,",
          "mas aos tolos está reservada",
          "a vergonha."
        ],
        "rlw_lines": []
      }
    ]
  },
