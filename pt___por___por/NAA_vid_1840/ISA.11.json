    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O reinado de paz"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Do tronco de Jessé",
          "sairá um rebento,",
          "e das suas raízes",
          "brotará um renovo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Repousará sobre ele",
          "o Espírito do Senhor,",
          "o Espírito de sabedoria",
          "e de entendimento,",
          "o Espírito de conselho",
          "e de fortaleza,",
          "o Espírito de conhecimento",
          "e de temor do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ele terá o seu prazer",
          "no temor do Senhor.",
          "Não julgará segundo a aparência,",
          "nem decidirá pelo que ouviu dizer,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "mas julgará com justiça os pobres",
          "e decidirá com equidade",
          "a favor dos mansos da terra.",
          "Castigará a terra com a vara",
          "de sua boca",
          "e com o sopro dos seus lábios",
          "matará o perverso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O cinto dele será a justiça,",
          "e a verdade será a faixa na cintura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O lobo habitará com o cordeiro,",
          "o leopardo se deitará",
          "junto do cabrito,",
          "o bezerro, o leão novo",
          "e o novilho gordo andarão juntos,",
          "e um pequenino os guiará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A vaca e a ursa pastarão juntas,",
          "e as suas crias juntas se deitarão;",
          "e o leão comerá palha como o boi."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A criança de peito brincará",
          "sobre a toca da cobra,",
          "e o já desmamado meterá a mão",
          "no ninho da serpente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não se fará mal nem dano algum",
          "em todo o meu santo monte,",
          "porque a terra se encherá",
          "do conhecimento do Senhor,",
          "como as águas cobrem o mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A nova glória de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Naquele dia, a raiz de Jessé estará posta por estandarte dos povos. As nações recorrerão a ela, e a glória será a sua morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Naquele dia, o Senhor tornará a estender a mão para resgatar o resto do seu povo, que for deixado, da Assíria, do Egito, de Patros, da Etiópia, de Elão, de Sinar, de Hamate e das terras do mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Levantará um estandarte",
          "para as nações,",
          "ajuntará os desterrados de Israel",
          "e recolherá os dispersos de Judá",
          "desde os quatro cantos da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "A inveja de Efraim acabará,",
          "e os adversários de Judá",
          "serão eliminados.",
          "Efraim não terá inveja de Judá,",
          "e Judá não oprimirá Efraim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ao contrário, voarão",
          "sobre os ombros",
          "dos filisteus, ao Ocidente;",
          "juntos despojarão",
          "os filhos do Oriente;",
          "estenderão as mãos",
          "sobre Edom e Moabe,",
          "e os filhos de Amom",
          "lhes serão sujeitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O Senhor destruirá totalmente",
          "o golfo do mar do Egito,",
          "e com a força do seu vento",
          "moverá a mão contra o Eufrates,",
          "dividindo-o em sete canais,",
          "para que qualquer um possa",
          "atravessá-lo de sandálias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Haverá um caminho plano",
          "para o resto do seu povo",
          "que for deixado na Assíria,",
          "como houve para Israel",
          "no dia em que saiu da terra do Egito."
        ],
        "rlw_lines": []
      }
    ]
  },
