    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A felicidade na Sião futura"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O deserto e a terra seca",
          "se alegrarão;",
          "o ermo exultará e florescerá",
          "como o narciso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele se cobrirá de flores,",
          "dará gritos de alegria e exultará.",
          "Receberá a glória do Líbano,",
          "o esplendor do Carmelo",
          "e de Sarom.",
          "Eles verão a glória do Senhor,",
          "o esplendor do nosso Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Fortaleçam as mãos frouxas",
          "e firmem os joelhos vacilantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Digam aos desalentados",
          "de coração:",
          "“Sejam fortes, não tenham medo.",
          "Eis aí está o Deus de vocês.",
          "A vingança vem,",
          "a retribuição de Deus;",
          "ele vem para salvar vocês.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Então se abrirão os olhos",
          "dos cegos,",
          "e se desimpedirão os ouvidos",
          "dos surdos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "os coxos saltarão como as corças,",
          "e a língua dos mudos cantará.",
          "Pois águas arrebentarão",
          "no deserto,",
          "e ribeiros, no ermo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A areia escaldante",
          "se transformará em lagos,",
          "e a terra seca,",
          "em mananciais de água.",
          "Onde os chacais",
          "costumavam viver,",
          "crescerá a erva com canas e juncos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "E ali haverá uma estrada,",
          "um caminho que será chamado",
          "de Caminho Santo.",
          "Os impuros não passarão por ele,",
          "pois será somente",
          "para o povo de Deus.",
          "Quem passar por esse caminho,",
          "mesmo que seja um tolo,",
          "não se perderá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ali não haverá leão;",
          "nenhum animal feroz",
          "passará por ele",
          "nem será encontrado nele;",
          "mas os remidos andarão",
          "por esse caminho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os resgatados do Senhor",
          "voltarão",
          "e virão a Sião",
          "com cânticos de júbilo.",
          "Alegria eterna",
          "coroará a sua cabeça.",
          "Ficarão tomados",
          "de júbilo e alegria,",
          "e deles fugirão",
          "a tristeza e o gemido."
        ],
        "rlw_lines": []
      }
    ]
  },
