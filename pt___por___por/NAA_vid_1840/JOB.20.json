    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segunda fala de Zofar"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Zofar, o naamatita, tomou a palavra e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Visto que os meus pensamentos",
          "me impõem resposta,",
          "eu me apresso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Eu ouvi a repreensão,",
          "que me envergonha,",
          "mas o meu espírito",
          "me obriga a responder",
          "segundo o meu entendimento.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "O júbilo dos ímpios é breve"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Será que você não sabe",
          "que desde todos os tempos,",
          "desde que o ser humano",
          "foi posto sobre a terra,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "o júbilo dos ímpios é breve,",
          "e a alegria dos maus",
          "é momentânea?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ainda que a sua presunção",
          "chegue aos céus,",
          "e a sua cabeça atinja as nuvens,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "como o seu próprio esterco,",
          "ele apodrecerá para sempre,",
          "e os que o conheceram",
          "perguntarão: ‘Onde está ele?’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Voará como um sonho",
          "e não será encontrado;",
          "será afugentado",
          "como uma visão da noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os olhos que o viram",
          "não o verão mais,",
          "e o lugar onde ele estava",
          "não o verá outra vez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os seus filhos procurarão",
          "aplacar os pobres,",
          "e com as suas mãos",
          "ele lhes devolverá os seus bens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ainda que os seus ossos",
          "estejam cheios do vigor",
          "da sua juventude,",
          "esse vigor se deitará",
          "com ele no pó.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "O mal é veneno"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Ainda que o mal seja doce",
          "na sua boca,",
          "e ele o esconda debaixo da língua,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "e o saboreie,",
          "e não o queira largar,",
          "mas o retenha em sua boca,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "o fato é que a sua comida",
          "se transformará",
          "no seu estômago;",
          "será veneno de cobra",
          "no seu interior."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Engoliu riquezas,",
          "mas terá de vomitá-las;",
          "Deus o obrigará a lançá-las",
          "de seu ventre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Sugou veneno de cobra;",
          "a mordedura da víbora o matará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Não se deliciará",
          "com a vista dos ribeiros",
          "e dos rios transbordantes de mel",
          "e de leite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Devolverá o fruto",
          "do seu trabalho",
          "e não o engolirá;",
          "do lucro dos seus negócios",
          "não tirará prazer nenhum."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Porque oprimiu",
          "e desamparou os pobres,",
          "roubou casas que não construiu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por não haver limites",
          "à sua cobiça,",
          "não chegará a salvar",
          "as coisas por ele desejadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Nada escapou",
          "à sua cobiça insaciável;",
          "por isso a sua prosperidade",
          "não durará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Na plenitude da sua riqueza,",
          "ficará angustiado;",
          "toda a força da miséria",
          "virá sobre ele.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "A ira de Deus sobre o ímpio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "“Para encher-lhe a barriga,",
          "Deus mandará sobre ele",
          "o furor da sua ira,",
          "que, por alimento,",
          "mandará chover sobre ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Se fugir das armas de ferro,",
          "uma flecha de bronze",
          "o atravessará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Ele arranca a flecha",
          "das suas costas,",
          "e esta vem brilhando com o seu fel;",
          "e o pavor tomará conta dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Todas as calamidades",
          "serão reservadas",
          "contra os seus tesouros;",
          "um fogo não aceso",
          "por mãos humanas o consumirá",
          "e devorará o que ficar",
          "na sua tenda.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "“Os céus manifestarão",
          "a sua iniquidade;",
          "e a terra se levantará contra ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "As riquezas de sua casa",
          "serão levadas embora;",
          "como água serão derramadas",
          "no dia da ira de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Esta é, da parte de Deus,",
          "a sorte do ímpio;",
          "esta é a herança",
          "decretada por Deus.”"
        ],
        "rlw_lines": []
      }
    ]
  },
