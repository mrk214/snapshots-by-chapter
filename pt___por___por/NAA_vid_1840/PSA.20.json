    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pela vitória"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Que o Senhor lhe responda",
          "no dia da tribulação;",
          "que o nome do Deus de Jacó",
          "o proteja!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Que do seu santuário",
          "lhe envie socorro",
          "e que desde Sião o sustenha."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que ele se lembre de todas",
          "as suas ofertas de cereais",
          "e aceite os holocaustos",
          "que você ofereceu."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Que Deus lhe conceda",
          "o que o seu coração almeja",
          "e realize tudo o que você planejou."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Celebraremos com júbilo",
          "a sua vitória",
          "e em nome do nosso Deus",
          "hastearemos pendões.",
          "Que o Senhor satisfaça",
          "todos os seus desejos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Agora sei que o Senhor",
          "salva o seu ungido;",
          "ele lhe responderá",
          "do seu santo céu",
          "com a vitoriosa força",
          "da sua mão direita."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Uns confiam em carros de guerra,",
          "e outros, em seus cavalos;",
          "nós, porém, invocaremos o nome",
          "do Senhor, nosso Deus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eles se prostram e caem;",
          "nós, porém, nos levantamos",
          "e nos mantemos em pé."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ó Senhor, dá vitória ao rei;",
          "responde-nos quando clamarmos."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
