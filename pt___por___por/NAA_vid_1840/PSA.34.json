    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Senhor é bom!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi, quando se fingiu de louco na presença de Aimeleque e, por este expulso, ele se foi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bendirei o Senhor",
          "em todo o tempo,",
          "o seu louvor estará sempre",
          "nos meus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "A minha alma se gloriará",
          "no Senhor;",
          "os humildes ouvirão isso",
          "e se alegrarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Louvem comigo",
          "a grandeza do Senhor,",
          "e todos juntos",
          "lhe exaltemos o nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Busquei o Senhor,",
          "e ele me acolheu;",
          "livrou-me de todos",
          "os meus temores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os que olham para ele",
          "ficarão radiantes;",
          "o rosto deles jamais se cobrirá",
          "de vexame."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Clamou este aflito,",
          "e o Senhor o ouviu",
          "e o livrou de todas",
          "as suas angústias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O anjo do Senhor acampa-se",
          "ao redor dos que o temem",
          "e os livra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Provem e vejam",
          "que o Senhor é bom;",
          "bem-aventurado é",
          "quem nele se refugia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Temam o Senhor,",
          "vocês que são os seus santos,",
          "pois nada falta aos que o temem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os leõezinhos",
          "passam necessidade",
          "e sentem fome,",
          "porém aos que buscam o Senhor",
          "bem nenhum lhes faltará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Venham, meus filhos, e escutem;",
          "eu lhes ensinarei",
          "o temor do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Quem de vocês",
          "ama a vida",
          "e quer longevidade",
          "para ver o bem?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Refreie a língua do mal",
          "e os lábios de falarem",
          "palavras enganosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Afaste-se do mal",
          "e pratique o bem;",
          "procure a paz",
          "e empenhe-se por alcançá-la."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os olhos do Senhor repousam",
          "sobre os justos,",
          "e os seus ouvidos estão abertos",
          "ao seu clamor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O rosto do Senhor está contra",
          "os que praticam o mal,",
          "para extirpar da terra",
          "a memória deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Clamam os justos,",
          "e o Senhor os escuta",
          "e os livra",
          "de todas as suas angústias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Perto está o Senhor dos que têm",
          "o coração quebrantado;",
          "ele salva os de espírito oprimido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Muitas são as aflições do justo,",
          "mas o Senhor de todas o livra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Preserva-lhe todos os ossos,",
          "nem um deles sequer",
          "será quebrado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "A desgraça matará o ímpio,",
          "e os que odeiam o justo",
          "serão condenados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "O Senhor resgata a alma",
          "dos seus servos,",
          "e dos que nele confiam",
          "nenhum será condenado."
        ],
        "rlw_lines": []
      }
    ]
  },
