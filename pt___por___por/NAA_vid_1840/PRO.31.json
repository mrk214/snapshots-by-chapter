    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Conselhos para o rei Lemuel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palavras do rei Lemuel, de Massá, que a mãe dele lhe ensinou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O que lhe direi, meu filho,",
          "filho do meu ventre?",
          "Que lhe direi,",
          "ó filho dos meus votos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não dê às mulheres a sua força,",
          "nem os seus caminhos",
          "às que destroem os reis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Não é próprio dos reis, ó Lemuel,",
          "não é próprio dos reis beber vinho,",
          "nem dos príncipes",
          "desejar bebida forte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quando eles bebem,",
          "se esquecem da lei",
          "e pervertem o direito",
          "de todos os aflitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Deem bebida forte",
          "aos que estão morrendo",
          "e vinho, aos amargurados",
          "de espírito;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para que bebam",
          "e se esqueçam da sua pobreza,",
          "e não se lembrem mais",
          "da sua miséria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Abra a boca a favor do mudo,",
          "pelo direito de todos",
          "os desamparados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Abra a boca, julgue retamente",
          "e faça justiça aos pobres",
          "e aos necessitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O louvor da mulher virtuosa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mulher virtuosa, quem a achará?",
          "O seu valor muito excede",
          "o de finas joias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O coração do seu marido",
          "confia nela,",
          "e não haverá falta de ganho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ela lhe faz bem e não mal,",
          "todos os dias da sua vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Busca lã e linho",
          "e de bom grado trabalha",
          "com as mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "É como o navio mercante:",
          "de longe traz o seu pão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "É ainda noite, e ela já se levanta,",
          "e dá mantimento à sua casa",
          "e tarefa às suas servas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ela examina uma propriedade",
          "e adquire-a;",
          "planta uma vinha",
          "com a renda do seu trabalho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Cinge os lombos com força",
          "e fortalece os seus braços."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ela percebe",
          "que o seu ganho é bom;",
          "a sua lâmpada",
          "não se apaga de noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Estende as mãos ao fuso,",
          "mãos que pegam na roca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Abre a mão aos aflitos;",
          "e ainda a estende",
          "aos necessitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Quanto à sua casa,",
          "não teme a neve,",
          "pois todos andam",
          "vestidos de lã escarlate."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Faz para si cobertas,",
          "veste-se de linho fino e de púrpura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Seu marido é estimado",
          "entre os juízes,",
          "quando se assenta",
          "com os anciãos da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Ela faz roupas de linho fino",
          "e as vende;",
          "ela fornece cintas",
          "aos comerciantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "A força e a dignidade",
          "são os seus vestidos,",
          "e, quanto ao dia de amanhã,",
          "não tem preocupações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Fala com sabedoria,",
          "e a instrução da bondade",
          "está na sua língua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Cuida do bom andamento",
          "da sua casa",
          "e não come o pão da preguiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Seus filhos se levantam",
          "e a chamam de",
          "bem-aventurada;",
          "seu marido a louva, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "“Muitas mulheres são virtuosas",
          "no que fazem,",
          "mas você supera todas elas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Enganosa é a graça,",
          "e vã é a formosura,",
          "mas a mulher que teme o Senhor,",
          "essa será louvada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Deem a ela",
          "o fruto das suas mãos,",
          "e que de público",
          "as suas obras a louvem."
        ],
        "rlw_lines": []
      }
    ]
  },
