    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O fim dos maus e dos bons"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Não se irrite",
          "por causa dos malfeitores,",
          "nem tenha inveja",
          "dos que praticam a iniquidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pois em breve eles secarão",
          "como a relva",
          "e murcharão",
          "como a erva verde."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Confie no Senhor e faça o bem;",
          "habite na terra",
          "e alimente-se da verdade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Agrade-se do Senhor,",
          "e ele satisfará os desejos",
          "do seu coração."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Entregue o seu caminho",
          "ao Senhor,",
          "confie nele, e o mais ele fará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Fará com que a sua justiça",
          "sobressaia como a luz",
          "e que o seu direito brilhe",
          "como o sol ao meio-dia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Descanse no Senhor",
          "e espere nele;",
          "não se irrite por causa daquele",
          "que prospera em seu caminho,",
          "por causa do que realiza",
          "os seus maus desígnios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Deixe a ira, abandone o furor;",
          "não se irrite;",
          "certamente isso acabará mal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque os malfeitores",
          "serão exterminados,",
          "mas os que esperam",
          "no Senhor possuirão a terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mais um pouco de tempo,",
          "e já não existirão os ímpios;",
          "você procurará no lugar",
          "onde eles estavam",
          "e não os encontrará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mas os mansos herdarão a terra",
          "e terão alegria",
          "na abundância de paz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Os ímpios fazem planos",
          "contra os justos",
          "e contra eles rangem os dentes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O Senhor dá risada dos ímpios,",
          "pois vê que o dia deles",
          "está chegando."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Os ímpios puxam da espada",
          "e preparam o arco",
          "para abater os pobres",
          "e necessitados,",
          "para matar os que trilham",
          "o reto caminho."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mas a espada deles",
          "lhes atravessará",
          "o próprio coração,",
          "e os seus arcos",
          "serão despedaçados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mais vale o pouco do justo",
          "que a abundância",
          "de muitos ímpios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pois os braços dos ímpios",
          "serão quebrados,",
          "mas os justos, o Senhor os sustém."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "O Senhor conhece",
          "os dias dos íntegros;",
          "a herança deles permanecerá",
          "para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Não serão envergonhados",
          "nos tempos difíceis",
          "e nos dias da fome se fartarão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Os ímpios, no entanto,",
          "perecerão,",
          "e os inimigos do Senhor serão",
          "como as mais belas pastagens:",
          "desaparecerão, como desaparece",
          "a fumaça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "O ímpio pede emprestado",
          "e não paga;",
          "o justo, porém,",
          "se compadece e dá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Aqueles a quem o Senhor abençoa",
          "possuirão a terra;",
          "e serão exterminados aqueles",
          "a quem ele amaldiçoa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "O Senhor firma os passos",
          "do homem bom",
          "e se agrada do seu caminho;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "se cair, não ficará prostrado,",
          "porque o Senhor",
          "o segura pela mão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Fui moço e agora sou velho,",
          "porém jamais vi",
          "o justo desamparado,",
          "nem a sua descendência",
          "a mendigar o pão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "É sempre compassivo",
          "e empresta,",
          "e a sua descendência",
          "será uma bênção."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Afaste-se do mal",
          "e pratique o bem,",
          "e a sua morada será perpétua."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Pois o Senhor ama a justiça",
          "e não desampara os seus santos.",
          "Serão preservados para sempre,",
          "mas a descendência dos ímpios",
          "será exterminada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Os justos herdarão a terra",
          "e nela habitarão para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Da boca do justo",
          "procede sabedoria,",
          "e a sua língua fala o que é justo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "No coração, ele tem",
          "a lei do seu Deus;",
          "os seus passos não vacilarão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "O perverso espreita o justo",
          "e procura tirar-lhe a vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Mas o Senhor não o deixará",
          "nas mãos do perverso,",
          "nem o condenará",
          "quando for julgado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Espere no Senhor",
          "e ande nos seus caminhos;",
          "ele o exaltará para que você",
          "herde a terra;",
          "você verá quando os ímpios",
          "forem exterminados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Vi um ímpio prepotente",
          "expandir-se como um cedro",
          "do Líbano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Passei, e eis que havia",
          "desaparecido;",
          "procurei-o,",
          "e já não foi encontrado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Observe aquele que é",
          "íntegro e reto;",
          "porque o futuro dele será de paz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Quanto aos transgressores,",
          "serão todos destruídos;",
          "a descendência dos ímpios",
          "será exterminada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Mas a salvação dos justos",
          "vem do Senhor;",
          "ele é a fortaleza deles",
          "em tempos de angústia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "O Senhor os ajuda e os livra;",
          "livra-os dos ímpios e os salva,",
          "porque nele buscam refúgio."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
