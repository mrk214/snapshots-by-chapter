    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração de um pecador aflito"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi. Em memória"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Não me repreendas, Senhor,",
          "na tua ira,",
          "nem me castigues no teu furor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cravam-se em mim as tuas setas,",
          "e a tua mão recai sobre mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não há parte sã na minha carne,",
          "por causa da tua indignação;",
          "não há saúde nos meus ossos,",
          "por causa do meu pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pois já se elevam acima",
          "de minha cabeça",
          "as minhas iniquidades;",
          "como fardos pesados,",
          "excedem as minhas forças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tenho feridas que cheiram mal",
          "e estão cheias de pus,",
          "por causa da minha insensatez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sinto-me encurvado",
          "e muito abatido,",
          "ando de luto o dia todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os meus lombos ardem,",
          "e não há parte sã na minha carne."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Estou aflito e mui quebrantado;",
          "dou gemidos por causa",
          "do desassossego do meu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Na tua presença, Senhor,",
          "estão os meus desejos todos,",
          "e a minha ansiedade",
          "não te é oculta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O meu coração bate acelerado,",
          "faltam-me as forças,",
          "e a luz dos meus olhos,",
          "até essa me deixou!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Os meus amigos e companheiros",
          "afastam-se da minha desgraça,",
          "e os meus parentes",
          "ficam de longe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Armam ciladas contra mim",
          "os que tramam tirar-me a vida;",
          "os que me procuram fazer o mal",
          "dizem coisas perniciosas",
          "e imaginam engano todo o dia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mas eu, como surdo, não ouço",
          "e, qual mudo, não abro a boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sou como quem não ouve",
          "e em cujos lábios não há réplica."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pois em ti, Senhor, espero;",
          "tu me responderás,",
          "Senhor, Deus meu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque eu dizia: “Não deixes",
          "que eles se alegrem de mim",
          "e contra mim se engrandeçam",
          "quando me resvala o pé.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pois estou prestes a tropeçar;",
          "a minha dor está sempre",
          "diante de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Confesso a minha iniquidade;",
          "suporto tristeza",
          "por causa do meu pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Mas os meus inimigos",
          "são vigorosos e fortes,",
          "e são muitos os que",
          "sem motivo me odeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Aqueles que pagam",
          "o mal pelo bem",
          "são meus adversários,",
          "porque eu sigo o que é bom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Não me desampares, Senhor;",
          "Deus meu,",
          "não te ausentes de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Apressa-te em socorrer-me,",
          "Senhor, salvação minha."
        ],
        "rlw_lines": []
      }
    ]
  },
