    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Os maus roubam"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Por que o Todo-Poderoso",
          "não designa",
          "tempos de julgamento?",
          "E por que os que o conhecem",
          "não veem tais dias?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Há os que removem",
          "os marcos de divisa,",
          "roubam os rebanhos",
          "e os apascentam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Levam o jumento",
          "que pertence ao órfão,",
          "e, como penhor,",
          "ficam com o boi da viúva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Desviam do caminho",
          "os necessitados,",
          "e os pobres da terra",
          "todos têm de se esconder.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Os pobres são explorados pelos maus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Como jumentos selvagens",
          "no deserto,",
          "os pobres saem",
          "para o seu trabalho,",
          "à procura de alimento;",
          "em campo aberto",
          "encontram comida",
          "para eles e para os seus filhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cortam o seu pasto no campo,",
          "e apanham as uvas que ficaram",
          "nas vinhas dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Passam a noite nus",
          "por falta de roupa",
          "e não têm cobertas contra o frio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "São encharcados",
          "pelas chuvas das montanhas",
          "e, por falta de abrigo,",
          "abraçam-se às rochas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Orfãozinhos são arrancados",
          "do peito,",
          "e dos pobres se toma penhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os pobres andam nus,",
          "sem roupa,",
          "e, famintos, carregam os feixes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Entre os muros desses perversos",
          "espremem o azeite;",
          "pisam as uvas no lagar,",
          "enquanto padecem sede."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Desde as cidades gemem",
          "os que estão para morrer,",
          "e a alma dos feridos pede socorro,",
          "mas Deus não considera isso",
          "anormal.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Perversos, assassinos, adúlteros, ladrões"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Os perversos são",
          "inimigos da luz,",
          "não conhecem os seus caminhos,",
          "nem permanecem",
          "nas suas veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O assassino se levanta",
          "de madrugada,",
          "mata o pobre e o necessitado,",
          "e de noite se torna ladrão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O olho do adúltero",
          "aguarda o crepúsculo,",
          "dizendo: ‘Ninguém me verá’;",
          "e cobre o rosto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Nas trevas,",
          "ladrões invadem as casas,",
          "mas de dia ficam escondidos;",
          "não querem nada com a luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pois a manhã é para todos eles",
          "como sombra de morte,",
          "mas os terrores da noite",
          "lhes são familiares.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus atenta ao perverso"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "“Os perversos são levados",
          "rapidamente",
          "na superfície das águas;",
          "a porção deles na terra é maldita,",
          "e por isso já não andam",
          "pelo caminho das vinhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A seca e o calor",
          "desfazem as águas da neve;",
          "a sepultura faz o mesmo",
          "com os que pecaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "A mãe se esquecerá deles,",
          "os vermes os comerão com gosto;",
          "nunca mais haverá",
          "lembrança deles.",
          "A injustiça será quebrada",
          "como uma árvore."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Maltratam as estéreis,",
          "que não têm filhos,",
          "e não fazem o bem às viúvas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Mas Deus, por sua força,",
          "prolonga os dias dos valentes;",
          "eles se veem em pé",
          "quando desesperavam da vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ele lhes dá descanso,",
          "e nisso se apoiam;",
          "mas os olhos de Deus",
          "estão atentos",
          "aos caminhos deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "São exaltados por breve tempo;",
          "depois, passam, colhidos",
          "como todos os demais;",
          "são cortados",
          "como as espigas do trigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Se não é assim,",
          "quem me desmentirá",
          "e anulará as minhas palavras?”"
        ],
        "rlw_lines": []
      }
    ]
  },
