    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Temor de Deus e felicidade no lar"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de peregrinação"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bem-aventurado",
          "aquele que teme o Senhor",
          "e anda nos seus caminhos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Você comerá",
          "do fruto do seu trabalho,",
          "será feliz,",
          "e tudo irá bem com você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sua esposa,",
          "no interior de sua casa,",
          "será como a videira frutífera;",
          "seus filhos serão",
          "como rebentos da oliveira",
          "ao redor da sua mesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eis como será abençoado",
          "o homem que teme o Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que o Senhor o abençoe",
          "desde Sião,",
          "para que você veja",
          "a prosperidade de Jerusalém",
          "durante os dias de sua vida,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "e veja os filhos dos seus filhos.",
          "Paz sobre Israel!"
        ],
        "rlw_lines": []
      }
    ]
  },
