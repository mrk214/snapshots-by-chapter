    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ai dos opressores gananciosos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Ai daqueles que,",
          "ainda no seu leito,",
          "imaginam a iniquidade",
          "e planejam o mal!",
          "Ao amanhecer, eles o praticam,",
          "porque têm poder para tanto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cobiçam campos",
          "e se apossam deles;",
          "cobiçam casas e as tomam;",
          "assim, fazem violência",
          "a um homem e à sua casa,",
          "a uma pessoa e à sua herança.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Portanto, assim diz o Senhor:",
          "“Eis que estou forjando",
          "uma calamidade",
          "contra esta família,",
          "da qual vocês não livrarão",
          "o seu pescoço.",
          "Vocês não andarão mais",
          "de cabeça erguida,",
          "porque será um tempo",
          "de calamidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Naquele dia, se criará",
          "um provérbio",
          "a respeito de vocês",
          "e se entoará",
          "a seguinte lamentação:",
          "‘Estamos completamente",
          "arruinados!",
          "A porção do meu povo,",
          "Deus a trocou!",
          "Como ele tirou o que era nosso!",
          "Entregou os nossos campos",
          "aos rebeldes!’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Portanto, na congregação",
          "do Senhor,",
          "quando a terra for dividida",
          "por sorteio,",
          "vocês não receberão",
          "nem uma parte dela.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contra os falsos profetas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Eles dizem:",
          "‘Não profetizem.",
          "Não profetizem tais coisas,",
          "porque a desgraça",
          "não cairá sobre nós."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tais coisas anunciadas",
          "não alcançarão a casa de Jacó.",
          "Estaria o Espírito",
          "do Senhor irritado?",
          "Será que ele agiria assim?’”",
          "“De fato, as minhas palavras",
          "fazem o bem",
          "ao que anda retamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas, há pouco, o meu povo",
          "se levantou como um inimigo.",
          "Além da roupa,",
          "vocês arrancam a capa",
          "daqueles que passam seguros,",
          "sem pensar em guerra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Vocês expulsam",
          "do seu lar querido",
          "as mulheres de meu povo;",
          "dos filhinhos delas vocês tiram",
          "a minha glória, para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Levantem-se e vão embora!",
          "Porque este não é",
          "o lugar de descanso.",
          "Vão embora",
          "por causa da impureza",
          "que traz destruição,",
          "sim, destruição enorme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Se alguém, seguindo o vento",
          "e a falsidade,",
          "inventar uma mentira do tipo:",
          "‘Eu lhes profetizarei",
          "a respeito de vinho",
          "e de bebida forte’,",
          "esse tal será o profeta deste povo.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Senhor congrega o remanescente de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Certamente eu ajuntarei",
          "todos vocês, casa de Jacó;",
          "certamente congregarei",
          "o remanescente de Israel.",
          "Eu os porei todos juntos,",
          "como ovelhas no aprisco,",
          "como rebanho",
          "no meio de sua pastagem;",
          "farão muito barulho,",
          "por causa da multidão",
          "de pessoas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Diante deles virá",
          "o que abre caminho;",
          "eles abrirão caminho,",
          "entrarão pelo portão",
          "e sairão por ele;",
          "e o seu Rei irá adiante deles;",
          "sim, o Senhor irá",
          "à frente deles.”"
        ],
        "rlw_lines": []
      }
    ]
  },
