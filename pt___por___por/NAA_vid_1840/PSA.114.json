    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "As maravilhas do êxodo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quando Israel saiu do Egito,",
          "e a casa de Jacó, do meio de",
          "um povo de língua estranha,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Judá se tornou",
          "o santuário do Senhor,",
          "e Israel, o seu domínio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O mar viu isso e fugiu;",
          "o Jordão recuou."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os montes saltaram",
          "como carneiros,",
          "e as colinas,",
          "como cordeiros do rebanho."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O que lhe aconteceu, ó mar,",
          "para que você fugisse assim?",
          "E você, Jordão, por que recuou?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Montes, por que estão saltando",
          "como carneiros?",
          "E vocês, colinas,",
          "como cordeiros do rebanho?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Trema, ó terra,",
          "na presença do Senhor,",
          "na presença do Deus de Jacó!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele transformou a rocha",
          "em lençol de água",
          "e o rochedo, em manancial."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
