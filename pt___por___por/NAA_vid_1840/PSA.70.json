    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pedindo ajuda"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. De Davi. Em memória"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Agrada-te, ó Deus,",
          "em me livrar;",
          "apressa-te, ó Senhor,",
          "em me socorrer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Que sejam envergonhados",
          "e cobertos de vexame",
          "os que buscam tirar-me a vida;",
          "retrocedam e cubram-se",
          "de vergonha",
          "os que se alegram com o meu mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Retrocedam por causa",
          "da sua vergonha",
          "os que dizem:",
          "“Bem feito! Bem feito!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Exultem e em ti se alegrem",
          "todos os que te buscam;",
          "e os que amam a tua salvação",
          "digam sempre:",
          "“Deus seja engrandecido!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eu sou pobre e necessitado;",
          "ó Deus, apressa-te em me socorrer,",
          "pois tu és o meu amparo",
          "e o meu libertador.",
          "Senhor, não te demores!"
        ],
        "rlw_lines": []
      }
    ]
  },
