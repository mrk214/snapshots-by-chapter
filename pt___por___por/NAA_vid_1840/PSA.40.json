    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cântico de louvor e pedido de ajuda"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Esperei com paciência",
          "pelo Senhor;",
          "ele se inclinou para mim",
          "e me ouviu quando clamei",
          "por socorro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tirou-me de um poço",
          "de perdição,",
          "de um atoleiro de lama;",
          "colocou os meus pés",
          "sobre uma rocha",
          "e firmou os meus passos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "E me pôs nos lábios",
          "um cântico novo,",
          "um hino de louvor ao nosso Deus.",
          "Muitos verão essas coisas, temerão",
          "e confiarão no Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Bem-aventurado é aquele",
          "que põe no Senhor",
          "a sua confiança",
          "e não se volta para os arrogantes,",
          "nem para os que seguem",
          "a mentira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "São muitas, Senhor, Deus meu,",
          "as maravilhas que tens operado",
          "e também os teus desígnios",
          "para conosco;",
          "não há ninguém",
          "que possa se igualar a ti.",
          "Eu quisera anunciá-los",
          "e deles falar,",
          "mas são mais do que",
          "se pode contar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sacrifícios e ofertas não quiseste;",
          "abriste os meus ouvidos;",
          "holocaustos e ofertas pelo pecado",
          "não requeres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Então eu disse: “Eis aqui estou,",
          "no rolo do livro está escrito",
          "a meu respeito;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "agrada-me fazer a tua vontade,",
          "ó Deus meu;",
          "a tua lei está dentro",
          "do meu coração.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Proclamei as boas-novas",
          "de justiça",
          "na grande congregação;",
          "jamais cerrei os lábios,",
          "tu o sabes, Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Não ocultei no coração",
          "a tua justiça;",
          "proclamei a tua fidelidade",
          "e a tua salvação;",
          "não escondi",
          "da grande congregação",
          "a tua graça e a tua verdade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Não retenhas de mim, Senhor,",
          "as tuas misericórdias;",
          "que a tua graça e a tua verdade",
          "sempre me guardem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "São incontáveis os males",
          "que me cercam;",
          "as minhas iniquidades",
          "me alcançaram,",
          "tantas, que me impedem a visão;",
          "são mais numerosas",
          "que os cabelos",
          "de minha cabeça,",
          "e o coração desfalece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Agrada-te, Senhor, em me livrar;",
          "apressa-te, ó Senhor,",
          "em me socorrer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Que sejam envergonhados",
          "e cobertos de vexame",
          "todos os que buscam",
          "tirar-me a vida;",
          "retrocedam",
          "e cubram-se de vergonha",
          "os que se alegram com o meu mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Sofram perturbação",
          "por causa da sua vergonha",
          "aqueles que me dizem:",
          "“Bem feito! Bem feito!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Exultem e em ti se alegrem",
          "todos os que te buscam;",
          "os que amam a tua salvação",
          "digam sempre:",
          "“O Senhor seja engrandecido!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Eu sou pobre e necessitado,",
          "porém o Senhor cuida de mim.",
          "Tu és o meu amparo",
          "e o meu libertador;",
          "não te demores, ó Deus meu!"
        ],
        "rlw_lines": []
      }
    ]
  },
