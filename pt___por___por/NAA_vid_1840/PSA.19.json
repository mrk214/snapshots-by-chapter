    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A excelência da criação e da palavra de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Os céus proclamam",
          "a glória de Deus,",
          "e o firmamento anuncia",
          "as obras das suas mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Um dia discursa a outro dia,",
          "e uma noite revela conhecimento",
          "a outra noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não há linguagem,",
          "nem há palavras,",
          "e deles não se ouve",
          "nenhum som."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No entanto, por toda a terra",
          "se faz ouvir a sua voz,",
          "e as suas palavras chegam",
          "até os confins do mundo.",
          "Aí, pôs uma tenda para o sol,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "que é como um noivo",
          "que sai dos seus aposentos,",
          "e se alegra como um herói",
          "a percorrer o seu caminho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Principia numa extremidade",
          "dos céus,",
          "e até a outra vai o seu percurso;",
          "e nada pode se esconder",
          "do seu calor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A lei do Senhor é perfeita",
          "e restaura a alma;",
          "o testemunho do Senhor é fiel",
          "e dá sabedoria aos simples."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os preceitos do Senhor são retos",
          "e alegram o coração;",
          "o mandamento do Senhor é puro",
          "e ilumina os olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O temor do Senhor é límpido",
          "e permanece para sempre;",
          "os juízos do Senhor são verdadeiros",
          "e todos igualmente, justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "São mais desejáveis do que ouro,",
          "mais do que muito ouro depurado;",
          "e são mais doces do que o mel",
          "e o destilar dos favos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Além disso, por eles",
          "se admoesta o teu servo;",
          "em os guardar",
          "há grande recompensa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Quem há que possa discernir",
          "as suas próprias faltas?",
          "Absolve-me",
          "das que me são ocultas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Também da soberba",
          "guarda o teu servo;",
          "que ela não me domine.",
          "Então serei irrepreensível",
          "e ficarei livre",
          "de grande transgressão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "As palavras dos meus lábios",
          "e o meditar do meu coração",
          "sejam agradáveis na tua presença,",
          "Senhor, rocha minha",
          "e redentor meu!"
        ],
        "rlw_lines": []
      }
    ]
  },
