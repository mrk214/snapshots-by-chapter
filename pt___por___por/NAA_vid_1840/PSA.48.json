    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A cidade de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico. Salmo dos filhos de Corá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Grande é o Senhor",
          "e mui digno de ser louvado,",
          "na cidade do nosso Deus,",
          "seu santo monte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alto e belo, alegria",
          "de toda a terra,",
          "é o monte Sião,",
          "para os lados do Norte,",
          "a cidade do grande Rei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Nos palácios dela,",
          "Deus se faz conhecer",
          "como alto refúgio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Por isso, eis que os reis se uniram",
          "e juntos a atacaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quando viram, se espantaram;",
          "ficaram com medo",
          "e fugiram apressados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O terror ali os venceu,",
          "e sentiram dores como de mulher",
          "que está dando à luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Com vento leste destruíste",
          "as naus de Társis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como temos ouvido dizer,",
          "agora vimos que aconteceu",
          "na cidade do Senhor dos Exércitos,",
          "na cidade do nosso Deus.",
          "Deus a estabelece para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pensamos, ó Deus,",
          "na tua misericórdia",
          "no meio do teu templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Como o teu nome, ó Deus,",
          "assim o teu louvor se estende",
          "até os confins da terra;",
          "a tua mão direita",
          "está cheia de justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Alegre-se o monte Sião,",
          "exultem as filhas de Judá,",
          "por causa dos teus juízos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Andem em volta de Sião,",
          "rodeiem-na toda,",
          "contem as suas torres;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "notem bem as suas muralhas,",
          "observem os seus palácios,",
          "para que possam contar",
          "às gerações vindouras"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "que este é Deus,",
          "o nosso Deus para todo o sempre;",
          "ele será nosso guia até a morte."
        ],
        "rlw_lines": []
      }
    ]
  },
