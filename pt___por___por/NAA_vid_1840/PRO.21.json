{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PRO","name":"Provérbios"},"chapter":{"chapter_usfm":"PRO.21","is_chapter":true,"previous":{"usfm":"PRO.20","human":"Provérbios 20","canonical":true,"toc":true},"current":{"usfm":"PRO.21","human":"Provérbios 21"},"next":{"usfm":"PRO.22","human":"Provérbios 22","canonical":true,"toc":true},"items":[{"type":"verse","verse_numbers":[1],"lines":["Como correntes de águas,","assim é o coração do rei","na mão do Senhor;","este o dirige para onde quiser."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Todo caminho de uma pessoa","é reto aos seus próprios olhos,","mas o Senhor sonda os corações."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Fazer justiça e julgar com retidão","é mais aceitável ao Senhor","do que oferecer sacrifícios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Olhar arrogante","e coração orgulhoso","— a lâmpada dos ímpios —","são pecado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Os planos de quem é esforçado","conduzem à fartura,","mas a pressa excessiva","leva à pobreza."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Fazer fortuna","por meio da mentira","é vaidade e armadilha mortal."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["A violência dos ímpios","os leva à ruína,","porque eles se recusam","a praticar a justiça."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["O caminho do culpado","é tortuoso,","mas, quanto ao inocente,","a sua conduta é reta."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Melhor é morar","no canto do terraço","do que com uma mulher briguenta","na mesma casa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["A alma do ímpio deseja o mal;","nem o seu vizinho","recebe dele compaixão."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Quando o zombador é castigado,","os ingênuos se tornam sábios;","e, quando o sábio é instruído,","cresce no conhecimento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Deus, o justo, observa","a casa dos ímpios","e os faz cair em desgraça."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Quem tapa os ouvidos","ao clamor do pobre","também clamará","e não será ouvido."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["O presente que se dá em segredo","acalma a ira,","e a dádiva em sigilo","vence a mais forte indignação."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Praticar a justiça","é uma alegria para o justo,","mas espanto","para os que praticam o mal."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Quem se desvia do caminho","do entendimento","repousará na congregação","dos mortos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Quem ama os prazeres","acabará na pobreza;","quem ama o vinho e a boa vida","nunca ficará rico."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["O ímpio serve de resgate","para o justo,","e, em lugar dos retos,","é entregue o infiel."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Melhor é morar","numa terra deserta","do que com a mulher briguenta","e geniosa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Na casa do sábio","há tesouros preciosos","e o suficiente para viver,","mas o tolo desperdiça","tudo o que tem."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Quem segue a justiça","e a bondade","achará a vida, a justiça e a honra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["O sábio escala a cidade","dos valentes","e derruba a fortaleza","em que eles confiam."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Quem guarda a boca e a língua","guarda a sua alma","de muitas dificuldades."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Quanto ao orgulhoso","e arrogante,","zombador é o seu nome;","ele age com orgulho e arrogância."],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["O preguiçoso morre desejando,","porque as suas mãos","se recusam a trabalhar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["O cobiçoso cobiça todo o dia,","porém o justo","dá com generosidade."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["O sacrifício dos ímpios","já é abominação;","ainda mais quando é oferecido","com más intenções!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["A testemunha falsa perecerá,","mas quem sabe ouvir","falará sem ser contestado."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["O ímpio aparenta determinação,","mas o justo considera","o seu caminho."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["Não há sabedoria,","nem entendimento,","nem mesmo conselho","contra o Senhor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["O cavalo é preparado","para o dia da batalha,","mas a vitória vem do Senhor."],"rlw_lines":[]}]}}