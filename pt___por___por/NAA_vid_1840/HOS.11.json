    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O amor de Deus e a ingratidão de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Quando Israel era menino,",
          "eu o amei;",
          "e do Egito chamei o meu filho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quanto mais eu os chamava,",
          "tanto mais se afastavam de mim;",
          "sacrificavam a baalins",
          "e queimavam incenso",
          "às imagens de escultura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mas fui eu que ensinei",
          "Efraim a andar;",
          "tomei-os nos meus braços,",
          "mas eles não entenderam",
          "que era eu que os curava."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Atraí-os com cordas humanas,",
          "com laços de amor;",
          "fui para eles como quem alivia",
          "o jugo de sobre o pescoço",
          "e me inclinei",
          "para dar-lhes de comer.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Não voltarão",
          "para a terra do Egito,",
          "mas o assírio será o seu rei,",
          "porque se recusam",
          "a voltar para mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A espada cairá",
          "sobre as suas cidades,",
          "consumirá os seus ferrolhos,",
          "e as devorará,",
          "por causa dos seus caprichos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque o meu povo é inclinado",
          "a rebelar-se contra mim;",
          "se são chamados a dirigir-se",
          "para o alto, ninguém o faz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Como poderia eu abandoná-lo,",
          "Efraim?",
          "Como poderia entregá-lo, Israel?",
          "Como faria com você",
          "o que fiz com Admá?",
          "Como poderia fazer de você",
          "outra Zeboim?",
          "Meu coração se comove",
          "dentro de mim;",
          "toda a minha compaixão",
          "se manifesta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não executarei o furor",
          "da minha ira;",
          "não voltarei para destruir Efraim.",
          "Porque eu sou Deus e não homem;",
          "sou o Santo no meio de vocês.",
          "Não virei com ira.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Seguirão o Senhor,",
          "que rugirá como leão.",
          "E, quando ele rugir,",
          "os filhos, tremendo,",
          "virão do Ocidente;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "tremendo, como passarinhos,",
          "virão os do Egito,",
          "e, como pombas,",
          "os da terra da Assíria.",
          "Eu os farei habitar",
          "em suas próprias casas”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A condenação de Israel e de Judá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Efraim me cercou com mentiras,",
          "e a casa de Israel, com engano;",
          "mas Judá ainda está",
          "do lado de Deus",
          "e permanece fiel ao Santo."
        ],
        "rlw_lines": []
      }
    ]
  },
