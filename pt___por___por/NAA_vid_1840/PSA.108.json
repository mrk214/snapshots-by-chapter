ue os teus amados","sejam livres,","salva-nos com a tua mão direita","e responde-nos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Deus falou na sua santidade:","“Exultarei; dividirei Siquém","e medirei o vale de Sucote."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Gileade é meu","e meu é também Manassés;","Efraim é o meu capacete;","Judá é o meu cetro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Moabe, porém,","é a minha bacia de lavar;","sobre Edom","atirarei a minha sandália;","sobre a Filístia jubilarei.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Quem me conduzirá","à cidade fortificada?","Quem me guiará até Edom?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Não nos rejeitaste, ó Deus?","Tu não sais, ó Deus,","com os nossos exércitos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Presta-nos auxílio na angústia,","pois vão é o socorro humano."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Em Deus faremos proezas,","porque ele mesmo pisará","os nossos adversários."],"rlw_lines":[]}]}}