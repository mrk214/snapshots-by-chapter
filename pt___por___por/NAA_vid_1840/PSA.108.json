    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus concede vitória ao seu povo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Firme está o meu coração, ó Deus!",
          "Cantarei e entoarei louvores",
          "de toda a minha alma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Acordem, lira e harpa!",
          "Quero acordar o alvorecer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Eu te darei graças entre os povos,",
          "ó Senhor!",
          "Cantarei louvores a ti",
          "entre as nações."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque a tua misericórdia",
          "se eleva acima dos céus,",
          "e a tua fidelidade,",
          "até as nuvens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sê exaltado, ó Deus,",
          "acima dos céus;",
          "e em toda a terra",
          "brilhe a tua glória."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Para que os teus amados",
          "sejam livres,",
          "salva-nos com a tua mão direita",
          "e responde-nos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Deus falou na sua santidade:",
          "“Exultarei; dividirei Siquém",
          "e medirei o vale de Sucote."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Gileade é meu",
          "e meu é também Manassés;",
          "Efraim é o meu capacete;",
          "Judá é o meu cetro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Moabe, porém,",
          "é a minha bacia de lavar;",
          "sobre Edom",
          "atirarei a minha sandália;",
          "sobre a Filístia jubilarei.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quem me conduzirá",
          "à cidade fortificada?",
          "Quem me guiará até Edom?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Não nos rejeitaste, ó Deus?",
          "Tu não sais, ó Deus,",
          "com os nossos exércitos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Presta-nos auxílio na angústia,",
          "pois vão é o socorro humano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Em Deus faremos proezas,",
          "porque ele mesmo pisará",
          "os nossos adversários."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
