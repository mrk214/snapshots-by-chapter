    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "Livro III"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "Salmos 73—89"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O problema da prosperidade dos maus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asafe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "De fato, Deus é bom",
          "para com Israel,",
          "para com os de coração limpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quanto a mim, porém,",
          "quase me resvalaram os pés;",
          "pouco faltou para que",
          "se desviassem os meus passos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois eu invejava os arrogantes,",
          "ao ver a prosperidade dos maus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Para eles não há preocupações,",
          "o seu corpo é forte e sadio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Não partilham",
          "das canseiras dos mortais,",
          "nem são afligidos",
          "como os outros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por isso, a soberba os cinge",
          "como um colar,",
          "e a violência os envolve",
          "como um manto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os olhos saltam-lhes",
          "de tanta gordura;",
          "do coração deles brotam fantasias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Zombam e falam com maldade;",
          "falam da opressão com arrogância."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Abrem a boca para falar",
          "contra os céus,",
          "e a língua deles percorre a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por isso, o seu povo",
          "se volta para eles",
          "e os tem por fonte",
          "da qual bebe com avidez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eles dizem:",
          "“Como Deus ficará sabendo?",
          "Por acaso o Altíssimo",
          "tem algum conhecimento?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eis que estes são os ímpios;",
          "e, sempre tranquilos,",
          "aumentam as suas riquezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Com certeza foi inútil",
          "conservar puro o meu coração",
          "e lavar as minhas mãos",
          "na inocência."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pois o dia inteiro sou afligido",
          "e cada manhã sou castigado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Se eu tivesse pensado",
          "em falar tais palavras,",
          "já aí teria traído a geração",
          "de teus filhos, ó Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Em só refletir",
          "para compreender isso,",
          "achei que a tarefa era",
          "pesada demais para mim;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "até que entrei",
          "no santuário de Deus",
          "e descobri qual seria o fim deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tu certamente os pões",
          "em lugares escorregadios",
          "e os fazes cair na destruição."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Como são destruídos",
          "num instante!",
          "São totalmente aniquilados",
          "de terror!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Como acontece com o sonho,",
          "quando alguém acorda,",
          "assim, ó Senhor, ao despertares,",
          "desprezarás a imagem deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Quando o meu coração",
          "estava cheio de amargura",
          "e o meu íntimo se comoveu,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "eu estava embrutecido",
          "e sem entendimento;",
          "era como um animal diante de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "No entanto,",
          "estou sempre contigo,",
          "tu me seguras",
          "pela minha mão direita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Tu me guias com o teu conselho",
          "e depois me recebes na glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Quem tenho eu no céu",
          "além de ti?",
          "E quem poderia eu querer",
          "na terra além de ti?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Ainda que a minha carne",
          "e o meu coração desfaleçam,",
          "Deus é a fortaleza do meu coração",
          "e a minha herança para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Os que se afastam de ti",
          "certamente perecerão;",
          "tu destróis todos os que são infiéis",
          "para contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Quanto a mim,",
          "bom é estar perto de Deus;",
          "faço do Senhor Deus o meu refúgio,",
          "para proclamar todas as suas obras."
        ],
        "rlw_lines": []
      }
    ]
  },
