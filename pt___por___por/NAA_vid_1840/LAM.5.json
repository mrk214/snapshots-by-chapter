    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pedindo misericórdia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Lembra-te, Senhor,",
          "do que nos aconteceu;",
          "considera e olha",
          "para a nossa desgraça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "A nossa herança foi entregue",
          "a estranhos,",
          "e as nossas casas,",
          "a estrangeiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Somos órfãos,",
          "já não temos pai;",
          "as nossas mães",
          "são como viúvas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Temos de comprar",
          "a nossa própria água;",
          "temos de pagar",
          "pela nossa própria lenha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os nossos perseguidores",
          "estão sobre o nosso pescoço;",
          "estamos exaustos",
          "e não temos descanso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Submetemo-nos aos egípcios",
          "e aos assírios,",
          "para nos fartarem de pão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nossos pais pecaram",
          "e já não existem;",
          "nós é que recebemos o castigo",
          "pelas suas iniquidades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Escravos dominam sobre nós;",
          "não há ninguém",
          "que nos livre das suas mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Arriscamos a vida",
          "para conseguir o nosso pão,",
          "por causa da ameaça",
          "que vem do deserto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Nossa pele queima",
          "como um forno,",
          "por causa do ardor da fome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "As mulheres foram",
          "violentadas em Sião;",
          "as virgens, nas cidades de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Enforcaram os príncipes,",
          "não tiveram nenhum respeito",
          "pelos velhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Os jovens são obrigados",
          "a virar os moinhos;",
          "os meninos tropeçam",
          "debaixo das cargas de lenha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Os anciãos já não se reúnem",
          "junto ao portão da cidade;",
          "os jovens já não cantam mais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Cessou a alegria",
          "de nosso coração;",
          "a nossa dança se transformou",
          "em lamentações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Caiu a coroa da nossa cabeça.",
          "Ai de nós, porque pecamos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Por causa disso,",
          "o nosso coração está doente;",
          "por causa dessas coisas,",
          "os nossos olhos se escureceram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pelo monte Sião,",
          "que está abandonado,",
          "vagueiam os chacais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Tu, Senhor,",
          "reinas eternamente,",
          "o teu trono subsiste",
          "de geração em geração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por que te esquecerias",
          "de nós para sempre?",
          "Por que nos desampararias",
          "por tanto tempo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Converte-nos a ti, Senhor,",
          "e seremos convertidos;",
          "renova os nossos dias como",
          "antigamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Por que nos rejeitarias de vez?",
          "Por que ficarias tão enfurecido",
          "contra nós?"
        ],
        "rlw_lines": []
      }
    ]
  },
