    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Senhor vai castigar o mundo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eis que o Senhor vai devastar",
          "e desolar a terra,",
          "vai transtornar a sua superfície",
          "e dispersar os seus moradores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O mesmo vai acontecer com todos:",
          "com o povo e com o sacerdote;",
          "com o servo e com o seu senhor;",
          "com a serva e com a sua dona;",
          "com o comprador",
          "e com o vendedor;",
          "com o que empresta",
          "e com o que toma emprestado;",
          "com o credor e com o devedor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A terra será completamente",
          "devastada",
          "e totalmente saqueada,",
          "porque o Senhor",
          "é quem proferiu esta palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A terra pranteia e murcha;",
          "o mundo enfraquece e murcha;",
          "enfraquecem os mais nobres",
          "do povo da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A terra está contaminada",
          "por causa dos seus moradores,",
          "porque transgridem as leis,",
          "violam os estatutos",
          "e quebram a aliança eterna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Por isso, a maldição",
          "consome a terra,",
          "e os que habitam nela",
          "se tornam culpados.",
          "Por isso, os moradores da terra",
          "serão queimados,",
          "e poucas pessoas restarão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O vinho pranteia,",
          "a videira murcha,",
          "e gemem todos os que estavam",
          "de coração alegre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Cessou o som alegre",
          "dos tamborins,",
          "acabou o ruído dos que exultam,",
          "cessou o som alegre da harpa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Já não se bebe vinho",
          "entre canções;",
          "a bebida forte é amarga",
          "para os que a bebem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A cidade caótica está demolida;",
          "todas as casas estão fechadas,",
          "e ninguém consegue entrar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Gritam por vinho nas ruas;",
          "todo o riso desapareceu;",
          "a alegria foi banida da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Na cidade, só restou a desolação,",
          "e o portão está em pedaços."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O que acontecerá na terra,",
          "no meio dos povos,",
          "é como o sacudir da oliveira",
          "no tempo da colheita",
          "e o rebuscar das parreiras",
          "depois de acabada a vindima."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A alegria dos justos e a ruína dos transgressores"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Eles levantam a voz",
          "e cantam com alegria;",
          "por causa da glória do Senhor,",
          "exultam desde o mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por isso, no Oriente",
          "deem glória ao Senhor",
          "e, nas terras do mar,",
          "glorifiquem o nome do Senhor,",
          "o Deus de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Dos confins da terra",
          "ouvimos cantar:",
          "“Glória ao Justo!”",
          "Mas eu digo: “Estou definhando!",
          "Estou definhando! Ai de mim!",
          "Os traidores estão traindo;",
          "sim, os traidores",
          "só tramam traições.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Terror, buracos e armadilhas",
          "esperam por vocês,",
          "moradores da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Aquele que fugir da voz do terror",
          "cairá no buraco,",
          "e, se sair do buraco,",
          "será apanhado na armadilha.",
          "Porque as represas do alto",
          "se abrem,",
          "e tremem os fundamentos da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A terra será totalmente quebrada,",
          "a terra ficará completamente",
          "despedaçada,",
          "a terra será violentamente sacudida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "A terra vai cambalear",
          "como um bêbado",
          "e balançar como uma cabana;",
          "a sua transgressão pesa sobre ela,",
          "ela cairá e nunca mais se levantará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Naquele dia, o Senhor castigará,",
          "nas alturas, os exércitos celestiais,",
          "e, na terra, castigará os reis da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Serão ajuntados",
          "como presos em masmorra",
          "e encerrados num cárcere;",
          "e, depois de muitos dias,",
          "serão castigados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "A lua ficará corada de vergonha",
          "e o sol se envergonhará",
          "quando o Senhor dos Exércitos",
          "reinar no monte Sião",
          "e em Jerusalém;",
          "e diante dos seus anciãos",
          "haverá glória."
        ],
        "rlw_lines": []
      }
    ]
  },
