        "lines": [
          "Das profundezas clamo a ti"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de peregrinação"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Das profundezas",
          "clamo a ti, Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Escuta, Senhor, a minha voz;",
          "estejam alertas os teus ouvidos",
          "às minhas súplicas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Se tu, Senhor,",
          "observares iniquidades,",
          "quem, Senhor, poderá escapar?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mas contigo está o perdão,",
          "para que sejas temido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aguardo o Senhor,",
          "a minha alma o aguarda;",
          "eu espero na sua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A minha alma anseia pelo Senhor",
          "mais do que os guardas anseiam",
          "pelo romper da manhã.",
          "Mais do que os guardas",
          "pelo romper da manhã,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "espere Israel no Senhor,",
          "pois no Senhor há misericórdia;",
          "nele, temos ampla redenção."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "É ele quem redime Israel",
          "de todas as suas iniquidades."
        ],
        "rlw_lines": []
      }
    ]
  },
