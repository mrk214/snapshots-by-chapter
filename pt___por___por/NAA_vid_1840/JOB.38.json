    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "Diálogo final"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "38.1—42.6"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primeira resposta de Deus a Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então, do meio de um redemoinho, o Senhor respondeu a Jó e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Quem é este",
          "que obscurece os meus planos",
          "com palavras sem conhecimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cinja os lombos como homem,",
          "pois eu lhe farei perguntas,",
          "e você me responderá.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Eu lancei os fundamentos da terra"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Onde você estava,",
          "quando eu lancei",
          "os fundamentos da terra?",
          "Responda, se você",
          "tem entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem determinou",
          "as medidas da terra,",
          "se é que você o sabe?",
          "Ou quem estendeu sobre ela",
          "uma linha de medir?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sobre o que estão firmadas",
          "as suas bases",
          "ou quem lhe assentou",
          "a pedra angular,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "quando as estrelas da alva,",
          "juntas, alegremente cantavam,",
          "e todos os filhos de Deus",
          "gritavam de alegria?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Ou quem encerrou",
          "o mar com portões,",
          "quando irrompeu do ventre,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "quando eu lhe pus",
          "as nuvens por vestimenta",
          "e a escuridão por fraldas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "quando eu lhe tracei limites,",
          "e lhe pus ferrolhos e portas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "e disse: ‘Até aqui",
          "você pode chegar,",
          "mas deste ponto não passará.",
          "Aqui se quebrará o orgulho",
          "das suas ondas’?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "De onde vêm a luz e a escuridão?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "“Alguma vez na vida",
          "você deu ordens à madrugada",
          "ou mostrou ao amanhecer",
          "o seu lugar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "para que agarrasse a terra",
          "pelas extremidades",
          "e dela sacudisse os perversos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "A terra se modela",
          "como o barro debaixo do selo,",
          "e tudo se apresenta",
          "como um vestido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Dos ímpios é retirada a sua luz,",
          "e o braço levantado",
          "para ferir se quebra.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "“Você foi até",
          "as nascentes do mar",
          "ou percorreu o mais profundo",
          "do abismo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Será que a você foram reveladas",
          "as portas da morte?",
          "Você viu essas portas",
          "da região tenebrosa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Você tem noção clara",
          "da largura da terra?",
          "Responda, se você sabe tudo isso.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "“Onde está o caminho",
          "para a morada da luz?",
          "E, quanto às trevas,",
          "onde é o seu lugar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "para que você as conduza",
          "ao seu território",
          "e conheça o caminho",
          "para a sua casa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Você sabe isso,",
          "porque nesse tempo",
          "já era nascido",
          "e porque é grande",
          "o número dos seus dias!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Quem faz a neve?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“Você alguma vez",
          "entrou nos depósitos da neve",
          "ou viu os reservatórios do granizo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "que eu guardo",
          "até o tempo da angústia,",
          "até o dia da batalha e da guerra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Qual é o caminho para o lugar",
          "onde se difunde a luz",
          "e onde o vento leste",
          "se espalha sobre a terra?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Quem faz a chuva, o orvalho, o gelo e a geada?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "“Quem abriu canais",
          "para o aguaceiro",
          "ou caminho para os relâmpagos",
          "e trovões,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "para fazer chover sobre a terra",
          "onde não há ninguém,",
          "e nos lugares desertos",
          "onde ninguém mora;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "para dessedentar a terra deserta",
          "e assolada",
          "e para fazer crescer",
          "os renovos da erva?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Por acaso a chuva tem pai?",
          "Ou quem gera as gotas de orvalho?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "De que ventre procede o gelo?",
          "E quem dá à luz a geada do céu?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "As águas ficam duras",
          "como a pedra,",
          "e a superfície das profundezas",
          "se torna compacta.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Você conhece as leis que governam o céu?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "“Será que você pode atar",
          "as correntes do Sete-estrelo",
          "ou soltar as cordas do Órion?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Você pode fazer aparecer",
          "as constelações a seu tempo",
          "ou guiar a Ursa Maior",
          "com os seus filhos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Você conhece as leis",
          "que governam os céus,",
          "e pode estabelecer",
          "a sua influência sobre a terra?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Quem pode derramar a chuva?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "“Você é capaz de levantar",
          "a sua voz até as nuvens,",
          "para que a abundância das águas",
          "cubra você?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Você pode dar ordens",
          "aos relâmpagos,",
          "para que saiam e lhe digam:",
          "‘Às suas ordens!’?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Quem pôs sabedoria no coração",
          "ou deu entendimento à mente?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Quem pode numerar",
          "com sabedoria as nuvens?",
          "Ou os cântaros dos céus,",
          "quem os pode despejar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "para que o pó se transforme",
          "em massa sólida,",
          "e os torrões se apeguem",
          "uns aos outros?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Quem alimenta os animais e as aves?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "“Será que é você que caça",
          "a presa para a leoa",
          "ou mata a fome dos leõezinhos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "quando se agacham nos covis",
          "e ficam à espreita nas suas covas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Quem prepara o alimento",
          "para o corvo,",
          "quando os seus filhotes",
          "clamam a Deus",
          "e andam vagueando,",
          "por não terem o que comer?”"
        ],
        "rlw_lines": []
      }
    ]
  },
