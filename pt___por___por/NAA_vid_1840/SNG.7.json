    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Como são bonitos os seus pés",
          "nas sandálias,",
          "ó filha do príncipe!",
          "As curvas dos seus quadris",
          "são como colares trabalhados",
          "por mãos de artista."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O seu umbigo",
          "é uma taça redonda",
          "onde nunca falta bebida;",
          "o seu ventre é um monte de trigo,",
          "cercado de lírios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os seus seios são como",
          "duas crias gêmeas",
          "de uma gazela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O seu pescoço é como",
          "uma torre de marfim.",
          "Os seus olhos são como",
          "as piscinas de Hesbom,",
          "junto ao portão de Bate-Rabim.",
          "O seu nariz é como",
          "a torre do Líbano,",
          "voltada para Damasco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A sua cabeça é como",
          "o monte Carmelo;",
          "os seus cabelos são como",
          "a púrpura;",
          "um rei está preso nas suas tranças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Como você é linda!",
          "Como você é atraente, meu amor,",
          "com as suas delícias!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Esse seu porte",
          "é semelhante à palmeira,",
          "e os seus seios",
          "se parecem com os cachos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eu disse: “Vou subir na palmeira",
          "e colher os seus frutos.”",
          "Sejam os seus seios",
          "como os cachos de uvas,",
          "e o aroma da sua respiração,",
          "como o das maçãs."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os seus beijos são",
          "como o bom vinho…"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "… vinho que se escoa suavemente",
          "para o meu amado,",
          "deslizando entre os seus lábios",
          "e dentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eu sou do meu amado,",
          "e ele tem saudades de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Venha, meu amado,",
          "vamos para o campo,",
          "passemos a noite nas aldeias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Vamos levantar cedo",
          "e olhar as parreiras,",
          "para ver se já começaram a brotar,",
          "se as flores estão se abrindo,",
          "se as romãzeiras já estão em flor.",
          "Ali eu lhe darei o meu amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "As mandrágoras exalam",
          "o seu perfume,",
          "e às nossas portas há todo tipo",
          "de frutos excelentes,",
          "frescos e secos,",
          "que reservei para você,",
          "meu amado."
        ],
        "rlw_lines": []
      }
    ]
  },
