    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Falarei ao Todo-Poderoso"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Eis que os meus olhos",
          "viram tudo isso,",
          "e os meus ouvidos",
          "o ouviram e entenderam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O que vocês sabem",
          "eu também sei;",
          "em nada sou inferior a vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mas falarei ao Todo-Poderoso",
          "e quero defender-me",
          "diante de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Vocês, porém,",
          "cobrem a verdade",
          "com mentiras;",
          "todos vocês são médicos",
          "que não valem nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem dera vocês ficassem",
          "completamente calados!",
          "Vocês poderiam passar",
          "por sábios!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Vocês zombariam de Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Ouçam agora a minha defesa",
          "e prestem atenção aos argumentos",
          "dos meus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Será que vão dizer perversidades",
          "em favor de Deus?",
          "Vão dizer mentiras a favor dele?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Serão parciais por ele?",
          "Argumentarão a favor de Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por acaso, seria bom",
          "se ele os examinasse?",
          "Ou vocês zombariam dele,",
          "como zombam das pessoas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ele certamente os repreenderá,",
          "se em oculto forem parciais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A grandeza dele",
          "não os amedrontaria?",
          "E o terror dele",
          "não cairia sobre vocês?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "As máximas de vocês",
          "são provérbios de cinza;",
          "as defesas de vocês",
          "são muralhas de barro.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Defenderei minha causa diante de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Calem-se diante de mim,",
          "e eu falarei;",
          "que venha sobre mim o que vier."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tomarei a minha carne",
          "nos meus dentes",
          "e porei a minha vida",
          "nas minhas mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eis que ele me matará,",
          "já não tenho esperança;",
          "mesmo assim defenderei",
          "a minha conduta diante dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Também isto será",
          "a minha salvação:",
          "o fato de um ímpio",
          "não comparecer diante dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ouçam com atenção",
          "as minhas palavras",
          "e escutem a minha exposição."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tenho já bem-encaminhada",
          "minha causa",
          "e estou certo de que",
          "serei justificado.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Ó Deus, por que me consideras teu inimigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "“Quem há que possa",
          "entrar em litígio comigo?",
          "Se houver, eu fico calado e morro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Concede-me somente",
          "duas coisas, ó Deus,",
          "e assim não me esconderei de ti:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "tira a tua mão de cima de mim,",
          "e não me amedronte o teu terror.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“Interpela-me, e eu responderei;",
          "ou deixa-me falar, e tu responderás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Quantas culpas",
          "e pecados tenho eu?",
          "Mostra-me a minha transgressão",
          "e o meu pecado.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "“Por que escondes o teu rosto",
          "e me consideras teu inimigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Queres aterrorizar uma folha",
          "levada pelo vento?",
          "E perseguirás a palha seca?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "“Pois decretas contra mim",
          "coisas amargas",
          "e me atribuis as culpas",
          "da minha mocidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Também prendes os meus pés",
          "com correntes,",
          "observas todos os meus caminhos",
          "e traças limites",
          "à planta dos meus pés,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "apesar de eu ser",
          "como uma coisa podre",
          "que se consome",
          "e como a roupa",
          "que é comida pela traça.”"
        ],
        "rlw_lines": []
      }
    ]
  },
