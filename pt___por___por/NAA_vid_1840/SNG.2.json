  "book": {
    "book_usfm": "SNG",
    "name": "Cântico dos Cânticos"
  },
  "chapter": {
    "usfm": "SNG.2",
    "human": "Cântico dos Cânticos 2",
    "previous": {
      "usfm": "SNG.1",
      "human": "Cântico dos Cânticos 1"
    },
    "next": {
      "usfm": "SNG.3",
      "human": "Cântico dos Cânticos 3"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu sou a rosa de Sarom,",
          "o lírio dos vales."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como um lírio entre os espinhos,",
          "assim é a minha querida",
          "entre as donzelas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Como a macieira",
          "entre as árvores do bosque,",
          "assim é o meu amado",
          "entre os jovens.",
          "Desejo muito a sua sombra",
          "e debaixo dela me assento,",
          "e o seu fruto é doce",
          "ao meu paladar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ele me levou à sala do banquete,",
          "e o seu estandarte sobre mim",
          "é o amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sustentem-me com passas,",
          "confortem-me com maçãs,",
          "pois estou morrendo de amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A sua mão esquerda",
          "está debaixo da minha cabeça,",
          "e a direita me abraça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Filhas de Jerusalém,",
          "jurem pelas gazelas",
          "e pelas corças selvagens",
          "que vocês não acordarão",
          "nem despertarão o amor,",
          "até que este o queira."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segundo cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ouço a voz do meu amado.",
          "Eis que ele vem,",
          "saltando sobre os montes,",
          "pulando sobre as colinas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O meu amado é semelhante",
          "ao gamo",
          "ou ao filho da gazela.",
          "Eis que ele está",
          "detrás de nossa parede,",
          "olhando pelas janelas,",
          "espreitando pelas grades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O meu amado fala e me diz:"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Levante-se, minha querida,",
          "minha linda, e venha comigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque eis que passou o inverno,",
          "a chuva cessou e se foi,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "aparecem as flores na terra,",
          "chegou o tempo",
          "de cantarem as aves,",
          "e já se ouve a voz",
          "da rolinha em nossa terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "A figueira começou",
          "a dar seus figos,",
          "e as vinhas em flor",
          "exalam o seu aroma.",
          "Levante-se, minha querida,",
          "minha linda, e venha comigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Minha pombinha,",
          "escondida nas fendas",
          "dos penhascos,",
          "no esconderijo",
          "das rochas escarpadas,",
          "mostre-me o seu rosto,",
          "deixe-me ouvir a sua voz;",
          "porque a sua voz é doce,",
          "e o seu rosto é lindo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Peguem as raposas,",
          "as raposinhas,",
          "que devastam os vinhedos,",
          "porque as nossas vinhas",
          "estão em flor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O meu amado é meu,",
          "e eu sou dele;",
          "ele apascenta o seu rebanho",
          "entre os lírios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Antes que rompa o dia",
          "e fujam as sombras,",
          "volte, meu amado.",
          "Venha correndo como o gamo",
          "ou o filho das gazelas",
          "sobre os montes de Beter."
        ],
        "rlw_lines": []
      }
    ]
  },
