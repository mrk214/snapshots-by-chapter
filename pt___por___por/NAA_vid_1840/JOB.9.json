    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resposta de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Quem ousa desafiar a Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jó respondeu:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Na verdade, sei que assim é;",
          "porque, como pode o mortal",
          "ser justo diante de Deus?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Se quiser discutir com ele,",
          "nem a uma de mil coisas",
          "lhe poderá responder."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ele é sábio de coração",
          "e grande em poder;",
          "quem ousou desafiá-lo",
          "e sobreviveu?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele é quem remove os montes,",
          "sem que saibam",
          "que na sua ira ele os transtorna."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Deus remove a terra do seu lugar,",
          "e faz as suas colunas estremecerem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele dá uma ordem ao sol,",
          "e este não sai,",
          "e sela as estrelas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sozinho ele estende os céus",
          "e anda sobre as costas do mar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ele fez a Ursa Maior, o Órion,",
          "o Sete-estrelo",
          "e as constelações do Sul."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Deus faz coisas grandes",
          "e insondáveis,",
          "e maravilhas",
          "que não se podem enumerar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eis que ele passa por mim,",
          "e não o vejo;",
          "segue diante de mim,",
          "e não o percebo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eis que arrebata a presa!",
          "Quem o pode impedir?",
          "Quem lhe dirá:",
          "‘O que estás fazendo?’"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Deus não revogará",
          "a sua própria ira;",
          "debaixo dele se curvam",
          "os ajudantes",
          "do monstro Raabe.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Sou justo e íntegro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Como então poderei",
          "eu responder a ele?",
          "Como escolher as minhas palavras,",
          "para argumentar com ele?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ainda que eu fosse justo,",
          "não lhe responderia;",
          "pelo contrário, pediria misericórdia",
          "ao meu Juiz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ainda que eu o chamasse",
          "e ele me respondesse,",
          "nem por isso eu creria",
          "que ele deu ouvidos",
          "à minha voz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Porque me esmaga",
          "com uma tempestade",
          "e sem motivo multiplica",
          "as minhas feridas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Não me permite respirar,",
          "porque me enche de amargura."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Se é uma questão de força,",
          "ele é o forte;",
          "se é uma questão de justiça, ele dirá:",
          "‘Quem pode me intimar?’"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Ainda que eu seja justo,",
          "a minha boca me condenará;",
          "embora eu seja íntegro,",
          "ela me declarará culpado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Eu sou íntegro,",
          "mas não me importo comigo,",
          "não faço caso da minha vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Para mim, é tudo a mesma coisa;",
          "por isso, digo:",
          "ele destrói tanto os íntegros",
          "como os perversos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Se um flagelo mata de repente,",
          "ele rirá do desespero",
          "dos inocentes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "A terra está entregue",
          "nas mãos dos ímpios,",
          "e Deus ainda cobre o rosto",
          "dos juízes.",
          "Se ele não é o causador disso,",
          "quem seria?”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus não me considerará inocente"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "“Os meus dias são mais velozes",
          "do que um corredor;",
          "fogem sem ter visto a felicidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Passam como barcos de junco,",
          "como a águia que se lança",
          "sobre a presa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Se eu disser: ‘Vou esquecer",
          "a minha queixa,",
          "deixarei o meu ar triste",
          "e ficarei contente’;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "ainda assim",
          "todas as minhas dores",
          "me apavoram,",
          "porque bem sei que",
          "não me considerarás inocente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Eu serei condenado;",
          "por que, pois, trabalho em vão?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Ainda que me lave",
          "com água de neve",
          "e purifique as minhas mãos",
          "com sabão,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "mesmo assim me submergirás",
          "no lodo,",
          "e as minhas próprias roupas",
          "terão nojo de mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Porque ele não é ser humano,",
          "como eu,",
          "a quem eu responda,",
          "se formos juntos ao tribunal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Não há entre nós árbitro",
          "que ponha a mão sobre nós dois."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Que ele tire a sua vara",
          "de cima de mim,",
          "e que o seu terror",
          "não me amedronte!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Então falarei sem o temer;",
          "do contrário,",
          "eu não estaria em mim.”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
