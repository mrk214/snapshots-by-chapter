    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A justiça de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantem ao Senhor",
          "um cântico novo,",
          "porque ele tem feito maravilhas;",
          "a sua mão direita",
          "e o seu braço santo",
          "lhe alcançaram a vitória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O Senhor fez notória",
          "a sua salvação;",
          "manifestou a sua justiça",
          "diante dos olhos das nações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Lembrou-se da sua misericórdia",
          "e da sua fidelidade",
          "para com a casa de Israel;",
          "todos os confins da terra viram",
          "a salvação do nosso Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Celebrem com júbilo ao Senhor,",
          "todos os moradores da terra;",
          "gritem de alegria,",
          "exultem e cantem louvores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Cantem com harpa",
          "louvores ao Senhor,",
          "com harpa e voz de canto;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "com trombetas",
          "e ao som de buzinas,",
          "exultem diante do Senhor,",
          "que é rei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ruja o mar e a sua plenitude,",
          "o mundo e os que nele habitam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os rios batam palmas,",
          "e juntos cantem de júbilo",
          "os montes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "na presença do Senhor,",
          "porque ele vem julgar a terra;",
          "julgará o mundo com justiça",
          "e os povos, com retidão."
        ],
        "rlw_lines": []
      }
    ]
  },
