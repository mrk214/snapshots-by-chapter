    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A felicidade de quem teme a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Bem-aventurado é aquele",
          "que teme o Senhor",
          "e tem grande prazer",
          "nos seus mandamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "A sua descendência",
          "será poderosa na terra;",
          "a geração dos justos",
          "será abençoada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Na sua casa há prosperidade",
          "e riqueza,",
          "e a sua justiça permanece",
          "para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Aos justos, nasce luz nas trevas;",
          "ele é bondoso, compassivo e justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Feliz aquele que se compadece",
          "e empresta;",
          "ele defenderá a sua causa em juízo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "não será jamais abalado;",
          "será tido em memória eterna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Não se atemoriza de más notícias;",
          "o seu coração é firme,",
          "confiante no Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O seu coração, bem firmado,",
          "não teme,",
          "até que veja a derrota",
          "dos seus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Distribui, dá aos pobres;",
          "a sua justiça permanece",
          "para sempre,",
          "e o seu poder se exaltará",
          "em glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O ímpio vê isso e fica com raiva;",
          "range os dentes e se consome.",
          "O desejo dos ímpios perecerá."
        ],
        "rlw_lines": []
      }
    ]
  },
