    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segunda fala de Bildade"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "A terra será abandonada por sua causa?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Bildade, o suíta, tomou a palavra e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Até quando você andará",
          "à caça de palavras?",
          "Considere bem,",
          "e então falaremos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Por que somos considerados",
          "como animais",
          "e passamos por tolos",
          "aos seus olhos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Você, que se despedaça",
          "em sua ira,",
          "pensa que a terra será abandonada",
          "por sua causa?",
          "Você pensa que as rochas",
          "devem ser tiradas",
          "do seu lugar?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "O fim do ímpio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Na verdade, a luz do ímpio",
          "se apagará,",
          "e a chama do seu fogo",
          "não resplandecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A luz se escurecerá na sua tenda,",
          "e a sua lâmpada sobre ele",
          "se apagará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os seus passos vigorosos",
          "se estreitarão,",
          "e a sua própria trama o derrubará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Porque por seus próprios pés",
          "é lançado na rede",
          "e andará sobre as suas malhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A armadilha o apanhará",
          "pelo calcanhar,",
          "e o laço o prenderá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A corda está escondida na terra",
          "para apanhá-lo,",
          "a armadilha se encontra",
          "no seu caminho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Terrores o amedrontam",
          "de todos os lados",
          "e o perseguem a cada passo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A calamidade virá faminta",
          "sobre ele,",
          "e a miséria estará alerta",
          "ao seu lado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ela devorará os membros",
          "do seu corpo;",
          "serão devorados",
          "pelo primogênito da morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O ímpio será arrancado",
          "da segurança de sua tenda,",
          "e será levado ao rei dos terrores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Nenhum dos seus irá morar",
          "na sua tenda;",
          "enxofre será espalhado",
          "sobre a sua habitação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por baixo secarão as suas raízes,",
          "e por cima murcharão",
          "os seus ramos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A sua memória desaparecerá",
          "da terra,",
          "e pelas praças não terá nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Da luz o lançarão nas trevas",
          "e o afugentarão do mundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Não terá filho nem posteridade",
          "entre o seu povo,",
          "nem sobrevivente algum ficará",
          "nas suas moradas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Do seu dia se espantarão",
          "os do Ocidente,",
          "e os do Oriente serão tomados",
          "de horror."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Tais são, na verdade,",
          "as moradas do ímpio,",
          "e este é o paradeiro",
          "daquele que não conhece Deus.”"
        ],
        "rlw_lines": []
      }
    ]
  },
