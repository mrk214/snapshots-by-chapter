    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ah! Se fendesses os céus",
          "e descesses!",
          "Se os montes tremessem",
          "na tua presença,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "como quando o fogo",
          "acende os gravetos,",
          "como quando faz ferver a água,",
          "para fazeres notório o teu nome",
          "aos teus adversários,",
          "e para que as nações",
          "tremam diante de ti!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quando fizeste coisas terríveis,",
          "que nós nem esperávamos,",
          "desceste, e os montes",
          "tremeram diante de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque desde a antiguidade",
          "não se ouviu,",
          "nem com os ouvidos se percebeu,",
          "nem com os olhos se viu Deus",
          "além de ti,",
          "que trabalha para aquele",
          "que nele espera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu sais ao encontro daquele",
          "que com alegria pratica a justiça,",
          "daqueles que se lembram de ti",
          "nos teus caminhos.",
          "Eis que te iraste, porque pecamos.",
          "Por muito tempo temos pecado;",
          "como, então, seremos salvos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Todos nós somos",
          "como o impuro,",
          "e todas as nossas justiças são",
          "como trapo manchado de sangue.",
          "Todos nós murchamos",
          "como a folha;",
          "e as nossas iniquidades",
          "nos arrastam como um vento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Não há ninguém",
          "que invoque o teu nome,",
          "que se disponha a apegar-se a ti.",
          "Porque escondes de nós",
          "o teu rosto",
          "e nos consomes por causa",
          "das nossas iniquidades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas agora, Senhor,",
          "tu és o nosso Pai.",
          "Nós somos o barro,",
          "e tu és o nosso oleiro;",
          "e todos nós somos",
          "obra das tuas mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não te enfureças tanto, ó Senhor,",
          "nem te lembres para sempre",
          "da nossa iniquidade.",
          "Olha para nós, por favor,",
          "pois todos nós somos o teu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "As tuas santas cidades",
          "estão desertas.",
          "Sião virou um deserto;",
          "Jerusalém está arrasada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O nosso templo santo e glorioso,",
          "em que nossos pais te louvavam,",
          "foi queimado;",
          "todas as nossas coisas preciosas",
          "se tornaram em ruínas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Diante de tais calamidades,",
          "como podes te conter, ó Senhor?",
          "Ficarias calado e nos afligirias",
          "ainda mais?"
        ],
        "rlw_lines": []
      }
    ]
  },
