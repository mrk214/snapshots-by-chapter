    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“O meu espírito",
          "vai se consumindo,",
          "os meus dias",
          "vão se apagando,",
          "e só tenho diante de mim",
          "a sepultura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Estou cercado de zombadores,",
          "e os meus olhos são obrigados",
          "a contemplar",
          "as suas provocações.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Sou aquele em cujo rosto se cospe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“Dá-me, ó Deus, um penhor,",
          "e sê o meu fiador diante de ti;",
          "quem mais haverá que possa",
          "se comprometer comigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Fechaste o coração deles",
          "para o entendimento,",
          "e por isso não os exaltarás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Se alguém entrega",
          "os seus amigos como presa,",
          "os olhos de seus filhos",
          "desfalecerão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mas ele me pôs",
          "por provérbio dos povos;",
          "tornei-me como aquele",
          "em cujo rosto se cospe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os meus olhos se escureceram",
          "de mágoa,",
          "e todos os meus membros",
          "são como a sombra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os retos ficam admirados",
          "com isto,",
          "e os inocentes se levantam",
          "contra os ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O justo segue o seu caminho,",
          "e o puro de mãos se torna",
          "cada vez mais forte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mas voltem, todos vocês,",
          "e venham cá;",
          "porque não acharei nenhum sábio",
          "entre vocês.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Onde está a minha esperança?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Os meus dias passaram,",
          "e fracassaram os meus planos,",
          "os desejos do meu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Transformam a noite em dia,",
          "e dizem: ‘A luz está perto",
          "das trevas.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mas, se eu aguardo a sepultura",
          "por minha casa;",
          "se faço a minha cama nas trevas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "se digo à cova:",
          "‘Você é o meu pai’,",
          "e aos vermes: ‘Vocês são",
          "a minha mãe e a minha irmã’,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "onde está, então,",
          "a minha esperança?",
          "Sim, a minha esperança,",
          "quem a poderá ver?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ela descerá até as portas",
          "do mundo dos mortos,",
          "quando juntos descansarmos",
          "no pó.”"
        ],
        "rlw_lines": []
      }
    ]
  },
