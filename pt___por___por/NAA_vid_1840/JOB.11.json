    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Primeira fala de Zofar"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Por acaso, tem razão o falador?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Zofar, o naamatita, tomou a palavra e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Será que todas essas palavras",
          "ficarão sem resposta?",
          "Por acaso, tem razão o falador?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Você pensa, Jó,",
          "que o seu palavreado",
          "fará calar os homens?",
          "E, quando você zomba, pensa que",
          "não haverá ninguém",
          "que o envergonhe?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pois você diz:",
          "‘A minha doutrina é pura,",
          "e sou limpo aos olhos de Deus.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Mas quem dera que Deus falasse",
          "e abrisse os seus lábios",
          "contra você,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "e lhe revelasse os segredos",
          "da sabedoria,",
          "pois a verdadeira sabedoria",
          "é multiforme!",
          "Saiba, portanto, que Deus permite",
          "que seja esquecida",
          "parte da sua iniquidade.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Você pode desvendar os mistérios de Deus?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Será que você pode desvendar",
          "os mistérios de Deus",
          "ou descobrir a perfeição",
          "do Todo-Poderoso?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A sabedoria de Deus",
          "é mais elevada do que os céus;",
          "o que você poderá fazer?",
          "Ela é mais profunda",
          "do que o abismo;",
          "o que você poderá saber?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A sua medida é mais longa",
          "do que a terra",
          "e mais larga do que o mar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Se ele passa, prende alguém",
          "e chama a juízo,",
          "quem o poderá impedir?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Deus conhece os homens falsos",
          "e, sem esforço, vê a iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mas os tolos",
          "se tornarão sábios",
          "quando a cria de uma jumenta",
          "selvagem nascer homem.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Lance para longe a iniquidade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Se você dispuser o coração",
          "e estender as mãos para Deus;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "se lançar para longe",
          "a iniquidade de suas mãos",
          "e não permitir que a injustiça",
          "habite na sua tenda,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "então você levantará o seu rosto",
          "sem mácula,",
          "estará seguro e não temerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pois você esquecerá",
          "os seus sofrimentos",
          "e só lembrará deles",
          "como de águas passadas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A sua vida será mais clara",
          "que o meio-dia;",
          "ainda que haja trevas,",
          "serão como a manhã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Você se sentirá seguro,",
          "porque haverá esperança;",
          "olhará ao redor",
          "e dormirá tranquilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Você se deitará,",
          "e ninguém irá atemorizá-lo;",
          "e muitos procurarão obter",
          "o seu favor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Mas os olhos dos ímpios",
          "desfalecerão,",
          "sem que encontrem refúgio;",
          "a única esperança deles será morrer.”"
        ],
        "rlw_lines": []
      }
    ]
  },
