    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Doxologia final"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Louvem a Deus no seu santuário;",
          "louvem a Deus no firmamento,",
          "obra do seu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Louvem-no pelos seus",
          "poderosos feitos;",
          "louvem-no segundo",
          "a sua imensa grandeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Louvem-no ao som da trombeta;",
          "louvem-no com harpas e liras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Louvem-no com tamborins",
          "e danças;",
          "louvem-no com instrumentos",
          "de cordas e com flautas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Louvem-no",
          "com címbalos sonoros;",
          "louvem-no",
          "com címbalos retumbantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Todo ser que respira",
          "louve o Senhor.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
