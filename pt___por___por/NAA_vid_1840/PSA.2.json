    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O reinado do Ungido de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Por que se enfurecem as nações",
          "e os povos imaginam coisas vãs?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Os reis da terra se levantam,",
          "e as autoridades conspiram",
          "contra o Senhor e contra",
          "o seu Ungido, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“Vamos romper os seus laços",
          "e sacudir de nós as suas algemas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Aquele que habita nos céus",
          "dá risada;",
          "o Senhor zomba deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Na sua ira, a seu tempo,",
          "lhes falará",
          "e no seu furor os deixará",
          "apavorados, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Eu constituí o meu Rei",
          "sobre o meu santo monte Sião.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O rei diz: “Proclamarei",
          "o decreto do Senhor.",
          "Ele me disse: ‘Você é meu Filho,",
          "hoje eu gerei você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Peça, e eu lhe darei",
          "as nações por herança",
          "e as extremidades da terra",
          "por sua possessão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Com uma vara de ferro",
          "você as quebrará",
          "e as despedaçará",
          "como um vaso de oleiro.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Agora, pois, ó reis,",
          "sejam prudentes;",
          "deixem-se advertir,",
          "juízes da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Sirvam o Senhor com temor",
          "e alegrem-se nele com tremor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Beijem o Filho para que",
          "não se irrite,",
          "e não pereçam no caminho;",
          "porque em breve se acenderá",
          "a sua ira.",
          "Bem-aventurados todos",
          "os que nele se refugiam."
        ],
        "rlw_lines": []
      }
    ]
  },
