    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hino de gratidão a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo. Cântico para o dia de sábado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bom é render graças ao Senhor",
          "e cantar louvores ao teu nome,",
          "ó Altíssimo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "anunciar de manhã",
          "a tua misericórdia",
          "e, durante as noites,",
          "a tua fidelidade,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "com instrumentos de dez cordas,",
          "ao som da lira",
          "e com a solenidade da harpa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pois me alegraste, Senhor,",
          "com os teus feitos;",
          "exultarei nas obras das tuas mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Como são grandes, Senhor,",
          "as tuas obras!",
          "Os teus pensamentos,",
          "que profundos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O tolo não compreende,",
          "e o insensato não percebe isto:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "ainda que os ímpios",
          "brotem como a erva,",
          "e floresçam todos",
          "os que praticam a iniquidade,",
          "serão destruídos para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mas tu, Senhor,",
          "és o Altíssimo eternamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Eis que os teus inimigos, Senhor,",
          "eis que os teus inimigos perecerão;",
          "serão dispersos todos",
          "os que praticam a iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porém tu exaltas o meu poder",
          "como o do boi selvagem;",
          "derramas sobre mim o óleo fresco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Os meus olhos veem a derrota",
          "dos inimigos que me espreitam,",
          "e os meus ouvidos escutam",
          "os gritos dos malfeitores",
          "que contra mim se levantam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O justo florescerá",
          "como a palmeira,",
          "crescerá como o cedro no Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Plantados na Casa do Senhor,",
          "florescerão nos átrios",
          "do nosso Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Na velhice ainda darão frutos,",
          "serão cheios de seiva e de verdor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "para anunciar",
          "que o Senhor é reto.",
          "Ele é a minha rocha,",
          "e nele não há injustiça."
        ],
        "rlw_lines": []
      }
    ]
  },
