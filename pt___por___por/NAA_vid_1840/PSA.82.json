    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus, o juiz de todos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asafe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deus toma o seu lugar",
          "na congregação divina;",
          "no meio dos deuses, ele julga:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Até quando julgarão injustamente",
          "e tomarão partido",
          "pela causa dos ímpios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Defendam o direito dos fracos",
          "e dos órfãos,",
          "façam justiça aos aflitos",
          "e desamparados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Socorram os fracos",
          "e os necessitados,",
          "tirando-os das mãos dos ímpios.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Eles nada sabem,",
          "nem entendem;",
          "vagueiam em trevas;",
          "todos os fundamentos da terra",
          "vacilam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu disse: ‘Vocês são deuses;",
          "todos vocês são filhos do Altíssimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mas vocês morrerão",
          "como simples mortais,",
          "e, como qualquer dos príncipes,",
          "vocês sucumbirão.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Levanta-te, ó Deus,",
          "julga a terra,",
          "pois a ti pertencem",
          "todas as nações."
        ],
        "rlw_lines": []
      }
    ]
  },
