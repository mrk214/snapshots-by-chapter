    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Salvação para os gentios"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“Mantenham o direito",
          "e pratiquem a justiça,",
          "porque a minha salvação",
          "está prestes a vir,",
          "e a minha justiça",
          "está prestes a se manifestar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bem-aventurado quem faz isto,",
          "e aquele que nisto se firma,",
          "que se guarda",
          "de profanar o sábado",
          "e guarda a sua mão",
          "de cometer algum mal.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O estrangeiro que tiver se unido",
          "ao Senhor não deve dizer:",
          "“O Senhor certamente",
          "me excluirá do seu povo.”",
          "E um eunuco não deve dizer:",
          "“Eis que eu sou uma árvore seca.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque assim diz o Senhor:",
          "“Aos eunucos que guardam",
          "os meus sábados,",
          "escolhem aquilo que me agrada",
          "e abraçam a minha aliança,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "darei no meu templo",
          "e dentro das minhas muralhas",
          "um memorial e um nome melhor",
          "do que filhos e filhas;",
          "darei a cada um deles",
          "um nome eterno,",
          "que nunca se apagará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Aos estrangeiros",
          "que se aproximam do Senhor,",
          "para o servir e para amar",
          "o nome do Senhor,",
          "sendo deste modo servos dele,",
          "sim, todos os que guardam",
          "o sábado,",
          "não o profanando,",
          "e abraçam a minha aliança,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "também os levarei",
          "ao meu santo monte",
          "e lhes darei alegria",
          "na minha Casa de Oração.",
          "Os seus holocaustos",
          "e os seus sacrifícios",
          "serão aceitos no meu altar,",
          "porque a minha casa será chamada",
          "‘Casa de Oração’",
          "para todos os povos.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Assim diz o Senhor Deus,",
          "que congrega os dispersos",
          "de Israel:",
          "“Ainda congregarei outros",
          "aos que já se acham reunidos.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ai dos atalaias de Israel!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“Vocês, todos os animais",
          "do campo,",
          "todos os animais dos bosques,",
          "venham comer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os atalaias de Israel são cegos,",
          "nada sabem.",
          "Todos são cães mudos,",
          "não podem latir.",
          "São sonhadores preguiçosos,",
          "gostam de dormir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tais cães são gulosos,",
          "nunca se fartam.",
          "São pastores",
          "que nada compreendem;",
          "todos seguem o seu próprio",
          "caminho,",
          "cada um para a sua ganância,",
          "todos sem exceção."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eles dizem: ‘Venham!",
          "Vou trazer o vinho!",
          "Vamos nos encharcar",
          "de bebida forte!",
          "O dia de amanhã será como este",
          "e ainda maior e mais famoso.’”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
