    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus é forte refúgio"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No Senhor me refugio.",
          "Como então vocês dizem",
          "à minha alma:",
          "“Fuja como um pássaro",
          "para o seu monte”?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque eis aí os ímpios,",
          "armando os seus arcos;",
          "colocam a flecha na corda,",
          "para, às escondidas, dispararem",
          "contra os retos de coração."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ora, se forem destruídos",
          "os fundamentos,",
          "que poderá fazer o justo?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O Senhor está",
          "no seu santo templo;",
          "nos céus o Senhor tem",
          "o seu trono;",
          "os seus olhos estão atentos,",
          "as suas pálpebras sondam",
          "os filhos dos homens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor põe à prova",
          "o justo e o ímpio;",
          "mas ele abomina",
          "o que ama a violência."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Fará chover sobre os perversos",
          "brasas de fogo e enxofre,",
          "e vento abrasador será a parte",
          "do cálice deles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Por ser justo,",
          "o Senhor ama a justiça;",
          "os retos lhe contemplarão a face."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
