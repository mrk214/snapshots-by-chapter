    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Para onde foi o seu amado,",
          "ó mais bela das mulheres?",
          "Que rumo tomou o seu amado,",
          "para que a ajudemos",
          "a encontrá-lo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O meu amado desceu",
          "ao seu jardim,",
          "aos canteiros de bálsamo,",
          "para pastorear nos jardins",
          "e para colher os lírios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Eu sou do meu amado,",
          "e o meu amado é meu;",
          "ele apascenta o seu rebanho",
          "entre os lírios."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Quinto cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Minha querida,",
          "você é bonita como Tirza,",
          "encantadora como Jerusalém,",
          "impressionante como",
          "um exército com bandeiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Desvie de mim os seus olhos,",
          "porque eles me perturbam.",
          "Os seus cabelos são como",
          "um rebanho de cabras",
          "que descem ondeantes",
          "de Gileade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os seus dentes são como",
          "um rebanho de ovelhas",
          "que sobem do lavadouro;",
          "cada uma tem o seu par,",
          "e nenhuma está faltando."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "As suas faces, como romã partida,",
          "brilham através do véu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sessenta são as rainhas,",
          "oitenta, as concubinas,",
          "e as virgens, sem número;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "mas uma só é a minha pombinha",
          "sem defeito,",
          "a mais querida da sua mãe,",
          "a predileta daquela",
          "que a deu à luz.",
          "As outras mulheres a veem",
          "e dizem que ela é feliz;",
          "as rainhas e as concubinas",
          "a louvam."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quem é esta que aparece",
          "como a alva do dia,",
          "bonita como a lua,",
          "pura como o sol,",
          "impressionante como um exército",
          "com bandeiras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Desci ao jardim das nogueiras,",
          "para ver os renovos do vale,",
          "para ver se brotavam as videiras,",
          "se as romãzeiras estavam em flor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Não sei como,",
          "imaginei-me no carro",
          "do meu nobre povo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Volte, volte, sulamita!",
          "Volte, volte, para que nós",
          "a contemplemos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Por que vocês querem",
          "contemplar a sulamita",
          "na dança de Maanaim?"
        ],
        "rlw_lines": []
      }
    ]
  },
