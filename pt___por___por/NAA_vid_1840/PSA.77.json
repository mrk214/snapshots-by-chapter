],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["De noite indago o meu íntimo,","e o meu espírito pergunta:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["“Será que o Senhor nos rejeitará","para sempre?","Acaso, não voltará a ser propício?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Cessou perpetuamente","a sua graça?","Caducou a sua promessa","para todas as gerações?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Será que Deus se esqueceu","de ser bondoso?","Ou será que encerrou","as suas misericórdias","na sua ira?”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Então eu disse:","“Esta é a minha aflição:","o poder do Altíssimo","não é mais o mesmo.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Recordarei os feitos do Senhor;","certamente me lembrarei","das tuas maravilhas","da antiguidade."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Meditarei em todas as tuas obras","e pensarei em todos","os teus feitos poderosos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["O teu caminho, ó Deus,","é de santidade.","Que deus é tão grande","como o nosso Deus?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Tu és o Deus","que operas maravilhas","e, entre os povos,","tens feito notório o teu poder."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Com o teu braço","remiste o teu povo,","os filhos de Jacó e de José."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["As águas te viram, ó Deus,","as águas te viram e temeram;","até os abismos se abalaram."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Grossas nuvens","se desfizeram em água;","houve trovões nos espaços;","também as tuas setas cruzaram","de uma parte para outra."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["O estrondo do teu trovão","ecoou na redondeza;","os relâmpagos","iluminaram o mundo;","a terra se abalou e tremeu."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["O teu caminho foi pelo mar;","as tuas veredas passaram","pelas grandes águas,","mas ninguém encontrou","as tuas pegadas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["O teu povo, tu o conduziste,","como rebanho,","pelas mãos de Moisés e de Arão."],"rlw_lines":[]}]}}