        "lines": [
          "Humildade e confiança em Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de peregrinação. De Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, não é orgulhoso",
          "o meu coração,",
          "nem arrogante o meu olhar.",
          "Não ando à procura",
          "de coisas grandes,",
          "nem de coisas maravilhosas",
          "demais para mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pelo contrário, fiz calar",
          "e sossegar a minha alma.",
          "Como a criança desmamada",
          "se aquieta nos braços",
          "de sua mãe,",
          "assim é a minha alma",
          "dentro de mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Espere, ó Israel, no Senhor,",
          "desde agora e para sempre."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
