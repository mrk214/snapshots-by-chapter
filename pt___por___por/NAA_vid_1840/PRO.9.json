    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O banquete da Sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A Sabedoria construiu a sua casa,",
          "esculpiu para si sete colunas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Matou os seus animais",
          "para a festa",
          "e preparou o seu vinho;",
          "também já arrumou a sua mesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enviou as suas criadas para que,",
          "dos lugares mais altos",
          "da cidade, façam este convite:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Quem é ingênuo,",
          "venha para cá.”",
          "Aos que não têm juízo ela diz:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Venham, comam do meu pão",
          "e bebam do vinho que preparei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Afastem-se dos ingênuos e vivam;",
          "andem pelo caminho",
          "do entendimento.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quem repreende o zombador",
          "traz afronta sobre si;",
          "e quem censura o ímpio",
          "será insultado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Não repreenda o zombador,",
          "para que ele não odeie você;",
          "repreenda o sábio, e ele o amará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dê instrução ao sábio,",
          "e ele se tornará",
          "mais sábio ainda;",
          "ensine o justo,",
          "e ele crescerá na prudência."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O temor do Senhor é",
          "o princípio da sabedoria;",
          "conhecer o Santo",
          "é ter entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque por mim se multiplicarão",
          "os seus dias,",
          "e aumentarão os anos de sua vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Se você é sábio,",
          "é sábio para si mesmo;",
          "se é zombador, só você",
          "sofrerá as consequências."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O convite da loucura"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "A loucura",
          "é mulher espalhafatosa;",
          "é tola e não sabe coisa alguma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Senta-se junto",
          "à porta de sua casa,",
          "toma uma cadeira",
          "no lugar mais alto da cidade,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "para dizer aos que passam",
          "e seguem direito o seu caminho:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "“Quem for ingênuo,",
          "venha para cá.”",
          "E aos que não têm juízo ela diz:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“A água roubada é doce,",
          "e o pão comido às escondidas",
          "é saboroso.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Eles, porém, não sabem que ali",
          "estão os mortos,",
          "que os seus convidados estão",
          "nas profundezas do inferno."
        ],
        "rlw_lines": []
      }
    ]
  },
