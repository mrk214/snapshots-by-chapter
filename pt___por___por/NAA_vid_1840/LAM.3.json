  "book": {
    "book_usfm": "LAM",
    "name": "Lamentações"
  },
  "chapter": {
    "chapter_usfm": "LAM.3",
    "current": {
      "usfm": "LAM.3",
      "human": "Lamentações 3"
    },
    "previous": {
      "usfm": "LAM.2",
