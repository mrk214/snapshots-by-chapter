    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Castigo, arrependimento e esperança"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu sou o homem",
          "que viu a aflição",
          "causada pela vara",
          "do furor de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele me levou e me fez andar",
          "nas trevas e não na luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Certamente ele voltou",
          "a sua mão contra mim,",
          "sem parar, todo o dia.",
          "Bete —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Fez envelhecer",
          "a minha carne",
          "e a minha pele,",
          "e despedaçou os meus ossos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Construiu rampas de ataque",
          "contra mim",
          "e me cercou de amargura e dor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ele me faz habitar na escuridão,",
          "como aqueles que morreram",
          "há muito tempo.",
          "Guímel —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cercou-me de um muro,",
          "e já não posso sair;",
          "prendeu-me",
          "com pesadas correntes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Mesmo quando clamo e grito,",
          "ele fecha os ouvidos",
          "à minha oração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Fechou os meus caminhos",
          "com blocos de pedra,",
          "fez tortuosas as minhas veredas.",
          "Dálete —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Foi para mim como",
          "um urso à espreita,",
          "como um leão pronto para atacar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Desviou os meus caminhos",
          "e me fez em pedaços;",
          "depois me abandonou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Entesou o seu arco",
          "e me pôs como alvo",
          "de suas flechas.",
          "Hê —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "As flechas da sua aljava",
          "atingiram o meu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Fui feito motivo de riso",
          "para todo o meu povo,",
          "e a sua canção de deboche",
          "o dia inteiro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Fartou-me de amarguras,",
          "e me saciou de absinto.",
          "Vau —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Quebrou os meus dentes",
          "nas pedras,",
          "e cobriu-me de cinza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Já não sei o que é ter paz",
          "e esqueci o que é",
          "desfrutar do bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Então eu disse:",
          "“Não tenho mais forças.",
          "A minha esperança",
          "no Senhor acabou.”",
          "Zaine —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Lembra-te",
          "da minha aflição",
          "e do meu andar errante,",
          "do absinto e da amargura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Minha alma continuamente",
          "se lembra disso",
          "e se abate dentro de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Quero trazer à memória",
          "o que pode me dar esperança.",
          "Hete —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "As misericórdias",
          "do Senhor são a causa",
          "de não sermos",
          "consumidos,",
          "porque as suas misericórdias",
          "não têm fim;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "renovam-se cada manhã.",
          "Grande é a tua fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "“A minha porção é o Senhor”,",
          "diz a minha alma;",
          "“portanto, esperarei nele.”",
          "Tete —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "O Senhor é bom",
          "para os que esperam nele,",
          "para aqueles que o buscam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Bom é aguardar",
          "a salvação do Senhor,",
          "e isso, em silêncio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Bom é para o homem",
          "suportar o jugo na sua mocidade.",
          "Iode —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Que ele se assente solitário",
          "e fique em silêncio,",
          "porque esse jugo",
          "Deus pôs sobre ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Ponha a sua boca no pó;",
          "talvez ainda haja esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Dê a face ao que o fere",
          "e suporte todas as afrontas.",
          "Cafe —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "O Senhor não rejeitará",
          "para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Ainda que entristeça alguém,",
          "terá compaixão",
          "segundo a grandeza",
          "das suas misericórdias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Porque não aflige",
          "nem entristece de bom grado",
          "os filhos dos homens.",
          "Lâmede —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Pisar debaixo dos pés",
          "todos os prisioneiros da terra,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "perverter o direito do homem",
          "diante do Altíssimo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "subverter a justiça num processo",
          "— será que o Senhor",
          "não veria tais coisas?",
          "Mem —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Quem é aquele que diz,",
          "e assim acontece,",
          "sem que o Senhor",
          "o tenha ordenado?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Por acaso, não é",
          "da boca do Altíssimo",
          "que procedem",
          "tanto o mal como o bem?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Por que se queixa o homem?",
          "Queixe-se cada um",
          "dos seus próprios pecados.",
          "Num —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Examinemos bem",
          "os nossos caminhos",
          "e voltemos para o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Levantemos o coração,",
          "juntamente com as mãos,",
          "para Deus nos céus, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "“Nós pecamos",
          "e fomos rebeldes,",
          "e tu não nos perdoaste.”",
          "Sâmeque —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "“Cobriste-nos de ira",
          "e nos perseguiste;",
          "nos mataste sem dó",
          "nem piedade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "De nuvens te encobriste",
          "para que a nossa oração",
          "não passe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Como lixo e refugo nos puseste",
          "no meio dos povos.”",
          "Pê —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "“Todos os nossos inimigos",
          "abriram a boca contra nós."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Sobre nós vieram",
          "o temor e a cova,",
          "a desolação e a ruína.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Dos meus olhos",
          "correm rios de lágrimas,",
          "por causa da destruição",
          "da filha do meu povo.",
          "Aim —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Os meus olhos choram,",
          "não cessam, e não há descanso,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "até que o Senhor atenda",
          "e veja lá do céu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "O que vejo entristece",
          "a minha alma:",
          "o sofrimento de todas",
          "as filhas da minha cidade.",
          "Tsadê —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Aqueles que sem motivo",
          "são meus inimigos",
          "caçaram-me",
          "como se eu fosse uma ave."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Lançaram-me vivo numa cova",
          "e atiraram pedras sobre mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Águas correram",
          "sobre a minha cabeça;",
          "então eu disse: “Estou perdido!”",
          "Cofe —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Da mais profunda cova, Senhor,",
          "invoquei o teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Ouviste a minha voz,",
          "quando pedi:",
          "“Não feches os teus ouvidos",
          "aos meus lamentos,",
          "ao meu clamor.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "No dia em que te invoquei,",
          "chegaste perto de mim",
          "e disseste: “Não tenha medo.”",
          "Rexe —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Defendeste a minha causa,",
          "Senhor;",
          "remiste a minha vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Viste, Senhor, a injustiça",
          "que me fizeram;",
          "julga a minha causa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Viste toda a sua vingança,",
          "todos os seus planos contra mim.",
          "Chim —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Ouviste as suas afrontas,",
          "Senhor,",
          "todos os seus planos contra mim,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "as acusações que me fazem",
          "e o que murmuram contra mim,",
          "o dia todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Observa-os quando se assentam",
          "e quando se levantam;",
          "eu sou motivo de zombaria",
          "para eles.",
          "Tau —"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Tu, Senhor, lhes retribuirás",
          "segundo a obra das mãos deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Tu lhes darás dureza de coração,",
          "que é a tua maldição sobre eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Na tua ira, os perseguirás,",
          "e eles serão eliminados",
          "de debaixo dos céus do Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
