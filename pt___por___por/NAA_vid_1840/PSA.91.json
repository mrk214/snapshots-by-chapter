    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sob a sombra do Altíssimo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aquele que habita",
          "no esconderijo do Altíssimo",
          "e descansa à sombra do Onipotente"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "diz ao Senhor:",
          "“Tu és o meu refúgio",
          "e a minha fortaleza,",
          "o meu Deus, em quem confio.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois ele livrará você",
          "do laço do passarinheiro",
          "e da peste perniciosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ele o cobrirá com as suas penas,",
          "e, sob as suas asas,",
          "você estará seguro;",
          "a sua verdade é proteção e escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Você não terá medo",
          "do terror noturno,",
          "nem da flecha que voa de dia,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "nem da peste",
          "que se propaga nas trevas,",
          "nem da mortandade",
          "que assola ao meio-dia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Caiam mil ao seu lado,",
          "e dez mil, à sua direita;",
          "você não será atingido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Somente com os seus olhos",
          "você contemplará",
          "e verá o castigo dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Você disse:",
          "“O Senhor é o meu refúgio.”",
          "Você fez do Altíssimo a sua morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Nenhum mal lhe sucederá,",
          "praga nenhuma chegará",
          "à sua tenda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque aos seus anjos",
          "ele dará ordens a seu respeito,",
          "para que guardem você",
          "em todos os seus caminhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eles o sustentarão",
          "nas suas mãos,",
          "para que você não tropece",
          "em alguma pedra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Você pisará o leão e a cobra;",
          "com os pés esmagará o leãozinho",
          "e a serpente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Deus diz: “Porque a mim",
          "se apegou com amor,",
          "eu o livrarei;",
          "eu o protegerei,",
          "porque conhece o meu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ele me invocará,",
          "e eu lhe responderei;",
          "na sua angústia eu estarei com ele;",
          "eu o livrarei e o glorificarei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Vou saciá-lo com longevidade",
          "e lhe mostrarei a minha salvação.”"
        ],
        "rlw_lines": []
      }
    ]
  },
