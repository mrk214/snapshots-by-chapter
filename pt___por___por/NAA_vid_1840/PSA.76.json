    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A majestade e o poder de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, com instrumentos de cordas. Salmo de Asafe. Cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deus é conhecido em Judá;",
          "grande é o seu nome em Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Em Salém está o seu tabernáculo,",
          "e, em Sião, a sua morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ali, despedaçou ele as flechas,",
          "o escudo, a espada e a batalha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tu és ilustre e mais glorioso",
          "do que os montes eternos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os corajosos foram despojados;",
          "jazem a dormir o seu sono,",
          "e nenhum dos valentes",
          "pode valer-se das próprias mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ante a tua repreensão,",
          "ó Deus de Jacó,",
          "carros de guerra e cavalos",
          "foram lançados",
          "num sono profundo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tu, sim, tu és terrível;",
          "se estás irado,",
          "quem pode permanecer",
          "na tua presença?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Desde os céus fizeste ouvir",
          "o teu juízo;",
          "a terra tremeu e se aquietou,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "quando Deus se levantou",
          "para julgar",
          "e salvar todos os humildes da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois até a ira humana",
          "há de louvar-te;",
          "e da ira restante te cingirás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Façam votos ao Senhor, seu Deus,",
          "e tratem de cumpri-los;",
          "todos os que o rodeiam",
          "tragam presentes",
          "àquele que deve ser temido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ele acaba com",
          "o orgulho dos príncipes;",
          "ele é tremendo",
          "para os reis da terra."
        ],
        "rlw_lines": []
      }
    ]
  },
