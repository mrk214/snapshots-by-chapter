    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus onisciente e onipotente"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, tu me sondas",
          "e me conheces."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sabes quando me sento",
          "e quando me levanto;",
          "de longe conheces",
          "os meus pensamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Observas o meu andar",
          "e o meu deitar",
          "e conheces",
          "todos os meus caminhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A palavra ainda nem chegou",
          "à minha língua,",
          "e tu, Senhor, já a conheces toda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu me cercas por todos os lados",
          "e pões a tua mão sobre mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tal conhecimento é maravilhoso",
          "demais para mim:",
          "é tão elevado,",
          "que não o posso atingir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Para onde me ausentarei",
          "do teu Espírito?",
          "Para onde fugirei da tua face?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Se subo aos céus, lá estás;",
          "se faço a minha cama",
          "no mais profundo abismo,",
          "lá estás também;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "se tomo as asas da alvorada",
          "e me detenho",
          "nos confins dos mares,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "ainda ali a tua mão",
          "me guiará,",
          "e a tua mão direita me susterá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Se eu digo: “As trevas,",
          "com certeza, me encobrirão,",
          "e a luz ao redor de mim",
          "se fará noite”,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "até as próprias trevas",
          "não te serão escuras,",
          "e a noite é tão clara como o dia.",
          "Para ti, as trevas e a luz",
          "são a mesma coisa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pois tu formaste o meu interior,",
          "tu me teceste",
          "no ventre de minha mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Graças te dou, visto que de modo",
          "assombrosamente maravilhoso",
          "me formaste;",
          "as tuas obras são admiráveis,",
          "e a minha alma o sabe muito bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os meus ossos",
          "não te foram encobertos,",
          "quando no oculto",
          "fui formado e entretecido",
          "como nas profundezas da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Os teus olhos viram",
          "a minha substância",
          "ainda informe,",
          "e no teu livro foram escritos",
          "todos os meus dias,",
          "cada um deles escrito",
          "e determinado,",
          "quando nem um deles ainda existia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Que preciosos para mim, ó Deus,",
          "são os teus pensamentos!",
          "E como é grande a soma deles!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Se os contasse, seriam mais",
          "do que os grãos de areia;",
          "quando acordo,",
          "ainda estou contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Como eu gostaria, ó Deus,",
          "que acabasses",
          "com os perversos;",
          "afastem-se, pois, de mim,",
          "homens violentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Eles se rebelam contra ti",
          "e como teus inimigos",
          "falam coisas ruins."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Acaso não odeio",
          "os que te odeiam, Senhor?",
          "E não desprezo",
          "os que se levantam contra ti?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Eu os detesto",
          "com ódio completo;",
          "para mim são inimigos de fato."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Sonda-me, ó Deus,",
          "e conhece o meu coração,",
          "prova-me e conhece",
          "os meus pensamentos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "vê se há em mim",
          "algum caminho mau",
          "e guia-me pelo caminho eterno."
        ],
        "rlw_lines": []
      }
    ]
  },
