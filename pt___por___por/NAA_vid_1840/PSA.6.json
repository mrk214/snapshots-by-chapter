    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração em tempo de angústia"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, com instrumentos de oito cordas. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, não me repreendas",
          "na tua ira,",
          "nem me castigues no teu furor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tem compaixão de mim, Senhor,",
          "porque eu me sinto debilitado;",
          "sara-me, Senhor, porque",
          "os meus ossos estão abalados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Também a minha alma está",
          "profundamente perturbada;",
          "mas tu, Senhor, até quando?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Volta-te, Senhor, e socorre-me;",
          "salva-me por tua graça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois, na morte,",
          "não há recordação de ti;",
          "no sepulcro, quem te dará louvor?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Estou cansado de tanto gemer;",
          "todas as noites faço nadar",
          "o meu leito,",
          "de minhas lágrimas o alago."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "De tristeza os meus olhos",
          "se consomem,",
          "envelhecem por causa de",
          "todos os meus adversários."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Afastem-se de mim, todos vocês",
          "que praticam a iniquidade,",
          "porque o Senhor ouviu",
          "a voz do meu lamento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "o Senhor ouviu a minha súplica;",
          "o Senhor acolhe a minha oração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Sejam envergonhados e fiquem",
          "extremamente perturbados",
          "todos os meus inimigos;",
          "retirem-se, num instante,",
          "cobertos de vergonha."
        ],
        "rlw_lines": []
      }
    ]
  },
