    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração de um homem perseguido"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus do meu louvor,",
          "não te cales!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pois contra mim se abriram",
          "lábios maldosos e fraudulentos;",
          "com língua mentirosa",
          "falam contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cercam-me com palavras odiosas",
          "e me atacam sem motivo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Em paga do meu amor,",
          "me hostilizam;",
          "eu, porém, oro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pagaram-me o bem com o mal;",
          "o amor, com ódio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Suscita contra ele um ímpio,",
          "e que à sua direita",
          "esteja um acusador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quando o julgarem,",
          "que ele seja condenado;",
          "e que a oração dele",
          "seja tida como pecado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sejam poucos os seus dias,",
          "e outro tome o seu encargo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Fiquem órfãos os seus filhos,",
          "e viúva, a sua esposa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Andem errantes os seus filhos",
          "e mendiguem;",
          "e sejam expulsos",
          "das ruínas de suas casas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Que um credor se aposse de tudo",
          "o que ele tem;",
          "que estranhos saqueiem",
          "o fruto do seu trabalho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ninguém tenha",
          "misericórdia dele,",
          "nem haja quem se compadeça",
          "dos seus filhos órfãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Desapareça a sua posteridade,",
          "e que o seu nome se extinga",
          "na geração seguinte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Que a iniquidade",
          "de seus pais fique viva",
          "na memória do Senhor,",
          "e não se apague o pecado",
          "de sua mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Permaneçam",
          "ante os olhos do Senhor,",
          "para que faça desaparecer",
          "da terra a sua memória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque ele não se lembrou",
          "de usar de misericórdia,",
          "mas perseguiu o pobre",
          "e o necessitado,",
          "bem como o quebrantado",
          "de coração,",
          "para os entregar à morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Amou a maldição:",
          "que ela o apanhe!",
          "Não quis a bênção:",
          "que ela se afaste dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Vestiu-se de maldição",
          "como de uma túnica:",
          "que ela penetre, como água,",
          "no seu interior,",
          "e nos seus ossos, como azeite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Seja para ele",
          "como a roupa que o cobre",
          "e como o cinto",
          "com que sempre se cinge."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Que esta seja,",
          "da parte do Senhor,",
          "a recompensa dos que me acusam",
          "e dos que falam mal de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Mas tu, ó Deus, meu Senhor,",
          "age por mim,",
          "por amor do teu nome;",
          "livra-me, porque é boa",
          "a tua misericórdia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Porque sou pobre e necessitado",
          "e, dentro de mim,",
          "sinto ferido o coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Vou passando,",
          "como a sombra que declina;",
          "sou atirado para longe,",
          "como um gafanhoto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "De tanto jejuar,",
          "os meus joelhos vacilam,",
          "e o meu corpo definha de magreza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Tornei-me para eles",
          "objeto de zombaria;",
          "quando me veem,",
          "balançam a cabeça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Socorre-me, Senhor, meu Deus!",
          "Salva-me",
          "segundo a tua misericórdia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Para que saibam que isso vem",
          "das tuas mãos;",
          "que tu, Senhor, o fizeste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Amaldiçoem eles,",
          "mas tu, abençoa.",
          "Sejam envergonhados",
          "os que se levantam contra mim;",
          "alegre-se, porém, o teu servo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Cubram-se de vexame",
          "os meus adversários,",
          "e a sua própria vergonha",
          "os envolva como um manto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Muitas graças darei ao Senhor",
          "com os meus lábios;",
          "eu o louvarei no meio da multidão;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "porque ele se põe",
          "à direita do pobre,",
          "para o livrar",
          "daqueles que o condenam."
        ],
        "rlw_lines": []
      }
    ]
  },
