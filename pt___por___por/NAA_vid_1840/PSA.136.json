    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A misericórdia de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deem graças ao Senhor,",
          "porque ele é bom,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deem graças",
          "ao Deus dos deuses,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Deem graças",
          "ao Senhor dos senhores,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ao único que opera",
          "grandes maravilhas,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Àquele que com entendimento",
          "fez os céus,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Àquele que estendeu",
          "a terra sobre as águas,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Àquele que fez",
          "os grandes luzeiros,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Fez o sol para presidir o dia,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Fez a lua e as estrelas",
          "para presidirem a noite,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Àquele que matou",
          "os primogênitos do Egito,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "E tirou Israel do meio deles,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ele os tirou com mão poderosa",
          "e braço estendido,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Àquele que dividiu",
          "o mar Vermelho em duas partes,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "E fez Israel passar pelo meio dele,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mas lançou Faraó",
          "e o seu exército",
          "no mar Vermelho,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Àquele que conduziu",
          "o seu povo pelo deserto,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Àquele que matou",
          "reis poderosos,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "E tirou a vida de reis famosos,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Matou Seom, rei dos amorreus,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "E matou Ogue, rei de Basã,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "E deu a terra deles em herança,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Em herança a Israel, seu servo,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Àquele que se lembrou de nós",
          "em nosso abatimento,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "E nos libertou",
          "dos nossos inimigos,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Ele dá alimento",
          "a todos os seres vivos,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Deem louvores",
          "ao Deus dos céus,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
