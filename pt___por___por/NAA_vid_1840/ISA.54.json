    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O futuro glorioso de Sião"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Cante, ó estéril,",
          "você que não deu à luz;",
          "exulte e grite de alegria,",
          "você que nunca sentiu",
          "dores de parto!",
          "Porque os filhos da mulher",
          "solitária",
          "são mais numerosos",
          "do que os filhos da casada”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Alargue o espaço de sua tenda",
          "e aumente o toldo",
          "de sua habitação;",
          "não o impeça; alongue as cordas",
          "e firme bem as estacas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque você se expandirá",
          "para a direita",
          "e para a esquerda;",
          "a sua posteridade",
          "possuirá as nações",
          "e fará com que se povoem",
          "as cidades arrasadas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Não tenha medo,",
          "porque você não será",
          "envergonhada;",
          "não tenha vergonha,",
          "porque você não sofrerá",
          "humilhação.",
          "Você se esquecerá",
          "da vergonha da sua mocidade",
          "e não mais se lembrará",
          "da desgraça da sua viuvez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque o seu Criador",
          "é o seu marido;",
          "Senhor dos Exércitos é o seu nome.",
          "O Santo de Israel",
          "é o seu Redentor;",
          "ele é chamado",
          "‘O Deus de toda a terra’.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Porque o Senhor chamou você",
          "como se chama",
          "a mulher abandonada",
          "e de espírito abatido,",
          "como se chama",
          "a mulher da mocidade,",
          "que havia sido repudiada”,",
          "diz o seu Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Por um breve momento",
          "abandonei você,",
          "mas com grande misericórdia",
          "tornarei a acolhê-la."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Num ímpeto de indignação,",
          "escondi de você a minha face",
          "por um momento,",
          "mas com misericórdia eterna",
          "me compadeço de você”,",
          "diz o Senhor, o seu Redentor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“Porque isto é para mim",
          "como as águas de Noé:",
          "como jurei que as águas de Noé",
          "não mais inundariam a terra,",
          "assim jurei que não mais",
          "ficaria irado com você,",
          "nem a repreenderia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mesmo que os montes",
          "se retirem",
          "e as colinas sejam removidas,",
          "a minha misericórdia",
          "não se afastará de você,",
          "e a minha aliança de paz",
          "não será removida”,",
          "diz o Senhor,",
          "que se compadece de você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Ó cidade aflita,",
          "sacudida pela tormenta",
          "e desconsolada!",
          "Eis que eu assentarei",
          "as suas pedras",
          "com argamassa colorida",
          "e lançarei os seus alicerces",
          "sobre safiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "As suas torres serão de rubis,",
          "os seus portões",
          "serão de esmeraldas",
          "e toda a sua muralha",
          "será de pedras preciosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Todos os seus filhos",
          "serão ensinados pelo Senhor,",
          "e será grande a paz de seus filhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Você será estabelecida",
          "em justiça.",
          "Ficará longe da opressão,",
          "porque não temerá;",
          "ficará longe do terror,",
          "porque ele não chegará perto",
          "de você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Se alguém a atacar,",
          "isso não procederá de mim;",
          "mas quem a atacar cairá",
          "diante de você.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "“Eis que eu criei o ferreiro,",
          "que assopra as brasas no fogo",
          "e que produz a arma",
          "para o seu devido fim;",
          "eu criei também o destruidor,",
          "para trazer a ruína."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Nenhuma arma forjada",
          "contra você prosperará;",
          "e você condenará toda língua",
          "que quiser acusá-la em juízo.",
          "Esta é a herança",
          "dos servos do Senhor",
          "e a sua justiça",
          "que procede de mim”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
