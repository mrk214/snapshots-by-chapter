    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus, o nosso pastor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O Senhor é o meu pastor;",
          "nada me faltará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele me faz repousar",
          "em pastos verdejantes.",
          "Leva-me para junto das águas",
          "de descanso;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "refrigera-me a alma.",
          "Guia-me pelas veredas da justiça",
          "por amor do seu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ainda que eu ande",
          "pelo vale da sombra da morte,",
          "não temerei mal nenhum,",
          "porque tu estás comigo;",
          "o teu bordão e o teu cajado",
          "me consolam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Preparas-me uma mesa",
          "na presença dos meus adversários,",
          "unges a minha cabeça com óleo;",
          "o meu cálice transborda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Bondade e misericórdia",
          "certamente me seguirão",
          "todos os dias da minha vida;",
          "e habitarei na Casa do Senhor",
          "para todo o sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
