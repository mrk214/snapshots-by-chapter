    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplicas de um ancião"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Em ti, Senhor, me refugio;",
          "não seja eu jamais envergonhado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Livra-me por tua justiça",
          "e resgata-me;",
          "inclina-me os ouvidos e salva-me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sê tu para mim",
          "uma rocha habitável",
          "em que eu sempre possa",
          "me refugiar.",
          "Ordenaste que eu me salve,",
          "pois tu és a minha rocha",
          "e a minha fortaleza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Livra-me, Deus meu,",
          "das mãos do ímpio,",
          "das garras do homem injusto",
          "e cruel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois tu és a minha esperança,",
          "Senhor Deus,",
          "a minha confiança",
          "desde a minha mocidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Em ti eu tenho me apoiado",
          "desde o meu nascimento;",
          "tu me tiraste do ventre materno.",
          "A ti se dirige constantemente",
          "o meu louvor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Para muitos sou motivo",
          "de espanto,",
          "mas tu és o meu forte refúgio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os meus lábios estão repletos",
          "do teu louvor",
          "e da tua glória continuamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não me rejeites",
          "na minha velhice;",
          "quando me faltarem as forças,",
          "não me desampares."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois os meus inimigos",
          "falam contra mim;",
          "e os que querem matar-me",
          "conspiram,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "dizendo: “Deus o abandonou.",
          "Persigam-no e prendam-no,",
          "pois não há quem o possa livrar.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ó Deus, não te ausentes de mim;",
          "Deus meu, apressa-te",
          "em me socorrer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Que sejam envergonhados",
          "e consumidos",
          "os que são adversários",
          "de minha alma;",
          "cubram-se de vergonha",
          "e de vexame",
          "os que procuram o meu mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Quanto a mim, esperarei sempre",
          "e te louvarei cada vez mais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "A minha boca proclamará",
          "a tua justiça;",
          "o dia inteiro contarei",
          "os feitos da tua salvação,",
          "ainda que eu não saiba",
          "o seu número."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Irei na força do Senhor Deus;",
          "anunciarei a tua justiça,",
          "a tua somente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tu me tens ensinado, ó Deus,",
          "desde a minha mocidade;",
          "e até agora tenho anunciado",
          "as tuas maravilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Não me desampares, ó Deus,",
          "agora que estou velho",
          "e de cabelos brancos,",
          "até que eu tenha declarado",
          "à presente geração a tua força",
          "e às gerações vindouras o teu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A tua justiça, ó Deus,",
          "se eleva até os céus.",
          "Grandes coisas tens feito, ó Deus;",
          "quem é semelhante a ti?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Tu, que me tens feito ver",
          "muitas angústias e males,",
          "me restaurarás ainda a vida",
          "e de novo me tirarás",
          "dos abismos da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Aumenta a minha grandeza",
          "e consola-me novamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Eu também te louvo com a lira",
          "por tua verdade,",
          "ó Deus meu;",
          "cantarei louvores a ti",
          "ao som da harpa,",
          "ó Santo de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Os meus lábios exultarão",
          "quando eu cantar louvores a ti;",
          "também exultará a minha alma,",
          "que remiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Igualmente a minha língua",
          "celebrará a tua justiça",
          "todo o dia;",
          "pois estão envergonhados",
          "e confundidos",
          "os que procuram o meu mal."
        ],
        "rlw_lines": []
      }
    ]
  },
