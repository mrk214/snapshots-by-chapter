    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ação de graças pela libertação da morte"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi. Cântico da dedicação da casa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu te exaltarei, Senhor,",
          "porque tu me livraste",
          "e não permitiste",
          "que os meus inimigos",
          "se alegrassem contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Senhor, meu Deus,",
          "clamei a ti por socorro,",
          "e tu me curaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Senhor, da sepultura",
          "fizeste subir a minha alma;",
          "preservaste-me a vida",
          "para que não descesse",
          "ao abismo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Cantem louvores ao Senhor,",
          "vocês que são os seus santos,",
          "e deem graças ao seu santo nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque a sua ira dura",
          "só um momento,",
          "mas o seu favor dura a vida inteira.",
          "O choro pode durar uma noite,",
          "mas a alegria vem pela manhã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu disse na minha prosperidade:",
          "“Jamais serei abalado.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tu, Senhor, por teu favor",
          "fizeste permanecer forte",
          "a minha montanha;",
          "apenas voltaste o rosto,",
          "fiquei logo com medo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por ti, Senhor, clamei;",
          "ao Senhor implorei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Que proveito obterás",
          "no meu sangue,",
          "quando baixo à cova?",
          "Será que o pó",
          "é capaz de te louvar?",
          "Poderá ele declarar a tua verdade?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ouve, Senhor,",
          "e tem compaixão de mim;",
          "sê tu, Senhor, o meu auxílio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tornaste o meu pranto",
          "em dança alegre;",
          "tiraste o meu pano de saco",
          "e me cingiste de alegria,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "para que o meu espírito",
          "te cante louvores",
          "e não se cale.",
          "Senhor, Deus meu,",
          "graças te darei para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
