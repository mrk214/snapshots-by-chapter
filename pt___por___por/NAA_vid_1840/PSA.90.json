    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "Livro IV"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "Salmos 90—106"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A eternidade de Deus e a transitoriedade do ser humano"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oração de Moisés, homem de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, tu tens sido",
          "o nosso refúgio,",
          "de geração em geração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Antes que os montes nascessem",
          "e tu formasses a terra e o mundo,",
          "de eternidade a eternidade,",
          "tu és Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tu reduzes o ser humano ao pó",
          "e dizes: “Voltem ao pó,",
          "filhos dos homens.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pois mil anos, aos teus olhos,",
          "são como o dia de ontem que se foi",
          "e como a vigília da noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu os arrastas na torrente;",
          "são como um sono.",
          "São como a relva que floresce",
          "de madrugada;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "de madrugada, viceja e floresce;",
          "à tarde, murcha e seca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pois somos consumidos",
          "pela tua ira",
          "e pelo teu furor, conturbados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Puseste as nossas iniquidades",
          "diante de ti",
          "e, sob a luz do teu rosto,",
          "os nossos pecados ocultos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pois todos os nossos dias",
          "se passam na tua ira;",
          "acabam-se os nossos anos",
          "como um breve pensamento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os dias da nossa vida",
          "sobem a setenta anos",
          "ou, em havendo vigor, a oitenta;",
          "neste caso, o melhor deles",
          "é canseira e enfado,",
          "porque tudo passa rapidamente,",
          "e nós voamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Quem conhece",
          "o poder da tua ira?",
          "E a tua cólera, segundo o temor",
          "que te é devido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ensina-nos a contar",
          "os nossos dias,",
          "para que alcancemos",
          "coração sábio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Volta-te, Senhor!",
          "Até quando estarás indignado?",
          "Tem compaixão dos teus servos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sacia-nos de manhã",
          "com a tua bondade,",
          "para que cantemos de júbilo",
          "e nos alegremos",
          "todos os nossos dias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Alegra-nos por tantos dias",
          "quantos nos tens afligido,",
          "por tantos anos",
          "quantos suportamos",
          "a adversidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Aos teus servos apareçam",
          "as tuas obras,",
          "e a seus filhos, a tua glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Seja sobre nós a graça do Senhor,",
          "nosso Deus;",
          "confirma sobre nós",
          "as obras das nossas mãos,",
          "sim, confirma",
          "a obra das nossas mãos."
        ],
        "rlw_lines": []
      }
    ]
  },
