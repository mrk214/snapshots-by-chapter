    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Chamado para voltar ao Senhor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Israel, volte para o Senhor,",
          "seu Deus,",
          "porque você caiu",
          "por causa dos seus pecados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tragam palavras",
          "de arrependimento",
          "e convertam-se",
          "ao Senhor, dizendo:",
          "‘Perdoa toda a nossa iniquidade,",
          "aceita o que é bom",
          "e, em vez de novilhos,",
          "os sacrifícios dos nossos lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A Assíria não nos salvará.",
          "Não iremos montados em cavalos",
          "e não mais diremos",
          "às obras das nossas mãos",
          "que elas são o nosso Deus.",
          "Porque só em ti",
          "o órfão encontra misericórdia.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Vou curar a rebeldia deles.",
          "Vou amá-los de boa vontade,",
          "porque a minha ira",
          "se afastou deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Serei para Israel como orvalho;",
          "ele florescerá como o lírio",
          "e lançará as suas raízes",
          "como o cedro do Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os seus ramos se estenderão,",
          "o seu esplendor",
          "será como o da oliveira,",
          "e a sua fragrância,",
          "como a do cedro do Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os que se assentavam",
          "à sua sombra voltarão;",
          "serão vivificados como o trigo",
          "e florescerão como a videira;",
          "a sua fama será",
          "como a do vinho do Líbano.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Ó Efraim, que tenho eu",
          "a ver com os ídolos?",
          "Sou eu que ouço as suas orações",
          "e cuido de você!",
          "Eu sou como o cipreste verde;",
          "de mim procede o seu fruto.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Apelo final"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Quem é sábio,",
          "que entenda estas coisas!",
          "Quem é inteligente,",
          "que as compreenda!",
          "Porque os caminhos do Senhor",
          "são retos,",
          "e os justos andarão neles,",
          "mas os transgressores neles cairão."
        ],
        "rlw_lines": []
      }
    ]
  },
