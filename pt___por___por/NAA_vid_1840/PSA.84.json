    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Saudades do templo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “Os lagares”. Salmo dos filhos de Corá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quão amáveis são",
          "os teus tabernáculos,",
          "Senhor dos Exércitos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "A minha alma suspira e desfalece",
          "pelos átrios do Senhor;",
          "o meu coração e a minha carne",
          "exultam pelo Deus vivo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O pardal encontrou casa,",
          "e a andorinha, ninho para si,",
          "onde acolha os seus filhotes,",
          "perto dos teus altares,",
          "Senhor dos Exércitos,",
          "Rei meu e Deus meu!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Bem-aventurados",
          "os que habitam em tua casa;",
          "louvam-te perpetuamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Bem-aventurado é aquele",
          "cuja força está em ti,",
          "em cujo coração se encontram",
          "os caminhos aplanados!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quando passa pelo vale árido,",
          "faz dele um manancial;",
          "de bênçãos o cobre",
          "a primeira chuva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Vão indo de força em força;",
          "cada um deles aparece",
          "diante de Deus em Sião."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Senhor, Deus dos Exércitos,",
          "escuta a minha oração;",
          "ouve-me, ó Deus de Jacó!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Olha, ó Deus, escudo nosso,",
          "e contempla o rosto do teu ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois um dia nos teus átrios",
          "vale mais que mil;",
          "prefiro estar à porta",
          "da casa do meu Deus",
          "a permanecer nas tendas",
          "da perversidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Porque o Senhor Deus",
          "é sol e escudo;",
          "o Senhor dá graça e glória;",
          "não recusa nenhum bem",
          "aos que andam retamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ó Senhor dos Exércitos,",
          "feliz é aquele que em ti confia."
        ],
        "rlw_lines": []
      }
    ]
  },
