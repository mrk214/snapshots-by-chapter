    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hino de louvor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Cantem ao Senhor",
          "um cântico novo;",
          "cantem o seu louvor",
          "na assembleia dos santos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alegre-se Israel no seu Criador;",
          "exultem no seu Rei",
          "os filhos de Sião."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Louvem o nome do Senhor",
          "com danças;",
          "cantem-lhe salmos",
          "ao som de tamborins e harpas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque o Senhor",
          "se agrada do seu povo",
          "e exalta os humildes",
          "com a salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que os santos exultem de glória,",
          "e no seu leito cantem de júbilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Nos seus lábios estejam",
          "os altos louvores de Deus,",
          "e, nas suas mãos,",
          "uma espada de dois gumes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para exercer vingança",
          "entre as nações",
          "e castigo sobre os povos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "para prender os seus reis",
          "com correntes",
          "e os seus nobres,",
          "com cadeias de ferro;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para executar contra eles",
          "a sentença escrita,",
          "o que será honra",
          "para todos os seus santos.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
