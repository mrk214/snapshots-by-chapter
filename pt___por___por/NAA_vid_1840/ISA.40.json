    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Mensagem de consolo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Consolem, consolem",
          "o meu povo”,",
          "diz o Deus de vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Falem ao coração de Jerusalém",
          "e anunciem que o tempo",
          "da sua escravidão já acabou,",
          "que a sua iniquidade",
          "está perdoada",
          "e que ela já recebeu em dobro",
          "das mãos do Senhor",
          "por todos os seus pecados.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Uma voz clama:",
          "“No deserto preparem",
          "o caminho do Senhor!",
          "No ermo façam uma estrada reta",
          "para o nosso Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Todos os vales serão levantados,",
          "e todos os montes e colinas",
          "serão rebaixados;",
          "o que é tortuoso será retificado,",
          "e os lugares ásperos",
          "serão aplanados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A glória do Senhor",
          "se manifestará,",
          "e toda a humanidade a verá,",
          "pois a boca do Senhor o disse.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Uma voz diz: “Proclame!”",
          "E alguém pergunta:",
          "“Que hei de proclamar?”",
          "Toda a humanidade é erva,",
          "e toda a sua glória",
          "é como a flor do campo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A erva seca e as flores caem,",
          "soprando nelas o hálito do Senhor.",
          "Na verdade, o povo é erva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A erva seca e as flores caem,",
          "mas a palavra do nosso Deus",
          "permanece para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ó Sião, você que anuncia",
          "boas-novas,",
          "suba a um alto monte!",
          "Ó Jerusalém, você que anuncia",
          "boas-novas,",
          "levante a sua voz fortemente!",
          "Levante-a, não tenha medo.",
          "Diga às cidades de Judá:",
          "“Eis aí está o seu Deus!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eis que o Senhor Deus",
          "virá com poder,",
          "e o seu braço dominará;",
          "eis que o seu galardão",
          "está com ele,",
          "e diante dele",
          "vem a sua recompensa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Como pastor, ele apascentará",
          "o seu rebanho;",
          "entre os seus braços recolherá",
          "os cordeirinhos",
          "e os carregará no colo;",
          "as que amamentam",
          "ele guiará mansamente."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A majestade do Senhor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Quem na concha de sua mão",
          "mediu as águas",
          "e tomou a medida dos céus",
          "a palmos?",
          "Quem recolheu o pó da terra",
          "na terça parte de uma vasilha",
          "e pesou os montes e as colinas",
          "numa balança?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Quem guiou",
          "o Espírito do Senhor?",
          "Ou, como seu conselheiro,",
          "o ensinou?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Com quem ele se aconselhou,",
          "para que lhe desse compreensão?",
          "Quem lhe ensinou",
          "a vereda da justiça",
          "ou quem lhe ensinou sabedoria?",
          "E quem lhe mostrou",
          "o caminho de entendimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eis que as nações",
          "são consideradas por ele",
          "como um pingo que cai",
          "de um balde",
          "e como um grão de pó na balança;",
          "eis que ele carrega as ilhas",
          "como se fossem pó fino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O Líbano não seria suficiente",
          "para o fogo,",
          "e os animais de lá não bastariam",
          "para um holocausto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Diante dele, todas as nações",
          "são como coisa que não é nada;",
          "ele as considera menos",
          "do que nada, como um vácuo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Com quem vocês querem",
          "comparar Deus?",
          "Com que imagem vocês o podem",
          "confrontar?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Quanto à imagem,",
          "esta é moldada pelo artífice;",
          "depois, o ourives a reveste de ouro",
          "e forja correntes de prata para ela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O pobre, que não pode fazer",
          "tal oferta,",
          "escolhe madeira que não apodrece",
          "e procura um artífice perito",
          "para fazer uma imagem esculpida",
          "que não oscile."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Será que vocês não sabem?",
          "Será que não ouviram?",
          "Será que isso",
          "não lhes foi anunciado",
          "desde o princípio?",
          "Vocês não entenderam isso",
          "desde a fundação do mundo?",
          "Vocês não atentaram",
          "para os fundamentos da terra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ele é o que está assentado",
          "sobre a cúpula da terra,",
          "cujos moradores",
          "são como gafanhotos.",
          "É ele quem estende os céus",
          "como cortina",
          "e os desenrola como tenda",
          "para neles habitar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "É ele quem reduz a nada",
          "os príncipes",
          "e torna em nulidade",
          "os juízes da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Mal foram plantados",
          "e semeados,",
          "mal se arraigou na terra",
          "o seu tronco,",
          "já secam, quando um sopro",
          "passa por eles,",
          "e uma tempestade",
          "os leva como palha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "“Com quem vocês vão",
          "me comparar?",
          "A quem eu seria igual?”",
          "— diz o Santo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Levantem os olhos para o alto",
          "e vejam.",
          "Quem criou estas coisas?",
          "Aquele que faz sair o seu exército",
          "de estrelas,",
          "todas bem-contadas,",
          "as quais ele chama pelo nome;",
          "por ser ele grande em força",
          "e forte em poder,",
          "nem uma só vem a faltar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Por que, então, você diz, ó Jacó,",
          "e você fala, ó Israel:",
          "“O meu caminho está encoberto",
          "ao Senhor,",
          "e o meu direito passa",
          "despercebido ao meu Deus”?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Será que você não sabe,",
          "nem ouviu que o eterno Deus,",
          "o Senhor,",
          "o Criador dos confins da terra,",
          "nem se cansa, nem se fatiga?",
          "A sabedoria dele é insondável."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Ele fortalece o cansado",
          "e multiplica as forças",
          "ao que não tem nenhum vigor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Os jovens se cansam",
          "e se fatigam,",
          "e os moços, de exaustos, caem,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "mas os que esperam no Senhor",
          "renovam as suas forças,",
          "sobem com asas como águias,",
          "correm e não se cansam,",
          "caminham e não se fatigam."
        ],
        "rlw_lines": []
      }
    ]
  },
