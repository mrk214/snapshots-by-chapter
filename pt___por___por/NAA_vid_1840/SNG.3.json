    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "De noite, na minha cama,",
          "busquei o amado de minha alma;",
          "busquei-o, mas não o achei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Eu me levantarei agora",
          "e rodearei a cidade,",
          "pelas ruas e pelas praças;",
          "buscarei o amado da minha alma.",
          "Busquei-o, mas não o achei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os guardas, que rondavam",
          "a cidade, me encontraram.",
          "Então lhes perguntei:",
          "“Vocês viram o amado",
          "da minha alma?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mal os deixei, encontrei logo",
          "o amado da minha alma.",
          "Agarrei-me a ele",
          "e não o deixei ir embora,",
          "até que o fiz entrar",
          "na casa de minha mãe",
          "e no quarto daquela",
          "que me concebeu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Filhas de Jerusalém,",
          "jurem pelas gazelas",
          "e pelas corças selvagens",
          "que vocês não acordarão",
          "nem despertarão o amor,",
          "até que este o queira."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Terceiro cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O que é aquilo que vem",
          "subindo do deserto,",
          "como colunas de fumaça,",
          "perfumado de mirra, de incenso",
          "e de todos os tipos",
          "de pós aromáticos",
          "do mercador?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "É a liteira de Salomão.",
          "Vem escoltada",
          "por sessenta valentes,",
          "dos melhores valentes de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Todos sabem manejar a espada",
          "e são treinados para a guerra;",
          "cada um leva a espada na cintura,",
          "por causa dos temores noturnos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O rei Salomão mandou fazer",
          "um palanquim",
          "de madeira do Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "As colunas eram de prata,",
          "o encosto de ouro,",
          "o assento de púrpura,",
          "e o interior foi enfeitado",
          "com carinho pelas mulheres",
          "de Jerusalém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Saiam, ó filhas de Sião,",
          "e venham ver o rei Salomão",
          "com a coroa",
          "com que sua mãe o coroou",
          "no dia do seu casamento,",
          "no dia da alegria do seu coração."
        ],
        "rlw_lines": []
      }
    ]
  },
