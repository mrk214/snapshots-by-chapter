    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Agora ajunte-se em tropas,",
          "ó filha de tropas,",
          "porque fomos sitiados,",
          "e ferirão com uma vara",
          "a face do juiz de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O nascimento do Messias e o seu reinado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“E você, Belém-Efrata,",
          "que é pequena demais para figurar",
          "como grupo de milhares de Judá,",
          "de você me sairá aquele",
          "que há de reinar em Israel,",
          "e cujas origens são",
          "desde os tempos antigos,",
          "desde os dias da eternidade.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Portanto, o Senhor os entregará",
          "até o tempo em que",
          "a que está em dores",
          "tiver dado à luz;",
          "então o restante de seus irmãos",
          "voltará aos filhos de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ele se manterá firme",
          "e apascentará o povo",
          "na força do Senhor,",
          "na majestade do nome do Senhor,",
          "seu Deus;",
          "e eles habitarão seguros,",
          "porque, agora,",
          "ele será engrandecido",
          "até os confins da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "E ele será a nossa paz.",
          "Quando a Assíria vier à nossa terra",
          "e quando entrar",
          "em nossas fortalezas,",
          "levantaremos contra ela",
          "sete pastores",
          "e oito chefes do povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Estes dominarão a terra da Assíria",
          "com a espada,",
          "e a terra de Ninrode,",
          "dentro de suas próprias portas.",
          "Assim, nos livrará da Assíria,",
          "quando esta vier à nossa terra",
          "e invadir as nossas fronteiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O remanescente de Jacó estará",
          "no meio de muitos povos",
          "como orvalho do Senhor,",
          "como chuvisco sobre a relva,",
          "que não espera pelo homem,",
          "nem depende",
          "dos filhos de homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O remanescente de Jacó",
          "estará entre as nações,",
          "no meio de muitos povos,",
          "como um leão entre",
          "os animais da floresta,",
          "como um leãozinho",
          "entre os rebanhos de ovelhas,",
          "o qual, se passar,",
          "ataca e despedaça a presa,",
          "sem que ninguém a possa livrar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A sua mão se exaltará",
          "sobre os seus adversários,",
          "e todos os seus inimigos",
          "serão eliminados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Naquele dia”,",
          "diz o Senhor,",
          "“eliminarei do meio de vocês",
          "os cavalos",
          "e destruirei os carros de guerra;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "destruirei as cidades da sua terra",
          "e derrubarei todas as fortalezas",
          "de vocês;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "arrancarei as feitiçarias",
          "das suas mãos,",
          "e vocês não mais terão adivinhos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "do meio de vocês eliminarei",
          "as imagens de escultura",
          "e as colunas,",
          "e vocês não mais se inclinarão",
          "diante do que fizeram",
          "com as suas próprias mãos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "eliminarei do meio de vocês",
          "os postes da deusa Aserá",
          "e destruirei as cidades de vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Com ira e furor,",
          "eu me vingarei das nações",
          "que não me obedeceram.”"
        ],
        "rlw_lines": []
      }
    ]
  },
