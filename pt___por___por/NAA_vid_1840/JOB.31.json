      "human": "Jó 32"
    },
    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Que Deus me pese numa balança justa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Fiz uma aliança",
          "com os meus olhos:",
          "de não olhar para uma virgem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Do contrário, qual seria",
          "a minha porção",
          "do Deus lá de cima,",
          "e que herança receberia",
          "do Todo-Poderoso",
          "desde as alturas?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Por acaso, não é a perdição",
          "para o ímpio,",
          "e a desgraça para os que praticam",
          "a maldade?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Será que Deus não vê",
          "os meus caminhos",
          "e não conta todos os meus passos?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Se andei com falsidade",
          "ou se o meu pé se apressou",
          "para o engano"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "— que Deus me pese",
          "numa balança justa",
          "e conhecerá a minha integridade!”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Nunca cobicei, nem adulterei"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Se os meus passos se desviaram",
          "do caminho,",
          "se o meu coração",
          "segue os meus olhos,",
          "e se alguma mancha",
          "se apegou às minhas mãos,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "então que outros comam",
          "o que eu semeei,",
          "e que seja arrancado",
          "o que se produz no meu campo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Se o meu coração se deixou",
          "seduzir por uma mulher,",
          "se fiquei rondando",
          "a porta do meu próximo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "então que a minha mulher",
          "moa os cereais",
          "para outro homem,",
          "e que outros se deitem com ela."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pois eu teria cometido",
          "um crime hediondo,",
          "um delito a ser punido pelos juízes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Isso seria fogo que consome",
          "até a destruição",
          "e arrancaria toda a minha colheita",
          "pela raiz.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Sempre fui justo e caridoso"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "“Se não reconheci",
          "o direito do meu servo",
          "ou da minha serva",
          "quando eles reclamavam",
          "contra mim,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "então que faria eu",
          "quando Deus se levantasse",
          "no tribunal?",
          "E, se ele me interrogasse,",
          "que lhe responderia eu?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Aquele que me formou",
          "no ventre de minha mãe",
          "não os fez também a eles?",
          "Ou não é o mesmo Deus",
          "que nos formou",
          "no ventre materno?”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "“Se retive o que os pobres",
          "desejavam",
          "ou deixei que os olhos das viúvas",
          "esperassem em vão;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "ou, se sozinho",
          "comi o meu bocado,",
          "sem reparti-lo com os órfãos"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "— porque",
          "desde a minha mocidade",
          "eu os criei como se fosse",
          "pai deles,",
          "durante toda a minha vida",
          "fui o guia das viúvas —;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "se vi alguém perecer",
          "por falta de roupa",
          "ou notava que o necessitado",
          "não tinha com que se cobrir;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "se ele não me agradeceu",
          "do fundo do coração,",
          "quando se aquecia",
          "com a lã dos meus cordeiros;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "se eu levantei a mão",
          "contra o órfão,",
          "sabendo que eu tinha",
          "o apoio dos juízes,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "então que a omoplata caia",
          "do meu ombro,",
          "e que o meu braço",
          "seja arrancado da articulação."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Porque o castigo de Deus",
          "seria para mim um assombro,",
          "e eu não poderia enfrentar",
          "a sua majestade.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Nunca neguei a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "“Se no ouro pus",
          "a minha esperança",
          "ou se eu disse ao ouro fino:",
          "‘Você é a minha garantia’;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "se me alegrei por ser grande",
          "a minha riqueza",
          "e por ter a minha mão",
          "alcançado muito;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "se olhei para o sol,",
          "quando resplandecia,",
          "ou para a lua, que caminhava",
          "em seu esplendor,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "e o meu coração se deixou",
          "seduzir em segredo,",
          "e eu lhes atirei beijos com a mão,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "também isto seria um delito",
          "a ser punido pelos juízes,",
          "pois eu teria negado a Deus,",
          "que está lá em cima.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Nunca me alegrei com o mal"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "“Se me alegrei com a desgraça",
          "do que me odeia",
          "e se exultei quando o mal o atingiu"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "— eu que não deixei",
          "a minha boca pecar,",
          "rogando praga",
          "para que morresse —;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "se as pessoas que moram",
          "na minha tenda não disseram:",
          "‘Quem nos dera encontrar",
          "alguém que não se saciou",
          "da carne provida por ele’"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "— pois o estrangeiro",
          "não pernoitava na rua;",
          "as minhas portas estavam",
          "sempre abertas",
          "para os viajantes! —;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "se, como Adão, encobri",
          "as minhas transgressões,",
          "ocultando a minha iniquidade",
          "em meu íntimo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "porque eu tinha medo",
          "da grande multidão,",
          "e o desprezo das famílias",
          "me apavorava,",
          "fazendo com que eu me calasse",
          "e não saísse da porta…”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Eis aqui a minha defesa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "“Quem dera que eu tivesse",
          "quem me ouvisse!",
          "Eis aqui a minha defesa assinada!",
          "Que o Todo-Poderoso",
          "me responda!",
          "Que o meu adversário escreva",
          "a sua acusação!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Por certo que a levaria",
          "sobre o meu ombro,",
          "e a poria sobre mim",
          "como se fosse uma coroa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Eu lhe mostraria",
          "o número dos meus passos;",
          "como príncipe",
          "eu me aproximaria dele.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "“Se a minha terra clamar",
          "contra mim,",
          "e se os seus sulcos",
          "juntamente chorarem;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "se comi os seus frutos",
          "sem pagar",
          "ou se causei a morte",
          "aos seus donos,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "que ela produza espinhos",
          "em vez de trigo,",
          "e joio em lugar de cevada.”",
          "Fim das palavras de Jó."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
