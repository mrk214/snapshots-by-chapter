    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pedindo justiça"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Por que, Senhor,",
          "te conservas longe?",
          "Por que te escondes",
          "nas horas de angústia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Com arrogância, os ímpios",
          "perseguem os pobres;",
          "que eles sejam apanhados",
          "nas ciladas que armaram!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois o perverso se gloria",
          "da sua própria cobiça,",
          "o avarento maldiz o Senhor",
          "e blasfema contra ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Em sua soberba,",
          "o perverso não investiga;",
          "tudo o que ele pensa",
          "é que Deus não existe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "São prósperos os caminhos dele",
          "em todo tempo;",
          "muito acima e longe dele",
          "estão os teus juízos;",
          "quanto aos seus adversários,",
          "ele a todos trata com desprezo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pois lá no seu íntimo diz:",
          "“Jamais serei abalado;",
          "de geração em geração,",
          "nenhum mal me sobrevirá.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A sua boca está cheia",
          "de maldição,",
          "enganos e opressão;",
          "debaixo da língua ele tem",
          "insulto e maldade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Põe-se de tocaia nas aldeias,",
          "trucida os inocentes",
          "nos lugares ocultos;",
          "seus olhos espreitam",
          "o desamparado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ele se põe de emboscada,",
          "como o leão na sua caverna;",
          "está de emboscada",
          "para enlaçar o pobre:",
          "apanha-o e o arrasta",
          "com a sua rede."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Abaixa-se, rasteja;",
          "nas suas garras",
          "caem os necessitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Diz ele, no seu íntimo:",
          "“Deus se esqueceu,",
          "virou o rosto",
          "e nunca verá isto.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Levanta-te, Senhor!",
          "Ó Deus, ergue a tua mão!",
          "Não te esqueças dos pobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Por que o ímpio despreza Deus,",
          "dizendo no seu íntimo que Deus",
          "não lhe pedirá contas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tu, porém, tens visto isso,",
          "porque atentas",
          "ao sofrimento e à dor,",
          "para que os possas tomar",
          "em tuas mãos.",
          "A ti se entrega o desamparado;",
          "tu tens sido o defensor do órfão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Quebra o braço do perverso",
          "e do malvado;",
          "pede contas da sua maldade,",
          "até que a descubras de todo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O Senhor é rei eterno:",
          "da sua terra somem as nações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Tens ouvido, Senhor,",
          "o desejo dos humildes;",
          "tu lhes firmarás o coração",
          "e ouvirás o seu clamor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "para fazeres justiça ao órfão",
          "e ao oprimido,",
          "a fim de que o ser humano,",
          "que é da terra,",
          "não volte a espalhar o terror."
        ],
        "rlw_lines": []
      }
    ]
  },
