    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A alegria dos justos pela salvação"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deem graças ao Senhor,",
          "porque ele é bom,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Diga, pois, Israel:",
          "“Sim, a sua misericórdia",
          "dura para sempre.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Diga, pois, a casa de Arão:",
          "“Sim, a sua misericórdia",
          "dura para sempre.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Digam, pois, os que temem",
          "o Senhor:",
          "“Sim, a sua misericórdia",
          "dura para sempre.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Na angústia, invoquei o Senhor;",
          "e o Senhor me ouviu",
          "e me pôs a salvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor está comigo;",
          "não temerei.",
          "O que é que alguém",
          "pode me fazer?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor está comigo,",
          "para me ajudar;",
          "por isso, verei a derrota",
          "dos meus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Melhor é buscar refúgio",
          "no Senhor",
          "do que confiar nos seres humanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Melhor é buscar refúgio",
          "no Senhor",
          "do que confiar em príncipes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todas as nações me cercaram,",
          "mas em nome do Senhor as destruí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Elas me cercaram, sim,",
          "me cercaram de todos os lados;",
          "mas em nome do Senhor as destruí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Como abelhas me cercaram,",
          "porém como fogo em espinhos",
          "foram queimados;",
          "em nome do Senhor as destruí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Empurraram-me violentamente",
          "para me fazer cair,",
          "porém o Senhor me ajudou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor é a minha força",
          "e o meu cântico,",
          "porque ele me salvou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Nas tendas dos justos",
          "há voz de júbilo",
          "e de salvação:",
          "“A mão do Senhor faz proezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "A mão do Senhor se eleva,",
          "a mão do Senhor faz proezas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Não morrerei;",
          "pelo contrário, viverei",
          "e contarei as obras do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "O Senhor me castigou",
          "severamente,",
          "mas não me entregou à morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Abram as portas",
          "da justiça para mim;",
          "entrarei por elas",
          "e darei graças ao Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Esta é a porta do Senhor;",
          "por ela entrarão os justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Graças te dou",
          "porque me escutaste",
          "e foste a minha salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "A pedra que os construtores",
          "rejeitaram,",
          "essa veio a ser a pedra angular."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Isto procede do Senhor",
          "e é maravilhoso aos nossos olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Este é o dia que o Senhor fez;",
          "exultemos e alegremo-nos nele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Oh! Salva-nos, Senhor,",
          "nós te pedimos;",
          "oh! Senhor, concede-nos",
          "prosperidade!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Bendito o que vem",
          "em nome do Senhor.",
          "Da Casa do Senhor,",
          "nós os abençoamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "O Senhor é Deus,",
          "ele é a nossa luz;",
          "adornem a festa com ramos",
          "até as pontas do altar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Tu és o meu Deus,",
          "e eu te louvarei;",
          "tu és o meu Deus,",
          "eu te exaltarei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Deem graças ao Senhor,",
          "porque ele é bom,",
          "porque a sua misericórdia",
          "dura para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
