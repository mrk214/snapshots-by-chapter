verse_numbers":[6],"lines":["Tu destróis os que proferem","mentira;","o Senhor abomina o sanguinário","e o fraudulento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Eu, porém, pela riqueza","da tua misericórdia,","entrarei na tua casa","e me prostrarei diante","do teu santo templo,","no teu temor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Senhor, guia-me na tua justiça,","por causa dos meus adversários;","endireita diante de mim","o teu caminho."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Porque na boca dos meus","adversários não há sinceridade;","o íntimo deles","está cheio de crimes;","a garganta deles","é sepulcro aberto,","e com a língua lisonjeiam."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Declara-os culpados, ó Deus;","que eles caiam","por seus próprios planos.","Rejeita-os por causa de","suas muitas transgressões,","pois se rebelaram contra ti."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Mas alegrem-se todos","os que confiam em ti;","cantem de júbilo para sempre,","porque tu os defendes;","e em ti se gloriem","os que amam o teu nome."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Pois tu, Senhor,","abençoas o justo","e, como escudo,","o cercas da tua bondade."],"rlw_lines":[]}]}}