    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A maldade humana e a bondade de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. De Davi, servo do Senhor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Há no coração do ímpio",
          "a voz da transgressão;",
          "não há temor de Deus",
          "diante de seus olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque a transgressão",
          "o lisonjeia a seus olhos",
          "e lhe diz que a sua iniquidade",
          "não há de ser descoberta,",
          "nem detestada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "As palavras de sua boca",
          "são maldade e engano;",
          "deixou de lado o discernimento",
          "e a prática do bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No seu leito, planeja maldades,",
          "detém-se em caminho",
          "que não é bom,",
          "e não rejeita aquilo que é mau."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A tua misericórdia, Senhor,",
          "chega até os céus,",
          "a tua fidelidade vai até as nuvens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A tua justiça é como",
          "as grandes montanhas;",
          "os teus juízos são como",
          "um abismo profundo.",
          "Tu, Senhor, preservas as pessoas",
          "e os animais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Como é preciosa, ó Deus,",
          "a tua misericórdia!",
          "Por isso, os filhos dos homens",
          "se acolhem à sombra",
          "das tuas asas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Fartam-se da abundância",
          "da tua casa,",
          "e na torrente das tuas delícias",
          "lhes dás de beber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pois em ti está a fonte da vida;",
          "na tua luz, vemos a luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Estende a tua misericórdia",
          "aos que te conhecem,",
          "e a tua justiça,",
          "aos retos de coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Não deixes que",
          "os pés dos soberbos",
          "me esmaguem,",
          "nem que a mão dos ímpios",
          "me obrigue a fugir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Tombaram os que praticam",
          "a iniquidade;",
          "foram derrubados",
          "e não conseguem",
          "mais se levantar."
        ],
        "rlw_lines": []
      }
    ]
  },
