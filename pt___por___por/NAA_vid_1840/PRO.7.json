  "book": {
    "book_usfm": "PRO",
    "name": "Provérbios"
  },
  "chapter": {
    "usfm": "PRO.7",
    "human": "Provérbios 7",
    "previous": {
      "usfm": "PRO.6",
      "human": "Provérbios 6"
    },
    "next": {
      "usfm": "PRO.8",
      "human": "Provérbios 8"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Meu filho, guarde",
          "as minhas palavras",
          "e conserve os meus mandamentos",
          "em seu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Observe os meus mandamentos",
          "e você viverá;",
          "guarde a minha lei",
          "como a menina dos seus olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Amarre-os aos dedos,",
          "escreva-os na tábua",
          "do seu coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Diga à Sabedoria:",
          "“Você é minha irmã”;",
          "e ao Entendimento:",
          "“Você é meu parente.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eles o guardarão",
          "da mulher imoral,",
          "da estranha que lisonjeia",
          "com palavras."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A mulher imoral"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque da janela da minha casa,",
          "olhando pela grade,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "vi entre os ingênuos,",
          "e descobri entre os jovens",
          "um que não tinha juízo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele ia e vinha pela rua",
          "junto à esquina",
          "da mulher estranha",
          "e seguia o caminho da casa dela,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "no crepúsculo, ao anoitecer,",
          "na escuridão da noite, nas trevas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eis que a mulher",
          "lhe saiu ao encontro,",
          "com roupas de prostituta",
          "e astúcia no coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "É espalhafatosa e inquieta;",
          "os seus pés não param em casa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ora está nas ruas,",
          "ora, nas praças,",
          "espreitando por todos os cantos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ela agarrou o jovem e o beijou;",
          "e com o maior descaramento",
          "lhe disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Eu tinha de oferecer",
          "sacrifícios pacíficos;",
          "hoje paguei os meus votos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por isso, saí ao seu encontro;",
          "vim procurá-lo,",
          "e agora o encontrei!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Já cobri de colchas",
          "a minha cama,",
          "de linho fino do Egito,",
          "de várias cores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Já perfumei o meu leito",
          "com mirra, aloés e cinamomo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Venha, vamos nos embriagar",
          "com as delícias do amor,",
          "até o amanhecer;",
          "gozemos amores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Porque o meu marido",
          "não está em casa;",
          "saiu de viagem para longe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Levou consigo uma bolsa",
          "cheia de dinheiro;",
          "não voltará para casa",
          "antes da lua cheia.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Ela o seduziu",
          "com as suas muitas palavras,",
          "com as lisonjas dos seus lábios",
          "o arrastou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "E, num instante, ele a seguiu,",
          "como um boi",
          "que vai para o matadouro;",
          "como um animal",
          "que corre para a armadilha,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "até que uma flecha",
          "lhe atravesse o coração.",
          "Ele era como a ave que corre",
          "para dentro do alçapão,",
          "sem saber que isto",
          "lhe custará a vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Agora, meu filho,",
          "escute o que eu digo",
          "e dê atenção",
          "às palavras da minha boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Não deixe que o seu coração",
          "se desvie para os caminhos",
          "dessa mulher,",
          "e não ande perdido",
          "nas suas veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Porque a muitos",
          "ela feriu e derrubou;",
          "e são muitos os que",
          "por ela foram mortos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "A casa dela é caminho",
          "para o abismo",
          "e desce para as câmaras da morte."
        ],
        "rlw_lines": []
      }
    ]
  },
