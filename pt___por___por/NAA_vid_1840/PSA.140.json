    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração por proteção"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, livra-me dos maus;",
          "protege-me dos homens violentos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "que planejam o mal",
          "em seu coração",
          "e vivem provocando conflitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Aguçam a língua como a serpente;",
          "sob os lábios",
          "têm veneno de víbora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Guarda-me, Senhor,",
          "das mãos dos ímpios,",
          "protege-me dos homens violentos,",
          "que se empenham",
          "por me desviar os passos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os soberbos ocultaram",
          "armadilhas e cordas contra mim,",
          "estenderam uma rede",
          "à beira do caminho;",
          "armaram ciladas contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Digo ao Senhor:",
          "“Tu és o meu Deus.”",
          "Escuta, Senhor,",
          "a voz das minhas súplicas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ó Deus, meu Senhor,",
          "força da minha salvação,",
          "tu me protegeste a cabeça",
          "no dia da batalha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Não concedas, Senhor,",
          "aos ímpios os seus desejos;",
          "não permitas",
          "que sejam bem-sucedidos",
          "os seus maus propósitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Se exaltam a cabeça",
          "os que me cercam,",
          "que a maldade dos seus lábios",
          "caia sobre eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Caiam sobre eles brasas vivas,",
          "sejam atirados ao fogo,",
          "lançados em abismos para que",
          "não mais se levantem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O caluniador",
          "não se estabelecerá na terra;",
          "ao homem violento,",
          "o mal o perseguirá",
          "com golpe sobre golpe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sei que o Senhor defenderá",
          "a causa do oprimido",
          "e o direito do necessitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Assim, os justos renderão graças",
          "ao teu nome;",
          "os retos habitarão na tua presença."
        ],
        "rlw_lines": []
      }
    ]
  },
