    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração vespertina"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, eu clamo a ti;",
          "apressa-te em me socorrer!",
          "Inclina os ouvidos à minha voz,",
          "quando te invoco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Suba à tua presença",
          "a minha oração como incenso,",
          "e seja o erguer de minhas mãos",
          "como oferenda vespertina."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Põe guarda à minha boca, Senhor;",
          "vigia a porta dos meus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Não permitas que o meu coração",
          "se incline para o mal,",
          "para a prática da perversidade",
          "na companhia de malfeitores;",
          "e que eu não coma",
          "das suas iguarias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Fira-me o justo,",
          "e isso será um favor;",
          "repreenda-me, e será como óleo",
          "sobre a minha cabeça,",
          "a qual não há de rejeitá-lo.",
          "Continuarei a orar",
          "enquanto os perversos",
          "praticam maldade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quando os seus juízes",
          "forem lançados",
          "do alto de uma rocha,",
          "eles ouvirão as minhas palavras,",
          "que são agradáveis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Como quando se lavra",
          "e sulca a terra,",
          "assim os nossos ossos",
          "são espalhados",
          "à boca da sepultura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pois em ti, ó Deus, meu Senhor,",
          "estão os meus olhos:",
          "em ti confio; não desampares",
          "a minha alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Guarda-me dos laços",
          "que me armaram",
          "e das armadilhas",
          "dos que praticam iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Que os ímpios caiam",
          "nas suas próprias redes,",
          "enquanto eu escapo ileso."
        ],
        "rlw_lines": []
      }
    ]
  },
