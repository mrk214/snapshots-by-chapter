    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ameaças contra Jerusalém"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ai da cidade opressora,",
          "rebelde e manchada!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Não atende ninguém,",
          "não aceita disciplina,",
          "não confia no Senhor,",
          "nem se aproxima do seu Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os seus príncipes",
          "são leões rugidores",
          "no meio dela,",
          "os seus juízes",
          "são lobos do anoitecer,",
          "que não deixam os ossos",
          "para serem roídos no dia seguinte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os seus profetas",
          "são levianos e falsos.",
          "Os seus sacerdotes",
          "profanam o santuário",
          "e fazem violência à lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor é justo,",
          "no meio da cidade;",
          "ele não comete injustiça.",
          "Manhã após manhã,",
          "ele traz o seu juízo à luz;",
          "não falha.",
          "Mas o injusto não sabe",
          "o que é vergonha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Exterminei nações.",
          "As suas torres estão destruídas.",
          "Tornei desertas as suas praças,",
          "a ponto de não haver",
          "quem passe por elas.",
          "As suas cidades foram destruídas,",
          "de maneira que não há ninguém,",
          "ninguém que as habite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Eu dizia:",
          "‘Certamente você, Jerusalém,",
          "viverá em temor diante de mim",
          "e aceitará a disciplina,",
          "e, assim, a sua morada",
          "não seria destruída,",
          "segundo o que eu",
          "havia determinado.’",
          "Mas eles se tornaram",
          "cada vez mais corruptos",
          "em todos os seus atos.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A salvação da filha de Jerusalém"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Portanto, esperem por mim”,",
          "diz o Senhor,",
          "“esperem pelo dia",
          "em que eu me levantar",
          "para tomar o despojo.",
          "Porque a minha resolução",
          "é ajuntar as nações",
          "e congregar os reinos,",
          "para fazer cair sobre eles",
          "a minha indignação",
          "e todo o furor da minha ira.",
          "Porque toda esta terra",
          "será consumida",
          "pelo fogo do meu zelo.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "“Então darei lábios puros",
          "aos povos,",
          "para que todos invoquem",
          "o nome do Senhor",
          "e o sirvam de comum acordo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dalém dos rios da Etiópia,",
          "os meus adoradores,",
          "que constituem",
          "a filha da minha dispersão,",
          "me trarão sacrifícios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Naquele dia, você não terá",
          "de se envergonhar",
          "de nenhuma das suas rebeliões",
          "contra mim,",
          "porque tirarei do meio de você,",
          "Jerusalém,",
          "os que exultam no seu orgulho,",
          "e você nunca mais se orgulhará",
          "no meu santo monte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mas deixarei no meio de você",
          "um povo modesto e humilde,",
          "que confia no nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O remanescente de Israel",
          "não cometerá injustiça.",
          "Eles não proferirão mentira,",
          "e da sua boca não sairão palavras",
          "enganosas,",
          "porque serão apascentados,",
          "se deitarão,",
          "e não haverá quem os atemorize.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Cante, ó filha de Sião!",
          "Grite de alegria, ó Israel!",
          "Alegre-se e exulte",
          "de todo o coração,",
          "ó filha de Jerusalém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O Senhor retirou as sentenças",
          "que eram contra você",
          "e afastou os seus inimigos.",
          "O Rei de Israel, o Senhor,",
          "está no meio de você;",
          "você não precisa mais temer",
          "nenhum mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Naquele dia, se dirá a Jerusalém:",
          "“Não tenha medo, ó Sião,",
          "não desfaleçam as suas mãos.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O Senhor, seu Deus,",
          "está no meio de você,",
          "poderoso para salvar.",
          "Ele ficará muito contente",
          "com você.",
          "Ele a renovará no seu amor,",
          "e se encherá de júbilo",
          "por causa de você."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "“Congregarei",
          "os que estão entristecidos",
          "por se acharem afastados",
          "das festas solenes,",
          "estes que são do seu meio",
          "e sobre os quais pesam afrontas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Eis que, naquele tempo,",
          "agirei contra todos",
          "os que a afligem.",
          "Salvarei os que coxeiam",
          "e recolherei os que foram expulsos.",
          "Farei deles um louvor e um nome",
          "em toda a terra",
          "em que foram envergonhados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Naquele tempo,",
          "farei com que vocês voltem",
          "e os recolherei.",
          "Certamente farei de vocês",
          "um nome e um louvor",
          "entre todos os povos",
          "da terra,",
          "quando eu restaurar",
          "a sorte de vocês",
          "diante dos seus próprios olhos”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
