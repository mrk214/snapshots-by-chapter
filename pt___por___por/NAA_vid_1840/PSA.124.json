    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus, nosso protetor e libertador"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de peregrinação. De Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Não fosse o Senhor,",
          "que esteve ao nosso lado —",
          "Israel que o diga —;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "não fosse o Senhor,",
          "que esteve ao nosso lado,",
          "quando os nossos inimigos",
          "se levantaram contra nós,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "eles nos teriam engolido vivos,",
          "quando a sua ira se acendeu",
          "contra nós."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "As águas nos teriam submergido,",
          "e a torrente teria passado",
          "por cima de nós;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "águas impetuosas teriam passado",
          "por cima de nós."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Bendito seja o Senhor,",
          "que não nos deu por presa",
          "aos dentes deles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A nossa alma foi salva,",
          "como um pássaro",
          "do laço dos passarinheiros;",
          "rompeu-se o laço,",
          "e nós nos vimos livres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O nosso socorro está",
          "no nome do Senhor,",
          "que fez o céu e a terra."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
