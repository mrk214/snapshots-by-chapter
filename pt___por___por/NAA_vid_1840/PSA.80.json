    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pela restauração de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “Os lírios”. Testemunho de Asafe. Salmo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dá ouvidos, ó pastor de Israel,",
          "tu que conduzes José",
          "como um rebanho;",
          "tu que estás entronizado",
          "acima dos querubins,",
          "mostra o teu esplendor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Diante de Efraim,",
          "Benjamim e Manassés,",
          "desperta o teu poder",
          "e vem salvar-nos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Restaura-nos, ó Deus;",
          "faze resplandecer o teu rosto,",
          "e seremos salvos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ó Senhor, Deus dos Exércitos,",
          "até quando estarás indignado",
          "contra a oração do teu povo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Para comer, tu lhe deste",
          "pão de lágrimas",
          "e, para beber,",
          "pranto em abundância."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Fizeste de nós",
          "um motivo de conflito",
          "entre os nossos vizinhos,",
          "e os nossos inimigos",
          "zombam de nós a valer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Restaura-nos,",
          "ó Deus dos Exércitos;",
          "faze resplandecer o teu rosto,",
          "e seremos salvos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Trouxeste uma videira do Egito;",
          "expulsaste as nações e a plantaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Preparaste-lhe o terreno,",
          "ela deitou profundas raízes",
          "e encheu a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Com a sombra dela",
          "os montes se cobriram,",
          "e os seus ramos se estenderam",
          "por cima dos cedros de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ela estendeu a sua ramagem",
          "até o mar",
          "e os seus rebentos, até o rio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por que derrubaste as cercas",
          "que havia em volta dela,",
          "deixando que todos os que passam",
          "pelo caminho arranquem",
          "as suas uvas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O javali da selva a devasta,",
          "e os animais do campo",
          "se alimentam dela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ó Deus dos Exércitos,",
          "volta-te, nós te rogamos!",
          "Olha do céu, vê",
          "e visita esta vinha!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Protege o que",
          "a tua mão direita plantou,",
          "o ramo que para ti fortaleceste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Foi cortada, foi queimada.",
          "Pereçam os nossos inimigos",
          "pela repreensão do teu rosto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Seja a tua mão sobre aquele",
          "que escolheste,",
          "sobre o filho do homem",
          "que fortaleceste para ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "E assim não nos afastaremos de ti.",
          "Vivifica-nos, e invocaremos",
          "o teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Restaura-nos, ó Senhor,",
          "Deus dos Exércitos;",
          "faze resplandecer o teu rosto,",
          "e seremos salvos."
        ],
        "rlw_lines": []
      }
    ]
  },
