    "items": [
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "O ser humano nasce para o sofrimento"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Grite agora, para ver",
          "se há quem responda!",
          "E para qual dos santos anjos",
          "você se voltará?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque a ira mata o insensato,",
          "e a inveja destrói o tolo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Eu mesmo vi o insensato",
          "lançar raízes,",
          "mas logo declarei maldita",
          "a sua habitação."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os filhos dele estão longe",
          "do socorro;",
          "são oprimidos nos tribunais,",
          "e não há quem os livre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A sua colheita,",
          "o faminto a devora,",
          "arrebatando até o que se encontra",
          "no meio de espinhos;",
          "e o sedento suga os seus bens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque a aflição não vem do pó,",
          "e o sofrimento não brota do chão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mas o ser humano nasce",
          "para o sofrimento,",
          "como as faíscas das brasas",
          "voam para cima.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Há esperança para os pobres"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Quanto a mim,",
          "eu buscaria a Deus",
          "e a ele entregaria a minha causa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Deus faz coisas grandes",
          "e insondáveis,",
          "maravilhas que não se podem",
          "enumerar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Faz chover sobre a terra",
          "e envia águas sobre os campos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Põe os abatidos num lugar alto",
          "e conduz os enlutados",
          "a um lugar seguro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Deus frustra os planos",
          "dos astutos,",
          "para que não possam realizar",
          "seus projetos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ele apanha os sábios",
          "na própria astúcia deles,",
          "e o conselho dos que tramam",
          "não chega a vingar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "De dia eles encontram as trevas,",
          "e ao meio-dia andam tateando",
          "como se fosse noite."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Porém Deus salva da espada",
          "que lhes sai da boca,",
          "salva os necessitados",
          "das mãos dos poderosos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Assim, há esperança",
          "para os pobres,",
          "e a iniquidade tapa",
          "a sua própria boca.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "As mãos de Deus curam"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "“Bem-aventurado é aquele",
          "a quem Deus disciplina!",
          "Portanto, não despreze a disciplina",
          "do Todo-Poderoso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Porque ele faz a ferida",
          "e ele mesmo a faz sarar;",
          "ele fere, e as suas mãos curam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "De seis angústias ele o livrará,",
          "e na sétima o mal",
          "não tocará em você."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Na fome ele livrará você",
          "da morte;",
          "na guerra, do poder da espada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Você estará abrigado",
          "do açoite da língua",
          "e, quando vier a destruição,",
          "não ficará com medo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Da destruição e da fome",
          "você dará risada",
          "e dos animais da terra",
          "não terá medo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Porque com as pedras do campo",
          "você fará aliança,",
          "e os animais selvagens viverão",
          "em paz com você."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Saberá que a sua tenda",
          "está em paz;",
          "percorrerá as suas posses",
          "e não achará falta de nada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Saberá que a sua descendência",
          "se multiplicará,",
          "e que a sua posteridade será",
          "como a erva da terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Em robusta velhice",
          "você descerá à sepultura,",
          "como se recolhe o feixe de trigo",
          "no tempo certo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Veja bem!",
          "Isto é o que investigamos,",
          "e assim é.",
          "Ouça e medite nisso",
          "para o seu bem.”"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
