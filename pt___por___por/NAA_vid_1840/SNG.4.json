{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"SNG","name":"Cântico dos Cânticos"},"chapter":{"chapter_usfm":"SNG.4","is_chapter":true,"previous":{"usfm":"SNG.3","human":"Cântico dos Cânticos 3","canonical":true,"toc":true},"current":{"usfm":"SNG.4","human":"Cântico dos Cânticos 4"},"next":{"usfm":"SNG.5","human":"Cântico dos Cânticos 5","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Esposo"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Como você é bela,","minha querida!","Como você é linda!","Os seus olhos são como pombas","e brilham através do véu.","Os seus cabelos são como","um rebanho de cabras","que descem ondeantes","do monte de Gileade."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Os seus dentes são como","um rebanho de ovelhas","recém-tosquiadas,","que sobem do lavadouro;","cada uma tem o seu par,","e nenhuma está faltando."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Os seus lábios são como","um fio de escarlate,","e a sua boca é linda.","As suas faces, como romã partida,","brilham através do véu."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["O seu pescoço é como","a torre de Davi,","edificada para arsenal;","mil escudos pendem dela,","todos escudos","de soldados valentes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Os seus seios são como","duas crias gêmeas","de uma gazela,","que pastam entre os lírios."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Antes que rompa o dia,","e fujam as sombras,","irei ao monte da mirra","e à colina do incenso."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Você é toda linda,","minha querida,","e em você não há defeito."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Venha comigo do Líbano,","minha noiva,","venha comigo do Líbano.","Desça do alto do monte Amana,","do alto do Senir e do Hermom,","dos covis dos leões,","dos montes dos leopardos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Você roubou meu coração,","meu amor, minha noiva;","roubou meu coração","com um só dos seus olhares,","com uma só pérola do seu colar."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Como são agradáveis","as suas carícias,","meu amor, minha noiva!","O seu amor é melhor","do que o vinho,","e o aroma do seu perfume","é mais suave do que","todas as especiarias!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Os seus lábios destilam mel,","minha noiva.","Mel e leite se acham","debaixo da sua língua,","e o cheiro dos seus vestidos","é como o cheiro do Líbano."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Meu amor, minha noiva,","você é um jardim fechado,","um manancial recluso,","uma fonte selada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Os seus renovos são","um pomar de romãs","com frutos excelentes:","henas com nardos,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["nardo e açafrão,","cálamo e cinamomo,","com todo tipo","de árvores de incenso,","mirra e aloés, com todas","as principais especiarias."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Você é fonte dos jardins,","poço de águas vivas","que correm do Líbano!"],"rlw_lines":[]},{"type":"heading1","verse_numbers":[],"lines":["Esposa"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Desperte, vento norte,","e venha, vento sul!","Soprem no meu jardim,","para que se derramem","os seus aromas.","Que o meu amado venha","ao seu jardim","e coma os seus frutos excelentes!"],"rlw_lines":[]}]}}