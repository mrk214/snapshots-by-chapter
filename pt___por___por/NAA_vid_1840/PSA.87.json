    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jerusalém, a cidade de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo dos filhos de Corá. Cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Fundada por ele",
          "sobre os montes santos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "o Senhor ama as portas de Sião",
          "mais do que todas",
          "as habitações de Jacó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Coisas gloriosas são ditas",
          "a respeito de você,",
          "ó cidade de Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Dentre os que me conhecem,",
          "farei menção de Raabe",
          "e da Babilônia.",
          "Eis aí a Filístia e Tiro",
          "com a Etiópia;",
          "‘nasceram em Sião’,",
          "é o que se diz.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "E a respeito de Sião se dirá:",
          "“Este e aquele nasceram nela”;",
          "e o próprio Altíssimo",
          "a estabelecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor, ao registrar",
          "os povos, dirá:",
          "“Este nasceu lá.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todos os cantores,",
          "saltando de alegria, dirão:",
          "“Todas as minhas fontes",
          "estão em ti.”"
        ],
        "rlw_lines": []
      }
    ]
  },
