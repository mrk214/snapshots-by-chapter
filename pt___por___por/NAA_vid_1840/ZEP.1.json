    "name": "Sofonias"
  },
  "chapter": {
    "usfm": "ZEP.1",
    "human": "Sofonias 1",
    "previous": {
      "usfm": "HAB.3",
      "human": "Habacuque 3"
    },
    "next": {
      "usfm": "ZEP.2",
      "human": "Sofonias 2"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palavra do Senhor que veio a Sofonias, filho de Cusi, filho de Gedalias, filho de Amarias, filho de Ezequias, nos dias de Josias, filho de Amom, rei de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ameaças contra Judá e Jerusalém"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Certamente consumirei",
          "todas as coisas",
          "sobre a face da terra”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“Consumirei as pessoas",
          "e os animais,",
          "consumirei as aves do céu,",
          "os peixes do mar,",
          "e as ofensas com os ímpios.",
          "E exterminarei os seres humanos",
          "da face da terra”,",
          "diz o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Estenderei a mão contra Judá",
          "e contra todos os moradores",
          "de Jerusalém.",
          "Exterminarei deste lugar",
          "o resto de Baal",
          "e a lembrança",
          "dos ministros dos ídolos",
          "e seus sacerdotes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Exterminarei os que",
          "sobre os terraços adoram",
          "o exército do céu",
          "e os que adoram o Senhor",
          "e juram por ele",
          "e também por Milcom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Farei desaparecer também",
          "os que deixam de seguir o Senhor",
          "e os que não buscam o Senhor,",
          "nem perguntam por ele.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O dia da ira do Senhor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Calem-se diante",
          "do Senhor Deus,",
          "porque o Dia do Senhor está perto.",
          "O Senhor preparou o sacrifício",
          "e santificou os seus convidados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No dia do sacrifício do Senhor,",
          "hei de castigar as autoridades,",
          "e os filhos do rei,",
          "e todos os que se vestem",
          "como estrangeiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Castigarei também, naquele dia,",
          "todos aqueles que sobem",
          "o pedestal dos ídolos",
          "e enchem de violência e engano",
          "a casa dos seus senhores.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Naquele dia”,",
          "diz o Senhor,",
          "“se ouvirá um grito",
          "desde o Portão dos Peixes,",
          "e um uivo desde a parte nova da cidade,",
          "e grande lamento desde as colinas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Lamentem, moradores",
          "da cidade baixa,",
          "porque todos os comerciantes",
          "serão mortos",
          "e todos os que pesam prata",
          "serão destruídos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Naquele tempo, vasculharei",
          "Jerusalém com lanternas",
          "e castigarei aqueles",
          "que estão apegados",
          "à borra do vinho",
          "e dizem no seu coração:",
          "‘O Senhor não faz bem",
          "nem faz mal.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Por isso, os bens deles",
          "serão saqueados,",
          "e as suas casas serão destruídas.",
          "Eles construirão casas,",
          "mas não habitarão nelas;",
          "plantarão vinhas,",
          "mas não beberão o vinho.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "“Está perto",
          "o grande Dia do Senhor;",
          "está perto",
          "e vem chegando depressa.",
          "Atenção!",
          "O Dia do Senhor é amargo,",
          "e nele clamarão até os poderosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Aquele dia será um dia de ira,",
          "dia de angústia e tribulação,",
          "dia de ruína e destruição,",
          "dia de trevas e escuridão,",
          "dia de nuvens e densas trevas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "dia de toque de trombeta",
          "e gritos de guerra",
          "contra as cidades fortificadas",
          "e contra as torres altas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Trarei angústia",
          "sobre as pessoas,",
          "e elas andarão como se estivessem cegas,",
          "porque pecaram contra o Senhor.",
          "O sangue dessas pessoas",
          "será derramado como pó,",
          "e a sua carne será espalhada",
          "como esterco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Nem a prata nem o ouro",
          "poderão livrá-las",
          "no dia da ira do Senhor,",
          "mas, pelo fogo do seu zelo,",
          "a terra será consumida.",
          "Porque ele certamente fará",
          "destruição total e repentina",
          "de todos os moradores da terra.”"
        ],
        "rlw_lines": []
      }
    ]
  },
