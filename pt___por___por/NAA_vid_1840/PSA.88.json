    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração de um sofredor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico. Salmo dos filhos de Corá. Ao mestre de canto. Para ser cantado com cítara. Salmo didático de Hemã, ezraíta"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Senhor, Deus da minha",
          "salvação,",
          "dia e noite clamo diante de ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Chegue à tua presença",
          "a minha oração;",
          "inclina os teus ouvidos",
          "ao meu clamor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois a minha alma",
          "está cheia de angústias,",
          "e a minha vida",
          "já se aproxima da morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sou contado",
          "com os que descem ao abismo.",
          "Sou como um homem sem força,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "atirado entre os mortos;",
          "como os feridos de morte",
          "que jazem na sepultura,",
          "dos quais já não te lembras;",
          "pois foram abandonados",
          "pelas tuas mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Puseste-me",
          "na mais profunda cova,",
          "nos lugares tenebrosos,",
          "nos abismos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sobre mim pesa a tua ira;",
          "tu me abates",
          "com todas as tuas ondas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Afastaste de mim",
          "os meus conhecidos",
          "e me fizeste objeto de abominação",
          "para com eles;",
          "estou preso e não vejo como sair."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os meus olhos desfalecem",
          "de aflição;",
          "dia após dia,",
          "venho clamando a ti, Senhor,",
          "e a ti levanto as minhas mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Será que farás maravilhas",
          "para os mortos?",
          "Ou será que os finados",
          "se levantarão para te louvar?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A tua bondade será anunciada",
          "na sepultura?",
          "A tua fidelidade, nos abismos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Acaso nas trevas se manifestam",
          "as tuas maravilhas?",
          "E a tua justiça,",
          "na terra do esquecimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Mas eu, Senhor,",
          "clamo a ti por socorro,",
          "e de madrugada dirijo a ti",
          "a minha oração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Por que rejeitas, Senhor,",
          "a minha alma",
          "e ocultas de mim o teu rosto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ando aflito e prestes a morrer",
          "desde moço;",
          "sob o peso dos teus terrores,",
          "estou desorientado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Sobre mim passou a tua ira;",
          "os teus terrores acabaram comigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O dia todo eles me rodeiam",
          "como água;",
          "a um tempo me circundam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Para longe de mim afastaste",
          "os amigos e companheiros;",
          "os meus conhecidos",
          "agora são as trevas."
        ],
        "rlw_lines": []
      }
    ]
  },
