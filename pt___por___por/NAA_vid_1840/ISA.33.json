    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A aflição e o livramento de Jerusalém"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ai de você, destruidor",
          "que nunca foi destruído!",
          "Ai de você, traidor",
          "que nunca foi traído!",
          "Quando você acabar de destruir,",
          "será destruído;",
          "quando acabar de trair,",
          "será traído."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Senhor, tem misericórdia de nós!",
          "Em ti temos esperado.",
          "Sê tu o nosso braço",
          "manhã após manhã",
          "e a nossa salvação",
          "no tempo da angústia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ao ruído do tumulto,",
          "os povos fogem;",
          "quando tu te ergues,",
          "as nações se dispersam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Então o despojo",
          "que vocês ajuntaram",
          "será recolhido",
          "como se devorado por uma nuvem de gafanhotos;",
          "como os gafanhotos saltam,",
          "assim os homens",
          "saltarão sobre ele."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor é sublime,",
          "pois habita nas alturas;",
          "encheu Sião de retidão e de justiça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ó Sião, no seu tempo",
          "haverá estabilidade,",
          "abundância de salvação,",
          "sabedoria e conhecimento.",
          "O temor do Senhor",
          "será o seu tesouro."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Eis que os heróis",
          "pranteiam nas ruas,",
          "e os mensageiros de paz",
          "estão chorando amargamente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "As estradas estão desoladas,",
          "ninguém passa por elas.",
          "Rompem-se as alianças,",
          "as cidades são desprezadas,",
          "não há respeito pelas pessoas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A terra geme e desfalece;",
          "o Líbano se envergonha e murcha;",
          "Sarom se torna como um deserto,",
          "Basã e Carmelo são despidos",
          "de suas folhas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "“Agora me levantarei”,",
          "diz o Senhor;",
          "“agora me erguerei;",
          "agora serei exaltado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Vocês conceberam palha",
          "e darão à luz restolho;",
          "o sopro que sai da boca de vocês",
          "é um fogo que os há de devorar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Os povos serão queimados",
          "como se queima a cal;",
          "como espinhos cortados,",
          "serão jogados no fogo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Vocês que estão longe,",
          "escutem o que eu fiz;",
          "e vocês que estão perto,",
          "reconheçam o meu poder.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Em Sião, os pecadores",
          "estão atemorizados;",
          "o tremor se apodera dos ímpios.",
          "Eles perguntam:",
          "“Quem de nós habitará",
          "com o fogo devorador?",
          "Quem de nós habitará",
          "com chamas eternas?”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Aquele que anda em justiça",
          "e fala o que é reto;",
          "que despreza o ganho de opressão;",
          "que, com um gesto de mãos,",
          "recusa aceitar suborno;",
          "que tapa os ouvidos,",
          "para não ouvir falar",
          "de homicídios,",
          "e fecha os olhos, para não ver o mal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Este habitará nas alturas;",
          "as fortalezas das rochas",
          "serão o seu alto refúgio,",
          "o seu pão lhe será dado,",
          "e água nunca lhe faltará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os olhos de vocês verão",
          "o rei na sua formosura,",
          "verão a terra que se estende",
          "até longe."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "O seu coração se lembrará",
          "dos terrores, dizendo:",
          "“Onde está o escrivão?",
          "Onde está aquele",
          "que recolheu o tributo?",
          "E onde está aquele",
          "que contou as torres?”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Você já não verá",
          "aquele povo atrevido,",
          "povo de fala obscura,",
          "de uma língua estranha,",
          "que não se pode entender."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Olhe para Sião,",
          "a cidade das nossas festas.",
          "Os seus olhos verão Jerusalém,",
          "habitação tranquila,",
          "tenda que não será removida,",
          "cujas estacas",
          "nunca serão arrancadas,",
          "nem rebentada",
          "nenhuma de suas cordas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Mas o Senhor ali",
          "nos será grandioso,",
          "fará as vezes de largos rios e canais.",
          "Nenhum barco a remo",
          "passará por eles,",
          "navio grande por eles não navegará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Porque o Senhor é o nosso juiz,",
          "o Senhor é o nosso legislador,",
          "o Senhor é o nosso Rei;",
          "ele nos salvará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Agora as suas cordas",
          "estão frouxas;",
          "não permitem firmar o mastro,",
          "nem estender a vela.",
          "Então se repartirá",
          "a presa de muitos despojos;",
          "até os coxos participarão dela."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Nenhum morador de Jerusalém",
          "dirá: “Estou doente”;",
          "o povo que habita nela",
          "terá o seu pecado perdoado."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
