    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cântico de louvor e gratidão"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Cântico. Salmo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aclamem a Deus, todas as terras!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cantem louvores",
          "à glória do seu nome,",
          "deem glória ao seu louvor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Digam isto a Deus:",
          "“Que tremendos",
          "são os teus feitos!",
          "Pela grandeza do teu poder,",
          "a ti se mostram submissos",
          "os teus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Toda a terra se prostra",
          "diante de ti,",
          "e canta louvores a ti;",
          "canta louvores ao teu nome.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Venham e vejam",
          "as obras de Deus:",
          "tremendos feitos para com",
          "os filhos dos homens!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Transformou o mar em terra seca;",
          "eles atravessaram o rio a pé;",
          "ali, nos alegramos nele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele, em seu poder,",
          "governa eternamente;",
          "os seus olhos vigiam as nações.",
          "Não se exaltem os rebeldes!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Bendigam, ó povos,",
          "o nosso Deus;",
          "façam ouvir a voz do seu louvor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "É ele quem preserva com vida",
          "a nossa alma",
          "e não permite que resvalem",
          "os nossos pés."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois tu, ó Deus, nos provaste;",
          "tu nos refinaste",
          "como se faz com a prata."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tu nos deixaste cair",
          "na armadilha;",
          "puseste uma pesada carga",
          "nas nossas costas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "fizeste com que os nossos inimigos",
          "cavalgassem",
          "sobre a nossa cabeça;",
          "passamos pelo fogo e pela água;",
          "porém, afinal, nos trouxeste",
          "para um lugar espaçoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Entrarei na tua casa",
          "com holocaustos;",
          "a ti pagarei os meus votos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "que os meus lábios fizeram,",
          "e que, no dia da angústia,",
          "a minha boca prometeu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Oferecerei a ti holocaustos",
          "de animais gordos,",
          "com aroma de carneiros;",
          "oferecerei novilhos e cabritos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Venham e escutem, todos vocês",
          "que temem a Deus,",
          "e eu contarei o que ele tem feito",
          "por minha alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A ele clamei com a boca;",
          "com a língua o exaltei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Se, no coração, eu tivesse",
          "contemplado iniquidade,",
          "o Senhor não teria me ouvido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Entretanto, Deus me ouviu",
          "e atendeu a voz da minha oração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Bendito seja Deus,",
          "que não rejeitou",
          "a minha oração,",
          "nem afastou de mim a sua graça."
        ],
        "rlw_lines": []
      }
    ]
  },
