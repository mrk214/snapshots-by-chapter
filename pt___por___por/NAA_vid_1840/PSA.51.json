    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confissão e arrependimento"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi, quando o profeta Natã foi falar com ele, depois de ele ter estado com Bate-Seba"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Compadece-te de mim, ó Deus,",
          "segundo a tua benignidade;",
          "e, segundo a multidão",
          "das tuas misericórdias,",
          "apaga as minhas transgressões."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Lava-me completamente",
          "da minha iniquidade",
          "e purifica-me do meu pecado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois eu conheço",
          "as minhas transgressões,",
          "e o meu pecado",
          "está sempre diante de mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pequei contra ti,",
          "contra ti somente,",
          "e fiz o que é mau aos teus olhos,",
          "de maneira que serás tido",
          "por justo no teu falar",
          "e puro no teu julgar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eu nasci na iniquidade,",
          "e em pecado me concebeu",
          "a minha mãe."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eis que te agradas",
          "da verdade no íntimo",
          "e no oculto me fazes conhecer",
          "a sabedoria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Purifica-me com hissopo,",
          "e ficarei limpo;",
          "lava-me, e ficarei mais alvo",
          "do que a neve."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Faze-me ouvir júbilo e alegria,",
          "para que exultem os ossos",
          "que esmagaste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Esconde o teu rosto",
          "dos meus pecados",
          "e apaga todas as minhas",
          "iniquidades."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cria em mim, ó Deus,",
          "um coração puro",
          "e renova dentro de mim",
          "um espírito inabalável."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Não me lances fora",
          "da tua presença,",
          "nem me retires",
          "o teu Santo Espírito."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Restitui-me a alegria",
          "da tua salvação",
          "e sustenta-me",
          "com um espírito voluntário."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Então ensinarei",
          "aos transgressores",
          "os teus caminhos,",
          "e os pecadores",
          "se converterão a ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Livra-me dos crimes",
          "de sangue, ó Deus,",
          "Deus da minha salvação,",
          "e a minha língua",
          "exaltará a tua justiça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Abre, Senhor, os meus lábios,",
          "e a minha boca manifestará",
          "o teu louvor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pois não te agradas",
          "de sacrifícios;",
          "do contrário, eu os ofereceria;",
          "e não tens prazer em holocaustos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sacrifício agradável a Deus",
          "é o espírito quebrantado;",
          "coração quebrantado e contrito,",
          "não o desprezarás, ó Deus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Faze bem a Sião,",
          "segundo a tua boa vontade;",
          "edifica as muralhas de Jerusalém."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Então te agradarás",
          "dos sacrifícios de justiça,",
          "dos holocaustos",
          "e das ofertas queimadas;",
          "e sobre o teu altar",
          "serão oferecidos novilhos."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
