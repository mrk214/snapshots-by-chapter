    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Gratidão pela vitória"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Na tua força, Senhor,",
          "o rei se alegra!",
          "E como exulta com a tua salvação!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tu lhe satisfizeste",
          "o desejo do coração",
          "e não lhe negaste",
          "as súplicas dos seus lábios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois o supres",
          "das bênçãos de bondade;",
          "e lhe pões na cabeça",
          "uma coroa de ouro puro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ele te pediu vida,",
          "e tu lhe deste;",
          "sim, longevidade",
          "para todo o sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Grande é a glória dele",
          "por causa da tua salvação;",
          "de esplendor e majestade",
          "o cobriste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pois o puseste por bênção",
          "para sempre",
          "e o encheste de alegria",
          "com a tua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O rei confia no Senhor",
          "e pela misericórdia do Altíssimo",
          "jamais vacilará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A mão dele alcançará",
          "todos os seus inimigos,",
          "a sua mão direita apanhará",
          "os que o odeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tu os farás",
          "como uma fornalha ardente,",
          "quando te manifestares;",
          "o Senhor, na sua indignação,",
          "os consumirá,",
          "o fogo os devorará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Destruirás da terra",
          "a sua posteridade",
          "e a sua descendência,",
          "de entre os filhos dos homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Se contra ti planejarem o mal",
          "e armarem ciladas,",
          "não obterão êxito;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "porque tu os porás em fuga",
          "e mirarás o rosto deles",
          "com o teu arco."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Exalta-te, Senhor, na tua força!",
          "Nós cantaremos",
          "e louvaremos o teu poder."
        ],
        "rlw_lines": []
      }
    ]
  },
