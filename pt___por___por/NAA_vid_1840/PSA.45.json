    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Ungido de Deus e a sua noiva"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “Os lírios”. Dos filhos de Corá. Salmo didático. Cântico de amor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O meu coração transborda",
          "de belas palavras.",
          "Ao rei consagro o que compus;",
          "a minha língua é como a pena",
          "de um hábil escritor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O senhor, ó rei, é o mais formoso",
          "dos filhos dos homens;",
          "a graça se extravasou",
          "nos seus lábios;",
          "por isso, Deus o abençoou",
          "para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cinja a espada no seu flanco,",
          "herói;",
          "cinja a sua glória",
          "e a sua majestade!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "E nessa majestade",
          "cavalgue vitoriosamente,",
          "pela causa da verdade",
          "e da justiça;",
          "e a sua mão direita",
          "lhe ensinará proezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "As suas flechas são afiadas",
          "e penetram o coração",
          "dos inimigos do rei;",
          "os povos caem submissos",
          "aos seus pés."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O teu trono, ó Deus,",
          "é para todo o sempre;",
          "cetro de justiça",
          "é o cetro do teu reino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O senhor, ó rei, ama a justiça",
          "e odeia a iniquidade;",
          "por isso, Deus, o seu Deus, o ungiu",
          "com o óleo de alegria,",
          "como a nenhum",
          "dos seus companheiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Todas as suas roupas cheiram",
          "a mirra, aloés e cássia;",
          "de palácios de marfim ressoam",
          "instrumentos de cordas",
          "que o alegram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Filhas de reis se encontram",
          "entre as suas damas de honra;",
          "à sua direita está a rainha",
          "enfeitada com ouro",
          "finíssimo de Ofir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ouça, filha,",
          "olhe e preste atenção:",
          "esqueça o seu povo",
          "e a casa de seu pai."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Então o rei ficará encantado",
          "com a sua formosura;",
          "por ser ele o seu senhor,",
          "incline-se diante dele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A filha de Tiro virá",
          "trazendo presentes;",
          "os mais ricos do povo",
          "lhe pedirão favores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "A filha do rei é toda formosura",
          "no interior do palácio;",
          "os seus vestidos",
          "são enfeitados de ouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Em roupas bordadas",
          "conduzem-na diante do rei;",
          "as virgens, suas companheiras",
          "que a seguem,",
          "serão trazidas à sua presença,",
          "ó rei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Serão conduzidas",
          "com alegria e regozijo;",
          "entrarão no palácio do rei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Em lugar de seus pais,",
          "estarão os seus filhos,",
          "colocados como príncipes",
          "por toda a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Farei com que o seu nome",
          "seja celebrado",
          "de geração em geração,",
          "e, assim, os povos o louvarão",
          "para todo o sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
