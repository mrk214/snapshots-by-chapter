    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A promessa de Deus a Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo didático de Etã, ezraíta"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantarei para sempre",
          "as tuas misericórdias,",
          "ó Senhor;",
          "os meus lábios proclamarão",
          "a todas as gerações",
          "a tua fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pois eu disse: “A misericórdia",
          "está edificada para sempre;",
          "a tua fidelidade,",
          "tu a confirmarás nos céus.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tu disseste: “Fiz uma aliança",
          "com o meu escolhido",
          "e jurei a Davi, meu servo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "‘Para sempre estabelecerei",
          "a sua posteridade",
          "e firmarei o seu trono",
          "de geração em geração.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os céus celebram",
          "as tuas maravilhas,",
          "ó Senhor,",
          "e, na assembleia dos santos,",
          "louvam a tua fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Pois quem nos céus",
          "é comparável ao Senhor?",
          "Entre os seres celestiais,",
          "quem é semelhante ao Senhor?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Deus infunde grande terror",
          "na assembleia dos santos;",
          "é temível sobre todos",
          "os que o rodeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ó Senhor, Deus dos Exércitos,",
          "quem é poderoso",
          "como tu és, Senhor,",
          "com a tua fidelidade",
          "ao redor de ti?!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dominas a fúria do mar;",
          "quando as suas ondas se levantam,",
          "tu as acalmas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Esmagaste o monstro Raabe",
          "e o mataste;",
          "com o teu braço forte",
          "dispersaste os teus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Teus são os céus, e tua é a terra;",
          "o mundo e a sua plenitude,",
          "tu os estabeleceste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O Norte e o Sul, tu os criaste;",
          "o Tabor e o Hermom",
          "exultam em teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O teu braço é poderoso;",
          "forte é a tua mão,",
          "e elevada é a tua mão direita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Justiça e direito",
          "são o fundamento",
          "do teu trono;",
          "graça e verdade te precedem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Bem-aventurado o povo",
          "que conhece",
          "os gritos de alegria,",
          "que anda, ó Senhor,",
          "na luz da tua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Em teu nome se alegra o dia todo",
          "e na tua justiça se exalta,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "porque tu és a glória",
          "de sua força;",
          "no teu favor é exaltado",
          "o nosso poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pois ao Senhor pertence",
          "o nosso escudo,",
          "e ao Santo de Israel, o nosso rei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Outrora falaste em visão",
          "aos teus santos e disseste:",
          "“A um herói concedi",
          "o poder de socorrer;",
          "do meio do povo,",
          "exaltei um escolhido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Encontrei Davi, meu servo;",
          "com o meu santo óleo o ungi."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "A minha mão estará",
          "sempre com ele,",
          "o meu braço o fortalecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "O inimigo jamais o surpreenderá,",
          "nem será ele humilhado",
          "pelo filho da perversidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Esmagarei diante dele",
          "os seus adversários",
          "e destruirei aqueles que o odeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "A minha fidelidade",
          "e a minha bondade",
          "o acompanharão,",
          "e em meu nome crescerá",
          "o seu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Porei a sua mão sobre o mar",
          "e a sua direita, sobre os rios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Ele me invocará, dizendo:",
          "‘Tu és o meu pai,",
          "meu Deus e a rocha",
          "da minha salvação.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Por isso, farei dele",
          "o meu primogênito,",
          "o mais elevado",
          "entre os reis da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Conservarei para sempre",
          "a minha bondade para com ele",
          "e lhe confirmarei a minha aliança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Farei durar para sempre",
          "a sua descendência;",
          "e o seu trono ficará firme",
          "enquanto o céu existir.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "“Se os filhos dele",
          "desprezarem a minha lei",
          "e não andarem nos meus juízos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "se violarem os meus preceitos",
          "e não guardarem",
          "os meus mandamentos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "então punirei com vara",
          "as suas transgressões",
          "e com açoites, a sua iniquidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Mas jamais retirarei dele",
          "a minha bondade,",
          "nem desmentirei",
          "a minha fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Não violarei a minha aliança,",
          "nem modificarei o que",
          "os meus lábios prometeram.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "“Uma vez jurei",
          "por minha santidade",
          "que nunca mentiria a Davi."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "A sua posteridade",
          "durará para sempre,",
          "e o seu trono,",
          "como o sol diante de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Ele será estabelecido",
          "para sempre como a lua",
          "e fiel como a testemunha",
          "nos céus.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Tu, porém, o repudiaste",
          "e o rejeitaste;",
          "e te indignaste com o teu ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Quebraste a aliança",
          "com o teu servo;",
          "profanaste a sua coroa,",
          "jogando-a no chão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Arrasaste",
          "todas as suas muralhas;",
          "reduziste a ruínas",
          "as suas fortificações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Todos os que passam",
          "pelo caminho o saqueiam;",
          "ele se tornou objeto de deboche",
          "para os vizinhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Exaltaste a mão direita",
          "dos seus adversários",
          "e deste alegria",
          "a todos os seus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Deixaste sem fio a sua espada",
          "e não o sustentaste na batalha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Fizeste cessar o seu esplendor",
          "e deitaste por terra o seu trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Abreviaste",
          "os dias da sua mocidade",
          "e o cobriste de vergonha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Até quando, Senhor?",
          "Ficarás escondido para sempre?",
          "Até quando a tua ira",
          "queimará como fogo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Lembra-te de como é breve",
          "a minha existência!",
          "Terias criado em vão",
          "todos os filhos dos homens?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Quem é que pode viver",
          "e não ver a morte?",
          "Ou quem pode livrar a sua alma",
          "do poder da sepultura?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Senhor, onde estão",
          "as tuas misericórdias de outrora,",
          "juradas a Davi por tua fidelidade?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Lembra-te, Senhor, dos insultos",
          "contra os teus servos",
          "e de como trago no peito",
          "a injúria de muitos povos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "com que os teus inimigos,",
          "Senhor, têm insultado,",
          "sim, insultado",
          "os passos do teu ungido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Bendito seja o Senhor",
          "para sempre!",
          "Amém e amém!"
        ],
        "rlw_lines": []
      }
    ]
  },
