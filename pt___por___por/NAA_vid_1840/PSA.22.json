    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Um grito de angústia e um salmo de louvor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “Corça da manhã”. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deus meu, Deus meu,",
          "por que me desamparaste?",
          "Por que se acham longe",
          "de minha salvação",
          "as palavras de meu gemido?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deus meu, clamo de dia,",
          "e não me respondes;",
          "também de noite,",
          "porém não tenho sossego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Contudo, tu és santo,",
          "entronizado entre os louvores",
          "de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Nossos pais confiaram em ti;",
          "confiaram, e tu os livraste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A ti clamaram e escaparam;",
          "confiaram em ti",
          "e não foram envergonhados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Mas eu sou verme",
          "e não um ser humano;",
          "afrontado pelos homens",
          "e desprezado pelo povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todos os que me veem",
          "zombam de mim;",
          "fazem caretas e balançam",
          "a cabeça, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Confiou no Senhor!",
          "Ele que o livre!",
          "Salve-o, pois nele tem prazer.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Contudo, tu és quem",
          "me fez nascer;",
          "e me preservaste,",
          "estando eu ainda",
          "ao seio de minha mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A ti me entreguei",
          "desde o meu nascimento;",
          "desde o ventre de minha mãe,",
          "tu és o meu Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Não te distancies de mim,",
          "porque a tribulação está próxima,",
          "e não há quem me ajude."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Muitos touros me cercam,",
          "fortes touros de Basã me rodeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Contra mim abrem a boca,",
          "como faz o leão",
          "que despedaça e ruge."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Derramei-me como água,",
          "e todos os meus ossos",
          "se desconjuntaram;",
          "meu coração fez-se como cera,",
          "derreteu-se dentro de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Secou-se o meu vigor,",
          "como um caco de barro,",
          "e a língua se me apega",
          "ao céu da boca;",
          "assim, me deitas no pó da morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Cães me cercam;",
          "um bando de malfeitores",
          "me rodeia;",
          "traspassaram-me as mãos e os pés."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Posso contar",
          "todos os meus ossos;",
          "os meus inimigos",
          "estão olhando para mim",
          "e me encarando."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Repartem entre si",
          "as minhas roupas",
          "e sobre a minha túnica",
          "lançam sortes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Tu, porém, Senhor,",
          "não te afastes de mim;",
          "força minha, apressa-te",
          "em me socorrer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Livra a minha alma da espada,",
          "e, das presas do cão, a minha vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Salva-me da boca do leão",
          "e dos chifres dos búfalos;",
          "sim, tu me respondes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "A meus irmãos declararei",
          "o teu nome;",
          "no meio da congregação",
          "eu te louvarei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Louvem o Senhor,",
          "vocês que o temem;",
          "glorifiquem-no, todos vocês,",
          "descendência de Jacó;",
          "temam-no, todos vocês,",
          "posteridade de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Porque não desprezou",
          "nem detestou",
          "a dor do aflito,",
          "nem ocultou dele o seu rosto,",
          "mas o ouviu, quando lhe gritou",
          "por socorro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "De ti vem o meu louvor",
          "na grande congregação;",
          "cumprirei os meus votos",
          "na presença dos que o temem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Os sofredores hão de comer",
          "e fartar-se;",
          "louvarão o Senhor",
          "aqueles que o buscam.",
          "Que o coração de vocês",
          "viva para sempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Os confins da terra",
          "se lembrarão do Senhor",
          "e a ele se converterão;",
          "diante dele se prostrarão",
          "todas as famílias das nações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Pois do Senhor é o reino,",
          "é ele quem governa as nações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Todos os ricos da terra",
          "hão de comer e adorar,",
          "e todos os que descem ao pó",
          "se prostrarão diante dele,",
          "até aquele que não pode",
          "preservar a própria vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "A posteridade o servirá,",
          "e se falará do Senhor",
          "à geração vindoura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Virão e anunciarão a justiça dele;",
          "ao povo que há de nascer,",
          "contarão que foi ele",
          "quem o fez."
        ],
        "rlw_lines": []
      }
    ]
  },
