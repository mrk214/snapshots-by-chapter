    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O reino e o sacerdócio do Messias"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Disse o Senhor",
          "ao meu senhor:",
          "“Sente-se à minha direita,",
          "até que eu ponha os seus inimigos",
          "por estrado dos seus pés.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O Senhor lhe enviará de Sião",
          "o cetro do poder,",
          "dizendo: “Domine",
          "entre os seus inimigos.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O seu povo se apresentará",
          "voluntariamente,",
          "no dia em que você manifestar",
          "o seu poder;",
          "com santos ornamentos,",
          "como o orvalho do alvorecer,",
          "virão os seus jovens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O Senhor jurou",
          "e não voltará atrás:",
          "“Você é sacerdote para sempre,",
          "segundo a ordem",
          "de Melquisedeque.”"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor, à sua direita,",
          "no dia em que se irar,",
          "esmagará os reis."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ele julgará entre as nações,",
          "enchendo-as de cadáveres;",
          "esmagará cabeças por toda a terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "No caminho,",
          "beberá água na torrente",
          "e passará de cabeça erguida."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
