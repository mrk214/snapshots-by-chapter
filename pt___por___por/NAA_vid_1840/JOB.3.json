    "items": [
      {
        "type": "section1",
        "verse_numbers": [],
        "lines": [
          "Primeiro diálogo"
        ],
        "rlw_lines": []
      },
      {
        "type": "section2",
        "verse_numbers": [],
        "lines": [
          "Caps.3—14"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A queixa de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Jó amaldiçoa o seu nascimento"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Depois disto, Jó passou a falar e amaldiçoou o dia do seu nascimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Jó disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "“Pereça o dia em que nasci",
          "e a noite em que se disse:",
          "‘Foi concebido um homem!’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Que aquele dia",
          "se transforme em trevas,",
          "e Deus, lá de cima,",
          "não se importe com ele,",
          "nem resplandeça sobre ele a luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que as trevas",
          "e a sombra da morte",
          "se apoderem desse dia;",
          "que uma nuvem habite sobre ele;",
          "que tudo o que pode",
          "escurecer o dia o espante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Aquela noite,",
          "que dela se apoderem",
          "densas trevas;",
          "que ela não se alegre",
          "entre os dias do ano,",
          "nem entre na conta dos meses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sim, que seja estéril aquela noite,",
          "e dela sejam banidos",
          "os gritos de alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Amaldiçoem-na",
          "aqueles que sabem",
          "amaldiçoar o dia",
          "e sabem instigar o Leviatã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Escureçam-se as estrelas",
          "do seu alvorecer;",
          "que a noite espere a luz,",
          "e a luz não venha;",
          "que não veja",
          "o despontar da alvorada,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "pois não fechou as portas",
          "do ventre da minha mãe,",
          "nem escondeu dos meus olhos",
          "o sofrimento.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Por que não morri ao nascer?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Por que não morri ao nascer?",
          "Por que não expirei",
          "ao sair do ventre",
          "de minha mãe?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Por que houve um colo",
          "que me acolhesse,",
          "e seios, para que eu mamasse?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Porque agora",
          "eu repousaria tranquilo;",
          "dormiria, e então haveria",
          "para mim descanso,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "com os reis e conselheiros",
          "da terra",
          "que construíram para si",
          "mausoléus;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "ou com os príncipes",
          "que tinham ouro",
          "e encheram as suas casas de prata;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "ou, como aborto oculto,",
          "eu não existiria,",
          "como crianças",
          "que nunca viram a luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ali os maus cessam de perturbar,",
          "e ali repousam os cansados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ali os presos juntamente",
          "repousam",
          "e não ouvem a voz do capataz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ali está tanto o pequeno",
          "como o grande,",
          "e o servo fica livre de seu senhor.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Por que o miserável continua vivendo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "“Por que se concede",
          "luz ao miserável",
          "e vida aos de coração amargurado,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "que esperam a morte,",
          "e ela não vem,",
          "que cavam em procura dela",
          "mais do que",
          "tesouros ocultos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "que se alegrariam",
          "por um túmulo",
          "e exultariam se achassem",
          "a sepultura?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Por que se concede",
          "luz ao homem",
          "cujo caminho é oculto,",
          "e a quem Deus cercou",
          "de todos os lados?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "“Porque em vez do meu pão",
          "me vêm gemidos,",
          "e os meus lamentos",
          "se derramam como água."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Aquilo que temo me sobrevém,",
          "e o que receio me acontece."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Não tenho descanso,",
          "não tenho sossego,",
          "não tenho repouso;",
          "só tenho inquietação.”"
        ],
        "rlw_lines": []
      }
    ]
  },
