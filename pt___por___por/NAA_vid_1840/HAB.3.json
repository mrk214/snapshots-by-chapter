      "human": "Sofonias 1"
    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A oração de Habacuque"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oração do profeta Habacuque sob a forma de canto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Senhor, tenho ouvido a tua fama,",
          "e me sinto alarmado.",
          "Aviva a tua obra, ó Senhor,",
          "no decorrer dos anos,",
          "e, no decurso dos anos,",
          "faze-a conhecida.",
          "Na tua ira, lembra-te",
          "da misericórdia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Deus vem de Temã,",
          "o Santo vem do monte Parã.",
          "A sua glória cobre os céus,",
          "e a terra se enche do seu louvor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O seu resplendor é como a luz,",
          "e raios brilham da sua mão;",
          "o seu poder se esconde ali."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Adiante dele vai a peste,",
          "e a pestilência",
          "segue os seus passos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ele para e faz a terra tremer;",
          "olha e sacode as nações.",
          "Esmigalham-se",
          "os montes primitivos;",
          "as colinas antigas se abatem.",
          "Os caminhos de Deus são eternos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Vejo as tendas de Cusã",
          "em aflição;",
          "os acampamentos",
          "da terra de Midiã tremem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Acaso é contra os rios, Senhor,",
          "que estás irado?",
          "É contra os ribeiros a tua ira",
          "ou contra o mar, o teu furor,",
          "já que andas montado",
          "nos teus cavalos,",
          "nos teus carros de vitória?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Preparas o teu arco;",
          "a tua aljava está cheia de flechas.",
          "Tu fendes a terra com rios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os montes te veem",
          "e se contorcem;",
          "torrentes de água passam.",
          "As profundezas do mar",
          "fazem ouvir a sua voz",
          "e levantam bem alto as suas mãos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O sol e a lua param",
          "nas suas moradas,",
          "ao resplandecer a luz",
          "das tuas flechas sibilantes,",
          "ao fulgor do relâmpago",
          "da tua lança."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Na tua indignação,",
          "marchas pela terra;",
          "na tua ira, pisas as nações."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tu sais para salvar o teu povo,",
          "para salvar o teu ungido.",
          "Feres o chefe da casa dos ímpios,",
          "deixando-o descoberto",
          "dos pés à cabeça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Traspassas a cabeça",
          "dos guerreiros do inimigo",
          "com as suas próprias lanças,",
          "os quais, como tempestade,",
          "avançam para me destruir;",
          "alegram-se, como se estivessem",
          "para devorar o pobre",
          "em segredo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Marchas com os teus cavalos",
          "pelo mar,",
          "pela massa de grandes águas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ouvi isso, e o meu íntimo",
          "se comoveu;",
          "os meus lábios tremeram",
          "ao ouvir a sua voz.",
          "A podridão entrou nos meus ossos,",
          "e os meus joelhos vacilaram,",
          "pois, em silêncio, devo esperar",
          "o dia da angústia,",
          "que virá contra o povo",
          "que nos ataca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ainda que a figueira",
          "não floresça,",
          "nem haja fruto na videira;",
          "ainda que a colheita da oliveira",
          "decepcione,",
          "e os campos não produzam",
          "mantimento;",
          "ainda que as ovelhas",
          "desapareçam do aprisco,",
          "e nos currais não haja mais gado,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "mesmo assim",
          "eu me alegro no Senhor,",
          "e exulto no Deus",
          "da minha salvação."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Deus, o Senhor,",
          "é a minha fortaleza.",
          "Ele dá aos meus pés",
          "a ligeireza das corças,",
          "e me faz andar",
          "nas minhas alturas.",
          "Ao mestre de canto. Para instrumentos de cordas."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
