    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Um grito de angústia"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “Os lírios”. De Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Salva-me, ó Deus,",
          "porque as águas me sobem",
          "até a alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Estou atolado",
          "num profundo lamaçal,",
          "que não dá pé.",
          "Entrei em águas profundas,",
          "e estou sendo arrastado",
          "pela correnteza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Estou cansado de clamar,",
          "e a minha garganta secou;",
          "os meus olhos esmorecem",
          "de tanto esperar por meu Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os que, sem razão, me odeiam",
          "são mais numerosos",
          "do que os cabelos",
          "da minha cabeça;",
          "são poderosos os que querem",
          "me destruir,",
          "os que com falsos motivos",
          "são meus inimigos;",
          "por isso, tenho de restituir",
          "o que não roubei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu, ó Deus, bem conheces",
          "a minha insensatez,",
          "e as minhas culpas",
          "não te são ocultas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não sejam envergonhados",
          "por minha causa",
          "os que esperam em ti,",
          "ó Senhor, Deus dos Exércitos;",
          "nem por minha causa",
          "sofram vexame",
          "os que te buscam,",
          "ó Deus de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pois tenho suportado afrontas",
          "por amor de ti,",
          "e o meu rosto se cobre",
          "de vergonha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tornei-me um estranho",
          "para os meus irmãos",
          "e um desconhecido para os filhos",
          "da minha mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pois o zelo da tua casa",
          "me consumiu,",
          "e as ofensas dos que te insultam",
          "caem sobre mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Chorei, jejuei,",
          "mas até isto se tornou motivo",
          "de deboche para mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pus um pano de saco por roupa",
          "e me tornei motivo de provérbio",
          "para eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Os que se assentam",
          "junto ao portão da cidade",
          "falam de mim,",
          "e sou motivo para cantigas",
          "de bêbados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Quanto a mim, porém, Senhor,",
          "faço a ti, em tempo favorável,",
          "a minha oração.",
          "Responde-me, ó Deus,",
          "pela riqueza da tua graça.",
          "Pela tua fidelidade em socorrer,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "livra-me do lamaçal,",
          "para que eu não me afunde;",
          "que eu seja salvo",
          "dos que me odeiam",
          "e das profundezas das águas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Não deixes que",
          "a corrente das águas",
          "me arraste,",
          "nem que as profundezas do abismo",
          "me engulam,",
          "nem que se feche sobre mim",
          "a boca do poço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Responde-me, Senhor,",
          "pois compassiva é a tua graça;",
          "volta-te para mim",
          "segundo a riqueza",
          "das tuas misericórdias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Não escondas o rosto",
          "ao teu servo,",
          "pois estou angustiado;",
          "responde-me depressa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Aproxima-te de minha alma",
          "e redime-a;",
          "resgata-me por causa",
          "dos meus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Tu conheces a minha afronta,",
          "a minha vergonha e o meu vexame;",
          "todos os meus adversários",
          "estão à tua vista."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "As afrontas partiram",
          "o meu coração,",
          "e desfaleci.",
          "Esperei por piedade,",
          "mas foi em vão.",
          "Esperei por consoladores,",
          "mas não apareceu ninguém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Por alimento me deram fel",
          "e na minha sede",
          "me deram a beber vinagre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Que a mesa deles se torne",
          "em laço diante deles,",
          "e a prosperidade, em armadilha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Que os olhos deles se escureçam,",
          "para que não vejam;",
          "e faze com que as suas costas",
          "não parem de tremer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Derrama sobre eles",
          "a tua indignação,",
          "e que o furor da tua ira os alcance."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Fique deserta a sua morada,",
          "e não haja quem habite",
          "nas suas tendas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Pois perseguem a quem tu feriste",
          "e ficam falando",
          "sobre as dores daqueles",
          "a quem golpeaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Soma-lhes iniquidade",
          "à iniquidade,",
          "e que não tenham acesso",
          "à tua justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Sejam riscados",
          "do Livro dos Vivos",
          "e não sejam incluídos",
          "na lista dos justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Quanto a mim, porém,",
          "estou sofrendo e aflito;",
          "que a tua salvação, ó Deus,",
          "me ponha num alto refúgio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Louvarei com cânticos",
          "o nome de Deus;",
          "quero exaltá-lo",
          "com ações de graças."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Isso será muito mais agradável",
          "ao Senhor",
          "do que um boi ou um novilho",
          "com chifres e cascos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Que os aflitos vejam isso",
          "e se alegrem;",
          "quanto a vocês",
          "que buscam a Deus,",
          "que o seu coração se reanime."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Porque o Senhor",
          "ouve os necessitados",
          "e não despreza os seus prisioneiros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Louvem-no os céus e a terra,",
          "os mares e tudo",
          "o que neles se move."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Porque Deus salvará Sião",
          "e edificará as cidades de Judá;",
          "habitarão ali",
          "e tomarão posse de Sião."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Também a descendência",
          "dos seus servos a herdará,",
          "e nela habitarão os que amam",
          "o nome de Deus."
        ],
        "rlw_lines": []
      }
    ]
  },
