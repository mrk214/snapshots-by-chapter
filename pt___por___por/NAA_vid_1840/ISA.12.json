    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cântico de louvor pela restauração de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Naquele dia, você dirá:",
          "“Graças te dou, ó Senhor,",
          "porque, ainda que te iraste",
          "contra mim,",
          "a tua ira se retirou,",
          "e tu me consolas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Eis que Deus é a minha salvação;",
          "confiarei e não temerei,",
          "porque o Senhor Deus",
          "é a minha força e o meu cântico;",
          "ele se tornou a minha salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Com alegria, vocês tirarão água",
          "das fontes da salvação.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Naquele dia, vocês dirão:",
          "“Deem graças ao Senhor,",
          "invoquem o seu nome;",
          "tornem conhecidos entre os povos",
          "os seus feitos,",
          "anunciem que é excelso",
          "o seu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Cantem louvores ao Senhor,",
          "porque ele fez coisas grandiosas;",
          "saiba-se isto em toda a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Exultem e gritem de alegria,",
          "ó moradores de Sião,",
          "porque grande é o Santo de Israel",
          "no meio de vocês.”"
        ],
        "rlw_lines": []
      }
    ]
  },
