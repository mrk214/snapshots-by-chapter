    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O castigo está próximo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "“Toque a trombeta!",
          "Ele vem como a águia",
          "contra a casa do Senhor,",
          "porque transgrediram",
          "a minha aliança",
          "e se rebelaram contra a minha lei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Eles me invocam, dizendo:",
          "‘Nosso Deus!",
          "Nós, Israel, te conhecemos.’"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mas Israel rejeitou o que é bom;",
          "o inimigo o perseguirá.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "“Eles estabeleceram reis,",
          "mas não da minha parte;",
          "constituíram príncipes,",
          "mas eu não o soube.",
          "Com a sua prata e com o seu ouro",
          "fizeram ídolos para si,",
          "para a sua própria destruição."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O seu bezerro, ó Samaria,",
          "é rejeitado.",
          "A minha ira se acende contra eles.",
          "Até quando eles serão incapazes",
          "da inocência?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque esse bezerro",
          "vem de Israel;",
          "é obra de artífice, não é Deus.",
          "Esse bezerro de Samaria",
          "será quebrado em pedaços.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "“Porque semeiam ventos",
          "e colherão tempestades.",
          "O cereal que estiver por ser colhido",
          "não terá espigas,",
          "e não haverá farinha;",
          "e, se houver, os estrangeiros",
          "a comerão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Israel foi devorado.",
          "Agora está entre as nações",
          "como coisa de que ninguém",
          "se agrada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque foram pedir ajuda",
          "à Assíria,",
          "como um jumento selvagem",
          "que segue o seu próprio rumo.",
          "Efraim contratou amantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todavia, ainda que contratem",
          "amantes entre as nações",
          "para socorrê-los,",
          "eu os reunirei para juízo.",
          "Já começaram a definhar",
          "sob a opressão do poderoso rei.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Visto que Efraim multiplicou",
          "altares para pecar,",
          "estes altares lhe serviram",
          "para pecar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Embora eu lhe escreva",
          "a minha lei",
          "em dez mil preceitos,",
          "estes seriam tidos",
          "como coisa estranha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Amam o sacrifício;",
          "por isso, sacrificam,",
          "pois gostam de carne e a comem,",
          "mas o Senhor não os aceita.",
          "Agora ele se lembrará",
          "da iniquidade deles",
          "e castigará os pecados",
          "que cometeram.",
          "Vou mandá-los de volta",
          "para o Egito!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Porque Israel se esqueceu",
          "do seu Criador",
          "e edificou palácios,",
          "e Judá multiplicou",
          "cidades fortificadas;",
          "mas eu enviarei fogo",
          "contra as suas cidades,",
          "fogo que consumirá",
          "os seus palácios.”"
        ],
        "rlw_lines": []
      }
    ]
  },
