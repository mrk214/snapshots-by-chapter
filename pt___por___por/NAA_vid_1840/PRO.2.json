    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A excelência da sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Meu filho, se você aceitar",
          "as minhas palavras",
          "e guardar no seu coração",
          "os meus mandamentos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "se você der ouvidos",
          "à sabedoria",
          "e inclinar o seu coração",
          "ao entendimento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "sim, se você pedir inteligência",
          "e gritar por entendimento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "se buscar a sabedoria",
          "como a prata",
          "e a procurar como se procuram",
          "tesouros escondidos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "então você entenderá",
          "o temor do Senhor",
          "e achará o conhecimento de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque o Senhor dá a sabedoria,",
          "e da sua boca vem o conhecimento",
          "e a inteligência."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele reserva a verdadeira",
          "sabedoria para os retos;",
          "é escudo para os que andam",
          "com integridade,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "guardando as veredas da justiça",
          "e conservando o caminho",
          "dos seus santos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Então você entenderá",
          "a justiça, o juízo",
          "e a equidade — todas",
          "as boas veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porque a sabedoria",
          "entrará no seu coração,",
          "e o conhecimento",
          "será agradável à sua alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O discernimento o guardará",
          "e o entendimento o protegerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A sabedoria o livrará",
          "do caminho do mal",
          "e do homem que diz",
          "coisas perversas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "dos que abandonam",
          "as veredas da retidão,",
          "para andarem pelos caminhos",
          "das trevas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "dos que têm prazer",
          "em fazer o mal",
          "e se alegram com as perversidades",
          "dos maus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "cujas veredas são tortuosas",
          "e que se desviam",
          "em seus caminhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "A sabedoria também o livrará",
          "da mulher adúltera,",
          "da estranha que lisonjeia",
          "com palavras,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "que abandona o amigo",
          "da sua mocidade",
          "e se esquece da aliança",
          "do seu Deus;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "porque a casa dela",
          "se inclina para a morte,",
          "e as suas veredas conduzem",
          "para o mundo dos mortos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Todos os que se dirigem",
          "a essa mulher não voltarão",
          "e não encontrarão",
          "as veredas da vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Tendo a sabedoria, você andará",
          "pelo caminho",
          "dos homens de bem",
          "e guardará as veredas dos justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Porque os retos",
          "habitarão a terra,",
          "e os íntegros permanecerão nela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Mas os perversos",
          "serão eliminados da terra,",
          "e os infiéis serão dela arrancados."
        ],
        "rlw_lines": []
      }
    ]
  },
