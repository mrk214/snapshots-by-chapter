    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Defesa final de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Deus cuidava de mim"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Jó continuou em sua fala, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Ah! Quem me dera ser",
          "como fui nos meses passados,",
          "como nos dias em que Deus",
          "cuidava de mim!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quando Deus fazia resplandecer",
          "a sua lâmpada",
          "sobre a minha cabeça,",
          "quando eu, guiado por sua luz,",
          "caminhava na escuridão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Quem me dera ser como fui",
          "nos dias do meu vigor,",
          "quando a amizade de Deus",
          "estava sobre a minha tenda,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "quando o Todo-Poderoso",
          "ainda estava comigo,",
          "e os meus filhos",
          "estavam ao meu redor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "quando eu lavava",
          "os meus pés em leite,",
          "e da rocha me corriam",
          "rios de azeite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quando eu me dirigia",
          "até o portão da cidade",
          "e mandava preparar",
          "o meu assento na praça,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "os moços me viam",
          "e se retiravam,",
          "e os idosos se levantavam",
          "e ficavam em pé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os príncipes reprimiam",
          "as suas palavras",
          "e punham a mão sobre a boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A voz dos nobres emudecia,",
          "e a língua deles se apegava",
          "ao céu da boca.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Eu era pai dos necessitados"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“O ouvido que me ouvia",
          "dizia que eu era feliz;",
          "o olho que me via",
          "dava testemunho de mim,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "porque eu livrava os pobres",
          "que pediam ajuda",
          "e também o órfão que não tinha",
          "quem o socorresse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "A bênção do que estava",
          "prestes a perecer",
          "vinha sobre mim,",
          "e eu fazia o coração da viúva",
          "cantar de alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Eu me cobria de retidão,",
          "e ela me servia de roupa;",
          "a minha justiça era como",
          "um manto e um turbante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Eu era os olhos do cego",
          "e os pés do aleijado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Era pai dos necessitados",
          "e até as causas dos desconhecidos",
          "eu examinava."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Eu quebrava os queixos",
          "dos iníquos",
          "e arrancava as vítimas",
          "dos dentes deles.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading2",
        "verse_numbers": [],
        "lines": [
          "Todos esperavam o meu conselho"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "“Eu dizia: ‘Vou morrer",
          "no meu ninho,",
          "e multiplicarei os meus dias",
          "como a areia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "As minhas raízes se estenderão",
          "até as águas,",
          "e o orvalho ficará durante a noite",
          "sobre os meus ramos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "A minha honra",
          "se renovará em mim,",
          "e o meu arco se reforçará",
          "na minha mão.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "“Os que me ouviam",
          "esperavam o meu conselho",
          "e guardavam silêncio para ouvi-lo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Depois que eu falava,",
          "não diziam nada;",
          "as minhas palavras caíam",
          "sobre eles como orvalho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Esperavam-me",
          "como se espera a chuva,",
          "abriam a boca como para absorver",
          "a chuva fora de época."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Quando eu sorria para eles,",
          "nem acreditavam;",
          "e a luz do meu rosto",
          "eles não desprezavam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Eu escolhia o caminho para eles,",
          "assentava-me como chefe",
          "e vivia como rei",
          "entre as suas tropas;",
          "eu era como quem consola",
          "os que pranteiam.”"
        ],
        "rlw_lines": []
      }
    ]
  },
