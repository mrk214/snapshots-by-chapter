  "chapter": {
    "usfm": "ECC.10",
    "human": "Eclesiastes 10",
    "previous": {
      "usfm": "ECC.9",
      "human": "Eclesiastes 9"
    },
    "next": {
      "usfm": "ECC.11",
      "human": "Eclesiastes 11"
    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A excelência da sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Assim como a mosca morta",
          "faz o óleo do perfumador",
          "exalar mau cheiro,",
          "assim também uma pequena tolice",
          "pode ter mais peso",
          "do que a sabedoria e a honra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O coração do sábio",
          "se inclina para o bem,",
          "mas o coração do tolo",
          "se inclina para o mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quando o tolo vai pelo caminho,",
          "falta-lhe o entendimento;",
          "e, assim, mostra a todos",
          "que é mesmo um tolo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Se aquele que governa",
          "ficar indignado contra você,",
          "não deixe o seu lugar,",
          "porque o ânimo sereno",
          "acalma grandes ofensas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ainda há um mal que vi debaixo do sol, um erro cometido pelos que governam:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "os tolos colocados em muitos postos elevados, enquanto os ricos ocupam os postos inferiores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Vi servos andando a cavalo e príncipes andando a pé como se fossem servos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Quem abre uma cova",
          "acaba caindo nela,",
          "e quem arromba um muro",
          "será mordido por uma cobra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Quem arranca pedras",
          "será ferido por elas,",
          "e o que racha lenha",
          "se expõe ao perigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Se o machado está embotado",
          "e ninguém o afia,",
          "é preciso redobrar a força;",
          "mas com sabedoria",
          "se obtém êxito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Se a cobra morder",
          "antes de estar encantada,",
          "de nada adianta",
          "o trabalho do encantador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "As palavras do sábio",
          "lhe trazem favor,",
          "mas o tolo é destruído",
          "pelo que diz;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "as primeiras palavras",
          "de sua boca são tolice,",
          "e as últimas, loucura perversa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O tolo multiplica as palavras,",
          "mas o ser humano não sabe",
          "o que vai acontecer.",
          "Quem poderá lhe dizer",
          "o que será depois dele?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "O trabalho do tolo o fatiga,",
          "pois nem sabe ir à cidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ai de você, ó terra",
          "cujo rei é criança",
          "e cujos príncipes se banqueteiam",
          "já de manhã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Feliz é você, ó terra",
          "cujo rei é filho de nobres",
          "e cujos príncipes se sentam",
          "à mesa a seu tempo",
          "para refazer as forças",
          "e não para se embriagar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Por causa da preguiça",
          "o teto desaba,",
          "e por causa dos braços cruzados",
          "a casa tem goteiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "As festas são feitas para rir,",
          "o vinho alegra a vida,",
          "e o dinheiro dá conta de tudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Nem em pensamento",
          "fale mal do rei,",
          "e não fale mal do rico",
          "nem mesmo quando você",
          "estiver sozinho em seu quarto,",
          "porque as aves do céu",
          "poderiam levar a sua voz,",
          "e o que tem asas",
          "poderia contar",
          "o que você falou."
        ],
        "rlw_lines": []
      }
    ]
  },
