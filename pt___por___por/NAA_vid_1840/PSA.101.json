    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Promessas de um rei"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantarei a respeito da bondade",
          "e da justiça;",
          "a ti, Senhor, cantarei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quero, com sabedoria, refletir",
          "no caminho da perfeição.",
          "Quando virás ao meu encontro?",
          "Em minha casa,",
          "andarei com sinceridade",
          "de coração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não porei coisa injusta",
          "diante dos meus olhos.",
          "Detesto a conduta",
          "dos que se desviam.",
          "Nada disto se pegará em mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Longe de mim o coração perverso;",
          "não quero conhecer o mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ao que às escondidas",
          "calunia o próximo,",
          "a esse destruirei;",
          "o que tem olhar arrogante",
          "e coração orgulhoso,",
          "não o suportarei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os meus olhos procurarão",
          "os fiéis da terra,",
          "para que morem comigo;",
          "o que anda em reto caminho,",
          "esse me servirá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Não ficará em minha casa",
          "o que usa de fraude;",
          "o que fala mentiras",
          "não permanecerá",
          "diante dos meus olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Manhã após manhã, destruirei",
          "todos os ímpios da terra,",
          "para limpar a cidade do Senhor",
          "dos que praticam a iniquidade."
        ],
        "rlw_lines": []
      }
    ]
  },
