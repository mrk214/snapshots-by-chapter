    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ciro, o libertador de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Assim diz o Senhor ao seu ungido,",
          "a Ciro, a quem tomo",
          "pela mão direita,",
          "para submeter as nações",
          "diante dele,",
          "para desarmar os reis,",
          "e para abrir diante dele os portões,",
          "que não se fecharão:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Eu irei adiante de você,",
          "endireitarei",
          "os caminhos tortuosos,",
          "quebrarei os portões de bronze",
          "e despedaçarei as trancas de ferro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Darei a você",
          "os tesouros escondidos",
          "e as riquezas encobertas,",
          "para que você saiba",
          "que eu sou o Senhor,",
          "o Deus de Israel,",
          "que o chama pelo seu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Por amor do meu servo Jacó",
          "e de Israel, meu escolhido,",
          "eu o chamei pelo seu nome",
          "e lhe dei um título de honra,",
          "mesmo que você não me conheça.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Eu sou o Senhor, e não há outro;",
          "além de mim não há Deus;",
          "eu o cingirei, mesmo que você",
          "não me conheça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Para que se saiba,",
          "desde o nascente do sol",
          "até o poente,",
          "que além de mim não há outro;",
          "eu sou o Senhor, e não há outro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Eu formo a luz e crio as trevas;",
          "promovo a paz e crio os conflitos;",
          "eu, o Senhor,",
          "faço todas estas coisas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "“Que os céus gotejem lá do alto,",
          "e as nuvens chovam justiça;",
          "que a terra se abra",
          "e produza a salvação,",
          "e juntamente com ela",
          "brote a justiça;",
          "eu, o Senhor, as criei.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Senhor é o Criador"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ai daquele que discute",
          "com o seu Criador,",
          "sendo um simples caco",
          "entre outros cacos de barro!",
          "Será que o barro",
          "pergunta ao oleiro:",
          "“O que você está fazendo?”",
          "Ou diz: “Este seu vaso",
          "não tem alça!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ai daquele que diz ao seu pai:",
          "“Por que você gerou?”",
          "E à sua mãe:",
          "“Por que você deu à luz?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Assim diz o Senhor,",
          "o Santo de Israel,",
          "que formou o seu povo:",
          "“Por acaso vocês querem saber",
          "as coisas futuras?",
          "Querem dar ordens",
          "a respeito de meus filhos",
          "e a respeito das obras",
          "das minhas mãos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eu fiz a terra e criei nela",
          "o ser humano;",
          "as minhas mãos",
          "estenderam os céus,",
          "e a todos os seus exércitos",
          "dei as minhas ordens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Eu, na minha justiça,",
          "suscitei Ciro",
          "e endireitarei",
          "todos os seus caminhos.",
          "Ele reconstruirá a minha cidade",
          "e libertará os meus exilados,",
          "não por preço nem por presentes”,",
          "diz o Senhor dos Exércitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Assim diz o Senhor:",
          "“A riqueza do Egito,",
          "as mercadorias da Etiópia",
          "e os sabeus, homens",
          "de grande estatura,",
          "lhe serão entregues e serão seus.",
          "Eles o seguirão,",
          "presos com correntes,",
          "se prostrarão diante de você",
          "e lhe farão as suas súplicas,",
          "dizendo:",
          "‘Certamente Deus está com você,",
          "e não há outro que seja Deus.’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Verdadeiramente tu és",
          "um Deus que se esconde,",
          "ó Deus de Israel, ó Salvador."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Ficarão envergonhados",
          "e serão humilhados",
          "todos os que fabricam ídolos;",
          "juntos ficarão cobertos",
          "de vergonha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Israel, porém, será salvo",
          "pelo Senhor",
          "com salvação eterna;",
          "vocês não serão envergonhados",
          "nem humilhados,",
          "por toda a eternidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Porque assim diz o Senhor,",
          "que criou os céus",
          "— e ele é o único Deus;",
          "que formou a terra e a fez —",
          "ele a estabeleceu;",
          "ele não a criou para ser um caos,",
          "mas para ser habitada:",
          "“Eu sou o Senhor, e não há outro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Não falei em segredo,",
          "nem em algum lugar escuro",
          "da terra;",
          "eu não disse à descendência",
          "de Jacó:",
          "‘Busquem-me em vão’;",
          "eu, o Senhor, falo a verdade",
          "e proclamo o que é direito.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Senhor e os ídolos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "“Reúnam-se e venham;",
          "aproximem-se todos juntos,",
          "vocês que escaparam das nações.",
          "Não sabem nada os que carregam",
          "as suas imagens de madeira",
          "e fazem súplicas a um deus",
          "que não pode salvar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Declarem e apresentem",
          "as suas razões.",
          "Que tomem conselho",
          "uns com os outros.",
          "Quem fez ouvir isto",
          "desde a antiguidade?",
          "Quem desde aquele tempo",
          "o anunciou?",
          "Será que não fui eu, o Senhor?",
          "Pois não há outro Deus,",
          "além de mim,",
          "Deus justo e Salvador",
          "não há além de mim.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "“Voltem-se para mim",
          "e sejam salvos,",
          "vocês, todos os confins da terra;",
          "porque eu sou Deus,",
          "e não há outro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Por mim mesmo tenho jurado;",
          "da minha boca saiu o que é justo,",
          "e a minha palavra",
          "não tornará atrás.",
          "Diante de mim se dobrará",
          "todo joelho,",
          "e jurará toda língua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "De mim se dirá:",
          "‘Tão somente no Senhor",
          "há justiça e força.’",
          "Até ele virão",
          "e serão envergonhados",
          "todos os que se irritarem",
          "contra ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Mas no Senhor será justificada",
          "toda a descendência de Israel",
          "e nele se gloriará.”"
        ],
        "rlw_lines": []
      }
    ]
  },
