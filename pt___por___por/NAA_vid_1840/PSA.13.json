    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração de fé"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Até quando, Senhor,",
          "te esquecerás de mim?",
          "Será para sempre?",
          "Até quando esconderás de mim",
          "o teu rosto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Até quando estarei relutando",
          "em minha alma,",
          "com tristeza no coração cada dia?",
          "Até quando o meu inimigo",
          "se exaltará sobre mim?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Olha para mim e responde-me,",
          "Senhor, meu Deus!",
          "Ilumina os meus olhos, para que",
          "eu não durma o sono da morte;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "para que o meu inimigo não diga:",
          "“Prevaleci contra ele”;",
          "e não se alegrem",
          "os meus adversários,",
          "se eu for abalado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quanto a mim,",
          "confio na tua graça;",
          "que o meu coração se alegre",
          "na tua salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cantarei ao Senhor,",
          "porque ele me tem feito",
          "muito bem."
        ],
        "rlw_lines": []
      }
    ]
  },
