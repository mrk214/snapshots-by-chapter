    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A oração de Jonas"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Então Jonas, do ventre do peixe, orou ao Senhor, seu Deus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "e disse:",
          "“Na minha angústia,",
          "clamei ao Senhor,",
          "e ele me respondeu;",
          "do ventre do abismo, gritei,",
          "e tu ouviste a minha voz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois me lançaste",
          "nas profundezas,",
          "no coração dos mares,",
          "e a corrente das águas me cercou;",
          "todas as tuas ondas e as tuas vagas",
          "passaram sobre mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Então eu disse:",
          "‘Estou excluído da tua presença;",
          "será que tornarei a ver",
          "o teu santo templo?’”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“As águas me cercaram",
          "até a alma,",
          "o abismo me rodeou;",
          "e as algas se enrolaram",
          "na minha cabeça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Desci até os fundamentos",
          "dos montes;",
          "desci até a terra,",
          "cujos ferrolhos se fecharam",
          "atrás de mim para sempre.",
          "Tu, porém, fizeste a minha vida",
          "subir da sepultura,",
          "ó Senhor, meu Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quando, dentro de mim,",
          "desfalecia a minha alma,",
          "eu me lembrei do Senhor;",
          "e subiu a ti a minha oração,",
          "no teu santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os que adoram ídolos vãos",
          "abandonam aquele",
          "que lhes é misericordioso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mas, com a voz",
          "do agradecimento,",
          "eu te oferecerei sacrifício;",
          "o que prometi cumprirei.",
          "Ao Senhor pertence a salvação!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "E o Senhor falou ao peixe, e este vomitou Jonas na terra."
        ],
        "rlw_lines": []
      }
    ]
  },
