    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração de um justo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Faze-me justiça, Senhor,",
          "pois tenho andado",
          "na minha integridade",
          "e confio no Senhor, sem vacilar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Examina-me, Senhor, e prova-me;",
          "sonda o meu coração",
          "e os meus pensamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois a tua misericórdia,",
          "tenho-a diante dos olhos",
          "e tenho andado na tua verdade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Não me tenho assentado",
          "com gente falsa",
          "e com os hipócritas",
          "não me associo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Detesto a assembleia",
          "dos malfeitores",
          "e com os ímpios não me assento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Lavo as mãos na inocência",
          "e, assim, andarei, Senhor,",
          "ao redor do teu altar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para entoar, com voz alta,",
          "os louvores",
          "e proclamar",
          "todas as tuas maravilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eu amo, Senhor,",
          "a habitação de tua casa",
          "e o lugar onde a tua glória reside."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não colhas a minha alma",
          "com a dos pecadores,",
          "nem a minha vida",
          "com a dos sanguinários,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "em cujas mãos há crimes",
          "e cuja mão direita",
          "está cheia de subornos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Quanto a mim, porém,",
          "ando na minha integridade;",
          "livra-me e tem compaixão de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O meu pé está firme",
          "em terreno plano;",
          "nas congregações,",
          "bendirei o Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
