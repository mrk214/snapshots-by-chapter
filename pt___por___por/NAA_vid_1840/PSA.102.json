{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.102","is_chapter":true,"previous":{"usfm":"PSA.101","human":"Salmos 101","canonical":true,"toc":true},"current":{"usfm":"PSA.102","human":"Salmos 102"},"next":{"usfm":"PSA.103","human":"Salmos 103","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Oração de um aflito"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["Oração do aflito que, desfalecido, derrama a sua queixa diante do Senhor"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Ouve, Senhor, a minha súplica,","e cheguem a ti os meus clamores."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Não escondas de mim o teu rosto","no dia da minha angústia;","inclina-me os ouvidos;","no dia em que eu clamar,","responde-me depressa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Porque os meus dias","desaparecem como fumaça,","e os meus ossos queimam","como se estivessem no fogo."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Cortado como a erva,","secou-se o meu coração;","até me esqueço","de comer o meu pão."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Os meus ossos","já se apegam à pele,","por causa do meu dolorido gemer."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Sou como o pelicano no deserto,","como a coruja das ruínas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Não durmo","e sou como o passarinho solitário","nos telhados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Os meus inimigos","me insultam a toda hora;","furiosos contra mim, praguejam","com o meu próprio nome."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Por pão tenho comido cinza","e as lágrimas se misturam","com a minha bebida,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["por causa da tua indignação","e da tua ira,","porque me elevaste","e depois me abateste."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Como a sombra que declina,","assim são os meus dias,","e eu vou secando como a relva."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Tu, porém, Senhor,","permaneces para sempre,","e a memória do teu nome,","de geração em geração."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Tu te levantarás","e terás piedade de Sião;","é tempo de te compadeceres dela,","e já chegou a sua hora."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Porque os teus servos","amam até as pedras de Sião","e se compadecem do seu pó."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Todas as nações","temerão o nome do Senhor,","e todos os reis da terra","temerão a sua glória,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["quando o Senhor reconstruir Sião","e se manifestar na sua glória,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["quando atender","à oração do desamparado","e não desprezar as suas preces."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Isto ficará registrado","para as gerações futuras,","e um povo, que há de ser criado,","louvará o Senhor, dizendo:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["“O Senhor, do alto","do seu santuário,","desde os céus, olhou para a terra,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["a fim de ouvir","o gemido dos cativos","e libertar os condenados à morte.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Em Sião será anunciado","o nome do Senhor","e o seu louvor, em Jerusalém,"],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["quando se reunirem","os povos e os reinos,","para servirem o Senhor."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Ele me abateu","a força no caminho","e abreviou os meus dias."],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["Eu disse: “Deus meu, não me leves","na metade de minha vida;","tu, cujos anos se estendem","por todas as gerações.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Em tempos remotos, lançaste","os fundamentos da terra;","e os céus são obra das tuas mãos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Eles perecerão,","mas tu permaneces;","todos eles envelhecerão","como veste,","como roupa os mudarás,","e serão mudados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["Tu, porém, és sempre o mesmo,","e os teus anos jamais terão fim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Os filhos dos teus servos","habitarão seguros,","e diante de ti se estabelecerá","a sua descendência."],"rlw_lines":[]}]}}