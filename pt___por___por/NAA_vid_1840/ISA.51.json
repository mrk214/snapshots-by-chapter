{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"ISA","name":"Isaías"},"chapter":{"chapter_usfm":"ISA.51","is_chapter":true,"previous":{"usfm":"ISA.50","human":"Isaías 50","canonical":true,"toc":true},"current":{"usfm":"ISA.51","human":"Isaías 51"},"next":{"usfm":"ISA.52","human":"Isaías 52","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Palavra de conforto para Sião"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["“Escutem, vocês que procuram","a justiça,","vocês que buscam o Senhor:","olhem para a rocha","da qual vocês foram cortados","e para a pedreira","de onde foram tirados."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Olhem para Abraão, seu pai,","e para Sara, que os deu à luz.","Porque Abraão era um só,","quando eu o chamei,","o abençoei e o multipliquei."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Porque o Senhor terá piedade","de Sião;","terá piedade de todos","os seus lugares desolados.","Fará o seu deserto como o Éden,","e os seus lugares áridos,","como o jardim do Senhor.","Ali haverá júbilo e alegria,","ações de graças e som de música.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["“Preste atenção, meu povo,","e escute, minha nação!","Porque de mim sairá a lei,","e estabelecerei o meu direito","como luz dos povos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Perto está a minha justiça,","a minha salvação já aparece,","e os meus braços","dominarão os povos.","As terras do mar me aguardam","e no meu braço esperam."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Levantem os olhos para os céus","e olhem para a terra,","aqui embaixo!","Porque os céus desaparecerão","como a fumaça,","e a terra envelhecerá","como a roupa;","os seus moradores morrerão","como mosquitos,","mas a minha salvação","durará para sempre,","e a minha justiça","não será anulada.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["“Escutem, vocês que conhecem","a justiça,","vocês, povo em cujo coração","está a minha lei:","não temam os insultos","dos homens,","nem fiquem assustados","por causa das suas zombarias."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Porque as traças os roerão","como fazem com a roupa,","e os bichos os comerão","como fazem com a lã.","Mas a minha justiça","durará para sempre,","e a minha salvação,","de geração em geração."],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Desperta! Desperta,","braço do Senhor,","e arma-te de força!","Desperta como nos dias passados,","como nas gerações antigas!","Não és tu aquele que cortou","Raabe em pedaços","e feriu o monstro marinho?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Não és tu aquele","que secou o mar,","as águas do grande abismo?","Não abriste um caminho no fundo do mar,","para que passassem os remidos?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Os resgatados do Senhor","voltarão","e entrarão em Sião","com cânticos de júbilo.","Alegria eterna coroará","a sua cabeça.","Ficarão tomados","de júbilo e alegria,","e deles fugirão","a tristeza e o gemido.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["“Eu, eu sou aquele","que os consola;","quem, então, é você,","para que tenha medo","do homem, que é mortal,","ou do filho do homem,","que não passa de erva?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Por que você se esquece","do Senhor, que o criou,","que estendeu os céus","e fundou a terra,","e todo o dia, sem cessar,","teme a fúria do opressor,","que se prepara para destruir?","Onde está a fúria do opressor?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["O exilado cativo depressa","será libertado,","lá não morrerá,","lá não descerá à sepultura;","o seu pão não lhe faltará.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["“Pois eu sou o Senhor, seu Deus,","que agito o mar,","de modo que bramem","as suas ondas.","O meu nome é","Senhor dos Exércitos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Confio a você as minhas palavras","e o protejo com a sombra","da minha mão,","para que eu estenda os céus,","firme a terra e diga a Sião:","‘Você é o meu povo.’”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["Acorde! Acorde e levante-se,","ó Jerusalém,","você que bebeu da mão do Senhor","o cálice da sua ira,","você que esgotou","o cálice de atordoamento."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["De todos os filhos que ela teve","nenhum a guiou;","de todos os filhos que criou","nenhum a tomou pela mão."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Estas duas coisas","lhe sobrevieram,","mas quem teve","compaixão de você?","Houve destruição e ruína,","fome e espada,","mas quem veio consolar você?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["Os seus filhos desmaiaram,","jazem nas esquinas","de todas as ruas,","como o antílope na rede.","Estão cheios da ira do Senhor","e da repreensão do seu Deus."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Por isso, agora escute isto,","você que está aflita e embriagada,","mas não de vinho."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Assim diz o seu Senhor,","o Senhor, seu Deus,","que defenderá a causa","do seu povo:","“Eis que eu tiro da sua mão","o cálice de atordoamento,","o cálice da minha ira.","Você nunca mais beberá dele."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Eu o porei nas mãos","dos que a atormentaram,","dos que lhe disseram:","‘Abaixe-se, para que passemos","por cima de você!’","E você pôs as suas costas","como chão","e como rua para os que passavam.”"],"rlw_lines":[]}]}}