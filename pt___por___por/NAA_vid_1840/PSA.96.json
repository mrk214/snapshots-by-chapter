    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvor à glória e à majestade de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantem ao Senhor",
          "um cântico novo,",
          "cantem ao Senhor,",
          "todas as terras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cantem ao Senhor,",
          "bendigam o seu nome;",
          "proclamem a sua salvação,",
          "dia após dia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Anunciem entre as nações",
          "a sua glória,",
          "entre todos os povos,",
          "as suas maravilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque o Senhor é grande",
          "e digno de ser louvado,",
          "mais temível",
          "do que todos os deuses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque todos os deuses dos povos",
          "não passam de ídolos;",
          "o Senhor, porém, fez os céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Glória e majestade",
          "estão diante dele,",
          "força e formosura,",
          "no seu santuário."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Deem ao Senhor,",
          "ó famílias dos povos,",
          "deem ao Senhor glória e força."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Deem ao Senhor",
          "a glória devida ao seu nome;",
          "tragam ofertas",
          "e entrem nos seus átrios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Adorem o Senhor",
          "na beleza da sua santidade;",
          "tremam diante dele,",
          "todas as terras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Digam entre as nações:",
          "“Reina o Senhor.”",
          "Ele firmou o mundo",
          "para que não se abale",
          "e julga os povos com justiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Alegrem-se os céus,",
          "e a terra exulte;",
          "ruja o mar e a sua plenitude."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Alegre-se o campo",
          "e tudo o que nele há;",
          "cantem de alegria",
          "todas as árvores do bosque,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "na presença do Senhor,",
          "porque vem, vem julgar a terra;",
          "julgará o mundo com justiça",
          "e os povos, de acordo",
          "com a sua fidelidade."
        ],
        "rlw_lines": []
      }
    ]
  },
