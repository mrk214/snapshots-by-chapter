    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvor ao verdadeiro Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Não a nós, Senhor, não a nós,",
          "mas ao teu nome dá glória,",
          "por amor da tua misericórdia",
          "e da tua fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Por que diriam as nações:",
          "“Onde está o Deus deles?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O nosso Deus está no céu",
          "e faz tudo como lhe agrada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os ídolos das nações",
          "são prata e ouro,",
          "obra de mãos humanas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Têm boca e não falam;",
          "têm olhos e não veem;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "têm ouvidos e não ouvem;",
          "têm nariz e não cheiram;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "têm mãos e não apalpam;",
          "têm pés e não andam;",
          "som nenhum lhes sai da garganta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tornem-se semelhantes a eles",
          "os que os fazem",
          "e todos os que neles confiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ó Israel, confie no Senhor!",
          "Ele é o seu amparo e o seu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Casa de Arão, confie no Senhor!",
          "Ele é o seu amparo e o seu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Vocês que temem o Senhor,",
          "confiem no Senhor!",
          "Ele é o seu amparo e o seu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O Senhor lembrou-se de nós;",
          "ele nos abençoará;",
          "abençoará a casa de Israel,",
          "abençoará a casa de Arão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ele abençoa",
          "os que temem o Senhor,",
          "tanto pequenos como grandes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor os abençoe",
          "mais e mais,",
          "a vocês e aos seus filhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Que vocês sejam abençoados",
          "pelo Senhor,",
          "que fez os céus e a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Os céus são os céus do Senhor,",
          "mas a terra ele deu",
          "aos filhos dos homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os mortos não louvam o Senhor,",
          "nem os que descem",
          "à região do silêncio",
          "podem fazer isso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Nós, porém,",
          "bendiremos o Senhor,",
          "desde agora e para sempre.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
