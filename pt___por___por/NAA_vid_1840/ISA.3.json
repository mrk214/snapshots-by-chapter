    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Julgamento de Judá e de Jerusalém"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Porque eis que o Senhor,",
          "o Senhor dos Exércitos,",
          "vai tirar de Jerusalém e de Judá",
          "o sustento e o apoio,",
          "todo sustento de pão",
          "e todo sustento de água."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele vai tirar também o valente,",
          "o guerreiro e o juiz;",
          "o profeta, o adivinho e o ancião;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "o capitão de cinquenta, o nobre,",
          "o conselheiro, o hábil artífice",
          "e o perito em encantamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O Senhor lhes dará meninos",
          "por chefes,",
          "e crianças governarão sobre eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Entre o povo,",
          "uns oprimirão os outros,",
          "cada um o seu próximo.",
          "Os jovens se levantarão",
          "contra os velhos,",
          "as pessoas desprezíveis",
          "contra os nobres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quando alguém for falar",
          "com o seu irmão",
          "na casa de seu pai, dizendo:",
          "“Você ainda tem um manto;",
          "venha ser o nosso chefe",
          "e assuma o controle dessas ruínas”,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "naquele dia o outro",
          "levantará a sua voz,",
          "dizendo: “Não sou médico",
          "e não há comida nem roupa",
          "em minha casa;",
          "não me ponham por chefe do povo.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Jerusalém tropeçou,",
          "e a terra de Judá está caída;",
          "porque as suas palavras",
          "e as suas obras",
          "são contra o Senhor,",
          "para desafiarem",
          "a sua gloriosa presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O aspecto do rosto",
          "testifica contra eles;",
          "e, como Sodoma,",
          "exibem o seu pecado",
          "e não o encobrem.",
          "Ai deles! Porque estão provocando",
          "a sua própria desgraça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Digam ao justo",
          "que tudo irá bem com ele;",
          "porque comerá do fruto",
          "das suas ações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ai do ímpio! Tudo irá mal com ele;",
          "porque o pagamento dele será",
          "o que as próprias mãos fizeram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Os opressores do meu povo",
          "são crianças,",
          "e mulheres estão à frente",
          "do seu governo.",
          "Meu povo, os seus guias",
          "enganam você",
          "e destroem o caminho",
          "por onde você deve seguir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O Senhor se levanta para",
          "apresentar a sua causa;",
          "ele se apresenta",
          "para julgar os povos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor entra em juízo",
          "contra os anciãos do seu povo",
          "e contra os seus líderes.",
          "Ele diz: “Foram vocês",
          "que arruinaram esta vinha.",
          "O que roubaram dos pobres",
          "está na casa de vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Com que direito vocês esmagam",
          "o meu povo",
          "e moem a face dos pobres?”",
          "O Senhor, o Senhor dos Exércitos,",
          "é quem está falando."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Julgamento das filhas de Sião"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O Senhor disse:",
          "“Visto que são orgulhosas",
          "as filhas de Sião",
          "e andam de pescoço erguido,",
          "com olhar despudorado,",
          "dando passos curtos",
          "e fazendo tinir",
          "os enfeites dos tornozelos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "o Senhor fará com que",
          "apareça sarna",
          "na cabeça das filhas de Sião;",
          "o Senhor fará com que se veja",
          "a nudez delas.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Naquele dia, o Senhor tirará os enfeites que elas têm nos tornozelos, as toucas e os ornamentos em forma de meia-lua;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "os pendentes, os braceletes e os véus esvoaçantes;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "os turbantes, as correntinhas para os tornozelos, os cintos, as caixinhas de perfume e os amuletos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "os anéis e as joias pendentes do nariz;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "os vestidos de festa, os mantos, os xales e as bolsas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "os espelhos, as roupas finíssimas, os enfeites para a cabeça e os véus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Em vez de perfume",
          "haverá cheiro podre;",
          "em vez de cinto, uma corda;",
          "em vez de belos penteados,",
          "cabeça rapada;",
          "em vez de vestidos luxuosos,",
          "roupa feita de pano de saco;",
          "e marca de fogo",
          "em lugar de formosura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Os homens de Jerusalém",
          "cairão à espada,",
          "e os valentes",
          "serão mortos na guerra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Os portões da cidade chorarão",
          "e estarão de luto;",
          "Sião, desolada,",
          "se assentará no chão."
        ],
        "rlw_lines": []
      }
    ]
  },
