{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"PSA","name":"Salmos"},"chapter":{"chapter_usfm":"PSA.81","is_chapter":true,"previous":{"usfm":"PSA.80","human":"Salmos 80","canonical":true,"toc":true},"current":{"usfm":"PSA.81","human":"Salmos 81"},"next":{"usfm":"PSA.82","human":"Salmos 82","canonical":true,"toc":true},"items":[{"type":"heading1","verse_numbers":[],"lines":["Exortação a louvor e obediência"],"rlw_lines":[]},{"type":"label","verse_numbers":[],"lines":["Ao mestre de canto, segundo a melodia “Os lagares”. Salmo de Asafe"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["Cantem de júbilo a Deus,","força nossa;","celebrem o Deus de Jacó."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["Cantem louvores","e façam soar os tamborins,","a suave harpa e também a lira."],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Toquem a trombeta","na Festa da Lua Nova,","na lua cheia, dia da nossa festa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["É preceito para Israel,","é prescrição do Deus de Jacó."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["Ele o ordenou, como lei, a José,","ao marchar contra a terra do Egito.","Ouvi uma linguagem","que eu não conhecia,","dizendo:"],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["“Livrei os seus ombros do peso,","e as mãos de vocês","ficaram livres dos cestos."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Na angústia, vocês clamaram","e eu os livrei;","do esconderijo do trovão","eu lhes respondi;","e eu os pus à prova","junto às águas de Meribá."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["Escute, meu povo,","as minhas admoestações.","Ó Israel, se ao menos","você me escutasse!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["Não haja no meio de vocês","nenhum deus estranho,","nem se prostrem diante de","um deus estrangeiro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Eu sou o Senhor,","o Deus de vocês,","que os tirei da terra do Egito.","Abram bem a boca,","e eu a encherei."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Mas o meu povo","não escutou a minha voz;","Israel não quis saber de mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["Assim, deixei que andassem","na teimosia do seu coração,","e seguissem","as suas próprias inclinações."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Ah! Se o meu povo","me escutasse,","se Israel andasse","nos meus caminhos!"],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Eu derrotaria logo","os seus inimigos","e voltaria a minha mão","contra os seus adversários."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Os que odeiam o Senhor","se submeteriam a ele,","e isto duraria para sempre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["Mas a vocês eu sustentaria","com o trigo mais fino","e os saciaria com o mel","que escorre da rocha.”"],"rlw_lines":[]}]}}