{"version":{"version_id":1840,"local_abbreviation":"NAA","local_title":"Nova Almeida Atualizada","language":{"iso_639_1":"pt","iso_639_3":"por","language_tag":"por","local_name":"Português (Brasil)","text_direction":"ltr"},"repository":"https://github.com/mrk214/bible-data-pt-por","publisher":{"name":"Bible Society of Brazil"},"copyright":{"html":"<p>A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil.</p>","text":"A Sociedade Bíblica do Brasil tem a missão de semear a Palavra que transforma vidas, tornando-a relevante para as pessoas. Junte-se a nós! NAA © 2017 Sociedade Bíblica do Brasil."}},"book":{"book_usfm":"JOB","name":"Jó"},"chapter":{"chapter_usfm":"JOB.30","is_chapter":true,"previous":{"usfm":"JOB.29","human":"Jó 29","canonical":true,"toc":true},"current":{"usfm":"JOB.30","human":"Jó 30"},"next":{"usfm":"JOB.31","human":"Jó 31","canonical":true,"toc":true},"items":[{"type":"heading2","verse_numbers":[],"lines":["Todos zombam de mim"],"rlw_lines":[]},{"type":"verse","verse_numbers":[1],"lines":["“Mas agora zombam de mim","os que têm menos idade","do que eu,","cujos pais eu não teria aceito","nem para colocar ao lado","dos cães do meu rebanho."],"rlw_lines":[]},{"type":"verse","verse_numbers":[2],"lines":["De que também me serviria","a força de suas mãos,","se eles são homens","cujo vigor já desapareceu?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[3],"lines":["Enfraqueceram de tanto","passar fome e necessidade;","roem a terra seca,","desde muito em ruínas","e desolada."],"rlw_lines":[]},{"type":"verse","verse_numbers":[4],"lines":["Apanham malvas","e folhas de arbustos","e se alimentam","de raízes de zimbro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[5],"lines":["São expulsos","do meio das pessoas;","grita-se contra eles,","como se grita","atrás de um ladrão."],"rlw_lines":[]},{"type":"verse","verse_numbers":[6],"lines":["Têm de morar","nos desfiladeiros sombrios,","nas cavernas da terra","e das rochas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[7],"lines":["Uivam entre os arbustos","e se ajuntam","debaixo dos espinheiros."],"rlw_lines":[]},{"type":"verse","verse_numbers":[8],"lines":["São filhos de doidos,","gente sem nome,","e são escorraçados da terra.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[9],"lines":["“Mas agora sou","a canção de deboche","dessa gente;","sirvo de provérbio","no meio deles."],"rlw_lines":[]},{"type":"verse","verse_numbers":[10],"lines":["Eles me detestam,","fogem para longe de mim","e não têm receio de me cuspir","no rosto."],"rlw_lines":[]},{"type":"verse","verse_numbers":[11],"lines":["Deus afrouxou a corda","do meu arco e me oprimiu;","por isso, sacudiram de si","o freio diante de mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[12],"lines":["À minha direita se levanta","um bando e me empurra,","e contra mim prepara","o seu caminho de destruição."],"rlw_lines":[]},{"type":"verse","verse_numbers":[13],"lines":["Arruínam o meu caminho;","promovem a minha destruição","sem a ajuda de ninguém."],"rlw_lines":[]},{"type":"verse","verse_numbers":[14],"lines":["Vêm contra mim","como por uma grande brecha","e se revolvem avante","no meio das ruínas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[15],"lines":["Sobrevieram-me pavores;","a minha honra é como que varrida","pelo vento;","como nuvem passou","a minha felicidade.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Tu foste cruel comigo"],"rlw_lines":[]},{"type":"verse","verse_numbers":[16],"lines":["“Agora a minha alma","se derrama dentro de mim;","os dias da aflição","se apoderam de mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[17],"lines":["A noite perfura os meus ossos,","e o mal que me corrói","não descansa."],"rlw_lines":[]},{"type":"verse","verse_numbers":[18],"lines":["Pela grande violência","do meu mal está desfigurada","a minha roupa;","este mal me envolve","como a gola da minha túnica."],"rlw_lines":[]},{"type":"verse","verse_numbers":[19],"lines":["Deus me lançou na lama,","e me tornei semelhante","ao pó e à cinza.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[20],"lines":["“Clamo a ti, ó Deus,","e não me respondes;","estou em pé,","mas apenas olhas para mim."],"rlw_lines":[]},{"type":"verse","verse_numbers":[21],"lines":["Tu foste cruel comigo;","e, com a força da tua mão,","me atacas."],"rlw_lines":[]},{"type":"verse","verse_numbers":[22],"lines":["Tu me levantas sobre o vento","e me fazes cavalgá-lo;","no estrondo da tempestade","me jogas de um lado","para outro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[23],"lines":["Pois eu sei que me levarás","à morte","e à casa destinada","a todos os vivos.”"],"rlw_lines":[]},{"type":"verse","verse_numbers":[24],"lines":["“Não é fato que","de um montão de ruínas","um homem estenderá","a sua mão?","E, na sua desventura,","não levantará","um grito por socorro?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[25],"lines":["Por acaso, não chorei","por aquele que atravessava","dias difíceis?","Não se angustiou a minha alma","pelo necessitado?"],"rlw_lines":[]},{"type":"verse","verse_numbers":[26],"lines":["Quando eu esperava o bem,","eis que me veio o mal;","esperava a luz,","e veio a escuridão.”"],"rlw_lines":[]},{"type":"heading2","verse_numbers":[],"lines":["Eu clamo por socorro"],"rlw_lines":[]},{"type":"verse","verse_numbers":[27],"lines":["“O meu íntimo se agita","sem cessar;","e dias de aflição me sobrevêm."],"rlw_lines":[]},{"type":"verse","verse_numbers":[28],"lines":["Tenho a pele queimada,","mas não pelo sol;","levanto-me na congregação","e clamo por socorro."],"rlw_lines":[]},{"type":"verse","verse_numbers":[29],"lines":["Sou irmão dos chacais","e companheiro de avestruzes."],"rlw_lines":[]},{"type":"verse","verse_numbers":[30],"lines":["A minha pele escurece e cai;","os meus ossos queimam de febre."],"rlw_lines":[]},{"type":"verse","verse_numbers":[31],"lines":["Por isso, a minha harpa é usada","para fazer lamentações,","e a minha flauta, para acompanhar","os que choram.”"],"rlw_lines":[]}]}}