    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A corrupção do pecador e sua redenção"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Diz o insensato no seu coração:",
          "“Não há Deus.”",
          "São corruptos",
          "e praticam abominação;",
          "já não há quem faça o bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Do céu o Senhor olha",
          "para os filhos dos homens,",
          "para ver se há",
          "quem tenha entendimento,",
          "se há quem busque a Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Todos se desviaram",
          "e juntamente se corromperam;",
          "não há quem faça o bem,",
          "não há nem um sequer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Será que não entendem nada",
          "todos esses que praticam",
          "a iniquidade,",
          "que devoram o meu povo",
          "como se comessem pão,",
          "e que não invocam o Senhor?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Lá, ficarão tomados",
          "de grande pavor,",
          "porque Deus está",
          "com a linhagem do justo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Vocês querem frustrar",
          "o conselho dos humildes,",
          "mas o Senhor é o refúgio deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quem dera que de Sião viesse já",
          "a salvação de Israel!",
          "Quando o Senhor restaurar",
          "a sorte do seu povo,",
          "Jacó exultará",
          "e Israel se encherá de alegria."
        ],
        "rlw_lines": []
      }
    ]
  },
