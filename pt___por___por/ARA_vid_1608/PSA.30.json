    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ações de graças pela libertação da morte"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi. Cântico da dedicação da casa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu te exaltarei, ó Senhor, porque tu me livraste",
          "e não permitiste que os meus inimigos se regozijassem contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Senhor, meu Deus, clamei a ti por socorro,",
          "e tu me saraste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Senhor, da cova fizeste subir a minha alma;",
          "preservaste-me a vida para que não descesse à sepultura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Salmodiai ao Senhor, vós que sois seus santos,",
          "e dai graças ao seu santo nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Porque não passa de um momento a sua ira;",
          "o seu favor dura a vida inteira.",
          "Ao anoitecer, pode vir o choro,",
          "mas a alegria vem pela manhã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quanto a mim, dizia eu na minha prosperidade:",
          "jamais serei abalado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tu, Senhor, por teu favor",
          "fizeste permanecer forte a minha montanha;",
          "apenas voltaste o rosto,",
          "fiquei logo conturbado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por ti, Senhor, clamei,",
          "ao Senhor implorei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Que proveito obterás no meu sangue,",
          "quando baixo à cova?",
          "Louvar-te-á, porventura, o pó?",
          "Declarará ele a tua verdade?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ouve, Senhor, e tem compaixão de mim;",
          "sê tu, Senhor, o meu auxílio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Converteste o meu pranto em folguedos;",
          "tiraste o meu pano de saco",
          "e me cingiste de alegria,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "para que o meu espírito te cante louvores e não se cale.",
          "Senhor, Deus meu, graças te darei para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
