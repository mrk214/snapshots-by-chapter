    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A voz de Deus na tempestade"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Tributai ao Senhor, filhos de Deus,",
          "tributai ao Senhor glória e força."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Tributai ao Senhor a glória devida ao seu nome,",
          "adorai o Senhor na beleza da santidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ouve-se a voz do Senhor sobre as águas;",
          "troveja o Deus da glória;",
          "o Senhor está sobre as muitas águas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "A voz do Senhor é poderosa;",
          "a voz do Senhor é cheia de majestade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A voz do Senhor quebra os cedros;",
          "sim, o Senhor despedaça os cedros do Líbano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ele os faz saltar como um bezerro;",
          "o Líbano e o Siriom, como bois selvagens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "A voz do Senhor despede chamas de fogo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A voz do Senhor faz tremer o deserto;",
          "o Senhor faz tremer o deserto de Cades."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "A voz do Senhor faz dar cria às corças",
          "e desnuda os bosques;",
          "e no seu templo tudo diz: Glória!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O Senhor preside aos dilúvios;",
          "como rei, o Senhor presidirá para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O Senhor dá força ao seu povo,",
          "o Senhor abençoa com paz ao seu povo."
        ],
        "rlw_lines": []
      }
    ]
  },
