    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração a favor do rei"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O Senhor te responda no dia da tribulação;",
          "o nome do Deus de Jacó te eleve em segurança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Do seu santuário te envie socorro",
          "e desde Sião te sustenha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Lembre-se de todas as tuas ofertas de manjares",
          "e aceite os teus holocaustos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Conceda-te segundo o teu coração",
          "e realize todos os teus desígnios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Celebraremos com júbilo a tua vitória",
          "e em nome do nosso Deus hastearemos pendões;",
          "satisfaça o Senhor a todos os teus votos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Agora, sei que o Senhor salva o seu ungido;",
          "ele lhe responderá do seu santo céu",
          "com a vitoriosa força de sua destra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Uns confiam em carros, outros, em cavalos;",
          "nós, porém, nos gloriaremos em o nome do Senhor, nosso Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eles se encurvam e caem;",
          "nós, porém, nos levantamos e nos mantemos de pé."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ó Senhor, dá vitória ao rei;",
          "responde-nos, quando clamarmos."
        ],
        "rlw_lines": []
      }
    ]
  },
