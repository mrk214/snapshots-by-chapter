    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Auxílio contra a falsidade"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, para instrumentos de oito cordas. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Socorro, Senhor! Porque já não há homens piedosos;",
          "desaparecem os fiéis entre os filhos dos homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Falam com falsidade uns aos outros,",
          "falam com lábios bajuladores e coração fingido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Corte o Senhor todos os lábios bajuladores,",
          "a língua que fala soberbamente,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "pois dizem: Com a língua prevaleceremos,",
          "os lábios são nossos; quem é senhor sobre nós?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Por causa da opressão dos pobres e do gemido dos necessitados,",
          "eu me levantarei agora, diz o Senhor;",
          "e porei a salvo a quem por isso suspira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "As palavras do Senhor são palavras puras,",
          "prata refinada em cadinho de barro,",
          "depurada sete vezes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sim, Senhor, tu nos guardarás;",
          "desta geração nos livrarás para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por todos os lugares andam os perversos,",
          "quando entre os filhos dos homens a vileza é exaltada."
        ],
        "rlw_lines": []
      }
    ]
  },
