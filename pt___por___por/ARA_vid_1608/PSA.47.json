    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus, o Rei da terra"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo dos filhos de Corá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Batei palmas, todos os povos;",
          "celebrai a Deus com vozes de júbilo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Pois o Senhor Altíssimo é tremendo,",
          "é o grande rei de toda a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ele nos submeteu os povos",
          "e pôs sob os nossos pés as nações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Escolheu-nos a nossa herança,",
          "a glória de Jacó, a quem ele ama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Subiu Deus por entre aclamações,",
          "o Senhor, ao som de trombeta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Salmodiai a Deus, cantai louvores;",
          "salmodiai ao nosso Rei, cantai louvores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Deus é o Rei de toda a terra;",
          "salmodiai com harmonioso cântico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Deus reina sobre as nações;",
          "Deus se assenta no seu santo trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os príncipes dos povos se reúnem,",
          "o povo do Deus de Abraão,",
          "porque a Deus pertencem os escudos da terra;",
          "ele se exaltou gloriosamente."
        ],
        "rlw_lines": []
      }
    ]
  },
