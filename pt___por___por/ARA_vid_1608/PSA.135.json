    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvores a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Louvai o nome do Senhor;",
          "louvai-o, servos do Senhor,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "vós que assistis na Casa do Senhor,",
          "nos átrios da casa do nosso Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Louvai ao Senhor, porque o Senhor é bom;",
          "cantai louvores ao seu nome, porque é agradável."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pois o Senhor escolheu para si a Jacó",
          "e a Israel, para sua possessão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Com efeito, eu sei que o Senhor é grande",
          "e que o nosso Deus está acima de todos os deuses."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tudo quanto aprouve ao Senhor, ele o fez,",
          "nos céus e na terra,",
          "no mar e em todos os abismos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Faz subir as nuvens dos confins da terra,",
          "faz os relâmpagos para a chuva,",
          "faz sair o vento dos seus reservatórios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Foi ele quem feriu os primogênitos no Egito,",
          "tanto dos homens como das alimárias;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "quem, no meio de ti, ó Egito, operou sinais e prodígios",
          "contra Faraó e todos os seus servos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "quem feriu muitas nações",
          "e tirou a vida a poderosos reis:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "a Seom, rei dos amorreus,",
          "e a Ogue, rei de Basã,",
          "e a todos os reinos de Canaã;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "cujas terras deu em herança,",
          "em herança a Israel, seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O teu nome, Senhor, subsiste para sempre;",
          "a tua memória, Senhor, passará de geração em geração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Pois o Senhor julga ao seu povo",
          "e se compadece dos seus servos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os ídolos das nações são prata e ouro,",
          "obra das mãos dos homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Têm boca e não falam;",
          "têm olhos e não veem;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "têm ouvidos e não ouvem;",
          "pois não há alento de vida em sua boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Como eles se tornam os que os fazem,",
          "e todos os que neles confiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Casa de Israel, bendizei ao Senhor;",
          "casa de Arão, bendizei ao Senhor;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "casa de Levi, bendizei ao Senhor;",
          "vós que temeis ao Senhor, bendizei ao Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Desde Sião bendito seja o Senhor,",
          "que habita em Jerusalém!",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
