    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Apelo do justo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Faze-me justiça, Senhor, pois tenho andado na minha integridade",
          "e confio no Senhor, sem vacilar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Examina-me, Senhor, e prova-me;",
          "sonda-me o coração e os pensamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois a tua benignidade, tenho-a perante os olhos",
          "e tenho andado na tua verdade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Não me tenho assentado com homens falsos",
          "e com os dissimuladores não me associo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aborreço a súcia de malfeitores",
          "e com os ímpios não me assento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Lavo as mãos na inocência",
          "e, assim, andarei, Senhor, ao redor do teu altar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para entoar, com voz alta, os louvores",
          "e proclamar as tuas maravilhas todas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eu amo, Senhor, a habitação de tua casa",
          "e o lugar onde tua glória assiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não colhas a minha alma com a dos pecadores,",
          "nem a minha vida com a dos homens sanguinários,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "em cujas mãos há crimes",
          "e cuja destra está cheia de subornos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Quanto a mim, porém, ando na minha integridade;",
          "livra-me e tem compaixão de mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O meu pé está firme em terreno plano;",
          "nas congregações, bendirei o Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
