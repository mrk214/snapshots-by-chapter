    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jó afirma a soberania de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Jó, porém, respondeu:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como sabes ajudar ao que não tem força",
          "e prestar socorro ao braço que não tem vigor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Como sabes aconselhar ao que não tem sabedoria",
          "e revelar plenitude de verdadeiro conhecimento!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Com a ajuda de quem proferes tais palavras?",
          "E de quem é o espírito que fala em ti?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A alma dos mortos treme",
          "debaixo das águas com seus habitantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O além está desnudo perante ele,",
          "e não há coberta para o abismo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele estende o norte sobre o vazio",
          "e faz pairar a terra sobre o nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Prende as águas em densas nuvens,",
          "e as nuvens não se rasgam debaixo delas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Encobre a face do seu trono",
          "e sobre ele estende a sua nuvem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Traçou um círculo à superfície das águas,",
          "até aos confins da luz e das trevas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "As colunas do céu tremem",
          "e se espantam da sua ameaça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Com a sua força fende o mar",
          "e com o seu entendimento abate o adversário."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pelo seu sopro aclara os céus,",
          "a sua mão fere o dragão veloz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Eis que isto são apenas as orlas dos seus caminhos!",
          "Que leve sussurro temos ouvido dele!",
          "Mas o trovão do seu poder, quem o entenderá?"
        ],
        "rlw_lines": []
      }
    ]
  },
