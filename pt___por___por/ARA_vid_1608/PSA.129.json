    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Recordação de libertações"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de romagem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Muitas vezes me angustiaram desde a minha mocidade,",
          "Israel que o diga;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "desde a minha mocidade, me angustiaram,",
          "todavia, não prevaleceram contra mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sobre o meu dorso lavraram os aradores;",
          "nele abriram longos sulcos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mas o Senhor é justo;",
          "cortou as cordas dos ímpios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sejam envergonhados e repelidos",
          "todos os que aborrecem a Sião!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sejam como a erva dos telhados,",
          "que seca antes de florescer,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "com a qual não enche a mão o ceifeiro,",
          "nem os braços, o que ata os feixes!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "E também os que passam não dizem:",
          "A bênção do Senhor seja convosco!",
          "Nós vos abençoamos em nome do Senhor!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
