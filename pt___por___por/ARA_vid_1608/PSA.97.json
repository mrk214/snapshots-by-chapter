    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A majestade e o domínio de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Reina o Senhor. Regozije-se a terra,",
          "alegrem-se as muitas ilhas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Nuvens e escuridão o rodeiam,",
          "justiça e juízo são a base do seu trono."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Adiante dele vai um fogo",
          "que lhe consome os inimigos em redor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os seus relâmpagos alumiam o mundo;",
          "a terra os vê e estremece."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Derretem-se como cera os montes, na presença do Senhor,",
          "na presença do Senhor de toda a terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os céus anunciam a sua justiça,",
          "e todos os povos veem a sua glória."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sejam confundidos todos os que servem a imagens de escultura,",
          "os que se gloriam de ídolos;",
          "prostrem-se diante dele todos os deuses."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sião ouve e se alegra,",
          "as filhas de Judá se regozijam,",
          "por causa da tua justiça, ó Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pois tu, Senhor, és o Altíssimo sobre toda a terra;",
          "tu és sobremodo elevado acima de todos os deuses."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Vós que amais o Senhor, detestai o mal;",
          "ele guarda a alma dos seus santos,",
          "livra-os da mão dos ímpios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A luz difunde-se para o justo,",
          "e a alegria, para os retos de coração."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Alegrai-vos no Senhor, ó justos,",
          "e dai louvores ao seu santo nome."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
