    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pede-se o perdão de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo dos filhos de Corá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Favoreceste, Senhor, a tua terra;",
          "restauraste a prosperidade de Jacó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Perdoaste a iniquidade de teu povo,",
          "encobriste os seus pecados todos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A tua indignação, reprimiste-a toda,",
          "do furor da tua ira te desviaste."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Restabelece-nos, ó Deus da nossa salvação,",
          "e retira de sobre nós a tua ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Estarás para sempre irado contra nós?",
          "Prolongarás a tua ira por todas as gerações?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porventura, não tornarás a vivificar-nos,",
          "para que em ti se regozije o teu povo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mostra-nos, Senhor, a tua misericórdia",
          "e concede-nos a tua salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Escutarei o que Deus, o Senhor, disser,",
          "pois falará de paz ao seu povo e aos seus santos;",
          "e que jamais caiam em insensatez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Próxima está a sua salvação dos que o temem,",
          "para que a glória assista em nossa terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Encontraram-se a graça e a verdade,",
          "a justiça e a paz se beijaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Da terra brota a verdade,",
          "dos céus a justiça baixa o seu olhar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Também o Senhor dará o que é bom,",
          "e a nossa terra produzirá o seu fruto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "A justiça irá adiante dele,",
          "cujas pegadas ela transforma em caminhos."
        ],
        "rlw_lines": []
      }
    ]
  },
