    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A excelência da sabedoria"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Filho meu, se aceitares as minhas palavras",
          "e esconderes contigo os meus mandamentos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "para fazeres atento à sabedoria o teu ouvido",
          "e para inclinares o coração ao entendimento,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "e, se clamares por inteligência,",
          "e por entendimento alçares a voz,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "se buscares a sabedoria como a prata",
          "e como a tesouros escondidos a procurares,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "então, entenderás o temor do Senhor",
          "e acharás o conhecimento de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque o Senhor dá a sabedoria,",
          "e da sua boca vem a inteligência e o entendimento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele reserva a verdadeira sabedoria para os retos;",
          "é escudo para os que caminham na sinceridade,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "guarda as veredas do juízo",
          "e conserva o caminho dos seus santos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Então, entenderás justiça, juízo",
          "e equidade, todas as boas veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Porquanto a sabedoria entrará no teu coração,",
          "e o conhecimento será agradável à tua alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O bom siso te guardará,",
          "e a inteligência te conservará;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "para te livrar do caminho do mal",
          "e do homem que diz coisas perversas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "dos que deixam as veredas da retidão,",
          "para andarem pelos caminhos das trevas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "que se alegram de fazer o mal,",
          "folgam com as perversidades dos maus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "seguem veredas tortuosas",
          "e se desviam nos seus caminhos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "para te livrar da mulher adúltera,",
          "da estrangeira, que lisonjeia com palavras,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "a qual deixa o amigo da sua mocidade",
          "e se esquece da aliança do seu Deus;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "porque a sua casa se inclina para a morte,",
          "e as suas veredas, para o reino das sombras da morte;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "todos os que se dirigem a essa mulher não voltarão",
          "e não atinarão com as veredas da vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Assim, andarás pelo caminho dos homens de bem",
          "e guardarás as veredas dos justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Porque os retos habitarão a terra,",
          "e os íntegros permanecerão nela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Mas os perversos serão eliminados da terra,",
          "e os aleivosos serão dela desarraigados."
        ],
        "rlw_lines": []
      }
    ]
  },
