  "book": {
    "usfm": "LAM",
    "human": "Lamentações"
  },
  "chapter": {
    "usfm": "LAM.3",
    "human": "Lamentações 3",
    "previous": {
      "usfm": "LAM.2",
      "human": "Lamentações 2"
    },
    "next": {
      "usfm": "LAM.4",
      "human": "Lamentações 4"
    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Convidado o povo a reconhecer o seu pecado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Eu sou o homem que viu a aflição",
          "pela vara do furor de Deus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele me levou e me fez andar",
          "em trevas e não na luz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Deveras ele volveu contra mim a mão,",
          "de contínuo, todo o dia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Fez envelhecer a minha carne e a minha pele,",
          "despedaçou os meus ossos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Edificou contra mim",
          "e me cercou de veneno e de dor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Fez-me habitar em lugares tenebrosos,",
          "como os que estão mortos para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cercou-me de um muro, e já não posso sair;",
          "agravou-me com grilhões de bronze."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ainda quando clamo e grito,",
          "ele não admite a minha oração."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Fechou os meus caminhos com pedras lavradas,",
          "fez tortuosas as minhas veredas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Fez-se-me como urso à espreita,",
          "um leão de emboscada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Desviou os meus caminhos e me fez em pedaços;",
          "deixou-me assolado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Entesou o seu arco",
          "e me pôs como alvo à flecha."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Fez que me entrassem no coração",
          "as flechas da sua aljava."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Fui feito objeto de escárnio para todo o meu povo",
          "e a sua canção, todo o dia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Fartou-me de amarguras,",
          "saciou-me de absinto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Fez-me quebrar com pedrinhas de areia os meus dentes,",
          "cobriu-me de cinza."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Afastou a paz de minha alma;",
          "esqueci-me do bem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Então, disse eu: já pereceu a minha glória,",
          "como também a minha esperança no Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Lembra-te da minha aflição e do meu pranto,",
          "do absinto e do veneno."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Minha alma, continuamente, os recorda",
          "e se abate dentro de mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Quero trazer à memória",
          "o que me pode dar esperança."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esperança de auxílio pela misericórdia de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "As misericórdias do Senhor são a causa de não sermos consumidos,",
          "porque as suas misericórdias não têm fim;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "renovam-se cada manhã.",
          "Grande é a tua fidelidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "A minha porção é o Senhor, diz a minha alma;",
          "portanto, esperarei nele."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Bom é o Senhor para os que esperam por ele,",
          "para a alma que o busca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Bom é aguardar a salvação do Senhor,",
          "e isso, em silêncio."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Bom é para o homem",
          "suportar o jugo na sua mocidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Assente-se solitário e fique em silêncio;",
          "porquanto esse jugo Deus pôs sobre ele;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "ponha a boca no pó;",
          "talvez ainda haja esperança."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Dê a face ao que o fere;",
          "farte-se de afronta."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "O Senhor não rejeitará",
          "para sempre;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "pois, ainda que entristeça a alguém,",
          "usará de compaixão segundo a grandeza das suas misericórdias;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "porque não aflige, nem entristece de bom grado",
          "os filhos dos homens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Pisar debaixo dos pés",
          "a todos os presos da terra,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "perverter o direito do homem",
          "perante o Altíssimo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "subverter ao homem no seu pleito,",
          "não o veria o Senhor?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Quem é aquele que diz, e assim acontece,",
          "quando o Senhor o não mande?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Acaso, não procede do Altíssimo",
          "tanto o mal como o bem?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Por que, pois, se queixa o homem vivente?",
          "Queixe-se cada um dos seus próprios pecados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Esquadrinhemos os nossos caminhos,",
          "provemo-los e voltemos para o Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Levantemos o coração,",
          "juntamente com as mãos, para Deus nos céus, dizendo:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Nós prevaricamos e fomos rebeldes,",
          "e tu não nos perdoaste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Cobriste-nos de ira e nos perseguiste;",
          "e sem piedade nos mataste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "De nuvens te encobriste",
          "para que não passe a nossa oração."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Como cisco e refugo nos puseste",
          "no meio dos povos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Todos os nossos inimigos",
          "abriram contra nós a boca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Sobre nós vieram o temor e a cova,",
          "a assolação e a ruína."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Dos meus olhos se derramam torrentes de águas,",
          "por causa da destruição da filha do meu povo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Os meus olhos choram,",
          "não cessam, e não há descanso,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "até que o Senhor atenda",
          "e veja lá do céu."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Os meus olhos entristecem a minha alma,",
          "por causa de todas as filhas da minha cidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Caçaram-me, como se eu fosse ave,",
          "os que sem motivo são meus inimigos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Para me destruírem, lançaram-me na cova",
          "e atiraram pedras sobre mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Águas correram sobre a minha cabeça;",
          "então, disse: estou perdido!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Da mais profunda cova, Senhor,",
          "invoquei o teu nome."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Ouviste a minha voz;",
          "não escondas o ouvido aos meus lamentos, ao meu clamor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "De mim te aproximaste no dia em que te invoquei;",
          "disseste: Não temas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Pleiteaste, Senhor, a causa da minha alma,",
          "remiste a minha vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Viste, Senhor, a injustiça que me fizeram;",
          "julga a minha causa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Viste a sua vingança toda,",
          "todos os seus pensamentos contra mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Ouviste as suas afrontas, Senhor,",
          "todos os seus pensamentos contra mim;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "as acusações dos meus adversários",
          "e o seu murmurar contra mim, o dia todo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Observa-os quando se assentam e quando se levantam;",
          "eu sou objeto da sua canção."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "Tu lhes darás a paga, Senhor,",
          "segundo a obra das suas mãos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Tu lhes darás cegueira de coração,",
          "a tua maldição imporás sobre eles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Na tua ira, os perseguirás,",
          "e eles serão eliminados de debaixo dos céus do Senhor."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
