    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A fraqueza do homem e a fidelidade de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Louva, ó minha alma, ao Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Louvarei ao Senhor durante a minha vida;",
          "cantarei louvores ao meu Deus, enquanto eu viver."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não confieis em príncipes,",
          "nem nos filhos dos homens, em quem não há salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sai-lhes o espírito, e eles tornam ao pó;",
          "nesse mesmo dia, perecem todos os seus desígnios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Bem-aventurado aquele que tem o Deus de Jacó por seu auxílio,",
          "cuja esperança está no Senhor, seu Deus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "que fez os céus e a terra,",
          "o mar e tudo o que neles há",
          "e mantém para sempre a sua fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que faz justiça aos oprimidos",
          "e dá pão aos que têm fome.",
          "O Senhor liberta os encarcerados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O Senhor abre os olhos aos cegos,",
          "o Senhor levanta os abatidos,",
          "o Senhor ama os justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O Senhor guarda o peregrino,",
          "ampara o órfão e a viúva,",
          "porém transtorna o caminho dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O Senhor reina para sempre;",
          "o teu Deus, ó Sião, reina de geração em geração.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
