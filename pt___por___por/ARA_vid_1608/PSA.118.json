    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A alegria dos justos pelo Salvador"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Rendei graças ao Senhor, porque ele é bom,",
          "porque a sua misericórdia dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Diga, pois, Israel:",
          "Sim, a sua misericórdia dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Diga, pois, a casa de Arão:",
          "Sim, a sua misericórdia dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Digam, pois, os que temem ao Senhor:",
          "Sim, a sua misericórdia dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Em meio à tribulação, invoquei o Senhor,",
          "e o Senhor me ouviu e me deu folga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor está comigo; não temerei.",
          "Que me poderá fazer o homem?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor está comigo entre os que me ajudam;",
          "por isso, verei cumprido o meu desejo nos que me odeiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Melhor é buscar refúgio no Senhor",
          "do que confiar no homem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Melhor é buscar refúgio no Senhor",
          "do que confiar em príncipes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todas as nações me cercaram,",
          "mas em nome do Senhor as destruí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Cercaram-me, cercaram-me de todos os lados;",
          "mas em nome do Senhor as destruí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Como abelhas me cercaram,",
          "porém como fogo em espinhos foram queimadas;",
          "em nome do Senhor as destruí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Empurraram-me violentamente para me fazer cair,",
          "porém o Senhor me amparou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor é a minha força e o meu cântico,",
          "porque ele me salvou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Nas tendas dos justos há voz de júbilo e de salvação;",
          "a destra do Senhor faz proezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "A destra do Senhor se eleva,",
          "a destra do Senhor faz proezas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Não morrerei; antes, viverei",
          "e contarei as obras do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "O Senhor me castigou severamente,",
          "mas não me entregou à morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Abri-me as portas da justiça;",
          "entrarei por elas e renderei graças ao Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Esta é a porta do Senhor;",
          "por ela entrarão os justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Render-te-ei graças porque me acudiste",
          "e foste a minha salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "A pedra que os construtores rejeitaram,",
          "essa veio a ser a principal pedra, angular;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "isto procede do Senhor",
          "e é maravilhoso aos nossos olhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Este é o dia que o Senhor fez;",
          "regozijemo-nos e alegremo-nos nele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Oh! Salva-nos, Senhor, nós te pedimos;",
          "oh! Senhor, concede-nos prosperidade!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Bendito o que vem em nome do Senhor.",
          "A vós outros da Casa do Senhor, nós vos abençoamos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "O Senhor é Deus, ele é a nossa luz;",
          "adornai a festa com ramos até às pontas do altar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Tu és o meu Deus, render-te-ei graças;",
          "tu és o meu Deus, quero exaltar-te."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Rendei graças ao Senhor, porque ele é bom,",
          "porque a sua misericórdia dura para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
