    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Para onde foi o teu amado,",
          "ó mais formosa entre as mulheres?",
          "Que rumo tomou o teu amado?",
          "E o buscaremos contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O meu amado desceu ao seu jardim,",
          "aos canteiros de bálsamo,",
          "para pastorear nos jardins",
          "e para colher os lírios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Eu sou do meu amado, e o meu amado é meu;",
          "ele pastoreia entre os lírios."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Quinto cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Formosa és, querida minha, como Tirza,",
          "aprazível como Jerusalém,",
          "formidável como um exército com bandeiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Desvia de mim os olhos,",
          "porque eles me perturbam.",
          "Os teus cabelos descem ondeantes",
          "como o rebanho das cabras de Gileade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "São os teus dentes como o rebanho de ovelhas",
          "que sobem do lavadouro,",
          "e das quais todas produzem gêmeos,",
          "e nenhuma delas há sem crias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "As tuas faces, como romã partida,",
          "brilham através do véu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Sessenta são as rainhas, oitenta, as concubinas,",
          "e as virgens, sem número."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mas uma só é a minha pomba, a minha imaculada,",
          "de sua mãe, a única,",
          "a predileta daquela que a deu à luz;",
          "viram-na as donzelas e lhe chamaram ditosa;",
          "viram-na as rainhas e as concubinas e a louvaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quem é esta que aparece como a alva do dia,",
          "formosa como a lua, pura como o sol,",
          "formidável como um exército com bandeiras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Desci ao jardim das nogueiras,",
          "para mirar os renovos do vale,",
          "para ver se brotavam as vides,",
          "se floresciam as romeiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Não sei como,",
          "imaginei-me no carro do meu nobre povo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Volta, volta, ó sulamita,",
          "volta, volta, para que nós te contemplemos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Esposa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Por que quereis contemplar a sulamita",
          "na dança de Maanaim?"
        ],
        "rlw_lines": []
      }
    ]
  },
