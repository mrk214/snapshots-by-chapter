    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jerusalém, amada de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo dos filhos de Corá. Cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Fundada por ele sobre os montes santos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "o Senhor ama as portas de Sião",
          "mais do que as habitações todas de Jacó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Gloriosas coisas se têm dito de ti,",
          "ó cidade de Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dentre os que me conhecem, farei menção de Raabe e da Babilônia;",
          "eis aí Filístia e Tiro com Etiópia;",
          "lá, nasceram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "E com respeito a Sião se dirá:",
          "Este e aquele nasceram nela;",
          "e o próprio Altíssimo a estabelecerá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor, ao registrar os povos, dirá:",
          "Este nasceu lá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todos os cantores, saltando de júbilo, entoarão:",
          "Todas as minhas fontes são em ti."
        ],
        "rlw_lines": []
      }
    ]
  },
