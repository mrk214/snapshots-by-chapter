    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração no meio de grande perigo"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo didático de Davi. Oração que fez quando estava na caverna"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ao Senhor ergo a minha voz e clamo,",
          "com a minha voz suplico ao Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Derramo perante ele a minha queixa,",
          "à sua presença exponho a minha tribulação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quando dentro de mim me esmorece o espírito,",
          "conheces a minha vereda.",
          "No caminho em que ando,",
          "me ocultam armadilha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Olha à minha direita e vê,",
          "pois não há quem me reconheça,",
          "nenhum lugar de refúgio,",
          "ninguém que por mim se interesse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A ti clamo, Senhor,",
          "e digo: tu és o meu refúgio,",
          "o meu quinhão na terra dos viventes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Atende o meu clamor,",
          "pois me vejo muito fraco.",
          "Livra-me dos meus perseguidores,",
          "porque são mais fortes do que eu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tira a minha alma do cárcere,",
          "para que eu dê graças ao teu nome;",
          "os justos me rodearão,",
          "quando me fizeres esse bem."
        ],
        "rlw_lines": []
      }
    ]
  },
