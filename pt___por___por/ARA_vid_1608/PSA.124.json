      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus, nosso protetor e libertador"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de romagem. De Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Não fosse o Senhor, que esteve ao nosso lado,",
          "Israel que o diga;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "não fosse o Senhor, que esteve ao nosso lado,",
          "quando os homens se levantaram contra nós,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "e nos teriam engolido vivos,",
          "quando a sua ira se acendeu contra nós;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "as águas nos teriam submergido,",
          "e sobre a nossa alma teria passado a torrente;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "águas impetuosas teriam passado",
          "sobre a nossa alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Bendito o Senhor, que não nos deu",
          "por presa aos dentes deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Salvou-se a nossa alma,",
          "como um pássaro do laço dos passarinheiros;",
          "quebrou-se o laço,",
          "e nós nos vimos livres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O nosso socorro está em o nome do Senhor,",
          "criador do céu e da terra."
        ],
        "rlw_lines": []
      }
    ]
