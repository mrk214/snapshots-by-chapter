  "book": {
    "book_usfm": "JOB",
    "name": "Jó"
  },
  "chapter": {
    "usfm": "JOB.33",
    "human": "Jó 33",
    "previous": {
      "usfm": "JOB.32",
      "human": "Jó 32"
    },
    "next": {
