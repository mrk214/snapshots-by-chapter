    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendentes de Adão"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Adão, Sete, Enos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cainã, Maalalel, Jarede,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Enoque, Metusalém, Lameque,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Noé, Sem, Cam e Jafé."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendentes dos filhos de Noé"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os filhos de Jafé foram: Gomer, Magogue, Madai, Javã, Tubal, Meseque e Tiras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os filhos de Gomer: Asquenaz, Rifate e Togarma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Os filhos de Javã: Elisá, Társis, Quitim e Rodanim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os filhos de Cam: Cuxe, Mizraim, Pute e Canaã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Os filhos de Cuxe: Sebá, Havilá, Sabtá, Raamá e Sabtecá; os filhos de Raamá: Sabá e Dedã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Cuxe gerou a Ninrode, que começou a ser poderoso na terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mizraim gerou a Ludim, a Anamim, a Leabim, a Naftuim,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "a Patrusim, a Casluim (de quem descendem os filisteus) e a Caftorim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Canaã gerou a Sidom, seu primogênito, a Hete,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "aos jebuseus, aos amorreus, aos girgaseus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "aos heveus, aos arqueus, aos sineus,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "aos arvadeus, aos zemareus e aos hamateus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os filhos de Sem: Elão, Assur, Arfaxade, Lude, Arã, Uz, Hul, Geter e Meseque."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Arfaxade gerou a Selá, e Selá gerou a Héber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A Héber nasceram dois filhos: o nome de um foi Pelegue, porquanto, nos seus dias, se repartiu a terra; e o nome de seu irmão era Joctã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Joctã gerou a Almodá, a Salefe, a Hazar-Mavé, a Jerá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "a Hadorão, a Uzal, a Dicla,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "a Ebal, a Abimael, a Sabá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "a Ofir, a Havilá e a Jobabe; todos estes eram filhos de Joctã."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendentes de Sem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Sem, Arfaxade, Selá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Héber, Pelegue, Reú,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Serugue, Naor, Tera"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "e Abrão, que é Abraão."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendentes de Ismael"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Os filhos de Abraão: Isaque e Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "São estas as suas gerações: o primogênito de Ismael foi Nebaiote, depois Quedar, Adbeel, Mibsão,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Misma, Dumá, Massá, Hadade, Temá,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Jetur, Nafis e Quedemá; estes foram os filhos de Ismael."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendentes de Abraão e Quetura"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Quanto aos filhos de Quetura, concubina de Abraão, esta deu à luz a Zinrã, a Jocsã, a Medã, a Midiã, a Isbaque e a Sua. Os filhos de Jocsã: Sabá e Dedã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Os filhos de Midiã: Efa, Éfer, Enoque, Abida e Elda; todos estes foram filhos de Quetura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Abraão, pois, gerou a Isaque. Os filhos de Isaque: Esaú e Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendentes de Esaú"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Os filhos de Esaú: Elifaz, Reuel, Jeús, Jalão e Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Os filhos de Elifaz: Temã, Omar, Zefi, Gaetã, Quenaz, Timna e Amaleque."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Os filhos de Reuel: Naate, Zerá, Samá e Mizá."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendentes de Seir"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Os filhos de Seir: Lotã, Sobal, Zibeão, Aná, Diso, Eser e Disã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Os filhos de Lotã: Hori e Homã; e a irmã de Lotã foi Timna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Os filhos de Sobal eram Aliã, Manaate, Ebal, Sefô e Onã. Os filhos de Zibeão: Aías e Aná."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "O filho de Aná: Disom. Os filhos de Disom: Hanrão, Esbã, Itrã e Querã."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Os filhos de Eser: Bilã, Zaavã e Jaacã. Os filhos de Disã: Uz e Arã."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Reis e príncipes de Edom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "São estes os reis que reinaram na terra de Edom, antes que houvesse rei sobre os filhos de Israel: Bela, filho de Beor, e o nome da sua cidade era Dinabá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Morreu Bela, e em seu lugar reinou Jobabe, filho de Zera, de Bozra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Morreu Jobabe, e em seu lugar reinou Husão, da terra dos temanitas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Morreu Husão, e em seu lugar reinou Hadade, filho de Bedade; este feriu a Midiã no campo de Moabe; o nome da sua cidade era Avite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Morreu Hadade, e em seu lugar reinou Samlá, de Masreca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Morreu Samlá, e em seu lugar reinou Saul, de Reobote, junto ao Eufrates."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Morreu Saul, e em seu lugar reinou Baal-Hanã, filho de Acbor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "Morreu Baal-Hanã, e em seu lugar reinou Hadade; o nome da sua cidade era Paú, e o de sua mulher era Meetabel, filha de Matrede, filha de Me-Zaabe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Morreu Hadade. São estes os nomes dos príncipes de Edom: o príncipe Timna, o príncipe Alva, o príncipe Jetete,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "o príncipe Oolibama, o príncipe Elá, o príncipe Pinom,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "o príncipe Quenaz, o príncipe Temã, o príncipe Mibzar,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "o príncipe Magdiel, o príncipe Irão; são estes os príncipes de Edom."
        ],
        "rlw_lines": []
      }
    ]
  },
