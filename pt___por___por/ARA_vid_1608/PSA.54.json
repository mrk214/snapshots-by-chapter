    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Apelo para o socorro divino"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo didático. Para instrumentos de cordas. De Davi, quando os zifeus vieram dizer a Saul: Não está Davi homiziado entre nós?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, salva-me, pelo teu nome,",
          "e faze-me justiça, pelo teu poder."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Escuta, ó Deus, a minha oração,",
          "dá ouvidos às palavras da minha boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois contra mim se levantam os insolentes,",
          "e os violentos procuram tirar-me a vida;",
          "não têm Deus diante de si."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eis que Deus é o meu ajudador,",
          "o Senhor é quem me sustenta a vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele retribuirá o mal aos meus opressores;",
          "por tua fidelidade dá cabo deles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Oferecer-te-ei voluntariamente sacrifícios;",
          "louvarei o teu nome, ó Senhor, porque é bom."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Pois me livrou de todas as tribulações;",
          "e os meus olhos se enchem com a ruína dos meus inimigos."
        ],
        "rlw_lines": []
      }
    ]
  },
