    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica e confiança"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oração de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Inclina, Senhor, os ouvidos e responde-me,",
          "pois estou aflito e necessitado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Preserva a minha alma, pois eu sou piedoso;",
          "tu, ó Deus meu, salva o teu servo que em ti confia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Compadece-te de mim, ó Senhor, pois a ti clamo de contínuo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alegra a alma do teu servo,",
          "porque a ti, Senhor, elevo a minha alma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois tu, Senhor, és bom e compassivo;",
          "abundante em benignidade para com todos os que te invocam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Escuta, Senhor, a minha oração",
          "e atende à voz das minhas súplicas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "No dia da minha angústia, clamo a ti,",
          "porque me respondes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Não há entre os deuses semelhante a ti, Senhor;",
          "e nada existe que se compare às tuas obras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Todas as nações que fizeste",
          "virão, prostrar-se-ão diante de ti, Senhor,",
          "e glorificarão o teu nome."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois tu és grande e operas maravilhas;",
          "só tu és Deus!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ensina-me, Senhor, o teu caminho,",
          "e andarei na tua verdade;",
          "dispõe-me o coração para só temer o teu nome."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Dar-te-ei graças, Senhor, Deus meu, de todo o coração,",
          "e glorificarei para sempre o teu nome."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pois grande é a tua misericórdia para comigo,",
          "e me livraste a alma do mais profundo poder da morte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ó Deus, os soberbos se têm levantado contra mim,",
          "e um bando de violentos atenta contra a minha vida;",
          "eles não te consideram."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mas tu, Senhor, és Deus compassivo e cheio de graça,",
          "paciente e grande em misericórdia e em verdade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Volta-te para mim e compadece-te de mim;",
          "concede a tua força ao teu servo",
          "e salva o filho da tua serva."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Mostra-me um sinal do teu favor,",
          "para que o vejam e se envergonhem os que me aborrecem;",
          "pois tu, Senhor, me ajudas e me consolas."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
