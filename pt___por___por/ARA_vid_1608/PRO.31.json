    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Conselhos para o rei Lemuel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Palavras do rei Lemuel, de Massá, as quais lhe ensinou sua mãe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Que te direi, filho meu? Ó filho do meu ventre?",
          "Que te direi, ó filho dos meus votos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não dês às mulheres a tua força,",
          "nem os teus caminhos, às que destroem os reis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Não é próprio dos reis, ó Lemuel,",
          "não é próprio dos reis beber vinho,",
          "nem dos príncipes desejar bebida forte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Para que não bebam, e se esqueçam da lei,",
          "e pervertam o direito de todos os aflitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dai bebida forte aos que perecem",
          "e vinho, aos amargurados de espírito;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para que bebam, e se esqueçam da sua pobreza,",
          "e de suas fadigas não se lembrem mais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Abre a boca a favor do mudo,",
          "pelo direito de todos os que se acham desamparados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Abre a boca, julga retamente",
          "e faze justiça aos pobres e aos necessitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O louvor da mulher virtuosa"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mulher virtuosa, quem a achará?",
          "O seu valor muito excede o de finas joias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O coração do seu marido confia nela,",
          "e não haverá falta de ganho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ela lhe faz bem e não mal,",
          "todos os dias da sua vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Busca lã e linho",
          "e de bom grado trabalha com as mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "É como o navio mercante:",
          "de longe traz o seu pão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "É ainda noite, e já se levanta,",
          "e dá mantimento à sua casa",
          "e a tarefa às suas servas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Examina uma propriedade e adquire-a;",
          "planta uma vinha com as rendas do seu trabalho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Cinge os lombos de força",
          "e fortalece os braços."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ela percebe que o seu ganho é bom;",
          "a sua lâmpada não se apaga de noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Estende as mãos ao fuso,",
          "mãos que pegam na roca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Abre a mão ao aflito;",
          "e ainda a estende ao necessitado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No tocante à sua casa, não teme a neve,",
          "pois todos andam vestidos de lã escarlate."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Faz para si cobertas,",
          "veste-se de linho fino e de púrpura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Seu marido é estimado entre os juízes,",
          "quando se assenta com os anciãos da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Ela faz roupas de linho fino, e vende-as,",
          "e dá cintas aos mercadores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "A força e a dignidade são os seus vestidos,",
          "e, quanto ao dia de amanhã, não tem preocupações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Fala com sabedoria,",
          "e a instrução da bondade está na sua língua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Atende ao bom andamento da sua casa",
          "e não come o pão da preguiça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Levantam-se seus filhos e lhe chamam ditosa;",
          "seu marido a louva, dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Muitas mulheres procedem virtuosamente,",
          "mas tu a todas sobrepujas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Enganosa é a graça, e vã, a formosura,",
          "mas a mulher que teme ao Senhor, essa será louvada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Dai-lhe do fruto das suas mãos,",
          "e de público a louvarão as suas obras."
        ],
        "rlw_lines": []
      }
    ]
  },
