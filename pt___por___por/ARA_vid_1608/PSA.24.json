    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A vinda do Rei da Glória"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ao Senhor pertence a terra e tudo o que nela se contém,",
          "o mundo e os que nele habitam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Fundou-a ele sobre os mares",
          "e sobre as correntes a estabeleceu."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quem subirá ao monte do Senhor?",
          "Quem há de permanecer no seu santo lugar?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O que é limpo de mãos e puro de coração,",
          "que não entrega a sua alma à falsidade,",
          "nem jura dolosamente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Este obterá do Senhor a bênção",
          "e a justiça do Deus da sua salvação."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tal é a geração dos que o buscam,",
          "dos que buscam a face do Deus de Jacó."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Levantai, ó portas, as vossas cabeças;",
          "levantai-vos, ó portais eternos,",
          "para que entre o Rei da Glória."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Quem é o Rei da Glória?",
          "O Senhor, forte e poderoso,",
          "o Senhor, poderoso nas batalhas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Levantai, ó portas, as vossas cabeças;",
          "levantai-vos, ó portais eternos,",
          "para que entre o Rei da Glória."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Quem é esse Rei da Glória?",
          "O Senhor dos Exércitos,",
          "ele é o Rei da Glória."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
