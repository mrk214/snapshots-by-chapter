    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "As maravilhas do êxodo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quando saiu Israel do Egito,",
          "e a casa de Jacó, do meio de um povo de língua estranha,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Judá se tornou o seu santuário,",
          "e Israel, o seu domínio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O mar viu isso e fugiu;",
          "o Jordão tornou atrás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Os montes saltaram como carneiros,",
          "e as colinas, como cordeiros do rebanho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que tens, ó mar, que assim foges?",
          "E tu, Jordão, para tornares atrás?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Montes, por que saltais como carneiros?",
          "E vós, colinas, como cordeiros do rebanho?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Estremece, ó terra, na presença do Senhor,",
          "na presença do Deus de Jacó,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "o qual converteu a rocha em lençol de água",
          "e o seixo, em manancial."
        ],
        "rlw_lines": []
      }
    ]
  },
