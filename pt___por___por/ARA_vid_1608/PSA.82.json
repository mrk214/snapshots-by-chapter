    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Increpadas a injustiça e a parcialidade dos juízes"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asafe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deus assiste na congregação divina;",
          "no meio dos deuses, estabelece o seu julgamento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Até quando julgareis injustamente",
          "e tomareis partido pela causa dos ímpios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Fazei justiça ao fraco e ao órfão,",
          "procedei retamente para com o aflito e o desamparado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Socorrei o fraco e o necessitado;",
          "tirai-os das mãos dos ímpios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eles nada sabem, nem entendem;",
          "vagueiam em trevas;",
          "vacilam todos os fundamentos da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu disse: sois deuses,",
          "sois todos filhos do Altíssimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Todavia, como homens, morrereis",
          "e, como qualquer dos príncipes, haveis de sucumbir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Levanta-te, ó Deus, julga a terra,",
          "pois a ti compete a herança de todas as nações."
        ],
        "rlw_lines": []
      }
    ]
  },
