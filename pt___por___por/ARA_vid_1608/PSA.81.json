    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Exortação a louvor e obediência"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, segundo a melodia “Os lagares”. Salmo de Asafe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantai de júbilo a Deus, força nossa;",
          "celebrai o Deus de Jacó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Salmodiai e fazei soar o tamboril,",
          "a suave harpa com o saltério."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tocai a trombeta na Festa da Lua Nova,",
          "na lua cheia, dia da nossa festa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "É preceito para Israel,",
          "é prescrição do Deus de Jacó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele o ordenou, como lei, a José,",
          "ao sair contra a terra do Egito.",
          "Ouço uma linguagem que eu não conhecera."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Livrei os seus ombros do peso,",
          "e suas mãos foram livres dos cestos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Clamaste na angústia, e te livrei;",
          "do recôndito do trovão eu te respondi",
          "e te experimentei junto às águas de Meribá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ouve, povo meu, quero exortar-te.",
          "Ó Israel, se me escutasses!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não haja no meio de ti deus alheio,",
          "nem te prostres ante deus estranho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eu sou o Senhor, teu Deus,",
          "que te tirei da terra do Egito.",
          "Abre bem a boca, e ta encherei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mas o meu povo não me quis escutar a voz,",
          "e Israel não me atendeu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Assim, deixei-o andar na teimosia do seu coração;",
          "siga os seus próprios conselhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ah! Se o meu povo me escutasse,",
          "se Israel andasse nos meus caminhos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Eu, de pronto, lhe abateria o inimigo",
          "e deitaria mão contra os seus adversários."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os que aborrecem ao Senhor se lhe submeteriam,",
          "e isto duraria para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Eu o sustentaria com o trigo mais fino",
          "e o saciaria com o mel que escorre da rocha."
        ],
        "rlw_lines": []
      }
    ]
  },
