    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Advertência contra a lascívia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Filho meu, atende a minha sabedoria;",
          "à minha inteligência inclina os ouvidos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "para que conserves a discrição,",
          "e os teus lábios guardem o conhecimento;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "porque os lábios da mulher adúltera destilam favos de mel,",
          "e as suas palavras são mais suaves do que o azeite;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "mas o fim dela é amargoso como o absinto,",
          "agudo, como a espada de dois gumes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Os seus pés descem à morte;",
          "os seus passos conduzem-na ao inferno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ela não pondera a vereda da vida;",
          "anda errante nos seus caminhos e não o sabe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Agora, pois, filho, dá-me ouvidos",
          "e não te desvies das palavras da minha boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Afasta o teu caminho da mulher adúltera",
          "e não te aproximes da porta da sua casa;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para que não dês a outrem a tua honra,",
          "nem os teus anos, a cruéis;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "para que dos teus bens não se fartem os estranhos,",
          "e o fruto do teu trabalho não entre em casa alheia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "e gemas no fim de tua vida,",
          "quando se consumirem a tua carne e o teu corpo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "e digas: Como aborreci o ensino!",
          "E desprezou o meu coração a disciplina!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "E não escutei a voz dos que me ensinavam,",
          "nem a meus mestres inclinei os ouvidos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Quase que me achei em todo mal",
          "que sucedeu no meio da assembleia e da congregação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Bebe a água da tua própria cisterna",
          "e das correntes do teu poço."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Derramar-se-iam por fora as tuas fontes,",
          "e, pelas praças, os ribeiros de águas?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sejam para ti somente",
          "e não para os estranhos contigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Seja bendito o teu manancial,",
          "e alegra-te com a mulher da tua mocidade,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "corça de amores e gazela graciosa.",
          "Saciem-te os seus seios em todo o tempo;",
          "e embriaga-te sempre com as suas carícias."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por que, filho meu, andarias cego pela estranha",
          "e abraçarias o peito de outra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Porque os caminhos do homem estão perante os olhos do Senhor,",
          "e ele considera todas as suas veredas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Quanto ao perverso, as suas iniquidades o prenderão,",
          "e com as cordas do seu pecado será detido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ele morrerá pela falta de disciplina,",
          "e, pela sua muita loucura, perdido, cambaleia."
        ],
        "rlw_lines": []
      }
    ]
  },
