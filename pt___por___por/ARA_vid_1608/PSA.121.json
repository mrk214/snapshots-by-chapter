    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus, o fiel guarda dos homens"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de romagem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Elevo os olhos para os montes:",
          "de onde me virá o socorro?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O meu socorro vem do Senhor,",
          "que fez o céu e a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ele não permitirá que os teus pés vacilem;",
          "não dormitará aquele que te guarda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "É certo que não dormita, nem dorme",
          "o guarda de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor é quem te guarda;",
          "o Senhor é a tua sombra à tua direita."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "De dia não te molestará o sol,",
          "nem de noite, a lua."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor te guardará de todo mal;",
          "guardará a tua alma."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "O Senhor guardará a tua saída e a tua entrada,",
          "desde agora e para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
