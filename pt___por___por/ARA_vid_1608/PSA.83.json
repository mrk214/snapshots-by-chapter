    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Julgamento de Deus contra as nações inimigas"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico. Salmo de Asafe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, não te cales;",
          "não te emudeças, nem fiques inativo, ó Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Os teus inimigos se alvoroçam,",
          "e os que te odeiam levantam a cabeça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tramam astutamente contra o teu povo",
          "e conspiram contra os teus protegidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Dizem: Vinde, risquemo-los de entre as nações;",
          "e não haja mais memória do nome de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois tramam concordemente",
          "e firmam aliança contra ti"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "as tendas de Edom e os ismaelitas,",
          "Moabe e os hagarenos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Gebal, Amom e Amaleque,",
          "a Filístia como os habitantes de Tiro;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "também a Assíria se alia com eles,",
          "e se constituem braço forte aos filhos de Ló."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Faze-lhes como fizeste a Midiã,",
          "como a Sísera, como a Jabim na ribeira de Quisom;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "os quais pereceram em En-Dor;",
          "tornaram-se adubo para a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Sejam os seus nobres como Orebe e como Zeebe,",
          "e os seus príncipes, como Zeba e como Zalmuna,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "que disseram: Apoderemo-nos",
          "das habitações de Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Deus meu, faze-os como folhas impelidas por um remoinho,",
          "como a palha ao léu do vento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Como o fogo devora um bosque",
          "e a chama abrasa os montes,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "assim, persegue-os com a tua tempestade",
          "e amedronta-os com o teu vendaval."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Enche-lhes o rosto de ignomínia,",
          "para que busquem o teu nome, Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sejam envergonhados e confundidos perpetuamente;",
          "perturbem-se e pereçam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "E reconhecerão que só tu,",
          "cujo nome é Senhor,",
          "és o Altíssimo sobre toda a terra."
        ],
        "rlw_lines": []
      }
    ]
  },
