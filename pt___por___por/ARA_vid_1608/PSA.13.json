    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração de fé"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Salmo de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Até quando, Senhor?",
          "Esquecer-te-ás de mim para sempre?",
          "Até quando ocultarás de mim o rosto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Até quando estarei eu relutando dentro de minha alma,",
          "com tristeza no coração cada dia?",
          "Até quando se erguerá contra mim o meu inimigo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Atenta para mim, responde-me, Senhor, Deus meu!",
          "Ilumina-me os olhos, para que eu não durma o sono da morte;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "para que não diga o meu inimigo: Prevaleci contra ele;",
          "e não se regozijem os meus adversários, vindo eu a vacilar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "No tocante a mim, confio na tua graça;",
          "regozije-se o meu coração na tua salvação."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cantarei ao Senhor,",
          "porquanto me tem feito muito bem."
        ],
        "rlw_lines": []
      }
    ]
  },
