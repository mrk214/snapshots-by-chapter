    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pelo rei"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. Com instrumentos de cordas. De Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ouve, ó Deus, a minha súplica;",
          "atende à minha oração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Desde os confins da terra clamo por ti,",
          "no abatimento do meu coração.",
          "Leva-me para a rocha que é alta demais para mim;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "pois tu me tens sido refúgio",
          "e torre forte contra o inimigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Assista eu no teu tabernáculo, para sempre;",
          "no esconderijo das tuas asas, eu me abrigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois ouviste, ó Deus, os meus votos",
          "e me deste a herança dos que temem o teu nome."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dias sobre dias acrescentas ao rei;",
          "duram os seus anos gerações após gerações."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Permaneça para sempre diante de Deus;",
          "concede-lhe que a bondade e a fidelidade o preservem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Assim, salmodiarei o teu nome para sempre,",
          "para cumprir, dia após dia, os meus votos."
        ],
        "rlw_lines": []
      }
    ]
  },
