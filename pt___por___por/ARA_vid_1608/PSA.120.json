    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Contra as más línguas"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de romagem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Na minha angústia, clamo ao Senhor,",
          "e ele me ouve."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Senhor, livra-me dos lábios mentirosos,",
          "da língua enganadora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que te será dado ou que te será acrescentado,",
          "ó língua enganadora?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Setas agudas do valente",
          "e brasas vivas de zimbro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ai de mim, que peregrino em Meseque",
          "e habito nas tendas de Quedar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Já há tempo demais que habito",
          "com os que odeiam a paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sou pela paz; quando, porém, eu falo,",
          "eles teimam pela guerra."
        ],
        "rlw_lines": []
      }
    ]
  },
