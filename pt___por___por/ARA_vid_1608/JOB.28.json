    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O homem apropria-se das riquezas da terra"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Na verdade, a prata tem suas minas,",
          "e o ouro, que se refina, o seu lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O ferro tira-se da terra,",
          "e da pedra se funde o cobre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os homens põem termo à escuridão",
          "e até aos últimos confins procuram as pedras",
          "ocultas nas trevas e na densa escuridade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Abrem entrada para minas longe da habitação dos homens,",
          "esquecidos dos transeuntes;",
          "e, assim, longe deles, dependurados, oscilam de um lado para outro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Da terra procede o pão,",
          "mas embaixo é revolvida como por fogo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Nas suas pedras se encontra safira,",
          "e há pó que contém ouro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Essa vereda, a ave de rapina a ignora,",
          "e jamais a viram os olhos do falcão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Nunca a pisaram feras majestosas,",
          "nem o leãozinho passou por ela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Estende o homem a mão contra o rochedo",
          "e revolve os montes desde as suas raízes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Abre canais nas pedras,",
          "e os seus olhos veem tudo o que há de mais precioso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tapa os veios de água, e nem uma gota sai deles,",
          "e traz à luz o que estava escondido."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A verdadeira sabedoria é dom de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mas onde se achará a sabedoria?",
          "E onde está o lugar do entendimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O homem não conhece o valor dela,",
          "nem se acha ela na terra dos viventes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O abismo diz: Ela não está em mim;",
          "e o mar diz: Não está comigo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Não se dá por ela ouro fino,",
          "nem se pesa prata em câmbio dela."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O seu valor não se pode avaliar pelo ouro de Ofir,",
          "nem pelo precioso ônix, nem pela safira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O ouro não se iguala a ela, nem o cristal;",
          "ela não se trocará por joia de ouro fino;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "ela faz esquecer o coral e o cristal;",
          "a aquisição da sabedoria é melhor que a das pérolas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Não se lhe igualará o topázio da Etiópia,",
          "nem se pode avaliar por ouro puro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Donde, pois, vem a sabedoria,",
          "e onde está o lugar do entendimento?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Está encoberta aos olhos de todo vivente",
          "e oculta às aves do céu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "O abismo e a morte dizem:",
          "Ouvimos com os nossos ouvidos a sua fama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Deus lhe entende o caminho,",
          "e ele é quem sabe o seu lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Porque ele perscruta até as extremidades da terra,",
          "vê tudo o que há debaixo dos céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Quando regulou o peso do vento",
          "e fixou a medida das águas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "quando determinou leis para a chuva",
          "e caminho para o relâmpago dos trovões,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "então, viu ele a sabedoria e a manifestou;",
          "estabeleceu-a e também a esquadrinhou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "E disse ao homem:",
          "Eis que o temor do Senhor é a sabedoria,",
          "e o apartar-se do mal é o entendimento."
        ],
        "rlw_lines": []
      }
    ]
  },
