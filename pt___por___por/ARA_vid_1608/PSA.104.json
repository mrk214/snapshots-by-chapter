    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvor ao Deus criador"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bendize, ó minha alma, ao Senhor!",
          "Senhor, Deus meu, como tu és magnificente:",
          "sobrevestido de glória e majestade,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "coberto de luz como de um manto.",
          "Tu estendes o céu como uma cortina,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "pões nas águas o vigamento da tua morada,",
          "tomas as nuvens por teu carro",
          "e voas nas asas do vento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Fazes a teus anjos ventos",
          "e a teus ministros, labaredas de fogo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Lançaste os fundamentos da terra,",
          "para que ela não vacile em tempo nenhum."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tomaste o abismo por vestuário e a cobriste;",
          "as águas ficaram acima das montanhas;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "à tua repreensão, fugiram,",
          "à voz do teu trovão, bateram em retirada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Elevaram-se os montes, desceram os vales,",
          "até ao lugar que lhes havias preparado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Puseste às águas divisa que não ultrapassarão,",
          "para que não tornem a cobrir a terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tu fazes rebentar fontes no vale,",
          "cujas águas correm entre os montes;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "dão de beber a todos os animais do campo;",
          "os jumentos selvagens matam a sua sede."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Junto delas têm as aves do céu o seu pouso",
          "e, por entre a ramagem, desferem o seu canto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Do alto de tua morada, regas os montes;",
          "a terra farta-se do fruto de tuas obras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Fazes crescer a relva para os animais",
          "e as plantas, para o serviço do homem,",
          "de sorte que da terra tire o seu pão,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "o vinho, que alegra o coração do homem,",
          "o azeite, que lhe dá brilho ao rosto,",
          "e o alimento, que lhe sustém as forças."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Avigoram-se as árvores do Senhor",
          "e os cedros do Líbano que ele plantou,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "em que as aves fazem seus ninhos;",
          "quanto à cegonha, a sua casa é nos ciprestes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Os altos montes são das cabras montesinhas,",
          "e as rochas, o refúgio dos arganazes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Fez a lua para marcar o tempo;",
          "o sol conhece a hora do seu ocaso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Dispões as trevas, e vem a noite,",
          "na qual vagueiam os animais da selva."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Os leõezinhos rugem pela presa",
          "e buscam de Deus o sustento;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "em vindo o sol, eles se recolhem",
          "e se acomodam nos seus covis."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Sai o homem para o seu trabalho",
          "e para o seu encargo até à tarde."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Que variedade, Senhor, nas tuas obras!",
          "Todas com sabedoria as fizeste;",
          "cheia está a terra das tuas riquezas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Eis o mar vasto, imenso,",
          "no qual se movem seres sem conta,",
          "animais pequenos e grandes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Por ele transitam os navios",
          "e o monstro marinho que formaste para nele folgar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Todos esperam de ti",
          "que lhes dês de comer a seu tempo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Se lhes dás, eles o recolhem;",
          "se abres a mão, eles se fartam de bens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Se ocultas o rosto, eles se perturbam;",
          "se lhes cortas a respiração, morrem",
          "e voltam ao seu pó."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Envias o teu Espírito, eles são criados,",
          "e, assim, renovas a face da terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "A glória do Senhor seja para sempre!",
          "Exulte o Senhor por suas obras!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Com só olhar para a terra, ele a faz tremer;",
          "toca as montanhas, e elas fumegam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Cantarei ao Senhor enquanto eu viver;",
          "cantarei louvores ao meu Deus durante a minha vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Seja-lhe agradável a minha meditação;",
          "eu me alegrarei no Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Desapareçam da terra os pecadores,",
          "e já não subsistam os perversos.",
          "Bendize, ó minha alma, ao Senhor!",
          "Aleluia!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
