    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Honras somente a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Não a nós, Senhor, não a nós,",
          "mas ao teu nome dá glória,",
          "por amor da tua misericórdia e da tua fidelidade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Por que diriam as nações:",
          "Onde está o Deus deles?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "No céu está o nosso Deus",
          "e tudo faz como lhe agrada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Prata e ouro são os ídolos deles,",
          "obra das mãos de homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Têm boca e não falam;",
          "têm olhos e não veem;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "têm ouvidos e não ouvem;",
          "têm nariz e não cheiram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Suas mãos não apalpam;",
          "seus pés não andam;",
          "som nenhum lhes sai da garganta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tornem-se semelhantes a eles os que os fazem",
          "e quantos neles confiam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Israel confia no Senhor;",
          "ele é o seu amparo e o seu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "A casa de Arão confia no Senhor;",
          "ele é o seu amparo e o seu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Confiam no Senhor os que temem o Senhor;",
          "ele é o seu amparo e o seu escudo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "De nós se tem lembrado o Senhor; ele nos abençoará;",
          "abençoará a casa de Israel,",
          "abençoará a casa de Arão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ele abençoa os que temem o Senhor,",
          "tanto pequenos como grandes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor vos aumente bênçãos mais e mais,",
          "sobre vós e sobre vossos filhos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Sede benditos do Senhor,",
          "que fez os céus e a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Os céus são os céus do Senhor,",
          "mas a terra, deu-a ele aos filhos dos homens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os mortos não louvam o Senhor,",
          "nem os que descem à região do silêncio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Nós, porém, bendiremos o Senhor,",
          "desde agora e para sempre.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
