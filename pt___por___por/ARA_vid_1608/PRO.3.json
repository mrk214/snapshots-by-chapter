    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Exortações da Sabedoria a obedecer ao Senhor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Filho meu, não te esqueças dos meus ensinos,",
          "e o teu coração guarde os meus mandamentos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "porque eles aumentarão os teus dias",
          "e te acrescentarão anos de vida e paz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Não te desamparem a benignidade e a fidelidade;",
          "ata-as ao pescoço;",
          "escreve-as na tábua do teu coração"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "e acharás graça e boa compreensão",
          "diante de Deus e dos homens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Confia no Senhor de todo o teu coração",
          "e não te estribes no teu próprio entendimento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Reconhece-o em todos os teus caminhos,",
          "e ele endireitará as tuas veredas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Não sejas sábio aos teus próprios olhos;",
          "teme ao Senhor e aparta-te do mal;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "será isto saúde para o teu corpo",
          "e refrigério, para os teus ossos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Honra ao Senhor com os teus bens",
          "e com as primícias de toda a tua renda;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "e se encherão fartamente os teus celeiros,",
          "e transbordarão de vinho os teus lagares."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Filho meu, não rejeites a disciplina do Senhor,",
          "nem te enfades da sua repreensão."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Porque o Senhor repreende a quem ama,",
          "assim como o pai, ao filho a quem quer bem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Feliz o homem que acha sabedoria,",
          "e o homem que adquire conhecimento;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "porque melhor é o lucro que ela dá do que o da prata,",
          "e melhor a sua renda do que o ouro mais fino."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mais preciosa é do que pérolas,",
          "e tudo o que podes desejar não é comparável a ela."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O alongar-se da vida está na sua mão direita,",
          "na sua esquerda, riquezas e honra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Os seus caminhos são caminhos deliciosos,",
          "e todas as suas veredas, paz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "É árvore de vida para os que a alcançam,",
          "e felizes são todos os que a retêm."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "O Senhor com sabedoria fundou a terra,",
          "com inteligência estabeleceu os céus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Pelo seu conhecimento os abismos se rompem,",
          "e as nuvens destilam orvalho."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Filho meu, não se apartem estas coisas dos teus olhos;",
          "guarda a verdadeira sabedoria e o bom siso;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "porque serão vida para a tua alma",
          "e adorno ao teu pescoço."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Então, andarás seguro no teu caminho,",
          "e não tropeçará o teu pé."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Quando te deitares, não temerás;",
          "deitar-te-ás, e o teu sono será suave."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Não temas o pavor repentino,",
          "nem a arremetida dos perversos, quando vier."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Porque o Senhor será a tua segurança",
          "e guardará os teus pés de serem presos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Não te furtes a fazer o bem a quem de direito,",
          "estando na tua mão o poder de fazê-lo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Não digas ao teu próximo: Vai e volta amanhã;",
          "então, to darei, se o tens agora contigo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Não maquines o mal contra o teu próximo,",
          "pois habita junto de ti confiadamente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Jamais pleiteies com alguém sem razão,",
          "se te não houver feito mal."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Não tenhas inveja do homem violento,",
          "nem sigas nenhum de seus caminhos;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "porque o Senhor abomina o perverso,",
          "mas aos retos trata com intimidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "A maldição do Senhor habita na casa do perverso,",
          "porém a morada dos justos ele abençoa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Certamente, ele escarnece dos escarnecedores,",
          "mas dá graça aos humildes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Os sábios herdarão honra,",
          "mas os loucos tomam sobre si a ignomínia."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
