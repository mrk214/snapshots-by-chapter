    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvor ao Criador e Preservador"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Exultai, ó justos, no Senhor!",
          "Aos retos fica bem louvá-lo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Celebrai o Senhor com harpa,",
          "louvai-o com cânticos no saltério de dez cordas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Entoai-lhe novo cântico,",
          "tangei com arte e com júbilo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Porque a palavra do Senhor é reta,",
          "e todo o seu proceder é fiel."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ele ama a justiça e o direito;",
          "a terra está cheia da bondade do Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os céus por sua palavra se fizeram,",
          "e, pelo sopro de sua boca, o exército deles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele ajunta em montão as águas do mar;",
          "e em reservatório encerra as grandes vagas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tema ao Senhor toda a terra,",
          "temam-no todos os habitantes do mundo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Pois ele falou, e tudo se fez;",
          "ele ordenou, e tudo passou a existir."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O Senhor frustra os desígnios das nações",
          "e anula os intentos dos povos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O conselho do Senhor dura para sempre;",
          "os desígnios do seu coração, por todas as gerações."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Feliz a nação cujo Deus é o Senhor,",
          "e o povo que ele escolheu para sua herança."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "O Senhor olha dos céus;",
          "vê todos os filhos dos homens;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "do lugar de sua morada, observa",
          "todos os moradores da terra,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "ele, que forma o coração de todos eles,",
          "que contempla todas as suas obras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Não há rei que se salve com o poder dos seus exércitos;",
          "nem por sua muita força se livra o valente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "O cavalo não garante vitória;",
          "a despeito de sua grande força, a ninguém pode livrar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Eis que os olhos do Senhor estão sobre os que o temem,",
          "sobre os que esperam na sua misericórdia,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "para livrar-lhes a alma da morte,",
          "e, no tempo da fome, conservar-lhes a vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Nossa alma espera no Senhor,",
          "nosso auxílio e escudo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Nele, o nosso coração se alegra,",
          "pois confiamos no seu santo nome."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Seja sobre nós, Senhor, a tua misericórdia,",
          "como de ti esperamos."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
