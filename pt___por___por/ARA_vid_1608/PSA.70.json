    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Petição por auxílio divino"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto. De Davi. Em memória"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Praza-te, ó Deus, em livrar-me;",
          "dá-te pressa, ó Senhor, em socorrer-me."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Sejam envergonhados e cobertos de vexame",
          "os que me demandam a vida;",
          "tornem atrás e cubram-se de ignomínia",
          "os que se comprazem no meu mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Retrocedam por causa da sua ignomínia",
          "os que dizem: Bem feito! Bem feito!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Folguem e em ti se rejubilem",
          "todos os que te buscam;",
          "e os que amam a tua salvação",
          "digam sempre: Deus seja magnificado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eu sou pobre e necessitado;",
          "ó Deus, apressa-te em valer-me,",
          "pois tu és o meu amparo e o meu libertador.",
          "Senhor, não te detenhas!"
        ],
        "rlw_lines": []
      }
    ]
  },
