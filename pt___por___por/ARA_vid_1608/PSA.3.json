    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confiança em Deus, na adversidade"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi quando fugia de Absalão, seu filho"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Senhor, como tem crescido o número dos meus adversários!",
          "São numerosos os que se levantam contra mim."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "São muitos os que dizem de mim:",
          "Não há em Deus salvação para ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porém tu, Senhor, és o meu escudo,",
          "és a minha glória e o que exaltas a minha cabeça."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Com a minha voz clamo ao Senhor,",
          "e ele do seu santo monte me responde."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Deito-me e pego no sono;",
          "acordo, porque o Senhor me sustenta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Não tenho medo de milhares do povo",
          "que tomam posição contra mim de todos os lados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Levanta-te, Senhor!",
          "Salva-me, Deus meu,",
          "pois feres nos queixos a todos os meus inimigos",
          "e aos ímpios quebras os dentes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Do Senhor é a salvação,",
          "e sobre o teu povo, a tua bênção."
        ],
        "rlw_lines": []
      }
    ]
  },
