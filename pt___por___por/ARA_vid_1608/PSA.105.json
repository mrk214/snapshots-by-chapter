    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "As maravilhosas obras do Senhor a favor de Israel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Rendei graças ao Senhor, invocai o seu nome,",
          "fazei conhecidos, entre os povos, os seus feitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cantai-lhe, cantai-lhe salmos;",
          "narrai todas as suas maravilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Gloriai-vos no seu santo nome;",
          "alegre-se o coração dos que buscam o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Buscai o Senhor e o seu poder;",
          "buscai perpetuamente a sua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Lembrai-vos das maravilhas que fez,",
          "dos seus prodígios e dos juízos de seus lábios,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "vós, descendentes de Abraão, seu servo,",
          "vós, filhos de Jacó, seus escolhidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele é o Senhor, nosso Deus;",
          "os seus juízos permeiam toda a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Lembra-se perpetuamente da sua aliança,",
          "da palavra que empenhou para mil gerações;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "da aliança que fez com Abraão",
          "e do juramento que fez a Isaque;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "o qual confirmou a Jacó por decreto",
          "e a Israel por aliança perpétua,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "dizendo: Dar-te-ei a terra de Canaã",
          "como quinhão da vossa herança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Então, eram eles em pequeno número,",
          "pouquíssimos e forasteiros nela;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "andavam de nação em nação,",
          "de um reino para outro reino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "A ninguém permitiu que os oprimisse;",
          "antes, por amor deles, repreendeu a reis,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "dizendo: Não toqueis nos meus ungidos,",
          "nem maltrateis os meus profetas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Fez vir fome sobre a terra",
          "e cortou os meios de se obter pão."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Adiante deles enviou um homem,",
          "José, vendido como escravo;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "cujos pés apertaram com grilhões",
          "e a quem puseram em ferros,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "até cumprir-se a profecia a respeito dele,",
          "e tê-lo provado a palavra do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O rei mandou soltá-lo;",
          "o potentado dos povos o pôs em liberdade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Constituiu-o senhor de sua casa",
          "e mordomo de tudo o que possuía,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "para, a seu talante, sujeitar os seus príncipes",
          "e aos seus anciãos ensinar a sabedoria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Então, Israel entrou no Egito,",
          "e Jacó peregrinou na terra de Cam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Deus fez sobremodo fecundo o seu povo",
          "e o tornou mais forte do que os seus opressores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Mudou-lhes o coração para que odiassem o seu povo",
          "e usassem de astúcia para com os seus servos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "E lhes enviou Moisés, seu servo,",
          "e Arão, a quem escolhera,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "por meio dos quais fez, entre eles,",
          "os seus sinais e maravilhas na terra de Cam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Enviou trevas, e tudo escureceu;",
          "e Moisés e Arão não foram rebeldes à sua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Transformou-lhes as águas em sangue",
          "e assim lhes fez morrer os peixes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Sua terra produziu rãs em abundância,",
          "até nos aposentos dos reis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Ele falou, e vieram nuvens de moscas",
          "e piolhos em todo o seu país."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Por chuva deu-lhes saraiva",
          "e fogo chamejante, na sua terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Devastou-lhes os vinhedos e os figueirais",
          "e lhes quebrou as árvores dos seus limites."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Ele falou, e vieram gafanhotos",
          "e saltões sem conta,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "os quais devoraram toda a erva do país",
          "e comeram o fruto dos seus campos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Também feriu de morte a todos os primogênitos da sua terra,",
          "as primícias do seu vigor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Então, fez sair o seu povo, com prata e ouro,",
          "e entre as suas tribos não havia um só inválido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Alegrou-se o Egito quando eles saíram,",
          "porquanto lhe tinham infundido terror."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Ele estendeu uma nuvem que lhes servisse de toldo",
          "e um fogo para os alumiar de noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Pediram, e ele fez vir codornizes",
          "e os saciou com pão do céu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Fendeu a rocha, e dela brotaram águas,",
          "que correram, qual torrente, pelo deserto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Porque estava lembrado da sua santa palavra",
          "e de Abraão, seu servo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "E conduziu com alegria o seu povo",
          "e, com jubiloso canto, os seus escolhidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Deu-lhes as terras das nações,",
          "e eles se apossaram do trabalho dos povos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "para que lhe guardassem os preceitos",
          "e lhe observassem as leis.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
