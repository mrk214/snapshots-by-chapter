    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "O Senhor, o maior e mais digno objeto de louvor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Louvai, servos do Senhor,",
          "louvai o nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bendito seja o nome do Senhor,",
          "agora e para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Do nascimento do sol até ao ocaso,",
          "louvado seja o nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Excelso é o Senhor, acima de todas as nações,",
          "e a sua glória, acima dos céus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quem há semelhante ao Senhor, nosso Deus,",
          "cujo trono está nas alturas,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "que se inclina para ver",
          "o que se passa no céu e sobre a terra?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele ergue do pó o desvalido",
          "e do monturo, o necessitado,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "para o assentar ao lado dos príncipes,",
          "sim, com os príncipes do seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Faz que a mulher estéril viva em família",
          "e seja alegre mãe de filhos.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
