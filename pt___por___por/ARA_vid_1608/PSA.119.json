      "human": "Salmos 120"
    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Excelência da lei divina"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bem-aventurados os irrepreensíveis no seu caminho,",
          "que andam na lei do Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Bem-aventurados os que guardam as suas prescrições",
          "e o buscam de todo o coração;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "não praticam iniquidade",
          "e andam nos seus caminhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tu ordenaste os teus mandamentos,",
          "para que os cumpramos à risca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tomara sejam firmes os meus passos,",
          "para que eu observe os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Então, não terei de que me envergonhar,",
          "quando considerar em todos os teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Render-te-ei graças com integridade de coração,",
          "quando tiver aprendido os teus retos juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Cumprirei os teus decretos;",
          "não me desampares jamais."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "De que maneira poderá o jovem guardar puro o seu caminho?",
          "Observando-o segundo a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "De todo o coração te busquei;",
          "não me deixes fugir aos teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Guardo no coração as tuas palavras,",
          "para não pecar contra ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Bendito és tu, Senhor;",
          "ensina-me os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Com os lábios tenho narrado",
          "todos os juízos da tua boca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Mais me regozijo com o caminho dos teus testemunhos",
          "do que com todas as riquezas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Meditarei nos teus preceitos",
          "e às tuas veredas terei respeito."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Terei prazer nos teus decretos;",
          "não me esquecerei da tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Sê generoso para com o teu servo,",
          "para que eu viva e observe a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Desvenda os meus olhos,",
          "para que eu contemple as maravilhas da tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Sou peregrino na terra;",
          "não escondas de mim os teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Consumida está a minha alma",
          "por desejar, incessantemente, os teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Increpaste os soberbos, os malditos,",
          "que se desviam dos teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Tira de sobre mim o opróbrio e o desprezo,",
          "pois tenho guardado os teus testemunhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Assentaram-se príncipes e falaram contra mim,",
          "mas o teu servo considerou nos teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Com efeito, os teus testemunhos são o meu prazer,",
          "são os meus conselheiros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "A minha alma está apegada ao pó;",
          "vivifica-me segundo a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Eu te expus os meus caminhos, e tu me valeste;",
          "ensina-me os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Faze-me atinar com o caminho dos teus preceitos,",
          "e meditarei nas tuas maravilhas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "A minha alma, de tristeza, verte lágrimas;",
          "fortalece-me segundo a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Afasta de mim o caminho da falsidade",
          "e favorece-me com a tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Escolhi o caminho da fidelidade",
          "e decidi-me pelos teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Aos teus testemunhos me apego;",
          "não permitas, Senhor, seja eu envergonhado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Percorrerei o caminho dos teus mandamentos,",
          "quando me alegrares o coração."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Ensina-me, Senhor, o caminho dos teus decretos,",
          "e os seguirei até ao fim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Dá-me entendimento, e guardarei a tua lei;",
          "de todo o coração a cumprirei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Guia-me pela vereda dos teus mandamentos,",
          "pois nela me comprazo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Inclina-me o coração aos teus testemunhos",
          "e não à cobiça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Desvia os meus olhos, para que não vejam a vaidade,",
          "e vivifica-me no teu caminho."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Confirma ao teu servo a tua promessa",
          "feita aos que te temem."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Afasta de mim o opróbrio, que temo,",
          "porque os teus juízos são bons."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Eis que tenho suspirado pelos teus preceitos;",
          "vivifica-me por tua justiça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Venham também sobre mim as tuas misericórdias, Senhor,",
          "e a tua salvação, segundo a tua promessa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "E saberei responder aos que me insultam,",
          "pois confio na tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Não tires jamais de minha boca a palavra da verdade,",
          "pois tenho esperado nos teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Assim, observarei de contínuo a tua lei,",
          "para todo o sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "E andarei com largueza,",
          "pois me empenho pelos teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Também falarei dos teus testemunhos na presença dos reis",
          "e não me envergonharei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Terei prazer nos teus mandamentos,",
          "os quais eu amo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Para os teus mandamentos, que amo, levantarei as mãos",
          "e meditarei nos teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Lembra-te da promessa que fizeste ao teu servo,",
          "na qual me tens feito esperar."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "O que me consola na minha angústia é isto:",
          "que a tua palavra me vivifica."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Os soberbos zombam continuamente de mim;",
          "todavia, não me afasto da tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Lembro-me dos teus juízos de outrora",
          "e me conforto, ó Senhor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "De mim se apoderou a indignação,",
          "por causa dos pecadores que abandonaram a tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Os teus decretos são motivo dos meus cânticos,",
          "na casa da minha peregrinação."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Lembro-me, Senhor, do teu nome, durante a noite,",
          "e observo a tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "Tem-se dado assim comigo,",
          "porque guardo os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "O Senhor é a minha porção;",
          "eu disse que guardaria as tuas palavras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Imploro de todo o coração a tua graça;",
          "compadece-te de mim, segundo a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Considero os meus caminhos",
          "e volto os meus passos para os teus testemunhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Apresso-me, não me detenho",
          "em guardar os teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Laços de perversos me enleiam;",
          "contudo, não me esqueço da tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "Levanto-me à meia-noite para te dar graças,",
          "por causa dos teus retos juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "Companheiro sou de todos os que te temem",
          "e dos que guardam os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "A terra, Senhor, está cheia da tua bondade;",
          "ensina-me os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Tens feito bem ao teu servo,",
          "Senhor, segundo a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Ensina-me bom juízo e conhecimento,",
          "pois creio nos teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          67
        ],
        "lines": [
          "Antes de ser afligido, andava errado,",
          "mas agora guardo a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          68
        ],
        "lines": [
          "Tu és bom e fazes o bem;",
          "ensina-me os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          69
        ],
        "lines": [
          "Os soberbos têm forjado mentiras contra mim;",
          "não obstante, eu guardo de todo o coração os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          70
        ],
        "lines": [
          "Tornou-se-lhes o coração insensível, como se fosse de sebo;",
          "mas eu me comprazo na tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          71
        ],
        "lines": [
          "Foi-me bom ter eu passado pela aflição,",
          "para que aprendesse os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          72
        ],
        "lines": [
          "Para mim vale mais a lei que procede de tua boca",
          "do que milhares de ouro ou de prata."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          73
        ],
        "lines": [
          "As tuas mãos me fizeram e me afeiçoaram;",
          "ensina-me para que aprenda os teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          74
        ],
        "lines": [
          "Alegraram-se os que te temem quando me viram,",
          "porque na tua palavra tenho esperado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          75
        ],
        "lines": [
          "Bem sei, ó Senhor, que os teus juízos são justos",
          "e que com fidelidade me afligiste."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          76
        ],
        "lines": [
          "Venha, pois, a tua bondade consolar-me,",
          "segundo a palavra que deste ao teu servo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          77
        ],
        "lines": [
          "Baixem sobre mim as tuas misericórdias, para que eu viva;",
          "pois na tua lei está o meu prazer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          78
        ],
        "lines": [
          "Envergonhados sejam os soberbos por me haverem oprimido injustamente;",
          "eu, porém, meditarei nos teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          79
        ],
        "lines": [
          "Voltem-se para mim os que te temem",
          "e os que conhecem os teus testemunhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          80
        ],
        "lines": [
          "Seja o meu coração irrepreensível nos teus decretos,",
          "para que eu não seja envergonhado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          81
        ],
        "lines": [
          "Desfalece-me a alma, aguardando a tua salvação;",
          "porém espero na tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          82
        ],
        "lines": [
          "Esmorecem os meus olhos de tanto esperar por tua promessa,",
          "enquanto digo: quando me haverás de consolar?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          83
        ],
        "lines": [
          "Já me assemelho a um odre na fumaça;",
          "contudo, não me esqueço dos teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          84
        ],
        "lines": [
          "Quantos vêm a ser os dias do teu servo?",
          "Quando me farás justiça contra os que me perseguem?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          85
        ],
        "lines": [
          "Para mim abriram covas os soberbos,",
          "que não andam consoante a tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          86
        ],
        "lines": [
          "São verdadeiros todos os teus mandamentos;",
          "eles me perseguem injustamente; ajuda-me."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          87
        ],
        "lines": [
          "Quase deram cabo de mim, na terra;",
          "mas eu não deixo os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          88
        ],
        "lines": [
          "Vivifica-me, segundo a tua misericórdia,",
          "e guardarei os testemunhos oriundos de tua boca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          89
        ],
        "lines": [
          "Para sempre, ó Senhor,",
          "está firmada a tua palavra no céu."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          90
        ],
        "lines": [
          "A tua fidelidade estende-se de geração em geração;",
          "fundaste a terra, e ela permanece."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          91
        ],
        "lines": [
          "Conforme os teus juízos, assim tudo se mantém até hoje;",
          "porque ao teu dispor estão todas as coisas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          92
        ],
        "lines": [
          "Não fosse a tua lei ter sido o meu prazer,",
          "há muito já teria eu perecido na minha angústia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          93
        ],
        "lines": [
          "Nunca me esquecerei dos teus preceitos,",
          "visto que por eles me tens dado vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          94
        ],
        "lines": [
          "Sou teu; salva-me,",
          "pois eu busco os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          95
        ],
        "lines": [
          "Os ímpios me espreitam para perder-me;",
          "mas eu atento para os teus testemunhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          96
        ],
        "lines": [
          "Tenho visto que toda perfeição tem seu limite;",
          "mas o teu mandamento é ilimitado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          97
        ],
        "lines": [
          "Quanto amo a tua lei!",
          "É a minha meditação, todo o dia!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          98
        ],
        "lines": [
          "Os teus mandamentos me fazem mais sábio que os meus inimigos;",
          "porque, aqueles, eu os tenho sempre comigo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          99
        ],
        "lines": [
          "Compreendo mais do que todos os meus mestres,",
          "porque medito nos teus testemunhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          100
        ],
        "lines": [
          "Sou mais prudente que os idosos, porque guardo os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          101
        ],
        "lines": [
          "De todo mau caminho desvio os pés,",
          "para observar a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          102
        ],
        "lines": [
          "Não me aparto dos teus juízos,",
          "pois tu me ensinas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          103
        ],
        "lines": [
          "Quão doces são as tuas palavras ao meu paladar!",
          "Mais que o mel à minha boca."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          104
        ],
        "lines": [
          "Por meio dos teus preceitos, consigo entendimento;",
          "por isso, detesto todo caminho de falsidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          105
        ],
        "lines": [
          "Lâmpada para os meus pés é a tua palavra",
          "e, luz para os meus caminhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          106
        ],
        "lines": [
          "Jurei e confirmei o juramento",
          "de guardar os teus retos juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          107
        ],
        "lines": [
          "Estou aflitíssimo;",
          "vivifica-me, Senhor, segundo a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          108
        ],
        "lines": [
          "Aceita, Senhor, a espontânea oferenda dos meus lábios",
          "e ensina-me os teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          109
        ],
        "lines": [
          "Estou de contínuo em perigo de vida;",
          "todavia, não me esqueço da tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          110
        ],
        "lines": [
          "Armam ciladas contra mim os ímpios;",
          "contudo, não me desvio dos teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          111
        ],
        "lines": [
          "Os teus testemunhos, recebi-os por legado perpétuo,",
          "porque me constituem o prazer do coração."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          112
        ],
        "lines": [
          "Induzo o coração a guardar os teus decretos,",
          "para sempre, até ao fim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          113
        ],
        "lines": [
          "Aborreço a duplicidade,",
          "porém amo a tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          114
        ],
        "lines": [
          "Tu és o meu refúgio e o meu escudo;",
          "na tua palavra, eu espero."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          115
        ],
        "lines": [
          "Apartai-vos de mim, malfeitores;",
          "quero guardar os mandamentos do meu Deus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          116
        ],
        "lines": [
          "Ampara-me, segundo a tua promessa, para que eu viva;",
          "não permitas que a minha esperança me envergonhe."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          117
        ],
        "lines": [
          "Sustenta-me, e serei salvo",
          "e sempre atentarei para os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          118
        ],
        "lines": [
          "Desprezas os que se desviam dos teus decretos,",
          "porque falsidade é a astúcia deles."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          119
        ],
        "lines": [
          "Rejeitas, como escória, todos os ímpios da terra;",
          "por isso, amo os teus testemunhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          120
        ],
        "lines": [
          "Arrepia-se-me a carne com temor de ti,",
          "e temo os teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          121
        ],
        "lines": [
          "Tenho praticado juízo e justiça;",
          "não me entregues aos meus opressores."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          122
        ],
        "lines": [
          "Sê fiador do teu servo para o bem;",
          "não permitas que os soberbos me oprimam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          123
        ],
        "lines": [
          "Desfalecem-me os olhos à espera da tua salvação",
          "e da promessa da tua justiça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          124
        ],
        "lines": [
          "Trata o teu servo segundo a tua misericórdia",
          "e ensina-me os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          125
        ],
        "lines": [
          "Sou teu servo; dá-me entendimento,",
          "para que eu conheça os teus testemunhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          126
        ],
        "lines": [
          "Já é tempo, Senhor, para intervires,",
          "pois a tua lei está sendo violada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          127
        ],
        "lines": [
          "Amo os teus mandamentos mais do que o ouro,",
          "mais do que o ouro refinado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          128
        ],
        "lines": [
          "Por isso, tenho por, em tudo, retos os teus preceitos todos",
          "e aborreço todo caminho de falsidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          129
        ],
        "lines": [
          "Admiráveis são os teus testemunhos;",
          "por isso, a minha alma os observa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          130
        ],
        "lines": [
          "A revelação das tuas palavras esclarece",
          "e dá entendimento aos simples."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          131
        ],
        "lines": [
          "Abro a boca e aspiro,",
          "porque anelo os teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          132
        ],
        "lines": [
          "Volta-te para mim e tem piedade de mim,",
          "segundo costumas fazer aos que amam o teu nome."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          133
        ],
        "lines": [
          "Firma os meus passos na tua palavra,",
          "e não me domine iniquidade alguma."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          134
        ],
        "lines": [
          "Livra-me da opressão do homem,",
          "e guardarei os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          135
        ],
        "lines": [
          "Faze resplandecer o rosto sobre o teu servo",
          "e ensina-me os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          136
        ],
        "lines": [
          "Torrentes de água nascem dos meus olhos,",
          "porque os homens não guardam a tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          137
        ],
        "lines": [
          "Justo és, Senhor,",
          "e retos, os teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          138
        ],
        "lines": [
          "Os teus testemunhos, tu os impuseste com retidão",
          "e com suma fidelidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          139
        ],
        "lines": [
          "O meu zelo me consome,",
          "porque os meus adversários se esquecem da tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          140
        ],
        "lines": [
          "Puríssima é a tua palavra;",
          "por isso, o teu servo a estima."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          141
        ],
        "lines": [
          "Pequeno sou e desprezado;",
          "contudo, não me esqueço dos teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          142
        ],
        "lines": [
          "A tua justiça é justiça eterna,",
          "e a tua lei é a própria verdade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          143
        ],
        "lines": [
          "Sobre mim vieram tribulação e angústia;",
          "todavia, os teus mandamentos são o meu prazer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          144
        ],
        "lines": [
          "Eterna é a justiça dos teus testemunhos;",
          "dá-me a inteligência deles, e viverei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          145
        ],
        "lines": [
          "De todo o coração eu te invoco; ouve-me, Senhor;",
          "observo os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          146
        ],
        "lines": [
          "Clamo a ti; salva-me,",
          "e guardarei os teus testemunhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          147
        ],
        "lines": [
          "Antecipo-me ao alvorecer do dia e clamo;",
          "na tua palavra, espero confiante."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          148
        ],
        "lines": [
          "Os meus olhos antecipam-se às vigílias noturnas,",
          "para que eu medite nas tuas palavras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          149
        ],
        "lines": [
          "Ouve, Senhor, a minha voz, segundo a tua bondade;",
          "vivifica-me, segundo os teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          150
        ],
        "lines": [
          "Aproximam-se de mim os que andam após a maldade;",
          "eles se afastam da tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          151
        ],
        "lines": [
          "Tu estás perto, Senhor,",
          "e todos os teus mandamentos são verdade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          152
        ],
        "lines": [
          "Quanto às tuas prescrições,",
          "há muito sei que as estabeleceste para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          153
        ],
        "lines": [
          "Atenta para a minha aflição e livra-me,",
          "pois não me esqueço da tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          154
        ],
        "lines": [
          "Defende a minha causa e liberta-me;",
          "vivifica-me, segundo a tua promessa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          155
        ],
        "lines": [
          "A salvação está longe dos ímpios,",
          "pois não procuram os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          156
        ],
        "lines": [
          "Muitas, Senhor, são as tuas misericórdias;",
          "vivifica-me, segundo os teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          157
        ],
        "lines": [
          "São muitos os meus perseguidores e os meus adversários;",
          "não me desvio, porém, dos teus testemunhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          158
        ],
        "lines": [
          "Vi os infiéis e senti desgosto,",
          "porque não guardam a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          159
        ],
        "lines": [
          "Considera em como amo os teus preceitos;",
          "vivifica-me, ó Senhor, segundo a tua bondade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          160
        ],
        "lines": [
          "As tuas palavras são em tudo verdade desde o princípio,",
          "e cada um dos teus justos juízos dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          161
        ],
        "lines": [
          "Príncipes me perseguem sem causa,",
          "porém o que o meu coração teme é a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          162
        ],
        "lines": [
          "Alegro-me nas tuas promessas,",
          "como quem acha grandes despojos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          163
        ],
        "lines": [
          "Abomino e detesto a mentira;",
          "porém amo a tua lei."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          164
        ],
        "lines": [
          "Sete vezes no dia, eu te louvo",
          "pela justiça dos teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          165
        ],
        "lines": [
          "Grande paz têm os que amam a tua lei;",
          "para eles não há tropeço."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          166
        ],
        "lines": [
          "Espero, Senhor, na tua salvação",
          "e cumpro os teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          167
        ],
        "lines": [
          "A minha alma tem observado os teus testemunhos;",
          "eu os amo ardentemente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          168
        ],
        "lines": [
          "Tenho observado os teus preceitos e os teus testemunhos,",
          "pois na tua presença estão todos os meus caminhos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          169
        ],
        "lines": [
          "Chegue a ti, Senhor, a minha súplica;",
          "dá-me entendimento, segundo a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          170
        ],
        "lines": [
          "Chegue a minha petição à tua presença;",
          "livra-me segundo a tua palavra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          171
        ],
        "lines": [
          "Profiram louvor os meus lábios,",
          "pois me ensinas os teus decretos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          172
        ],
        "lines": [
          "A minha língua celebre a tua lei,",
          "pois todos os teus mandamentos são justiça."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          173
        ],
        "lines": [
          "Venha a tua mão socorrer-me,",
          "pois escolhi os teus preceitos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          174
        ],
        "lines": [
          "Suspiro, Senhor, por tua salvação;",
          "a tua lei é todo o meu prazer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          175
        ],
        "lines": [
          "Viva a minha alma para louvar-te;",
          "ajudem-me os teus juízos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          176
        ],
        "lines": [
          "Ando errante como ovelha desgarrada;",
          "procura o teu servo,",
          "pois não me esqueço dos teus mandamentos."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
