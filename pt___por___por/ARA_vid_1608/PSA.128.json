    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Temor de Deus e felicidade no lar"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de romagem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Bem-aventurado aquele que teme ao Senhor",
          "e anda nos seus caminhos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Do trabalho de tuas mãos comerás,",
          "feliz serás, e tudo te irá bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tua esposa, no interior de tua casa,",
          "será como a videira frutífera;",
          "teus filhos, como rebentos da oliveira,",
          "à roda da tua mesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Eis como será abençoado o homem",
          "que teme ao Senhor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor te abençoe desde Sião,",
          "para que vejas a prosperidade de Jerusalém",
          "durante os dias de tua vida,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "vejas os filhos de teus filhos.",
          "Paz sobre Israel!"
        ],
        "rlw_lines": []
      }
    ]
  },
