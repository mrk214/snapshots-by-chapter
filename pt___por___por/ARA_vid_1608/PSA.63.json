    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Buscando a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi, quando no deserto de Judá"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, tu és o meu Deus forte; eu te busco ansiosamente;",
          "a minha alma tem sede de ti;",
          "meu corpo te almeja,",
          "como terra árida, exausta, sem água."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Assim, eu te contemplo no santuário,",
          "para ver a tua força e a tua glória."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Porque a tua graça é melhor do que a vida;",
          "os meus lábios te louvam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Assim, cumpre-me bendizer-te enquanto eu viver;",
          "em teu nome, levanto as mãos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Como de banha e de gordura farta-se a minha alma;",
          "e, com júbilo nos lábios, a minha boca te louva,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "no meu leito, quando de ti me recordo",
          "e em ti medito, durante a vigília da noite."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porque tu me tens sido auxílio;",
          "à sombra das tuas asas, eu canto jubiloso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A minha alma apega-se a ti;",
          "a tua destra me ampara."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porém os que me procuram a vida para a destruir",
          "abismar-se-ão nas profundezas da terra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Serão entregues ao poder da espada",
          "e virão a ser pasto dos chacais."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "O rei, porém, se alegra em Deus;",
          "quem por ele jura gloriar-se-á,",
          "pois se tapará a boca dos que proferem mentira."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
