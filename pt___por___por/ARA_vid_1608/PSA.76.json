    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A majestade e o poder de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Ao mestre de canto, com instrumentos de cordas. Salmo de Asafe. Cântico"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Conhecido é Deus em Judá;",
          "grande, o seu nome em Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Em Salém, está o seu tabernáculo,",
          "e, em Sião, a sua morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ali, despedaçou ele os relâmpagos do arco,",
          "o escudo, a espada e a batalha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tu és ilustre e mais glorioso",
          "do que os montes eternos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Despojados foram os de ânimo forte;",
          "jazem a dormir o seu sono,",
          "e nenhum dos valentes",
          "pode valer-se das próprias mãos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ante a tua repreensão, ó Deus de Jacó,",
          "paralisaram carros e cavalos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tu, sim, tu és terrível;",
          "se te iras,",
          "quem pode subsistir à tua vista?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Desde os céus fizeste ouvir o teu juízo;",
          "tremeu a terra e se aquietou,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "ao levantar-se Deus para julgar",
          "e salvar todos os humildes da terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pois até a ira humana há de louvar-te;",
          "e do resíduo das iras te cinges."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Fazei votos e pagai-os ao Senhor, vosso Deus;",
          "tragam presentes todos os que o rodeiam,",
          "àquele que deve ser temido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ele quebranta o orgulho dos príncipes;",
          "é tremendo aos reis da terra."
        ],
        "rlw_lines": []
      }
    ]
  },
