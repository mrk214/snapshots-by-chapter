      "human": "Jó 41"
    },
    "items": [
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Disse mais o Senhor a Jó:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Acaso, quem usa de censuras contenderá com o Todo-Poderoso?",
          "Quem assim argui a Deus que responda."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A resposta humilde de Jó"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Então, Jó respondeu ao Senhor e disse:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Sou indigno; que te responderia eu?",
          "Ponho a mão na minha boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Uma vez falei e não replicarei,",
          "aliás, duas vezes, porém não prosseguirei."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "As manifestações do poder de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Então, o Senhor, do meio de um redemoinho, respondeu a Jó:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cinge agora os lombos como homem;",
          "eu te perguntarei, e tu me responderás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Acaso, anularás tu, de fato, o meu juízo?",
          "Ou me condenarás, para te justificares?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ou tens braço como Deus",
          "ou podes trovejar com a voz como ele o faz?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Orna-te, pois, de excelência e grandeza,",
          "veste-te de majestade e de glória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Derrama as torrentes da tua ira",
          "e atenta para todo soberbo e abate-o."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Olha para todo soberbo e humilha-o,",
          "calca aos pés os perversos no seu lugar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Cobre-os juntamente no pó,",
          "encerra-lhes o rosto no sepulcro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Então, também eu confessarei a teu respeito",
          "que a tua mão direita te dá vitória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Contempla agora o hipopótamo, que eu criei contigo,",
          "que come a erva como o boi."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Sua força está nos seus lombos,",
          "e o seu poder, nos músculos do seu ventre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Endurece a sua cauda como cedro;",
          "os tendões das suas coxas estão entretecidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Os seus ossos são como tubos de bronze,",
          "o seu arcabouço, como barras de ferro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Ele é obra-prima dos feitos de Deus;",
          "quem o fez o proveu de espada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Em verdade, os montes lhe produzem pasto,",
          "onde todos os animais do campo folgam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Deita-se debaixo dos lotos,",
          "no esconderijo dos canaviais e da lama."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Os lotos o cobrem com sua sombra;",
          "os salgueiros do ribeiro o cercam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Se um rio transborda, ele não se apressa;",
          "fica tranquilo ainda que o Jordão se levante até à sua boca."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Acaso, pode alguém apanhá-lo quando ele está olhando?",
          "Ou lhe meter um laço pelo nariz?"
        ],
        "rlw_lines": []
      }
    ]
  },
