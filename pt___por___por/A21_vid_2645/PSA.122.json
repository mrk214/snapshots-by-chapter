    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pela paz de Jerusalém"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de degraus; de Davi"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A legrei-me quando me disseram: Vamos à casa do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ó Jerusalém, nossos pés estão dentro das tuas portas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Jerusalém, que és construída como uma cidade bem estabelecida,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "para onde sobem as tribos, as tribos do Senhor, como testemunho para Israel, a fim de render graças ao nome do Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ali estão os tribunais de justiça, os tribunais da casa de Davi."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Orai pela paz de Jerusalém, prosperem os que te amam!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Haja paz dentro de teus muros e prosperidade em teus palácios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por amor aos meus irmãos e amigos, direi: Haja paz em ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Por amor à casa do Senhor, nosso Deus, buscarei teu bem."
        ],
        "rlw_lines": []
      }
    ]
  },
