        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "àquele que estendeu a terra sobre as águas, pois seu amor dura para sempre;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "àquele que fez os grandes luminares, pois seu amor dura para sempre;"
