        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus é louvado por sua bondade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Rendei graças ao Senhor, pois ele é bom, e seu amor dura para sempre."
