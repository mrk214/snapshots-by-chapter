    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Súplica por livramento"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cântico de degraus"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Na minha angústia clamei ao Senhor, e ele me respondeu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Senhor, livra-me dos lábios mentirosos e da língua enganadora."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O que te será dado ou acrescentado, língua enganadora?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Flechas agudas do guerreiro, com brasas vivas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ai de mim, que vivo em Meseque e habito entre as tendas de Quedar!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Há muito tempo moro com os que odeiam a paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Sou pela paz; mas, até quando falo, eles insistem na guerra."
        ],
        "rlw_lines": []
      }
    ]
  },
