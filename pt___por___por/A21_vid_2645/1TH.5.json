    "name": "1Tessalonicenses"
  },
  "chapter": {
    "chapter_usfm": "1TH.5",
    "is_chapter": true,
    "previous": {
      "usfm": "1TH.4",
      "human": "1Tessalonicenses 4"
    },
    "current": {
      "usfm": "1TH.5",
