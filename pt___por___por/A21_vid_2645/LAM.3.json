    "book_usfm": "LAM",
    "name": "Lamentações"
  },
  "chapter": {
    "chapter_usfm": "LAM.3",
    "previous": {
      "usfm": "LAM.2",
      "human": "Lamentações 2"
    },
    "current": {
      "usfm": "LAM.3",
