    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hino de gratidão"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deem graças a Deus, o Senhor,",
          "porque ele é bom;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Deem graças ao mais poderoso",
          "de todos os deuses;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Deem graças ao mais poderoso",
          "de todos os senhores;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Somente o Senhor faz grandes milagres;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pela sua sabedoria, ele fez os céus;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Ele pôs a terra",
          "sobre as águas profundas;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Ele fez o sol e a lua;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Fez o sol para governar o dia;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Fez a lua e as estrelas",
          "para governarem a noite;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Em cada lar dos egípcios,",
          "Deus matou o primeiro filho;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ele tirou do Egito o povo de Israel;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Ele os tirou com a sua mão forte",
          "e com o seu braço poderoso;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ele dividiu o mar Vermelho",
          "em duas partes;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Fez com que o povo de Israel passasse",
          "pelo meio do mar;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ali, no mar, ele afogou o rei do Egito",
          "e o seu exército;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Deus guiou o seu povo pelo deserto;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Matou reis poderosos;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Matou reis famosos;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Matou Seom, o rei dos amorreus;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "E matou Ogue, rei de Basã;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Ele deu ao seu povo",
          "as terras desses reis;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Deu essas terras ao povo de Israel,",
          "seu servo;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Quando fomos derrotados,",
          "Deus não esqueceu de nós;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Ele nos livrou dos nossos inimigos;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Ele dá comida aos seres humanos",
          "e aos animais;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Deem graças ao Deus do céu;",
          "o seu amor dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
