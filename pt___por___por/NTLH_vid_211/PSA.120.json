    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pedido de ajuda"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canção de peregrinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Quando estive aflito,",
          "pedi ajuda a Deus, o Senhor,",
          "e ele me respondeu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ó Senhor, livra-me",
          "dos mentirosos e dos falsos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mentirosos, que será que Deus",
          "vai fazer com vocês?",
          "Como será que ele vai castigá-los?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ele os castigará com as flechas afiadas",
          "de um soldado e com brasas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Viver entre vocês me faz sofrer tanto",
          "como se eu morasse em Meseque",
          "ou entre a gente de Quedar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Há muito tempo que estou morando",
          "com aqueles que odeiam a paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quando falo de paz,",
          "eles falam a favor de guerra."
        ],
        "rlw_lines": []
      }
    ]
  },
