    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Confiança no amor de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi. Ao regente do coro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Senhor Deus, até quando",
          "esquecerás de mim?",
          "Será para sempre?",
          "Por quanto tempo esconderás de mim",
          "o teu rosto?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Até quando terei de suportar",
          "este sofrimento?",
          "Até quando o meu coração se encherá",
          "dia e noite de tristeza?",
          "Até quando os meus inimigos",
          "me vencerão?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ó Senhor, meu Deus,",
          "olha para mim e responde-me!",
          "Dá-me forças novamente",
          "para que eu não morra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Assim os meus inimigos não poderão",
          "se alegrar com a minha desgraça,",
          "nem poderão dizer:",
          "“Nós o derrotamos!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eu confio no teu amor.",
          "O meu coração ficará alegre,",
          "pois tu me salvarás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "E, porque tens sido bom para mim,",
          "cantarei hinos a ti, ó Senhor."
        ],
        "rlw_lines": []
      }
    ]
  },
