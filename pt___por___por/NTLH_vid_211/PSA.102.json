    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração de um homem aflito"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Oração de um homem aflito que na tristeza derrama as suas queixas na presença de Deus, o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Senhor, ouve a minha oração",
          "e escuta o meu grito pedindo socorro!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Não te escondas de mim",
          "quando estou aflito.",
          "Ouve-me quando eu te chamar",
          "e responde depressa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A minha vida está desaparecendo",
          "como fumaça,",
          "e o meu corpo queima",
          "como se estivesse no fogo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Estou acabado como a grama",
          "que foi cortada e pisada;",
          "não tenho nem vontade de comer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Fico gemendo alto;",
          "sou apenas pele e osso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Sou como um pássaro",
          "em lugares desertos,",
          "como uma coruja numa casa abandonada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Não consigo dormir;",
          "sou como um pássaro solitário",
          "em cima do telhado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Os meus inimigos me insultam",
          "o dia todo;",
          "aqueles que zombam de mim",
          "usam o meu nome para rogar pragas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9,
          10
        ],
        "lines": [
          "Por causa da tua ira e do teu furor,",
          "as cinzas são a minha comida,",
          "e as lágrimas se misturam",
          "com a minha bebida.",
          "Tu me pegaste e me jogaste fora."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A minha vida é como as sombras",
          "do anoitecer;",
          "vou secando como o capim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Mas tu, ó Senhor Deus,",
          "és Rei para sempre;",
          "todas as gerações futuras lembrarão de ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tu te levantarás",
          "e terás pena de Jerusalém.",
          "Já é hora de teres compaixão dela,",
          "a hora certa já chegou."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ainda que ela esteja destruída,",
          "os teus servos a amam;",
          "eles têm compaixão dela,",
          "embora esteja arrasada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "As nações temerão o Senhor;",
          "todos os reis do mundo",
          "temerão o seu poder."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Quando o Senhor",
          "tornar a construir Jerusalém,",
          "ele mostrará a sua glória."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ele ouvirá o seu povo abandonado",
          "e escutará a sua oração."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Que isso fique escrito",
          "para que os nossos descendentes",
          "saibam o que o Senhor Deus fez",
          "e para que o louvem",
          "aqueles que ainda vão nascer!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Do seu lugar santo, nas alturas,",
          "o Senhor olhou;",
          "do céu ele olhou para a terra"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "a fim de ouvir os gemidos",
          "dos prisioneiros",
          "e libertar os que tinham sido",
          "condenados à morte."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Por isso, o Senhor Deus",
          "será louvado em Jerusalém,",
          "e a sua fama será anunciada ali"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "quando as nações e os reinos",
          "se reunirem para adorá-lo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Ainda sou moço,",
          "mas Deus me tirou as forças",
          "e encurtou a minha vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Ó meu Deus, tu que vives para sempre,",
          "não me leves agora,",
          "antes que eu envelheça!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "No começo, criaste a terra",
          "e, com as tuas próprias mãos,",
          "fizeste o céu."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "A terra e o céu vão acabar,",
          "mas tu viverás para sempre.",
          "A terra e o céu se gastarão",
          "como roupas.",
          "Tu os trocarás como se troca de roupa,",
          "e eles serão jogados fora."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Mas tu és sempre o mesmo,",
          "e a tua vida não tem fim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Os nossos filhos viverão em segurança,",
          "e os seus descendentes terão sempre",
          "a tua proteção."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
