    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pela vitória"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi. Ao regente do coro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó rei, que na hora da angústia",
          "o Senhor Deus responda",
          "à sua oração!",
          "Que o Deus de Jacó o proteja!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Que, do seu Templo,",
          "Deus lhe envie socorro,",
          "e que, do monte Sião, ele o ajude!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que Deus lembre",
          "de todas as suas ofertas",
          "e aceite com prazer os seus",
          "sacrifícios queimados no altar!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Que Deus satisfaça",
          "os seus desejos, ó rei,",
          "e permita que todos os seus planos",
          "deem certo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Então daremos gritos de alegria",
          "pelo seu triunfo",
          "e, em louvor ao nosso Deus,",
          "levantaremos as bandeiras",
          "da vitória.",
          "Que o Senhor atenda",
          "todos os seus pedidos, ó rei!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Agora sei que o Senhor",
          "dá a vitória",
          "ao rei que ele escolheu.",
          "Do seu santo céu, ele lhe responde",
          "e, com o seu grande poder,",
          "ele o torna vitorioso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Alguns confiam",
          "nos seus carros de guerra,",
          "e outros, nos seus cavalos,",
          "mas nós confiamos no poder",
          "do Senhor, nosso Deus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eles tropeçarão e cairão,",
          "mas nós nos levantaremos",
          "e ficaremos firmes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ó Senhor Deus, dá a vitória ao rei!",
          "Responde-nos",
          "quando pedirmos a tua ajuda."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
