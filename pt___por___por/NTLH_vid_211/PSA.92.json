    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hino de gratidão a Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo. Canção para os sábados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Senhor Deus, como é bom",
          "dar-te graças!",
          "Como é bom cantar hinos em tua honra,",
          "ó Altíssimo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Como é bom anunciar de manhã",
          "o teu amor",
          "e de noite, a tua fidelidade,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "com a música de uma harpa",
          "de dez cordas",
          "e ao som da lira!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Ó Senhor Deus, os teus feitos poderosos",
          "me tornam feliz!",
          "Eu canto de alegria",
          "pelas coisas que fazes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que grandes coisas tens feito,",
          "ó Senhor!",
          "Como é difícil entender",
          "os teus pensamentos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Aqui está uma coisa",
          "que o tolo não entende,",
          "e o ignorante não pode compreender:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "os que praticam más ações",
          "crescem como a erva,",
          "e os perversos podem prosperar,",
          "porém eles serão",
          "completamente destruídos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Pois tu, ó Senhor, estás para sempre",
          "acima de tudo e de todos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Nós sabemos que os teus inimigos",
          "morrerão",
          "e que todos os maus serão derrotados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tu me tens tornado forte",
          "como um touro selvagem",
          "e me tens abençoado com a felicidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Tenho visto a derrota",
          "dos meus inimigos",
          "e ouvido os gritos dos maus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Os bons florescem como as palmeiras;",
          "eles crescem como os cedros",
          "dos montes Líbanos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Eles são como árvores",
          "plantadas na casa do Senhor,",
          "que florescem nos pátios",
          "do Templo do nosso Deus."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Na velhice, eles ainda produzem frutos;",
          "são sempre fortes e cheios de vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Isso prova que o Senhor Deus é justo,",
          "prova que ele, a minha rocha,",
          "não comete injustiça."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
