    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Segurança em Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Hino de Davi. Ao regente do coro — com a melodia de “Não Destruas”. Escrito por Davi quando fugiu de Saul na caverna."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Tem misericórdia de mim, ó Deus,",
          "tem misericórdia,",
          "pois em ti procuro segurança!",
          "Na sombra das tuas asas",
          "eu encontro proteção",
          "até que passe o perigo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Eu chamo o Deus Altíssimo;",
          "eu chamo a Deus, que me ajuda",
          "em tudo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Do céu, ele me responderá",
          "e me salvará;",
          "ele derrotará os que me atacam.",
          "Deus me mostrará o seu amor",
          "e a sua fidelidade."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Estou cercado de inimigos;",
          "eles são como leões,",
          "e querem me devorar.",
          "Os seus dentes",
          "são como lanças e flechas,",
          "e a língua deles,",
          "como espada afiada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ó Deus, mostra a tua grandeza nos céus,",
          "e que a tua glória brilhe",
          "no mundo inteiro!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Os meus inimigos armaram",
          "uma armadilha para me pegar,",
          "e eu fiquei muito aflito.",
          "Fizeram uma cova no meu caminho,",
          "mas eles mesmos caíram nela."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O meu coração está firme,",
          "ó Deus, bem firme;",
          "eu cantarei hinos em teu louvor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Acorde, meu coração!",
          "Minha harpa e minha lira, acordem!",
          "Eu acordarei o sol."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Senhor, eu te darei graças",
          "no meio das nações;",
          "eu te louvarei entre os povos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "O teu amor chega até os céus,",
          "e a tua fidelidade, até as nuvens."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Ó Deus, mostra a tua grandeza",
          "nos céus,",
          "e que a tua glória brilhe",
          "no mundo inteiro!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
