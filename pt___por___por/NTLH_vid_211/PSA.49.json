    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ninguém escapa da morte"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo do grupo de Corá. Ao regente do coro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Povos, escutem bem isto!",
          "Ouçam, todos os moradores do mundo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "tanto os poderosos como os humildes,",
          "tanto os ricos como os pobres!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Os meus pensamentos serão claros;",
          "falarei palavras de sabedoria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Vou dar atenção aos provérbios",
          "e, enquanto toco a minha lira,",
          "vou explicá-los."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eu não sinto medo",
          "nas horas de perigo,",
          "quando os meus inimigos me cercam."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Esses perversos confiam",
          "nas suas riquezas",
          "e se orgulham",
          "das suas grandes fortunas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mas ninguém pode salvar a si mesmo,",
          "nem pagar a Deus",
          "o preço da sua vida,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "pois não há dinheiro que pague",
          "a vida de alguém.",
          "Por mais dinheiro",
          "que uma pessoa tenha,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "isso não garante que ela",
          "nunca vá morrer,",
          "que ela vá viver para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Todo mundo vê",
          "que até os sábios morrem,",
          "e morrem também os tolos",
          "e os ignorantes.",
          "E todos deixam as suas riquezas",
          "para os outros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "As suas sepulturas",
          "são os seus lares perpétuos,",
          "onde eles ficam para sempre,",
          "ainda que tenham possuído",
          "muitas terras."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "O ser humano,",
          "por mais importante que seja,",
          "não pode escapar da morte;",
          "como os animais morrem,",
          "ele também morre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Reparem no que acontece",
          "com os que confiam em si mesmos;",
          "vejam o fim daqueles",
          "que estão satisfeitos",
          "com as suas riquezas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O pastor deles — a morte — os leva,",
          "e eles são condenados a morrer",
          "como se fossem ovelhas.",
          "De manhã, as pessoas corretas",
          "os vencerão;",
          "os corpos deles apodrecerão",
          "na sepultura,",
          "longe dos seus lares."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Porém Deus me livrará",
          "do poder da morte,",
          "pois ele me receberá."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Não se preocupem",
          "quando alguém fica rico,",
          "e a sua riqueza aumenta",
          "cada vez mais."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pois, quando morrer,",
          "ele não poderá levar nada;",
          "a sua riqueza não irá com ele",
          "para a sepultura."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ainda que esteja contente",
          "com a sua vida",
          "e seja elogiado por ter sucesso,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "ele, quando morrer, vai reunir-se",
          "com os seus antepassados",
          "no lugar onde a escuridão",
          "dura para sempre."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "O ser humano,",
          "por mais importante que seja,",
          "não pode escapar da morte;",
          "como os animais morrem,",
          "ele também morre."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
