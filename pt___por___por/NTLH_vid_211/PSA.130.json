    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oração pedindo a ajuda de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canção de peregrinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Senhor Deus, eu te chamei",
          "quando estava em profundo desespero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Escuta o meu grito, ó Senhor!",
          "Ouve o meu pedido de socorro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Se tu tivesses feito uma lista",
          "dos nossos pecados,",
          "quem escaparia da condenação?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mas tu nos perdoas,",
          "e por isso nós te tememos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Eu aguardo ansioso a ajuda",
          "de Deus, o Senhor,",
          "e confio na sua palavra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu espero pelo Senhor",
          "mais do que os vigias esperam",
          "o amanhecer,",
          "mais do que os vigias esperam",
          "o nascer do sol."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Povo de Israel, ponha a sua esperança",
          "em Deus, o Senhor,",
          "porque o seu amor é fiel,",
          "e ele sempre está disposto a salvar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele salvará Israel, o seu povo,",
          "de todos os seus pecados."
        ],
        "rlw_lines": []
      }
    ]
  },
