    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus, o juiz de todos"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Asafe."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deus toma o seu lugar",
          "na reunião dos deuses",
          "e no meio deles dá a sua sentença:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "“Vocês precisam parar de julgar",
          "injustamente",
          "e de estar do lado dos maus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Defendam os direitos dos pobres",
          "e dos órfãos;",
          "sejam justos com os aflitos",
          "e os necessitados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Socorram os humildes e os pobres",
          "e os salvem do poder dos maus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "“Vocês são ignorantes,",
          "não entendem nada;",
          "vocês vivem na escuridão.",
          "As bases da lei e da ordem na terra",
          "estão abaladas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Eu disse: ‘Vocês são deuses;",
          "todos vocês são filhos",
          "do Deus Altíssimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Porém morrerão",
          "como os homens comuns morrem;",
          "a vida de vocês acabará",
          "como a de qualquer príncipe.’ ”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Vem, ó Deus, e governa o mundo,",
          "pois todas as nações são tuas!"
        ],
        "rlw_lines": []
      }
    ]
  },
