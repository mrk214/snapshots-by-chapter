    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Deus, o nosso protetor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canção de peregrinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Olho para os montes e pergunto:",
          "“De onde virá o meu socorro?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "O meu socorro vem do Senhor Deus,",
          "que fez o céu e a terra."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ele, o seu protetor,",
          "está sempre alerta",
          "e não deixará que você caia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "O protetor do povo de Israel",
          "nunca dorme, nem cochila."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "O Senhor guardará você;",
          "ele está sempre ao seu lado",
          "para protegê-lo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O sol não lhe fará mal de dia,",
          "nem a lua, de noite."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor guardará você",
          "de todo perigo;",
          "ele protegerá a sua vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ele o guardará quando você for",
          "e quando voltar,",
          "agora e sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
