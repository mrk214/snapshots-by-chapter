    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Elogio a Jerusalém"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canção de peregrinos. De Davi."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Fiquei alegre quando me disseram:",
          "“Vamos à casa de Deus, o Senhor.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "E agora aqui estamos,",
          "dentro de Jerusalém."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Jerusalém é uma cidade construída",
          "de novo,",
          "onde o povo se reúne."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Para cá sobem as tribos,",
          "as tribos de Israel,",
          "para dar graças ao Senhor,",
          "como ele ordenou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Aqui estão os tribunais de justiça,",
          "onde o rei julga o seu povo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Orem para que haja paz em Jerusalém.",
          "“Ó Jerusalém, que prosperem",
          "aqueles que a amam!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que haja paz na cidade protegida",
          "por muralhas!",
          "Que haja segurança nos seus palácios!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Eu amo os meus patrícios e amigos",
          "e por isso digo a Jerusalém:",
          "“Que a paz esteja com você!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Eu amo o Templo do Senhor,",
          "o nosso Deus,",
          "e por isso oro pela prosperidade",
          "de Jerusalém."
        ],
        "rlw_lines": []
      }
    ]
  },
