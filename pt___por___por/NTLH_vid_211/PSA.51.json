    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Arrependimento e perdão"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi. Ao regente do coro. Escrito depois que o profeta Natã falou com Davi a respeito do pecado que este havia cometido com Bate-Seba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Por causa do teu amor, ó Deus,",
          "tem misericórdia de mim.",
          "Por causa da tua grande compaixão",
          "apaga os meus pecados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Purifica-me de todas as minhas",
          "maldades",
          "e lava-me do meu pecado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Pois eu conheço bem os meus erros,",
          "e o meu pecado está sempre",
          "diante de mim."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Contra ti eu pequei —",
          "somente contra ti —",
          "e fiz o que detestas.",
          "Tu tens razão quando me julgas",
          "e estás certo quando me condenas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "De fato, tenho sido mau",
          "desde que nasci;",
          "tenho sido pecador desde o dia",
          "em que fui concebido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O que tu queres é um coração sincero;",
          "enche o meu coração",
          "com a tua sabedoria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tira de mim o meu pecado,",
          "e ficarei limpo;",
          "lava-me, e ficarei mais branco",
          "do que a neve."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Faze-me ouvir outra vez os sons",
          "de alegria e de felicidade;",
          "e, ainda que tenhas me esmagado",
          "e quebrado,",
          "eu serei feliz de novo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Não olhes para os meus pecados",
          "e apaga todas as minhas maldades."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ó Deus, cria em mim um coração puro",
          "e dá-me uma vontade nova e firme!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Não me expulses da tua presença,",
          "nem tires de mim",
          "o teu santo Espírito."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Dá-me novamente a alegria",
          "da tua salvação",
          "e conserva em mim o desejo",
          "de ser obediente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Então ensinarei aos desobedientes",
          "as tuas leis,",
          "e eles voltarão a ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Ó Deus, meu Salvador,",
          "livra-me da morte,",
          "e com alegria eu anunciarei",
          "a tua salvação!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Ó Senhor, põe as palavras certas",
          "na minha boca,",
          "e eu te louvarei!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tu não queres que eu",
          "te ofereça sacrifícios;",
          "tu não gostas que animais",
          "sejam queimados como oferta a ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Ó Deus, o meu sacrifício",
          "é um espírito humilde;",
          "tu não rejeitarás um coração humilde",
          "e arrependido."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ó Deus, com a tua bondade,",
          "ajuda Jerusalém",
          "e constrói de novo as suas muralhas!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Então terás prazer em receber",
          "os sacrifícios certos",
          "e os animais que são",
          "totalmente queimados.",
          "E touros novos serão oferecidos",
          "no teu altar."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
