    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Agradecimento pela vitória"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Deem graças a Deus, o Senhor,",
          "porque ele é bom",
          "e porque o seu amor dura para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Que o povo de Israel diga:",
          "“O seu amor dura para sempre!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Que os sacerdotes de Deus digam:",
          "“O seu amor dura para sempre!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "E que todos os que o temem digam:",
          "“O seu amor dura para sempre!”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Na minha aflição,",
          "eu clamei ao Senhor;",
          "ele me respondeu e me livrou",
          "da angústia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "O Senhor está comigo,",
          "e eu não tenho medo;",
          "que mal pode alguém me fazer?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "O Senhor está comigo;",
          "é ele quem me ajuda.",
          "Por isso, verei a derrota",
          "dos meus inimigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "É melhor confiar no Senhor,",
          "do que depender de seres humanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "É melhor confiar no Senhor",
          "do que depender de pessoas importantes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Os inimigos que estavam em volta de mim",
          "eram muitos,",
          "mas, pelo poder de Deus, o Senhor,",
          "eu acabei com eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Eles me cercaram por todos os lados,",
          "mas, pelo poder do Senhor,",
          "eu acabei com eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Eles se juntaram, como abelhas,",
          "em volta de mim,",
          "porém foram queimados no fogo",
          "como galhos secos;",
          "pelo poder do Senhor,",
          "eu acabei com eles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Eles me atacaram com violência,",
          "e eu quase fui derrotado,",
          "porém o Senhor me ajudou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "O Senhor Deus me torna forte",
          "e poderoso;",
          "ele me salvou."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Escutem os gritos alegres de vitória",
          "no acampamento do povo de Deus:",
          "“O poder do Senhor",
          "nos deu a vitória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Com o seu poder ele fez grandes coisas.",
          "O poder do Senhor",
          "nos deu a vitória.”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Não vou morrer;",
          "pelo contrário, vou viver",
          "e anunciar o que o Senhor Deus",
          "tem feito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ele me castigou com dureza,",
          "mas não deixou que eu morresse."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Abram os portões do Templo para mim;",
          "eu entrarei e louvarei o Senhor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Este é o portão do Senhor;",
          "somente os que lhe obedecem",
          "podem entrar por ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Ó Deus, eu te louvo",
          "porque me escutaste",
          "e me deste a vitória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "A pedra que os construtores rejeitaram",
          "veio a ser a mais importante de todas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Isso foi feito pelo Senhor",
          "e é uma coisa maravilhosa!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Este é o dia da vitória",
          "de Deus, o Senhor;",
          "que seja para nós um dia de felicidade",
          "e alegria!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Salva-nos, ó Senhor, salva-nos!",
          "Dá-nos prosperidade, ó Deus!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Que Deus abençoe aquele que vem",
          "em nome de Deus, o Senhor!",
          "Daqui do Templo do Senhor,",
          "nós abençoamos todos vocês."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "O Senhor é Deus; ele é a nossa luz.",
          "Com ramos nas mãos, comecem a festa",
          "e andem em volta do altar."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Tu és o meu Deus — eu te louvarei;",
          "tu és o meu Deus — eu anunciarei",
          "a tua grandeza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Deem graças a Deus, o Senhor,",
          "porque ele é bom",
          "e porque o seu amor dura para sempre."
        ],
        "rlw_lines": []
      }
    ]
  },
