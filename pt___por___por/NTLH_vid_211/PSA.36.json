    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "A maldade humana e a bondade de Deus"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "De Davi, servo do Senhor. Ao regente do coro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "O pecado fala ao perverso",
          "lá no fundo do seu coração.",
          "O perverso não aprende",
          "a temer a Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Ele se julga muito importante",
          "e pensa que Deus não descobrirá",
          "o seu pecado",
          "e não o condenará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A conversa dele é má",
          "e cheia de mentiras;",
          "ele não tem juízo",
          "e não quer fazer o bem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Deitado na sua cama,",
          "ele planeja maldades.",
          "Ele anda por caminhos",
          "que não são bons",
          "e nunca rejeita as coisas más."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Ó Senhor Deus,",
          "o teu amor chega até o céu,",
          "e a tua fidelidade vai até as nuvens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "A tua justiça é firme",
          "como as grandes montanhas,",
          "e os teus julgamentos são profundos",
          "como o mar.",
          "Ó Senhor Deus, tu cuidas das pessoas",
          "e dos animais."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Como é precioso o teu amor!",
          "Na sombra das tuas asas,",
          "encontramos proteção."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ficamos satisfeitos com a comida",
          "que nos dás com fartura;",
          "tu nos deixas beber do rio",
          "da tua bondade."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tu és a fonte da vida,",
          "e, por causa da tua luz,",
          "nós vemos a luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ó Deus, continua a amar",
          "os que te conhecem",
          "e a fazer o bem",
          "aos que têm um coração honesto!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Não deixes que os orgulhosos",
          "e os maus me pisem",
          "e me obriguem a fugir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Lá estão eles, caídos;",
          "foram derrubados",
          "e não podem se levantar."
        ],
        "rlw_lines": []
      }
    ]
  },
