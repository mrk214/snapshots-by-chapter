    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sede espiritual"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi. Escrito quando estava no deserto de Judá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Deus, tu és o meu Deus;",
          "procuro estar na tua presença.",
          "Todo o meu ser deseja estar contigo;",
          "eu tenho sede de ti",
          "como uma terra cansada,",
          "seca e sem água."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Quero ver-te no Templo;",
          "quero ver como és poderoso e glorioso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "O teu amor é melhor",
          "do que a própria vida,",
          "e por isso eu te louvarei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Enquanto viver,",
          "falarei da tua bondade",
          "e levantarei as mãos a ti em oração."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "As tuas bênçãos",
          "são como alimentos gostosos;",
          "elas me satisfazem,",
          "e por isso canto alegremente",
          "canções de louvor a ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Quando estou deitado,",
          "eu lembro de ti.",
          "Penso em ti a noite toda"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "porque sempre me tens ajudado.",
          "Na sombra das tuas asas",
          "eu canto de alegria."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "A tua mão direita",
          "me segura bem firme,",
          "e eu me apego a ti."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porém aqueles que me querem matar",
          "descerão para o mundo dos mortos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eles serão mortos na batalha,",
          "e os corpos deles serão comidos",
          "pelos animais selvagens."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mas o rei se alegrará",
          "porque Deus lhe dá a vitória.",
          "Os que fazem promessas",
          "em nome de Deus se alegrarão,",
          "mas a boca dos mentirosos",
          "será fechada."
        ],
        "rlw_lines": []
      }
    ]
  },
