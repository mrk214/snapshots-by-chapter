    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hino de louvor"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de louvor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantem hinos a Deus, o Senhor,",
          "todos os moradores da terra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Adorem o Senhor com alegria",
          "e venham cantando até a sua presença."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Lembrem que o Senhor é Deus.",
          "Ele nos fez, e nós somos dele;",
          "somos o seu povo, o seu rebanho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Entrem pelos portões do Templo",
          "com ações de graças,",
          "entrem nos seus pátios com louvor.",
          "Louvem a Deus",
          "e sejam agradecidos a ele."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pois o Senhor é bom;",
          "o seu amor dura para sempre,",
          "e a sua fidelidade não tem fim."
        ],
        "rlw_lines": []
      }
    ]
  },
