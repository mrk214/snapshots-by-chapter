    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Festejar e obedecer"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "De Asafe. Ao regente do coro — com a melodia de “Os Lagares”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Cantem com alegria a Deus,",
          "o nosso defensor;",
          "cantem louvores ao Deus de Jacó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Comecem a música e toquem os tamboris;",
          "toquem músicas alegres nas liras",
          "e nas harpas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Toquem a trombeta para a festa",
          "quando chegar a lua nova",
          "e quando for lua cheia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Isso é lei para Israel,",
          "é uma ordem do Deus de Jacó."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quando Deus marchou",
          "contra a terra do Egito,",
          "ele deu essa lei ao povo de Israel.",
          "Ouvi uma voz, que eu não conhecia,",
          "dizendo:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "“Eu tirei das costas de vocês",
          "as cargas pesadas,",
          "fiz com que vocês ficassem livres",
          "de carregar os cestos cheios",
          "de tijolos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Quando estavam aflitos,",
          "vocês me chamaram,",
          "e eu os salvei.",
          "Lá de onde eu estava escondido,",
          "na tempestade,",
          "eu lhes respondi.",
          "Eu os pus à prova na fonte de Meribá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Meu povo, escute os meus conselhos!",
          "Ó Israel, como eu gostaria",
          "que você me ouvisse!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Nunca mais sirvam",
          "nenhum deus estrangeiro,",
          "nem adorem nenhum deus estranho."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Eu sou o Senhor, o Deus de vocês,",
          "sou aquele que os tirou",
          "da terra do Egito.",
          "Abram a boca, e eu os alimentarei."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "“Mas o meu povo não quis me ouvir;",
          "Israel não me obedeceu."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Portanto, eu deixei que eles andassem",
          "nos seus caminhos de teimosia",
          "e que fizessem o que queriam."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Como gostaria que o meu povo",
          "me ouvisse,",
          "que o povo de Israel me obedecesse!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Eu derrotaria logo os seus inimigos",
          "e castigaria todos os seus adversários."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Aqueles que me odeiam se curvariam",
          "diante de mim,",
          "e o castigo deles duraria para sempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Mas a vocês eu daria o melhor trigo",
          "e os alimentaria com mel do campo,",
          "até que ficassem satisfeitos.”"
        ],
        "rlw_lines": []
      }
    ]
  },
