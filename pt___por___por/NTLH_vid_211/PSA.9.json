    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Louvor a Deus pela sua justiça"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de Davi. Ao regente do coro — com a melodia de “A Morte do Filho”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ó Senhor Deus, eu te louvarei",
          "com todo o coração",
          "e contarei todas as coisas",
          "maravilhosas que tens feito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Por causa de ti eu me alegrarei",
          "e ficarei feliz.",
          "Cantarei louvores a ti,",
          "ó Deus Altíssimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Quando apareces,",
          "os meus inimigos fogem;",
          "eles caem e morrem."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Tu és um juiz justo",
          "e, sentado no teu trono,",
          "fizeste justiça,",
          "julgando a meu favor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Tu condenaste os pagãos",
          "e destruíste os maus;",
          "eles nunca mais serão lembrados."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Arrasaste as cidades",
          "dos nossos inimigos;",
          "elas foram destruídas para sempre,",
          "e eles estão completamente",
          "esquecidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mas o Senhor é Rei para sempre.",
          "Sentado no seu trono,",
          "ele faz os seus julgamentos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Deus governa o mundo com justiça",
          "e julga os povos",
          "de acordo com o que é direito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "O Senhor é um abrigo",
          "para os que são perseguidos;",
          "ele os protege em tempos de aflição."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Ó Senhor, aqueles que te conhecem",
          "confiam em ti,",
          "pois não abandonas",
          "os que procuram a tua ajuda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Cantem louvores ao Senhor,",
          "que reina em Jerusalém.",
          "Anunciem às nações o que ele tem feito."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Pois Deus lembra",
          "dos que são perseguidos;",
          "ele não esquece os seus gemidos",
          "e castiga aqueles que os tratam",
          "com violência."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Ó Senhor Deus, tem compaixão de mim!",
          "Vê como me fazem sofrer",
          "os que me odeiam.",
          "Livra-me da morte"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "a fim de que eu,",
          "na presença do povo de Jerusalém,",
          "possa me levantar",
          "para anunciar o motivo",
          "por que te louvo",
          "e dizer que sou feliz",
          "porque me salvaste da morte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Os pagãos caíram na cova",
          "que fizeram;",
          "foram apanhados na armadilha",
          "que eles mesmos armaram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "O Senhor se torna conhecido",
          "por causa dos seus julgamentos justos,",
          "e os maus caem",
          "nas suas próprias armadilhas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Eles acabarão no mundo dos mortos;",
          "para lá irão todos os que rejeitam",
          "a Deus."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Os pobres não serão esquecidos",
          "para sempre,",
          "e os necessitados não perderão",
          "para sempre a esperança."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Vem, ó Senhor,",
          "e não deixes que os seres humanos",
          "te desafiem!",
          "Põe os povos pagãos diante de ti",
          "e julga-os."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Faze, ó Senhor Deus,",
          "com que sintam medo!",
          "Que eles fiquem sabendo",
          "que são simples criaturas mortais!"
        ],
        "rlw_lines": []
      }
    ]
  },
