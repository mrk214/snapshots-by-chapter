    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Hino de louvor"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aleluia!",
          "Cantem a Deus, o Senhor, uma nova canção.",
          "Louvem a Deus na reunião",
          "dos seus servos fiéis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alegre-se, ó povo de Israel,",
          "por causa do seu Criador!",
          "Fique contente, ó povo de Jerusalém,",
          "por causa do seu Rei!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Louvem a Deus, o Senhor, com danças",
          "e, em seu louvor, toquem pandeiros",
          "e liras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pois o Senhor está contente",
          "com o seu povo;",
          "ele dá aos humildes",
          "a honra da vitória."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que os seus servos fiéis se alegrem",
          "com a vitória",
          "e cantem alegremente nas suas festas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Que eles louvem a Deus,",
          "gritando bem alto,",
          "com espadas afiadas nas mãos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "para derrotar as nações",
          "e castigar os povos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "para prender os seus reis",
          "e as suas autoridades",
          "com pesadas correntes de ferro;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "para castigar as nações",
          "como Deus mandou!",
          "Essa é a vitória",
          "dos seus servos fiéis.",
          "Aleluia!"
        ],
        "rlw_lines": []
      }
    ]
  },
