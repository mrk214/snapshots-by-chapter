  "book": {
    "book_usfm": "PSA",
    "name": "Salmo"
  },
  "chapter": {
    "usfm": "PSA.2",
    "human": "Salmo 2",
    "previous": {
      "usfm": "PSA.1",
      "human": "Salmo 1"
    },
    "next": {
