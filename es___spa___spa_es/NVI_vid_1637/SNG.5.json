    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El amado"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "He entrado ya en mi jardín,",
          "hermana y novia mía,",
          "y en él recojo mirra y bálsamo;",
          "allí me sacio del panal y de su miel;",
          "allí bebo mi vino y mi leche."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Los amigos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¡Comed y bebed, amigos,",
          "y embriagaos de amor!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Cuarto Canto"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Yo dormía, pero mi corazón velaba.",
          "¡Y oí una voz!",
          "¡Mi amado estaba a la puerta!",
          "«Hermana, amada mía;",
          "preciosa paloma mía,",
          "¡déjame entrar!",
          "Mi cabeza está empapada de rocío;",
          "la humedad de la noche corre por mi pelo»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Ya me he quitado la ropa;",
          "¡cómo volver a vestirme!",
          "Ya me he lavado los pies;",
          "¡cómo ensuciarlos de nuevo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mi amado pasó la mano",
          "por la abertura del cerrojo;",
          "¡se estremecieron mis entrañas al sentirlo!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me levanté para abrir a mi amado;",
          "¡gotas de mirra corrían por mis manos!",
          "¡Se deslizaban entre mis dedos",
          "y caían sobre la aldaba!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Le abrí a mi amado,",
          "pero ya no estaba allí.",
          "Se había marchado,",
          "y tras su voz se fue mi alma.",
          "Lo busqué, y no lo hallé.",
          "Lo llamé, y no me respondió."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Me encontraron los centinelas",
          "mientras rondaban la ciudad;",
          "los que vigilan las murallas",
          "me hirieron, me golpearon;",
          "¡me despojaron de mi manto!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Yo os ruego, mujeres de Jerusalén,",
          "que, si encontráis a mi amado,",
          "¡le digáis que estoy enferma de amor!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "El coro"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dinos, bella entre las bellas,",
          "¿en qué aventaja tu amado a otros hombres?",
          "¿En qué aventaja tu amado a otros hombres,",
          "que nos haces tales ruegos?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La amada"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Mi amado es apuesto y trigueño,",
          "y entre diez mil hombres se le distingue."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Su cabeza es oro puro;",
          "su cabellera es ondulada",
          "y negra como un cuervo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sus ojos parecen palomas",
          "posadas junto a los arroyos,",
          "bañadas en leche,",
          "engarzadas como joyas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Sus mejillas son como lechos de bálsamo,",
          "como cultivos de aromáticas hierbas.",
          "Sus labios son azucenas",
          "por las que fluye mirra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Sus brazos son barras de oro",
          "engarzadas sobre topacios.",
          "Su cuerpo es pulido marfil",
          "incrustado de zafiros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Sus piernas son pilares de mármol",
          "que descansan sobre bases de oro puro.",
          "Su porte es como el del Líbano,",
          "esbelto como sus cedros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Su paladar es la dulzura misma;",
          "¡todo él es un encanto!",
          "¡Tal es mi amado, tal es mi amigo,",
          "mujeres de Jerusalén!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
