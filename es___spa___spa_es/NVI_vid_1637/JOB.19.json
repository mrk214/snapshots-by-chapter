    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sexto discurso de Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A esto, Job respondió:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«¿Hasta cuándo vais a estar atormentándome",
          "y aplastándome con vuestras palabras?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Una y otra vez me hacéis reproches;",
          "descaradamente me atacáis."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Aun si fuera verdad que me he desviado,",
          "mis errores son asunto mío."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Si queréis daros importancia a costa mía,",
          "y valeros de mi humillación para atacarme,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "sabed que es Dios quien me ha hecho daño,",
          "quien me ha atrapado en su red."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Aunque grito: “¡Violencia!”, no hallo respuesta;",
          "aunque pido ayuda, no se me hace justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dios me ha cerrado el camino, y no puedo pasar;",
          "ha cubierto de oscuridad mis senderos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Me ha despojado de toda honra;",
          "de la cabeza me ha quitado la corona."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Por todos lados me destroza, como a un árbol;",
          "me aniquila, y arranca de raíz mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Su enojo se ha encendido contra mí;",
          "me cuenta entre sus enemigos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Sus tropas avanzan en tropel;",
          "levantan una rampa para asediarme;",
          "¡acampan alrededor de mi tienda!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "»Hizo que mis hermanos me abandonaran;",
          "hasta mis amigos se han alejado de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Mis parientes y conocidos se distanciaron,",
          "me echaron al olvido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Mis huéspedes y mis criadas me ven como a un extraño,",
          "me miran como a un desconocido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Llamo a mi criado, y no me responde,",
          "aunque yo mismo se lo ruego."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A mi esposa le da asco mi aliento;",
          "a mis hermanos les resulto repugnante."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Hasta los niños me desprecian;",
          "en cuanto me ven, se burlan de mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A todos mis amigos les resulto abominable;",
          "mis seres queridos se han vuelto contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "La piel y la carne se me pegan a los huesos;",
          "¡a duras penas he salvado el pellejo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "»¡Compadeceos de mí, amigos míos;",
          "compadeceos, que la mano de Dios me ha golpeado!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "¿Por qué me acosáis como Dios?",
          "¿No os basta con desollarme vivo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "»¡Ah, si fueran grabadas mis palabras,",
          "si quedaran escritas en un libro!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "¡Si para siempre quedaran sobre la roca,",
          "grabadas con cincel de hierro sobre plomo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Yo sé que mi redentor vive,",
          "y que al final triunfará sobre la muerte."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Y, cuando mi piel haya sido destruida,",
          "todavía veré a Dios con mis propios ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Yo mismo espero verlo;",
          "espero ser yo quien lo vea, y no otro.",
          "¡Este anhelo me consume las entrañas!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "»Vosotros decís: “Vamos a acosarlo,",
          "porque en él está la raíz del mal”."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Pero cuidaos de la espada,",
          "pues con ella viene la ira justiciera,",
          "para que sepáis que hay un juez»."
        ],
        "rlw_lines": []
      }
    ]
  },
