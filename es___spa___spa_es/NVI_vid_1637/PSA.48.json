    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Canción. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Grande es el Señor, y digno de suprema alabanza",
          "en la ciudad de nuestro Dios.",
          "Su monte santo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "bella colina,",
          "es la alegría de toda la tierra.",
          "El monte Sión, en la parte norte,",
          "es la ciudad del gran Rey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "En las fortificaciones de Sión",
          "Dios se ha dado a conocer como refugio seguro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Hubo reyes que unieron sus fuerzas",
          "y que juntos avanzaron contra la ciudad;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "pero al verla quedaron pasmados,",
          "y asustados emprendieron la retirada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Allí el miedo se apoderó de ellos,",
          "y un dolor de parturienta les sobrevino."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¡Con un viento huracanado",
          "destruiste las naves de Tarsis!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tal como lo habíamos oído,",
          "ahora lo hemos visto",
          "en la ciudad del Señor Todopoderoso,",
          "en la ciudad de nuestro Dios:",
          "¡Él la hará permanecer para siempre!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Dentro de tu templo, oh Dios,",
          "meditamos en tu gran amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Tu alabanza, oh Dios, como tu nombre,",
          "llega a los confines de la tierra;",
          "tu derecha está llena de justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "A causa de tus justas decisiones",
          "el monte Sión se alegra",
          "y las aldeas de Judá se regocijan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Caminad alrededor de Sión,",
          "caminad en torno a él",
          "y contad sus torres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Observad bien sus murallas",
          "y examinad sus fortificaciones,",
          "para que se lo cuenten a las generaciones futuras."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "¡Este Dios es nuestro Dios eterno!",
          "¡Él nos guiará para siempre!"
        ],
        "rlw_lines": []
      }
    ]
  },
