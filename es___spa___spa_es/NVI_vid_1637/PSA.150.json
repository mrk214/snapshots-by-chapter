        "lines": [
          "¡Aleluya! ¡Alabado sea el Señor!",
          "Alabad a Dios en su santuario,",
          "alabadle en su poderoso firmamento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Alabadle por sus proezas,",
