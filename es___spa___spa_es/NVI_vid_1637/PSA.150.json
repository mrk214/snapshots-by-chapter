        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Alabadle con sonido de trompeta,",
          "alabadle con el arpa y la lira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Alabadle con panderos y danzas,",
          "alabadle con cuerdas y flautas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Alabadle con címbalos sonoros,",
          "alabadle con címbalos resonantes."
        ],
        "rlw_lines": []
      },
