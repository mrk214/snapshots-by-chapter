    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Para Jedutún. Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Solo en Dios halla descanso mi alma;",
          "de él viene mi salvación."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Solo él es mi roca y mi salvación;",
          "él es mi protector.",
          "¡Jamás habré de caer!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Hasta cuándo atacaréis todos vosotros",
          "a un hombre para derribarlo?",
          "Es como un muro inclinado,",
          "¡como una cerca a punto de derrumbarse!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Solo quieren derribarlo",
          "de su lugar de preeminencia.",
          "Se complacen en la mentira:",
          "bendicen con la boca,",
          "pero maldicen con el corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Solo en Dios halla descanso mi alma;",
          "de él viene mi esperanza."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Solo él es mi roca y mi salvación;",
          "él es mi protector",
          "y no habré de caer."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios es mi salvación y mi gloria;",
          "es la roca que me fortalece;",
          "¡mi refugio está en Dios!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Confía siempre en él, pueblo mío;",
          "ábrele tu corazón cuando estés ante él.",
          "¡Dios es nuestro refugio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Una quimera es la gente de humilde cuna,",
          "y una mentira la gente de alta alcurnia;",
          "si se les pone juntos en la balanza,",
          "todos ellos no pesan nada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "No confiéis en la extorsión",
          "ni os hagáis ilusiones con sus rapiñas;",
          "y, aunque se multipliquen vuestras riquezas,",
          "no pongáis el corazón en ellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Una cosa ha dicho Dios,",
          "y dos veces lo he escuchado:",
          "Que tú, oh Dios, eres poderoso;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "que tú, Señor, eres todo amor;",
          "que tú pagarás a cada uno",
          "según lo que merezcan sus obras."
        ],
        "rlw_lines": []
      }
    ]
  },
