    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Sígase la tonada de «No destruyas». Mictam de David, cuando David había huido de Saúl y estaba en una cueva."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Ten compasión de mí, oh Dios;",
          "ten compasión de mí, que en ti confío.",
          "A la sombra de tus alas me refugiaré,",
          "hasta que haya pasado el peligro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Clamo al Dios Altísimo,",
          "al Dios que me brinda su apoyo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Desde el cielo me tiende la mano y me salva;",
          "reprende a mis perseguidores."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¡Dios me envía su amor y su verdad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Me encuentro en medio de leones,",
          "rodeado de gente rapaz.",
          "Sus dientes son lanzas y flechas;",
          "su lengua, una espada afilada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Pero tú, oh Dios, estás sobre los cielos,",
          "¡tu gloria cubre toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tendieron una red en mi camino,",
          "y mi ánimo quedó por los suelos.",
          "En mi senda cavaron una fosa,",
          "pero ellos mismos cayeron en ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Firme está, oh Dios, mi corazón;",
          "firme está mi corazón.",
          "Voy a cantarte salmos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¡Despierta, alma mía!",
          "¡Despertad, arpa y lira!",
          "¡Haré despertar al nuevo día!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Te alabaré, Señor, entre los pueblos,",
          "te cantaré salmos entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pues tu amor es tan grande que llega a los cielos;",
          "¡tu verdad llega hasta el firmamento!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "¡Tú, oh Dios, estás sobre los cielos;",
          "tu gloria cubre toda la tierra!"
        ],
        "rlw_lines": []
      }
    ]
