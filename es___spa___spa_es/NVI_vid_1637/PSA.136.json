      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dad gracias al Señor, porque él es bueno;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Dad gracias al Dios de dioses;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Dad gracias al Señor omnipotente;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Al único que hace grandes maravillas;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Al que con inteligencia hizo los cielos;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Al que expandió la tierra sobre las aguas;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Al que hizo los grandes luminares;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "El sol, para iluminar el día;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "La luna y las estrellas, para iluminar la noche;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Al que hirió a los primogénitos de Egipto;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Al que sacó de Egipto a Israel;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Con mano poderosa y con brazo extendido;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Al que partió en dos el Mar Rojo;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Y por en medio hizo cruzar a Israel;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero hundió en el Mar Rojo al faraón y a su ejército;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Al que guio a su pueblo por el desierto;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Al que hirió de muerte a grandes reyes;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Al que a reyes poderosos les quitó la vida;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "A Sijón, el rey amorreo;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "A Og, el rey de Basán;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Cuyas tierras entregó como herencia;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Como herencia para su siervo Israel;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Al que nunca nos olvida, aunque estemos humillados;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Al que nos libra de nuestros adversarios;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Al que alimenta a todo ser vivo;",
          "su gran amor perdura para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡Dad gracias al Dios de los cielos!",
          "¡Su gran amor perdura para siempre!"
        ],
