    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Álef"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "No te irrites a causa de los impíos",
          "ni envidies a los que cometen injusticias;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "porque pronto se marchitan, como la hierba;",
          "pronto se secan, como el verdor del pasto."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Confía en el Señor y haz el bien;",
          "establécete en la tierra y mantente fiel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Deléitate en el Señor,",
          "y él te concederá los deseos de tu corazón."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Guímel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Encomienda al Señor tu camino;",
          "confía en él, y él actuará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Hará que tu justicia resplandezca como el alba;",
          "tu justa causa, como el sol de mediodía."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dálet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Guarda silencio ante el Señor,",
          "y espera en él con paciencia;",
          "no te irrites ante el éxito de otros,",
          "de los que maquinan planes malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "He"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Refrena tu enojo, abandona la ira;",
          "no te irrites, pues esto conduce al mal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Porque los impíos serán exterminados,",
          "pero los que esperan en el Señor heredarán la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Vav"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Dentro de poco los malvados dejarán de existir;",
          "por más que los busques, no los encontrarás."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Pero los desposeídos heredarán la tierra",
          "y disfrutarán de gran bienestar."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Zayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Los malvados conspiran contra los justos",
          "y crujen los dientes contra ellos;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "pero el Señor se ríe de los malvados,",
          "pues sabe que les llegará su hora."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los malvados sacan la espada y tensan el arco",
          "para abatir al pobre y al necesitado,",
          "para matar a los que viven con rectitud."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero su propia espada les atravesará el corazón,",
          "y su arco quedará hecho pedazos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Más vale lo poco de un justo",
          "que lo mucho de innumerables malvados;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "porque el brazo de los impíos será quebrado,",
          "pero el Señor sostendrá a los justos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Yod"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "El Señor protege la vida de los íntegros,",
          "y su herencia perdura por siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "En tiempos difíciles serán prosperados;",
          "en épocas de hambre tendrán abundancia."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Caf"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Los malvados, los enemigos del Señor,",
          "acabarán por ser destruidos;",
          "desaparecerán como las flores silvestres,",
          "se desvanecerán como el humo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lámed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Los malvados piden prestado y no pagan,",
          "pero los justos dan con generosidad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Los benditos del Señor heredarán la tierra,",
          "pero los que él maldice serán destruidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Mem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "El Señor afirma los pasos del hombre",
          "cuando le agrada su modo de vivir;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "podrá tropezar, pero no caerá,",
          "porque el Señor lo sostiene de la mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Nun"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "He sido joven y ahora soy viejo,",
          "pero nunca he visto justos en la miseria,",
          "ni que sus hijos mendiguen pan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Prestan siempre con generosidad;",
          "sus hijos son una bendición."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sámej"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Apártate del mal y haz el bien,",
          "y siempre tendrás dónde vivir."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Porque el Señor ama la justicia",
          "y no abandona a quienes le son fieles.",
          "El Señor los protegerá para siempre,",
          "pero acabará con la descendencia de los malvados."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Los justos heredarán la tierra,",
          "y por siempre vivirán en ella."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "La boca del justo imparte sabiduría,",
          "y su lengua emite justicia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "La ley de Dios está en su corazón,",
          "y sus pies jamás resbalan."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tsade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Los malvados acechan a los justos",
          "con la intención de matarlos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "pero el Señor no los dejará caer en sus manos",
          "ni permitirá que los condenen en el juicio."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Qof"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Pero tú, espera en el Señor,",
          "y vive según su voluntad,",
          "que él te exaltará para que heredes la tierra.",
          "Cuando los malvados sean destruidos,",
          "tú lo verás con tus propios ojos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resh"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "He visto al déspota y malvado",
          "extenderse como cedro frondoso."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Pero pasó al olvido y dejó de existir;",
          "lo busqué, y ya no pude encontrarlo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Shin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Observa a los que son íntegros y rectos:",
          "hay porvenir para quien busca la paz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Pero todos los pecadores serán destruidos;",
          "el porvenir de los malvados será el exterminio."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tav"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "La salvación de los justos viene del Señor;",
          "él es su fortaleza en tiempos de angustia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "El Señor los ayuda y los libra;",
          "los libra de los malvados y los salva,",
          "porque en él ponen su confianza."
        ],
        "rlw_lines": []
      }
    ]
  },
