  "book": {
    "book_usfm": "LAM",
    "name": "Lamentaciones"
  },
  "chapter": {
    "usfm": "LAM.3",
    "human": "Lamentaciones 3",
    "previous": {
      "usfm": "LAM.2",
      "human": "Lamentaciones 2"
    },
    "next": {
      "usfm": "LAM.4",
      "human": "Lamentaciones 4"
    },
    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Álef"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Yo soy aquel que ha sufrido la aflicción",
          "bajo la vara de su ira."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Me ha hecho andar en las tinieblas;",
          "me ha apartado de la luz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Una y otra vez, y a todas horas,",
          "su mano se ha vuelto contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Bet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Me ha marchitado la carne y la piel;",
          "me ha quebrantado los huesos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Me ha tendido un cerco",
          "de amargura y tribulaciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Me obliga a vivir en las tinieblas,",
          "como a los que hace tiempo murieron."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Guímel"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Me tiene encerrado, no puedo escapar;",
          "me ha puesto pesadas cadenas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Por más que grito y pido ayuda,",
          "él se niega a escuchar mi oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ha sembrado de piedras mi camino;",
          "ha torcido mis senderos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Dálet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Me vigila como oso agazapado;",
          "me acecha como león."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Me aparta del camino para despedazarme;",
          "¡me deja del todo desvalido!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Con el arco tenso,",
          "me ha hecho blanco de sus flechas."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "He"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Me ha partido el corazón",
          "con las flechas de su aljaba."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Soy el hazmerreír de todo mi pueblo;",
          "todo el día me parodian."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Me ha llenado de amargura,",
          "me ha hecho beber hiel."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Vav"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Me ha estrellado contra el suelo;",
          "me ha hecho morder el polvo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Me ha quitado la paz;",
          "ya no recuerdo lo que es la dicha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Y digo: «La vida se me acaba,",
          "junto con mi esperanza en el Señor»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Zayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Recuerda que ando errante y afligido,",
          "que estoy saturado de hiel y amargura."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Siempre tengo esto presente,",
          "y por eso me deprimo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Pero algo más me viene a la memoria,",
          "lo cual me llena de esperanza:"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Jet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "El gran amor del Señor nunca se acaba,",
          "y su compasión jamás se agota."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Cada mañana se renuevan sus bondades;",
          "¡muy grande es su fidelidad!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Por tanto, digo:",
          "«El Señor es todo lo que tengo.",
          "¡En él esperaré!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tet"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Bueno es el Señor con quienes en él confían,",
          "con todos los que lo buscan."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Bueno es esperar calladamente",
          "que el Señor venga a salvarnos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Bueno es que el hombre aprenda",
          "a llevar el yugo desde su juventud."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Yod"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "¡Dejadle estar solo y en silencio,",
          "porque así el Señor se lo impuso!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¡Que hunda el rostro en el polvo!",
          "¡Tal vez haya esperanza todavía!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "¡Que dé la otra mejilla a quien lo hiera,",
          "y quede así cubierto de oprobio!"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Caf"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "El Señor nos ha rechazado,",
          "pero no será para siempre."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Nos hace sufrir, pero también nos compadece,",
          "porque es muy grande su amor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "El Señor nos hiere y nos aflige,",
          "pero no porque sea de su agrado."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Lámed"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Cuando se aplasta bajo el pie",
          "a todos los prisioneros de la tierra,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "cuando en presencia del Altísimo",
          "se le niegan al hombre sus derechos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "y no se le hace justicia,",
          "¿el Señor no se da cuenta?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Mem"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "¿Quién puede anunciar algo y hacerlo realidad",
          "sin que el Señor dé la orden?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "¿No es acaso por mandato del Altísimo",
          "por lo que acontece lo bueno y lo malo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "¿Por qué habría de quejarse en vida",
          "quien es castigado por sus pecados?"
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Nun"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Hagamos un examen de conciencia",
          "y volvamos al camino del Señor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          41
        ],
        "lines": [
          "Elevemos al Dios de los cielos",
          "nuestro corazón y nuestras manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          42
        ],
        "lines": [
          "Hemos pecado, hemos sido rebeldes,",
          "y tú no has querido perdonarnos."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Sámej"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          43
        ],
        "lines": [
          "Ardiendo en ira nos persigues;",
          "nos masacras sin piedad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          44
        ],
        "lines": [
          "Te envuelves en una nube",
          "para no escuchar nuestra oración."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          45
        ],
        "lines": [
          "Como a escoria despreciable,",
          "nos has arrojado entre las naciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Pe"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          46
        ],
        "lines": [
          "Todos nuestros enemigos abren la boca",
          "para hablar mal de nosotros."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          47
        ],
        "lines": [
          "Hemos sufrido terrores, caídas,",
          "ruina y destrucción."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          48
        ],
        "lines": [
          "Ríos de lágrimas corren por mis mejillas",
          "porque ha sido destruida la capital de mi pueblo."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Ayin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          49
        ],
        "lines": [
          "Se inundarán de lágrimas mis ojos,",
          "sin cesar y sin consuelo,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          50
        ],
        "lines": [
          "hasta que desde el cielo",
          "el Señor se digne mirarnos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          51
        ],
        "lines": [
          "Me duele en lo más profundo del alma",
          "ver sufrir a las mujeres de mi ciudad."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tsade"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          52
        ],
        "lines": [
          "Mis enemigos me persiguen sin razón,",
          "y quieren atraparme como a un ave."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          53
        ],
        "lines": [
          "Me quieren enterrar vivo",
          "y taparme con piedras la salida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          54
        ],
        "lines": [
          "Las aguas me han cubierto la cabeza;",
          "parece que me ha llegado el fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Qof"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          55
        ],
        "lines": [
          "Desde lo más profundo de la fosa",
          "invoqué, Señor, tu nombre,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          56
        ],
        "lines": [
          "y tú escuchaste mi plegaria;",
          "no cerraste tus oídos a mi clamor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          57
        ],
        "lines": [
          "Te invoqué, y viniste a mí;",
          "«No temas», me dijiste."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Resh"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          58
        ],
        "lines": [
          "Tú, Señor, te pusiste de mi parte",
          "y me salvaste la vida."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          59
        ],
        "lines": [
          "Tú, Señor, viste el mal que me causaron;",
          "¡hazme justicia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          60
        ],
        "lines": [
          "Tú notaste su sed de venganza",
          "y todas sus maquinaciones en mi contra."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Shin"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          61
        ],
        "lines": [
          "Señor, tú has escuchado sus insultos",
          "y todas sus maquinaciones en mi contra;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          62
        ],
        "lines": [
          "tú sabes que todo el día mis enemigos",
          "murmuran y se confabulan contra mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          63
        ],
        "lines": [
          "¡Míralos! Hagan lo que hagan,",
          "se burlan de mí en sus canciones."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Tav"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          64
        ],
        "lines": [
          "¡Dales, Señor, su merecido",
          "por todo lo que han hecho!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          65
        ],
        "lines": [
          "Oscurece su entendimiento,",
          "¡y caiga sobre ellos tu maldición!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          66
        ],
        "lines": [
          "Persíguelos, Señor, en tu enojo,",
          "y bórralos de este mundo."
        ],
        "rlw_lines": []
      }
    ]
  },
