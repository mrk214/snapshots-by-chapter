    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Séptimo discurso de Job"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A esto, Job respondió:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "«Escuchad atentamente mis palabras;",
          "concededme este consuelo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Tened un poco de paciencia mientras hablo,",
          "y burlaos si queréis cuando haya terminado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "»¿Acaso dirijo mi queja a los mortales?",
          "¿Por qué creéis que pierdo la paciencia?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Miradme, y quedaos asombrados;",
          "tapaos la boca con la mano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Si pienso en esto, me lleno de espanto;",
          "un escalofrío me corre por el cuerpo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "¿Por qué siguen con vida los malvados,",
          "cada vez más viejos y más ricos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Ven establecerse en torno a ellos",
          "a sus hijos y a sus descendientes."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Tienen paz en su hogar, y están libres de temores;",
          "la vara de Dios no los castiga."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Sus toros son verdaderos sementales;",
          "sus vacas paren y no pierden las crías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Dejan correr a sus niños como si fueran ovejas;",
          "sus pequeñuelos danzan alegres."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Cantan al son del tamboril y del arpa;",
          "se divierten al son de la flauta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pasan la vida con gran bienestar,",
          "y en paz bajan al sepulcro."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "A Dios increpan: “¡Déjanos tranquilos!",
          "No queremos conocer tu voluntad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¿Quién es el Todopoderoso, para que le sirvamos?",
          "¿Qué ganamos con dirigirle nuestras oraciones?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Pero su bienestar no depende de ellos.",
          "¡Jamás me dejaré llevar por sus malos consejos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "»¿Cuándo se ha apagado la lámpara de los malvados?",
          "¿Cuándo les ha sobrevenido el desastre?",
          "¿Cuándo Dios, en su enojo, los ha hecho sufrir"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "como paja que arrebata el viento,",
          "como tamo que se lleva la tormenta?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Me dirán que Dios reserva el castigo",
          "para los hijos del pecador.",
          "¡Mejor que castigue al que peca,",
          "para que escarmiente!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "¡Que sufra el pecador su propia destrucción!",
          "¡Que beba de la ira del Todopoderoso!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "¿Qué le puede importar la familia que deja,",
          "si le quedan pocos meses de vida?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "»¿Quién puede aleccionar a Dios,",
          "si es él quien juzga a las grandes eminencias?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Hay quienes mueren en la flor de la vida,",
          "rebosantes de salud y de paz;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "sus caderas, llenas de grasa;",
          "sus huesos, recios hasta la médula."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Otros mueren con el ánimo amargado,",
          "sin haber disfrutado de lo bueno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "¡En el polvo yacen unos y otros,",
          "todos ellos cubiertos de gusanos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "»Sé muy bien lo que estáis pensando,",
          "y los planes que tenéis de hacerme daño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "También sé que os preguntáis:",
          "“¿Dónde está la mansión del potentado?",
          "¿Dónde están las moradas de los inicuos?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "¿No habéis interrogado a los viajeros?",
          "¿No habéis prestado atención a sus argumentos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "En el día del desastre, el malvado se salva;",
          "¡en el día de la ira, es puesto a salvo!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "¿Y quién le echa en cara su conducta?",
          "¿Quién le da su merecido por sus hechos?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "Cuando lo llevan al sepulcro,",
          "sobre su tumba se pone vigilancia;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "mucha gente le abre paso,",
          "y muchos más cierran el cortejo.",
          "¡Descansa en paz bajo la tierra del valle!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "»¿Cómo esperáis consolarme con discursos sin sentido?",
          "¡Vuestras respuestas no son más que falacias!»"
        ],
        "rlw_lines": []
      }
    ]
  },
