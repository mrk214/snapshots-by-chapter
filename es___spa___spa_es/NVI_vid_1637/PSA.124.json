    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico de los peregrinos. De David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Si el Señor no hubiera estado de nuestra parte",
          "—que lo repita ahora Israel—,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "si el Señor no hubiera estado de nuestra parte",
          "cuando todo el mundo se levantó contra nosotros,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "nos habrían tragado vivos",
          "al encenderse su furor contra nosotros;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "nos habrían inundado las aguas,",
          "el torrente nos habría arrastrado,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡nos habrían arrastrado las aguas turbulentas!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Bendito sea el Señor, que no dejó",
          "que nos despedazaran con sus dientes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Como las aves, hemos escapado",
          "de la trampa del cazador;",
          "¡la trampa se rompió,",
          "y nosotros escapamos!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Nuestra ayuda está en el nombre del Señor,",
          "creador del cielo y de la tierra."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
