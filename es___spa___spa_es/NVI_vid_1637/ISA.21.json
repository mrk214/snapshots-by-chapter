    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Profecía contra Babilonia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Profecía contra el desierto junto al mar:",
          "Como torbellinos que pasan por el Néguev,",
          "se acercan invasores de una temible tierra del desierto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Una visión terrible",
          "me ha sido revelada:",
          "el traidor traiciona,",
          "el destructor destruye.",
          "¡Al ataque, Elam! ¡Al asedio, Media!",
          "Pondré fin a todo gemido."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Por eso mi cuerpo se estremece de dolor,",
          "sufro de agudos dolores,",
          "como los de una parturienta;",
          "lo que oigo, me aturde;",
          "lo que veo, me desconcierta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Se me nubla la mente,",
          "me hace temblar el terror;",
          "el crepúsculo tan anhelado",
          "se me ha vuelto un espanto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¡Ellos preparan las mesas,",
          "extienden los tapices,",
          "y comen y beben!",
          "¡Jefes, poneos de pie!",
          "¡Levantaos y engrasad los escudos!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Porque así me ha dicho el Señor:",
          "«Ve y pon un centinela",
          "que informe de todo lo que vea."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Cuando vea carros de combate tirados por caballos,",
          "o gente montada en asnos o en camellos,",
          "que preste atención,",
          "mucha atención»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Y el centinela gritó:",
          "«¡Día tras día, Señor,",
          "estoy de pie en la torre;",
          "cada noche permanezco",
          "en mi puesto de guardia!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¡Ahí viene un hombre",
          "en un carro de combate tirado por caballos!",
          "Y este es su mensaje:",
          "“¡Ha caído, ha caído Babilonia!",
          "¡Todas las imágenes de sus dioses",
          "han rodado por el suelo!”»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Pueblo mío, trillado como el trigo,",
          "yo te he anunciado lo que he oído",
          "de parte del Señor Todopoderoso,",
          "del Dios de Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Profecía contra Edom"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Profecía contra Dumá:",
          "Alguien me grita desde Seír:",
          "«Centinela, ¿cuánto queda de la noche?",
          "Centinela, ¿cuánto falta para que amanezca?»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "El centinela responde:",
          "«Ya viene la mañana, pero también la noche.",
          "Si queréis preguntar, preguntad;",
          "si queréis volver, volved»."
        ],
        "rlw_lines": []
      },
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Profecía contra Arabia"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Profecía contra Arabia:",
          "Caravanas de Dedán,",
          "acampadas en los matorrales del desierto:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Salid al encuentro del sediento",
          "y ofrecedle agua.",
          "Habitantes de la tierra de Temá,",
          "ofreced alimento a los fugitivos,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "porque huyen de la espada,",
          "de la espada desnuda,",
          "del arco tenso",
          "y del fragor de la batalla."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Porque así me dijo el Señor: «Dentro de un año, contado como lo cuenta un jornalero, toda la magnificencia de Cedar llegará a su fin."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Pocos serán los arqueros, los guerreros de Cedar, que sobrevivan». Lo ha dicho el Señor, el Dios de Israel."
        ],
        "rlw_lines": []
      }
    ]
  },
