    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Oración de Jonás"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Entonces Jonás oró al Señor su Dios desde el vientre del pez."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Dijo:",
          "«En mi angustia clamé al Señor,",
          "y él me respondió.",
          "Desde las entrañas del sepulcro pedí auxilio,",
          "y tú escuchaste mi clamor."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A lo profundo me arrojaste,",
          "al corazón mismo de los mares;",
          "las corrientes me envolvían,",
          "todas tus ondas y tus olas pasaban sobre mí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Y pensé: “He sido expulsado",
          "de tu presencia.",
          "¿Cómo volveré a contemplar",
          "tu santo templo?”"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Las aguas me llegaban hasta el cuello,",
          "lo profundo del océano me envolvía;",
          "las algas se me enredaban en la cabeza,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "arrastrándome a los cimientos de las montañas.",
          "Me tragó la tierra, y para siempre",
          "sus cerrojos se cerraron sobre mí.",
          "Pero tú, Señor, Dios mío,",
          "me rescataste de la fosa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»Al sentir que se me iba la vida,",
          "me acordé del Señor,",
          "y mi oración llegó hasta ti,",
          "hasta tu santo templo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "»Los que siguen a ídolos vanos",
          "abandonan el amor de Dios."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Yo, en cambio, te ofreceré sacrificios",
          "y cánticos de gratitud.",
          "Cumpliré las promesas que te hice.",
          "¡La salvación viene del Señor!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Entonces el Señor dio una orden y el pez vomitó a Jonás en tierra firme."
        ],
        "rlw_lines": []
      }
    ]
  },
