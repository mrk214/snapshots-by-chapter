    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Invitación de la sabiduría y de la necedad"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "La sabiduría construyó su casa",
          "y labró sus siete pilares."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Preparó un banquete, mezcló su vino",
          "y puso la mesa."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Envió a sus doncellas, y ahora clama",
          "desde lo más alto de la ciudad."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«¡Venid conmigo los inexpertos!",
          "—dice a los faltos de juicio—."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Venid, disfrutad de mi pan",
          "y bebed del vino que he mezclado."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Dejad vuestra insensatez, y viviréis;",
          "andaréis por el camino del discernimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "»El que corrige al burlón se gana que lo insulten;",
          "el que reprende al malvado se gana su desprecio."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "No reprendas al insolente, no sea que acabe por odiarte;",
          "reprende al sabio, y te amará."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Instruye al sabio, y se hará más sabio;",
          "enseña al justo, y aumentará su saber."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "»El comienzo de la sabiduría es el temor del Señor;",
          "conocer al Santo es tener discernimiento."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Por mí aumentarán tus días;",
          "muchos años de vida te serán añadidos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Si eres sabio, tu premio será tu sabiduría;",
          "si eres insolente, solo tú lo sufrirás»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "La mujer necia es escandalosa,",
          "frívola y desvergonzada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Se sienta a las puertas de su casa,",
          "se sienta en una silla en lo más alto de la ciudad,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "y llama a los que van por el camino,",
          "a los que no se apartan de su senda."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "«¡Venid conmigo, inexpertos!",
          "—dice a los faltos de juicio—."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "¡Las aguas robadas saben a gloria!",
          "¡El pan sabe a miel si se come a escondidas!»"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Pero estos ignoran que allí está la muerte,",
          "que sus invitados caen al fondo de la fosa."
        ],
        "rlw_lines": []
      }
    ]
  },
