    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Llamado de la sabiduría"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "¿Acaso no está llamando la sabiduría?",
          "¿No está elevando su voz la inteligencia?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Establece su puesto en las alturas,",
          "a la vera del camino y en las encrucijadas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Junto a las puertas que dan a la ciudad,",
          "a la entrada misma, grita fuertemente:"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "«A vosotros los hombres os estoy llamando;",
          "dirijo mi voz a toda la humanidad."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Vosotros los inexpertos, ¡adquirid prudencia!",
          "Vosotros los necios, ¡obtened discernimiento!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Escuchadme, que diré cosas importantes;",
          "mis labios hablarán lo correcto."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Mi boca expresará la verdad,",
          "pues mis labios detestan la mentira."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Las palabras de mi boca son todas justas;",
          "no hay en ellas maldad ni doblez."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Son claras para los entendidos,",
          "e irreprochables para los sabios."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Optad por mi instrucción, no por la plata;",
          "por el conocimiento, no por el oro refinado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Vale más la sabiduría que las piedras preciosas,",
          "y ni lo más deseable se le compara."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "»Yo, la sabiduría, convivo con la prudencia",
          "y poseo conocimiento y discreción."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Quien teme al Señor aborrece lo malo;",
          "yo aborrezco el orgullo y la arrogancia,",
          "la mala conducta y el lenguaje perverso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Míos son el consejo y el buen juicio;",
          "míos son el entendimiento y el poder."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Por mí reinan los reyes",
          "y promulgan leyes justas los gobernantes."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Por mí gobiernan los príncipes",
          "y todos los nobles que rigen la tierra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "A los que me aman, les correspondo;",
          "a los que me buscan, me doy a conocer."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Conmigo están las riquezas y la honra,",
          "la prosperidad y los bienes duraderos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Mi fruto es mejor que el oro fino;",
          "mi cosecha sobrepasa a la plata refinada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Voy por el camino de la rectitud,",
          "por los senderos de la justicia,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "enriqueciendo a los que me aman",
          "y acrecentando sus tesoros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "»El Señor me dio la vida como primicia de sus obras,",
          "mucho antes de sus obras de antaño."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Fui establecida desde la eternidad,",
          "desde antes que existiera el mundo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "No existían los grandes mares cuando yo nací;",
          "no había entonces manantiales de abundantes aguas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Nací antes que fueran formadas las colinas,",
          "antes que se cimentaran las montañas,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "antes que él creara la tierra y sus paisajes",
          "y el polvo primordial con que hizo el mundo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Cuando Dios cimentó la bóveda celeste",
          "y trazó el horizonte sobre las aguas,",
          "allí estaba yo presente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Cuando estableció las nubes en los cielos",
          "y reforzó las fuentes del mar profundo;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "cuando señaló los límites del mar,",
          "para que las aguas obedecieran su mandato;",
          "cuando plantó los fundamentos de la tierra,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "allí estaba yo, afirmando su obra.",
          "Día tras día me llenaba yo de alegría,",
          "siempre disfrutaba de estar en su presencia;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "me regocijaba en el mundo que él creó;",
          "¡en el género humano me deleitaba!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "»Y ahora, hijos míos, escuchadme:",
          "dichosos los que van por mis caminos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Atended a mi instrucción, y sed sabios;",
          "no la descuidéis."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "Dichosos los que me escuchan",
          "y a mis puertas están atentos cada día,",
          "esperando a la entrada de mi casa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "En verdad, quien me encuentra halla la vida",
          "y recibe el favor del Señor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Quien me rechaza se perjudica a sí mismo;",
          "quien me aborrece ama la muerte»."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
