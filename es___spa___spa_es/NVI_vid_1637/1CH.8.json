    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Descendientes de Benjamín"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Los hijos de Benjamín fueron:",
          "Bela, el primero;",
          "Asbel, el segundo;",
          "Ajará, el tercero;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Noja, el cuarto,",
          "y Rafá, el quinto."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Los hijos de Bela fueron Adar, Guerá, Abiud,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Abisúa, Naamán, Ajoaj,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Guerá, Sefufán e Hiram."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Los hijos de Aod, jefes de las familias patriarcales que habitaban en Gueba y que luego se trasladaron a Manajat, fueron"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Naamán, Ahías y Guerá, padre de Uza y de Ajiud. Guerá fue el que los trasladó a Manajat."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Después de que Sajarayin repudió a sus esposas Jusín y Bará, tuvo otros hijos en los campos de Moab."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Con su esposa Hodes tuvo a Jobab, Sibia, Mesá, Malcán,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Jeús, Saquías y Mirma. Estos hijos suyos fueron jefes de familias patriarcales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Con Jusín tuvo a Abitob y a Elpal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Los hijos de Elpal fueron Éber, Misán y Sémed. Sémed edificó las ciudades de Ono y Lod, con sus aldeas;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Beriá y Semá fueron jefes de las familias patriarcales de los habitantes de Ayalón, y expulsaron a los habitantes de Gat."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Los hijos de Beriá fueron Ajío, Sasac, Jeremot,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Zebadías, Arad, Ader,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Micael, Ispá y Yojá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Zebadías, Mesulán, Hizqui, Éber,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Ismeray, Jezlías y Jobab fueron los hijos de Elpal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Yaquín, Zicrí, Zabdí,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Elienay, Ziletay, Eliel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Adaías, Beraías y Simrat fueron los hijos de Simí."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ispán, Éber, Eliel,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Abdón, Zicrí, Janán,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Jananías, Elam, Anatotías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Ifdaías y Peniel fueron los hijos de Sasac."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Samseray, Seharías, Atalías,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "Jaresías, Elías y Zicrí fueron los hijos de Jeroán."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          28
        ],
        "lines": [
          "Según sus registros genealógicos, estos fueron jefes de familias patriarcales y habitaron en Jerusalén."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          29
        ],
        "lines": [
          "Jehiel, padre de Gabaón, vivía en Gabaón. Su esposa se llamaba Macá."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          30
        ],
        "lines": [
          "Sus hijos fueron Abdón, el primogénito; Zur, Quis, Baal, Ner, Nadab,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          31
        ],
        "lines": [
          "Guedor, Ajío, Zéquer"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          32
        ],
        "lines": [
          "y Miclot, padre de Simá. Estos vivían también en Jerusalén con sus hermanos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          33
        ],
        "lines": [
          "Ner fue el padre de Quis, y este fue padre de Saúl, quien fue padre de Jonatán, Malquisúa, Abinadab y Esbaal."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          34
        ],
        "lines": [
          "El hijo de Jonatán fue Meribaal, padre de Micaías."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          35
        ],
        "lines": [
          "Los hijos de Micaías fueron Pitón, Mélec, Tarea y Acaz."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          36
        ],
        "lines": [
          "Acaz fue padre de Joada, y este lo fue de Alemet, Azmávet y Zimri. Zimri fue el padre de Mosá;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          37
        ],
        "lines": [
          "Mosá fue el padre de Biná, y este lo fue de Rafá; Rafá fue el padre de Elasá, y este lo fue de Azel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          38
        ],
        "lines": [
          "Azel tuvo seis hijos, cuyos nombres fueron Azricán, Bocrú, Ismael, Searías, Abdías y Janán. Estos fueron los hijos de Azel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          39
        ],
        "lines": [
          "Los hijos de su hermano Ésec fueron:",
          "Ulán, el primero;",
          "Jeús, el segundo,",
          "y Elifelet, el tercero."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          40
        ],
        "lines": [
          "Los hijos de Ulán fueron guerreros valientes, diestros con el arco. Tuvieron muchos hijos y nietos: ciento cincuenta en total.",
          "Todos estos fueron los descendientes de Benjamín."
        ],
        "rlw_lines": []
      }
    ]
  },
