    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Acompáñese con instrumentos de cuerda. Salmo de Asaf. Cántico."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Dios es conocido en Judá;",
          "su nombre es exaltado en Israel."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "En Salén se halla su santuario;",
          "en Sión está su morada."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Allí hizo pedazos las centelleantes flechas,",
          "los escudos, las espadas, las armas de guerra."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Estás rodeado de esplendor;",
          "eres más imponente que las montañas eternas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Los valientes yacen ahora despojados;",
          "han caído en el sopor de la muerte.",
          "Ninguno de esos hombres aguerridos",
          "volverá a levantar sus manos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cuando tú, Dios de Jacob, los reprendiste,",
          "quedaron pasmados jinetes y corceles."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Tú, y solo tú, eres temido.",
          "¿Quién puede hacerte frente",
          "cuando se enciende tu enojo?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Desde el cielo diste a conocer tu veredicto;",
          "la tierra, temerosa, guardó silencio"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "cuando tú, oh Dios, te levantaste para juzgar,",
          "para salvar a los pobres de la tierra."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "La furia del hombre se vuelve tu alabanza,",
          "y los que sobrevivan al castigo te harán fiesta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Haced votos al Señor vuestro Dios, y cumplidlos;",
          "que todos los países vecinos",
          "paguen tributo al Dios temible,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "al que acaba con el valor de los gobernantes,",
          "¡al que es temido por los reyes de la tierra!"
        ],
        "rlw_lines": []
      }
    ]
  },
