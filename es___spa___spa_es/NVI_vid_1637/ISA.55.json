    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "Invitación a los sedientos"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "»¡Venid a las aguas",
          "todos los que tengáis sed!",
          "¡Venid a comprar y a comer",
          "los que no tengáis dinero!",
          "Venid, comprad vino y leche",
          "sin pago alguno."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¿Por qué gastáis dinero en lo que no es pan,",
          "y vuestro salario en lo que no satisface?",
          "Escuchadme bien, y comeréis lo que es bueno,",
          "y os deleitaréis con manjares deliciosos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Prestad atención y venid a mí,",
          "escuchadme y viviréis.",
          "Haré con vosotros un pacto eterno,",
          "conforme a mi constante amor por David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Lo he puesto como testigo para los pueblos,",
          "como su jefe supremo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Sin duda convocarás a naciones",
          "que no conocías,",
          "y naciones que no te conocían",
          "correrán hacia ti,",
          "gracias al Señor tu Dios,",
          "el Santo de Israel,",
          "que te ha colmado de honor»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Buscad al Señor mientras se deje encontrar,",
          "llamadlo mientras esté cercano."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Que abandone el malvado su camino,",
          "y el perverso sus pensamientos.",
          "Que se vuelva al Señor, a nuestro Dios,",
          "que es generoso para perdonar,",
          "y de él recibirá misericordia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "«Porque mis pensamientos no son los vuestros,",
          "ni vuestros caminos son los míos",
          "—afirma el Señor—."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Mis caminos y mis pensamientos",
          "son más altos que los vuestros;",
          "¡más altos que los cielos sobre la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Así como la lluvia y la nieve",
          "descienden del cielo,",
          "y no vuelven allá sin regar antes la tierra",
          "y hacerla fecundar y germinar",
          "para que dé semilla al que siembra",
          "y pan al que come,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "así es también la palabra que sale de mi boca:",
          "No volverá a mí vacía,",
          "sino que hará lo que yo deseo",
          "y cumplirá con mis propósitos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Vosotros saldréis con alegría",
          "y seréis guiados en paz.",
          "A vuestro paso, las montañas y las colinas",
          "prorrumpirán en gritos de júbilo",
          "y aplaudirán todos los árboles del bosque."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "En vez de zarzas, crecerán cipreses;",
          "mirtos, en lugar de ortigas.",
          "Esto le dará renombre al Señor;",
          "será una señal que durará para siempre»."
        ],
        "rlw_lines": []
      }
    ]
  },
