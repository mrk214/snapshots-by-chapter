    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David, para las ofrendas memoriales."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Señor, no me reprendas en tu enojo",
          "ni me castigues en tu ira."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Porque tus flechas me han atravesado,",
          "y sobre mí ha caído tu mano."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "A causa de tu indignación",
          "no hay nada sano en mi cuerpo;",
          "por mi pecado,",
          "mis huesos no hallan descanso."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Mis maldades me abruman,",
          "son una carga demasiado pesada."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "A causa de mi insensatez,",
          "mis llagas hieden y supuran."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Estoy agobiado, del todo abatido;",
          "todo el día ando acongojado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Estoy ardiendo de fiebre;",
          "no hay nada sano en mi cuerpo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Me siento débil, completamente deshecho;",
          "mi corazón gime angustiado."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Ante ti, Señor, están todos mis deseos;",
          "no te son un secreto mis anhelos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Late mi corazón con violencia,",
          "las fuerzas me abandonan,",
          "hasta la luz de mis ojos se apaga."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Mis amigos y vecinos se apartan de mis llagas;",
          "mis parientes se mantienen a distancia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Tienden sus trampas los que quieren matarme;",
          "maquinan mi ruina los que buscan mi mal",
          "y todo el día urden engaños."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Pero yo me hago el sordo, y no los escucho;",
          "me hago el mudo, y no les respondo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Soy como los que no oyen",
          "ni pueden defenderse."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Yo, Señor, espero en ti;",
          "tú, Señor y Dios mío, serás quien responda."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Tan solo pido que no se burlen de mí,",
          "que no se crean superiores si resbalo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Cerca estoy de desfallecer;",
          "el dolor no me deja un solo instante."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Voy a confesar mi iniquidad,",
          "pues mi pecado me angustia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Muchos son mis enemigos gratuitos;",
          "abundan los que me odian sin motivo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por hacer el bien, me pagan con el mal;",
          "por procurar lo bueno, se ponen en mi contra."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "Señor, no me abandones;",
          "Dios mío, no te alejes de mí."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Señor de mi salvación,",
          "¡ven pronto en mi ayuda!"
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
