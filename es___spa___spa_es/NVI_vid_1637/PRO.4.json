    "items": [
      {
        "type": "heading1",
        "verse_numbers": [],
        "lines": [
          "La sabiduría es lo máximo"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Escuchad, hijos, la corrección de un padre;",
          "disponeos a adquirir inteligencia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Yo os brindo buenas enseñanzas,",
          "así que no abandonéis mi instrucción."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Cuando yo era pequeño y vivía con mi padre,",
          "cuando era el niño consentido de mi madre,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "mi padre me instruyó de esta manera:",
          "«Aférrate de corazón a mis palabras;",
          "obedece mis mandamientos, y vivirás."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Adquiere sabiduría, adquiere inteligencia;",
          "no olvides mis palabras ni te apartes de ellas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "No abandones nunca a la sabiduría,",
          "y ella te protegerá;",
          "ámala, y ella te cuidará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "La sabiduría es lo primero. ¡Adquiere sabiduría!",
          "Por encima de todas las cosas, adquiere discernimiento."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Estima a la sabiduría, y ella te exaltará;",
          "abrázala, y ella te honrará;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "te pondrá en la cabeza una hermosa diadema;",
          "te obsequiará con una bella corona»."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Escucha, hijo mío, acoge mis palabras,",
          "y los años de tu vida aumentarán."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Yo te guío por el camino de la sabiduría,",
          "te dirijo por sendas de rectitud."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Cuando camines, no encontrarás obstáculos;",
          "cuando corras, no tropezarás."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Aférrate a la instrucción, no la dejes escapar;",
          "cuídala bien, porque ella es tu vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "No sigas la senda de los perversos",
          "ni vayas por el camino de los malvados."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "¡Evita ese camino! ¡No pases por él!",
          "¡Aléjate de allí, y sigue adelante!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Los malvados no duermen si no hacen lo malo;",
          "pierden el sueño si no hacen que alguien caiga."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Su pan es la maldad;",
          "su vino, la violencia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "La senda de los justos se asemeja",
          "a los primeros albores de la aurora:",
          "su esplendor va en aumento",
          "hasta que el día alcanza su plenitud."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Pero el camino de los malvados",
          "es como la más densa oscuridad;",
          "¡ni siquiera saben con qué tropiezan!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Hijo mío, atiende a mis consejos;",
          "escucha atentamente lo que digo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          21
        ],
        "lines": [
          "No pierdas de vista mis palabras;",
          "guárdalas muy dentro de tu corazón."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          22
        ],
        "lines": [
          "Ellas dan vida a quienes las hallan;",
          "son la salud del cuerpo."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          23
        ],
        "lines": [
          "Por encima de todas las cosas cuida tu corazón,",
          "porque de él mana la vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          24
        ],
        "lines": [
          "Aleja de tu boca la perversidad;",
          "aparta de tus labios las palabras corruptas."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          25
        ],
        "lines": [
          "Pon la mirada en lo que tienes delante;",
          "fija la vista en lo que está frente a ti."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          26
        ],
        "lines": [
          "Endereza las sendas por donde andas;",
          "allana todos tus caminos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          27
        ],
        "lines": [
          "No te desvíes ni a diestra ni a siniestra;",
          "apártate de la maldad."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
