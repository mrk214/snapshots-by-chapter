    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Aplaudid, pueblos todos;",
          "aclamad a Dios con gritos de alegría."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "¡Cuán imponente es el Señor Altísimo,",
          "el gran rey de toda la tierra!"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sometió a nuestro dominio las naciones;",
          "puso a los pueblos bajo nuestros pies;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "escogió para nosotros una heredad",
          "que es el orgullo de Jacob, a quien amó."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Dios el Señor ha ascendido",
          "entre gritos de alegría y toques de trompeta."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Cantad salmos a Dios, cantadle salmos;",
          "cantad, cantadle salmos a nuestro rey."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Dios es el rey de toda la tierra;",
          "por eso, cantadle un salmo solemne."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Dios reina sobre las naciones;",
          "Dios está sentado en su santo trono."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Los nobles de los pueblos se reúnen",
          "con el pueblo del Dios de Abraham,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "pues de Dios son los imperios de la tierra.",
          "¡Él es grandemente enaltecido!"
        ],
        "rlw_lines": []
      }
    ]
  },
