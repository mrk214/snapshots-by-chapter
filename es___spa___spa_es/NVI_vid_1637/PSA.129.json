    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Cántico de los peregrinos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Mucho me han angustiado desde mi juventud",
          "—que lo repita ahora Israel—,"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "mucho me han angustiado desde mi juventud,",
          "pero no han logrado vencerme."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Sobre la espalda me pasaron el arado,",
          "abriéndome en ella profundos surcos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Pero el Señor, que es justo,",
          "me libró de las ataduras de los impíos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Que retrocedan avergonzados",
          "todos los que odian a Sión."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Que sean como la hierba en el techo,",
          "que antes de crecer se marchita;"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "que no llena las manos del segador",
          "ni el regazo del que cosecha."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Que al pasar nadie les diga:",
          "«La bendición del Señor sea con vosotros;",
          "os bendecimos en el nombre del Señor»."
        ],
        "rlw_lines": []
      }
    ]
  },
