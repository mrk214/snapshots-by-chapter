    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Salmo de David."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Del Señor es la tierra y todo cuanto hay en ella,",
          "el mundo y cuantos lo habitan;"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "porque él la afirmó sobre los mares,",
          "la estableció sobre los ríos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "¿Quién puede subir al monte del Señor?",
          "¿Quién puede estar en su lugar santo?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Solo el de manos limpias y corazón puro,",
          "el que no adora ídolos vanos",
          "ni jura por dioses falsos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "Quien es así recibe bendiciones del Señor;",
          "Dios su Salvador le hará justicia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "Tal es la generación de los que a ti acuden,",
          "de los que buscan tu rostro, oh Dios de Jacob."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Elevad, puertas, vuestros dinteles;",
          "levantaos, puertas antiguas,",
          "que va a entrar el Rey de la gloria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¿Quién es este Rey de la gloria?",
          "El Señor, el fuerte y valiente,",
          "el Señor, el valiente guerrero."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Elevad, puertas, vuestros dinteles;",
          "levantaos, puertas antiguas,",
          "que va a entrar el Rey de la gloria."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "¿Quién es este Rey de la gloria?",
          "Es el Señor Todopoderoso;",
          "¡él es el Rey de la gloria!"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
