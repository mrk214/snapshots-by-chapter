    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Para Jedutún. Salmo de Asaf."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "A Dios elevo mi voz suplicante;",
          "a Dios elevo mi voz para que me escuche."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "Cuando estoy angustiado, recurro al Señor;",
          "sin cesar elevo mis manos por las noches,",
          "pero me niego a recibir consuelo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Me acuerdo de Dios, y me lamento;",
          "medito en él, y desfallezco."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "No me dejas conciliar el sueño;",
          "tan turbado estoy que ni hablar puedo."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          5,
          6
        ],
        "lines": [
          "Me pongo a pensar en los tiempos de antaño;",
          "de los años ya idos me acuerdo.",
          "Mi corazón reflexiona por las noches;",
          "mi espíritu medita e inquiere:"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "«¿Nos rechazará el Señor para siempre?",
          "¿No volverá a mostrarnos su buena voluntad?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "¿Se habrá agotado su gran amor eterno,",
          "y sus promesas por todas las generaciones?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "¿Se habrá olvidado Dios de sus bondades,",
          "y en su enojo ya no quiere tener compasión de nosotros?»"
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Y me pongo a pensar: «Esto es lo que me duele:",
          "que haya cambiado la diestra del Altísimo»."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Prefiero recordar las hazañas del Señor,",
          "traer a la memoria sus milagros de antaño."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "Meditaré en todas tus proezas;",
          "evocaré tus obras poderosas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Santos, oh Dios, son tus caminos;",
          "¿qué dios hay tan excelso como nuestro Dios?"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Tú eres el Dios que realiza maravillas;",
          "el que despliega su poder entre los pueblos."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Con tu brazo poderoso redimiste a tu pueblo,",
          "a los descendientes de Jacob y de José."
        ],
        "rlw_lines": []
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "Las aguas te vieron, oh Dios,",
          "las aguas te vieron y se agitaron;",
          "el propio abismo se estremeció con violencia."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "Derramaron su lluvia las nubes;",
          "retumbaron con estruendo los cielos;",
          "rasgaron el espacio tus centellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Tu estruendo retumbó en el torbellino",
          "y tus relámpagos iluminaron el mundo;",
          "la tierra se estremeció con temblores."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "Te abriste camino en el mar;",
          "te hiciste paso entre las muchas aguas,",
          "y no se hallaron tus huellas."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "Por medio de Moisés y de Aarón",
          "guiaste como un rebaño a tu pueblo."
        ],
        "rlw_lines": []
      }
    ]
  },
