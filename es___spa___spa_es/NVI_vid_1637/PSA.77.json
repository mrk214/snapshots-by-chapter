    "name": "Salmo"
  },
  "chapter": {
    "usfm": "PSA.77",
    "human": "Salmo 77",
    "previous": {
      "usfm": "PSA.76",
      "human": "Salmo 76"
    },
    "next": {
      "usfm": "PSA.78",
