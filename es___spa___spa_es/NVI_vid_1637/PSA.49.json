    "items": [
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Al director musical. Salmo de los hijos de Coré."
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          1
        ],
        "lines": [
          "Oíd esto, pueblos todos;",
          "escuchad, habitantes todos del mundo,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          2
        ],
        "lines": [
          "tanto débiles como poderosos,",
          "lo mismo los ricos que los pobres."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          3
        ],
        "lines": [
          "Mi boca hablará con sabiduría;",
          "mi corazón se expresará con inteligencia."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          4
        ],
        "lines": [
          "Inclinaré mi oído a los proverbios;",
          "propondré mi enigma al son del arpa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          5
        ],
        "lines": [
          "¿Por qué he de temer en tiempos de desgracia,",
          "cuando me rodeen inicuos detractores?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          6
        ],
        "lines": [
          "¿Temeré a los que confían en sus riquezas",
          "y se jactan de sus muchas posesiones?"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          7
        ],
        "lines": [
          "Nadie puede salvar a nadie,",
          "ni pagarle a Dios rescate por la vida."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          8
        ],
        "lines": [
          "Tal rescate es muy costoso;",
          "ningún pago es suficiente."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          9
        ],
        "lines": [
          "Nadie vive para siempre",
          "sin llegar a ver la fosa."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          10
        ],
        "lines": [
          "Nadie puede negar que todos mueren,",
          "que sabios e insensatos perecen por igual,",
          "y que sus riquezas se quedan para otros."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          11
        ],
        "lines": [
          "Aunque tuvieron tierras a su nombre,",
          "sus tumbas serán su hogar eterno,",
          "su morada por todas las generaciones."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          12
        ],
        "lines": [
          "A pesar de sus riquezas, no perduran los mortales;",
          "al igual que las bestias, perecen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          13
        ],
        "lines": [
          "Tal es el destino de los que confían en sí mismos;",
          "el final de los que se envanecen."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          14
        ],
        "lines": [
          "Como ovejas, están destinados al sepulcro;",
          "hacia allá los conduce la muerte.",
          "Sus cuerpos se pudrirán en el sepulcro,",
          "lejos de sus mansiones suntuosas.",
          "Por la mañana los justos prevalecerán sobre ellos."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          15
        ],
        "lines": [
          "Pero Dios me rescatará de las garras del sepulcro",
          "y con él me llevará."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "label",
        "verse_numbers": [],
        "lines": [
          "Selah"
        ],
        "rlw_lines": []
      },
      {
        "type": "verse",
        "verse_numbers": [
          16
        ],
        "lines": [
          "No te asombre ver que alguien se enriquezca",
          "y aumente el esplendor de su casa,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          17
        ],
        "lines": [
          "porque al morir no se llevará nada,",
          "ni con él descenderá su esplendor."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          18
        ],
        "lines": [
          "Aunque en vida se considere dichoso,",
          "y la gente lo elogie por sus logros,"
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          19
        ],
        "lines": [
          "irá a reunirse con sus ancestros,",
          "sin que vuelva jamás a ver la luz."
        ],
        "rlw_lines": [],
        "np": true
      },
      {
        "type": "verse",
        "verse_numbers": [
          20
        ],
        "lines": [
          "A pesar de sus riquezas, no perduran los mortales;",
          "al igual que las bestias, perecen."
        ],
        "rlw_lines": [],
        "np": true
      }
    ]
  },
